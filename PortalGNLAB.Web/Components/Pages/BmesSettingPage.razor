@page "/bmes/setting"
@page "/setting"
@rendermode InteractiveServer
@using PortalGNLAB.Web.Services
@using Microsoft.AspNetCore.Components.Web
@inject AppPathsService         AppPaths
@inject NgRateSettingsService    NgRateSettings
@inject BmesMaterialService      BmesMaterials
@inject BmesSettingsSyncService  BmesSettingsSync
@inject WebRepository            Repo
@inject AiProviderSettingsService AiProviders
@inject CodexApiService          CodexApi
@inject QrTestDataService        QrBakoData
@inject QrModelCodeService       QrModelCodes
@inject HistoryCacheJobService   HistoryJob
@implements IDisposable

<PageTitle>Setting</PageTitle>

<div class="d-flex align-items-center gap-2 mb-3">
    <span style="font-size:20px;">⚙️</span>
    <h5 class="mb-0 fw-semibold">Setting</h5>
</div>

@if (!string.IsNullOrEmpty(_statusMsg))
{
    <div class="alert @(_statusError ? "alert-danger" : "alert-success") py-2 small mb-3 d-flex align-items-center">
        <span class="flex-fill">@_statusMsg</span>
        <button class="btn-close btn-sm" @onclick="() => _statusMsg = string.Empty"></button>
    </div>
}

<AuthorizeView Roles="Admin">
    <Authorized>
        <div class="row g-3 mb-3">
            <div class="col-lg-6">
<div class="card setting-card h-100">
    <div class="card-header fw-semibold small">Codex API (OpenAI)</div>
                    <div class="card-body">
                        <div class="mb-2">
                            <label class="form-label small fw-semibold mb-1">API Key</label>
                            <div class="input-group input-group-sm">
                                <input type="@(_showCodexKey ? "text" : "password")"
                                       class="form-control form-control-sm font-monospace"
                                       placeholder="sk-..."
                                       @bind="_codexApiKey" />
                                <button class="btn btn-outline-secondary btn-sm" type="button"
                                        @onclick="() => _showCodexKey = !_showCodexKey">
                                    @(_showCodexKey ? "Hide" : "Show")
                                </button>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold mb-1">Translate Model</label>
                            <div class="input-group input-group-sm">
                                <select class="form-select form-select-sm font-monospace" @bind="_codexTranslateModel">
                                    @foreach (string model in TranslateModelOptions)
                                    {
                                        <option value="@model">@model</option>
                                    }
                                </select>
                                <button class="btn btn-outline-secondary btn-sm" type="button"
                                        @onclick="LoadCodexModelsAsync" disabled="@_codexModelsLoading"
                                        title="Reload the model list from the OpenAI API">
                                    @(_codexModelsLoading ? "Loading..." : "Reload")
                                </button>
                            </div>
                            @if (_codexModelsLoading)
                            {
                                <div class="form-text small">Loading model list...</div>
                            }
                            else if (!string.IsNullOrEmpty(_codexModelsError))
                            {
                                <div class="form-text small text-danger">@_codexModelsError</div>
                            }
                            else
                            {
                                <div class="form-text small">@_codexModels.Count model(s) available to this API key.</div>
                            }
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold mb-1">Translate Reasoning Effort</label>
                            <select class="form-select form-select-sm" @bind="_codexTranslateEffort">
                                @foreach (string effort in CodexApiService.ReasoningEfforts)
                                {
                                    <option value="@effort">@effort</option>
                                }
                            </select>
                            <div class="form-text small">Codex Luna (@CodexApiService.LunaModel) at low is the default.</div>
                        </div>
                        <button class="btn btn-primary btn-sm" @onclick="SaveCodexAsync" disabled="@_codexSaving">
                            @(_codexSaving ? "Saving..." : "Save")
                        </button>
                        @if (_codexSaved) { <span class="ms-2 text-success fw-semibold small">Saved.</span> }
                        @if (!string.IsNullOrEmpty(_codexError)) { <div class="small text-danger mt-2">@_codexError</div> }
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
<div class="card setting-card h-100">
    <div class="card-header fw-semibold small">AI Provider Switches</div>
                    <div class="card-body">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="aiCodexCli"
                                   @bind="_aiProviders.CodexCliEnabled" />
                            <label class="form-check-label small" for="aiCodexCli">Codex CLI</label>
                        </div>
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" id="aiCodexApi"
                                   @bind="_aiProviders.CodexApiEnabled" />
                            <label class="form-check-label small" for="aiCodexApi">Codex API</label>
                        </div>
                        <button class="btn btn-primary btn-sm" @onclick="SaveAiProvidersAsync" disabled="@_aiProviderSaving">
                            @(_aiProviderSaving ? "Saving..." : "Save")
                        </button>
                        @if (_aiProviderSaved) { <span class="ms-2 text-success fw-semibold small">Saved.</span> }
                        @if (!string.IsNullOrEmpty(_aiProviderError)) { <div class="small text-danger mt-2">@_aiProviderError</div> }
                    </div>
                </div>
            </div>
        </div>
        <div class="row g-3 mb-3">
            <div class="col-12">
<div class="card setting-card">
    <div class="card-header fw-semibold small">QR BAKO DATA DB</div>
                    <div class="card-body">
                        <div class="row g-2 align-items-end">
                            <div class="col-lg-3 col-md-6">
                                <label class="form-label small fw-semibold mb-1">Server</label>
                                <input class="form-control form-control-sm" @bind="_pathsForm.QrBakoDataServer" />
                            </div>
                            <div class="col-lg-1 col-md-3">
                                <label class="form-label small fw-semibold mb-1">Port</label>
                                <input class="form-control form-control-sm" type="number" min="1" max="65535" @bind="_pathsForm.QrBakoDataPort" />
                            </div>
                            <div class="col-lg-2 col-md-4">
                                <label class="form-label small fw-semibold mb-1">Database</label>
                                <input class="form-control form-control-sm" @bind="_pathsForm.QrBakoDataDatabase" />
                            </div>
                            <div class="col-lg-2 col-md-4">
                                <label class="form-label small fw-semibold mb-1">User ID</label>
                                <input class="form-control form-control-sm" @bind="_pathsForm.QrBakoDataUserId" autocomplete="off" />
                            </div>
                            <div class="col-lg-3 col-md-6">
                                <label class="form-label small fw-semibold mb-1">Password</label>
                                <div class="input-group input-group-sm">
                                    <input class="form-control form-control-sm"
                                           type="@(_showQrBakoPassword ? "text" : "password")"
                                           @bind="_pathsForm.QrBakoDataPassword"
                                           autocomplete="off" />
                                    <button class="btn btn-outline-secondary btn-sm"
                                            type="button"
                                            @onclick="() => _showQrBakoPassword = !_showQrBakoPassword">
                                        @(_showQrBakoPassword ? "Hide" : "Show")
                                    </button>
                                </div>
                            </div>
                            <div class="col-lg-1 col-md-3">
                                <label class="form-label small fw-semibold mb-1">Rows</label>
                                <input class="form-control form-control-sm" type="number" min="1" max="20000" @bind="_pathsForm.QrBakoDataDefaultMaxRows" />
                            </div>
                            <div class="col-lg-2 col-md-3">
                                <label class="form-label small fw-semibold mb-1">Timeout</label>
                                <input class="form-control form-control-sm" type="number" min="1" max="300" @bind="_pathsForm.QrBakoDataTimeoutSeconds" />
                            </div>
                            <div class="col-lg-4 col-md-6 d-flex align-items-end gap-3">
                                <div class="form-check mb-1">
                                    <input class="form-check-input" id="qrBakoEncrypt" type="checkbox" @bind="_pathsForm.QrBakoDataEncrypt" />
                                    <label class="form-check-label small" for="qrBakoEncrypt">Encrypt</label>
                                </div>
                                <div class="form-check mb-1">
                                    <input class="form-check-input" id="qrBakoTrust" type="checkbox" @bind="_pathsForm.QrBakoDataTrustServerCertificate" />
                                    <label class="form-check-label small" for="qrBakoTrust">Trust server certificate</label>
                                </div>
                            </div>
                            <div class="col-lg-6 col-md-12 d-flex align-items-end gap-2">
                                <button class="btn btn-primary btn-sm" @onclick="SaveQrBakoDbAsync" disabled="@_qrBakoSaving">
                                    @if (_qrBakoSaving)
                                    { <span class="spinner-border spinner-border-sm me-1"></span> }
                                    Save
                                </button>
                                <button class="btn btn-outline-primary btn-sm" @onclick="TestQrBakoDbAsync" disabled="@(_qrBakoSaving || _qrBakoTesting)">
                                    @if (_qrBakoTesting)
                                    { <span class="spinner-border spinner-border-sm me-1"></span> }
                                    Test Connection
                                </button>
                                @if (!string.IsNullOrWhiteSpace(_qrBakoMsg))
                                {
                                    <span class="small fw-semibold @(_qrBakoError ? "text-danger" : "text-success")">@_qrBakoMsg</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row g-3 mb-3">
            <div class="col-12">
                <div class="card setting-card">
                    <div class="card-header fw-semibold small">
                        QR Model Codes
                        <span class="text-muted fw-normal">
                            · characters 11-12 of the QR name the model — J69NAG1GD0<b>37</b>00009 is code 37
                        </span>
                    </div>
                    <div class="card-body">
                        <p class="small text-muted mb-2">
                            The QR pages filter by this table. It is the only model marker the three stations agree on:
                            BKTD writes <code>3200.MSM-X316.L1.M1.V01.260922</code> in <code>Model</code> while ALTD and
                            GSTD write <code>3200.MSM-X316B.L1.M1.JIG1</code> in <code>ST_Information</code>.
                        </p>
                        <table class="table table-sm align-middle mb-2" style="max-width:34rem;">
                            <thead>
                                <tr>
                                    <th style="width:7rem;" class="small">Code</th>
                                    <th class="small">Model name</th>
                                    <th style="width:5rem;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_qrModelCodes.Count == 0)
                                {
                                    <tr>
                                        <td colspan="3" class="small text-muted">
                                            No model is defined; the QR pages will only offer "All models".
                                        </td>
                                    </tr>
                                }
                                @for (int i = 0; i < _qrModelCodes.Count; i++)
                                {
                                    int index = i;
                                    <tr>
                                        <td>
                                            <input class="form-control form-control-sm font-monospace"
                                                   maxlength="2"
                                                   placeholder="37"
                                                   @bind="_qrModelCodes[index].Code" />
                                        </td>
                                        <td>
                                            <input class="form-control form-control-sm"
                                                   placeholder="MSM-X316B"
                                                   @bind="_qrModelCodes[index].Name" />
                                        </td>
                                        <td>
                                            <button class="btn btn-outline-danger btn-sm"
                                                    type="button"
                                                    @onclick="() => _qrModelCodes.RemoveAt(index)">Remove</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <div class="d-flex align-items-center gap-2">
                            <button class="btn btn-outline-secondary btn-sm"
                                    type="button"
                                    @onclick="() => _qrModelCodes.Add(new QrModelCode())">Add model</button>
                            <button class="btn btn-primary btn-sm" @onclick="SaveQrModelCodes" disabled="@_qrModelSaving">
                                @if (_qrModelSaving)
                                { <span class="spinner-border spinner-border-sm me-1"></span> }
                                Save
                            </button>
                            @if (!string.IsNullOrWhiteSpace(_qrModelMsg))
                            {
                                <span class="small fw-semibold @(_qrModelError ? "text-danger" : "text-success")">@_qrModelMsg</span>
                            }
                            <span class="small text-muted ms-auto">@QrModelCodes.SettingsPath</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </Authorized>
</AuthorizeView>

<div class="row g-3 mb-3">
    <div class="col-12">
<div class="card setting-card">
    <div class="card-header fw-semibold small">App Path</div>
            <div class="card-body">
                <label class="form-label small fw-semibold mb-1">
                    Working Folder
                    <span class="badge bg-warning text-dark ms-1">restart</span>
                </label>
                <div class="input-group input-group-sm">
                    <input class="form-control form-control-sm font-monospace"
                           @bind="_pathsForm.DbRootDirectory"
                           placeholder="@AppPathsService.DefaultDbRootDirectory" />
                    <button class="btn btn-outline-secondary btn-sm"
                            type="button"
                            @onclick="UseDefaultAppPath">
                        Default
                    </button>
                    <button class="btn btn-primary btn-sm"
                            type="button"
                            @onclick="SaveAppPathAsync"
                            disabled="@_pathSaving">
                        @if (_pathSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Save
                    </button>
                </div>
                <div class="small text-muted mt-2">
                    NG RATE: <code>@NgRateWorkDirectory</code><br />
                    FCOST: <code>@FCostWorkDirectory</code><br />
                    WK STATUS: <code>@WorkerStatusWorkDirectory</code>
                </div>
                @if (!string.IsNullOrWhiteSpace(_pathStatus))
                {
                    <div class="small mt-2 @(_pathStatusError ? "text-danger" : "text-success") fw-semibold">
                        @_pathStatus
                    </div>
                }
                @if (_pathSavedRequiresRestart)
                {
                    <div class="small text-warning fw-semibold mt-2">
                        Restart the app for main DB path changes to fully take effect.
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ══ BMES Credentials ═══════════════════════════════════════════════════ -->
    <div class="col-md-6">
<div class="card setting-card h-100">
    <div class="card-header fw-semibold small">🔑 BMES Credentials <span class="text-muted fw-normal">(NG Rate / Worker Status)</span></div>
            <div class="card-body">
                <div class="mb-2">
                    <label class="form-label small fw-semibold mb-1">Login ID</label>
                    <input class="form-control form-control-sm" @bind="_snap.LoginId" placeholder="BMES ID" />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold mb-1">Password</label>
                    <input class="form-control form-control-sm" type="password" @bind="_snap.Password" placeholder="BMES Password" />
                </div>
                <button class="btn btn-primary btn-sm" @onclick="SaveCredentials">Save</button>
            </div>
        </div>
    </div>

    <!-- ══ BMES API Credentials ═══════════════════════════════════════════════ -->
    <div class="col-md-6">
<div class="card setting-card h-100">
    <div class="card-header fw-semibold small">🔑 BMES API Login <span class="text-muted fw-normal">(PLATFORM_API)</span></div>
            <div class="card-body">
                <div class="mb-2">
                    <label class="form-label small fw-semibold mb-1">Facility</label>
                    <select class="form-select form-select-sm" @bind="_snap.ApiFacility">
                        <option value="">Select facility…</option>
                        <option value="BN">BN</option>
                        <option value="GN">GN</option>
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label small fw-semibold mb-1">Login ID</label>
                    <input class="form-control form-control-sm" @bind="_snap.ApiLoginId" placeholder="BMES API ID" />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold mb-1">Password</label>
                    <input class="form-control form-control-sm" type="password" @bind="_snap.ApiPassword" placeholder="BMES API Password" />
                </div>
                <button class="btn btn-primary btn-sm" @onclick="SaveApiCredentials">Save</button>
            </div>
        </div>
    </div>

    <div class="col-md-6">
<div class="card setting-card h-100">
    <div class="card-header fw-semibold small">Server Tables</div>
            <div class="card-body">
                <div class="small text-muted mb-2">
                    Save target: <code>@ServerTableTargetPreview</code>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button class="btn btn-outline-primary btn-sm"
                            @onclick="PullRoutingFromServerAsync"
                            disabled="@(_serverTableBusy || _pathSaving)">
                        @if (_serverTableBusy && _serverTableAction == "routing")
                        { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Load Routing
                    </button>
                    <button class="btn btn-outline-primary btn-sm"
                            @onclick="PullReasonFromServerAsync"
                            disabled="@(_serverTableBusy || _pathSaving)">
                        @if (_serverTableBusy && _serverTableAction == "reason")
                        { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Load Reason
                    </button>
                    <button class="btn btn-primary btn-sm"
                            @onclick="PullRoutingReasonFromServerAsync"
                            disabled="@(_serverTableBusy || _pathSaving)">
                        @if (_serverTableBusy && _serverTableAction == "all")
                        { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Load Both
                    </button>
                </div>
                @if (!string.IsNullOrWhiteSpace(_serverTableMsg))
                {
                    <div class="small mt-2 @(_serverTableError ? "text-danger" : "text-success") fw-semibold">
                        @_serverTableMsg
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ══ NG Rate / F-COST history cache ═════════════════════════════════════ -->
    <div class="col-12">
<div class="card setting-card">
    <div class="card-header d-flex align-items-center gap-2">
                <span class="fw-semibold small">History Cache <span class="text-muted fw-normal">(NG Rate / F-COST)</span></span>
                @if (HistoryJob.IsRunning)
                { <span class="badge bg-primary" style="font-size:10px;">Running</span> }
                else if (!string.IsNullOrEmpty(HistoryJob.Status))
                { <span class="badge bg-secondary" style="font-size:10px;">@HistoryJob.Status</span> }
            </div>
            <div class="card-body">
                <div class="small text-muted mb-2">
                    Fetches every day from the start date to
                    <strong>@HistoryCachePolicy.LastHistoryDay(DateTime.Today).ToString("yyyy-MM-dd")</strong>
                    from the BMES API in one run and keeps it. The last @HistoryCachePolicy.LiveWindowDays days are
                    never kept: NG Rate and F-COST always fetch them live. Days already cached are skipped, so a
                    stopped run continues where it left off. It keeps running if you leave this page.
                </div>
                <div class="d-flex flex-wrap align-items-end gap-2">
                    <div>
                        <label class="form-label small mb-1">From</label>
                        <input type="date" class="form-control form-control-sm" style="width:160px;"
                               @bind="_historyFrom" disabled="@HistoryJob.IsRunning" />
                    </div>
                    @if (HistoryJob.IsRunning)
                    {
                        <button class="btn btn-outline-danger btn-sm" @onclick="HistoryJob.Cancel">Stop</button>
                    }
                    else
                    {
                        <button class="btn btn-primary btn-sm" @onclick="StartHistoryCache">▶ Build history cache</button>
                    }
                </div>
                @{ var historyLog = HistoryJob.Log; }
                @if (historyLog.Count > 0)
                {
                    <pre class="small mt-2 mb-0 setting-fetch-log">@string.Join("\n", historyLog.TakeLast(60))</pre>
                }
            </div>
        </div>
    </div>

    <!-- ══ BMES Material Fetch (test) ═════════════════════════════════════════ -->
    <div class="col-12">
<div class="card setting-card">
    <div class="card-header d-flex align-items-center gap-2">
                <span class="fw-semibold small">🧪 BMES Material Fetch (MES020010)</span>
                <span class="badge bg-secondary" style="font-size:10px;">DB rows: @_materialCount</span>
                <div class="ms-auto">
                    <button class="btn btn-primary btn-sm"
                            @onclick="FetchAllMaterialsAsync"
                            disabled="@_fetchBusy">
                        @if (_fetchBusy)
                        { <span class="spinner-border spinner-border-sm me-1"></span><text>Fetching…</text> }
                        else { <text>▶ Fetch all materials</text> }
                    </button>
                </div>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(_fetchLog))
                {
                    <pre class="small mb-2 setting-fetch-log">@_fetchLog</pre>
                }
                @if (_latest is not null)
                {
                    <div class="small">
                        <div><strong>MATNR:</strong> @_latest.Matnr</div>
                        <div><strong>MAKTX:</strong> @_latest.Maktx</div>
                        <div><strong>MTYPE/BTYPE:</strong> @_latest.Mtype / @_latest.Btype</div>
                        <div><strong>ModNameB:</strong> @_latest.ModNameB</div>
                        <div><strong>LotQt / Bunch:</strong> @_latest.LotQt / @_latest.Bunch</div>
                        <div><strong>ERNAM / ERDAT:</strong> @_latest.Ernam / @_latest.Erdat</div>
                        <div class="text-muted mt-1">FetchedAt: @_latest.FetchedAt</div>
                    </div>
                }
                else
                {
                    <div class="text-muted small">No material saved yet.</div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .ins .setting-card,
    .ins .setting-card .card-header { border-radius: 2px !important; }
    .setting-fetch-log {
        background: var(--panel-2, #f5f6f9);
        border: 1px solid var(--line, #dde1e7);
        border-radius: 2px;
        padding: 8px;
        max-height: 160px;
        overflow: auto;
    }
</style>

@code {
    private string _codexApiKey         = string.Empty;
    private string _codexTranslateModel = CodexApiService.DefaultTranslateModel;
    private string _codexTranslateEffort = CodexApiService.DefaultReasoningEffort;
    private bool   _showCodexKey;
    private bool   _codexSaving;
    private bool   _codexSaved;
    private string _codexError = string.Empty;
    private List<string> _codexModels = [];
    private bool   _codexModelsLoading;
    private string _codexModelsError = string.Empty;

    /// <summary>The models the API key can use, plus the saved one so a model that dropped out
    /// of the list stays selected instead of silently switching on the next Save.</summary>
    private IEnumerable<string> TranslateModelOptions =>
        _codexModels.Contains(_codexTranslateModel, StringComparer.OrdinalIgnoreCase)
            ? _codexModels
            : _codexModels.Prepend(_codexTranslateModel);

    private AiProviderSettingsSnapshot _aiProviders = new();
    private bool   _aiProviderSaving;
    private bool   _aiProviderSaved;
    private string _aiProviderError = string.Empty;

    private NgRateSettingsSnapshot _snap = new();
    private AppPathsConfig _pathsForm = new();
    private bool   _showQrBakoPassword;
    private bool   _qrBakoSaving;
    private bool   _qrBakoTesting;
    private string _qrBakoMsg = string.Empty;
    private bool   _qrBakoError;

    /// <summary>Editable copy of the QR model table; only Save writes it back.</summary>
    private List<QrModelCode> _qrModelCodes = [];
    private bool   _qrModelSaving;
    private string _qrModelMsg = string.Empty;
    private bool   _qrModelError;

    private string _statusMsg   = string.Empty;
    private bool   _statusError;
    private bool   _serverTableBusy;
    private string _serverTableAction = string.Empty;
    private string _serverTableMsg    = string.Empty;
    private bool   _serverTableError;
    private bool   _pathSaving;
    private bool   _pathSavedRequiresRestart;
    private string _pathStatus = string.Empty;
    private bool   _pathStatusError;
    private string _origDbRoot = string.Empty;
    private string _origMainDb = string.Empty;
    private string _origSettingsDbDir = string.Empty;
    private string EffectiveWorkDirectory =>
        string.IsNullOrWhiteSpace(_pathsForm.DbRootDirectory)
            ? AppPathsService.DefaultDbRootDirectory
