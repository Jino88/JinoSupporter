    private async Task TestQrBakoDbAsync()
    {
        if (_qrBakoTesting) return;
        _qrBakoTesting = true;
        _qrBakoMsg = string.Empty;
        _qrBakoError = false;
        StateHasChanged();

        try
        {
            if (!await SaveQrBakoDbCoreAsync(showSavedMessage: false))
                return;

            // One connection serves all three QR tables, so probe each of them —
            // otherwise a permission gap on ALTD/GSTD only shows up on the pages.
            foreach (QrTestTableDef table in QrTestTables.All)
                await QrBakoData.TestConnectionAsync(table);
            _qrBakoMsg = "Connected to TCDB (dbo.BKTD, dbo.ALTD, dbo.GSTD).";
        }
        catch (Exception ex)
        {
            _qrBakoError = true;
            _qrBakoMsg = ex.Message;
        }
        finally
        {
            _qrBakoTesting = false;
            StateHasChanged();
        }
    }

