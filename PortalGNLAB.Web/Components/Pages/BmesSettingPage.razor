    private async Task SaveCodexAsync()
    {
        _codexSaving = true;
        _codexSaved  = false;
        _codexError  = string.Empty;
        try
        {
            string model = string.IsNullOrWhiteSpace(_codexTranslateModel)
                ? CodexApiService.DefaultTranslateModel
                : _codexTranslateModel.Trim();
            Repo.SetSetting("OpenAI:ApiKey", _codexApiKey.Trim());
            Repo.SetSetting("OpenAI:TranslateModel", model);
            Repo.SetSetting("OpenAI:TranslateEffort", _codexTranslateEffort);
            if (!string.IsNullOrWhiteSpace(_codexApiKey))
            {
                _aiProviders.CodexApiEnabled = true;
                AiProviders.Save(_aiProviders);
            }
            _codexTranslateModel = model;
            _codexSaved = true;
        }
        catch (Exception ex)
        {
            _codexError = ex.Message;
        }
        finally
        {
            _codexSaving = false;
        }
        await Task.CompletedTask;
    }

