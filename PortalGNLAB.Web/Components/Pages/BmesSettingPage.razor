    protected override void OnInitialized()
    {
        CopyAppPathFromCurrent();
        _codexApiKey = Repo.GetSetting("OpenAI:ApiKey")
            ?? Repo.GetSetting("Codex:ApiKey")
            ?? string.Empty;
        _codexTranslateModel = Repo.GetSetting("OpenAI:TranslateModel")
            ?? Repo.GetSetting("Codex:TranslateModel")
            ?? CodexApiService.DefaultTranslateModel;
        _codexTranslateEffort = Repo.GetSetting("OpenAI:TranslateEffort") is { Length: > 0 } savedEffort
            ? savedEffort
            : CodexApiService.DefaultReasoningEffort;
        _aiProviders = AiProviders.GetSnapshot();
        _qrModelCodes = QrModelCodes.Codes.ToList();
        _snap        = NgRateSettings.GetSnapshot();

        _latest         = Repo.GetLatestBmesMaterial();
        _materialCount  = Repo.GetBmesMaterialCount();
    }

    // After the first render, not in OnInitializedAsync: prerendering would call OpenAI twice and
    // hold the whole page until the model list came back.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        HistoryJob.Changed += OnHistoryJobChanged;
        await LoadCodexModelsAsync();
        StateHasChanged();
    }

    // ── History cache ──────────────────────────────────────────────────────────

    private DateTime _historyFrom = new(DateTime.Today.Year - 2, 1, 1);

    private void StartHistoryCache()
    {
        if (!HistoryJob.Start(_historyFrom))
        {
            _statusMsg = "A history cache run is already in progress.";
            _statusError = true;
        }
    }

    private void OnHistoryJobChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => HistoryJob.Changed -= OnHistoryJobChanged;

