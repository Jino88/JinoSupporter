@page "/qr/bako-data"
@* Original route, kept so existing links and bookmarks still resolve. *@
@page "/bmes/qr-bako-data"
@rendermode InteractiveServer
@attribute [Authorize]
@using PortalGNLAB.Web.Services

<PageTitle>QR BAKO DATA</PageTitle>

<QrTestDataBrowser TableKey="@QrTestTables.BakoKey"
                   Kicker="BAKO TEST RESULTS · DB RECORDS"
                   Description="Select one or more dates to show the matching TCDB.dbo.BKTD rows together. TestResult is PASS / FAIL."
                   FocusDate="@DateQuery"
                   FocusProductId="@QrQuery" />

@code {
    // Set when QR SUMMARY opens this page on one of its cells.
    [SupplyParameterFromQuery(Name = "date")] public string? DateQuery { get; set; }
    [SupplyParameterFromQuery(Name = "qr")] public string? QrQuery { get; set; }
}
