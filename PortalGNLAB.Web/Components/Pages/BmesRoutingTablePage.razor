@page "/bmes/routing-table"
@rendermode InteractiveServer
@using PortalGNLAB.Web.Services
@using Microsoft.AspNetCore.Components.Web
@inject NgRateSettingsService    NgRateSettings
@inject BmesRoutingScrapeService BmesRoutingScrape
@inject BmesSettingsSyncService  BmesSettingsSync

<PageTitle>BMES Routing Table</PageTitle>

@{
    var models = GetFilteredModels();
    var rows = GetSelectedRows();
    var types = GetSelectedTypes();
    bool busy = _scrapeBusy || _serverSyncBusy;
}

<div class="rt-head">
    <div class="rt-title">
        <h5 class="mb-0 fw-semibold">Routing Table</h5>
        <span class="rt-sub">@_routingRows.Count rows &middot; @_modelCounts.Count models</span>
    </div>
    <div class="rt-toolbar">
        @if (_dirty)
        {
            <span class="rt-dirty" title="Local edits are not on the server until you click Update To Server.">Unsynced local changes</span>
        }
        <button class="btn btn-primary btn-sm" @onclick="RefreshRoutingFromBmes" disabled="@busy"
                title="Add missing routing rows from BMES API (GN, last 3 months)">
            Refresh from BMES
        </button>
        <button class="btn @(_dirty ? "btn-warning" : "btn-outline-secondary") btn-sm" @onclick="UpdateRoutingToServer" disabled="@busy"
                title="Send local Routing Table rows to the server DB">
            Update To Server
        </button>
        <button class="btn btn-outline-secondary btn-sm" @onclick="ImportRoutingFromFile" disabled="@busy"
                title="Import from Routing.txt (local only; then Update To Server)">
            Import from file
        </button>
    </div>
</div>

@if (_scrapeBusy || _serverSyncBusy || !string.IsNullOrEmpty(_statusMsg))
{
    <div class="rt-status @(_statusError ? "rt-status-err" : "")">
        @if (_scrapeBusy || _serverSyncBusy)
        {
            <span class="spinner-border spinner-border-sm" role="status" style="width:10px; height:10px;"></span>
        }
        <span class="flex-fill">@(string.IsNullOrEmpty(_statusMsg) ? "Working..." : _statusMsg)</span>
        @if (!busy)
        {
            <button class="rt-x" @onclick="() => _statusMsg = string.Empty" title="Dismiss">&times;</button>
        }
    </div>
}

<div class="rt-grid">
    <div class="rt-panel">
        <div class="rt-panel-head">
            <input class="rt-search" placeholder="Search model, process code or name" @bind="_modelSearch" @bind:event="oninput" />
        </div>
        <div class="rt-list">
            @foreach (var m in models)
            {
                <div class="rt-model @(m.Name == _selectedModel ? "rt-model-on" : "")" @onclick="() => SelectModel(m.Name)">
                    <span class="rt-model-name">@m.Name</span>
                    <span class="rt-count">@m.Count</span>
                </div>
            }
            @if (models.Count == 0)
            {
                <div class="rt-empty">No matching models.</div>
            }
        </div>
        <div class="rt-panel-foot">
            <input class="rt-search" placeholder="New model name" @bind="_newModel" @bind:event="oninput"
                   @onkeydown="OnNewModelKeyDown" />
            <button class="btn btn-outline-primary btn-sm" disabled="@string.IsNullOrWhiteSpace(_newModel)"
                    @onclick="AddProcessForNewModel">+ Add</button>
        </div>
    </div>

    <div class="rt-panel">
        <div class="rt-panel-head rt-right-head">
            <span class="rt-sel">@(string.IsNullOrEmpty(_selectedModel) ? "No model selected" : _selectedModel)</span>
            <span class="rt-sub">@rows.Count process(es)</span>
            <div class="ms-auto d-flex gap-2 align-items-center">
                <select class="rt-select" @bind="_typeFilter">
                    <option value="">All types</option>
                    @foreach (var t in types)
                    {
                        <option value="@t">@t</option>
                    }
                </select>
                <button class="btn btn-primary btn-sm" disabled="@string.IsNullOrEmpty(_selectedModel)"
                        @onclick="AddProcess">+ Add process</button>
            </div>
        </div>
        <div class="rt-table-wrap">
            <table class="bmes-table">
                <thead>
                    <tr>
                        <th style="min-width:130px;">ProcessCode</th>
                        <th style="min-width:200px;">ProcessName</th>
                        <th style="min-width:110px;">ProcessType</th>
                        <th style="width:90px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in rows)
                    {
                        @if (_editRoutingId == r.Id)
                        {
                            <tr class="bmes-edit-row">
                                <td><input class="bmes-input" @bind="_editRouting.ProcessCode" /></td>
                                <td><input class="bmes-input" @bind="_editRouting.ProcessName" /></td>
                                <td><input class="bmes-input" @bind="_editRouting.ProcessType" /></td>
                                <td class="bmes-actions">
                                    <button class="btn btn-success btn-sm py-0 px-2" @onclick="SaveRoutingEdit">Save</button>
                                    <button class="btn btn-secondary btn-sm py-0 px-2" @onclick="CancelRoutingEdit">Cancel</button>
                                </td>
                            </tr>
                        }
                        else
                        {
                            <tr class="bmes-row" @ondblclick="() => StartRoutingEdit(r)">
                                <td>@r.ProcessCode</td>
                                <td>@r.ProcessName</td>
                                <td>@r.ProcessType</td>
                                <td class="bmes-actions">
                                    <button class="btn btn-outline-primary btn-sm py-0 px-1" @onclick="() => StartRoutingEdit(r)" title="Edit">Edit</button>
                                    <button class="btn btn-outline-danger btn-sm py-0 px-1" @onclick="() => DeleteRoutingRow(r.Id)" title="Delete">Del</button>
                                </td>
                            </tr>
                        }
                    }
                    @if (rows.Count == 0)
                    {
                        <tr><td colspan="4" class="text-center text-muted py-4 small">No process rows.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .rt-head { display: flex; align-items: center; gap: 12px; margin-bottom: 8px; flex-wrap: wrap; }
    .rt-title { display: flex; align-items: baseline; gap: 10px; }
    .rt-sub { font-size: 11px; color: var(--ink-2, #4a5461); }
    .rt-toolbar { margin-left: auto; display: flex; gap: 6px; align-items: center; }
    .rt-dirty {
        font-size: 10px; text-transform: uppercase; letter-spacing: .4px; font-weight: 700;
        color: #8a5a00; background: #fff4d6; border: 1px solid #ecd28a; border-radius: 2px; padding: 2px 6px;
    }
    .rt-status {
        display: flex; align-items: center; gap: 8px; font-size: 12px; padding: 5px 10px; margin-bottom: 8px;
        border: 1px solid var(--line, #dde1e7); border-radius: 2px; background: var(--signal-wash, #edf0f4); color: var(--ink-2, #4a5461);
    }
    .rt-status-err { background: var(--crit-wash, #fbedec); color: #a12622; }
    .rt-x { border: 0; background: transparent; font-size: 16px; line-height: 1; color: inherit; padding: 0 4px; }
    .rt-grid { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: 10px; height: calc(var(--view-h, 100vh) - 190px); min-height: 320px; }
    .rt-panel { display: flex; flex-direction: column; min-height: 0; border: 1px solid var(--line, #dde1e7); border-radius: 2px; background: var(--panel, #fff); }
    .rt-panel-head, .rt-panel-foot {
        display: flex; gap: 6px; align-items: center; padding: 6px 8px; background: var(--panel-2, #f5f6f9);
    }
    .rt-panel-head { border-bottom: 1px solid var(--line, #dde1e7); }
    .rt-panel-foot { border-top: 1px solid var(--line, #dde1e7); }
    .rt-right-head { gap: 10px; }
    .rt-sel { font-weight: 700; font-size: 13px; }
    .rt-search, .rt-select {
        font-size: 11px; padding: 3px 6px; border: 1px solid var(--line, #dde1e7); border-radius: 2px;
        background: var(--panel, #fff); outline: none; color: var(--ink-2, #4a5461);
    }
    .rt-search { flex: 1; min-width: 0; }
    .rt-search:focus, .rt-select:focus { border-color: var(--signal, #16202b); }
    .rt-list { flex: 1; overflow-y: auto; }
    .rt-model { display: flex; justify-content: space-between; gap: 8px; padding: 5px 10px; font-size: 12px; cursor: pointer; border-bottom: 1px solid var(--line, #dde1e7); }
    .rt-model:hover { background: var(--panel-2, #f5f6f9); }
    .rt-model-on, .rt-model-on:hover { background: var(--signal-wash, #edf0f4); font-weight: 700; }
    .rt-model-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .rt-count { font-size: 10px; color: var(--ink-2, #4a5461); }
    .rt-empty { padding: 14px; font-size: 12px; color: var(--ink-2, #4a5461); text-align: center; }
    .rt-table-wrap { flex: 1; overflow: auto; }
    .bmes-table { width: 100%; border-collapse: collapse; font-size: 12px; white-space: nowrap; }
    .bmes-table thead th {
        background: var(--panel-2, #f5f6f9); font-weight: 700; font-size: 10px; color: var(--ink-2, #4a5461);
        text-transform: uppercase; letter-spacing: .4px; padding: 6px 10px;
        border: 1px solid var(--line, #dde1e7); position: sticky; top: 0; z-index: 2;
    }
    .bmes-table td { padding: 4px 10px; border: 1px solid var(--line, #dde1e7); vertical-align: middle; }
    .bmes-row:hover td { background: var(--panel-2, #f5f6f9); }
    .bmes-edit-row td { background: var(--signal-wash, #edf0f4); }
    .bmes-actions { text-align: center; white-space: nowrap; }
    .bmes-actions .btn { font-size: 10px; }
    .bmes-input {
        width: 100%; font-size: 12px; padding: 2px 6px; border: 1px solid var(--signal, #16202b);
        border-radius: 2px; background: var(--panel, #fff); outline: none;
    }
</style>

@code {
    private record ModelEntry(string Name, int Count);

    private List<RoutingRow> _routingRows = [];
    private List<ModelEntry> _modelCounts = [];
    private long _editRoutingId = -1;
    private long _newRoutingId = -1;
    private RoutingRow _editRouting = new();

    private string _modelSearch = string.Empty;
    private string _newModel = string.Empty;
    private string _selectedModel = string.Empty;
    private string _typeFilter = string.Empty;

    private bool _scrapeBusy;
    private bool _serverSyncBusy;
    private bool _dirty;
    private string _statusMsg = string.Empty;
    private bool _statusError;

    protected override void OnInitialized()
    {
        Reload();
        if (_modelCounts.Count > 0) _selectedModel = _modelCounts[0].Name;
    }

    private void Reload()
    {
        _routingRows = NgRateSettings.GetRoutingRows();
        _modelCounts = _routingRows
            .GroupBy(r => r.ModelName ?? string.Empty)
            .Where(g => g.Key.Length > 0)
            .Select(g => new ModelEntry(g.Key, g.Count()))
            .OrderBy(m => m.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (!string.IsNullOrEmpty(_selectedModel) && _modelCounts.All(m => m.Name != _selectedModel)
            && _routingRows.All(r => r.ModelName != _selectedModel))
            _selectedModel = _modelCounts.Count > 0 ? _modelCounts[0].Name : string.Empty;
        if (string.IsNullOrEmpty(_selectedModel) && _modelCounts.Count > 0)
            _selectedModel = _modelCounts[0].Name;
    }

    private List<ModelEntry> GetFilteredModels()
    {
        string q = _modelSearch.Trim();
        if (q.Length == 0) return _modelCounts;
        var byProcess = _routingRows
            .Where(r => (r.ProcessCode ?? string.Empty).Contains(q, StringComparison.OrdinalIgnoreCase)
                     || (r.ProcessName ?? string.Empty).Contains(q, StringComparison.OrdinalIgnoreCase))
            .Select(r => r.ModelName)
            .ToHashSet();
        return _modelCounts
            .Where(m => m.Name.Contains(q, StringComparison.OrdinalIgnoreCase) || byProcess.Contains(m.Name))
            .ToList();
    }

    private List<RoutingRow> GetSelectedRows()
    {
        if (string.IsNullOrEmpty(_selectedModel)) return [];
        return _routingRows
            .Where(r => r.ModelName == _selectedModel
                     && (string.IsNullOrEmpty(_typeFilter) || r.ProcessType == _typeFilter))
            .ToList();
    }

    private List<string> GetSelectedTypes() => _routingRows
        .Where(r => r.ModelName == _selectedModel && !string.IsNullOrWhiteSpace(r.ProcessType))
        .Select(r => r.ProcessType)
        .Distinct()
        .OrderBy(t => t, StringComparer.OrdinalIgnoreCase)
        .ToList();

    private void SelectModel(string name)
    {
        DiscardUnsavedNewRow();
        _selectedModel = name;
        _typeFilter = string.Empty;
        _editRoutingId = -1;
    }

    private void AddProcess()
    {
        if (string.IsNullOrEmpty(_selectedModel)) return;
        DiscardUnsavedNewRow();
        var newRow = new RoutingRow { ModelName = _selectedModel };
        long newId = NgRateSettings.AddRoutingRow(newRow);
        Reload();
        _typeFilter = string.Empty;
        _editRoutingId = newId;
        _newRoutingId = newId;
        _editRouting = new RoutingRow { Id = newId, ModelName = _selectedModel };
        MarkDirty("Process row added locally.");
    }

    private void AddProcessForNewModel()
    {
        string name = _newModel.Trim();
        if (name.Length == 0) return;
        DiscardUnsavedNewRow();     // before switching: Reload would drop a model that has no rows yet
        _selectedModel = name;
        _newModel = string.Empty;
        _modelSearch = string.Empty;
        AddProcess();
    }

    private void OnNewModelKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddProcessForNewModel();
    }

    private void StartRoutingEdit(RoutingRow r)
    {
        if (r.Id != _newRoutingId) DiscardUnsavedNewRow();
        _editRoutingId = r.Id;
        _editRouting = new RoutingRow
        {
            Id = r.Id,
            ModelName = r.ModelName,
            ProcessCode = r.ProcessCode,
            ProcessName = r.ProcessName,
            ProcessType = r.ProcessType,
        };
    }

    private void SaveRoutingEdit()
    {
        NgRateSettings.UpdateRoutingRow(_editRouting);
        _editRoutingId = -1;
        _newRoutingId = -1;
        Reload();
        MarkDirty("Process row saved locally.");
    }

    private void CancelRoutingEdit()
    {
        DiscardUnsavedNewRow();
        _editRoutingId = -1;
    }

    /// <summary>A row created by "+ Add" and left before its first save is removed again,
    /// so an empty row never reaches Update To Server.</summary>
    private void DiscardUnsavedNewRow()
    {
        if (_newRoutingId <= 0) return;
        NgRateSettings.DeleteRoutingRow(_newRoutingId);
        if (_editRoutingId == _newRoutingId) _editRoutingId = -1;
        _newRoutingId = -1;
        Reload();
        SetStatus("Unsaved new process row discarded.", false);
    }

    private void DeleteRoutingRow(long id)
    {
        NgRateSettings.DeleteRoutingRow(id);
        if (_editRoutingId == id) _editRoutingId = -1;
        if (_newRoutingId == id) _newRoutingId = -1;
        Reload();
        MarkDirty("Process row deleted locally.");
    }

    private void ImportRoutingFromFile()
    {
        int count = NgRateSettings.ImportRoutingFromFile(NgRateSettings.RoutingFilePath);
        _editRoutingId = -1;
        Reload();
        if (count > 0)
            MarkDirty($"Imported {count} routing rows locally.");
        else
            SetStatus("File not found or empty.", true);
    }

    private async Task RefreshRoutingFromBmes()
    {
        if (_scrapeBusy) return;
        _scrapeBusy = true;
        SetStatus(string.Empty, false);
        StateHasChanged();

        try
        {
            var progress = new Progress<string>(msg =>
            {
                _statusMsg = msg;
                _statusError = false;
                InvokeAsync(StateHasChanged);
            });

            int saved = await BmesRoutingScrape.FetchAllAsync(progress);
            if (saved < 0)
            {
                // Service already reported the reason through progress; mark it as an error.
                _statusError = true;
                if (string.IsNullOrEmpty(_statusMsg)) _statusMsg = "Refresh from BMES failed.";
            }
            else
            {
                _editRoutingId = -1;
                Reload();
                MarkDirty($"Refreshed from BMES: {saved} row(s) received.");
            }
        }
        catch (Exception ex)
        {
            SetStatus($"Refresh from BMES failed: {ex.Message}", true);
        }
        finally
        {
            _scrapeBusy = false;
            StateHasChanged();
        }
    }

    private async Task UpdateRoutingToServer()
    {
        if (_serverSyncBusy) return;
        DiscardUnsavedNewRow();
        _serverSyncBusy = true;
        SetStatus("Updating server...", false);
        StateHasChanged();
        try
        {
            Reload();
            var result = await BmesSettingsSync.SyncRoutingRowsAsync(_routingRows);
            if (result.Succeeded)
            {
                _dirty = false;
                SetStatus($"Routing table updated to server ({result.Rows} rows).", false);
            }
            else
            {
                SetStatus($"Server update failed. Local DB is unchanged: {result.Message}", true);
            }
        }
        catch (Exception ex)
        {
            SetStatus($"Server update failed: {ex.Message}", true);
        }
        finally
        {
            _serverSyncBusy = false;
            StateHasChanged();
        }
    }

    private void MarkDirty(string msg)
    {
        _dirty = true;
        SetStatus($"{msg} Click Update To Server to sync.", false);
    }

    private void SetStatus(string msg, bool isError)
    {
        _statusMsg = msg;
        _statusError = isError;
    }
}
