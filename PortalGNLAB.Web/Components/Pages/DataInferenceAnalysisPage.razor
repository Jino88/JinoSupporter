        padding: 60px; text-align: center; color: var(--ink-3, #7f8a98); font-size: 14px; line-height: 1.7;
    }
    .dian-empty-fill { flex: 1; display: flex; align-items: center; justify-content: center; padding: 20px; }
</style>

@code {
    private sealed record AnalysisDatasetItem(
        string DatasetName,
        string ProductType,
        string ReportDate,
        string Title,
        string ReportType,
        string PrimaryDefect,
        string SourceFile,
        int ResultCount,
        List<string> Tags);

    private sealed record TagSummary(string Tag, int Count);
    private sealed record TsvCell(string Value, string? Bg, string? Fg, bool Bold);
    private sealed record TsvSheet(string Name, List<List<TsvCell>> Rows);

    private List<AnalysisDatasetItem> _items = [];
    private List<TagSummary> _tagSummaries = [];
    private string? _selectedTag;
    private string? _selectedDataset;
    private string _selectedExcelPaste = "";
    private string _excelView = "table";
    private string _search = "";

    private AnalysisDatasetItem? SelectedItem
        => _selectedDataset is null
            ? null
            : _items.FirstOrDefault(x => string.Equals(x.DatasetName, _selectedDataset, StringComparison.Ordinal));

    private List<AnalysisDatasetItem> FilteredItems
    {
        get
        {
            IEnumerable<AnalysisDatasetItem> query = _items;
            if (!string.IsNullOrWhiteSpace(_selectedTag))
            {
                query = query.Where(x => x.Tags.Contains(_selectedTag, StringComparer.OrdinalIgnoreCase));
            }
            if (!string.IsNullOrWhiteSpace(_search))
            {
                string s = _search.Trim();
                query = query.Where(x =>
                    x.DatasetName.Contains(s, StringComparison.OrdinalIgnoreCase)
                    || x.Title.Contains(s, StringComparison.OrdinalIgnoreCase)
                    || x.Tags.Any(t => t.Contains(s, StringComparison.OrdinalIgnoreCase)));
            }
            return query
                .OrderByDescending(x => !string.IsNullOrWhiteSpace(x.ReportDate) ? x.ReportDate : "")
                .ThenBy(x => x.DatasetName, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
    }

    private List<TagSummary> VisibleTags
    {
        get
        {
            IEnumerable<TagSummary> query = _tagSummaries;
            if (!string.IsNullOrWhiteSpace(_search))
            {
                string s = _search.Trim();
                query = query.Where(x => x.Tag.Contains(s, StringComparison.OrdinalIgnoreCase)
                                         || _items.Any(i =>
                                             i.Tags.Contains(x.Tag, StringComparer.OrdinalIgnoreCase)
                                             && (i.DatasetName.Contains(s, StringComparison.OrdinalIgnoreCase)
                                                 || i.Title.Contains(s, StringComparison.OrdinalIgnoreCase))));
            }
            return query.Take(300).ToList();
        }
    }

    protected override void OnInitialized() => Reload();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await JS.InvokeVoidAsync("diFullPage.enter");
    }

    private void Reload()
    {
        var list = new List<AnalysisDatasetItem>();
        foreach (var report in Repo.GetAllRawReports())
        {
            DatasetSummaryRecord? summary = Repo.GetDatasetSummaryRecord(report.DatasetName);
            AiDocBundle? doc = Repo.GetAiDocBundle(report.DatasetName);
            if (summary is null && doc is null) continue;

            var tags = BuildTags(report, summary, doc);
            if (tags.Count == 0) tags.Add("untagged");

            string title = FirstNonBlank(doc?.Title, summary?.Headline, summary?.Summary, report.DatasetName);
            string reportType = FirstNonBlank(doc?.ReportType, summary?.ReportType);
            string primary = FirstNonBlank(doc?.PrimaryDefect, doc?.RelatedDefects.FirstOrDefault(), doc?.Hints.FirstOrDefault()?.DefectName);
            string sourceFile = FirstNonBlank(doc?.SourceFile, report.DatasetName);
            string reportDate = FirstNonBlank(doc?.ReportDate, report.ReportDate);
            int resultCount = doc?.Results.Count ?? report.MeasurementCount;

            list.Add(new AnalysisDatasetItem(
                report.DatasetName,
                report.ProductType,
                reportDate,
                title,
                reportType,
                primary,
                sourceFile,
                resultCount,
                tags));
        }

        _items = list;
        _tagSummaries = _items
            .SelectMany(x => x.Tags.Distinct(StringComparer.OrdinalIgnoreCase))
            .GroupBy(x => x, StringComparer.OrdinalIgnoreCase)
            .Select(g => new TagSummary(g.Key, g.Count()))
            .OrderByDescending(x => x.Count)
            .ThenBy(x => x.Tag, StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (_selectedDataset is not null && _items.All(x => x.DatasetName != _selectedDataset))
        {
            _selectedDataset = null;
            _selectedExcelPaste = "";
        }
        if (_selectedTag is not null && _tagSummaries.All(x => !string.Equals(x.Tag, _selectedTag, StringComparison.OrdinalIgnoreCase)))
        {
            _selectedTag = null;
        }
    }

    private void OnSearchChanged(ChangeEventArgs e) => _search = e.Value?.ToString() ?? "";

    private void SelectTag(string tag)
    {
        _selectedTag = tag;
        _selectedDataset = null;
        _selectedExcelPaste = "";
    }

    private void ClearTag()
    {
        _selectedTag = null;
        _selectedDataset = null;
        _selectedExcelPaste = "";
    }

    private void SelectDataset(string datasetName)
    {
        _selectedDataset = datasetName;
        _selectedExcelPaste = Repo.GetExtractedText(datasetName, WebRepository.TextKindExcelPaste) ?? "";
        _excelView = "table";
    }

    private bool IsSelectedTag(string tag)
        => string.Equals(_selectedTag, tag, StringComparison.OrdinalIgnoreCase);

    private bool IsSelectedDataset(string datasetName)
        => string.Equals(_selectedDataset, datasetName, StringComparison.Ordinal);

    private static List<string> BuildTags(RawReportInfo report, DatasetSummaryRecord? summary, AiDocBundle? doc)
    {
        var set = new SortedSet<string>(StringComparer.OrdinalIgnoreCase);
        if (summary?.Tags is not null)
        {
            foreach (string tag in summary.Tags) AddTag(set, tag);
        }

        AddTag(set, report.ProductType);
        AddTag(set, doc?.ReportType ?? summary?.ReportType);
        AddTag(set, doc?.PrimaryDefect);
        foreach (string value in doc?.RelatedDefects ?? []) AddTag(set, value);
        foreach (string value in doc?.Parts ?? []) AddTag(set, value);
        foreach (string value in doc?.Processes ?? []) AddTag(set, value);
        foreach (var result in doc?.Results ?? [])
        {
            AddTag(set, result.MeasurementType);
            AddTag(set, result.ConditionProcess);
            AddTag(set, result.ChangedFactor);
            AddTag(set, result.MetricName);
        }
        foreach (var hint in doc?.Hints ?? [])
        {
            AddTag(set, hint.DefectName);
            AddTag(set, hint.RelatedProcess);
            AddTag(set, hint.RelatedPart);
        }
        if (summary?.Context is not null)
        {
            AddTag(set, summary.Context.Process);
            AddTag(set, summary.Context.Stage);
        }
        foreach (var evidence in summary?.Evidence ?? [])
        {
            AddTag(set, evidence.Metric);
        }

        return set.Take(80).ToList();
    }

    private static void AddTag(SortedSet<string> set, string? raw)
    {
        string tag = NormalizeTag(raw);
        if (string.IsNullOrWhiteSpace(tag)) return;
        set.Add(tag);
    }

    private static string NormalizeTag(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return "";
        string s = raw.Trim().ToLowerInvariant();
        if (s.Length > 70) return "";

        var sb = new System.Text.StringBuilder(s.Length);
        bool lastDash = false;
        foreach (char ch in s)
        {
            if (char.IsLetterOrDigit(ch))
            {
                sb.Append(ch);
                lastDash = false;
            }
            else if (!lastDash)
            {
                sb.Append('-');
                lastDash = true;
            }
        }
        string tag = sb.ToString().Trim('-');
        if (tag.Length < 2) return "";

        string[] stop =
        [
            "test", "normal", "result", "report", "clean", "sheet", "input", "ok", "ng",
            "date", "line", "total", "rate", "summary", "unknown", "none"
        ];
        if (stop.Contains(tag, StringComparer.OrdinalIgnoreCase)) return "";
        if (System.Text.RegularExpressions.Regex.IsMatch(tag, @"^\d{4}-\d{2}-\d{2}$")) return "";
        return tag;
    }

    private static string FirstNonBlank(params string?[] values)
        => values.FirstOrDefault(v => !string.IsNullOrWhiteSpace(v))?.Trim() ?? "";

    private static string ShortText(string text, int max)
    {
        if (string.IsNullOrWhiteSpace(text)) return "";
        text = text.Trim();
        return text.Length <= max ? text : text[..Math.Max(0, max - 1)] + "...";
    }

    private static List<TsvSheet> ParsePastedTsv(string tsv)
    {
        var sheets = new List<TsvSheet>();
        if (string.IsNullOrWhiteSpace(tsv)) return sheets;

        string currentName = "Sheet 1";
        var currentRows = new List<List<TsvCell>>();
        bool seenSheetHeader = false;

        void FlushSheet()
        {
            if (seenSheetHeader || currentRows.Count > 0)
            {
                sheets.Add(new TsvSheet(currentName, currentRows));
            }
        }

        foreach (string rawLine in tsv.Split('\n'))
        {
            string line = rawLine.TrimEnd('\r');
            if (line.StartsWith("### WORKBOOK:", StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }
            if (line.StartsWith("## ", StringComparison.Ordinal)
                || line.StartsWith("=== SHEET:", StringComparison.OrdinalIgnoreCase))
            {
                if (seenSheetHeader) FlushSheet();
                currentName = $"Sheet {sheets.Count + 1}";
                currentRows = [];
                seenSheetHeader = true;
                continue;
            }
            if (line.StartsWith("DIMENSION:", StringComparison.OrdinalIgnoreCase)
                || line.StartsWith("MERGED:", StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }
            if (string.IsNullOrEmpty(line)) continue;

            var cells = new List<TsvCell>();
            string rowText = line;
            var renderedRow = System.Text.RegularExpressions.Regex.Match(
                line,
                @"^\s*\[r\d+\]\s*(.*)$",
                System.Text.RegularExpressions.RegexOptions.IgnoreCase);
            string[] rawCells = renderedRow.Success
                ? System.Text.RegularExpressions.Regex.Split(renderedRow.Groups[1].Value, @"\s+\|\s+")
                : rowText.Split('\t');

            foreach (string raw in rawCells)
            {
                var cell = ParseCell(raw);
                if (!string.IsNullOrWhiteSpace(cell.Value)) cells.Add(cell);
            }
            if (cells.Count > 0) currentRows.Add(cells);
        }

        if (seenSheetHeader) FlushSheet();
        else if (currentRows.Count > 0) sheets.Add(new TsvSheet("Sheet 1", currentRows));
        return sheets;
    }

    private static TsvCell ParseCell(string raw)
    {
        const char open = '\u3014';
        const char close = '\u3015';
        if (raw.Length == 0 || raw[0] != open) return new TsvCell(CleanExcelDisplayText(raw), null, null, false);
        int end = raw.IndexOf(close);
        if (end < 0) return new TsvCell(CleanExcelDisplayText(raw), null, null, false);

        string tag = raw[1..end];
        string value = raw[(end + 1)..];
        string? bg = null;
        string? fg = null;
        bool bold = false;
        foreach (string part in tag.Split(','))
        {
            string p = part.Trim();
            if (p.StartsWith("bg=", StringComparison.Ordinal)) bg = p[3..];
            else if (p.StartsWith("fg=", StringComparison.Ordinal)) fg = p[3..];
            else if (p == "b") bold = true;
        }
        return new TsvCell(CleanExcelDisplayText(value), bg, fg, bold);
    }

    private static string DisplayExcelSourceText(string rawText)
    {
        var sheets = ParsePastedTsv(rawText);
        if (sheets.Count == 0) return "";

        var sb = new System.Text.StringBuilder();
        for (int i = 0; i < sheets.Count; i++)
        {
            if (i > 0) sb.AppendLine();
            sb.AppendLine(sheets[i].Name);
            foreach (var row in sheets[i].Rows)
            {
                sb.AppendLine(string.Join("\t", row.Select(cell => CleanExcelDisplayText(cell.Value))));
            }
        }
        return sb.ToString().TrimEnd();
    }

    private static string CellStyle(TsvCell cell)
    {
        var sb = new System.Text.StringBuilder();
        if (!string.IsNullOrWhiteSpace(cell.Bg)) sb.Append("background:").Append(cell.Bg).Append(';');
        if (!string.IsNullOrWhiteSpace(cell.Fg)) sb.Append("color:").Append(cell.Fg).Append(';');
        if (cell.Bold) sb.Append("font-weight:700;");
        return sb.ToString();
    }

    private static string CleanExcelSerialDateText(string? value)
    {
        string text = value ?? "";
        if (string.IsNullOrWhiteSpace(text)) return "";

        text = System.Text.RegularExpressions.Regex.Replace(
            text,
            @"\b(?:Excel\s+serial(?:\s+date)?|serial\s+date)\s+([0-9]{5}(?:\.\d+)?)\s*(?:=|:|->)?\s*(\d{4}-\d{2}-\d{2})\b",
            "$2",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        text = System.Text.RegularExpressions.Regex.Replace(
            text,
            @"\b([0-9]{5}(?:\.\d+)?)\s*\(=\s*(\d{4}-\d{2}-\d{2})\)",
            "$2");

        text = System.Text.RegularExpressions.Regex.Replace(
            text,
            @"\b(?:Excel\s+serial(?:\s+date)?|serial\s+date)\s+([0-9]{5}(?:\.\d+)?)\b",
            m => TryExcelSerialDate(m.Groups[1].Value, out DateTime date)
                ? date.ToString("yyyy-MM-dd")
                : m.Value,
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        return text.Trim();
    }

    private static string CleanExcelDisplayText(string? value)
    {
        string text = CleanExcelSerialDateText(value);
        if (string.IsNullOrWhiteSpace(text)) return "";

        var options = System.Text.RegularExpressions.RegexOptions.IgnoreCase;
        text = System.Text.RegularExpressions.Regex.Replace(
            text,
            @"^\s*\{(?:merged|cell|cells|ref|range|source|sheet)[^}]*\}\s*",
            "",
            options);
        text = System.Text.RegularExpressions.Regex.Replace(
            text,
            @"^\s*\u3014(?:merged|cell|cells|ref|range|source|sheet)[^\u3015]*\u3015\s*",
            "",
            options);
        text = System.Text.RegularExpressions.Regex.Replace(
            text,
            @"^\s*(?:'[^'\r\n]+'|[^!\t\r\n|]{1,80})![A-Z]{1,3}\d+(?::[A-Z]{1,3}\d+)?\s*[:=]\s*",
            "",
            options);
        text = System.Text.RegularExpressions.Regex.Replace(
            text,
            @"^\s*[A-Z]{1,3}\d+(?::[A-Z]{1,3}\d+)?\s*[:=]\s*",
            "",
            options);
        return text.Trim();
    }

    private static bool TryExcelSerialDate(string? value, out DateTime date)
    {
        date = default;
        string text = (value ?? "").Trim();
        if (!System.Text.RegularExpressions.Regex.IsMatch(text, @"^\d{5}(?:\.0+)?$")) return false;
        if (!double.TryParse(text, System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture, out double serial)) return false;
        if (serial < 20000 || serial > 80000) return false;
        try
        {
            date = DateTime.FromOADate(serial).Date;
            return date.Year is >= 1954 and <= 2119;
        }
        catch
        {
            return false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("diFullPage.leave"); } catch { }
    }
}
