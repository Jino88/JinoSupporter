@page "/data-inference/analysis"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject WebRepository Repo
@inject IJSRuntime JS

<PageTitle>Data Inference - Aggregated Results</PageTitle>

<div class="dian-root">
    <div class="dian-header">
        <div>
            <div class="dian-title">Aggregated Results</div>
            <div class="dian-subtitle">AI analyzed reports grouped by tags. Select a tag, then a file, then review the Excel sheet data.</div>
        </div>
        <div class="dian-spacer"></div>
        <input class="form-control form-control-sm dian-search"
               placeholder="Search tag or file"
               value="@_search"
               @oninput="OnSearchChanged" />
        <button class="btn btn-outline-secondary btn-sm" @onclick="Reload">Refresh</button>
    </div>

    <div class="dian-statbar">
        <span class="dian-stat">@_items.Count analyzed file(s)</span>
        <span class="dian-stat">@_tagSummaries.Count tag(s)</span>
        @if (!string.IsNullOrWhiteSpace(_selectedTag))
        {
            <span class="dian-stat dian-stat-active">@FilteredItems.Count item(s) for @_selectedTag</span>
        }
    </div>

    @if (_items.Count == 0)
    {
        <div class="dian-empty">
            No AI analyzed reports are available yet.
        </div>
    }
    else
    {
        <div class="dian-workspace">
            <aside class="dian-tags-pane">
                <div class="dian-pane-head">
                    <strong>Tags</strong>
                    <button class="dian-link-btn" @onclick="ClearTag" disabled="@string.IsNullOrWhiteSpace(_selectedTag)">All</button>
                </div>
                <div class="dian-tags-list">
                    @foreach (var tag in VisibleTags)
                    {
                        <button class="dian-tag-btn @(IsSelectedTag(tag.Tag) ? "active" : "")"
                                title="@tag.Tag"
                                @onclick="() => SelectTag(tag.Tag)">
                            <span>@tag.Tag</span>
                            <em>@tag.Count</em>
                        </button>
                    }
                </div>
            </aside>

            <aside class="dian-files-pane">
                <div class="dian-pane-head">
                    <strong>Files</strong>
                    <span>@FilteredItems.Count</span>
                </div>
                <div class="dian-file-list">
                    @foreach (var item in FilteredItems)
                    {
                        <button class="dian-file-btn @(IsSelectedDataset(item.DatasetName) ? "active" : "")"
                                @onclick="() => SelectDataset(item.DatasetName)">
                            <span class="dian-file-name">@item.DatasetName</span>
                            <span class="dian-file-title">@ShortText(item.Title, 120)</span>
                            <span class="dian-file-meta">
                                @if (!string.IsNullOrWhiteSpace(item.ReportType))
                                {
                                    <span>@item.ReportType</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.PrimaryDefect))
                                {
                                    <span>@item.PrimaryDefect</span>
                                }
                                @if (item.ResultCount > 0)
                                {
                                    <span>@item.ResultCount result(s)</span>
                                }
                            </span>
                        </button>
                    }
                </div>
            </aside>

            <main class="dian-excel-pane">
                @if (SelectedItem is null)
                {
                    <div class="dian-empty dian-empty-fill">
                        Select a tag and file to show the Excel sheet data.
                    </div>
                }
                else
                {
                    <div class="dian-excel-head">
                        <div>
                            <div class="dian-excel-file">@SelectedItem.DatasetName</div>
                            <div class="dian-excel-title">@SelectedItem.Title</div>
                        </div>
                        <div class="dian-view-toggle">
                            <button class="dian-view-btn @(_excelView == "table" ? "active" : "")"
                                    @onclick='() => _excelView = "table"'
                                    disabled="@string.IsNullOrWhiteSpace(_selectedExcelPaste)">Table</button>
                            <button class="dian-view-btn @(_excelView == "text" ? "active" : "")"
                                    @onclick='() => _excelView = "text"'
                                    disabled="@string.IsNullOrWhiteSpace(_selectedExcelPaste)">Text</button>
                        </div>
                    </div>

                    @if (SelectedItem.Tags.Count > 0)
                    {
                        <div class="dian-selected-tags">
                            @foreach (var t in SelectedItem.Tags.Take(18))
                            {
                                <button @onclick="() => SelectTag(t)" class="dian-mini-tag">@t</button>
                            }
                        </div>
                    }

                    @if (string.IsNullOrWhiteSpace(_selectedExcelPaste))
                    {
                        <div class="dian-empty dian-empty-fill">
                            This file has no saved Excel paste data.
                        </div>
                    }
                    else if (_excelView == "text")
                    {
                        <pre class="dian-excel-text">@DisplayExcelSourceText(_selectedExcelPaste)</pre>
                    }
                    else
                    {
                        <div class="dian-table-preview">
                            @foreach (var sheet in ParsePastedTsv(_selectedExcelPaste))
                            {
                                <div class="dian-sheet-name">@sheet.Name</div>
                                <div class="dian-sheet-scroll">
                                    <table class="dian-preview-table">
                                        <tbody>
                                            @foreach (var row in sheet.Rows)
                                            {
                                                <tr>
                                                    @foreach (var cell in row)
                                                    {
                                                        <td style="@CellStyle(cell)">@CleanExcelDisplayText(cell.Value)</td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    }
                }
            </main>
        </div>
    }
</div>

<style>
    .dian-root {
        flex: 1; min-height: 0; display: flex; flex-direction: column;
        overflow: hidden; background: var(--panel-2, #f5f6f9); color: var(--ink, #0f1319);
    }
    .dian-header {
        display: flex; align-items: center; gap: 10px; padding: 10px 14px;
        background: var(--panel, #fff); border-bottom: 1px solid var(--line, #dde1e7); flex-shrink: 0;
    }
    .dian-title { font-size: 15px; font-weight: 750; }
    .dian-subtitle { font-size: 11px; color: var(--ink-3, #7f8a98); margin-top: 2px; }
    .dian-spacer { flex: 1; }
    .dian-search { width: 260px; }
    .dian-statbar {
        display: flex; gap: 6px; padding: 8px 14px; background: var(--panel, #fff);
        border-bottom: 1px solid var(--line, #dde1e7); flex-shrink: 0;
    }
    .dian-stat {
        font-size: 11px; font-weight: 650; padding: 2px 9px; border-radius: 2px;
        background: var(--panel-3, #eceef2); color: var(--ink-2, #4a5461);
    }
    .dian-stat-active { background: var(--ok-wash, #eaf1f9); color: var(--ok, #1f5fa8); }
    .dian-workspace {
        flex: 1; min-height: 0; display: grid;
        grid-template-columns: minmax(210px, 260px) minmax(300px, 400px) minmax(0, 1fr);
        overflow: hidden;
    }
    .dian-tags-pane, .dian-files-pane, .dian-excel-pane {
        min-height: 0; overflow: hidden; background: var(--panel, #fff);
        border-right: 1px solid var(--line, #dde1e7);
    }
