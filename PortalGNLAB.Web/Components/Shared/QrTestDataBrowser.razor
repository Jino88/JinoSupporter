@using System.Globalization
@using PortalGNLAB.Web.Services
@inject QrTestDataService QrData
@inject QrModelCodeService QrModelCodes
@inject QrViewPreferenceService QrViewPrefs
@inject IJSRuntime JS
@implements IDisposable

<div class="qr-date-browser">
    <header class="qr-titlebar">
        <div>
            <div class="qr-kicker">@Kicker</div>
            <h1>@Table.MenuLabel</h1>
            <p>@Description</p>
        </div>
        <div class="qr-actions">
            <span class="qr-connection">@ConnectionLabel</span>
            <button class="qr-btn qr-primary"
                    type="button"
                    @onclick="RefreshAsync"
                    disabled="@(_busy || !QrData.IsConfigured)">
                @if (_busy)
                {
                    <span class="qr-spinner" aria-hidden="true"></span>
                    <span>Loading</span>
                }
                else
                {
                    <span>Refresh</span>
                }
            </button>
            <button class="qr-btn"
                    type="button"
                    title="Two sheets: the newest test per QR, and every row of the selected dates"
                    @onclick="ExportExcelAsync"
                    disabled="@(_busy || _exporting || _result is null || _result.Rows.Count == 0)">
                @if (_exporting)
                {
                    <span class="qr-spinner" aria-hidden="true"></span>
                    <span>Exporting</span>
                }
                else
                {
                    <span>XLSX</span>
                }
            </button>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="qr-alert qr-danger">@_error</div>
    }

    @if (!string.IsNullOrWhiteSpace(_notice))
    {
        <div class="qr-alert qr-warning">@_notice</div>
    }

    @if (_result is not null && !string.IsNullOrWhiteSpace(_result.WarningMessage))
    {
        <div class="qr-alert qr-warning">@_result.WarningMessage</div>
    }

    @if (!QrData.IsConfigured)
    {
        <div class="qr-alert qr-warning">QR DB password is not configured on the server.</div>
    }

    @if (_busy && _result is null)
    {
        <div class="qr-state-panel">
            <span class="qr-spinner" aria-hidden="true"></span>
            <span>Loading the date list from TCDB.@Table.DisplayTable</span>
        </div>
    }
    else if (_result is null)
    {
        <div class="qr-state-panel">No data loaded.</div>
    }
    else
    {
        <div class="qr-browser-grid" aria-busy="@_busy.ToString().ToLowerInvariant()">
            <aside class="qr-date-panel">
                <div class="qr-section-head">
                    <div>
                        <strong>Test dates</strong>
                        <span>@_selectedDates.Count.ToString("N0") selected</span>
                    </div>
                    <small>TestTime · multi-select</small>
                </div>

                <div class="qr-date-list">
                    @if (_result.Dates.Count == 0)
                    {
                        <div class="qr-empty">No dates to show.</div>
                    }
                    else
                    {
                        @foreach (var date in _result.Dates)
                        {
                            <label class="@DateOptionClass(date.Date)">
                                <input class="qr-date-check"
                                       type="checkbox"
                                       checked="@_selectedDates.Contains(date.Date)"
                                       disabled="@_busy"
                                       @onchange="async _ => await ToggleDateAsync(date.Date)" />
                                <span class="qr-date-label">@FormatDate(date.Date)</span>
                                <span class="qr-date-count">@date.RowCount.ToString("N0") rows</span>
                            </label>
                        }
                    }
                </div>
            </aside>

            <section class="qr-data-panel">
                <div class="qr-section-head qr-table-head">
                    <div>
                        <strong>@SelectedDatesLabel</strong>
                        <span>Test data</span>
                    </div>
                    <div class="qr-row-summary">
                        <span>Shown @VisibleGroups.Count.ToString("N0") QR@(IsFiltered ? $" of {_rowGroups.Count:N0}" : string.Empty)</span>
                        <span>Fetched @_result.Rows.Count.ToString("N0") rows</span>
                        @if (_result.TotalRows is long totalRows)
                        {
                            <span>DB total @totalRows.ToString("N0") rows</span>
                        }
                        @if (_result.ExcludedRows is long excludedRows)
                        {
                            <span class="@(excludedRows > 0 ? "qr-excluded" : string.Empty)">Excluded @excludedRows.ToString("N0") rows</span>
                        }
                        <span>@_result.Columns.Count.ToString("N0") columns</span>
                        @if (_result.ValidTotalRows is long validTotal && validTotal > _result.Rows.Count)
                        {
                            <b>Limited to the latest @_result.MaxRows.ToString("N0") rows · QR groups follow the shown range</b>
                        }
                    </div>
                </div>

                @if (DisplaySummary is QrTestDataSummary summary)
                {
                    <div class="@(IsFiltered ? "qr-summary-grid qr-summary-filtered" : "qr-summary-grid")"
                         aria-label="@(IsFiltered ? "QR summary for the filtered rows" : "QR summary for the selected dates")">
                        <article class="qr-summary-card">
                            <span>Input count@(IsFiltered ? " · filtered" : string.Empty)</span>
                            <strong>@summary.InputCount.ToString("N0")</strong>
                            <small>@InputCountNote</small>
                        </article>
                        <article class="qr-summary-card">
                            <span>NG count@(IsFiltered ? " · filtered" : string.Empty)</span>
                            <strong>@summary.NgCount.ToString("N0")</strong>
                            <small>@NgCountNote</small>
                        </article>
                        <article class="qr-summary-card">
                            <span>NG Rate@(IsFiltered ? " · filtered" : string.Empty)</span>
                            <strong>@FormatPpm(summary.NgRatePpm)</strong>
                            <small>NG ÷ Input × 1,000,000 (ppm)</small>
                        </article>
                    </div>
                }

                @* One failing QR usually trips several items at once — 47% of them over the week of
                   2026-09-17 — so each item carries its own total, and unfolding it shows how that
                   total splits between failing alone and failing with others. A combination sits
                   under every item it contains, which is why the totals sum past the NG count. *@
                @if (_ngItemGroups.Count > 0 || _ngUnspecified > 0)
                {
                    <div class="qr-ng-items" aria-label="NG items, unfold one to see its combinations">
                        <div class="qr-ng-head">
                            <strong>NG by item</strong>
                            <span>
                                @_ngRowCount.ToString("N0") NG QR shown · @_ngItemTotalSum.ToString("N0") item NG in
                                @_ngComboCount.ToString("N0") combinations
                                @if (_ngMultiCount > 0)
                                {
                                    <b> · @_ngMultiCount.ToString("N0") failed 2+ items</b>
                                }
                                · click an item to unfold what it failed with
                            </span>
                        </div>
                        <div class="qr-ng-list">
                            @foreach (NgItemGroup group in _ngItemGroups)
                            {
                                bool expanded = _expandedNgItems.Contains(group.Label);
                                <span class="@(expanded ? "qr-ng-group qr-ng-open" : "qr-ng-group")">
                                    <button class="qr-ng-chip qr-ng-parent"
                                            type="button"
                                            aria-expanded="@expanded.ToString().ToLowerInvariant()"
                                            title="@group.Label failed on @group.Total.ToString("N0") of the QR shown, alone or with other items"
                                            @onclick="() => ToggleNgItem(group.Label)">
                                        <span aria-hidden="true">@(expanded ? "−" : "+")</span>
                                        <b>@group.Label</b>
                                        <i>@group.Total.ToString("N0")</i>
                                    </button>
                                    @if (expanded)
                                    {
                                        @foreach ((string label, int count) in group.Children)
                                        {
                                            <span class="qr-ng-chip qr-ng-child"
                                                  title="@(label == "alone"
                                                      ? $"{count:N0} QR failed {group.Label} and nothing else"
                                                      : $"{count:N0} QR failed {group.Label} together with {label[2..]}")">
                                                <b>@label</b>
                                                <i>@count.ToString("N0")</i>
                                            </span>
                                        }
                                    }
                                </span>
                            }
                            @if (_ngUnspecified > 0)
                            {
                                <span class="qr-ng-chip qr-ng-other" title="Failed the unit verdict without any item column flagged">
                                    <b>Unspecified</b>
                                    <i>@_ngUnspecified.ToString("N0")</i>
                                </span>
                            }
                        </div>
                    </div>
                }

                <div class="qr-search-bar">
                    @* Without this the page is stuck on the configured default, and a multi-date
                       selection silently reports only the newest rows that fit under it. *@
                    <label class="qr-maxrows">
                        <span>Max rows</span>
                        <select disabled="@_busy" @onchange="OnMaxRowsChanged">
                            <option value="0" selected="@_autoMaxRows">Auto · fit the dates</option>
                            @foreach (int option in MaxRowOptions)
                            {
                                <option value="@option" selected="@(!_autoMaxRows && option == _maxRows)">@option.ToString("N0")</option>
                            }
                        </select>
                        @if (_autoMaxRows)
                        {
                            <small class="qr-maxrows-auto">@_maxRows.ToString("N0")</small>
                        }
                    </label>

                    @* Model comes from the QR itself (characters 11-12), not from a column: BKTD
                       spells it in Model and ALTD/GSTD in ST_Information, and the two never match
                       as strings. The names come from the table on the Setting page. *@
                    <label class="qr-model-field">
                        <span>Model</span>
                        <select disabled="@(_busy || _productIdIndex < 0)" @onchange="OnModelChanged">
                            <option value="" selected="@(_modelCode.Length == 0)">All models</option>
                            @foreach (ModelOption option in _modelOptions)
                            {
                                <option value="@option.Code" selected="@(option.Code == _modelCode)">@option.Label</option>
                            }
                        </select>
                        @if (_productIdIndex < 0)
                        {
                            <small class="qr-model-note">no ProductID column</small>
                        }
                        else if (_modelOptions.Count == 0)
                        {
                            <small class="qr-model-note">Setting → QR Model Codes is empty</small>
                        }
                    </label>
                    @* Active column filters are named here as well as highlighted in the header:
                       when one of them empties the table, the reason has to stay visible. *@
                    @foreach ((int columnIndex, string text) in ActiveColumnFilters)
                    {
                        <button class="qr-filter-chip" type="button"
                                title="Clear this column filter"
                                @onclick="() => ClearColumnFilter(columnIndex)">
                            <b>@ColumnFilterLabel(columnIndex)</b>
                            <span>@text</span>
                            <i aria-hidden="true">×</i>
                        </button>
                    }
                    @if (IsFiltered)
                    {
                        <button class="qr-btn qr-search-clear" type="button" @onclick="ShowAll">Show all</button>
                    }
                    @if (_focusProductId.Length > 0)
                    {
                        <span class="qr-focus-note" title="Opened from QR SUMMARY">FROM QR SUMMARY · @_focusProductId</span>
                    }
                </div>

                <div class="qr-table-wrap">
                    @if (_result.Columns.Count == 0)
                    {
                        <div class="qr-empty">The query returned no columns.</div>
                    }
                    else if (_selectedDates.Count == 0)
                    {
                        <div class="qr-empty">Select a test date on the left.</div>
                    }
                    else if (_result.Rows.Count == 0)
                    {
                        <div class="qr-empty">No data for the selected dates.</div>
                    }
                    else
                    {
                        <table class="qr-data-table">
                            <thead>
                                <tr>
                                    <th class="qr-expand-head">
                                        <span>QR</span>
                                        <small>group</small>
                                    </th>
                                    @* The per-column filter lives inside the header cell rather than in a
                                       row of its own: the header is sticky at top:0, and a second sticky
                                       row would need an offset equal to a header height that changes with
                                       the column names. *@
                                    @foreach (ColumnSlot slot in _columnSlots)
                                    {
                                        int filterKey = slot.Column is null ? QrTestColumnLayout.TestDateIndex : slot.ColumnIndex;
                                        if (slot.Column is null)
                                        {
                                            <th class="qr-test-date-head">
                                                <span>Test date</span>
                                                <small>@DisplayCell(_result.SortColumnName)</small>
                                                <input @key="@ColumnFilterKey(filterKey)"
                                                       class="@ColumnFilterClass(filterKey)" type="search"
                                                       placeholder="filter" aria-label="Filter by test date"
                                                       value=""
                                                       @oninput="args => OnColumnFilterInput(filterKey, args)" />
                                            </th>
                                        }
                                        else
                                        {
                                            <th title="@slot.Column.DataType">
                                                <span>@slot.Column.Name</span>
                                                <small>@slot.Column.DataType</small>
                                                <input @key="@ColumnFilterKey(filterKey)"
                                                       class="@ColumnFilterClass(filterKey)" type="search"
                                                       placeholder="filter" aria-label="Filter by @slot.Column.Name"
                                                       value=""
                                                       @oninput="args => OnColumnFilterInput(filterKey, args)" />
                                            </th>
                                        }
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @* A filter that matches nothing must not take the header with it —
                                   the filter boxes live in the header, so hiding the table would
                                   leave no way to clear the filter that emptied it. *@
                                @if (_lines.Count == 0)
                                {
                                    <tr>
                                        <td class="qr-no-match" colspan="@(_columnSlots.Count + 1)">
                                            No row matches the current filters. Clear a highlighted filter box above, or press Show all.
                                        </td>
                                    </tr>
                                }
                                @* Virtualize keeps the render batch small: this table is up to 67
                                   columns wide, so a few thousand QR would push hundreds of
                                   thousands of cells over the SignalR circuit on every keystroke.
                                   Expanded rounds are flattened into the same list so every item
                                   stays exactly one <tr> and the spacer arithmetic holds. *@
                                <Virtualize Items="_lines" Context="line" ItemSize="32" SpacerElement="tr" OverscanCount="12">
                                    <tr class="@LineClass(line)" id="@(line.IsChild ? null : RowElementId(line.Group.Key))">
                                        <td class="qr-expand-cell">
                                            @if (line.IsChild)
                                            {
                                                <span class="qr-child-mark" aria-label="Additional test row for the same QR">└</span>
                                            }
                                            else if (line.Group.Rows.Count > 1)
                                            {
                                                <button class="qr-group-toggle"
                                                        type="button"
                                                        aria-expanded="@line.Expanded.ToString().ToLowerInvariant()"
                                                        title="@(line.Expanded ? "Collapse rows for this QR" : "Expand rows for this QR")"
                                                        @onclick="() => ToggleGroup(line.Group.Key)">
                                                    <span aria-hidden="true">@(line.Expanded ? "−" : "+")</span>
                                                    <b>@line.Group.Rows.Count.ToString("N0")</b>
                                                </button>
                                            }
                                        </td>
                                        @foreach (ColumnSlot slot in _columnSlots)
                                        {
                                            if (slot.Column is null)
                                            {
                                                <td class="qr-test-date">@FormatRowDate(line.Row.TestDate)</td>
                                            }
                                            else
                                            {
                                                string value = CellValue(line.Row, slot.ColumnIndex);
                                                <td class="@CellClass(slot.Column, value)">@DisplayCell(value)</td>
                                            }
                                        }
                                    </tr>
                                </Virtualize>
                            </tbody>
                        </table>
                    }
                </div>
            </section>
        </div>
    }
</div>

<style>
    .qr-date-browser {
        display: flex;
        min-height: 32rem;
        height: calc(var(--view-h, 100vh) - 6.2rem);
        margin: -0.25rem -0.5rem 0;
        padding: 0.8rem 1rem 1rem;
        flex-direction: column;
        overflow: hidden;
        background: var(--plane, #e8eaee);
        color: var(--ink, #0f1319);
        font-family: var(--sans, "Segoe UI", "Malgun Gothic", sans-serif);
    }

    .qr-titlebar {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 0.7rem;
        flex: 0 0 auto;
    }

    .qr-kicker {
        margin-bottom: 0.2rem;
        color: var(--crit, #c8342a);
        font-family: var(--mono, Bahnschrift, Consolas, monospace);
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.04em;
    }

    .qr-titlebar h1 {
        margin: 0;
        font-size: 1.12rem;
        line-height: 1.25;
    }

    .qr-titlebar p {
        margin: 0.16rem 0 0;
        color: var(--ink-2, #4a5461);
        font-size: 0.76rem;
    }

    .qr-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.4rem;
        min-width: 0;
    }

    .qr-connection {
        max-width: 24rem;
        margin-right: 0.25rem;
        overflow: hidden;
        color: var(--ink-3, #7f8a98);
        font-family: var(--mono, Bahnschrift, Consolas, monospace);
        font-size: 0.66rem;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .qr-btn {
        display: inline-flex;
        min-height: 1.9rem;
        padding: 0.32rem 0.72rem;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
        border: 1px solid var(--line-2, #c6ccd5);
        border-radius: 2px;
        background: var(--panel, #fff);
        color: var(--ink, #0f1319);
        font: 700 0.7rem var(--sans, "Segoe UI", sans-serif);
        cursor: pointer;
    }

    .qr-btn:hover:not(:disabled) {
        background: var(--panel-2, #f5f6f9);
        border-color: var(--ink, #0f1319);
    }

    .qr-btn.qr-primary {
        border-color: var(--signal, #16202b);
        background: var(--signal, #16202b);
        color: var(--panel, #fff);
    }

    .qr-btn:disabled,
    .qr-date-option.qr-disabled {
        cursor: default;
        opacity: 0.55;
    }

    .qr-spinner {
        display: inline-block;
        width: 0.78rem;
        height: 0.78rem;
        border: 2px solid var(--line-2, #c6ccd5);
        border-top-color: currentColor;
        border-radius: 50%;
        animation: qr-spin 0.75s linear infinite;
    }

    .qr-alert,
    .qr-state-panel {
        margin-bottom: 0.65rem;
        padding: 0.58rem 0.72rem;
        border: 1px solid var(--line-2, #c6ccd5);
        border-radius: 2px;
        background: var(--panel, #fff);
        color: var(--ink-2, #4a5461);
        font-size: 0.76rem;
    }

    .qr-state-panel {
        display: flex;
        min-height: 8rem;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
    }

    .qr-alert.qr-danger {
        border-color: var(--crit, #c8342a);
        background: var(--crit-wash, #fbedec);
        color: var(--crit, #c8342a);
    }

    .qr-alert.qr-warning {
        border-color: var(--line-2, #c6ccd5);
        background: var(--panel-2, #f5f6f9);
    }

    .qr-browser-grid {
        display: grid;
        min-height: 0;
        flex: 1 1 auto;
        grid-template-columns: 15rem minmax(0, 1fr);
        border: 1px solid var(--line-2, #c6ccd5);
        border-radius: 2px;
        background: var(--panel, #fff);
    }

    .qr-date-panel,
    .qr-data-panel {
        display: flex;
        min-width: 0;
        min-height: 0;
        flex-direction: column;
    }

    .qr-date-panel {
        border-right: 1px solid var(--line-2, #c6ccd5);
        background: var(--panel-2, #f5f6f9);
    }

    .qr-section-head {
        display: flex;
        min-height: 2.75rem;
        padding: 0.55rem 0.68rem;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        border-bottom: 1px solid var(--line-2, #c6ccd5);
        background: var(--panel-2, #f5f6f9);
    }

    .qr-section-head > div:first-child {
        display: flex;
        align-items: baseline;
        gap: 0.42rem;
    }

    .qr-section-head strong {
        font-size: 0.8rem;
    }

    .qr-section-head span,
    .qr-section-head small {
        color: var(--ink-3, #7f8a98);
        font-size: 0.68rem;
    }

    .qr-date-list {
        min-height: 0;
        padding: 0.38rem;
        flex: 1 1 auto;
        overflow: auto;
    }

    .qr-date-option {
        display: flex;
        width: 100%;
        min-height: 2.35rem;
        padding: 0.42rem 0.5rem;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        border: 1px solid transparent;
        border-radius: 2px;
        background: transparent;
        color: var(--ink, #0f1319);
        text-align: left;
        cursor: pointer;
    }

    .qr-date-option + .qr-date-option {
        margin-top: 0.18rem;
    }

    .qr-date-option:hover:not(.qr-disabled) {
        border-color: var(--line-2, #c6ccd5);
        background: var(--panel, #fff);
    }

    .qr-date-option.qr-selected {
        border-color: var(--signal, #16202b);
        background: var(--signal, #16202b);
        color: var(--panel, #fff);
    }

    .qr-date-check {
        width: 0.9rem;
        height: 0.9rem;
        margin: 0;
        flex: 0 0 auto;
        accent-color: var(--signal, #16202b);
    }

    .qr-date-label {
        margin-right: auto;
        font-family: var(--mono, Bahnschrift, Consolas, monospace);
        font-size: 0.72rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .qr-date-count {
        color: var(--ink-3, #7f8a98);
        font-size: 0.66rem;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

    .qr-selected .qr-date-count {
        color: var(--panel-3, #eceef2);
    }

    .qr-table-head {
        flex: 0 0 auto;
    }

    .qr-row-summary {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.75rem;
        font-variant-numeric: tabular-nums;
    }

    .qr-row-summary b {
        color: var(--warn-ink, #92610a);
        font-size: 0.68rem;
    }

    .qr-row-summary .qr-excluded {
        color: var(--warn-ink, #92610a);
        font-weight: 700;
    }

    .qr-search-bar {
        display: flex;
        padding: 0.4rem 0.55rem;
        align-items: center;
        gap: 0.6rem;
        flex: 0 0 auto;
        border-bottom: 1px solid var(--line, #dfe3e9);
        background: var(--panel-2, #f5f6f9);
    }

    .qr-maxrows {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        flex: 0 0 auto;
    }

    .qr-maxrows span {
        color: var(--ink-3, #7f8a98);
        font: 700 0.63rem var(--mono, Bahnschrift, Consolas, monospace);
        letter-spacing: 0.04em;
    }

    .qr-maxrows-auto {
        color: var(--ink-3, #7f8a98);
        font: 0.64rem var(--mono, Bahnschrift, Consolas, monospace);
        font-variant-numeric: tabular-nums;
    }

    .qr-maxrows select {
        padding: 0.26rem 0.4rem;
        border: 1px solid var(--line-2, #c6ccd5);
        border-radius: 2px;
        background: var(--panel, #fff);
        color: var(--ink, #0f1319);
        font: 0.72rem var(--mono, Bahnschrift, Consolas, monospace);
    }

    .qr-model-field {
        display: flex;
        min-width: 0;
        align-items: center;
        gap: 0.4rem;
        flex: 0 0 auto;
    }

    .qr-model-field span {
        color: var(--ink-3, #7f8a98);
        font: 700 0.63rem var(--mono, Bahnschrift, Consolas, monospace);
        letter-spacing: 0.04em;
    }

    .qr-model-field select {
        min-width: 13rem;
        padding: 0.26rem 0.4rem;
        border: 1px solid var(--line-2, #c6ccd5);
        border-radius: 2px;
