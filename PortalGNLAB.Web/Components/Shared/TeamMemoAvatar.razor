@using PortalGNLAB.Web.Services
@inject WebRepository Repo

@* Person badge: a pill with the user's display name (from Users), coloured per user name. *@
<span class="tm-av" title="@Name"
      style="background:@TeamMemoUi.AvatarColor(Name);height:@(Size)px;padding:0 @(Math.Round(Size * 0.45))px;font-size:@(Math.Max(10, Math.Round(Size * 0.46)))px;">@Label</span>

@code {
    /// <summary>User name (login id) of the person.</summary>
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 24;

    private string Label => string.IsNullOrWhiteSpace(Name) ? "?" : DisplayNames(Repo).GetValueOrDefault(Name, Name);

    // Display names change rarely; one shared lookup refreshed every minute keeps renders cheap.
    private static Dictionary<string, string> _names = new(StringComparer.OrdinalIgnoreCase);
    private static DateTime _loadedAt = DateTime.MinValue;
    private static readonly object Gate = new();

    private static Dictionary<string, string> DisplayNames(WebRepository repo)
    {
        lock (Gate)
        {
            if (DateTime.UtcNow - _loadedAt < TimeSpan.FromMinutes(1)) return _names;
            try
            {
                _names = repo.GetAllUsers().ToDictionary(u => u.Username,
                    u => string.IsNullOrWhiteSpace(u.DisplayName) ? u.Username : u.DisplayName, StringComparer.OrdinalIgnoreCase);
            }
            catch { /* keep the previous names */ }
            _loadedAt = DateTime.UtcNow;
            return _names;
        }
    }
}
