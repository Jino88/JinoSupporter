          "name": { "type": "string" },
          "rendererKey": { "type": "string" },
          "memberSelectionRule": { "type": "string" },
          "componentRecipe": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "representativeFiles": { "type": "array", "items": { "type": "string" } },
          "importantData": { "type": "array", "items": { "type": "string" } },
