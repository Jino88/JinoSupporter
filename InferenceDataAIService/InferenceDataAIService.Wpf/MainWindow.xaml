                                    Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                                    Text="새 Excel을 수집·등록하거나, 등록된 DB에서 질문과 관련된 자료를 찾습니다. 원본 대조와 보류 판정은 별도 품질 관리에서 수행합니다." />
                      </StackPanel>
                      <Border Grid.Column="1" Background="#203C34" BorderBrush="#2C8C70"
