            <!-- 9. Path settings -->
            <TabItem Header="설정">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="26">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <Border Style="{StaticResource CardStyle}" BorderBrush="#6D50A5" Padding="18">
                    <StackPanel>
                      <TextBlock Text="PATH &amp; DATABASE SETTINGS" Foreground="#A78BFA"
                                 FontSize="10" FontWeight="SemiBold"/>
                      <TextBlock Text="Excel DB 통합 설정" Margin="0,6,0,0"
                                 FontSize="22" FontWeight="SemiBold" Foreground="#EEEEEE"/>
                      <TextBlock Margin="0,7,0,0" Foreground="{StaticResource MutedTextBrush}"
                                 TextWrapping="Wrap"
                                 Text="통합 폴더 하나를 지정하면 Excel DB, 원본 보관함, 처리 결과, 로그와 검수 파일을 그 아래에 자동으로 정리합니다."/>
                    </StackPanel>
                  </Border>

                  <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="14">
                    <ItemsControl x:Name="PathSettingsItems">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,0,0,11">
                            <Grid.RowDefinitions>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="175"/>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                       Foreground="#D2D2D2" FontWeight="SemiBold"/>
                            <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas" FontSize="11" Margin="8,0,8,0"/>
                            <Button Grid.Column="2" Content="찾기" Click="BrowsePathSetting_Click"
                                    MinWidth="62" Margin="0,0,0,7"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                       Margin="8,4,0,0" Text="{Binding Description}"
                                       Foreground="#777777" FontSize="10" TextWrapping="Wrap"/>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>

                  <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="저장·즉시 적용" Style="{StaticResource PrimaryButtonStyle}"
                            Click="SavePathSettings_Click"/>
                    <Button Grid.Column="1" Content="기본값 불러오기"
                            Click="ResetPathSettings_Click"/>
                    <Button Grid.Column="2" Content="설정 파일 폴더"
                            Click="OpenPathSettingsFolder_Click"/>
                    <TextBlock x:Name="PathSettingsState" Grid.Column="3"
                               Margin="10,0,0,7" VerticalAlignment="Center"
                               Foreground="#A78BFA" TextWrapping="Wrap"/>
                  </Grid>

                  <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,8,0,18" Padding="12">
                    <StackPanel>
                      <TextBlock Text="설정 파일" Foreground="#A0A0A0" FontSize="10"/>
                      <TextBlock x:Name="PathSettingsFileText" Margin="0,4,0,0"
                                 FontFamily="Consolas" FontSize="10" Foreground="#777777"
                                 TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>
                </Grid>
              </ScrollViewer>
            </TabItem>

            <!-- 10. Read-only Excel COM capture and form classification -->
            <TabItem Header="Excel COM 사전 분석">
              <Grid Margin="18">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardStyle}" BorderBrush="#6D50A5" Padding="16">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="READ-ONLY COM CAPTURE · FORM PREFLIGHT"
                                 Foreground="#A78BFA" FontSize="10" FontWeight="SemiBold"/>
                      <TextBlock Text="Excel COM 추출과 양식 사전 판정" Margin="0,6,0,0"
                                 FontSize="20" FontWeight="SemiBold" Foreground="#EEEEEE"/>
                      <TextBlock Margin="0,6,0,0" Style="{StaticResource MutedTextStyle}"
