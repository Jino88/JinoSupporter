                                 Foreground="#929292" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                      <Button Content="양식군 검토·등록"
                              Tag="11"
                              Click="WorkspaceNavigation_Click"
                              ToolTip="유사·신규 양식을 구조별로 묶고 대표본 AI 분석과 사람 판정을 진행합니다."/>
                      <Button x:Name="RunKnownFormsFullProcessingButton"
                              Content="전체 자동 분석·DB·AI 문의 반영"
                              Style="{StaticResource PrimaryButtonStyle}"
                              IsEnabled="True"
                              Click="RunKnownFormsFullProcessing_Click"
                              ToolTip="보관함 전체를 form-pipeline-complete로 실행해 신규·유사 양식군 판정, 승인 corpus 의미 분석, canonical DB 적재·검증과 AI 문의 반영까지 완료합니다."/>
                    </StackPanel>
                  </Grid>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,8,0,0" Padding="8">
                  <DataGrid x:Name="FormPreflightGrid"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            CanUserAddRows="False"
                            EnableRowVirtualization="True"
                            SelectionMode="Single">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="판정" Binding="{Binding StatusDisplay}" Width="145"/>
                      <DataGridTextColumn Header="Excel 파일명" Binding="{Binding FileName}" Width="3*"/>
                      <DataGridTextColumn Header="유사도" Binding="{Binding SimilarityDisplay}" Width="80"/>
                      <DataGridTextColumn Header="가장 가까운 기존 양식" Binding="{Binding NearestKnownFile}" Width="2*"/>
                      <DataGridTextColumn Header="양식 지문" Binding="{Binding FormSignatureId}" Width="150"/>
                      <DataGridTextColumn Header="판정 근거" Binding="{Binding Reason}" Width="3*"/>
                    </DataGrid.Columns>
                  </DataGrid>
                </Border>
              </Grid>
            </TabItem>

            <!-- 11. Review-gated layout family registry -->
            <TabItem Header="양식군 검토·등록">
              <Grid Margin="18">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardStyle}" BorderBrush="#2C8C70" Padding="16">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="FORM FAMILY REVIEW · HUMAN APPROVAL"
                                 Foreground="#7FE0BE" FontSize="10" FontWeight="SemiBold"/>
                      <TextBlock Text="구조가 같은 Excel 양식군을 한 번만 분석"
                                 Margin="0,6,0,0" FontSize="20"
                                 FontWeight="SemiBold" Foreground="#EEEEEE"/>
                      <TextBlock Margin="0,6,0,0" Style="{StaticResource MutedTextStyle}"
                                 Text="유사·신규 Excel을 안정적인 구조 지문으로 묶습니다. 대표본과 최대 2개 표본으로 AI 추출 계약을 검증한 뒤 사람이 신규 등록, 기존 양식 연결 또는 제외를 결정합니다."/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#203C34" BorderBrush="#2C8C70"
                            BorderThickness="1" CornerRadius="12" Padding="10,5"
                            VerticalAlignment="Top">
                      <TextBlock Text="AI 제안 · 사람 최종 판정"
                                 Foreground="#7FE0BE" FontSize="10" FontWeight="SemiBold"/>
                    </Border>
                  </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="12">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock x:Name="FormGroupSummaryText"
                                 Text="사전 분석 결과에서 양식군을 불러오세요."
                                 Foreground="#D8D8D8" FontWeight="SemiBold"
                                 TextWrapping="Wrap"/>
                      <TextBlock x:Name="FormGroupProgressText"
                                 Margin="0,5,0,0"
                                 Text="판정 전에는 전체 처리 대상에 포함되지 않습니다."
                                 Foreground="#929292" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                      <Button x:Name="RefreshFormGroupsButton"
                              Content="양식군 새로고침"
                              Click="RefreshFormGroups_Click"/>
                      <Button x:Name="AnalyzeFormFamilyButton"
                              Content="대표본 AI 분석"
                              Style="{StaticResource PrimaryButtonStyle}"
                              IsEnabled="False"
                              Click="AnalyzeFormFamily_Click"/>
                      <Button x:Name="RegisterNewFormFamilyButton"
                              Content="신규 양식 등록"
                              IsEnabled="False"
                              Click="RegisterNewFormFamily_Click"/>
                      <Button x:Name="LinkExistingFormFamilyButton"
                              Content="기존 양식 연결"
                              IsEnabled="False"
                              Click="LinkExistingFormFamily_Click"/>
                      <Button x:Name="ExcludeFormFamilyButton"
                              Content="전체 처리 제외"
                              Style="{StaticResource DangerButtonStyle}"
                              IsEnabled="False"
                              Click="ExcludeFormFamily_Click"/>
                    </StackPanel>
                  </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,8,0,0" Padding="12">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="105"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="125"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="판정자" VerticalAlignment="Center"
                               Foreground="#B9A8E8" FontWeight="SemiBold"/>
                    <TextBox x:Name="FormFamilyReviewerText" Grid.Column="1"
                             TextChanged="FormFamilyDecisionInput_Changed"/>
                    <TextBlock Grid.Column="2" Text="표시 이름"
                               Margin="12,0,0,0" VerticalAlignment="Center"
                               Foreground="#B9A8E8" FontWeight="SemiBold"/>
                    <TextBox x:Name="FormFamilyDisplayNameText" Grid.Column="3"
                             TextChanged="FormFamilyDecisionInput_Changed"/>
                    <TextBlock Grid.Row="1" Text="기존 양식 서명"
                               VerticalAlignment="Center"
                               Foreground="#B9A8E8" FontWeight="SemiBold"/>
                    <TextBox x:Name="FormFamilyLinkedSignatureText"
                             Grid.Row="1" Grid.Column="1"
                             FontFamily="Consolas"
                             ToolTip="기존 양식 연결 시 사용할 분석 완료 formSignatureId"
                             TextChanged="FormFamilyDecisionInput_Changed"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="판정 메모"
                               Margin="12,0,0,0" VerticalAlignment="Center"
                               Foreground="#B9A8E8" FontWeight="SemiBold"/>
                    <TextBox x:Name="FormFamilyNotesText"
                             Grid.Row="1" Grid.Column="3"
                             TextChanged="FormFamilyDecisionInput_Changed"/>
                  </Grid>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,8,0,0" Padding="8">
                  <DataGrid x:Name="FormFamilyGroupsGrid"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            CanUserAddRows="False"
                            EnableRowVirtualization="True"
                            SelectionMode="Single"
                            SelectionChanged="FormFamilyGroupsGrid_SelectionChanged">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="판정" Binding="{Binding DecisionStatusDisplay}" Width="135"/>
                      <DataGridTextColumn Header="양식군 이름" Binding="{Binding DisplayName}" Width="2*"/>
                      <DataGridTextColumn Header="파일 수" Binding="{Binding MemberCount}" Width="70"/>
                      <DataGridTextColumn Header="대표 Excel" Binding="{Binding RepresentativeFile}" Width="2*"/>
                      <DataGridTextColumn Header="검증 표본" Binding="{Binding SampleDisplay}" Width="3*"/>
                      <DataGridTextColumn Header="평균 유사도" Binding="{Binding SimilarityDisplay}" Width="90"/>
                      <DataGridTextColumn Header="AI 계약 검증" Binding="{Binding ValidationDisplay}" Width="120"/>
                      <DataGridTextColumn Header="가까운 기존 양식" Binding="{Binding NearestKnownFile}" Width="2*"/>
                      <DataGridTextColumn Header="기존 양식 서명" Binding="{Binding NearestKnownFormSignatureId}" Width="155"/>
                      <DataGridTextColumn Header="후보 판정" Binding="{Binding CandidateStatuses}" Width="2*"/>
                      <DataGridTextColumn Header="판정자" Binding="{Binding Reviewer}" Width="100"/>
                      <DataGridTextColumn Header="메모" Binding="{Binding Notes}" Width="2*"/>
                    </DataGrid.Columns>
                  </DataGrid>
                </Border>
              </Grid>
            </TabItem>
          </TabControl>

          <GridSplitter x:Name="WorkspaceInsightSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#343434" ShowsPreview="True" />

          <!-- Persistent evidence / result pane -->
          <Grid x:Name="InsightPane" Grid.Column="2" Margin="0,14,14,14">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="RESULT" Foreground="#777777" FontSize="10" FontWeight="SemiBold" />
                <TextBlock x:Name="ResultTitle" Margin="0,4,0,0" FontSize="20" FontWeight="SemiBold" Foreground="#EEEEEE" Text="분석 결과" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="InsightWideButton" Content="넓게 보기" Margin="0,0,8,0" Padding="12,5"
                        Click="ToggleInsightWide_Click" ToolTip="왼쪽 작업 영역을 접고 결과 표를 창 너비로 봅니다." />
                <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="10" Padding="9,4" VerticalAlignment="Center">
                  <TextBlock Text="원본 근거 연결" Foreground="#C4B5FD" FontSize="9" />
                </Border>
              </StackPanel>
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,12,0,10" Padding="12,10">
              <StackPanel>
                <TextBlock x:Name="PipelineFileTitle" Foreground="#C4B5FD" FontWeight="SemiBold" Text="질문하거나 파일을 선택하세요." TextWrapping="Wrap" />
                <TextBlock x:Name="PipelineBatchText" Margin="0,4,0,5" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                <TextBlock x:Name="PipelineStagesText" FontFamily="Consolas" FontSize="11" Foreground="#8D8D8D" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Grid.Row="2" Background="#181818" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
              <Grid Background="#181818">
                <StackPanel x:Name="ResultBrowserPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Text="INSIGHT" Foreground="#6F5A94" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" />
                  <TextBlock Text="결과를 준비하고 있습니다." Foreground="#A8A8A8" Margin="0,8,0,0" />
                </StackPanel>
                <WebBrowser x:Name="ResultBrowser" Visibility="Hidden"
                            Navigating="ResultBrowser_Navigating"
                            LoadCompleted="ResultBrowser_LoadCompleted" />
              </Grid>
            </Border>
          </Grid>
        </Grid>

        <Expander x:Name="DeveloperConsoleExpander" Grid.Row="3" Header="  Developer console" IsExpanded="False" BorderBrush="#343434" BorderThickness="0,1,0,0">
          <TextBox x:Name="LogText" Height="132" Padding="12,8" Background="#151515" BorderThickness="0"
                   Foreground="#9FC9AE" FontFamily="Consolas" FontSize="11" IsReadOnly="True"
                   TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
        </Expander>
      </Grid>
    </Grid>

    <!-- Obsidian-style status bar -->
    <Border Grid.Row="2" Background="#181818" BorderBrush="#303030" BorderThickness="0,1,0,0">
      <Grid Margin="10,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="WorkspaceStatusText" Text="Ready" Foreground="#7C7C7C" FontSize="9" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
          <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" Margin="0,0,6,0" />
          <TextBlock Text="Context AI" Foreground="#8D8D8D" FontSize="9" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="REVIEW GATED" Foreground="#A78BFA" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
