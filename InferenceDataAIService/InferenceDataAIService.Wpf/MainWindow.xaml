                    </StackPanel>
                    <Border Grid.Column="1" Background="#203C34" BorderBrush="#2C8C70"
                            BorderThickness="1" CornerRadius="12" Padding="10,5" VerticalAlignment="Top">
                      <TextBlock Text="원본 유지 · journal 재개" Foreground="#7FE0BE"
                                 FontSize="10" FontWeight="SemiBold"/>
                    </Border>
                  </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="12">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="110"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="분석할 보관함" VerticalAlignment="Center"
                               Foreground="#B9A8E8" FontWeight="SemiBold"/>
                    <TextBox x:Name="FormPreflightArchivePathText" Grid.Column="1"
                             IsReadOnly="True" FontFamily="Consolas"
                             ToolTip="신규 Excel 수집에서 사용하는 로컬 보관함"/>
                    <Button x:Name="RefreshFormPreflightButton" Grid.Column="2"
                            Content="이전 결과 불러오기"
