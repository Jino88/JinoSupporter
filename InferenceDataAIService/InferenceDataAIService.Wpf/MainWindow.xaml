                              VerticalAlignment="Top">
                        <TextBlock Text="History DB online" Foreground="#7FE0BE" FontSize="10" FontWeight="SemiBold" />
                      </Border>
                    </Grid>
                  </Border>

                  <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Tag="6" Click="WorkspaceNavigation_Click"
                            MinHeight="154" Margin="0,0,8,0" Padding="16"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                      <StackPanel>
                        <TextBlock Text="수집" Foreground="#7FE0BE" FontSize="11" FontWeight="Bold" />
                        <TextBlock Text="신규 Excel 수집" Margin="0,10,0,0"
                                   Foreground="#EEEEEE" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="폴더를 DB와 비교하고 없는 파일만 로컬 보관"
                                   Margin="0,8,0,0" Foreground="#929292" TextWrapping="Wrap" />
                      </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Tag="10" Click="WorkspaceNavigation_Click"
                            MinHeight="154" Margin="8,0" Padding="16"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                      <StackPanel>
                        <TextBlock Text="판정" Foreground="#A78BFA" FontSize="11" FontWeight="Bold" />
                        <TextBlock Text="Excel COM 사전 분석" Margin="0,10,0,0"
                                   Foreground="#EEEEEE" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="COM 추출 후 기존·유사·신규 양식을 먼저 구분"
                                   Margin="0,8,0,0" Foreground="#929292" TextWrapping="Wrap" />
                      </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Tag="2" Click="WorkspaceNavigation_Click"
                            MinHeight="154" Margin="8,0,0,0" Padding="16"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                      <StackPanel>
                        <TextBlock Text="검색" Foreground="#A78BFA" FontSize="11" FontWeight="Bold" />
                        <TextBlock Text="질문으로 자료 찾기" Margin="0,10,0,0"
                                   Foreground="#EEEEEE" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="질문에 필요한 보고서와 Study 원본 근거 검색"
                                   Margin="0,8,0,0" Foreground="#929292" TextWrapping="Wrap" />
                      </StackPanel>
                    </Button>
                  </Grid>

                  <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,16,0,0" Padding="16">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="품질 관리" Foreground="#D8D8D8" FontWeight="SemiBold" />
                        <TextBlock Text="필요할 때만 원본값을 대조하거나 AI 보류 항목을 사람이 판정합니다."
                                   Margin="0,5,0,0" Foreground="#8D8D8D" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Tag="3" Content="원본 값 대조" Click="WorkspaceNavigation_Click" />
                        <Button Tag="4" Content="보류 항목 판정" Click="WorkspaceNavigation_Click" Margin="0,0,0,7" />
                      </StackPanel>
                    </Grid>
                  </Border>

                  <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,16,0,0" Padding="16">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="분석 도구" Foreground="#D8D8D8" FontWeight="SemiBold" />
                        <TextBlock Text="기존 Excel 목록과 완료된 분석 결과를 바로 확인할 수 있습니다."
                                   Margin="0,5,0,0" Foreground="#8D8D8D" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Tag="0" Content="Excel 분석 목록" Click="WorkspaceNavigation_Click" />
                        <Button Tag="1" Content="분석 결과 보관함" Click="WorkspaceNavigation_Click" Margin="0,0,0,7" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </Grid>
              </ScrollViewer>
