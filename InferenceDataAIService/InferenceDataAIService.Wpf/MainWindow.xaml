                            Click="StopFormPreflight_Click"
                            ToolTip="현재 전용 Excel COM 작업을 정리하고 완료된 부분 결과를 보존합니다."/>
                  </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,8,0,0" Padding="12">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
