<Window x:Class="InferenceDataAIService.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Inference Data AI"
        Width="1720"
        Height="980"
        MinWidth="1280"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        StateChanged="MainWindow_StateChanged">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="38"
                              ResizeBorderThickness="6"
                              CornerRadius="0"
                              GlassFrameThickness="0"
                              UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <Style x:Key="WindowButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="38" />
      <Setter Property="MinWidth" Value="46" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="#B8B8B8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ChromeBorder" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ChromeBorder" Property="Background" Value="#353535" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PanelCaptionStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
  </Window.Resources>

  <Grid x:Name="ShellRoot" Background="{StaticResource AppBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="38" />
      <RowDefinition Height="*" />
      <RowDefinition Height="24" />
    </Grid.RowDefinitions>

    <!-- WorkHub-compatible custom title bar -->
    <Border Grid.Row="0"
            Background="{StaticResource TitleBarBrush}"
            BorderBrush="#303030"
            BorderThickness="0,0,0,1"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="252" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
          <Border Width="20" Height="20" Background="{StaticResource AccentBrush}" CornerRadius="4">
            <TextBlock Text="AI" FontSize="9" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="Inference Data AI" Margin="9,0,0,0" FontWeight="SemiBold" Foreground="#DDDDDD" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="evidence workspace" HorizontalAlignment="Center"
                   VerticalAlignment="Center" Foreground="#6F6F6F" FontSize="10" />
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button Content="&#xE921;" Style="{StaticResource WindowButtonStyle}" Click="MinimizeButton_Click" />
          <Button Style="{StaticResource WindowButtonStyle}" Click="MaximizeButton_Click">
            <TextBlock x:Name="MaximizeGlyphText" Text="&#xE922;" />
          </Button>
          <Button Content="&#xE8BB;" Style="{StaticResource WindowButtonStyle}" Click="CloseWindowButton_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="252" />
        <ColumnDefinition Width="1" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Obsidian-style vault navigator -->
      <Border Grid.Column="0" Background="{StaticResource RailBrush}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border BorderBrush="#353535" BorderThickness="0,0,0,1">
            <Grid Margin="14,0,12,0">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="INFERENCE VAULT" Foreground="#D0D0D0" FontSize="11" FontWeight="SemiBold" />
                <TextBlock Text="989 workbooks · 3,710 studies" Foreground="#777777" FontSize="10" Margin="0,3,0,0" />
              </StackPanel>
              <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                      Background="{StaticResource AccentSoftBrush}" CornerRadius="4" Padding="7,3">
                <TextBlock Text="AI" Foreground="#C4B5FD" FontSize="10" FontWeight="SemiBold" />
              </Border>
            </Grid>
          </Border>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="WorkspaceNavigationPanel" Margin="5,4,5,14">
              <Button Tag="8" Style="{StaticResource NavigationButtonStyle}" Click="WorkspaceNavigation_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" />
                  <TextBlock Text="홈" />
                </StackPanel>
              </Button>

              <TextBlock Text="주요 작업" Style="{StaticResource SectionLabelStyle}" />
              <Button Tag="6" Style="{StaticResource NavigationButtonStyle}" Click="WorkspaceNavigation_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" />
                  <TextBlock Text="신규 Excel 수집" />
                </StackPanel>
              </Button>
              <Button Tag="10" Style="{StaticResource NavigationButtonStyle}" Click="WorkspaceNavigation_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" />
                  <TextBlock Text="Excel COM 사전 분석" />
                </StackPanel>
              </Button>
              <Button Tag="11" Style="{StaticResource NavigationButtonStyle}" Click="WorkspaceNavigation_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" />
                  <TextBlock Text="양식군 검토·등록" />
                </StackPanel>
              </Button>
              <Button Tag="7" Style="{StaticResource NavigationButtonStyle}" Click="WorkspaceNavigation_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" />
                  <TextBlock Text="전체 처리 상태·재시도" />
                </StackPanel>
              </Button>
              <Button Tag="2" Style="{StaticResource NavigationButtonStyle}" Click="WorkspaceNavigation_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" />
                  <TextBlock Text="질문으로 자료 찾기" />
                </StackPanel>
              </Button>

              <TextBlock Text="품질 관리" Style="{StaticResource SectionLabelStyle}" />
              <Button Tag="3" Style="{StaticResource NavigationButtonStyle}" Click="WorkspaceNavigation_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" />
                  <TextBlock Text="원본 값 대조" />
                </StackPanel>
              </Button>
              <Button Tag="4" Style="{StaticResource NavigationButtonStyle}" Click="WorkspaceNavigation_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" />
                  <TextBlock Text="보류 항목 판정" />
                </StackPanel>
              </Button>

              <TextBlock Text="분석 도구" Style="{StaticResource SectionLabelStyle}" />
              <Button Tag="0" Style="{StaticResource NavigationButtonStyle}" Click="WorkspaceNavigation_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" />
                  <TextBlock Text="Excel 분석 목록" />
                </StackPanel>
              </Button>
              <Button Tag="1" Style="{StaticResource NavigationButtonStyle}" Click="WorkspaceNavigation_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" />
                  <TextBlock Text="분석 결과 보관함" />
                </StackPanel>
              </Button>
              <Button Tag="5" Style="{StaticResource NavigationButtonStyle}" Click="WorkspaceNavigation_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" />
                  <TextBlock Text="개념·별칭 정규화" />
                </StackPanel>
              </Button>

              <TextBlock Text="시스템" Style="{StaticResource SectionLabelStyle}" />
              <Button Tag="9" Style="{StaticResource NavigationButtonStyle}" Click="WorkspaceNavigation_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" />
                  <TextBlock Text="설정" />
                </StackPanel>
              </Button>
            </StackPanel>
          </ScrollViewer>

          <Border Grid.Row="2" BorderBrush="#353535" BorderThickness="0,1,0,0" Padding="12,10">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Top" Margin="0,5,9,0" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="History DB online" Foreground="#BEBEBE" FontSize="10" />
                <TextBlock Text="review-gated evidence" Foreground="#707070" FontSize="9" Margin="0,2,0,0" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <Border Grid.Column="1" Background="#363636" />

      <!-- Workspace shell -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="42" />
          <RowDefinition Height="32" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource TitleBarBrush}" BorderBrush="#343434" BorderThickness="0,0,0,1">
          <Grid>
            <Border HorizontalAlignment="Left" MinWidth="220" MaxWidth="360"
                    Background="{StaticResource AppBackgroundBrush}"
                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,2,0,0" Padding="14,0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Foreground="#A78BFA"
                           FontSize="12" VerticalAlignment="Center" Margin="0,0,9,0" />
                <TextBlock x:Name="WorkspacePageTitleText" Grid.Column="1" Text="질문 관련 보고서"
                           Foreground="#D8D8D8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Ellipse Grid.Column="2" Width="5" Height="5" Fill="#777777" Margin="12,0,0,0" />
              </Grid>
            </Border>
          </Grid>
        </Border>

        <Border Grid.Row="1" BorderBrush="#2B2B2B" BorderThickness="0,0,0,1">
          <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
            <TextBlock Text="Inference Data AI" Foreground="#777777" FontSize="10" />
            <TextBlock Text="  /  " Foreground="#555555" FontSize="10" />
            <TextBlock x:Name="WorkspaceSubtitleText" Text="질문의 문맥을 이해하고 직접 근거만 사용합니다."
                       Foreground="#9A9A9A" FontSize="10" />
          </StackPanel>
        </Border>

        <Grid x:Name="WorkspaceResultGrid" Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="WorkspacePaneColumn" Width="46*" MinWidth="520" />
            <ColumnDefinition x:Name="WorkspaceSplitterColumn" Width="5" />
            <ColumnDefinition x:Name="InsightPaneColumn" Width="54*" MinWidth="430" />
          </Grid.ColumnDefinitions>

          <TabControl x:Name="WorkspaceTabs" Grid.Column="0" SelectedIndex="8"
                      Style="{StaticResource WorkspaceTabControlStyle}"
                      SelectionChanged="WorkspaceTabs_SelectionChanged">
            <!-- 0. Excel analysis -->
            <TabItem Header="Excel 분석 목록">
              <Grid Margin="18">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <WrapPanel x:Name="SourceToolbar">
                  <Button Content="① 폴더 추가" Click="AddFolder_Click" />
                  <Button Content="새로 고침" Click="Refresh_Click" />
                  <Button x:Name="AiGroupAnalysisButton" Content="구조 스캔 배치 AI 그룹" Click="StartAiGroupAnalysis_Click"
                          ToolTip="이미 구조 스캔되어 배치 ID가 있는 Excel만 AI 그룹화를 이어서 실행합니다." />
                  <Button x:Name="GroupStatusButton" Content="③ 결과·그룹 확인" Click="ShowGroupStatus_Click" />
                  <Button x:Name="NumericReviewFolderButton" Content="숫자 검토 폴더" Click="NumericReviewFolder_Click" />
                </WrapPanel>
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,2,0,10">
                  <StackPanel>
                    <TextBlock Foreground="#E2D8FF" FontWeight="SemiBold" TextWrapping="Wrap"
                               Text="목록 사용 순서  ① Excel 파일·폴더 추가 또는 아래로 끌어놓기  →  ② 파일 우클릭 ‘선택 파일 단건 분석’  →  ③ 결과 확인" />
                    <TextBlock Margin="0,5,0,0" Foreground="#8D8D8D" FontSize="10" TextWrapping="Wrap"
                               Text="폴더 전체와 신규 DRM 원본은 왼쪽 MAIN WORKFLOW의 ‘1 DRM Excel 전체 처리’를 사용하세요. ‘구조 스캔 배치 AI 그룹’은 기존 배치를 이어서 처리할 때만 사용합니다." />
                    <TextBlock x:Name="PipelineRunState" Margin="0,7,0,0" Foreground="#C4B5FD" FontWeight="SemiBold" Text="파이프라인: 대기" TextWrapping="Wrap" />
                    <TextBlock x:Name="NumericReviewState" Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}"
                               Text="숫자 검토: 대기 — 같은 날짜의 명시된 Test–Normal만 비교합니다." TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
                <Grid Grid.Row="2" Background="Transparent" AllowDrop="True"
                      PreviewDragEnter="FilesDropSurface_PreviewDragEnter"
                      PreviewDragOver="FilesDropSurface_PreviewDragOver"
                      DragLeave="FilesDropSurface_DragLeave"
                      Drop="FilesDropSurface_Drop">
                  <DataGrid x:Name="FilesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                            SelectionMode="Extended" SelectionChanged="FilesGrid_SelectionChanged"
                            MouseDoubleClick="FilesGrid_MouseDoubleClick" CanUserAddRows="False"
                            ToolTip="Excel 파일 또는 폴더를 이 목록에 끌어놓을 수 있습니다.">
                    <DataGrid.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="선택 파일 단건 분석" Click="AnalyzeSelected_Click" />
                        <MenuItem Header="선택 파일 강제 재분석" Click="ForceAnalyzeSelected_Click" />
                        <MenuItem Header="결과 열기" Click="OpenResult_Click" />
                        <Separator />
                        <MenuItem Header="원본 Excel 보기" Click="OpenSourceExcel_Click" />
                        <MenuItem Header="결과 HTML 보기" Click="OpenResultHtml_Click" />
                      </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Excel 파일" Binding="{Binding FileName}" Width="3*" />
                      <DataGridTextColumn Header="구조" Binding="{Binding StructureStatus}" Width="80" />
                      <DataGridTextColumn Header="캡처" Binding="{Binding CaptureStatus}" Width="85" />
                      <DataGridTextColumn Header="AI 그룹" Binding="{Binding AiGroupStatus}" Width="150" />
                      <DataGridTextColumn Header="렌더" Binding="{Binding RenderStatus}" Width="120" />
                    </DataGrid.Columns>
                  </DataGrid>
                  <Border x:Name="FilesDropIndicator" Visibility="Collapsed" IsHitTestVisible="False"
                          Background="#DD211A2F" BorderBrush="#A78BFA" BorderThickness="2"
                          CornerRadius="6" Margin="3">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" Foreground="#C4B5FD"
                                 FontSize="34" HorizontalAlignment="Center" />
                      <TextBlock Text="Excel 파일 또는 폴더를 놓으세요" Foreground="#F1ECFF"
                                 FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0" />
                      <TextBlock Text=".xlsx · .xlsm · .xlsb · .xls" Foreground="#AFA5C8"
                                 FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" />
                    </StackPanel>
                  </Border>
                </Grid>
              </Grid>
            </TabItem>

            <!-- 1. Stored analyses -->
            <TabItem Header="기존 학습 결과">
              <Grid Margin="18">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <WrapPanel>
                  <ComboBox x:Name="LearnedBatchSelector" Width="300" DisplayMemberPath="DisplayName"
                            SelectionChanged="LearnedBatchSelector_SelectionChanged" Margin="0,0,8,7" />
                  <Button Content="새로 고침" Click="RefreshLearnedResults_Click" />
                  <Button Content="렌더 인덱스" Click="ShowLearnedRenderIndex_Click" />
                  <Button Content="AI 그룹 카탈로그" Click="ShowLearnedCatalog_Click" />
                </WrapPanel>
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,2,0,10">
                  <StackPanel>
                    <TextBlock x:Name="LearnedResultsTitle" Foreground="#C4B5FD" FontWeight="SemiBold" Text="저장된 검증 결과를 찾는 중입니다." />
                    <TextBlock x:Name="LearnedResultsSummary" Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
                <DataGrid x:Name="LearnedReportsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionChanged="LearnedReportsGrid_SelectionChanged" CanUserAddRows="False">
                  <DataGrid.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="원본 Excel 열기" Click="OpenLearnedSourceExcel_Click" />
                      <MenuItem Header="분석 HTML 새 창으로 열기" Click="OpenLearnedReportHtml_Click" />
                    </ContextMenu>
                  </DataGrid.ContextMenu>
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Excel 파일" Binding="{Binding FileName}" Width="3*" />
                    <DataGridTextColumn Header="AI 그룹" Binding="{Binding GroupId}" Width="2*" />
                    <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="120" />
                    <DataGridTextColumn Header="데이터 구성" Binding="{Binding ComponentSummary}" Width="2*" />
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </TabItem>

            <!-- 2. Contextual AI -->
            <TabItem Header="질문으로 자료 찾기">
              <Grid Margin="18">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource CardStyle}" BorderBrush="#55466D" Padding="14">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="FIND RELEVANT REPORTS" Foreground="#A78BFA" FontSize="10" FontWeight="SemiBold" />
                      <TextBlock Text="질문으로 자료 찾기" Margin="0,6,0,0" FontSize="20" FontWeight="SemiBold" Foreground="#EEEEEE" />
                      <TextBlock Margin="0,6,0,0" Style="{StaticResource MutedTextStyle}"
                                 Text="AI는 관련 보고서만 선별합니다. 결과의 의미·증감·원인은 판단하지 않고 원본 근거를 함께 보여줍니다." />
                      <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="58"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Foreground="#777777" FontSize="10" Text="검색 DB"/>
                        <TextBox x:Name="CanonicalDbPathText" Grid.Column="1" IsReadOnly="True"
                                 FontSize="10" Foreground="#777777" Padding="7,4"/>
                      </Grid>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#302647" BorderBrush="#684D91"
                            BorderThickness="1" CornerRadius="12" Padding="10,5" VerticalAlignment="Top">
                      <TextBlock Text="원본 근거 연결" Foreground="#C4B5FD" FontSize="10" FontWeight="SemiBold" />
                    </Border>
                  </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="12">
                  <StackPanel>
                    <TextBlock Text="무엇을 찾고 싶나요?" Foreground="#D8D8D8" FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,8" Foreground="#777777" FontSize="10"
                               Text="대상·조건·지표를 자연어로 입력하세요. 예: VP CD 조립 조건과 Hearing 불량 관련 보고서" />
                    <TextBox x:Name="EvidenceQuestionText" Height="92"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             FontSize="14" VerticalContentAlignment="Top" Padding="10,8"
                             ToolTip="예: VP CD 조립에 따른 Hearing 불량률 추이" />
                  </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="12,10">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="165"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <ComboBox x:Name="EvidenceQueryModeSelector" SelectedIndex="0"
                                Margin="0,0,8,0" VerticalAlignment="Center"
                                Background="#F2F2F2" Foreground="#202020" FontWeight="SemiBold"
                                ToolTip="최신 적재 DB는 방금 추가한 Excel을 즉시 포함합니다. 기존 전체 이력은 별도 table-first 자료입니다.">
                        <ComboBoxItem Content="최신 적재 DB" Tag="canonical" />
                        <ComboBoxItem Content="기존 전체 이력" Tag="history" />
                      </ComboBox>
                      <Button x:Name="AskEvidenceButton" Grid.Column="1" Height="36" Margin="0"
                              Content="관련 보고서 찾기" Style="{StaticResource PrimaryButtonStyle}" Click="AskEvidence_Click" />
                      <TextBlock x:Name="EvidenceQueryState" Grid.Column="2" Margin="12,0,0,0"
                                 VerticalAlignment="Center" Foreground="#C4B5FD"
                                 Text="질문을 입력한 뒤 관련 보고서 찾기를 누르세요." TextWrapping="Wrap" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock VerticalAlignment="Center" Margin="0,0,10,7"
                                 Foreground="#777777" FontSize="10" Text="결과 도구"/>
                      <Button x:Name="LoadEvidenceHistoryButton" Grid.Column="1" Content="저장된 검색 결과" Click="LoadEvidenceHistory_Click" />
                      <Button Grid.Column="2" Content="선택 근거 표" Click="OpenEvidencePreview_Click" />
                      <Button Grid.Column="3" HorizontalAlignment="Left" Content="선택 Excel 범위" Click="OpenEvidenceExcel_Click" />
                    </Grid>
                  </Grid>
                </Border>

                <Grid Grid.Row="3" Margin="2,12,2,7">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="원본 근거" Foreground="#D8D8D8" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Margin="10,0,0,0" Foreground="#777777" FontSize="10"
                             Text="검색 후 행을 더블클릭하면 근거 표를 확인할 수 있습니다." />
                </Grid>

                <DataGrid x:Name="EvidenceCitationsGrid" Grid.Row="4" AutoGenerateColumns="False" IsReadOnly="True"
                          MouseDoubleClick="EvidenceCitationsGrid_MouseDoubleClick" CanUserAddRows="False">
                  <DataGrid.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="근거 표 미리보기" Click="OpenEvidencePreview_Click" />
                      <MenuItem Header="원본 Excel의 정확한 범위 열기" Click="OpenEvidenceExcel_Click" />
                    </ContextMenu>
                  </DataGrid.ContextMenu>
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="근거 ID" Binding="{Binding EvidenceId}" Width="155" />
                    <DataGridTextColumn Header="시트" Binding="{Binding Sheet}" Width="110" />
                    <DataGridTextColumn Header="범위" Binding="{Binding Range}" Width="90" />
                    <DataGridTextColumn Header="관련 원본 Excel" Binding="{Binding FileName}" Width="3*" />
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </TabItem>

            <!-- 3. Workbook comparison -->
            <TabItem Header="원본 값 대조">
              <Grid Margin="18">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="210"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Button x:Name="RefreshWorkbookComparisonButton" Content="대표 30건 불러오기" Click="RefreshWorkbookComparison_Click" />
                  <Button x:Name="OpenWorkbookComparisonExcelButton" Grid.Column="1" Content="원본 Excel 셀 열기" Click="OpenWorkbookComparisonExcel_Click" />
                  <TextBlock x:Name="WorkbookComparisonState" Grid.Column="2" Margin="10,0,0,7" VerticalAlignment="Center"
                             Foreground="#A78BFA" Text="대표 30건을 불러오세요." TextWrapping="Wrap" />
                </Grid>
                <DataGrid x:Name="WorkbookComparisonGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionChanged="WorkbookComparisonGrid_SelectionChanged" CanUserAddRows="False" EnableRowVirtualization="True">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding BenchmarkNumber}" Width="42" />
                    <DataGridTextColumn Header="Excel 파일" Binding="{Binding FileName}" Width="3*" />
                    <DataGridTextColumn Header="Analysis ID" Binding="{Binding PublicAnalysisId}" Width="145" />
                    <DataGridTextColumn Header="Study" Binding="{Binding StudyCount}" Width="55" />
                    <DataGridTextColumn Header="값" Binding="{Binding ObservationCount}" Width="55" />
                    <DataGridTextColumn Header="상태" Binding="{Binding VerificationStatus}" Width="100" />
                  </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="2" Margin="0,12,0,7" FontWeight="SemiBold" Foreground="#BBBBBB"
                           Text="문제 / Excel 실제값 / DB 인식값" />
                <DataGrid x:Name="WorkbookComparisonValuesGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" EnableRowVirtualization="True" MouseDoubleClick="WorkbookComparisonValuesGrid_MouseDoubleClick">
                  <DataGrid.ContextMenu><ContextMenu><MenuItem Header="원본 Excel의 정확한 셀 열기" Click="OpenWorkbookComparisonExcel_Click" /></ContextMenu></DataGrid.ContextMenu>
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="문제" Binding="{Binding ProblemDescription}" Width="2*" />
                    <DataGridTextColumn Header="Excel 실제값" Binding="{Binding ExcelActualValue}" Width="*" />
                    <DataGridTextColumn Header="DB 인식값" Binding="{Binding DatabaseValue}" Width="*" />
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </TabItem>

            <!-- 4. Human review -->
            <TabItem Header="보류 항목 판정">
              <Grid Margin="18">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <WrapPanel>
                  <Button x:Name="RefreshReviewQueueButton" Content="검토 큐 새로고침" Click="RefreshReviewQueue_Click" />
                  <Button Content="근거 표 보기" Click="OpenReviewEvidencePreview_Click" />
                  <Button Content="근거 Excel 열기" Click="OpenReviewEvidenceExcel_Click" />
                  <TextBlock x:Name="ReviewQueueState" Margin="8,7,0,7" Foreground="#A78BFA" Text="새로고침 필요" TextWrapping="Wrap" />
                </WrapPanel>
                <DataGrid x:Name="ReviewQueueGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionChanged="ReviewQueueGrid_SelectionChanged" CanUserAddRows="False">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="CMP ID" Binding="{Binding PublicComparisonId}" Width="140" />
                    <DataGridTextColumn Header="DATA ID" Binding="{Binding PublicDataId}" Width="140" />
                    <DataGridTextColumn Header="Study" Binding="{Binding StudyTitle}" Width="2*" />
                    <DataGridTextColumn Header="원본 Excel" Binding="{Binding FileName}" Width="2*" />
                    <DataGridTextColumn Header="상태" Binding="{Binding ComparisonValidityStatus}" Width="105" />
                  </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,10,0,10" BorderBrush="#5B4B32">
                  <StackPanel>
                    <TextBlock Text="HUMAN DECISION" Foreground="#D7A84B" FontSize="10" FontWeight="SemiBold" />
                    <WrapPanel Margin="0,8,0,0">
                      <TextBlock Width="65" VerticalAlignment="Center" Text="검토자" />
                      <TextBox x:Name="ReviewReviewerText" Width="130" />
                      <TextBlock Width="65" Margin="12,0,0,0" VerticalAlignment="Center" Text="판정 이유" />
                      <TextBox x:Name="ReviewReasonText" Width="300" />
                    </WrapPanel>
                    <WrapPanel Margin="0,8,0,0">
                      <TextBlock Width="105" VerticalAlignment="Center" Text="Study 비교가능성" />
                      <ComboBox x:Name="ReviewStudyComparabilityCombo" Width="115" SelectedValuePath="Tag">
                        <ComboBoxItem Tag="UNASSESSED" Content="UNASSESSED"/><ComboBoxItem Tag="VALID" Content="VALID"/>
                        <ComboBoxItem Tag="PARTIAL" Content="PARTIAL"/><ComboBoxItem Tag="INVALID" Content="INVALID"/>
                      </ComboBox>
                      <TextBlock Width="75" Margin="12,0,0,0" VerticalAlignment="Center" Text="Study 교란" />
                      <ComboBox x:Name="ReviewStudyConfoundingCombo" Width="115" SelectedValuePath="Tag">
                        <ComboBoxItem Tag="UNASSESSED" Content="UNASSESSED"/><ComboBoxItem Tag="NONE" Content="NONE"/>
                        <ComboBoxItem Tag="POSSIBLE" Content="POSSIBLE"/><ComboBoxItem Tag="CONFOUNDED" Content="CONFOUNDED"/>
                      </ComboBox>
                    </WrapPanel>
                    <WrapPanel Margin="0,8,0,0">
                      <TextBlock Width="105" VerticalAlignment="Center" Text="비교 유효성" />
                      <ComboBox x:Name="ReviewComparisonValidityCombo" Width="115" SelectedValuePath="Tag">
                        <ComboBoxItem Tag="NEEDS_REVIEW" Content="NEEDS_REVIEW"/><ComboBoxItem Tag="VALID" Content="VALID"/>
                        <ComboBoxItem Tag="INVALID" Content="INVALID"/><ComboBoxItem Tag="EXCLUDED" Content="EXCLUDED"/>
                      </ComboBox>
                      <TextBlock Width="75" Margin="12,0,0,0" VerticalAlignment="Center" Text="비교 교란" />
                      <ComboBox x:Name="ReviewComparisonConfoundingCombo" Width="115" SelectedValuePath="Tag">
                        <ComboBoxItem Tag="UNASSESSED" Content="UNASSESSED"/><ComboBoxItem Tag="NONE" Content="NONE"/>
                        <ComboBoxItem Tag="POSSIBLE" Content="POSSIBLE"/><ComboBoxItem Tag="CONFOUNDED" Content="CONFOUNDED"/>
                      </ComboBox>
                    </WrapPanel>
                    <DockPanel Margin="0,8,0,0"><TextBlock Width="105" VerticalAlignment="Center" Text="Matching basis"/><TextBox x:Name="ReviewMatchingBasisText" /></DockPanel>
                    <WrapPanel Margin="0,10,0,0">
                      <Button x:Name="ApproveReviewButton" Content="승인·효과 계산" Style="{StaticResource PrimaryButtonStyle}" Click="ApproveReview_Click" />
                      <Button x:Name="RejectReviewButton" Content="거절" Style="{StaticResource DangerButtonStyle}" Click="RejectReview_Click" />
                      <Button x:Name="ExcludeReviewButton" Content="제외" Click="ExcludeReview_Click" />
                      <Button x:Name="ReturnReviewButton" Content="재검토로 복귀" Click="ReturnReview_Click" />
                    </WrapPanel>
                  </StackPanel>
                </Border>
                <DataGrid x:Name="ReviewEvidenceGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True"
                          MouseDoubleClick="ReviewEvidenceGrid_MouseDoubleClick" CanUserAddRows="False">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="근거 ID" Binding="{Binding EvidenceId}" Width="150" />
                    <DataGridTextColumn Header="구분" Binding="{Binding Role}" Width="105" />
                    <DataGridTextColumn Header="시트" Binding="{Binding Sheet}" Width="105" />
                    <DataGridTextColumn Header="범위" Binding="{Binding Range}" Width="90" />
                    <DataGridTextColumn Header="값" Binding="{Binding ValueSummary}" Width="2*" />
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </TabItem>

            <!-- 5. Concept curation -->
            <TabItem Header="개념·별칭 정규화">
              <Grid Margin="18">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <WrapPanel>
                  <TextBox Width="62" IsReadOnly="True" Text="OPEN" Foreground="#A78BFA" />
                  <TextBox x:Name="ConceptCandidateKindFilterText" Width="135" Margin="8,0,0,7" ToolTip="CONCEPT:PROCESS 또는 UNIT" />
                  <TextBox x:Name="ConceptCandidateQueryText" Width="155" Margin="8,0,0,7" />
                  <Button x:Name="RefreshConceptCandidatesButton" Content="후보 새로고침" Click="RefreshConceptCandidates_Click" />
                  <TextBlock x:Name="ConceptCurationState" Margin="8,7,0,7" Foreground="#A78BFA" Text="OPEN 후보 새로고침 필요" />
                </WrapPanel>
                <DataGrid x:Name="ConceptCandidatesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionChanged="ConceptCandidatesGrid_SelectionChanged" CanUserAddRows="False">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="종류" Binding="{Binding CandidateKind}" Width="125" />
                    <DataGridTextColumn Header="원문" Binding="{Binding OriginalValue}" Width="2*" />
                    <DataGridTextColumn Header="제안 이름" Binding="{Binding SuggestedCanonicalName}" Width="2*" />
                    <DataGridTextColumn Header="건수" Binding="{Binding OccurrenceCount}" Width="55" />
                    <DataGridTextColumn Header="후보 UID" Binding="{Binding CandidateUid}" Width="175" />
                  </DataGrid.Columns>
                </DataGrid>
                <WrapPanel Grid.Row="2" Margin="0,10,0,7">
                  <TextBlock Margin="0,7,8,7" FontWeight="SemiBold" Text="동일 kind ACTIVE 개념" />
                  <TextBox x:Name="CanonicalConceptQueryText" Width="190" />
                  <Button x:Name="RefreshCanonicalConceptsButton" Content="개념 새로고침" Click="RefreshCanonicalConcepts_Click" />
                </WrapPanel>
                <DataGrid x:Name="CanonicalConceptsGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionChanged="CanonicalConceptsGrid_SelectionChanged" CanUserAddRows="False">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="종류" Binding="{Binding ConceptKind}" Width="100" />
                    <DataGridTextColumn Header="Canonical name" Binding="{Binding CanonicalName}" Width="2*" />
                    <DataGridTextColumn Header="승인 별칭" Binding="{Binding AliasSummary}" Width="3*" />
                    <DataGridTextColumn Header="개념 UID" Binding="{Binding ConceptUid}" Width="175" />
                  </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="4" Style="{StaticResource CardStyle}" Margin="0,10,0,0" BorderBrush="#5B4B32">
                  <StackPanel>
                    <WrapPanel>
                      <TextBlock Width="105" VerticalAlignment="Center" Text="Canonical name"/><TextBox x:Name="ConceptCanonicalNameText" Width="190" />
                      <TextBlock Width="48" Margin="12,0,0,0" VerticalAlignment="Center" Text="별칭"/><TextBox x:Name="ConceptAliasText" Width="180" />
                    </WrapPanel>
                    <WrapPanel Margin="0,8,0,0">
                      <TextBlock Width="105" VerticalAlignment="Center" Text="검토자"/><TextBox x:Name="ConceptReviewerText" Width="130" />
                      <TextBlock Width="48" Margin="12,0,0,0" VerticalAlignment="Center" Text="근거"/><TextBox x:Name="ConceptNoteText" Width="300" />
                    </WrapPanel>
                    <WrapPanel Margin="0,10,0,0">
                      <Button x:Name="CreateConceptButton" Content="새 개념 생성" Style="{StaticResource PrimaryButtonStyle}" Click="CreateConcept_Click" />
                      <Button x:Name="MergeConceptButton" Content="선택 개념에 병합" Click="MergeConcept_Click" />
                      <Button x:Name="RejectConceptButton" Content="후보 거절" Style="{StaticResource DangerButtonStyle}" Click="RejectConcept_Click" />
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </Grid>
            </TabItem>

            <!-- 6. Collect Excel files that are not in the DB -->
            <TabItem Header="신규 Excel 수집">
              <Grid Margin="18">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardStyle}" BorderBrush="#3F5F53" Padding="16">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="COLLECT NEW EXCEL FILES" Foreground="#7FE0BE" FontSize="10" FontWeight="SemiBold" />
                      <TextBlock Text="DB에 없는 Excel만 로컬 보관함으로 수집" Margin="0,6,0,0"
                                 FontSize="20" FontWeight="SemiBold" Foreground="#EEEEEE" />
                      <TextBlock Margin="0,6,0,0" Style="{StaticResource MutedTextStyle}"
                                 Text="선택한 폴더의 Excel 파일명을 DB와 비교한 뒤, DB에 없는 파일을 로컬 보관함 바로 아래에 복사합니다. 수집 후 Excel COM 사전 분석에서 양식 안전성을 먼저 판정합니다." />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#203C34" BorderBrush="#2C8C70"
                            BorderThickness="1" CornerRadius="12" Padding="10,5" VerticalAlignment="Top">
                      <TextBlock Text="수집 → COM 사전 분석" Foreground="#7FE0BE" FontSize="10" FontWeight="SemiBold" />
                    </Border>
                  </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="12">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock VerticalAlignment="Center" Text="검색할 폴더"/>
                      <TextBox x:Name="ExcelFolderSearchPathText" Grid.Column="1" IsReadOnly="True"
                               ToolTip="파일을 열지 않고 하위 Excel 파일명만 검색할 폴더"/>
                      <Button x:Name="ExcelFolderSearchButton" Grid.Column="2" Content="검색 폴더 선택"
                              Margin="8,0,0,7" Click="ExcelFolderSearch_Click"
                              ToolTip="지정 폴더와 하위 폴더의 Excel 파일명만 읽어 현재 DB 존재 여부를 확인합니다." />
                      <Button x:Name="ExcelMultiFolderSearchButton" Grid.Column="3"
                              Content="검색 폴더 여러 개"
                              Margin="8,0,0,7" Click="ExcelMultiFolderSearch_Click"
                              ToolTip="저장된 검색 폴더 이력을 불러오거나 여러 폴더를 추가해 한 번에 검색합니다." />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,4,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock VerticalAlignment="Center" Text="로컬 보관함"/>
                      <TextBox x:Name="ExcelArchivePathText" Grid.Column="1" IsReadOnly="True"
                               ToolTip="DB에 없는 Excel 복사본이 배치별로 저장되는 위치"/>
                    </Grid>
                  </Grid>
                </Border>

                <Border x:Name="ExcelFolderSearchPanel" Grid.Row="2" Style="{StaticResource CardStyle}"
                        Margin="0,12,0,0" Padding="12" BorderBrush="#3F5F53">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="DB 비교 결과" Foreground="#7FE0BE" FontWeight="SemiBold" />
                      <Button x:Name="CopyMissingExcelSearchButton" Grid.Column="1"
                              Content="DB 없음 모두 이 폴더로 복사"
                              Click="CopyMissingExcelSearch_Click" IsEnabled="False"
                              ToolTip="검색 결과 중 DB에 없는 파일만 로컬 ExcelFileArchive 보관함에 복사합니다. 네트워크 원본은 변경하지 않습니다." />
                      <Button x:Name="ProcessCollectedExcelButton" Grid.Column="2"
                              Content="Excel COM 사전 분석"
                              Style="{StaticResource PrimaryButtonStyle}"
                              Click="GoToFormPreflight_Click" IsEnabled="False"
                              ToolTip="로컬 보관함의 Excel을 COM으로 읽고 기존 분석 양식과 먼저 비교합니다. AI 분석은 실행하지 않습니다." />
                    </Grid>
                    <TextBlock x:Name="ExcelFolderSearchSummary" Grid.Row="1" Margin="0,5,0,8"
                               Foreground="#B8B8B8" TextWrapping="Wrap"
                               Text="검색 폴더를 선택하면 파일명을 DB와 비교합니다." />
                    <TextBlock x:Name="CollectedExcelProcessingState" Grid.Row="2" Margin="0,0,0,8"
                               Foreground="#B9A8E8" TextWrapping="Wrap"
                               Text="로컬 보관함의 처리 대상을 확인하는 중입니다." />
                    <DataGrid x:Name="ExcelFolderSearchGrid" Grid.Row="3" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True"
                              SelectionMode="Single">
                      <DataGrid.Columns>
                        <DataGridTemplateColumn Header="DB 상태" Width="145">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <Grid>
                                <Button Content="DB 있음 · 원본 열기"
                                        Click="OpenMatchedDatabaseExcel_Click"
                                        Margin="2" Padding="8,3"
                                        Foreground="#7FE0BE"
                                        Background="#203C34"
                                        BorderBrush="#2C8C70"
                                        ToolTip="{Binding DatabaseSourcePath}">
                                  <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                      <Setter Property="Visibility" Value="Collapsed"/>
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding ExistsInDatabase}" Value="True">
                                          <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </Button.Style>
                                </Button>
                                <Border Background="#392326" BorderBrush="#704047"
                                        BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="2">
                                  <Border.Style>
                                    <Style TargetType="Border">
                                      <Setter Property="Visibility" Value="Visible"/>
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding ExistsInDatabase}" Value="True">
                                          <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </Border.Style>
                                  <TextBlock Text="DB 없음 · 수집 대상"
                                             Foreground="#FF8E87" FontWeight="SemiBold"
                                             HorizontalAlignment="Center"/>
                                </Border>
                              </Grid>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Excel 파일명" Binding="{Binding FileName}" Width="3*" />
                        <DataGridTextColumn Header="검색 폴더" Binding="{Binding SearchRoot}" Width="2*" />
                        <DataGridTextColumn Header="하위 폴더" Binding="{Binding RelativeFolder}" Width="2*" />
                      </DataGrid.Columns>
                    </DataGrid>
                  </Grid>
                </Border>
              </Grid>
            </TabItem>

            <!-- 7. Collected Excel end-to-end workflow status and retry -->
            <TabItem Header="전체 처리 상태·재시도">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="18">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Border Style="{StaticResource CardStyle}" BorderBrush="#6D50A5" Padding="16">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="DRM EXCEL → AI → QUESTION" Foreground="#A78BFA" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Text="사전 분석 통과 Excel 전체 처리" Margin="0,6,0,0" FontSize="20" FontWeight="SemiBold" Foreground="#EEEEEE" />
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource MutedTextStyle}"
                                   Text="Excel COM 사전 분석에서 기존 양식으로 판정된 파일만 처리합니다. 사전 추출한 COM 데이터를 재사용하고, 신규·유사 양식과 추출 실패 파일은 AI 분석에서 제외합니다." />
                      </StackPanel>
                      <Border Grid.Column="1" Background="#203C34" BorderBrush="#2C8C70" BorderThickness="1" CornerRadius="12" Padding="10,5" VerticalAlignment="Top">
                        <TextBlock Text="사전 분석 통과본만" Foreground="#7FE0BE" FontSize="10" FontWeight="SemiBold" />
                      </Border>
                    </Grid>
                  </Border>

                  <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="150"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="처리 대상 보관함"
                               VerticalAlignment="Center"
                               Foreground="#B9A8E8"
                               FontWeight="SemiBold" />
                    <ComboBox x:Name="IngestSourceModeSelector" SelectedIndex="1"
                              Visibility="Collapsed"
                              FontWeight="SemiBold"
                              SelectionChanged="IngestSourceModeSelector_SelectionChanged">
                      <ComboBoxItem Content="Excel 파일 1개" Tag="file"/>
                      <ComboBoxItem Content="Excel 폴더" Tag="folder"/>
                    </ComboBox>
                    <TextBox x:Name="IngestWorkbookPathText" Grid.Column="1" IsReadOnly="True"
                             ToolTip="신규 Excel 수집에서 사용하는 로컬 보관함 경로"/>
                    <Button x:Name="BrowseIngestSourceButton" Visibility="Collapsed"
                            Content="Excel 선택"
                            Click="BrowseIngestWorkbook_Click" />
                  </Grid>

                  <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,8,0,0" Padding="12">
                    <StackPanel>
                      <TextBlock Text="처리 단계" Foreground="#D7D7D7" FontWeight="SemiBold" Margin="2,0,0,8"/>
                      <ItemsControl x:Name="IngestStagesList">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Background="{Binding Background}" BorderBrush="{Binding BorderBrush}" BorderThickness="1"
                                    CornerRadius="5" Padding="10,7" Margin="0,0,0,5">
                              <Grid>
                                <Grid.RowDefinitions>
                                  <RowDefinition Height="Auto"/>
                                  <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="34"/>
                                  <ColumnDefinition Width="190"/>
                                  <ColumnDefinition Width="90"/>
                                  <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="12" Background="{Binding MarkerBrush}">
                                  <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Foreground="White" FontSize="11" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                                           Foreground="#ECECEC" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="2" Text="{Binding StatusText}" VerticalAlignment="Center"
                                           Foreground="{Binding StatusBrush}" FontWeight="SemiBold" FontSize="11"/>
                                <TextBlock Grid.Column="3" Text="{Binding Detail}" VerticalAlignment="Center"
                                           Foreground="#929292" TextTrimming="CharacterEllipsis"/>
                                <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,7,0,1"
                                      Visibility="{Binding ProgressVisibility}">
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                  </Grid.ColumnDefinitions>
                                  <ProgressBar Height="5" Minimum="0"
                                               Maximum="{Binding ProgressMaximum}"
                                               Value="{Binding ProgressValue, Mode=OneWay}"
                                               Background="#353535"
                                               Foreground="#8B5CF6"
                                               BorderThickness="0"/>
                                  <TextBlock Grid.Column="1" Margin="10,-5,0,0"
                                             Text="{Binding ProgressText}"
                                             Foreground="#B9A8E8"
                                             FontSize="10"
                                             FontFamily="Consolas"/>
                                </Grid>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>

                  <Grid Grid.Row="3" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button x:Name="IngestWorkbookButton" Content="전체 실행" Style="{StaticResource PrimaryButtonStyle}" Click="IngestWorkbook_Click" />
                    <Button x:Name="RetryIngestButton" Grid.Column="1" Content="실패 단계 재시도" Click="RetryIngest_Click" IsEnabled="False" />
                    <Button x:Name="InspectIngestResultButton" Grid.Column="2" Content="처리 내용 검증" Style="{StaticResource PrimaryButtonStyle}"
                            Click="InspectIngestResult_Click" IsEnabled="False"
                            ToolTip="적재된 Study, 시험군·비교군, 측정값과 원본 셀 근거를 확인합니다." />
                    <Button Grid.Column="3" Content="질문 화면으로" Click="GoToEvidenceQuestion_Click" />
                    <TextBlock x:Name="IngestWorkbookState" Grid.Column="4" Margin="10,0,0,7" VerticalAlignment="Center"
                               Foreground="#A78BFA" Text="Excel 원본을 선택하세요." TextWrapping="Wrap" />
                  </Grid>

                  <Expander Grid.Row="4" Header="  인증창 고급 설정" Margin="0,8,0,0" BorderBrush="#343434" BorderThickness="1">
                    <StackPanel Margin="12,8,12,12">
                      <WrapPanel>
                        <CheckBox x:Name="InspectAuthDialogCheck" Content="인증창 정보 확인" Margin="0,0,18,8"
                                  ToolTip="Excel 소유 인증창의 제목·클래스·버튼을 로그에 표시하며 자동으로 닫지 않습니다."/>
                        <CheckBox x:Name="DismissAuthDialogCheck" Content="정확히 일치할 때 버튼 클릭" Margin="0,0,18,8"
                                  ToolTip="아래 세 값이 모두 정확히 일치하는 Excel 소유 창의 버튼만 클릭합니다."/>
                      </WrapPanel>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="AuthDialogTitleText" Margin="0,0,6,0" ToolTip="인증창 제목" />
                        <TextBox x:Name="AuthDialogClassText" Grid.Column="1" Margin="6,0" ToolTip="인증창 Window class" />
                        <TextBox x:Name="AuthDialogButtonText" Grid.Column="2" Margin="6,0,0,0" ToolTip="클릭할 버튼 문구" />
                      </Grid>
                      <TextBlock Margin="0,7,0,0" Foreground="#8E8E8E" FontSize="10" TextWrapping="Wrap"
                                 Text="확인 모드는 창 정보를 개발자 로그에 표시합니다. 자동 클릭은 제목·클래스·버튼 세 값이 모두 입력되고 정확히 일치할 때만 동작합니다."/>
                    </StackPanel>
                  </Expander>
                </Grid>
              </ScrollViewer>
            </TabItem>

            <!-- 8. Home -->
            <TabItem Header="홈">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="26">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <Border Style="{StaticResource CardStyle}" BorderBrush="#6D50A5" Padding="22">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="INFERENCE DATA AI" Foreground="#A78BFA" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Text="검증 가능한 Excel 분석 작업실" Margin="0,8,0,0"
                                   FontSize="26" FontWeight="SemiBold" Foreground="#F0F0F0" />
