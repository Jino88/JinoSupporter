<Window x:Class="InferenceDataAIService.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inference Data AI Service" Height="900" Width="1540" MinHeight="650" MinWidth="1100">
  <Grid Background="#F5F7FA">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="220" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="620" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Grid Grid.Row="0" Grid.Column="0" Margin="14">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock FontSize="22" FontWeight="SemiBold" Text="Excel 분석 목록" />
      <DockPanel Grid.Row="1" Margin="0,12,0,10">
        <Button Width="110" Height="32" Margin="0,0,8,0" Content="폴더 추가" Click="AddFolder_Click" />
        <Button Width="95" Height="32" Margin="0,0,8,0" Content="새로 고침" Click="Refresh_Click" />
        <TextBlock VerticalAlignment="Center" Foreground="#52606D" Text="우클릭 → 분석 시작" />
      </DockPanel>
      <DataGrid x:Name="FilesGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionChanged="FilesGrid_SelectionChanged" CanUserAddRows="False" Background="White">
        <DataGrid.ContextMenu>
          <ContextMenu>
            <MenuItem Header="선택 파일 분석 시작" Click="AnalyzeSelected_Click" />
            <MenuItem Header="결과 HTML 열기" Click="OpenResult_Click" />
          </ContextMenu>
        </DataGrid.ContextMenu>
        <DataGrid.Columns>
          <DataGridTextColumn Header="Excel 파일" Binding="{Binding FileName}" Width="2*" />
          <DataGridTextColumn Header="DB" Binding="{Binding DbStatus}" Width="80" />
          <DataGridTextColumn Header="분석" Binding="{Binding AnalysisStatus}" Width="110" />
          <DataGridTextColumn Header="진행" Binding="{Binding Progress}" Width="150" />
        </DataGrid.Columns>
      </DataGrid>
    </Grid>

    <Grid Grid.Row="0" Grid.Column="1" Margin="0,14,14,14">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock x:Name="ResultTitle" FontSize="22" FontWeight="SemiBold" Text="분석 결과" />
      <WebBrowser x:Name="ResultBrowser" Grid.Row="1" Margin="0,12,0,0" />
    </Grid>

    <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="14,0,14,14" BorderBrush="#D8DEE8" BorderThickness="1" Background="#111827" CornerRadius="6">
      <TextBox x:Name="LogText" Padding="12" Background="Transparent" Foreground="#D1FAE5" FontFamily="Consolas" FontSize="12" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
    </Border>
  </Grid>
</Window>
