<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.102.3" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR" Version="1.2.9" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.3" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.5" />
    <PackageReference Include="Microsoft.Playwright" Version="1.59.0" />
    <PackageReference Include="Syncfusion.Blazor.Core" Version="33.1.49" />
    <PackageReference Include="Syncfusion.Blazor.Spreadsheet" Version="33.1.49" />
    <PackageReference Include="Syncfusion.Blazor.WordProcessor" Version="33.1.49" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.5" />
  </ItemGroup>

  <!-- DRM-cleaner C# wrapper lives next to its Python CLI (External/ExcelDrmCli/).
       Linked here so callers see ExcelDrm.ExcelDrmCleaner without a separate
       assembly reference. The actual conversion runs in Python via subprocess. -->
  <ItemGroup>
    <Compile Include="..\External\ExcelDrmCli\ExcelDrmCleaner.cs">
      <Link>Services\ExcelDrmCleaner.cs</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\AI_PROMPTS\**\*">
      <Link>AI_PROMPTS\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Update="GraphMakerExamples\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <None Include="GraphMakerExamples\*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
    <Content Include="tools\input_data_excel_com_extract.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- wwwroot/ui-redesign/assets/instrument.scoped.css is generated from
       instrument.css by tools/scope-css.js. Editing the source and forgetting to
       regenerate ships stale CSS with no visible failure, so the build checks.

       Node is treated as optional: exit code 1 means real drift and fails the
       build, anything else (9009/127 = node not installed) only warns, so a
       machine without Node can still build. Set SkipScopedCssCheck=true to opt out. -->
  <Target Name="CheckScopedCss" BeforeTargets="Build" Condition="'$(SkipScopedCssCheck)' != 'true'">
    <Exec Command="node tools/scope-css.js check"
          WorkingDirectory="$(MSBuildProjectDirectory)/.."
          ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="ScopedCssExit" />
    </Exec>
    <Warning Condition="'$(ScopedCssExit)' != '0' and '$(ScopedCssExit)' != '1'"
             Text="Skipped the scoped-CSS check: node exited $(ScopedCssExit). Install Node.js to enable it." />
    <Error Condition="'$(ScopedCssExit)' == '1'"
           Text="instrument.scoped.css is out of date with instrument.css. Run: node tools/scope-css.js" />
  </Target>

</Project>
