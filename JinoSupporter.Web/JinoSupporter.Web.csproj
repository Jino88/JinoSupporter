<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.102.3" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR" Version="1.2.9" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.3" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.5" />
    <PackageReference Include="Microsoft.Playwright" Version="1.59.0" />
    <PackageReference Include="Syncfusion.Blazor.Core" Version="33.1.49" />
    <PackageReference Include="Syncfusion.Blazor.Spreadsheet" Version="33.1.49" />
    <PackageReference Include="Syncfusion.Blazor.WordProcessor" Version="33.1.49" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.5" />
  </ItemGroup>

  <!-- DRM-cleaner C# wrapper lives next to its Python CLI (External/ExcelDrmCli/).
       Linked here so callers see ExcelDrm.ExcelDrmCleaner without a separate
       assembly reference. The actual conversion runs in Python via subprocess. -->
  <ItemGroup>
    <Compile Include="..\External\ExcelDrmCli\ExcelDrmCleaner.cs">
      <Link>Services\ExcelDrmCleaner.cs</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Content Update="GraphMakerExamples\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <None Include="GraphMakerExamples\*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
