@page "/qr/summary"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Globalization
@using JinoSupporter.Web.Services
@inject QrSummaryService QrSummary
@inject QrModelCodeService QrModelCodes
@inject QrViewPreferenceService QrViewPrefs
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>QR SUMMARY</PageTitle>

<div class="qrs-page">
    <header class="qrs-titlebar">
        <div>
            <div class="qrs-kicker">AIRLEAK · BAKO · GAUSS COMBINED</div>
            <h1>QR SUMMARY</h1>
            <p>One row per Product ID across the three stations. Each value is that station’s most recent test within the selected period.</p>
        </div>
        <div class="qrs-actions">
            <span class="qrs-connection">@ConnectionLabel</span>
            <button class="qrs-btn qrs-primary"
                    type="button"
                    @onclick="ReloadAsync"
                    disabled="@(_busy || !QrSummary.IsConfigured)">
                @if (_busy)
                {
                    <span class="qrs-spinner" aria-hidden="true"></span>
                    <span>Loading</span>
                }
                else
                {
                    <span>Refresh</span>
                }
            </button>
            <button class="qrs-btn"
                    type="button"
                    title="Two sheets: the newest round per QR, and every round of the selected period"
                    @onclick="ExportExcelAsync"
                    disabled="@(_busy || _exporting || VisibleRows.Count == 0)">
                @if (_exporting)
                {
                    <span class="qrs-spinner" aria-hidden="true"></span>
                    <span>Exporting</span>
                }
                else
                {
                    <span>XLSX</span>
                }
            </button>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="qrs-alert qrs-danger">@_error</div>
    }

    @if (!string.IsNullOrWhiteSpace(_notice))
    {
        <div class="qrs-alert qrs-warning">@_notice</div>
    }

    @if (!QrSummary.IsConfigured)
    {
        <div class="qrs-alert qrs-warning">QR DB password is not configured on the server.</div>
    }
    else if (_result is not null && !string.IsNullOrWhiteSpace(_result.WarningMessage))
    {
        <div class="qrs-alert qrs-warning">@_result.WarningMessage</div>
    }

    <div class="qrs-toolbar">
        @* No disabled binding on the date inputs: disabling one mid-entry drops the caret,
           which is exactly what happens while the debounced reload runs. *@
        <label class="qrs-field">
            <span>From</span>
            <input type="date"
                   value="@_from.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
                   @onchange="OnFromChanged" />
        </label>
        <label class="qrs-field">
            <span>To</span>
            <input type="date"
                   value="@_to.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
                   @onchange="OnToChanged" />
        </label>
        <div class="qrs-quick">
            <button class="qrs-chip" type="button" disabled="@_busy" @onclick="() => ApplyQuickRangeAsync(0)">Latest day</button>
            <button class="qrs-chip" type="button" disabled="@_busy" @onclick="() => ApplyQuickRangeAsync(6)">7 days</button>
            <button class="qrs-chip" type="button" disabled="@_busy" @onclick="() => ApplyQuickRangeAsync(29)">30 days</button>
        </div>
        <label class="qrs-field">
            <span>Max QR</span>
            <select disabled="@_busy" @onchange="OnMaxRowsChanged">
                @foreach (int option in MaxRowOptions)
                {
                    <option value="@option" selected="@(option == _maxRows)">@option.ToString("N0")</option>
                }
            </select>
        </label>
        @* The model lives in characters 11-12 of the QR itself, which is the only model marker
           the three stations agree on; the names come from Setting → QR Model Codes. *@
        <label class="qrs-field qrs-grow">
            <span>Model</span>
            <select disabled="@_busy" @onchange="OnModelChanged">
                <option value="" selected="@(_modelCode.Length == 0)">All models</option>
                @foreach (ModelOption option in _modelOptions)
                {
                    <option value="@option.Code" selected="@(option.Code == _modelCode)">@option.Label</option>
                }
            </select>
        </label>
        <div class="qrs-quick">
            <button class="qrs-chip @(_filter == RowFilter.All ? "qrs-on" : "")"
                    type="button" @onclick="() => SetFilter(RowFilter.All)">All</button>
            <button class="qrs-chip @(_filter == RowFilter.NgOnly ? "qrs-on" : "")"
                    type="button" @onclick="() => SetFilter(RowFilter.NgOnly)">Has NG</button>
            <button class="qrs-chip @(_filter == RowFilter.CompleteOnly ? "qrs-on" : "")"
                    type="button" @onclick="() => SetFilter(RowFilter.CompleteOnly)">All 3 stations</button>
        </div>
    </div>

    @if (_busy && _result is null)
    {
        <div class="qrs-state">
            <span class="qrs-spinner" aria-hidden="true"></span>
            <span>Reading ALTD / BKTD / GSTD from TCDB.</span>
        </div>
    }
    else if (_result is null)
    {
        <div class="qrs-state">No data loaded.</div>
    }
    else
    {
        <div class="qrs-cards">
            <article class="qrs-card">
                <span>QR count</span>
                <strong>@_result.Rows.Count.ToString("N0")</strong>
                <small>@(_result.HitMaxRows ? $"Latest {_result.MaxRows:N0} of {_result.TotalProducts:N0} total" : "Whole selected period")</small>
            </article>
            @foreach (StationCard card in StationCards)
            {
                @if (card.Station == GaussStation)
                {
                    <button class="qrs-card qrs-card-link"
                            type="button"
                            title="Open the GAUSS dispersion scatter in a new window"
                            @onclick="OpenGaussScatterAsync">
                        <span>@card.Station <em class="qrs-card-cue">SCATTER ↗</em></span>
                        <strong>@card.Tested.ToString("N0")</strong>
                        <small>NG @card.Ng.ToString("N0") · @FormatPpm(card.NgRatePpm)</small>
                    </button>
                }
                else
                {
                    <article class="qrs-card">
                        <span>@card.Station</span>
                        <strong>@card.Tested.ToString("N0")</strong>
                        <small>NG @card.Ng.ToString("N0") · @FormatPpm(card.NgRatePpm)</small>
                    </article>
                }
            }
            <article class="qrs-card">
                <span>All 3 stations tested</span>
                <strong>@CompleteCount.ToString("N0")</strong>
                <small>QR with data from all three stations</small>
            </article>
            <article class="qrs-card">
                <span>QR with NG</span>
                <strong>@NgRowCount.ToString("N0")</strong>
                <small>QR failing at least one station</small>
            </article>
        </div>

        <div class="qrs-table-wrap">
            @if (VisibleRows.Count == 0)
            {
                <div class="qrs-empty">No QR matches the current filter.</div>
            }
            else
            {
                <table class="qrs-table">
                    <thead>
                        <tr class="qrs-group-row">
                            <th rowspan="2" class="qrs-group-head">QR GROUP</th>
                            <th rowspan="2" class="qrs-qr-head">Product ID</th>
                            <th rowspan="2" class="qrs-time-head">Last test</th>
                            <th rowspan="2" class="qrs-final-head">Final Result</th>
                            <th colspan="3" class="qrs-grp qrs-grp-air">AIRLEAK · dbo.ALTD</th>
                            <th colspan="7" class="qrs-grp qrs-grp-bako">BAKO · dbo.BKTD</th>
                            <th colspan="4" class="qrs-grp qrs-grp-gauss">
                                <button class="qrs-grp-link"
                                        type="button"
                                        title="Open the GAUSS dispersion scatter in a new window"
                                        @onclick="OpenGaussScatterAsync">GAUSS · dbo.GSTD ↗</button>
                            </th>
                        </tr>
                        <tr>
                            <th>Result</th><th>Value</th><th>Test time</th>
                            <th>Result</th><th>SPL1</th><th>SPL2</th><th>THD</th><th>ImpLimit</th><th>Imp2kHz</th><th>Test time</th>
                            <th>Result</th><th>Value</th><th>Value 2</th><th>Test time</th>
                        </tr>
                    </thead>
                    @* Virtualize keeps the render batch small: a 20,000 QR result would
                       otherwise push ~320,000 cells over the SignalR circuit at once.
                       Expanded rounds are flattened into the same list so every item stays
                       exactly one <tr> and the spacer arithmetic holds. *@
                    <tbody>
                        @* ItemSize matches the 2rem row height below; a mismatch makes the scrollbar drift. *@
                        <Virtualize Items="_lines" Context="line" ItemSize="32" SpacerElement="tr" OverscanCount="12">
                            @{ QrSummaryRow row = line.Row; }
                            <tr class="@LineClass(line)">
                                <td class="qrs-group-cell">
                                    @if (line.IsChild)
                                    {
                                        <span class="qrs-child-mark" aria-label="Earlier test round for the same QR">└</span>
                                    }
                                    else if (row.HasOlder)
                                    {
                                        <button class="qrs-group-toggle"
                                                type="button"
                                                aria-expanded="@line.Expanded.ToString().ToLowerInvariant()"
                                                title="@GroupTitle(row, line.Expanded)"
                                                @onclick="() => ToggleGroup(row.ProductId)">
                                            <span aria-hidden="true">@(line.Expanded ? "−" : "+")</span>
                                            <b>@row.Older.Count.ToString("N0")</b>
                                        </button>
                                    }
                                </td>
                                <td class="qrs-qr">@(line.IsChild ? string.Empty : row.ProductId)</td>
                                <td class="qrs-time">@FormatTime(row.LatestTime)</td>
                                <td class="qrs-verdict @(row.IsFinalPass ? "qrs-pass" : "qrs-fail")" title="@row.FinalNote">@(row.IsFinalPass ? "PASS" : "NG")</td>

                                @* The verdict cell is the handle for its whole station block: it
                                   opens that station's own data browser on this QR's raw rows. *@
                                <td class="qrs-verdict @VerdictClass(row.Airleak)" title="@VerdictTitle(row.Airleak)">
                                    @if (row.Airleak is QrSummaryCell airleak)
                                    {
                                        <button class="qrs-cell-link" type="button"
                                                title="@DetailTitle(row, airleak)"
                                                @onclick="() => OpenStationDetailAsync(row, airleak)">@VerdictLabel(airleak)</button>
                                    }
                                    else
                                    {
                                        @VerdictLabel(row.Airleak)
                                    }
                                </td>
                                <td class="qrs-value @ItemClass(row.Airleak, 0)">@ItemText(row.Airleak, 0)</td>
                                <td class="qrs-time">@FormatTime(row.Airleak?.TestTime)</td>

                                <td class="qrs-verdict @VerdictClass(row.Bako)" title="@VerdictTitle(row.Bako)">
                                    @if (row.Bako is QrSummaryCell bako)
                                    {
                                        <button class="qrs-cell-link" type="button"
                                                title="@DetailTitle(row, bako)"
                                                @onclick="() => OpenStationDetailAsync(row, bako)">@VerdictLabel(bako)</button>
                                    }
                                    else
                                    {
                                        @VerdictLabel(row.Bako)
                                    }
                                </td>
                                <td class="qrs-value @ItemClass(row.Bako, 0)">@ItemText(row.Bako, 0)</td>
                                <td class="qrs-value @ItemClass(row.Bako, 1)">@ItemText(row.Bako, 1)</td>
                                <td class="qrs-value @ItemClass(row.Bako, 2)">@ItemText(row.Bako, 2)</td>
                                <td class="qrs-value @ItemClass(row.Bako, 3)">@ItemText(row.Bako, 3)</td>
                                <td class="qrs-value @ItemClass(row.Bako, 4)">@ItemText(row.Bako, 4)</td>
                                <td class="qrs-time">@FormatTime(row.Bako?.TestTime)</td>

                                <td class="qrs-verdict @VerdictClass(row.Gauss)" title="@VerdictTitle(row.Gauss)">
                                    @if (row.Gauss is QrSummaryCell gauss)
                                    {
                                        <button class="qrs-cell-link" type="button"
                                                title="@DetailTitle(row, gauss)"
                                                @onclick="() => OpenStationDetailAsync(row, gauss)">@VerdictLabel(gauss)</button>
                                    }
                                    else
                                    {
                                        @VerdictLabel(row.Gauss)
                                    }
                                </td>
                                <td class="qrs-value @ItemClass(row.Gauss, 0)">@ItemText(row.Gauss, 0)</td>
                                <td class="qrs-value @ItemClass(row.Gauss, 1)">@ItemText(row.Gauss, 1)</td>
                                <td class="qrs-time">@FormatTime(row.Gauss?.TestTime)</td>
                            </tr>
                        </Virtualize>
                    </tbody>
                </table>
            }
        </div>

        <footer class="qrs-foot">
            <span>@_result.From.ToString("yyyy-MM-dd") ~ @_result.To.ToString("yyyy-MM-dd")</span>
            <span>Shown @VisibleRows.Count.ToString("N0") / fetched @_result.Rows.Count.ToString("N0") QR</span>
            <span>Only 17-character Product IDs are counted</span>
            @if (_result.FetchedAt != default)
            {
                <span>as of @_result.FetchedAt.ToString("yyyy-MM-dd HH:mm:ss")</span>
            }
        </footer>
    }
</div>

<style>
    .qrs-page {
        display: flex;
        min-height: 32rem;
        height: calc(var(--view-h, 100vh) - 6.2rem);
        margin: -0.25rem -0.5rem 0;
        padding: 0.8rem 1rem 1rem;
        flex-direction: column;
        overflow: hidden;
        background: var(--plane, #e8eaee);
        color: var(--ink, #0f1319);
        font-family: var(--sans, "Segoe UI", "Malgun Gothic", sans-serif);
    }

    .qrs-titlebar {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 0.7rem;
        flex: 0 0 auto;
    }

    .qrs-kicker {
        margin-bottom: 0.2rem;
        color: var(--crit, #c8342a);
        font-family: var(--mono, Bahnschrift, Consolas, monospace);
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.04em;
    }

    .qrs-titlebar h1 {
        margin: 0;
        font-size: 1.12rem;
        line-height: 1.25;
    }

    .qrs-titlebar p {
        margin: 0.16rem 0 0;
        color: var(--ink-2, #4a5461);
        font-size: 0.76rem;
    }

    .qrs-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.4rem;
        min-width: 0;
    }

    .qrs-connection {
        max-width: 24rem;
        margin-right: 0.25rem;
        overflow: hidden;
        color: var(--ink-3, #7f8a98);
        font-family: var(--mono, Bahnschrift, Consolas, monospace);
        font-size: 0.66rem;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .qrs-btn {
        display: inline-flex;
        min-height: 1.9rem;
        padding: 0.32rem 0.72rem;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
        border: 1px solid var(--line-2, #c6ccd5);
        border-radius: 2px;
        background: var(--panel, #fff);
        color: var(--ink, #0f1319);
        font: 700 0.7rem var(--sans, "Segoe UI", sans-serif);
        cursor: pointer;
    }

    .qrs-btn:hover:not(:disabled) {
        background: var(--panel-2, #f5f6f9);
        border-color: var(--ink, #0f1319);
    }

    .qrs-btn.qrs-primary {
        border-color: var(--signal, #16202b);
        background: var(--signal, #16202b);
        color: var(--panel, #fff);
    }

    .qrs-btn:disabled,
    .qrs-chip:disabled {
        cursor: default;
        opacity: 0.55;
    }

    .qrs-spinner {
        display: inline-block;
        width: 0.78rem;
        height: 0.78rem;
        border: 2px solid var(--line-2, #c6ccd5);
        border-top-color: currentColor;
        border-radius: 50%;
        animation: qrs-spin 0.75s linear infinite;
    }

    .qrs-alert,
    .qrs-state {
        margin-bottom: 0.65rem;
        padding: 0.58rem 0.72rem;
        border: 1px solid var(--line-2, #c6ccd5);
        border-radius: 2px;
        background: var(--panel, #fff);
        color: var(--ink-2, #4a5461);
        font-size: 0.76rem;
    }

    .qrs-state {
        display: flex;
        min-height: 8rem;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
    }

    .qrs-alert.qrs-danger {
        border-color: var(--crit, #c8342a);
        background: var(--crit-wash, #fbedec);
        color: var(--crit, #c8342a);
    }

    .qrs-alert.qrs-warning {
        border-color: var(--line-2, #c6ccd5);
        background: var(--panel-2, #f5f6f9);
    }

    .qrs-toolbar {
        display: flex;
        margin-bottom: 0.6rem;
        padding: 0.5rem 0.6rem;
        align-items: flex-end;
        gap: 0.6rem;
        flex: 0 0 auto;
        flex-wrap: wrap;
        border: 1px solid var(--line-2, #c6ccd5);
        border-radius: 2px;
        background: var(--panel, #fff);
    }

    .qrs-field {
        display: flex;
        min-width: 0;
        flex-direction: column;
        gap: 0.18rem;
    }

    .qrs-field.qrs-grow {
        flex: 1 1 12rem;
    }

    .qrs-field > span {
        color: var(--ink-3, #7f8a98);
        font-size: 0.64rem;
        font-weight: 700;
        letter-spacing: 0.02em;
    }

    .qrs-field input,
    .qrs-field select {
        min-height: 1.9rem;
        padding: 0.24rem 0.4rem;
        border: 1px solid var(--line-2, #c6ccd5);
        border-radius: 2px;
        background: var(--panel, #fff);
        color: var(--ink, #0f1319);
        font: 400 0.72rem var(--mono, Bahnschrift, Consolas, monospace);
    }

    .qrs-quick {
        display: flex;
        gap: 0.25rem;
    }

    .qrs-chip {
        min-height: 1.9rem;
        padding: 0.28rem 0.6rem;
        border: 1px solid var(--line-2, #c6ccd5);
        border-radius: 2px;
        background: var(--panel, #fff);
        color: var(--ink-2, #4a5461);
        font: 700 0.68rem var(--sans, "Segoe UI", sans-serif);
        cursor: pointer;
    }

    .qrs-chip:hover:not(:disabled) {
        border-color: var(--ink, #0f1319);
    }

    .qrs-chip.qrs-on {
        border-color: var(--signal, #16202b);
        background: var(--signal, #16202b);
        color: var(--panel, #fff);
    }

    .qrs-cards {
        display: grid;
        margin-bottom: 0.6rem;
        flex: 0 0 auto;
        grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
        border: 1px solid var(--line-2, #c6ccd5);
        border-radius: 2px;
        background: var(--panel, #fff);
    }

    .qrs-card {
        display: grid;
        min-height: 4.2rem;
        padding: 0.5rem 0.7rem;
        align-content: center;
        gap: 0.1rem;
        border-right: 1px solid var(--line, #dde1e7);
    }

    .qrs-card:last-child {
        border-right: 0;
    }

    /* The GAUSS card is a button; strip the control chrome so it still reads as a card. */
    .qrs-card-link {
        border-top: 0;
        border-bottom: 0;
        border-left: 0;
        border-radius: 0;
        background: var(--panel, #fff);
        font: inherit;
        text-align: left;
        cursor: pointer;
    }

    .qrs-card-link:hover {
        background: var(--panel-2, #f5f6f9);
        box-shadow: inset 0 -2px 0 var(--signal, #16202b);
    }

    .qrs-card-cue {
        margin-left: 0.3rem;
        color: var(--signal, #16202b);
        font-size: 0.58rem;
        font-style: normal;
        font-weight: 800;
        letter-spacing: 0.03em;
    }

    .qrs-grp-link {
        padding: 0;
        border: 0;
        background: none;
        color: inherit;
        font: inherit;
        text-decoration: underline dotted;
        text-underline-offset: 2px;
        cursor: pointer;
    }

    .qrs-grp-link:hover {
        color: var(--signal, #16202b);
        text-decoration: underline solid;
    }

    .qrs-card span,
    .qrs-card small {
        color: var(--ink-3, #7f8a98);
        font-size: 0.63rem;
    }

    .qrs-card strong {
        color: var(--ink, #0f1319);
        font: 800 1.02rem var(--mono, Bahnschrift, Consolas, monospace);
        font-variant-numeric: tabular-nums;
    }

    .qrs-table-wrap {
        min-width: 0;
        min-height: 0;
        flex: 1 1 auto;
        overflow: auto;
        border: 1px solid var(--line-2, #c6ccd5);
        border-radius: 2px;
        background: var(--panel, #fff);
    }

    .qrs-table {
        width: max-content;
        min-width: 100%;
        border-collapse: collapse;
        background: var(--panel, #fff);
        font-size: 0.69rem;
    }

    .qrs-table th,
    .qrs-table td {
        height: 2rem;
        padding: 0.28rem 0.48rem;
        border: 1px solid var(--line, #dde1e7);
        text-align: left;
        white-space: nowrap;
    }

    .qrs-table th {
        position: sticky;
        top: 1.85rem;
        z-index: 3;
        border-bottom-color: var(--line-2, #c6ccd5);
        background: var(--panel-2, #f5f6f9);
        color: var(--ink-2, #4a5461);
        font-weight: 700;
        text-align: center;
    }

    .qrs-table .qrs-group-row th {
        top: 0;
        z-index: 4;
    }

    .qrs-table .qrs-group-head,
    .qrs-table .qrs-qr-head,
    .qrs-table .qrs-time-head,
    .qrs-table .qrs-final-head {
        top: 0;
        z-index: 5;
    }

    .qrs-grp {
        letter-spacing: 0.03em;
    }

    .qrs-grp-air    { background: #eef4fb; }
    .qrs-grp-bako   { background: #f3f1fb; }
    .qrs-grp-gauss  { background: #eef8f2; }

    /* QR GROUP is the leftmost frozen column; Product ID freezes right behind it. */
    .qrs-table .qrs-group-head,
    .qrs-table td.qrs-group-cell {
        width: 3.7rem;
        min-width: 3.7rem;
        position: sticky;
        left: 0;
        padding-right: 0.3rem;
        padding-left: 0.3rem;
        border-right-color: var(--line-2, #c6ccd5);
        text-align: center;
    }

    .qrs-table td.qrs-group-cell {
        z-index: 2;
        background: var(--panel, #fff);
    }

    .qrs-table th.qrs-group-head {
        z-index: 6;
    }

    .qrs-table td.qrs-qr {
        position: sticky;
        left: 3.7rem;
        z-index: 2;
        border-right-color: var(--line-2, #c6ccd5);
        background: var(--panel, #fff);
        font-family: var(--mono, Bahnschrift, Consolas, monospace);
        font-weight: 700;
    }

    .qrs-table th.qrs-qr-head {
        position: sticky;
        left: 3.7rem;
        z-index: 6;
    }

    .qrs-group-toggle {
        display: inline-flex;
        min-width: 2.9rem;
        min-height: 1.45rem;
        padding: 0.12rem 0.3rem;
        align-items: center;
        justify-content: center;
        gap: 0.22rem;
        border: 1px solid var(--signal, #16202b);
        border-radius: 2px;
        background: var(--panel, #fff);
        color: var(--signal, #16202b);
        font: 700 0.65rem var(--mono, Bahnschrift, Consolas, monospace);
        cursor: pointer;
    }

    .qrs-group-toggle:hover {
        background: var(--signal, #16202b);
        color: var(--panel, #fff);
    }

    .qrs-child-mark {
        display: inline-block;
        color: var(--ink-2, #4a5461);
        font: 700 0.72rem var(--mono, Bahnschrift, Consolas, monospace);
    }

    .qrs-table tr.qrs-row-child td.qrs-group-cell {
        border-left: 3px solid var(--signal, #16202b);
        background: var(--panel-3, #eceef2);
    }

    .qrs-table tbody tr:nth-child(even) td {
        background: color-mix(in srgb, var(--panel-2, #f5f6f9) 48%, var(--panel, #fff));
    }

    .qrs-table tbody tr:hover td {
        background: var(--panel-3, #eceef2);
    }

    .qrs-table tr.qrs-row-ng td.qrs-group-cell {
        border-left: 3px solid var(--crit, #c8342a);
    }

    .qrs-table td.qrs-time {
        color: var(--ink-2, #4a5461);
        font-family: var(--mono, Bahnschrift, Consolas, monospace);
        font-variant-numeric: tabular-nums;
        text-align: center;
    }

    .qrs-table td.qrs-value {
        font-variant-numeric: tabular-nums;
        text-align: right;
    }

    .qrs-table td.qrs-value small {
        margin-left: 0.35rem;
        color: var(--ink-3, #7f8a98);
        font-size: 0.6rem;
    }

    .qrs-table td.qrs-verdict {
        font-weight: 800;
        text-align: center;
    }

    /* The verdict cell keeps its NG red / PASS wash, so the link inherits every colour and
       only adds the affordance. Padding matches the cell so the whole cell is the target. */
    .qrs-cell-link {
        display: block;
        width: 100%;
        padding: 0;
        border: 0;
        background: none;
        color: inherit;
        font: inherit;
        text-decoration: underline dotted;
        text-underline-offset: 2px;
        cursor: pointer;
    }

    .qrs-cell-link:hover {
        text-decoration: underline solid;
    }

    .qrs-table td.qrs-verdict.qrs-pass {
        background: var(--ok-wash, #eaf1f9);
        color: var(--ok, #1f5fa8);
    }

    .qrs-table td.qrs-verdict.qrs-none {
        color: var(--ink-3, #7f8a98);
        font-weight: 400;
    }

    /* Every NG cell — the station verdict and each failing measurement — is painted red.
       Two classes so the zebra and hover rules above cannot repaint it. */
    .qrs-table td.qrs-verdict.qrs-fail,
    .qrs-table td.qrs-value.qrs-fail {
        background: var(--crit, #c8342a);
        color: #fff;
        font-weight: 800;
    }

    .qrs-dash {
        color: var(--ink-3, #7f8a98);
        font-weight: 400;
    }

    .qrs-empty {
        display: flex;
        min-height: 7rem;
        padding: 1rem;
        align-items: center;
        justify-content: center;
        color: var(--ink-3, #7f8a98);
        font-size: 0.74rem;
    }

    .qrs-foot {
        display: flex;
        padding-top: 0.45rem;
        gap: 0.9rem;
        flex: 0 0 auto;
        flex-wrap: wrap;
        color: var(--ink-3, #7f8a98);
        font-size: 0.66rem;
        font-variant-numeric: tabular-nums;
    }

    @@keyframes qrs-spin {
        to { transform: rotate(360deg); }
    }

    @@media (max-width: 900px) {
        .qrs-page {
            height: auto;
            min-height: 32rem;
            overflow: visible;
        }

        .qrs-titlebar {
            align-items: stretch;
            flex-direction: column;
        }

        .qrs-connection {
            display: none;
        }
    }
</style>

@code {
    private static readonly int[] MaxRowChoices = [500, 2000, 5000, 10000, 20000];

    /// <summary>The offered caps with whatever is in force folded in, so a remembered value that
    /// is not one of the presets still shows as the selected option instead of blanking it.</summary>
    private IEnumerable<int> MaxRowOptions =>
        MaxRowChoices.Append(_maxRows).Where(value => value > 0).Distinct().OrderBy(value => value);

    /// <summary>
    /// How long typing has to settle before a date edit reloads. A native date input raises
    /// "change" for every complete date passed through on the way to the intended one — typing
    /// "26" for the day commits the 2nd first — so reloading on the first event would both
    /// query a date nobody asked for and re-render the input out from under the caret.
    /// </summary>
    private const int DateSettleMs = 900;

    private const string GaussStation = "GAUSS";

    /// <summary>Popup geometry for the GAUSS scatter; wide enough for the scatter and its box panel.</summary>
    private const string ScatterWindowFeatures = "width=1360,height=900,resizable=yes,scrollbars=yes";

    /// <summary>Popup geometry for a station's data browser; wide enough for BKTD's column set.</summary>
    private const string DetailWindowFeatures = "width=1500,height=920,resizable=yes,scrollbars=yes";

    private enum RowFilter { All, NgOnly, CompleteOnly }

    private QrSummaryResult? _result;
    private List<QrSummaryRow> _visibleRows = [];
    // Concrete List: Virtualize needs ICollection<T>.
    private List<SummaryLine> _lines = [];
    private readonly HashSet<string> _expandedProductIds = new(StringComparer.Ordinal);
    private CancellationTokenSource? _dateSettle;
    private DateOnly _from;
    private DateOnly _to;
    private int _maxRows = 2000;

    /// <summary>Model code currently filtered on; empty means every model.
    /// <see cref="QrModelCodeService.UnmappedCode"/> selects the QR the table does not name.</summary>
    private string _modelCode = string.Empty;

    /// <summary>What the model dropdown offers for the QR that were actually fetched.</summary>
    private IReadOnlyList<ModelOption> _modelOptions = [];

    /// <summary>Codes the settings table names, used to decide what falls into "Other".</summary>
    private readonly HashSet<string> _knownCodes = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>One entry of the model dropdown.</summary>
    private sealed record ModelOption(string Code, string Label);

    private RowFilter _filter = RowFilter.All;
    private string _error = string.Empty;
    private string _notice = string.Empty;
    private bool _busy;
    private bool _exporting;

    /// <summary>One rendered table row: a QR, or one of its earlier rounds when unfolded.</summary>
    private sealed record SummaryLine(QrSummaryRow Row, bool IsChild, bool Expanded);

    protected override async Task OnInitializedAsync()
    {
        // Opens on the cap last picked here or on the scatter, not on the built-in default.
        _maxRows = QrViewPreferenceService.Resolve(QrViewPrefs.MaxQr, _maxRows);
        if (QrSummary.IsConfigured)
            await LoadAsync();
    }

    private string ConnectionLabel
    {
        get
        {
            QrTestDataConnectionSnapshot snapshot = QrSummary.Snapshot;
            return $"{snapshot.Server},{snapshot.Port} / {snapshot.Database} / ALTD·BKTD·GSTD";
        }
    }

    private List<QrSummaryRow> VisibleRows => _visibleRows;

    private int CompleteCount => _result?.Rows.Count(r => r.IsCompleteSet) ?? 0;

    private int NgRowCount => _result?.Rows.Count(r => r.HasAnyFail) ?? 0;

    private IEnumerable<StationCard> StationCards
    {
        get
        {
            if (_result is null)
                yield break;

            yield return BuildCard("AIRLEAK", r => r.Airleak);
            yield return BuildCard("BAKO", r => r.Bako);
            yield return BuildCard("GAUSS", r => r.Gauss);
        }
    }

    private StationCard BuildCard(string station, Func<QrSummaryRow, QrSummaryCell?> pick)
    {
        long tested = 0;
        long ng = 0;
        foreach (QrSummaryRow row in _result!.Rows)
        {
            if (pick(row) is not QrSummaryCell cell)
                continue;

            tested++;
            if (cell.Verdict == QrVerdict.Fail)
                ng++;
        }
        return new StationCard(station, tested, ng);
    }

    private async Task ReloadAsync()
    {
        CancelDateSettle();
        await LoadAsync();
    }

    /// <summary>
    /// Opens the GAUSS dispersion scatter in its own window, carrying the window the grid is
    /// currently showing so the two always describe the same set of tests.
    /// </summary>
    private async Task OpenGaussScatterAsync()
    {
        string url = $"/qr/gauss-scatter?from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}&max={_maxRows}";
        try
        {
            bool opened = await JS.InvokeAsync<bool>("jinoQr.openWindow", url, ScatterWindowFeatures);
            if (!opened)
                _error = "The browser blocked the GAUSS scatter window. Allow pop-ups for this site and try again.";
        }
        catch (JSException ex)
        {
            _error = ex.Message;
        }
    }

    /// <summary>The data browser that holds a station's raw rows.</summary>
    private static string StationRoute(string station) => station switch
    {
        "AIRLEAK" => "/qr/airleak-data",
        "BAKO" => "/qr/bako-data",
        GaussStation => "/qr/gauss-data",
        _ => string.Empty,
    };

    private static string DetailTitle(QrSummaryRow row, QrSummaryCell cell) =>
        $"Open {cell.Station} data for {row.ProductId}"
        + (cell.TestTime is DateTimeOffset time ? $" · {time:yyyy-MM-dd}" : string.Empty);

    /// <summary>
    /// Opens the clicked station's own data browser on this QR: the station's test date is
    /// preselected and the QR is searched, highlighted and scrolled into view, so the summary
    /// cell and the raw record always describe the same test. One reused window per station.
    /// </summary>
    private async Task OpenStationDetailAsync(QrSummaryRow row, QrSummaryCell cell)
    {
        string route = StationRoute(cell.Station);
        if (route.Length == 0 || string.IsNullOrWhiteSpace(row.ProductId))
            return;

        string url = $"{route}?qr={Uri.EscapeDataString(row.ProductId)}";
        if (cell.TestTime is DateTimeOffset time)
            url += $"&date={time.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)}";
        url += ShellChrome.HiddenQuery;

        try
        {
            bool opened = await JS.InvokeAsync<bool>(
                "jinoQr.openWindow", url, DetailWindowFeatures, $"jino-qr-detail-{cell.Station}");
            if (!opened)
                _error = $"The browser blocked the {cell.Station} data window. Allow pop-ups for this site and try again.";
        }
        catch (JSException ex)
        {
            _error = ex.Message;
        }
    }

    private void OnFromChanged(ChangeEventArgs args)
    {
        if (TryParseDate(args.Value, out DateOnly value))
        {
            _from = value;
            QueueDateReload();
        }
    }

    private void OnToChanged(ChangeEventArgs args)
    {
        if (TryParseDate(args.Value, out DateOnly value))
        {
            _to = value;
            QueueDateReload();
        }
    }

    /// <summary>
    /// Reloads once the user stops editing the date. Nothing is re-rendered while the timer
    /// runs, so the input the user is typing into is never touched — see <see cref="DateSettleMs"/>.
    /// </summary>
    private void QueueDateReload()
    {
        CancelDateSettle();
        var settle = new CancellationTokenSource();
        _dateSettle = settle;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(DateSettleMs, settle.Token);
                await InvokeAsync(LoadAsync);
            }
            catch (OperationCanceledException)
            {
                // Superseded by a newer keystroke, or the page went away.
            }
        });
    }

    private void CancelDateSettle()
    {
        CancellationTokenSource? settle = _dateSettle;
        _dateSettle = null;
        if (settle is null)
            return;

        settle.Cancel();
        settle.Dispose();
    }

    public void Dispose() => CancelDateSettle();

    private async Task OnMaxRowsChanged(ChangeEventArgs args)
    {
        if (int.TryParse(Convert.ToString(args.Value, CultureInfo.InvariantCulture), out int value) && value > 0)
        {
            _maxRows = value;
            QrViewPrefs.SetMaxQr(value);
            await LoadAsync();
        }
    }

    /// <summary>Sets the window to the newest day with data, going back <paramref name="daysBack"/> days.</summary>
    private async Task ApplyQuickRangeAsync(int daysBack)
    {
        CancelDateSettle();
        DateOnly anchor = _result?.Bounds.MaxDate ?? DateOnly.FromDateTime(DateTime.Today);
        _to = anchor;
        _from = anchor.AddDays(-daysBack);
        await LoadAsync();
    }

    private void OnModelChanged(ChangeEventArgs args)
    {
        _modelCode = (Convert.ToString(args.Value, CultureInfo.InvariantCulture) ?? string.Empty).Trim();
        ApplyFilters();
    }

    /// <summary>
    /// Builds the model dropdown from the settings table, keeping only the models the fetched QR
    /// actually contain and counting each — a model on the list but not in the period would
    /// otherwise look like a filter that silently empties the table.
    /// </summary>
    private void BuildModelOptions()
    {
        _knownCodes.Clear();
        _modelOptions = [];
        if (_result is null)
            return;

        var names = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (QrModelCode entry in QrModelCodes.Codes)
        {
            _knownCodes.Add(entry.Code);
            names[entry.Code] = string.IsNullOrWhiteSpace(entry.Name) ? entry.Code : entry.Name;
        }

        var counts = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        int unmapped = 0;
        foreach (QrSummaryRow row in _result.Rows)
        {
            string code = QrModelCodeService.ExtractCode(row.ProductId);
            if (_knownCodes.Contains(code))
                counts[code] = counts.TryGetValue(code, out int seen) ? seen + 1 : 1;
            else
                unmapped++;
        }

        var options = new List<ModelOption>();
        foreach ((string code, string name) in names.OrderBy(entry => entry.Key, StringComparer.Ordinal))
        {
            if (counts.TryGetValue(code, out int count))
                options.Add(new ModelOption(code, $"{name} ({code}) · {count:N0} QR"));
        }

        if (unmapped > 0)
            options.Add(new ModelOption(QrModelCodeService.UnmappedCode, $"Other · {unmapped:N0} QR"));

        _modelOptions = options;

        // A model that is no longer on the list must not keep filtering invisibly.
        if (_modelCode.Length > 0 && !options.Any(option => string.Equals(option.Code, _modelCode, StringComparison.OrdinalIgnoreCase)))
            _modelCode = string.Empty;
    }

    private void SetFilter(RowFilter filter)
    {
        _filter = filter;
        ApplyFilters();
    }

    private async Task LoadAsync()
    {
        if (_busy)
            return;

        _busy = true;
        _error = string.Empty;
        StateHasChanged();

        try
        {
            QrSummaryResult result = await QrSummary.FetchAsync(new QrSummaryQuery
            {
                From = _from,
                To = _to,
                MaxRows = _maxRows,
            });
            _result = result;
            // The service resolves an empty range to the newest week; mirror what it chose.
            _from = result.From;
            _to = result.To;
            _maxRows = result.MaxRows;
            _expandedProductIds.Clear();
            BuildModelOptions();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private void ToggleGroup(string productId)
    {
        if (!_expandedProductIds.Add(productId))
            _expandedProductIds.Remove(productId);
        BuildLines();
    }

    private string GroupTitle(QrSummaryRow row, bool expanded) =>
        expanded
            ? $"Collapse the {row.Older.Count:N0} earlier test rounds of this QR"
            : $"{row.Older.Count:N0} earlier test rounds hidden — click to expand, newest first";

    private static string LineClass(SummaryLine line)
    {
        var classes = new List<string>(2);
        if (line.IsChild)
            classes.Add("qrs-row-child");
        if (line.Row.HasAnyFail)
            classes.Add("qrs-row-ng");
        return string.Join(' ', classes);
    }

    /// <summary>
    /// Flattens the filtered QR into one entry per rendered row. Expanded groups contribute
    /// their earlier rounds in place, newest first, which is the order the service returns.
    /// </summary>
    private void BuildLines()
    {
        var lines = new List<SummaryLine>(_visibleRows.Count);
        foreach (QrSummaryRow row in _visibleRows)
        {
            bool expanded = row.HasOlder && _expandedProductIds.Contains(row.ProductId);
            lines.Add(new SummaryLine(row, IsChild: false, Expanded: expanded));
            if (!expanded)
                continue;

            foreach (QrSummaryRow older in row.Older)
                lines.Add(new SummaryLine(older, IsChild: true, Expanded: false));
        }
        _lines = lines;
    }

    private void ApplyFilters()
    {
        if (_result is null)
        {
            _visibleRows = [];
            _lines = [];
            return;
        }

        IEnumerable<QrSummaryRow> rows = _result.Rows;

        if (_modelCode.Length > 0)
        {
            // "Other" is every QR the settings table does not name, including one too short to
            // carry a code at all — which is exactly what someone picking it is looking for.
            rows = string.Equals(_modelCode, QrModelCodeService.UnmappedCode, StringComparison.Ordinal)
                ? rows.Where(r => !_knownCodes.Contains(QrModelCodeService.ExtractCode(r.ProductId)))
                : rows.Where(r => string.Equals(
                    QrModelCodeService.ExtractCode(r.ProductId),
                    _modelCode,
                    StringComparison.OrdinalIgnoreCase));
        }

        rows = _filter switch
        {
            RowFilter.NgOnly => rows.Where(r => r.HasAnyFail),
            RowFilter.CompleteOnly => rows.Where(r => r.IsCompleteSet),
            _ => rows,
        };

        _visibleRows = rows.ToList();
        BuildLines();
    }

    /// <summary>
    /// Writes the workbook from its own unlimited read of the period, not from the grid: the grid
    /// stops at Max QR and at whatever the Model dropdown and the All / Has NG / All 3 stations chips
    /// are filtering to, and an export that inherited any of those would under-report the period.
    /// Earlier rounds go out whether or not their group is unfolded on screen.
    /// </summary>
    private async Task ExportExcelAsync()
    {
        if (_exporting || VisibleRows.Count == 0)
            return;

        _exporting = true;
        _error = string.Empty;
        _notice = string.Empty;
        StateHasChanged();

        try
        {
            QrSummaryResult full = await QrSummary.FetchAsync(new QrSummaryQuery
            {
                From = _from,
                To = _to,
                AllRows = true,
            });

            byte[] bytes = QrSummaryExcelExporter.Build(full.Rows);
            string fileName = $"QR_SUMMARY_{_from:yyyyMMdd}-{_to:yyyyMMdd}_{DateTime.Now:HHmmss}.xlsx";
            await BrowserDownload.DownloadBytesAsync(JS, fileName, bytes, QrSummaryExcelExporter.ContentType);

            if (full.Rows.Count >= QrSummaryService.ExportMaxRows)
            {
                _notice = $"The export stops at {QrSummaryService.ExportMaxRows:N0} QR, which this period reached. "
                        + "Narrow the date range to get the whole period in one file.";
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _exporting = false;
            StateHasChanged();
        }
    }

    private static bool TryParseDate(object? value, out DateOnly parsed) =>
        DateOnly.TryParse(
            Convert.ToString(value, CultureInfo.InvariantCulture),
            CultureInfo.InvariantCulture,
            DateTimeStyles.None,
            out parsed);

    private static string ItemText(QrSummaryCell? cell, int index)
    {
        string value = cell?.ItemAt(index)?.Value ?? string.Empty;
        return string.IsNullOrWhiteSpace(value) ? "-" : value;
    }

    /// <summary>Paints an individual measurement red when that item's own result is NG.</summary>
    private static string ItemClass(QrSummaryCell? cell, int index) =>
        cell?.ItemAt(index)?.Verdict == QrVerdict.Fail ? "qrs-fail" : string.Empty;

    private static string VerdictTitle(QrSummaryCell? cell) =>
        cell is null ? "No test record" : $"TestResult = {cell.Result}";

    private static string FormatTime(DateTimeOffset? value) =>
        value is DateTimeOffset time
            ? time.ToString("MM-dd HH:mm:ss", CultureInfo.InvariantCulture)
            : "-";

    private static string FormatPpm(double? value) =>
        value is double ppm
            ? $"{ppm.ToString("N0", CultureInfo.CurrentCulture)} ppm"
            : "-";

    private static string VerdictClass(QrSummaryCell? cell) => cell?.Verdict switch
    {
        QrVerdict.Pass => "qrs-pass",
        QrVerdict.Fail => "qrs-fail",
        QrVerdict.Unknown => string.Empty,
        _ => "qrs-none",
    };

    /// <summary>GSTD stores 1/0, ALTD stores OK/AL — normalise so one column reads consistently.</summary>
    private static string VerdictLabel(QrSummaryCell? cell) => cell?.Verdict switch
    {
        QrVerdict.Pass => "OK",
        QrVerdict.Fail => "NG",
        QrVerdict.Unknown => string.IsNullOrWhiteSpace(cell?.Result) ? "?" : cell!.Result,
        _ => "-",
    };

    private sealed record StationCard(string Station, long Tested, long Ng)
    {
        public double? NgRatePpm => Tested <= 0 ? null : Ng / (double)Tested * 1_000_000d;
    }
}
