@page "/bmes/material-cost"
@rendermode InteractiveServer
@using System.Globalization
@using JinoSupporter.Web.Services
@inject BmesFcostActualService FCostActual
@inject BmesBomCacheService BomCache
@inject AppPathsService AppPaths
@inject AppActivityLogger Activity

<PageTitle>Material Cost</PageTitle>

<div class="d-flex align-items-center gap-2 mb-3">
    <span class="fw-semibold" style="font-size:18px;">₫</span>
    <h5 class="mb-0 fw-semibold">Material Cost</h5>
    <span class="badge bg-secondary-subtle text-secondary-emphasis">조회 전용</span>
</div>

<div class="matcost-toolbar mb-3">
    <input class="form-control form-control-sm matcost-search"
           placeholder="모델명(BOM 전개) 또는 자재코드/자재명"
           @bind="_search"
           @bind:event="oninput"
           @onkeydown="OnSearchKeyDown" />
    <input type="date" class="form-control form-control-sm matcost-date" @bind="_referenceDate" title="이 날짜에 유효한 단가를 조회합니다" />
    <select class="form-select form-select-sm matcost-rows" @bind="_maxRows">
        <option value="100">100건</option>
        <option value="300">300건</option>
        <option value="1000">1000건</option>
    </select>
    <div class="input-group input-group-sm matcost-base">
        <span class="input-group-text" title="BOM 소요량이 몇 개 기준으로 등록되어 있는지. 이 값으로 나눠 1개 기준으로 환산합니다">BOM 기준수량</span>
        <input type="number" min="1" step="1" class="form-control" @bind="_bomBaseQty" />
    </div>
    <button class="btn btn-primary btn-sm" @onclick="SearchAsync" disabled="@_isBusy">조회</button>
    <button class="btn btn-outline-primary btn-sm" @onclick="SearchForceAsync" disabled="@_isBusy" title="BOM 캐시를 무시하고 서버에서 다시 전개합니다">BOM 새로고침</button>
</div>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger py-2 small mb-3">@_errorMessage</div>
}

@if (_isBusy)
{
    <div class="alert alert-info py-2 small mb-3 d-flex align-items-center gap-2">
        <span class="spinner-border spinner-border-sm" role="status"></span>
        <span>@_statusMessage</span>
    </div>
}
else if (_rows.Count > 0)
{
    <div class="alert alert-light border py-2 small mb-3">
        단가는 <strong>구매 정보레코드(INFR)</strong>를 먼저 쓰고, 없으면 <strong>입고 실적(STBI)</strong>의 금액÷수량을 씁니다.
        VND 환산은 <strong>TCURR</strong>(KURST=BWCU) 월초 환율 기준입니다.
        @if (_isBomMode)
        {
            <span>
                · <strong>BOM Qty</strong> 는 BOM 에 등록된 원값이고, <strong>Qty/1EA</strong> 와 <strong>Cost/1EA</strong> 는
                기준수량 @_bomBaseQty.ToString("N0", CultureInfo.InvariantCulture) 로 나눈 제품 1개 기준 값입니다.
                기준수량은 BOM 헤더에서 읽어오지 않고 위 입력값을 씁니다.
                <strong>하위 BOM</strong> 배지가 붙은 반제품은 아래에 자기 구성 자재가 이어서 나옵니다.
                같은 자재가 상위·하위 양쪽에 잡히므로 전체를 그냥 더하면 이중 계산됩니다.
            </span>
        }
    </div>
}

<section class="matcost-section">
    <div class="matcost-section-title">
        <h6>@(_isBomMode ? $"{_bomModelName} BOM 자재 단가" : "자재 단가")</h6>
        <span>@_rows.Count.ToString("N0", CultureInfo.InvariantCulture)</span>
        @if (_isBomMode)
        {
            <span class="badge bg-primary-subtle text-primary-emphasis">BOM 전개</span>
            <span class="text-muted small">@_bomSource</span>
        }
        @if (_searchedAt is not null)
        {
            <small class="text-muted ms-auto">@_searchedAt.Value.ToString("yyyy-MM-dd HH:mm:ss")</small>
        }
    </div>
    <div class="matcost-table-scroll">
        <table class="matcost-table">
            <thead>
                <tr>
                    @if (_isBomMode)
                    {
                        <th class="text-center" style="min-width:44px;">Lv</th>
                    }
                    <th style="min-width:150px;">Material Code</th>
                    <th style="min-width:280px;">Material Name</th>
                    @if (_isBomMode)
                    {
                        <th style="min-width:150px;">Parent</th>
                    }
                    @if (_isBomMode)
                    {
                        <th class="text-end" style="min-width:100px;">BOM Qty</th>
                        <th style="min-width:60px;">Qty Unit</th>
                        <th class="text-end matcost-per-ea" style="min-width:110px;">Qty / 1EA</th>
                    }
                    <th class="text-end" style="min-width:120px;">Unit Price</th>
                    <th style="min-width:70px;">Currency</th>
                    <th style="min-width:70px;">Price Unit</th>
                    <th class="text-end" style="min-width:130px;">Unit Price (VND)</th>
                    @if (_isBomMode)
                    {
                        <th class="text-end matcost-per-ea" style="min-width:130px;">Cost / 1EA (VND)</th>
                    }
                    <th style="min-width:80px;">Source</th>
                </tr>
            </thead>
            <tbody>
                @if (_rows.Count == 0)
                {
                    <tr>
                        <td colspan="@(_isBomMode ? 13 : 7)" class="text-center text-muted py-4 small">
                            @(_searchedAt is null ? "모델명이나 자재코드를 입력하고 조회하세요." : "조회 결과가 없습니다.")
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var row in _rows)
                    {
                        <tr>
                            @if (_isBomMode)
                            {
                                <td class="text-center text-muted">@(row.BomLevel > 0 ? row.BomLevel.ToString(CultureInfo.InvariantCulture) : "-")</td>
                            }
                            <td class="font-monospace">@row.MaterialCode</td>
                            <td style="@(_isBomMode && row.BomLevel > 1 ? $"padding-left:{10 + (row.BomLevel - 1) * 16}px;" : null)">
                                @if (_isBomMode && row.BomLevel > 1)
                                {
                                    <span class="text-muted">└ </span>
                                }
                                @row.MaterialName
                                @if (_isBomMode && row.HasChildren)
                                {
                                    <span class="badge bg-info-subtle text-info-emphasis ms-1" title="이 자재는 자기 하위 BOM 을 갖는 반제품입니다">하위 BOM</span>
                                }
                            </td>
                            @if (_isBomMode)
                            {
                                <td class="font-monospace text-muted">@row.ParentMaterialCode</td>
                                <td class="text-end">@FormatQty(row.BomUsageQty)</td>
                                <td class="text-muted">@row.BomUsageUnit</td>
                                <td class="text-end matcost-per-ea">@FormatPerUnit(PerUnitQty(row))</td>
                            }
                            <td class="text-end">@FormatUnitPrice(row.UnitPrice)</td>
                            <td>@row.PriceCurrency</td>
                            <td>@row.PriceUnit</td>
                            <td class="text-end">@FormatVnd(row.UnitPriceVnd)</td>
                            @if (_isBomMode)
                            {
                                <td class="text-end fw-semibold matcost-per-ea">@FormatVnd(PerUnitCost(row))</td>
                            }
                            <td>
                                @if (string.IsNullOrWhiteSpace(row.PriceSource))
                                {
                                    <span class="text-muted" title="이 기준일에 INFR/STBI 어디에도 단가가 없습니다">-</span>
                                }
                                else
                                {
                                    <span class="badge @(row.PriceSource == "INFR" ? "bg-primary-subtle text-primary-emphasis" : "bg-warning-subtle text-warning-emphasis")">@row.PriceSource</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>

<style>
    .matcost-toolbar { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .matcost-search { max-width: 340px; }
    .matcost-date { max-width: 170px; }
    .matcost-rows { max-width: 110px; }
    .matcost-base { max-width: 230px; }

    .matcost-table th.matcost-per-ea, .matcost-table td.matcost-per-ea { background: #f3f8ff; }

    .matcost-section { border: 1px solid var(--line-2, #c6ccd5); border-radius: 8px; background: var(--panel, #fff); overflow: hidden; }
    .matcost-section-title { display: flex; align-items: center; gap: 8px; padding: 8px 12px; border-bottom: 1px solid var(--line-2, #c6ccd5); background: #f6f8fb; }
    .matcost-section-title h6 { margin: 0; font-size: 13px; font-weight: 700; }
    .matcost-section-title > span:first-of-type { display: inline-grid; min-width: 24px; height: 20px; place-items: center; padding: 0 6px; border-radius: 999px; background: #e5eaf1; color: #475467; font-size: 11px; font-weight: 700; }

    .matcost-table-scroll { max-height: min(70vh, 900px); overflow: auto; }
    .matcost-table { width: 100%; border-collapse: collapse; font-size: 12px; }
    .matcost-table thead th { position: sticky; top: 0; z-index: 1; padding: 7px 10px; border-bottom: 1px solid var(--line-2, #c6ccd5); background: #eef1f6; font-size: 11px; font-weight: 700; white-space: nowrap; }
    .matcost-table tbody td { padding: 6px 10px; border-bottom: 1px solid #eef1f5; }
    .matcost-table tbody tr:hover { background: #f7faff; }
</style>

@code {
    private const string BomPlant = "3200";
    private const int BomMaxDepth = 6;
    private const int BomMaxRows = 2000;

    private string _search = string.Empty;
    private DateTime _referenceDate = DateTime.Today;
    private int _maxRows = 300;

    /// <summary>BOM 소요량이 몇 개 기준으로 등록되어 있는지. BOM 헤더에서 읽지 않고 사용자가 지정한다.</summary>
    private decimal _bomBaseQty = 1000m;
    private bool _isBusy;
    private string _errorMessage = string.Empty;
    private string _statusMessage = string.Empty;
    private DateTime? _searchedAt;
    private bool _isBomMode;
    private string _bomModelName = string.Empty;
    private string _bomSource = string.Empty;
    private List<MaterialCostViewRow> _rows = [];

    private async Task OnSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await SearchAsync();
    }

    private Task SearchAsync() => RunSearchAsync(force: false);

    private Task SearchForceAsync() => RunSearchAsync(force: true);

    private async Task RunSearchAsync(bool force)
    {
        if (_isBusy) return;

        string query = _search.Trim();
        // 검색어 없이 조회하면 MATE 전체를 훑게 되어 운영 DB 에 부담이 크다.
        if (query.Length < 2)
        {
            _errorMessage = "모델명이나 자재코드를 2자 이상 입력하세요.";
            _rows = [];
            _searchedAt = null;
            return;
        }

        _isBusy = true;
        _errorMessage = string.Empty;
        _statusMessage = "BOM 을 전개하는 중입니다...";
        StateHasChanged();

        try
        {
            var connection = BuildNetworkDbConnection();

            // 1) 먼저 모델로 보고 BOM 전개를 시도한다.
            var bomRows = await TryLoadBomRowsAsync(query, force, connection);
            if (bomRows.Rows.Count > 0)
            {
                _statusMessage = $"BOM 자재 {bomRows.Rows.Count:N0}건의 단가를 조회하는 중입니다...";
                StateHasChanged();

                // 반제품(C-S 등)은 자기 하위 BOM 을 그대로 갖고 있다.
                // 코드로 접으면 그 계층이 사라지므로 트리 그대로 두고, 단가만 코드 단위로 조회한다.
                var distinctCodes = bomRows.Rows
                    .Select(r => r.MaterialCode.Trim())
                    .Where(code => code.Length > 0)
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .ToList();

                var prices = await FCostActual.FetchMaterialCostsAsync(new BmesMaterialCostQuery
                {
                    Connection = connection,
                    MaterialCodes = distinctCodes,
                    ReferenceDate = _referenceDate,
                    MaxRows = Math.Max(distinctCodes.Count, _maxRows),
                });
                var priceByCode = prices.ToDictionary(p => p.MaterialCode.Trim(), StringComparer.OrdinalIgnoreCase);

                _rows = bomRows.Rows
                    .OrderBy(r => r.BomPath, StringComparer.OrdinalIgnoreCase)
                    .ThenBy(r => r.MaterialCode, StringComparer.OrdinalIgnoreCase)
                    .Select(r =>
                    {
                        priceByCode.TryGetValue(r.MaterialCode.Trim(), out var price);
                        return new MaterialCostViewRow
                        {
                            BomLevel = r.BomLevel,
                            MaterialCode = r.MaterialCode.Trim(),
                            MaterialName = string.IsNullOrWhiteSpace(price?.MaterialName) ? r.MaterialName.Trim() : price.MaterialName,
                            ParentMaterialCode = r.ParentMaterialCode.Trim(),
                            HasChildren = r.HasChildren,
                            BomUsageQty = r.UsageQty,
                            BomUsageUnit = r.UsageUnit,
                            UnitPrice = price?.UnitPrice,
                            PriceCurrency = price?.PriceCurrency ?? string.Empty,
                            PriceUnit = price?.PriceUnit ?? string.Empty,
                            PriceSource = price?.PriceSource ?? string.Empty,
                            UnitPriceVnd = price?.UnitPriceVnd,
                        };
                    })
                    .ToList();

                _isBomMode = true;
                _bomModelName = query;
                _bomSource = bomRows.Source == "cache" ? "BOM 캐시" : "서버 조회";
                _searchedAt = DateTime.Now;
                return;
            }

            // 2) BOM 이 없으면 자재코드/자재명 검색으로 되돌아간다.
            _statusMessage = "자재 단가를 조회하는 중입니다...";
            StateHasChanged();

            var found = await FCostActual.FetchMaterialCostsAsync(new BmesMaterialCostQuery
            {
                Connection = connection,
                Search = query,
                ReferenceDate = _referenceDate,
                MaxRows = _maxRows,
            });

            _rows = found
                .Select(p => new MaterialCostViewRow
                {
                    MaterialCode = p.MaterialCode,
                    MaterialName = p.MaterialName,
                    UnitPrice = p.UnitPrice,
                    PriceCurrency = p.PriceCurrency,
                    PriceUnit = p.PriceUnit,
                    PriceSource = p.PriceSource,
                    UnitPriceVnd = p.UnitPriceVnd,
                })
                .ToList();
            _isBomMode = false;
            _bomModelName = string.Empty;
            _bomSource = string.Empty;
            _searchedAt = DateTime.Now;
        }
        catch (Exception ex)
        {
            _rows = [];
            _errorMessage = ex.Message;
            Activity.Log("Material Cost", "Lookup failed: " + ex.Message);
        }
        finally
        {
            _isBusy = false;
            _statusMessage = string.Empty;
        }
    }

    private async Task<(List<BmesBomMaterialCandidate> Rows, string Source)> TryLoadBomRowsAsync(
        string model,
        bool force,
        BmesFcostDbConnection connection)
    {
        var cacheQuery = new BmesBomCacheQuery(model, BomPlant, DateTime.Today, BomMaxDepth, BomMaxRows);
        if (!force)
        {
            BmesBomCacheEntry? cached = BomCache.TryLoad(cacheQuery);
            if (cached is not null)
                return (cached.Rows, "cache");
        }

        if (string.IsNullOrWhiteSpace(connection.Server) || string.IsNullOrWhiteSpace(connection.UserId))
            return ([], string.Empty);

        var rows = await FCostActual.FetchBomTreeAsync(new BmesBomMaterialQuery
        {
            Connection = connection,
            ModelName = model,
            Plant = BomPlant,
            MaxRows = BomMaxRows,
            MaxDepth = BomMaxDepth,
            WorkDate = DateTime.Today,
        });

        if (rows.Count > 0)
            BomCache.Save(cacheQuery, rows);

        return (rows, "server");
    }

    private BmesFcostDbConnection BuildNetworkDbConnection()
    {
        var c = AppPaths.Current;
        return new BmesFcostDbConnection
        {
            Server = c.AdminDbQueryServer,
            Port = c.AdminDbQueryPort > 0 ? c.AdminDbQueryPort : 1430,
            Database = string.IsNullOrWhiteSpace(c.AdminDbQueryDatabase) ||
                       string.Equals(c.AdminDbQueryDatabase, "master", StringComparison.OrdinalIgnoreCase)
                ? "BMES_LIV"
                : c.AdminDbQueryDatabase,
            UserId = c.AdminDbQueryUserId,
            Password = c.AdminDbQueryPassword,
            TimeoutSeconds = Math.Clamp(Math.Max(c.AdminDbQueryTimeoutSeconds, 120), 1, 600),
            Encrypt = c.AdminDbQueryEncrypt,
            TrustServerCertificate = c.AdminDbQueryTrustServerCertificate,
        };
    }

    private decimal? PerUnitQty(MaterialCostViewRow row)
        => row.BomUsageQty is > 0 && _bomBaseQty > 0 ? row.BomUsageQty.Value / _bomBaseQty : null;

    private decimal? PerUnitCost(MaterialCostViewRow row)
    {
        decimal? qty = PerUnitQty(row);
        return qty is > 0 && row.UnitPriceVnd is > 0 ? qty.Value * row.UnitPriceVnd.Value : null;
    }

    // 1개 기준 소요량은 0.001 처럼 아주 작아질 수 있어 유효숫자를 넉넉히 남긴다.
    private static string FormatPerUnit(decimal? value)
    {
        if (value is null || value.Value == 0) return "-";
        decimal abs = Math.Abs(value.Value);
        return value.Value.ToString(abs >= 1m ? "N2" : "0.########", CultureInfo.InvariantCulture);
    }

    // 단가는 USD 처럼 소수가 의미를 갖는 통화가 있어 유효숫자를 남긴다.
    private static string FormatUnitPrice(decimal? value)
    {
        if (value is null || value.Value == 0) return "-";
        decimal abs = Math.Abs(value.Value);
        string format = abs >= 1000m ? "N0" : abs >= 1m ? "N2" : "0.######";
        return value.Value.ToString(format, CultureInfo.InvariantCulture);
    }

    // VND 는 소수 단위를 쓰지 않으므로 정수로 반올림한다.
    private static string FormatVnd(decimal? value)
        => value is null || value.Value == 0
            ? "-"
            : Math.Round(value.Value, MidpointRounding.AwayFromZero).ToString("N0", CultureInfo.InvariantCulture);

    private static string FormatQty(decimal? value)
    {
        if (value is null || value.Value == 0) return "-";
        decimal abs = Math.Abs(value.Value);
        return value.Value.ToString(abs >= 1m ? "N0" : "0.######", CultureInfo.InvariantCulture);
    }

    private sealed class MaterialCostViewRow
    {
        public int BomLevel { get; init; }
        public string MaterialCode { get; init; } = string.Empty;
        public string MaterialName { get; init; } = string.Empty;
        public string ParentMaterialCode { get; init; } = string.Empty;

        /// <summary>이 자재가 다시 자기 하위 BOM 을 갖는 반제품인지.</summary>
        public bool HasChildren { get; init; }

        public decimal? BomUsageQty { get; init; }
        public string BomUsageUnit { get; init; } = string.Empty;
        public decimal? UnitPrice { get; init; }
        public string PriceCurrency { get; init; } = string.Empty;
        public string PriceUnit { get; init; } = string.Empty;
        public string PriceSource { get; init; } = string.Empty;
        public decimal? UnitPriceVnd { get; init; }
    }
}
