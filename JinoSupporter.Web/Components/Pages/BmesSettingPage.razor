    private async Task FetchAllMaterialsAsync()
    {
        if (_fetchBusy) return;
        _fetchBusy = true;
        _fetchLog  = string.Empty;
        StateHasChanged();

        var progress = new Progress<string>(msg =>
        {
            _fetchLog += (_fetchLog.Length > 0 ? "\n" : "") + msg;
            InvokeAsync(StateHasChanged);
        });

        try
        {
            int saved = await BmesMaterials.FetchAllAsync(progress);
            if (saved > 0)
            {
                _latest        = Repo.GetLatestBmesMaterial();
                _materialCount = Repo.GetBmesMaterialCount();
                SetStatus($"Saved {saved} material(s). Total in DB: {_materialCount}", false);
            }
            else
            {
                SetStatus("Fetch failed — see log below.", true);
            }
        }
        catch (Exception ex)
        {
            SetStatus($"Unexpected error: {ex.Message}", true);
            _fetchLog += "\n" + ex;
        }
        finally
        {
            _fetchBusy = false;
            StateHasChanged();
        }
    }

    private void SaveCredentials()
    {
        NgRateSettings.ApplySnapshot(_snap);
        SetStatus("Credentials saved.", false);
