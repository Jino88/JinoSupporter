@page "/bmes/setting"
@page "/setting"
@rendermode InteractiveServer
@using JinoSupporter.Web.Services
@using Microsoft.AspNetCore.Components.Web
@inject AppPathsService         AppPaths
@inject NgRateSettingsService    NgRateSettings
@inject BmesMaterialService      BmesMaterials
@inject BmesRoutingScrapeService BmesRoutingScrape
@inject BmesSettingsSyncService  BmesSettingsSync
@inject WebRepository            Repo
@inject AiProviderSettingsService AiProviders
@inject QrBakoDataService        QrBakoData

<PageTitle>Setting</PageTitle>

<div class="d-flex align-items-center gap-2 mb-3">
    <span style="font-size:20px;">⚙️</span>
    <h5 class="mb-0 fw-semibold">Setting</h5>
</div>

@if (!string.IsNullOrEmpty(_statusMsg))
{
    <div class="alert @(_statusError ? "alert-danger" : "alert-success") py-2 small mb-3 d-flex align-items-center">
        <span class="flex-fill">@_statusMsg</span>
        <button class="btn-close btn-sm" @onclick="() => _statusMsg = string.Empty"></button>
    </div>
}

<AuthorizeView Roles="Admin">
    <Authorized>
        <div class="row g-3 mb-3">
            <div class="col-lg-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header fw-semibold small">Claude API</div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label small fw-semibold mb-1">API Key</label>
                            <div class="input-group input-group-sm">
                                <input type="@(_showKey ? "text" : "password")"
                                       class="form-control form-control-sm font-monospace"
                                       placeholder="sk-ant-api03-..."
                                       @bind="_apiKey" />
                                <button class="btn btn-outline-secondary btn-sm" type="button"
                                        @onclick="() => _showKey = !_showKey">
                                    @(_showKey ? "Hide" : "Show")
                                </button>
                            </div>
                        </div>
                        <button class="btn btn-primary btn-sm" @onclick="SaveClaudeAsync" disabled="@_claudeSaving">
                            @(_claudeSaving ? "Saving..." : "Save")
                        </button>
                        @if (_claudeSaved) { <span class="ms-2 text-success fw-semibold small">Saved.</span> }
                        @if (!string.IsNullOrEmpty(_claudeError)) { <div class="small text-danger mt-2">@_claudeError</div> }
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header fw-semibold small">Codex API (OpenAI)</div>
                    <div class="card-body">
                        <div class="mb-2">
                            <label class="form-label small fw-semibold mb-1">API Key</label>
                            <div class="input-group input-group-sm">
                                <input type="@(_showCodexKey ? "text" : "password")"
                                       class="form-control form-control-sm font-monospace"
                                       placeholder="sk-..."
                                       @bind="_codexApiKey" />
                                <button class="btn btn-outline-secondary btn-sm" type="button"
                                        @onclick="() => _showCodexKey = !_showCodexKey">
                                    @(_showCodexKey ? "Hide" : "Show")
                                </button>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold mb-1">Translate Model</label>
                            <input class="form-control form-control-sm font-monospace"
                                   placeholder="@CodexApiService.DefaultTranslateModel"
                                   @bind="_codexTranslateModel" />
                        </div>
                        <button class="btn btn-primary btn-sm" @onclick="SaveCodexAsync" disabled="@_codexSaving">
                            @(_codexSaving ? "Saving..." : "Save")
                        </button>
                        @if (_codexSaved) { <span class="ms-2 text-success fw-semibold small">Saved.</span> }
                        @if (!string.IsNullOrEmpty(_codexError)) { <div class="small text-danger mt-2">@_codexError</div> }
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header fw-semibold small">AI Provider Switches</div>
                    <div class="card-body">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="aiClaudeApi"
                                   @bind="_aiProviders.ClaudeApiEnabled" />
                            <label class="form-check-label small" for="aiClaudeApi">Claude API</label>
                        </div>
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="aiClaudeCli"
                                   @bind="_aiProviders.ClaudeCliEnabled" />
                            <label class="form-check-label small" for="aiClaudeCli">Claude CLI</label>
                        </div>
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="aiCodexCli"
                                   @bind="_aiProviders.CodexCliEnabled" />
                            <label class="form-check-label small" for="aiCodexCli">Codex CLI</label>
                        </div>
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" id="aiCodexApi"
                                   @bind="_aiProviders.CodexApiEnabled" />
                            <label class="form-check-label small" for="aiCodexApi">Codex API</label>
                        </div>
                        <button class="btn btn-primary btn-sm" @onclick="SaveAiProvidersAsync" disabled="@_aiProviderSaving">
                            @(_aiProviderSaving ? "Saving..." : "Save")
                        </button>
                        @if (_aiProviderSaved) { <span class="ms-2 text-success fw-semibold small">Saved.</span> }
                        @if (!string.IsNullOrEmpty(_aiProviderError)) { <div class="small text-danger mt-2">@_aiProviderError</div> }
                    </div>
                </div>
            </div>
        </div>
        <div class="row g-3 mb-3">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header fw-semibold small">QR BAKO DATA DB</div>
                    <div class="card-body">
                        <div class="row g-2 align-items-end">
                            <div class="col-lg-3 col-md-6">
                                <label class="form-label small fw-semibold mb-1">Server</label>
                                <input class="form-control form-control-sm" @bind="_pathsForm.QrBakoDataServer" />
                            </div>
                            <div class="col-lg-1 col-md-3">
                                <label class="form-label small fw-semibold mb-1">Port</label>
                                <input class="form-control form-control-sm" type="number" min="1" max="65535" @bind="_pathsForm.QrBakoDataPort" />
                            </div>
                            <div class="col-lg-2 col-md-4">
                                <label class="form-label small fw-semibold mb-1">Database</label>
                                <input class="form-control form-control-sm" @bind="_pathsForm.QrBakoDataDatabase" />
                            </div>
                            <div class="col-lg-2 col-md-4">
                                <label class="form-label small fw-semibold mb-1">User ID</label>
                                <input class="form-control form-control-sm" @bind="_pathsForm.QrBakoDataUserId" autocomplete="off" />
                            </div>
                            <div class="col-lg-3 col-md-6">
                                <label class="form-label small fw-semibold mb-1">Password</label>
                                <div class="input-group input-group-sm">
                                    <input class="form-control form-control-sm"
                                           type="@(_showQrBakoPassword ? "text" : "password")"
                                           @bind="_pathsForm.QrBakoDataPassword"
                                           autocomplete="off" />
                                    <button class="btn btn-outline-secondary btn-sm"
                                            type="button"
                                            @onclick="() => _showQrBakoPassword = !_showQrBakoPassword">
                                        @(_showQrBakoPassword ? "Hide" : "Show")
                                    </button>
                                </div>
                            </div>
                            <div class="col-lg-1 col-md-3">
                                <label class="form-label small fw-semibold mb-1">Rows</label>
                                <input class="form-control form-control-sm" type="number" min="1" max="20000" @bind="_pathsForm.QrBakoDataDefaultMaxRows" />
                            </div>
                            <div class="col-lg-2 col-md-3">
                                <label class="form-label small fw-semibold mb-1">Timeout</label>
                                <input class="form-control form-control-sm" type="number" min="1" max="300" @bind="_pathsForm.QrBakoDataTimeoutSeconds" />
                            </div>
                            <div class="col-lg-4 col-md-6 d-flex align-items-end gap-3">
                                <div class="form-check mb-1">
                                    <input class="form-check-input" id="qrBakoEncrypt" type="checkbox" @bind="_pathsForm.QrBakoDataEncrypt" />
                                    <label class="form-check-label small" for="qrBakoEncrypt">Encrypt</label>
                                </div>
                                <div class="form-check mb-1">
                                    <input class="form-check-input" id="qrBakoTrust" type="checkbox" @bind="_pathsForm.QrBakoDataTrustServerCertificate" />
                                    <label class="form-check-label small" for="qrBakoTrust">Trust server certificate</label>
                                </div>
                            </div>
                            <div class="col-lg-6 col-md-12 d-flex align-items-end gap-2">
                                <button class="btn btn-primary btn-sm" @onclick="SaveQrBakoDbAsync" disabled="@_qrBakoSaving">
                                    @if (_qrBakoSaving)
                                    { <span class="spinner-border spinner-border-sm me-1"></span> }
                                    Save
                                </button>
                                <button class="btn btn-outline-primary btn-sm" @onclick="TestQrBakoDbAsync" disabled="@(_qrBakoSaving || _qrBakoTesting)">
                                    @if (_qrBakoTesting)
                                    { <span class="spinner-border spinner-border-sm me-1"></span> }
                                    Test Connection
                                </button>
                                @if (!string.IsNullOrWhiteSpace(_qrBakoMsg))
                                {
                                    <span class="small fw-semibold @(_qrBakoError ? "text-danger" : "text-success")">@_qrBakoMsg</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </Authorized>
</AuthorizeView>

@{
    var rFiltered  = GetFilteredRouting();
    var rsFiltered = GetFilteredReason();
}

<div class="row g-3 mb-3">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header fw-semibold small">App Path</div>
            <div class="card-body">
                <label class="form-label small fw-semibold mb-1">
                    Working Folder
                    <span class="badge bg-warning text-dark ms-1">restart</span>
                </label>
                <div class="input-group input-group-sm">
                    <input class="form-control form-control-sm font-monospace"
                           @bind="_pathsForm.DbRootDirectory"
                           placeholder="@AppPathsService.DefaultDbRootDirectory" />
                    <button class="btn btn-outline-secondary btn-sm"
                            type="button"
                            @onclick="UseDefaultAppPath">
                        Default
                    </button>
                    <button class="btn btn-primary btn-sm"
                            type="button"
                            @onclick="SaveAppPathAsync"
                            disabled="@_pathSaving">
                        @if (_pathSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Save
                    </button>
                </div>
                <div class="small text-muted mt-2">
                    NG RATE: <code>@NgRateWorkDirectory</code><br />
                    FCOST: <code>@FCostWorkDirectory</code><br />
                    WK STATUS: <code>@WorkerStatusWorkDirectory</code>
                </div>
                @if (!string.IsNullOrWhiteSpace(_pathStatus))
                {
                    <div class="small mt-2 @(_pathStatusError ? "text-danger" : "text-success") fw-semibold">
                        @_pathStatus
                    </div>
                }
                @if (_pathSavedRequiresRestart)
                {
                    <div class="small text-warning fw-semibold mt-2">
                        Restart the app for main DB path changes to fully take effect.
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ══ BMES Credentials ═══════════════════════════════════════════════════ -->
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold small">🔑 BMES Credentials <span class="text-muted fw-normal">(NG Rate / Worker Status)</span></div>
            <div class="card-body">
                <div class="mb-2">
                    <label class="form-label small fw-semibold mb-1">Login ID</label>
                    <input class="form-control form-control-sm" @bind="_snap.LoginId" placeholder="BMES ID" />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold mb-1">Password</label>
                    <input class="form-control form-control-sm" type="password" @bind="_snap.Password" placeholder="BMES Password" />
                </div>
                <button class="btn btn-primary btn-sm" @onclick="SaveCredentials">Save</button>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold small">Server Tables</div>
            <div class="card-body">
                <div class="small text-muted mb-2">
                    Save target: <code>@ServerTableTargetPreview</code>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button class="btn btn-outline-primary btn-sm"
                            @onclick="PullRoutingFromServerAsync"
                            disabled="@(_serverTableBusy || _pathSaving)">
                        @if (_serverTableBusy && _serverTableAction == "routing")
                        { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Load Routing
                    </button>
                    <button class="btn btn-outline-primary btn-sm"
                            @onclick="PullReasonFromServerAsync"
                            disabled="@(_serverTableBusy || _pathSaving)">
                        @if (_serverTableBusy && _serverTableAction == "reason")
                        { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Load Reason
                    </button>
                    <button class="btn btn-primary btn-sm"
                            @onclick="PullRoutingReasonFromServerAsync"
                            disabled="@(_serverTableBusy || _pathSaving)">
                        @if (_serverTableBusy && _serverTableAction == "all")
                        { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Load Both
                    </button>
                </div>
                @if (!string.IsNullOrWhiteSpace(_serverTableMsg))
                {
                    <div class="small mt-2 @(_serverTableError ? "text-danger" : "text-success") fw-semibold">
                        @_serverTableMsg
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ══ BMES Material Fetch (test) ═════════════════════════════════════════ -->
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header d-flex align-items-center gap-2">
                <span class="fw-semibold small">🧪 BMES Material Fetch (MES020010)</span>
                <span class="badge bg-secondary" style="font-size:10px;">DB rows: @_materialCount</span>
                <div class="ms-auto">
                    <button class="btn btn-primary btn-sm"
                            @onclick="FetchAllMaterialsAsync"
                            disabled="@_fetchBusy">
                        @if (_fetchBusy)
                        { <span class="spinner-border spinner-border-sm me-1"></span><text>Fetching…</text> }
                        else { <text>▶ Fetch all materials</text> }
                    </button>
                </div>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(_fetchLog))
                {
                    <pre class="small mb-2" style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:4px; padding:8px; max-height:160px; overflow:auto;">@_fetchLog</pre>
                }
                @if (_latest is not null)
                {
                    <div class="small">
                        <div><strong>MATNR:</strong> @_latest.Matnr</div>
                        <div><strong>MAKTX:</strong> @_latest.Maktx</div>
                        <div><strong>MTYPE/BTYPE:</strong> @_latest.Mtype / @_latest.Btype</div>
                        <div><strong>ModNameB:</strong> @_latest.ModNameB</div>
                        <div><strong>LotQt / Bunch:</strong> @_latest.LotQt / @_latest.Bunch</div>
                        <div><strong>ERNAM / ERDAT:</strong> @_latest.Ernam / @_latest.Erdat</div>
                        <div class="text-muted mt-1">FetchedAt: @_latest.FetchedAt</div>
                    </div>
                }
                else
                {
                    <div class="text-muted small">No material saved yet.</div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <a class="card shadow-sm text-decoration-none h-100" href="/bmes/routing-table">
            <div class="card-body">
                <div class="fw-semibold small text-dark">Routing Table</div>
                <div class="text-muted small mt-1">Moved to its own BMES menu.</div>
            </div>
        </a>
    </div>
    <div class="col-md-6">
        <a class="card shadow-sm text-decoration-none h-100" href="/bmes/reason-table">
            <div class="card-body">
                <div class="fw-semibold small text-dark">Reason Table</div>
                <div class="text-muted small mt-1">Moved to its own BMES menu. Model search is in the first column.</div>
            </div>
        </a>
    </div>
</div>

<div class="row g-3 d-none">

    <!-- ══ Routing Table ═══════════════════════════════════════════════════════ -->
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header d-flex align-items-center gap-2">
                <span class="fw-semibold small">Routing Table</span>
                <span class="badge bg-secondary ms-1" style="font-size:10px;">@_routingRows.Count rows</span>
                @if (_anyRoutingSearch)
                {
                    <span class="text-muted ms-1" style="font-size:10px;">— @rFiltered.Count shown</span>
                }
                <div class="ms-auto d-flex gap-2 align-items-center">
                    @if (_routingScrapeBusy)
                    {
                        <span class="spinner-border spinner-border-sm text-primary" role="status"></span>
                    }
                    @if (!string.IsNullOrEmpty(_routingScrapeMsg))
                    {
                        <span class="small @(_routingScrapeError ? "text-danger" : "text-success") fw-semibold">
                            @_routingScrapeMsg
                        </span>
                    }
                    <button class="btn btn-outline-primary btn-sm" @onclick="RefreshRoutingFromBmes"
                            disabled="@_routingScrapeBusy"
                            title="Scrape MES020240/SearchList for WERKS 3200/3210/3220 → bmes_routing_raw.db">
                        Refresh from BMES
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="ImportRoutingFromFile"
                            disabled="@_routingScrapeBusy"
                            title="Import from Routing.txt">
                        Import from file
                    </button>
                </div>
            </div>
            <div style="overflow-x:auto; max-height:460px; overflow-y:auto;">
                <table class="bmes-table">
                    <thead>
                        <tr>
                            <th style="min-width:160px;">Model Name</th>
                            <th style="min-width:130px;">ProcessCode</th>
                            <th style="min-width:200px;">ProcessName</th>
                            <th style="min-width:110px;">ProcessType</th>
                            <th style="width:60px;"></th>
                        </tr>
                        <tr class="bmes-search-row">
                            <td><input class="bmes-search-input" placeholder="Search…"
                                       @bind="_rqModelName"   @bind:event="oninput" @bind:after="OnRoutingSearchChanged" /></td>
                            <td><input class="bmes-search-input" placeholder="Search…"
                                       @bind="_rqProcessCode" @bind:event="oninput" @bind:after="OnRoutingSearchChanged" /></td>
                            <td><input class="bmes-search-input" placeholder="Search…"
                                       @bind="_rqProcessName" @bind:event="oninput" @bind:after="OnRoutingSearchChanged" /></td>
                            <td><input class="bmes-search-input" placeholder="Search…"
                                       @bind="_rqProcessType" @bind:event="oninput" @bind:after="OnRoutingSearchChanged" /></td>
                            <td></td>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!_anyRoutingSearch)
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4 small">
                                    Type in a search field above to find rows.
                                </td>
                            </tr>
                        }
                        else if (rFiltered.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="py-3 px-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <span class="text-muted small">No matching rows.</span>
                                        <button class="btn btn-primary btn-sm" @onclick="AddRoutingFromSearch">
                                            + Add Row with these values
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var r in rFiltered)
                            {
                                @if (_editRoutingId == r.Id)
                                {
                                    <tr class="bmes-edit-row">
                                        <td><input class="bmes-input" @bind="_editRouting.ModelName"   /></td>
                                        <td><input class="bmes-input" @bind="_editRouting.ProcessCode" /></td>
                                        <td><input class="bmes-input" @bind="_editRouting.ProcessName" /></td>
                                        <td><input class="bmes-input" @bind="_editRouting.ProcessType" /></td>
                                        <td class="bmes-actions">
                                            <button class="btn btn-success btn-sm py-0 px-2"   @onclick="SaveRoutingEdit">✓</button>
                                            <button class="btn btn-secondary btn-sm py-0 px-2" @onclick="CancelRoutingEdit">✕</button>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    <tr class="bmes-row" @ondblclick="() => StartRoutingEdit(r)">
                                        <td>@r.ModelName</td>
                                        <td>@r.ProcessCode</td>
                                        <td>@r.ProcessName</td>
                                        <td>@r.ProcessType</td>
                                        <td class="bmes-actions">
                                            <button class="btn btn-outline-primary btn-sm py-0 px-1" @onclick="() => StartRoutingEdit(r)"    title="Edit">✎</button>
                                            <button class="btn btn-outline-danger  btn-sm py-0 px-1" @onclick="() => DeleteRoutingRow(r.Id)" title="Delete">✕</button>
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ══ Reason Table ════════════════════════════════════════════════════════ -->
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header d-flex align-items-center gap-2">
                <span class="fw-semibold small">Reason Table</span>
                <span class="badge bg-secondary ms-1" style="font-size:10px;">@_reasonRows.Count rows</span>
                @if (_modelScanActive)
                {
                    <span class="text-muted ms-1" style="font-size:10px;">— @_modelPairs.Count distinct pair(s) for "@_rsqModel"</span>
                }
                else if (_anyReasonSearch)
                {
                    <span class="text-muted ms-1" style="font-size:10px;">— @rsFiltered.Count shown</span>
                }

                <div class="d-flex align-items-center gap-1 ms-3">
                    <input class="form-control form-control-sm"
                           style="max-width:240px; font-size:11px;"
                           placeholder="Model (Material) — Enter to scan"
                           @bind="_rsqModel"
                           @bind:event="oninput"
                           @onkeydown="OnModelSearchKeyDown" />
                    <button class="btn btn-outline-primary btn-sm py-0 px-2"
                            style="font-size:11px;"
                            disabled="@(_modelScanBusy || string.IsNullOrWhiteSpace(_rsqModel))"
                            @onclick="RunModelScan"
                            title="Scan daily DBs for distinct (ProcessName, NgName) pairs whose MATERIALNAME contains this model.">
                        @if (_modelScanBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-1" style="width:10px; height:10px;"></span>
                        }
                        Scan
                    </button>
                    @if (_modelScanActive)
                    {
                        <button class="btn btn-link btn-sm py-0 px-1 text-secondary"
                                style="font-size:11px;"
                                @onclick="ClearModelScan"
                                title="Clear model scan and return to Reason Table search">✕</button>
                    }
                </div>

                <div class="ms-auto d-flex gap-2 align-items-center">
                    @if (_reasonRefreshBusy)
                    {
                        <span class="spinner-border spinner-border-sm text-primary" role="status"></span>
                    }
                    @if (!string.IsNullOrEmpty(_reasonRefreshMsg))
                    {
                        <span class="small @(_reasonRefreshError ? "text-danger" : "text-success") fw-semibold">
                            @_reasonRefreshMsg
                        </span>
                    }
                    <button class="btn btn-outline-primary btn-sm" @onclick="RefreshReasonFromDailyDbs"
                            disabled="@_reasonRefreshBusy"
                            title="Scan all Daily DBs and add missing (ProcessName, NgName) pairs">
                        Refresh from Daily DBs
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="ImportReasonFromFile"
                            disabled="@_reasonRefreshBusy"
                            title="Import from reason.txt">
                        Import from file
                    </button>
                </div>
            </div>
            <div style="overflow-x:auto; max-height:460px; overflow-y:auto;">
                <table class="bmes-table">
                    <thead>
                        <tr>
                            <th style="min-width:200px;">ProcessName</th>
                            <th style="min-width:200px;">NgName</th>
                            <th style="min-width:200px;">Reason</th>
                            <th style="width:60px;"></th>
                        </tr>
                        <tr class="bmes-search-row">
                            <td><input class="bmes-search-input" placeholder="Search…"
                                       @bind="_rsqProcessName" @bind:event="oninput" @bind:after="OnReasonSearchChanged" /></td>
                            <td><input class="bmes-search-input" placeholder="Search…"
                                       @bind="_rsqNgName"      @bind:event="oninput" @bind:after="OnReasonSearchChanged" /></td>
                            <td><input class="bmes-search-input" placeholder="Search…"
                                       @bind="_rsqReason"      @bind:event="oninput" @bind:after="OnReasonSearchChanged" /></td>
                            <td></td>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_modelScanActive)
                        {
                            @if (_modelPairs.Count == 0)
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4 small">
                                        @(_modelScanBusy
                                            ? "Scanning…"
                                            : "No (PROCESSNAME, NGNAME) pair found in daily DBs for this model.")
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var p in ModelPairsFiltered())
                                {
                                    var existing = FindReasonRow(p.ProcessName, p.NgName);
                                    bool missing = existing is null;
                                    bool editing = existing is not null && _editReasonId == existing.Id;

                                    @if (editing)
                                    {
                                        <tr class="bmes-edit-row">
                                            <td><input class="bmes-input" @bind="_editReason.ProcessName" /></td>
                                            <td><input class="bmes-input" @bind="_editReason.NgName"      /></td>
                                            <td><input class="bmes-input" @bind="_editReason.Reason"      /></td>
                                            <td class="bmes-actions">
                                                <button class="btn btn-success btn-sm py-0 px-2"   @onclick="SaveReasonEdit">✓</button>
                                                <button class="btn btn-secondary btn-sm py-0 px-2" @onclick="CancelReasonEdit">✕</button>
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        var pn = p.ProcessName; var ng = p.NgName;
                                        <tr class="bmes-row @(missing ? "bmes-row-missing" : "")">
                                            <td>@pn</td>
                                            <td>@ng</td>
                                            <td>
                                                @if (missing)
                                                {
                                                    <span class="text-danger small fst-italic">(not in Reason Table)</span>
                                                }
                                                else
                                                {
                                                    @existing!.Reason
                                                }
                                            </td>
                                            <td class="bmes-actions">
                                                @if (missing)
                                                {
                                                    <button class="btn btn-outline-primary btn-sm py-0 px-1"
                                                            @onclick="() => AddReasonFromPair(pn, ng)"
                                                            title="Add to Reason Table">+</button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-outline-primary btn-sm py-0 px-1"
                                                            @onclick="() => StartReasonEdit(existing)"   title="Edit">✎</button>
                                                    <button class="btn btn-outline-danger  btn-sm py-0 px-1"
                                                            @onclick="() => DeleteReasonRow(existing.Id)" title="Delete">✕</button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            }
                        }
                        else if (!_anyReasonSearch)
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4 small">
                                    Type in a search field above to find rows.
                                </td>
                            </tr>
                        }
                        else if (rsFiltered.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="py-3 px-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <span class="text-muted small">No matching rows.</span>
                                        <button class="btn btn-primary btn-sm" @onclick="AddReasonFromSearch">
                                            + Add Row with these values
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var r in rsFiltered)
                            {
                                @if (_editReasonId == r.Id)
                                {
                                    <tr class="bmes-edit-row">
                                        <td><input class="bmes-input" @bind="_editReason.ProcessName" /></td>
                                        <td><input class="bmes-input" @bind="_editReason.NgName"      /></td>
                                        <td><input class="bmes-input" @bind="_editReason.Reason"      /></td>
                                        <td class="bmes-actions">
                                            <button class="btn btn-success btn-sm py-0 px-2"   @onclick="SaveReasonEdit">✓</button>
                                            <button class="btn btn-secondary btn-sm py-0 px-2" @onclick="CancelReasonEdit">✕</button>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    <tr class="bmes-row" @ondblclick="() => StartReasonEdit(r)">
                                        <td>@r.ProcessName</td>
                                        <td>@r.NgName</td>
                                        <td>@r.Reason</td>
                                        <td class="bmes-actions">
                                            <button class="btn btn-outline-primary btn-sm py-0 px-1" @onclick="() => StartReasonEdit(r)"    title="Edit">✎</button>
                                            <button class="btn btn-outline-danger  btn-sm py-0 px-1" @onclick="() => DeleteReasonRow(r.Id)" title="Delete">✕</button>
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<style>
