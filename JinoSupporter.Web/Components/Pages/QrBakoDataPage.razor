@page "/bmes/qr-bako-data"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Globalization
@using JinoSupporter.Web.Services
@inject QrBakoDataService QrBakoData
@inject IJSRuntime JS

<PageTitle>QR BAKO DATA</PageTitle>

<div class="qr-date-browser">
    <header class="qr-titlebar">
        <div>
            <div class="qr-kicker">BAKO 검사결과 · DB 접수 DATA</div>
            <h1>QR BAKO DATA</h1>
            <p>날짜를 하나 이상 선택하면 TCDB.dbo.BKTD의 해당 날짜 데이터를 함께 표시합니다.</p>
        </div>
        <div class="qr-actions">
            <span class="qr-connection">@ConnectionLabel</span>
            <button class="qr-btn qr-primary"
                    type="button"
                    @onclick="RefreshAsync"
                    disabled="@(_busy || !QrBakoData.IsConfigured)">
                @if (_busy)
                {
                    <span class="qr-spinner" aria-hidden="true"></span>
                    <span>Loading</span>
                }
                else
                {
                    <span>Refresh</span>
                }
            </button>
            <button class="qr-btn"
                    type="button"
                    @onclick="ExportCsvAsync"
                    disabled="@(_busy || _exporting || _result is null || _result.Rows.Count == 0)">
                @if (_exporting)
                {
                    <span class="qr-spinner" aria-hidden="true"></span>
                    <span>Exporting</span>
                }
                else
                {
                    <span>CSV</span>
                }
            </button>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="qr-alert qr-danger">@_error</div>
    }

    @if (_result is not null && !string.IsNullOrWhiteSpace(_result.WarningMessage))
    {
        <div class="qr-alert qr-warning">@_result.WarningMessage</div>
    }

    @if (!QrBakoData.IsConfigured)
    {
        <div class="qr-alert qr-warning">QR BAKO DB password is not configured on the server.</div>
    }

    @if (_busy && _result is null)
    {
        <div class="qr-state-panel">
            <span class="qr-spinner" aria-hidden="true"></span>
            <span>TCDB.dbo.BKTD 날짜 목록을 불러오는 중입니다.</span>
        </div>
    }
    else if (_result is null)
    {
        <div class="qr-state-panel">조회된 데이터가 없습니다.</div>
    }
    else
    {
        <div class="qr-browser-grid" aria-busy="@_busy.ToString().ToLowerInvariant()">
            <aside class="qr-date-panel">
                <div class="qr-section-head">
                    <div>
                        <strong>검사 날짜</strong>
                        <span>@_selectedDates.Count.ToString("N0")일 선택</span>
                    </div>
                    <small>TestTime · 복수 선택</small>
                </div>

                <div class="qr-date-list">
                    @if (_result.Dates.Count == 0)
                    {
                        <div class="qr-empty">표시할 날짜가 없습니다.</div>
                    }
                    else
                    {
                        @foreach (var date in _result.Dates)
                        {
                            <label class="@DateOptionClass(date.Date)">
                                <input class="qr-date-check"
                                       type="checkbox"
                                       checked="@_selectedDates.Contains(date.Date)"
                                       disabled="@_busy"
                                       @onchange="async _ => await ToggleDateAsync(date.Date)" />
                                <span class="qr-date-label">@FormatDate(date.Date)</span>
                                <span class="qr-date-count">@date.RowCount.ToString("N0")건</span>
                            </label>
                        }
                    }
                </div>
            </aside>

            <section class="qr-data-panel">
                <div class="qr-section-head qr-table-head">
                    <div>
                        <strong>@SelectedDatesLabel</strong>
                        <span>검사 데이터</span>
                    </div>
                    <div class="qr-row-summary">
                        <span>표시 @_rowGroups.Count.ToString("N0") QR</span>
                        <span>조회 @_result.Rows.Count.ToString("N0")건</span>
                        @if (_result.TotalRows is long totalRows)
                        {
                            <span>DB 원본 @totalRows.ToString("N0")건</span>
                        }
                        @if (_result.ExcludedRows is long excludedRows)
                        {
                            <span class="@(excludedRows > 0 ? "qr-excluded" : string.Empty)">제외 @excludedRows.ToString("N0")건</span>
                        }
                        <span>@_result.Columns.Count.ToString("N0")개 컬럼</span>
                        @if (_result.ValidTotalRows is long validTotal && validTotal > _result.Rows.Count)
                        {
                            <b>최신 @_result.MaxRows.ToString("N0")건 제한 · QR 묶음은 표시 범위 기준</b>
                        }
                    </div>
                </div>

                @if (_result.Summary is QrBakoDataSummary summary)
                {
                    <div class="qr-summary-grid" aria-label="선택 날짜 QR 요약">
                        <article class="qr-summary-card">
                            <span>Input 개수</span>
                            <strong>@summary.InputCount.ToString("N0")</strong>
                            <small>중복 ProductID 제외</small>
                        </article>
                        <article class="qr-summary-card">
                            <span>NG 개수</span>
                            <strong>@summary.NgCount.ToString("N0")</strong>
                                <small>최신 TestTime 결과 기준</small>
                        </article>
                        <article class="qr-summary-card">
                            <span>NG Rate</span>
                            <strong>@FormatPpm(summary.NgRatePpm)</strong>
                            <small>NG ÷ Input · PPM</small>
                        </article>
                    </div>
                }

                <div class="qr-table-wrap">
                    @if (_result.Columns.Count == 0)
                    {
                        <div class="qr-empty">쿼리 결과 컬럼이 없습니다.</div>
                    }
                    else if (_selectedDates.Count == 0)
                    {
                        <div class="qr-empty">좌측에서 검사 날짜를 선택하세요.</div>
                    }
                    else if (_result.Rows.Count == 0)
                    {
                        <div class="qr-empty">선택한 날짜의 데이터가 없습니다.</div>
                    }
                    else
                    {
                        <table class="qr-data-table">
                            <thead>
                                <tr>
                                    <th class="qr-expand-head">
                                        <span>QR</span>
                                        <small>묶음</small>
                                    </th>
                                    <th class="qr-test-date-head">
                                        <span>검사일</span>
                                        <small>TestTime</small>
                                    </th>
                                    @foreach (var column in _result.Columns)
                                    {
                                        <th title="@column.DataType">
                                            <span>@column.Name</span>
                                            <small>@column.DataType</small>
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var group in _rowGroups)
                                {
                                    bool expanded = _expandedProductIds.Contains(group.Key);
                                    QrBakoDataRow representative = group.Rows[0];
                                    <tr class="qr-primary-row">
                                        <td class="qr-expand-cell">
                                            @if (group.Rows.Count > 1)
                                            {
                                                <button class="qr-group-toggle"
                                                        type="button"
                                                        aria-expanded="@expanded.ToString().ToLowerInvariant()"
                                                        title="@(expanded ? "같은 QR 행 접기" : "같은 QR 행 펼치기")"
                                                        @onclick="() => ToggleGroup(group.Key)">
                                                    <span aria-hidden="true">@(expanded ? "−" : "+")</span>
                                                    <b>@group.Rows.Count.ToString("N0")</b>
                                                </button>
                                            }
                                        </td>
                                        <td class="qr-test-date">@FormatRowDate(representative.TestDate)</td>
                                        @for (int columnIndex = 0; columnIndex < _result.Columns.Count; columnIndex++)
                                        {
                                            var column = _result.Columns[columnIndex];
                                            string value = columnIndex < representative.Values.Count ? representative.Values[columnIndex] : string.Empty;
                                            <td class="@CellClass(column, value)">@DisplayCell(value)</td>
                                        }
                                    </tr>
                                    @if (expanded)
                                    {
                                        @for (int rowIndex = 1; rowIndex < group.Rows.Count; rowIndex++)
                                        {
                                            QrBakoDataRow childRow = group.Rows[rowIndex];
                                            <tr class="qr-child-row">
                                                <td class="qr-expand-cell">
                                                    <span class="qr-child-mark" aria-label="같은 QR의 추가 검사 행">└</span>
                                                </td>
                                                <td class="qr-test-date">@FormatRowDate(childRow.TestDate)</td>
                                                @for (int columnIndex = 0; columnIndex < _result.Columns.Count; columnIndex++)
                                                {
                                                    var column = _result.Columns[columnIndex];
                                                    string value = columnIndex < childRow.Values.Count ? childRow.Values[columnIndex] : string.Empty;
                                                    <td class="@CellClass(column, value)">@DisplayCell(value)</td>
                                                }
                                            </tr>
                                        }
                                    }
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </section>
        </div>
    }
</div>

<style>
    .qr-date-browser {
        display: flex;
        min-height: 32rem;
        height: calc(var(--view-h, 100vh) - 6.2rem);
        margin: -0.25rem -0.5rem 0;
        padding: 0.8rem 1rem 1rem;
        flex-direction: column;
        overflow: hidden;
        background: var(--plane, #e8eaee);
        color: var(--ink, #0f1319);
        font-family: var(--sans, "Segoe UI", "Malgun Gothic", sans-serif);
    }

    .qr-titlebar {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 0.7rem;
        flex: 0 0 auto;
    }

    .qr-kicker {
        margin-bottom: 0.2rem;
        color: var(--crit, #c8342a);
        font-family: var(--mono, Bahnschrift, Consolas, monospace);
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.04em;
    }

    .qr-titlebar h1 {
        margin: 0;
        font-size: 1.12rem;
        line-height: 1.25;
    }

    .qr-titlebar p {
        margin: 0.16rem 0 0;
        color: var(--ink-2, #4a5461);
        font-size: 0.76rem;
    }

    .qr-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.4rem;
        min-width: 0;
    }

    .qr-connection {
        max-width: 24rem;
        margin-right: 0.25rem;
        overflow: hidden;
        color: var(--ink-3, #7f8a98);
        font-family: var(--mono, Bahnschrift, Consolas, monospace);
        font-size: 0.66rem;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .qr-btn {
        display: inline-flex;
        min-height: 1.9rem;
        padding: 0.32rem 0.72rem;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
        border: 1px solid var(--line-2, #c6ccd5);
        border-radius: 2px;
        background: var(--panel, #fff);
        color: var(--ink, #0f1319);
        font: 700 0.7rem var(--sans, "Segoe UI", sans-serif);
        cursor: pointer;
    }

    .qr-btn:hover:not(:disabled) {
        background: var(--panel-2, #f5f6f9);
        border-color: var(--ink, #0f1319);
    }

    .qr-btn.qr-primary {
        border-color: var(--signal, #16202b);
        background: var(--signal, #16202b);
        color: var(--panel, #fff);
    }

    .qr-btn:disabled,
    .qr-date-option.qr-disabled {
        cursor: default;
        opacity: 0.55;
    }

    .qr-spinner {
        display: inline-block;
        width: 0.78rem;
        height: 0.78rem;
        border: 2px solid var(--line-2, #c6ccd5);
        border-top-color: currentColor;
        border-radius: 50%;
        animation: qr-spin 0.75s linear infinite;
    }

    .qr-alert,
    .qr-state-panel {
        margin-bottom: 0.65rem;
        padding: 0.58rem 0.72rem;
        border: 1px solid var(--line-2, #c6ccd5);
        border-radius: 2px;
        background: var(--panel, #fff);
        color: var(--ink-2, #4a5461);
        font-size: 0.76rem;
    }

    .qr-state-panel {
        display: flex;
        min-height: 8rem;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
    }

    .qr-alert.qr-danger {
        border-color: var(--crit, #c8342a);
        background: var(--crit-wash, #fbedec);
        color: var(--crit, #c8342a);
    }

    .qr-alert.qr-warning {
        border-color: var(--line-2, #c6ccd5);
        background: var(--panel-2, #f5f6f9);
    }

    .qr-browser-grid {
        display: grid;
        min-height: 0;
        flex: 1 1 auto;
        grid-template-columns: 15rem minmax(0, 1fr);
        border: 1px solid var(--line-2, #c6ccd5);
        border-radius: 2px;
        background: var(--panel, #fff);
    }

    .qr-date-panel,
    .qr-data-panel {
        display: flex;
        min-width: 0;
        min-height: 0;
        flex-direction: column;
    }

    .qr-date-panel {
        border-right: 1px solid var(--line-2, #c6ccd5);
        background: var(--panel-2, #f5f6f9);
    }

    .qr-section-head {
        display: flex;
        min-height: 2.75rem;
        padding: 0.55rem 0.68rem;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        border-bottom: 1px solid var(--line-2, #c6ccd5);
        background: var(--panel-2, #f5f6f9);
    }

    .qr-section-head > div:first-child {
        display: flex;
        align-items: baseline;
        gap: 0.42rem;
    }

    .qr-section-head strong {
        font-size: 0.8rem;
    }

    .qr-section-head span,
    .qr-section-head small {
        color: var(--ink-3, #7f8a98);
        font-size: 0.68rem;
    }

    .qr-date-list {
        min-height: 0;
        padding: 0.38rem;
        flex: 1 1 auto;
        overflow: auto;
    }

    .qr-date-option {
        display: flex;
        width: 100%;
        min-height: 2.35rem;
        padding: 0.42rem 0.5rem;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        border: 1px solid transparent;
        border-radius: 2px;
        background: transparent;
        color: var(--ink, #0f1319);
        text-align: left;
        cursor: pointer;
    }

    .qr-date-option + .qr-date-option {
        margin-top: 0.18rem;
    }

    .qr-date-option:hover:not(.qr-disabled) {
        border-color: var(--line-2, #c6ccd5);
        background: var(--panel, #fff);
    }

    .qr-date-option.qr-selected {
        border-color: var(--signal, #16202b);
        background: var(--signal, #16202b);
        color: var(--panel, #fff);
    }

    .qr-date-check {
        width: 0.9rem;
        height: 0.9rem;
        margin: 0;
        flex: 0 0 auto;
        accent-color: var(--signal, #16202b);
    }

    .qr-date-label {
        margin-right: auto;
        font-family: var(--mono, Bahnschrift, Consolas, monospace);
        font-size: 0.72rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .qr-date-count {
        color: var(--ink-3, #7f8a98);
        font-size: 0.66rem;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

    .qr-selected .qr-date-count {
        color: var(--panel-3, #eceef2);
    }

    .qr-table-head {
        flex: 0 0 auto;
    }

    .qr-row-summary {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.75rem;
        font-variant-numeric: tabular-nums;
    }

    .qr-row-summary b {
        color: var(--warn-ink, #92610a);
        font-size: 0.68rem;
    }

    .qr-row-summary .qr-excluded {
        color: var(--warn-ink, #92610a);
        font-weight: 700;
    }

    .qr-table-wrap {
        min-width: 0;
        min-height: 0;
        flex: 1 1 auto;
        overflow: auto;
        background: var(--panel, #fff);
    }

    .qr-data-table {
        width: max-content;
        min-width: 100%;
        border-collapse: collapse;
        background: var(--panel, #fff);
        font-size: 0.69rem;
    }

    .qr-data-table th,
    .qr-data-table td {
        height: 2rem;
        padding: 0.34rem 0.48rem;
        border: 1px solid var(--line, #dde1e7);
        text-align: left;
        white-space: nowrap;
    }

    .qr-data-table th {
        position: sticky;
        top: 0;
        z-index: 3;
        border-bottom-color: var(--line-2, #c6ccd5);
        background: var(--panel-2, #f5f6f9);
        color: var(--ink-2, #4a5461);
        font-weight: 700;
    }

    .qr-data-table th span,
    .qr-data-table th small {
        display: block;
    }

    .qr-data-table th small {
        margin-top: 0.08rem;
        color: var(--ink-3, #7f8a98);
        font-family: var(--mono, Bahnschrift, Consolas, monospace);
        font-size: 0.58rem;
        font-weight: 400;
    }

    .qr-data-table tbody tr:nth-child(even) td {
        background: color-mix(in srgb, var(--panel-2, #f5f6f9) 48%, var(--panel, #fff));
    }

    .qr-data-table tbody tr:hover td {
        background: var(--panel-3, #eceef2);
    }

    .qr-data-table th:first-child,
    .qr-data-table td:first-child {
        position: sticky;
        left: 0;
        z-index: 2;
        border-right-color: var(--line-2, #c6ccd5);
        background: var(--panel, #fff);
        font-variant-numeric: tabular-nums;
    }

    .qr-data-table th:first-child {
        z-index: 4;
        background: var(--panel-2, #f5f6f9);
    }

    .qr-data-table th:nth-child(2),
    .qr-data-table td:nth-child(2) {
        position: sticky;
        left: 3.7rem;
        z-index: 2;
        border-right-color: var(--line-2, #c6ccd5);
        background: var(--panel, #fff);
    }

    .qr-summary-grid {
        display: grid;
        flex: 0 0 auto;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        border-bottom: 1px solid var(--line-2, #c6ccd5);
        background: var(--panel, #fff);
    }

    .qr-summary-card {
        display: grid;
        min-height: 4.4rem;
        padding: 0.55rem 0.7rem;
        align-content: center;
        gap: 0.12rem;
        border-right: 1px solid var(--line, #dde1e7);
        background: var(--panel, #fff);
    }

    .qr-summary-card:last-child {
        border-right: 0;
    }

    .qr-summary-card span,
    .qr-summary-card small {
        color: var(--ink-3, #7f8a98);
        font-size: 0.64rem;
    }

    .qr-summary-card strong {
        color: var(--ink, #0f1319);
        font: 800 1.05rem var(--mono, Bahnschrift, Consolas, monospace);
        font-variant-numeric: tabular-nums;
    }

    .qr-data-table th:nth-child(2) {
        z-index: 4;
        background: var(--panel-2, #f5f6f9);
    }

    .qr-data-table .qr-expand-head,
    .qr-data-table .qr-expand-cell {
        width: 3.7rem;
        min-width: 3.7rem;
        padding-right: 0.3rem;
        padding-left: 0.3rem;
        text-align: center;
    }

    .qr-data-table .qr-test-date-head,
    .qr-data-table .qr-test-date {
        width: 6.3rem;
        min-width: 6.3rem;
        text-align: center;
        font-family: var(--mono, Bahnschrift, Consolas, monospace);
        font-variant-numeric: tabular-nums;
    }

    .qr-data-table .qr-test-date {
        color: var(--ink-2, #4a5461);
        font-weight: 700;
    }

    .qr-group-toggle {
        display: inline-flex;
        min-width: 2.9rem;
        min-height: 1.45rem;
        padding: 0.12rem 0.3rem;
        align-items: center;
        justify-content: center;
        gap: 0.22rem;
        border: 1px solid var(--signal, #16202b);
        border-radius: 2px;
        background: var(--panel, #fff);
        color: var(--signal, #16202b);
        font: 700 0.65rem var(--mono, Bahnschrift, Consolas, monospace);
        cursor: pointer;
    }

    .qr-group-toggle:hover {
        background: var(--signal, #16202b);
        color: var(--panel, #fff);
    }

    .qr-child-row .qr-expand-cell {
        border-left: 3px solid var(--signal, #16202b);
        background: var(--panel-3, #eceef2);
    }

    .qr-child-mark {
        display: inline-block;
        padding-left: 0.45rem;
        color: var(--ink-2, #4a5461);
        font: 700 0.72rem var(--mono, Bahnschrift, Consolas, monospace);
    }

    .qr-data-table tbody tr:nth-child(even) td:first-child,
    .qr-data-table tbody tr:nth-child(even) td:nth-child(2) {
        background: var(--panel-2, #f5f6f9);
    }

    .qr-data-table tbody tr:hover td:first-child,
    .qr-data-table tbody tr:hover td:nth-child(2) {
        background: var(--panel-3, #eceef2);
    }

    .qr-data-table td.qr-num {
        text-align: right;
        font-variant-numeric: tabular-nums;
    }

    .qr-data-table td.qr-result-pass {
        background: var(--ok-wash, #eaf1f9);
        color: var(--ok, #1f5fa8);
        font-weight: 800;
        text-align: center;
    }

    .qr-data-table td.qr-result-fail {
        background: var(--crit-wash, #fbedec);
        color: var(--crit, #c8342a);
        font-weight: 800;
        text-align: center;
    }

    .qr-empty {
        display: flex;
        min-height: 7rem;
        padding: 1rem;
        align-items: center;
        justify-content: center;
        color: var(--ink-3, #7f8a98);
        font-size: 0.74rem;
        text-align: center;
    }

    @@keyframes qr-spin {
        to { transform: rotate(360deg); }
    }

    @@media (max-width: 900px) {
        .qr-date-browser {
            height: auto;
            min-height: 32rem;
            overflow: visible;
        }

        .qr-titlebar {
            align-items: stretch;
            flex-direction: column;
        }

        .qr-actions {
            justify-content: flex-start;
        }

        .qr-browser-grid {
            min-height: 38rem;
            grid-template-columns: 11.5rem minmax(0, 1fr);
        }

        .qr-connection {
            display: none;
        }
    }
</style>

@code {
    private static readonly HashSet<string> NumericTypes = new(StringComparer.OrdinalIgnoreCase)
    {
        "bigint", "decimal", "float", "int", "money", "numeric", "real", "smallint", "smallmoney", "tinyint"
    };

    private QrBakoDataResult? _result;
    private IReadOnlyList<QrBakoRowGroup> _rowGroups = [];
    private readonly HashSet<string> _expandedProductIds = new(StringComparer.Ordinal);
    private readonly HashSet<DateOnly> _selectedDates = [];
    private string _error = string.Empty;
    private int _maxRows;
    private bool _busy;
    private bool _exporting;

    protected override async Task OnInitializedAsync()
    {
        _maxRows = QrBakoData.DefaultMaxRows;
        if (QrBakoData.IsConfigured)
            await LoadAsync();
    }

    private string ConnectionLabel
    {
        get
        {
            var snapshot = QrBakoData.Snapshot;
            return $"{snapshot.Server},{snapshot.Port} / {snapshot.Database} / {snapshot.UserId}";
        }
    }

    private string SelectedDatesLabel
    {
        get
        {
            if (_selectedDates.Count == 0)
                return "날짜 미선택";

            DateOnly latest = _selectedDates.Max();
            if (_selectedDates.Count == 1)
                return FormatDate(latest);

            DateOnly oldest = _selectedDates.Min();
            return $"{_selectedDates.Count:N0}개 날짜 · {oldest:yyyy-MM-dd} ~ {latest:yyyy-MM-dd}";
        }
    }

    private async Task RefreshAsync() => await LoadAsync(_selectedDates);

    private async Task ToggleDateAsync(DateOnly date)
    {
        if (_busy)
            return;

        HashSet<DateOnly> nextDates = _selectedDates.ToHashSet();
        if (!nextDates.Add(date))
            nextDates.Remove(date);
        await LoadAsync(nextDates);
    }

    private async Task LoadAsync(IEnumerable<DateOnly>? dates = null)
    {
        if (_busy)
            return;

        _busy = true;
        _error = string.Empty;
        StateHasChanged();

        try
        {
            QrBakoDataResult result = await QrBakoData.FetchAsync(new QrBakoDataQuery
            {
                MaxRows = _maxRows,
                TestDates = (dates ?? _selectedDates).Distinct().ToArray(),
            });
            _result = result;
            _rowGroups = BuildRowGroups(result);
            _expandedProductIds.Clear();
            _selectedDates.Clear();
            foreach (DateOnly selectedDate in result.SelectedDates)
                _selectedDates.Add(selectedDate);
            _maxRows = result.MaxRows;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task ExportCsvAsync()
    {
        if (_exporting || _result is null || _result.Rows.Count == 0)
            return;

        _exporting = true;
        _error = string.Empty;
        StateHasChanged();

        try
        {
            var rows = new List<IEnumerable<string?>>
            {
                _result.Columns.Select(column => (string?)column.Name),
            };
            rows.AddRange(_result.Rows.Select(row => row.Values.Select(value => (string?)value)));

            byte[] bytes = CsvExportUtility.Build(rows);
            string dateText = ExportDateText();
            string fileName = $"QR_BAKO_DATA_BKTD_{dateText}_{DateTime.Now:HHmmss}.csv";
            await BrowserDownload.DownloadBytesAsync(JS, fileName, bytes, CsvExportUtility.ContentType);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _exporting = false;
            StateHasChanged();
        }
    }

    private string DateOptionClass(DateOnly date)
    {
        var classes = new List<string> { "qr-date-option" };
        if (_selectedDates.Contains(date))
            classes.Add("qr-selected");
        if (_busy)
            classes.Add("qr-disabled");
        return string.Join(' ', classes);
    }

    private string ExportDateText()
    {
        if (_selectedDates.Count == 0)
            return "no_date";

        DateOnly latest = _selectedDates.Max();
        if (_selectedDates.Count == 1)
            return latest.ToString("yyyyMMdd", CultureInfo.InvariantCulture);

        DateOnly oldest = _selectedDates.Min();
        return $"{oldest:yyyyMMdd}-{latest:yyyyMMdd}_{_selectedDates.Count}dates";
    }

    private void ToggleGroup(string key)
    {
        if (!_expandedProductIds.Add(key))
            _expandedProductIds.Remove(key);
    }

    private static IReadOnlyList<QrBakoRowGroup> BuildRowGroups(QrBakoDataResult result)
    {
        int productIdIndex = FindColumnIndex(result.Columns, "ProductID");
        if (productIdIndex < 0)
            return result.Rows
                .Select((row, index) => QrBakoRowGroup.Single($"row:{index}", row))
                .ToList();

        var groups = new List<QrBakoRowGroup>();
        var byProductId = new Dictionary<string, QrBakoRowGroup>(StringComparer.OrdinalIgnoreCase);
        for (int rowIndex = 0; rowIndex < result.Rows.Count; rowIndex++)
        {
            QrBakoDataRow row = result.Rows[rowIndex];
            string productId = productIdIndex < row.Values.Count ? row.Values[productIdIndex].Trim() : string.Empty;
            if (string.IsNullOrWhiteSpace(productId))
            {
                groups.Add(QrBakoRowGroup.Single($"row:{rowIndex}", row));
                continue;
            }

            if (!byProductId.TryGetValue(productId, out QrBakoRowGroup? group))
            {
                group = new QrBakoRowGroup($"product:{productId}");
                byProductId.Add(productId, group);
                groups.Add(group);
            }
            group.Rows.Add(row);
        }

        return groups;
    }

    private static int FindColumnIndex(IReadOnlyList<QrBakoDataColumn> columns, string expectedName)
    {
        string normalizedExpected = NormalizeColumnName(expectedName);
        for (int i = 0; i < columns.Count; i++)
        {
            if (NormalizeColumnName(columns[i].Name) == normalizedExpected)
                return i;
        }
        return -1;
    }

    private static string NormalizeColumnName(string value) =>
        new(value.Where(char.IsLetterOrDigit).Select(char.ToLowerInvariant).ToArray());

    private static string FormatDate(DateOnly date) =>
        date.ToDateTime(TimeOnly.MinValue).ToString("yyyy-MM-dd (ddd)", CultureInfo.CurrentCulture);

    private static string FormatRowDate(DateOnly? date) =>
        date?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? "-";

    private static string FormatPpm(double value) =>
        $"{value.ToString("N0", CultureInfo.CurrentCulture)} ppm";

    private static string DisplayCell(string value) =>
        string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string CellClass(QrBakoDataColumn column, string value)
    {
        string numericClass = NumericTypes.Contains(column.DataType) ? "qr-num" : string.Empty;
        if (!column.Name.EndsWith("Result", StringComparison.OrdinalIgnoreCase))
            return numericClass;

        string resultClass = IsFail(value)
            ? "qr-result-fail"
            : IsPass(value) ? "qr-result-pass" : string.Empty;
        return string.Join(' ', new[] { numericClass, resultClass }.Where(x => !string.IsNullOrWhiteSpace(x)));
    }

    private static bool IsPass(string value) =>
        value.Equals("PASS", StringComparison.OrdinalIgnoreCase)
        || value.Equals("OK", StringComparison.OrdinalIgnoreCase);

    private static bool IsFail(string value) =>
        value.Equals("FAIL", StringComparison.OrdinalIgnoreCase)
        || value.Equals("NG", StringComparison.OrdinalIgnoreCase)
        || value.Equals("N/G", StringComparison.OrdinalIgnoreCase);

    private sealed class QrBakoRowGroup(string key)
    {
        public string Key { get; } = key;
        public List<QrBakoDataRow> Rows { get; } = [];

        public static QrBakoRowGroup Single(string key, QrBakoDataRow row)
        {
            var group = new QrBakoRowGroup(key);
            group.Rows.Add(row);
            return group;
        }
    }
}
