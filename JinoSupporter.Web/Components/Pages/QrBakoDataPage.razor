@code {
    private static readonly QrItemDefinition[] ItemDefinitions =
    [
        new("FRF", ["frf"]),
        new("FO", ["fo", "f0"]),
        new("THD", ["thd"]),
        new("SPL1", ["spl1", "spl_1"]),
        new("SPL2", ["spl2", "spl_2"]),
        new("Implimit", ["implimit", "imp_limit", "impedance_limit"]),
        new("Imp2kHz", ["imp2khz", "imp_2khz", "imp2k"]),
        new("Polarity", ["polarity", "polar"]),
        new("RB_100", ["rb100", "rb_100"]),
        new("RB_Limit", ["rblimit", "rb_limit"]),
        new("RB_250", ["rb250", "rb_250"]),
        new("RB_900", ["rb900", "rb_900"]),
        new("SEQS_Spectrum", ["seqsspectrum", "seqs_spectrum", "spectrum"]),
    ];

    private QrBakoDataResult? _result;
    private List<QrInspection> _inspections = [];
    private readonly HashSet<string> _expandedKeys = new(StringComparer.Ordinal);
    private readonly HashSet<string> _expandedDateKeys = new(StringComparer.Ordinal);
    private string _error = string.Empty;
    private string _search = string.Empty;
    private string _lineFilter = string.Empty;
    private string _equipmentFilter = string.Empty;
    private string _itemFilter = string.Empty;
    private int _maxRows;
    private bool _busy;
    private bool _exporting;
    private bool _failOnly;

    protected override async Task OnInitializedAsync()
    {
        _maxRows = QrBakoData.DefaultMaxRows;
        if (QrBakoData.IsConfigured)
            await LoadAsync();
    }

    private string ConnectionLabel
    {
        get
        {
            var s = QrBakoData.Snapshot;
            return $"{s.Server},{s.Port} / {s.Database} / {s.UserId}";
        }
    }

    private async Task LoadAsync()
    {
        if (_busy) return;

        _busy = true;
        _error = string.Empty;
        StateHasChanged();

        try
        {
            _result = await QrBakoData.FetchAsync(new QrBakoDataQuery { MaxRows = _maxRows });
            _maxRows = _result.MaxRows;
            _inspections = BuildInspections(_result);
            _expandedKeys.Clear();
            _expandedDateKeys.Clear();
            if (_inspections.Count > 0)
            {
                _expandedKeys.Add(_inspections[0].Key);
                _expandedDateKeys.Add(_inspections[0].DateKey);
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private QrDashboard BuildDashboard()
    {
        List<QrInspection> inspections = FilterInspections();
        int total = inspections.Count;
        int fail = inspections.Count(x => x.IsFail);
        int pass = total - fail;

        List<QrParetoItem> pareto = inspections
            .SelectMany(ParetoItemsFor)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .GroupBy(x => x, StringComparer.OrdinalIgnoreCase)
            .Select(g => new QrParetoItem(g.Key, g.Count()))
            .OrderByDescending(x => x.Count)
            .ThenBy(x => x.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();

        QrParetoItem? topNg = pareto.FirstOrDefault();

        string topLine = inspections
            .Where(x => !string.IsNullOrWhiteSpace(x.Line))
            .GroupBy(x => x.Line, StringComparer.OrdinalIgnoreCase)
            .OrderByDescending(g => g.Count())
            .ThenBy(g => g.Key, StringComparer.OrdinalIgnoreCase)
            .Select(g => g.Key)
            .FirstOrDefault() ?? string.Empty;

        int uniqueQr = inspections
            .Where(x => !string.IsNullOrWhiteSpace(x.Serial))
            .Select(x => x.Serial)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();

        return new QrDashboard(
            inspections,
            pareto,
            total,
            pass,
            fail,
            total == 0 ? 0 : pass / (double)total,
            total == 0 ? 0 : fail / (double)total,
            uniqueQr,
            topLine,
            topNg?.Name ?? string.Empty,
            topNg?.Count ?? 0,
            pareto.Count == 0 ? 0 : pareto.Max(x => x.Count));
    }

    private List<QrInspection> FilterInspections()
    {
        IEnumerable<QrInspection> query = _inspections;

        string search = (_search ?? string.Empty).Trim();
        if (!string.IsNullOrWhiteSpace(search))
        {
            query = query.Where(x =>
                ContainsIgnoreCase(x.Id, search)
                || ContainsIgnoreCase(x.Serial, search)
                || ContainsIgnoreCase(x.Line, search)
                || ContainsIgnoreCase(x.Model, search)
                || ContainsIgnoreCase(x.Lot, search)
                || x.NgItems.Any(item => ContainsIgnoreCase(item, search))
                || x.Row.Values.Any(value => ContainsIgnoreCase(value, search)));
        }

        if (!string.IsNullOrWhiteSpace(_lineFilter))
            query = query.Where(x => string.Equals(x.Line, _lineFilter, StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrWhiteSpace(_equipmentFilter))
        {
            query = query.Where(x =>
                string.Equals(x.RawEquipment, _equipmentFilter, StringComparison.OrdinalIgnoreCase)
                || string.Equals(x.Device, _equipmentFilter, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(_itemFilter))
        {
            query = query.Where(x =>
                x.Items.Any(item => string.Equals(item.Name, _itemFilter, StringComparison.OrdinalIgnoreCase))
                || x.NgItems.Any(item => string.Equals(item, _itemFilter, StringComparison.OrdinalIgnoreCase)));
        }

        if (_failOnly)
            query = query.Where(x => x.IsFail);

        return query.ToList();
    }

    private static List<QrDateGroup> GroupInspectionsByDate(IReadOnlyList<QrInspection> inspections) =>
        inspections
            .GroupBy(x => x.DateKey, StringComparer.Ordinal)
            .Select(g =>
            {
                List<QrInspection> rows = g.ToList();
                string label = rows.FirstOrDefault()?.DateLabel ?? "날짜 없음";
                string minTime = rows.Select(x => x.TimeOnly).Where(x => !string.IsNullOrWhiteSpace(x)).DefaultIfEmpty(string.Empty).Min() ?? string.Empty;
                string maxTime = rows.Select(x => x.TimeOnly).Where(x => !string.IsNullOrWhiteSpace(x)).DefaultIfEmpty(string.Empty).Max() ?? string.Empty;
                string range = string.IsNullOrWhiteSpace(minTime) || string.IsNullOrWhiteSpace(maxTime)
                    ? string.Empty
                    : minTime == maxTime ? minTime : $"{minTime} ~ {maxTime}";
                int fail = rows.Count(x => x.IsFail);

                return new QrDateGroup(
                    g.Key,
                    label,
                    rows,
                    rows.Count,
                    rows.Count - fail,
                    fail,
                    range);
            })
            .OrderByDescending(x => x.Key, StringComparer.Ordinal)
            .ToList();

    private static List<QrInspection> BuildInspections(QrBakoDataResult result)
    {
        var map = new QrColumnMap(result.Columns);
        var rows = new List<QrInspection>(result.Rows.Count);

        for (int i = 0; i < result.Rows.Count; i++)
        {
            rows.Add(BuildInspection(result.Rows[i], i, map));
        }

        return rows;
    }

    private static QrInspection BuildInspection(QrBakoDataRow row, int index, QrColumnMap map)
    {
        List<QrInspectionItem> items = BuildItems(row, map);
        string failText = map.FirstValue(row,
            "NG Item", "NGItem", "NG 항목", "NG항목", "Fail Item", "FailItem",
            "Fail Name", "FailName", "NG Name", "NGName", "NG Code", "NGCode");

        List<string> ngItems = ResolveNgItems(failText, items);
        string judge = map.FirstValue(row,
            "Result", "Judge", "Judgement", "Judgment", "Total Result", "Test Result",
            "판정", "OKNG", "PassFail", "Pass Fail");

        bool judgeFail = IsFailText(judge);
        bool itemFail = items.Any(x => x.IsFail);
        bool isFail = judgeFail || itemFail || ngItems.Count > 0;
        if (ngItems.Count == 0 && itemFail)
            ngItems = items.Where(x => x.IsFail).Select(x => x.Name).Distinct(StringComparer.OrdinalIgnoreCase).ToList();

        string id = FirstNonEmpty(
            map.FirstValue(row, "ID", "Id", "No", "Seq", "SEQ", "Index"),
            (index + 1).ToString(CultureInfo.InvariantCulture));

        string serial = map.FirstValue(row,
            "QR", "QR Code", "QRCode", "Serial", "Serial No", "SerialNo", "Barcode", "Barcode No", "BarcodeNo", "SN");

        string startTime = FirstNonEmpty(
            map.FirstValue(row, "Test Time", "TestTime", "Start Time", "StartTime", "시작시간", "Begin Time", "BeginTime", "Date Time", "DateTime"),
            map.Value(row, map.FindContaining("test", "time")));
        var dateParts = ResolveInspectionDate(startTime);

        string endTime = map.FirstValue(row, "End Time", "EndTime", "Finish Time", "FinishTime", "종료시간");
        string ngCountText = FirstNonEmpty(
            map.FirstValue(row, "NG Count", "NGCount", "NG건수", "Fail Count", "FailCount"),
            ngItems.Count.ToString(CultureInfo.InvariantCulture));

        return new QrInspection
        {
            Row = row,
            Key = $"{index}:{id}:{serial}:{startTime}",
            Id = id,
            Serial = serial,
            Channel = map.FirstValue(row, "CH", "Ch", "Channel"),
            Line = map.FirstValue(row, "Line", "LINE", "Line No", "LineNo", "생산 라인"),
            Version = map.FirstValue(row, "Version", "Ver", "VERSION", "SW Version", "SWVersion"),
            StartTime = startTime,
            DateKey = dateParts.Key,
            DateLabel = dateParts.Label,
            TimeOnly = dateParts.TimeOnly,
            EndTime = endTime,
            Judge = judge,
            Lot = map.FirstValue(row, "Lot", "LOT", "Lot No", "LotNo"),
            Plant = map.FirstValue(row, "Plant", "PLANT"),
            Model = map.FirstValue(row, "Model", "MODEL", "Model Name", "ModelName"),
            Device = map.FirstValue(row, "Instrument", "Tester", "Machine", "Equipment", "계측기", "Device"),
            RawEquipment = map.FirstValue(row, "설비(raw)", "Equipment Raw", "EquipmentRaw", "Raw Equipment", "RawEquipment", "Raw", "RAW"),
            Items = items,
            NgItems = ngItems,
            NgCountDisplay = ngCountText,
            IsFail = isFail,
        };
    }

    private static List<QrInspectionItem> BuildItems(QrBakoDataRow row, QrColumnMap map)
    {
        var items = new List<QrInspectionItem>();
        var used = new HashSet<int>();

        foreach (var definition in ItemDefinitions)
        {
            int? valueIndex = map.Find(definition.Aliases);
            valueIndex ??= map.FindValueColumn(definition.Aliases);
            int? statusIndex = map.FindStatusColumn(definition.Aliases);
            int? specIndex = map.FindSpecColumn(definition.Aliases);
            int? lowerIndex = map.FindLimitColumn(definition.Aliases, ["lsl", "lower", "low", "min"]);
            int? upperIndex = map.FindLimitColumn(definition.Aliases, ["usl", "upper", "high", "max"]);

            string value = FirstNonEmpty(map.Value(row, valueIndex), map.Value(row, statusIndex));
            string statusText = map.Value(row, statusIndex);
            string explicitSpec = map.Value(row, specIndex);
            string lower = map.Value(row, lowerIndex);
            string upper = map.Value(row, upperIndex);
            string spec = BuildSpecText(explicitSpec, lower, upper);

            if (string.IsNullOrWhiteSpace(value)
                && string.IsNullOrWhiteSpace(statusText)
                && string.IsNullOrWhiteSpace(spec))
                continue;

            QrItemState state = ClassifyItemState(FirstNonEmpty(statusText, value));
            items.Add(new QrInspectionItem(
                definition.Name,
                value,
                spec,
                state));

            AddIfPresent(used, valueIndex);
            AddIfPresent(used, statusIndex);
            AddIfPresent(used, specIndex);
            AddIfPresent(used, lowerIndex);
            AddIfPresent(used, upperIndex);
        }

        foreach (int columnIndex in map.ColumnIndexes)
        {
            if (used.Contains(columnIndex) || map.IsMetadataColumn(columnIndex))
                continue;

            string columnName = map.Columns[columnIndex].Name;
            string value = map.Value(row, columnIndex);
            if (string.IsNullOrWhiteSpace(value) || !LooksLikeInspectionItem(columnName, value))
                continue;

            QrItemState state = ClassifyItemState(value);
            items.Add(new QrInspectionItem(TrimItemName(columnName), value, string.Empty, state));
            used.Add(columnIndex);
        }

        return items
            .GroupBy(x => x.Name, StringComparer.OrdinalIgnoreCase)
            .Select(g => g.First())
            .ToList();
    }

    private IReadOnlyList<string> LineOptions() =>
        _inspections
            .Select(x => x.Line)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
