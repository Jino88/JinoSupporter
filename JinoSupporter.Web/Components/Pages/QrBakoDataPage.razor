    private async Task ExportCsvAsync()
    {
        if (_exporting || _result is null || _result.Columns.Count == 0) return;

        _exporting = true;
        _error = string.Empty;
        StateHasChanged();

        try
        {
            var rows = new List<IEnumerable<string?>>();
            rows.Add(_result.Columns.Select(c => c.Name));
            rows.AddRange(FilterInspections().Select(r => r.Row.Values.Select(v => (string?)v)));

            byte[] bytes = CsvExportUtility.Build(rows);
            string fileName = $"QR_BAKO_DATA_BKTD_{DateTime.Now:yyyyMMdd_HHmmss}.csv";
            await BrowserDownload.DownloadBytesAsync(JS, fileName, bytes, CsvExportUtility.ContentType);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _exporting = false;
            StateHasChanged();
        }
    }

    private static List<string> ResolveNgItems(string failText, IReadOnlyList<QrInspectionItem> items)
    {
        var result = new List<string>();
        string normalizedFailText = NormalizeColumnName(failText);

        if (!string.IsNullOrWhiteSpace(normalizedFailText))
        {
            foreach (var definition in ItemDefinitions)
            {
                if (definition.Aliases.Any(alias => normalizedFailText.Contains(NormalizeColumnName(alias), StringComparison.OrdinalIgnoreCase)))
                    result.Add(definition.Name);
            }

            if (result.Count == 0)
            {
                result.AddRange(failText
                    .Split([',', ';', '/', '|', '\r', '\n', '\t'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                    .Where(x => !string.Equals(x, "-", StringComparison.OrdinalIgnoreCase)));
            }
        }

        result.AddRange(items.Where(x => x.IsFail).Select(x => x.Name));

        return result
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private static string BuildSpecText(string explicitSpec, string lower, string upper)
    {
        if (!string.IsNullOrWhiteSpace(lower) || !string.IsNullOrWhiteSpace(upper))
            return $"spec {DisplayOrDash(lower)} ~ {DisplayOrDash(upper)}";

        if (string.IsNullOrWhiteSpace(explicitSpec))
            return string.Empty;

        string spec = explicitSpec.Trim();
        return spec.StartsWith("spec", StringComparison.OrdinalIgnoreCase) ? spec : $"spec {spec}";
    }

    private static QrItemState ClassifyItemState(string value)
    {
        if (IsFailText(value)) return QrItemState.Fail;
        if (IsPassText(value)) return QrItemState.Pass;
        return QrItemState.Unknown;
    }

    private static bool IsFailText(string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return false;
        string text = value.Trim();
        return text.Contains("FAIL", StringComparison.OrdinalIgnoreCase)
            || text.Equals("NG", StringComparison.OrdinalIgnoreCase)
            || text.Contains(" NG", StringComparison.OrdinalIgnoreCase)
            || text.Contains("N/G", StringComparison.OrdinalIgnoreCase)
            || text.Contains("REJECT", StringComparison.OrdinalIgnoreCase)
            || text.Contains("불량", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsPassText(string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return false;
        string text = value.Trim();
        return text.Contains("PASS", StringComparison.OrdinalIgnoreCase)
            || text.Equals("OK", StringComparison.OrdinalIgnoreCase)
            || text.Contains(" OK", StringComparison.OrdinalIgnoreCase)
            || text.Contains("GOOD", StringComparison.OrdinalIgnoreCase)
            || text.Contains("양품", StringComparison.OrdinalIgnoreCase);
    }

    private static bool LooksLikeInspectionItem(string columnName, string value)
    {
        string normalized = NormalizeColumnName(columnName);
        if (normalized.Length == 0)
            return false;

        if (normalized.Contains("spec", StringComparison.OrdinalIgnoreCase)
            || normalized.Contains("time", StringComparison.OrdinalIgnoreCase)
            || normalized.Contains("date", StringComparison.OrdinalIgnoreCase)
            || normalized.Contains("serial", StringComparison.OrdinalIgnoreCase)
            || normalized.Contains("barcode", StringComparison.OrdinalIgnoreCase)
            || normalized.Contains("version", StringComparison.OrdinalIgnoreCase))
            return false;

        if (IsPassText(value) || IsFailText(value))
            return true;

        return value.Any(char.IsDigit)
            && normalized.Length <= 24
            && !normalized.Contains("count", StringComparison.OrdinalIgnoreCase);
    }

    private static string TrimItemName(string columnName)
    {
        string name = columnName.Trim();
        foreach (string suffix in new[] { " Value", "_Value", " Result", "_Result", " Judge", "_Judge" })
        {
            if (name.EndsWith(suffix, StringComparison.OrdinalIgnoreCase))
                return name[..^suffix.Length].Trim();
        }

        return name;
    }

    private static void AddIfPresent(HashSet<int> set, int? index)
    {
        if (index is int i)
            set.Add(i);
    }

    private static bool ContainsIgnoreCase(string value, string query) =>
        !string.IsNullOrWhiteSpace(value)
        && value.Contains(query, StringComparison.OrdinalIgnoreCase);

    private static string FirstNonEmpty(params string[] values) =>
        values.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x))?.Trim() ?? string.Empty;

    private static string FormatNumber(int value) => value.ToString("N0", CultureInfo.CurrentCulture);

    private static string FormatPercent(double value) => value.ToString("P1", CultureInfo.CurrentCulture);

    private static string DisplayOrDash(string value) =>
        string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();

    private static (string Key, string Label, string TimeOnly) ResolveInspectionDate(string value)
    {
        string text = value?.Trim() ?? string.Empty;
        if (DateTime.TryParse(text, CultureInfo.CurrentCulture, DateTimeStyles.AssumeLocal, out DateTime current)
            || DateTime.TryParse(text, CultureInfo.InvariantCulture, DateTimeStyles.AssumeLocal, out current))
        {
            return (
                current.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
                current.ToString("yyyy-MM-dd (ddd)", CultureInfo.CurrentCulture),
                current.ToString("HH:mm:ss", CultureInfo.InvariantCulture));
        }

        if (text.Length >= 10)
        {
            string dateText = text[..10].Replace('/', '-').Replace('.', '-');
            if (DateTime.TryParseExact(dateText, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out DateTime date))
            {
                string timeOnly = text.Length >= 19 ? text.Substring(11, 8) : string.Empty;
                return (
                    date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
                    date.ToString("yyyy-MM-dd (ddd)", CultureInfo.CurrentCulture),
                    timeOnly);
            }
        }

        return ("0000-00-00", "날짜 없음", string.Empty);
    }

    private static string ParetoStyle(int count, int max)
    {
        double pct = max <= 0 ? 0 : Math.Clamp(count / (double)max, 0.03, 1.0);
        return $"--bar-height:{(pct * 9.2).ToString("0.###", CultureInfo.InvariantCulture)}rem;";
    }

    private static IEnumerable<string> ParetoItemsFor(QrInspection inspection) =>
        inspection.NgItems.Count == 0 && inspection.IsFail
            ? new[] { "미분류" }
            : inspection.NgItems;

    private static string NormalizeColumnName(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return string.Empty;

        return new string(value
            .Where(char.IsLetterOrDigit)
            .Select(char.ToLowerInvariant)
            .ToArray());
    }

    private sealed class QrColumnMap
    {
        private static readonly string[] MetadataNames =
        [
            "id", "no", "seq", "index", "qr", "qrcode", "serial", "serialno", "barcode", "barcodeno", "sn",
            "ch", "channel", "line", "lineno", "version", "ver", "testtime", "starttime", "begintime",
            "datetime", "endtime", "finishtime", "result", "judge", "judgement", "judgment", "totalresult",
            "testresult", "okng", "passfail", "ngitem", "failitem", "ngname", "failname", "ngcode",
            "failcode", "ngcount", "failcount", "lot", "lotno", "plant", "model", "modelname",
            "instrument", "tester", "machine", "equipment", "device", "raw", "equipmentraw", "rawequipment"
        ];

        private readonly Dictionary<string, int> _exact = new(StringComparer.OrdinalIgnoreCase);
        private readonly HashSet<string> _metadata = new(MetadataNames, StringComparer.OrdinalIgnoreCase);

        public QrColumnMap(IReadOnlyList<QrBakoDataColumn> columns)
        {
            Columns = columns;
            for (int i = 0; i < columns.Count; i++)
            {
                string key = NormalizeColumnName(columns[i].Name);
                if (!string.IsNullOrWhiteSpace(key) && !_exact.ContainsKey(key))
                    _exact.Add(key, i);
            }
        }

        public IReadOnlyList<QrBakoDataColumn> Columns { get; }

        public IEnumerable<int> ColumnIndexes => Enumerable.Range(0, Columns.Count);

        public int? Find(params string[] candidates)
        {
            foreach (string candidate in candidates)
            {
                string key = NormalizeColumnName(candidate);
                if (!string.IsNullOrWhiteSpace(key) && _exact.TryGetValue(key, out int index))
                    return index;
            }

            return null;
        }

        public int? FindContaining(params string[] tokens)
        {
            string[] normalizedTokens = tokens
                .Select(NormalizeColumnName)
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .ToArray();

            if (normalizedTokens.Length == 0)
                return null;

            for (int i = 0; i < Columns.Count; i++)
            {
                string name = NormalizeColumnName(Columns[i].Name);
                if (normalizedTokens.All(token => name.Contains(token, StringComparison.OrdinalIgnoreCase)))
                    return i;
            }

            return null;
        }

        public int? FindValueColumn(IReadOnlyList<string> aliases) =>
            FindColumnByAliasAndSuffix(aliases, ["value", "val", "data", "measure", "meas"]);

        public int? FindStatusColumn(IReadOnlyList<string> aliases) =>
            FindColumnByAliasAndSuffix(aliases, ["judge", "judgement", "judgment", "result", "status", "okng", "passfail"]);

        public int? FindSpecColumn(IReadOnlyList<string> aliases) =>
            FindColumnByAliasAndSuffix(aliases, ["spec", "std", "standard"]);

        public int? FindLimitColumn(IReadOnlyList<string> aliases, IReadOnlyList<string> suffixes) =>
            FindColumnByAliasAndSuffix(aliases, suffixes);

        public string FirstValue(QrBakoDataRow row, params string[] aliases) =>
            Value(row, Find(aliases));

        public string Value(QrBakoDataRow row, int? index)
        {
            if (index is not int i || i < 0 || i >= row.Values.Count)
                return string.Empty;

            return row.Values[i]?.Trim() ?? string.Empty;
        }

        public bool IsMetadataColumn(int index)
        {
            if (index < 0 || index >= Columns.Count)
                return true;

            string normalized = NormalizeColumnName(Columns[index].Name);
            return _metadata.Contains(normalized)
                || normalized.Contains("time", StringComparison.OrdinalIgnoreCase)
                || normalized.Contains("date", StringComparison.OrdinalIgnoreCase);
        }

        private int? FindColumnByAliasAndSuffix(IReadOnlyList<string> aliases, IReadOnlyList<string> suffixes)
        {
            foreach (string alias in aliases)
            {
                string normalizedAlias = NormalizeColumnName(alias);
                if (string.IsNullOrWhiteSpace(normalizedAlias))
                    continue;

                foreach (string suffix in suffixes)
                {
                    string normalizedSuffix = NormalizeColumnName(suffix);
                    foreach (var pair in _exact)
                    {
                        string name = pair.Key;
                        if (name == normalizedAlias + normalizedSuffix
                            || name == normalizedSuffix + normalizedAlias
                            || (name.Contains(normalizedAlias, StringComparison.OrdinalIgnoreCase)
                                && name.Contains(normalizedSuffix, StringComparison.OrdinalIgnoreCase)))
                            return pair.Value;
                    }
                }
            }

            return null;
        }
    }

    private sealed record QrItemDefinition(string Name, string[] Aliases);

    private sealed record QrInspectionItem(string Name, string Value, string Spec, QrItemState State)
    {
        public bool IsFail => State == QrItemState.Fail;
        public bool IsPass => State == QrItemState.Pass;
        public string StatusLabel => State switch
        {
            QrItemState.Fail => "NG",
            QrItemState.Pass => "OK",
            _ => "-",
        };
    }

