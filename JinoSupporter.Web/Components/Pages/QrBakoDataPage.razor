@page "/bmes/qr-bako-data"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Globalization
@using JinoSupporter.Web.Services
@inject QrBakoDataService QrBakoData
@inject IJSRuntime JS

<PageTitle>QR BAKO DATA</PageTitle>

@{
    var dashboard = BuildDashboard();
}

<div class="qr-dashboard">
    <div class="qr-titlebar">
        <div>
            <div class="qr-kicker"><span class="qr-live-dot"></span>BAKO 검사결과 · DB 접수 DATA</div>
            <h1>BAKO 검사결과 대시보드</h1>
            <div class="qr-subtitle">FAIL 조회 · QR 추적 · 항목별 Pareto</div>
        </div>
        <div class="qr-actions">
            <span class="qr-connection">@ConnectionLabel</span>
            <button class="qr-btn primary"
                    @onclick="LoadAsync"
                    disabled="@(_busy || !QrBakoData.IsConfigured)">
                @if (_busy)
                {
                    <span class="qr-spinner"></span>
                    <span>Loading</span>
                }
                else
                {
                    <span>Refresh</span>
                }
            </button>
            <button class="qr-btn"
                    @onclick="ExportCsvAsync"
                    disabled="@(_busy || _exporting || _result is null || _result.Columns.Count == 0)">
                @if (_exporting)
                {
                    <span class="qr-spinner"></span>
                    <span>Exporting</span>
                }
                else
                {
                    <span>CSV</span>
                }
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="qr-alert danger">@_error</div>
    }

    @if (_result is not null && !string.IsNullOrWhiteSpace(_result.WarningMessage))
    {
        <div class="qr-alert warning">@_result.WarningMessage</div>
    }

    @if (!QrBakoData.IsConfigured)
    {
        <div class="qr-alert warning">
            QR BAKO DB password is not configured on the server.
        </div>
    }

    @if (_busy && _result is null)
    {
        <div class="qr-panel qr-loading">
            <span class="qr-spinner"></span>
            <span>TCDB.dbo.BKTD 로딩 중...</span>
        </div>
    }
    else if (_result is null)
    {
        <div class="qr-panel qr-empty">조회된 데이터가 없습니다.</div>
    }
    else if (_result.Columns.Count == 0)
    {
        <div class="qr-panel qr-empty">쿼리 결과 컬럼이 없습니다.</div>
    }
    else
    {
        <div class="qr-kpi-grid">
            <div class="qr-kpi">
                <span>TOTAL</span>
                <strong>@FormatNumber(dashboard.Total)</strong>
                <small>표시 검사건수</small>
            </div>
            <div class="qr-kpi good">
                <span>PASS</span>
                <strong>@FormatNumber(dashboard.Pass)</strong>
                <small>@FormatPercent(dashboard.PassRate) PASS율</small>
            </div>
            <div class="qr-kpi bad">
                <span>FAIL</span>
                <strong>@FormatNumber(dashboard.Fail)</strong>
                <small>@FormatPercent(dashboard.FailRate) FAIL율</small>
            </div>
            <div class="qr-kpi danger">
                <span>불량률</span>
                <strong>@FormatPercent(dashboard.FailRate)</strong>
                <small>@FormatNumber(dashboard.Fail) / @FormatNumber(dashboard.Total)건</small>
            </div>
            <div class="qr-kpi">
                <span>UNIQUE QR</span>
                <strong>@FormatNumber(dashboard.UniqueQr)</strong>
                <small>고유 시리얼</small>
            </div>
            <div class="qr-kpi">
                <span>LINE</span>
                <strong>@DisplayOrDash(dashboard.TopLine)</strong>
                <small>최다 생산 라인</small>
            </div>
            <div class="qr-kpi bad">
                <span>TOP NG ITEM</span>
                <strong>@DisplayOrDash(dashboard.TopNgItem)</strong>
                <small>@dashboard.TopNgItemCount.ToString("N0")건 NG</small>
            </div>
        </div>

        <section class="qr-panel">
            <div class="qr-panel-head">
                <h2>검사항목 NG Pareto</h2>
                <div>결과별 등록 @dashboard.ParetoItems.Count.ToString("N0")개 · NG 상위순 정렬</div>
            </div>
            <div class="qr-pareto">
                @if (dashboard.ParetoItems.Count == 0)
                {
                    <div class="qr-empty mini">NG 항목이 없습니다.</div>
                }
                else
                {
                    @foreach (var item in dashboard.ParetoItems)
                    {
                        <div class="qr-pareto-row" title="@($"{item.Name}: {item.Count:N0}건")">
                            <div class="qr-pareto-bar" style="@ParetoStyle(item.Count, dashboard.MaxParetoCount)">
                                <span>@item.Count.ToString("N0")</span>
                            </div>
                            <div class="qr-pareto-label">@item.Name</div>
                        </div>
                    }
                }
            </div>
        </section>

        <section class="qr-panel">
            <div class="qr-panel-head">
                <h2>검사 이력</h2>
                <div>행 클릭 시 검사 상세를 펼칩니다.</div>
            </div>

            <div class="qr-filterbar">
                <input class="qr-input"
                       placeholder="QR / 시리얼 검색..."
                       @bind="_search"
                       @bind:event="oninput" />

                <select class="qr-input select" @bind="_lineFilter">
                    <option value="">전체 Line</option>
                    @foreach (var line in LineOptions())
                    {
                        <option value="@line">@line</option>
                    }
                </select>

                <select class="qr-input select wide" @bind="_equipmentFilter">
                    <option value="">전체 설비(raw)</option>
                    @foreach (var eq in EquipmentOptions())
                    {
                        <option value="@eq">@eq</option>
                    }
                </select>

                <select class="qr-input select wide" @bind="_itemFilter">
                    <option value="">전체 항목</option>
                    @foreach (var item in ItemOptions())
                    {
                        <option value="@item">@item</option>
                    }
                </select>

                <label class="qr-check">
                    <input type="checkbox" @bind="_failOnly" />
                    <span>FAIL만 보기</span>
                </label>

                <button class="qr-btn ghost" type="button" @onclick="ClearFilters">필터 초기화</button>

                <div class="qr-filter-summary">
                    @FormatNumber(dashboard.Total)건 표시 중
                    @if (_result.TotalRows is not null)
                    {
                        <span>· DB total @_result.TotalRows.Value.ToString("N0")</span>
                    }
                    @if (_result.HitMaxRows)
                    {
                        <span>· Max rows 제한</span>
                    }
                </div>
            </div>

            <div class="qr-history-wrap">
                <table class="qr-history">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>QR / 시리얼</th>
                            <th>CH</th>
                            <th>LINE</th>
                            <th>VERSION</th>
                            <th>시작시간</th>
                            <th>판정</th>
                            <th>NG건수</th>
                            <th>NG 항목</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (dashboard.Inspections.Count == 0)
                        {
                            <tr>
                                <td colspan="9" class="qr-no-row">조건에 맞는 검사 이력이 없습니다.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var dateGroup in GroupInspectionsByDate(dashboard.Inspections))
                            {
                                bool dateExpanded = _expandedDateKeys.Contains(dateGroup.Key);
                                <tr class="qr-date-row" @onclick="() => ToggleDateGroup(dateGroup.Key)">
                                    <td colspan="9">
                                        <span class="qr-caret">@(dateExpanded ? "▾" : "▸")</span>
                                        <strong>@dateGroup.Label</strong>
                                        <span>@dateGroup.Total.ToString("N0")건</span>
                                        <span class="qr-date-pass">PASS @dateGroup.Pass.ToString("N0")</span>
                                        <span class="qr-date-fail">FAIL @dateGroup.Fail.ToString("N0")</span>
                                        @if (!string.IsNullOrWhiteSpace(dateGroup.TimeRange))
                                        {
                                            <em>@dateGroup.TimeRange</em>
                                        }
                                    </td>
                                </tr>

                                @if (dateExpanded)
                                {
                                    @foreach (var inspection in dateGroup.Inspections)
                                    {
                                        bool expanded = _expandedKeys.Contains(inspection.Key);
                                        <tr class="qr-inspection-row @(inspection.IsFail ? "fail-row" : "pass-row")"
                                            @onclick="() => ToggleInspection(inspection.Key)">
                                            <td><span class="qr-caret">@(expanded ? "▾" : "▸")</span>@inspection.Id</td>
                                            <td class="qr-serial">@DisplayOrDash(inspection.Serial)</td>
                                            <td>@DisplayOrDash(inspection.Channel)</td>
                                            <td><span class="qr-line-pill">@DisplayOrDash(inspection.Line)</span></td>
                                            <td>@DisplayOrDash(inspection.Version)</td>
                                            <td>@DisplayOrDash(inspection.StartTime)</td>
                                            <td><span class="qr-result @(inspection.IsFail ? "bad" : "good")">@inspection.ResultLabel</span></td>
                                            <td>@inspection.NgCountDisplay</td>
                                            <td>
                                                @if (inspection.NgItems.Count == 0)
                                                {
                                                    <span class="qr-muted">-</span>
                                                }
                                                else
                                                {
                                                    <span class="qr-ng-chip">@string.Join(", ", inspection.NgItems)</span>
                                                }
                                            </td>
                                        </tr>
                                        @if (expanded)
                                        {
                                            <tr class="qr-detail-row">
                                                <td colspan="9">
                                                    <div class="qr-detail-meta">
                                                        <span><b>종료시간</b> @DisplayOrDash(inspection.EndTime)</span>
                                                        <span><b>총평가항목</b> @inspection.Items.Count.ToString("N0")</span>
                                                        <span><b>Lot</b> @DisplayOrDash(inspection.Lot)</span>
                                                        <span><b>Plant</b> @DisplayOrDash(inspection.Plant)</span>
                                                        <span><b>Model</b> @DisplayOrDash(inspection.Model)</span>
                                                        <span><b>계측기</b> @DisplayOrDash(inspection.Device)</span>
                                                        <span><b>설비(raw)</b> @DisplayOrDash(inspection.RawEquipment)</span>
                                                    </div>

                                                    <div class="qr-item-grid">
                                                        @if (inspection.Items.Count == 0)
                                                        {
                                                            <div class="qr-empty mini">표시할 검사항목 컬럼을 찾지 못했습니다.</div>
                                                        }
                                                        else
                                                        {
                                                            @foreach (var item in inspection.Items)
                                                            {
                                                                <div class="qr-item-card @(item.IsFail ? "fail" : item.IsPass ? "pass" : "")">
                                                                    <div class="qr-item-head">
                                                                        <span>@item.Name</span>
                                                                        <em>@item.StatusLabel</em>
                                                                    </div>
                                                                    <strong>@DisplayOrDash(item.Value)</strong>
                                                                    @if (!string.IsNullOrWhiteSpace(item.Spec))
                                                                    {
                                                                        <small>@item.Spec</small>
                                                                    }
                                                                </div>
                                                            }
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>

<style>
    .qr-dashboard {
        min-height: calc(100vh - 1.5rem);
        margin: -0.25rem -0.5rem 0;
        padding: 0.85rem 1rem 1.4rem;
        background: #090d14;
        color: #e5edf8;
        font-family: "Segoe UI", Arial, sans-serif;
    }

    .qr-titlebar {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.15rem;
    }

    .qr-kicker {
        color: #ff6b63;
        font-family: Consolas, "Courier New", monospace;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0;
        text-transform: uppercase;
    }

    .qr-live-dot {
        display: inline-block;
        width: 0.45rem;
        height: 0.45rem;
        margin-right: 0.42rem;
        border-radius: 50%;
        background: #42e18a;
        vertical-align: 0.05rem;
    }

    .qr-titlebar h1 {
        margin: 0.62rem 0 0;
        color: #eef4ff;
        font-size: 1.35rem;
        font-weight: 800;
        letter-spacing: 0;
        line-height: 1.1;
    }

    .qr-subtitle {
        margin-top: 0.2rem;
        color: var(--ink-3, #7f8a98);
        font-size: 0.82rem;
        font-weight: 600;
    }

    .qr-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.55rem;
        flex-wrap: wrap;
    }

    .qr-connection {
        color: #7890ad;
        font-family: Consolas, "Courier New", monospace;
        font-size: 0.72rem;
    }

    .qr-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
        min-height: 2rem;
        padding: 0.38rem 0.72rem;
        border: 1px solid #273449;
        border-radius: 2px;
        background: #121a27;
        color: #d8e4f6;
        font-size: 0.78rem;
        font-weight: 700;
        line-height: 1;
    }

    .qr-btn:hover:not(:disabled) {
        border-color: #3b82f6;
        color: var(--panel, var(--panel, #fff));
    }

    .qr-btn.primary {
        border-color: #3b82f6;
        background: #1d4ed8;
        color: var(--panel, var(--panel, #fff));
    }

    .qr-btn.ghost {
        background: #0e1520;
        color: #7e91ac;
    }

    .qr-btn:disabled {
        cursor: not-allowed;
        opacity: 0.52;
    }

    .qr-spinner {
        display: inline-block;
        width: 0.8rem;
        height: 0.8rem;
        border: 2px solid rgba(255, 255, 255, 0.32);
        border-top-color: var(--panel, var(--panel, #fff));
        border-radius: 50%;
        animation: qr-spin 0.75s linear infinite;
    }

    @@keyframes qr-spin {
        to { transform: rotate(360deg); }
    }

    .qr-alert {
        margin-bottom: 0.75rem;
        padding: 0.65rem 0.78rem;
        border: 1px solid #34445c;
        border-radius: 2px;
        background: var(--ink, #0f1319);
        color: var(--line-2, #c6ccd5);
        font-size: 0.82rem;
    }

    .qr-alert.danger {
        border-color: #7f1d1d;
        background: #1c1014;
        color: #fecaca;
    }

    .qr-alert.warning {
        border-color: #92400e;
        background: #1f1a10;
        color: #fde68a;
    }

    .qr-panel {
        margin-top: 1rem;
        border: 1px solid #253246;
        border-radius: 2px;
        background: #0d131d;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.02);
    }

    .qr-loading,
    .qr-empty {
        padding: 1.1rem;
        color: #93a4bb;
        font-size: 0.86rem;
    }

    .qr-empty.mini {
        padding: 0.85rem;
        color: #71829a;
        font-size: 0.78rem;
    }

    .qr-kpi-grid {
        display: grid;
        grid-template-columns: repeat(7, minmax(0, 1fr));
        gap: 0.68rem;
    }

    .qr-kpi {
        min-width: 0;
        min-height: 5rem;
        padding: 0.85rem 0.92rem;
        border: 1px solid #243145;
        border-radius: 2px;
        background: #0d121b;
    }

    .qr-kpi.danger {
        border-color: #6f272b;
        background: #171014;
    }

    .qr-kpi span {
        display: block;
        color: var(--ink-2, #4a5461);
        font-family: Consolas, "Courier New", monospace;
        font-size: 0.62rem;
        font-weight: 700;
        text-transform: uppercase;
    }

    .qr-kpi strong {
        display: block;
        margin-top: 0.42rem;
        overflow: hidden;
        color: var(--panel-2, #f5f6f9);
        font-family: Consolas, "Courier New", monospace;
        font-size: clamp(1.18rem, 1.9vw, 1.7rem);
        font-weight: 800;
        line-height: 1.05;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .qr-kpi.good strong {
        color: #48dd8c;
    }

    .qr-kpi.bad strong,
    .qr-kpi.danger strong {
        color: #ff645e;
    }

    .qr-kpi small {
        display: block;
        margin-top: 0.32rem;
        overflow: hidden;
        color: #71829a;
        font-size: 0.68rem;
        font-weight: 700;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .qr-panel-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1rem 1.1rem 0.65rem;
    }

    .qr-panel-head h2 {
        margin: 0;
        color: var(--panel-2, #f5f6f9);
        font-size: 0.9rem;
        font-weight: 800;
        letter-spacing: 0;
    }

    .qr-panel-head div {
        color: #70839d;
        font-size: 0.72rem;
        font-weight: 700;
    }

    .qr-pareto {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(4.75rem, 1fr));
        align-items: end;
        gap: 0.8rem;
        min-height: 12.4rem;
        padding: 0.6rem 1.15rem 1rem;
        background-image:
            linear-gradient(to top, rgba(148, 163, 184, 0.09) 1px, transparent 1px);
        background-size: 100% 25%;
        background-position: 0 0.6rem;
    }

    .qr-pareto-row {
        display: grid;
        grid-template-rows: 9.7rem 1.2rem;
        min-width: 0;
        align-items: end;
    }

    .qr-pareto-bar {
        position: relative;
        width: 52%;
        min-height: 0.15rem;
        height: var(--bar-height);
        margin: 0 auto;
        border-radius: 2px 2px 0 0;
        background: rgba(208, 86, 78, 0.55);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1);
    }

    .qr-pareto-row:first-child .qr-pareto-bar {
        background: #d95d55;
    }

    .qr-pareto-bar span {
        position: absolute;
        left: 50%;
        bottom: calc(100% + 0.25rem);
        color: #72849e;
        font-family: Consolas, "Courier New", monospace;
        font-size: 0.62rem;
        font-weight: 700;
        transform: translateX(-50%);
    }

    .qr-pareto-label {
        overflow: hidden;
        color: #92a1b5;
        font-family: Consolas, "Courier New", monospace;
        font-size: 0.66rem;
        font-weight: 700;
        text-align: center;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .qr-filterbar {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        flex-wrap: wrap;
        padding: 0 1.1rem 0.8rem;
    }

    .qr-input {
        height: 2rem;
        min-width: 14rem;
        padding: 0.36rem 0.7rem;
        border: 1px solid #263449;
        border-radius: 2px;
        background: #151f2d;
        color: #dbe8f9;
        font-size: 0.78rem;
        outline: none;
    }

    .qr-input:focus {
        border-color: #3b82f6;
    }

    .qr-input.select {
        min-width: 7.2rem;
    }

    .qr-input.select.wide {
        min-width: 11.6rem;
    }

    .qr-check {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        min-height: 2rem;
        padding: 0 0.75rem;
        border: 1px solid #263449;
        border-radius: 2px;
        background: #101827;
        color: #d6e2f3;
        font-size: 0.78rem;
        font-weight: 700;
    }

    .qr-check input {
        accent-color: #647a96;
    }

    .qr-filter-summary {
        margin-left: auto;
        color: #dce8f8;
        font-family: Consolas, "Courier New", monospace;
        font-size: 0.72rem;
        font-weight: 800;
    }

    .qr-history-wrap {
        overflow: auto;
        max-height: calc(100vh - 28rem);
        min-height: 18rem;
        padding: 0 1.1rem 1rem;
    }

    .qr-history {
        width: 100%;
        border-collapse: collapse;
        font-family: Consolas, "Courier New", monospace;
        font-size: 0.78rem;
        table-layout: fixed;
    }

    .qr-history th {
        position: sticky;
        top: 0;
        z-index: 2;
        padding: 0.58rem 0.65rem;
        border-bottom: 1px solid #273449;
        background: #0d131d;
        color: #657791;
        font-size: 0.62rem;
        font-weight: 800;
        text-align: left;
        text-transform: uppercase;
    }

    .qr-history td {
        overflow: hidden;
        padding: 0.58rem 0.65rem;
        border-bottom: 1px solid #1c2736;
        color: #eef4ff;
        text-overflow: ellipsis;
        vertical-align: middle;
        white-space: nowrap;
    }

    .qr-history th:nth-child(1) { width: 8%; }
    .qr-history th:nth-child(2) { width: 22%; }
    .qr-history th:nth-child(3) { width: 5%; }
    .qr-history th:nth-child(4) { width: 7%; }
    .qr-history th:nth-child(5) { width: 9%; }
    .qr-history th:nth-child(6) { width: 18%; }
    .qr-history th:nth-child(7) { width: 9%; }
    .qr-history th:nth-child(8) { width: 8%; }
    .qr-history th:nth-child(9) { width: 14%; }

    .qr-inspection-row {
        cursor: pointer;
    }

    .qr-inspection-row.fail-row td {
        background: rgba(66, 31, 42, 0.34);
    }

    .qr-inspection-row.pass-row td {
        background: rgba(10, 18, 28, 0.82);
    }

    .qr-inspection-row:hover td {
        background: #152131;
    }

    .qr-caret {
        display: inline-block;
        width: 0.9rem;
        color: #6d7f98;
    }

    .qr-serial {
        color: var(--panel, var(--panel, #fff)) !important;
        font-weight: 800;
    }

    .qr-line-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 1.75rem;
        padding: 0.12rem 0.38rem;
        border-radius: 2px;
        background: #1f3762;
        color: #b9d4ff;
        font-weight: 800;
    }

    .qr-result,
    .qr-ng-chip {
