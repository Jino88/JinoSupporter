    private MaterialEditState GetOrCreateMaterialEdit(MaterialAssignment assignment)
    {
        if (_materialEdits.TryGetValue(assignment.Key, out var edit))
            return edit;

        edit = new MaterialEditState
        {
            ProcessGroupKey = assignment.SavedProcessGroupKey,
            UsageQtyText = assignment.UsageQty.ToString("0.######", CultureInfo.InvariantCulture),
            UsageUnit = assignment.UsageUnit,
        };
        _materialEdits[assignment.Key] = edit;
        return edit;
    }

    private bool CanSaveMaterialAssignment(MaterialAssignment assignment)
    {
        string processGroupKey = GetMaterialProcessValue(assignment);
        return GetMaterialProcessRows(assignment, OrderedProcessRows)
                   .Any(r => string.Equals(r.GroupKey, processGroupKey, StringComparison.OrdinalIgnoreCase)) &&
               TryParseUsageQty(GetMaterialUsageQtyText(assignment), out decimal usageQty) &&
               usageQty > 0 &&
               !string.IsNullOrWhiteSpace(GetMaterialUsageUnit(assignment));
    }

    private Task SaveMaterialAssignmentAsync(MaterialAssignment assignment)
    {
        string processGroupKey = GetMaterialProcessValue(assignment);
        var processRow = GetMaterialProcessRows(assignment, OrderedProcessRows).FirstOrDefault(r =>
            string.Equals(r.GroupKey, processGroupKey, StringComparison.OrdinalIgnoreCase));
        if (processRow is null)
        {
            SetStatus("최초 투입 공정을 선택하세요.", true);
            return Task.CompletedTask;
        }

        if (!TryParseUsageQty(GetMaterialUsageQtyText(assignment), out decimal usageQty) || usageQty <= 0)
        {
            SetStatus("자재 사용량은 0보다 큰 숫자로 입력하세요.", true);
            return Task.CompletedTask;
        }

        string usageUnit = GetMaterialUsageUnit(assignment).Trim();
        if (usageUnit.Length == 0)
        {
            SetStatus("자재 단위를 입력하세요.", true);
            return Task.CompletedTask;
        }

        try
        {
            var targetMappings = processRow.LinkedProcesses
                .Select(targetProcess => new
                {
                    Process = targetProcess,
                    Material = ResolveMaterialForTargetProcess(assignment.Material, targetProcess),
                })
                .Where(target => target.Material is not null)
                .GroupBy(target => BuildLocalMappingKey(target.Process, target.Material!), StringComparer.OrdinalIgnoreCase)
                .Select(group => group.First())
                .ToList();
            if (targetMappings.Count == 0)
            {
                SetStatus("선택한 공정에 연결할 BOM 자재를 찾지 못했습니다.", true);
                return Task.CompletedTask;
            }

            DeleteMaterialMappingsForCurrentModel(assignment);

            int saved = 0;
            foreach (var target in targetMappings)
            {
                var edit = BuildMappingEdit(target.Process, target.Material!, assignment.Material);
                edit.UsageQty = usageQty;
                edit.UsageUnit = usageUnit;
                edit.Note = $"First input #{GetProcessNo(processRow)}; applies through final process";
                MappingService.Upsert(edit);
                saved++;
            }

            _rows = MappingService.GetAll();
            _materialEdits.Remove(assignment.Key);
            Activity.Log(
                "Test 3",
                $"Save first-input material={assignment.RawMaterialCode}, process={processRow.Process.ProcessName}, linkedRows={saved:N0}");
            SetStatus(
                saved > 0
                    ? $"{assignment.RawMaterialName}의 최초 투입 공정을 저장했습니다. 이후 마지막 공정까지 자동 적용됩니다."
                    : "저장할 연결 공정을 찾지 못했습니다.",
                saved == 0);
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, true);
        }

        return Task.CompletedTask;
    }

    private Task ClearMaterialAssignmentAsync(MaterialAssignment assignment)
    {
        try
        {
            int removed = DeleteMaterialMappingsForCurrentModel(assignment);
            _rows = MappingService.GetAll();
            _materialEdits.Remove(assignment.Key);
            Activity.Log("Test 3", $"Clear first-input material={assignment.RawMaterialCode}, rows={removed:N0}");
            SetStatus($"{assignment.RawMaterialName}의 최초 투입 설정을 해제했습니다.", false);
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, true);
        }

        return Task.CompletedTask;
    }

    private int DeleteMaterialMappingsForCurrentModel(MaterialAssignment assignment)
    {
        var material = assignment.Material;
        var processRows = AllModelProcessRows
            .Where(row => string.Equals(
                row.Process.ModelName,
                assignment.ModelName,
                StringComparison.OrdinalIgnoreCase))
            .ToList();
        string sideAgnosticMaterialKey = NormalizeSideAgnosticMaterialKey(
            material.MaterialCode,
            material.MaterialName);
        var ids = _rows
            .Where(r =>
                IsExactMaterial(
                    r.RawMaterialCode,
                    r.RawMaterialName,
                    material.MaterialCode,
                    material.MaterialName) ||
                (sideAgnosticMaterialKey.Length > 0 &&
                 string.Equals(
                     NormalizeSideAgnosticMaterialKey(r.RawMaterialCode, r.RawMaterialName),
                     sideAgnosticMaterialKey,
                     StringComparison.OrdinalIgnoreCase)))
            .Where(r => processRows.Any(row => row.LinkedProcesses.Any(process =>
                string.Equals(r.ModelName.Trim(), process.ModelName, StringComparison.OrdinalIgnoreCase) &&
                ProcessMatches(r, process))))
            .Select(r => r.Id)
            .Distinct()
            .ToList();

        int removed = 0;
        foreach (long id in ids)
        {
            if (MappingService.Delete(id))
                removed++;
        }

        return removed;
    }

    private void TrimMaterialEdits()
    {
        var validMaterialKeys = SelectMaterialSourceRows()
            .Select(BuildMaterialCandidateKey)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        var validProcessKeys = OrderedProcessRows
            .Select(r => r.GroupKey)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        foreach (string key in _materialEdits.Keys.Where(key => !validMaterialKeys.Contains(key)).ToList())
            _materialEdits.Remove(key);

        foreach (var edit in _materialEdits.Values)
        {
            if (edit.ProcessGroupKey.Length > 0 && !validProcessKeys.Contains(edit.ProcessGroupKey))
                edit.ProcessGroupKey = string.Empty;
        }
    }

    private static bool TryParseUsageQty(string text, out decimal value)
        => decimal.TryParse(text, NumberStyles.Number, CultureInfo.InvariantCulture, out value) ||
           decimal.TryParse(text, NumberStyles.Number, CultureInfo.CurrentCulture, out value);

    private string BuildMaterialScopeText(MaterialAssignment assignment, IReadOnlyList<Test3ProcessRow> orderedRows)
    {
        var materialProcessRows = GetMaterialProcessRows(assignment, orderedRows);
        string processGroupKey = GetMaterialProcessValue(assignment);
        int startIndex = materialProcessRows.FindIndex(r =>
            string.Equals(r.GroupKey, processGroupKey, StringComparison.OrdinalIgnoreCase));
        if (startIndex < 0)
            return "최초 투입 공정 미설정";

        var first = materialProcessRows[startIndex];
        var last = materialProcessRows[^1];
        return $"#{GetProcessNo(first)} {first.Process.ProcessName} → #{GetProcessNo(last)} {last.Process.ProcessName} · {materialProcessRows.Count - startIndex:N0}개 공정 적용";
    }

