@page "/bmes/test3"
@rendermode InteractiveServer
@using System.Globalization
@using System.Text
@using JinoSupporter.Web.Services
@inject ProcessMaterialMappingService MappingService
@inject NgRateSettingsService NgRateSettings
@inject BmesFcostActualService FCostActual
@inject AppPathsService AppPaths
@inject WebRepository Repo
@inject AppActivityLogger Activity

<PageTitle>Test 3</PageTitle>

@{
    var modelProcessRows = ModelProcessRows;
    var bomMaterials = FilteredBomMaterials;
}

<div class="d-flex align-items-center gap-2 mb-3">
    <span class="fw-semibold" style="font-size:18px;">T3</span>
    <h5 class="mb-0 fw-semibold">Test 3</h5>
</div>

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <div class="alert @(_statusError ? "alert-danger" : "alert-success") py-2 small mb-3 d-flex align-items-center">
        <span class="flex-fill">@_statusMessage</span>
        <button class="btn-close btn-sm" @onclick="() => _statusMessage = string.Empty"></button>
    </div>
}

<datalist id="test3-models">
    @foreach (string model in _modelNames)
    {
        <option value="@model"></option>
    }
</datalist>
<div class="test3-shell @(IsModelProcessMode ? "with-bom" : "")">
    <section class="test3-table-wrap">
        <div class="test3-toolbar">
            <span class="fw-semibold small">Mappings</span>
            <span class="badge bg-secondary">@_rows.Count.ToString("N0", CultureInfo.InvariantCulture)</span>
            @if (FilteredRows.Count != _rows.Count)
            {
                <span class="text-muted small">@FilteredRows.Count.ToString("N0", CultureInfo.InvariantCulture) shown</span>
            }
            <div class="ms-auto test3-filter">
                <input class="form-control form-control-sm" placeholder="Model" @bind="_filterModel" @bind:event="oninput" @bind:after="OnFilterModelChangedAsync" />
                <input class="form-control form-control-sm" placeholder="Process" @bind="_filterProcess" @bind:event="oninput" />
                <input class="form-control form-control-sm" placeholder="Raw material" @bind="_filterMaterial" @bind:event="oninput" />
            </div>
            @if (!string.IsNullOrWhiteSpace(_filterModel))
            {
                <button class="btn btn-outline-primary btn-sm"
                        @onclick="ReloadBomMaterialsAsync"
                        disabled="@_bomBusy"
                        title="Reload FCOST material candidates for the model">
                    FCOST
                </button>
                <button class="btn btn-outline-danger btn-sm"
                        @onclick="() => ResetVisibleProcessRegistrations(modelProcessRows)"
                        disabled="@(!HasProcessRegistrations(modelProcessRows))"
                        title="Delete process No and Ref registrations shown for this model">
                    Reset
                </button>
            }
        </div>
        <div class="test3-table-scroll">
            <table class="test3-table">
                <thead>
                    @if (IsModelProcessMode)
                    {
                        <tr>
                            <th style="width:34px;"></th>
                            <th style="width:86px;">No</th>
                            <th style="min-width:250px;">Model</th>
                            <th style="min-width:110px;">Process Code</th>
                            <th style="min-width:230px;">Process Name</th>
                            <th style="min-width:420px;">Mapped FCOST Materials</th>
                            <th style="min-width:90px;">Usage</th>
                            <th style="min-width:160px;">Note</th>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <th style="min-width:150px;">Model</th>
                            <th style="min-width:110px;">Process Code</th>
                            <th style="min-width:210px;">Process Name</th>
                            <th style="min-width:150px;">Raw Material Code</th>
                            <th style="min-width:230px;">Raw Material Name</th>
                            <th style="min-width:90px;">Usage</th>
                            <th style="min-width:160px;">Note</th>
                            <th style="width:92px;"></th>
                        </tr>
                    }
                </thead>
                <tbody>
                    @if (IsModelProcessMode)
                    {
                        @if (modelProcessRows.Count == 0)
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4 small">No routing process rows for this model.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var processRow in modelProcessRows)
                            {
                                string processNo = GetProcessNo(processRow.Process);
                                string referenceNo = GetReferenceProcessNo(processRow.Process);
                                var referenceProcess = FindProcessByNo(processRow.Process.ModelName, referenceNo);
                                <tr class="@BuildProcessDragRowClass(processRow.Process)"
                                    @ondragover:preventDefault="true"
                                    @ondragover="() => DragOverProcessRow(processRow.Process)"
                                    @ondragleave="() => ClearDragOverProcessRow(processRow.Process)"
                                    @ondrop="() => DropProcessRow(processRow.Process)">
                                    <td class="test3-drag-cell">
                                        <span class="test3-drag-handle"
                                              draggable="true"
                                              title="Drag to reorder"
                                              @ondragstart="() => StartProcessDrag(processRow.Process)"
                                              @ondragend="EndProcessDrag">::</span>
                                    </td>
                                    <td>
                                        <div class="test3-process-no-cell">
                                            <input class="test3-process-no"
                                                   value="@processNo"
                                                   placeholder="S2-1"
                                                   title="Process number, for example S2-1"
                                                   @onchange="e => SaveProcessNo(processRow.Process, e.Value?.ToString())" />
                                            <button type="button"
                                                    class="btn btn-outline-danger btn-sm py-0 px-1"
                                                    disabled="@(!HasProcessRegistration(processRow.LinkedProcesses))"
                                                    title="Delete this process No and Ref registration"
                                                    @onclick="() => DeleteProcessRegistration(processRow.LinkedProcesses)">
                                                Del
                                            </button>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="test3-model-pair">
                                            @foreach (var linkedProcess in processRow.LinkedProcesses)
                                            {
                                                <span class="test3-model-chip @BuildModelSideClass(linkedProcess)" title="@BuildProcessTitle(linkedProcess)">
                                                    <small>@BuildModelSideLabel(linkedProcess)</small>
                                                    <span>@linkedProcess.ModelName</span>
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td class="font-monospace">@processRow.Process.ProcessCode</td>
                                    <td>@processRow.Process.ProcessName</td>
                                    <td>
                                        <div class="test3-drop-zone @(IsFocusedProcess(processRow.Process) ? "active" : "")"
                                             role="button"
                                             tabindex="0"
                                             @onclick="() => FocusProcess(processRow.Process)">
                                            @if (processRow.Mappings.Count == 0 && string.IsNullOrWhiteSpace(referenceNo))
                                            {
                                                <span class="test3-drop-placeholder">
                                                    @(IsFocusedProcess(processRow.Process) ? "Focused - check candidates, then Add Selected" : "Click to focus process group")
                                                </span>
                                            }
                                            else
                                            {
                                                @if (!string.IsNullOrWhiteSpace(referenceNo))
                                                {
                                                    <span class="test3-process-ref" title="@BuildReferenceTitle(referenceNo, referenceProcess)">
                                                        <span>Ref @referenceNo</span>
                                                        <button type="button"
                                                                class="test3-chip-remove"
                                                                title="Clear reference"
                                                                @onclick:stopPropagation="true"
                                                                @onclick="() => SaveReferenceProcessNo(processRow.Process, string.Empty)">
                                                            x
                                                        </button>
                                                    </span>
                                                }
                                                @foreach (var mapped in processRow.Mappings)
                                                {
                                                    var mappingRole = GetMappingRole(processRow.Process, mapped, referenceProcess);
                                                    <span class="test3-mapped-material @mappingRole.CssClass" title="@BuildMappingTitle(mapped, mappingRole)">
                                                        @if (processRow.LinkedProcesses.Count > 1)
                                                        {
                                                            <small class="test3-map-role side">@BuildMappingSideLabel(mapped)</small>
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(mappingRole.Label))
                                                        {
                                                            <small class="test3-map-role">@mappingRole.Label</small>
                                                        }
                                                        <span class="font-monospace">@mapped.RawMaterialCode</span>
                                                        <span>@mapped.RawMaterialName</span>
                                                        <button type="button"
                                                                class="test3-chip-remove"
                                                                title="Delete mapping"
                                                                @onclick:stopPropagation="true"
                                                                @onclick="() => Delete(mapped.Id)">
                                                            x
                                                        </button>
                                                    </span>
                                                }
                                            }
                                            <input class="test3-ref-input"
                                                   value="@referenceNo"
                                                   placeholder="Ref"
                                                   title="Reference another process number, for example S2-1"
                                                   @onclick:stopPropagation="true"
                                                   @onchange="e => SaveReferenceProcessNo(processRow.Process, e.Value?.ToString())" />
                                        </div>
                                    </td>
                                    <td class="text-end">@FormatProcessUsage(processRow.Mappings)</td>
                                    <td>@FormatProcessNotes(processRow.Mappings)</td>
                                </tr>
                            }
                        }
                    }
                    else
                    {
                        @if (FilteredRows.Count == 0)
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4 small">No rows.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var row in FilteredRows)
                            {
                                <tr>
                                    <td>@row.ModelName</td>
                                    <td class="font-monospace">@row.ProcessCode</td>
                                    <td>@row.ProcessName</td>
                                    <td class="font-monospace">@row.RawMaterialCode</td>
                                    <td>@row.RawMaterialName</td>
                                    <td class="text-end">@FormatUsage(row)</td>
                                    <td>@row.Note</td>
                                    <td class="test3-row-actions">
                                        <button class="btn btn-outline-danger btn-sm py-0 px-1" @onclick="() => Delete(row.Id)">Del</button>
                                    </td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
    @if (IsModelProcessMode)
    {
        <aside class="test3-bom-tray">
            <div class="test3-bom-title">
                <span class="fw-semibold small">FCOST Material Candidates</span>
                <span class="text-muted small">@_filterModel.Trim()</span>
                @if (_focusedProcess is not null)
                {
                    <span class="badge bg-primary">@_focusedProcess.ProcessName</span>
                }
                @if (_bomBusy)
                {
                    <span class="spinner-border spinner-border-sm text-primary" role="status" style="width:12px;height:12px;"></span>
                }
                else
                {
                    <span class="badge bg-secondary">@bomMaterials.Count.ToString("N0", CultureInfo.InvariantCulture)</span>
                }
                @if (_selectedBomMaterialCodes.Count > 0)
                {
                    <span class="badge bg-success">@_selectedBomMaterialCodes.Count.ToString("N0", CultureInfo.InvariantCulture) selected</span>
                }
                <button type="button"
                        class="btn btn-primary btn-sm py-0 px-2"
                        disabled="@(_focusedProcess is null || _selectedBomMaterialCodes.Count == 0)"
                        @onclick="AddSelectedBomMaterialsToFocusedProcessAsync">
                    Add Selected
                </button>
                <button type="button"
                        class="btn btn-outline-secondary btn-sm py-0 px-2"
                        disabled="@(_selectedBomMaterialCodes.Count == 0)"
                        @onclick="ClearSelectedBomMaterials">
                    Clear
                </button>
            </div>
            @if (!string.IsNullOrWhiteSpace(_bomError))
            {
                <div class="text-danger small">@_bomError</div>
            }
            else if (!_bomBusy && bomMaterials.Count == 0)
            {
                <div class="text-muted small">No C-S-/R-S- FCOST material candidates.</div>
            }
            else
            {
                <div class="test3-bom-list">
                    @foreach (var material in bomMaterials)
                    {
                        <label class="test3-bom-card @(IsBomMaterialSelected(material) ? "selected" : "")"
                               title="@BuildBomTitle(material)">
                            <input type="checkbox"
                                   checked="@IsBomMaterialSelected(material)"
                                   @onchange="e => ToggleBomMaterialSelection(material, e.Value)" />
                            <span class="font-monospace">@material.MaterialCode</span>
                            <span>@material.MaterialName</span>
                            @if (material.SourceRows > 0)
                            {
                                <small>@material.SourceRows.ToString("N0", CultureInfo.InvariantCulture) rows</small>
                            }
                        </label>
                    }
                </div>
            }
        </aside>
    }
</div>

<style>
    .test3-shell {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 12px;
        align-items: start;
    }
    .test3-shell.with-bom {
        grid-template-columns: minmax(0, 1fr) 380px;
    }
    .test3-table-wrap {
        border: 1px solid var(--line-2, #c6ccd5);
        border-radius: 2px;
        background: var(--panel, #fff);
    }
    .test3-toolbar {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 10px;
        border-bottom: 1px solid var(--line-2, #c6ccd5);
        min-height: 42px;
    }
    .test3-filter {
        display: grid;
        grid-template-columns: repeat(3, minmax(110px, 180px));
        gap: 6px;
    }
    .test3-filter-processes {
        padding: 8px 10px;
        border-bottom: 1px solid var(--line-2, #c6ccd5);
        background: var(--panel-2, #f5f6f9);
    }
    .test3-filter-process-list {
        max-height: 90px;
    }
    .test3-process-no {
        width: 64px;
        height: 26px;
        border: 1px solid var(--line-2, #c6ccd5);
        border-radius: 2px;
        padding: 2px 5px;
        font-size: 11px;
        text-align: center;
    }
    .test3-process-no-cell {
        display: flex;
        align-items: center;
        gap: 4px;
    }
    .test3-process-no-cell .btn {
        font-size: 10px;
        line-height: 1.3;
        min-width: 30px;
    }
    .test3-model-pair {
        display: flex;
        align-items: center;
        gap: 5px;
        flex-wrap: wrap;
    }
    .test3-model-chip {
        display: inline-grid;
        grid-template-columns: 18px minmax(0, 1fr);
        align-items: center;
        max-width: 180px;
        border: 1px solid var(--line-2, #c6ccd5);
        border-radius: 2px;
        background: var(--panel, #fff);
        color: var(--ink, #0f1319);
        font-size: 11px;
        line-height: 1.2;
        overflow: hidden;
    }
    .test3-model-chip small {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        min-height: 22px;
        background: var(--line, var(--line, #dde1e7));
        color: var(--ink-2, #4a5461);
        font-size: 10px;
        font-weight: 800;
    }
    .test3-model-chip span {
        padding: 4px 6px;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .test3-model-chip.left small {
        background: #dbeafe;
        color: #1d4ed8;
    }
    .test3-model-chip.right small {
        background: var(--ok-wash, #eaf1f9);
        color: var(--ok, #1f5fa8);
    }
    .test3-table-scroll {
        overflow: auto;
        max-height: calc(100vh - 150px);
    }
    .test3-table {
        width: max-content;
        min-width: 100%;
        border-collapse: collapse;
        font-size: 12px;
        white-space: nowrap;
    }
    .test3-table th {
        position: sticky;
        top: 0;
        z-index: 1;
        background: var(--panel-3, #eceef2);
        color: var(--ink-2, #4a5461);
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        padding: 6px 8px;
        border: 1px solid var(--line, #dde1e7);
    }
    .test3-table td {
        padding: 5px 8px;
        border: 1px solid var(--line, #dde1e7);
        color: var(--ink, #0f1319);
    }
    .test3-table tr:hover td { background: var(--panel-2, #f5f6f9); }
    .test3-table tr.drag-over td {
        background: #eff6ff;
        box-shadow: inset 0 2px 0 #2563eb;
    }
    .test3-table tr.drag-source td {
        opacity: .65;
    }
    .test3-drag-cell {
        width: 34px;
        text-align: center;
    }
    .test3-drag-handle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 20px;
        height: 22px;
        border: 1px solid var(--line-2, #c6ccd5);
        border-radius: 2px;
        background: var(--panel-2, #f5f6f9);
        color: var(--ink-2, #4a5461);
        cursor: grab;
        font-size: 11px;
        font-weight: 800;
        line-height: 1;
        user-select: none;
    }
    .test3-drag-handle:active {
        cursor: grabbing;
    }
    .test3-drop-zone {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 5px;
        width: 100%;
        min-height: 31px;
        min-width: 380px;
        border: 1px dashed var(--line-2, #c6ccd5);
        border-radius: 2px;
        background: var(--panel-2, #f5f6f9);
        padding: 4px;
        text-align: left;
        cursor: pointer;
    }
    .test3-drop-zone:hover {
        border-color: #2563eb;
        background: #eff6ff;
    }
    .test3-drop-zone.active {
        border-color: var(--signal, #16202b);
        background: var(--signal-wash, #edf0f4);
        box-shadow: inset 0 0 0 1px #2563eb;
    }
    .test3-drop-placeholder {
        color: var(--ink-3, #7f8a98);
        font-size: 11px;
        padding: 2px 4px;
    }
    .test3-mapped-material,
    .test3-process-ref,
    .test3-bom-card {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        max-width: 100%;
        border: 1px solid var(--line-2, #c6ccd5);
        border-radius: 2px;
        background: var(--panel, #fff);
        color: var(--ink, #0f1319);
        font-size: 11px;
        line-height: 1.2;
        padding: 4px 6px;
    }
    .test3-mapped-material span:nth-child(2),
    .test3-bom-card span:nth-child(2) {
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .test3-process-ref {
        border-color: #93c5fd;
        background: #eff6ff;
        color: #1d4ed8;
        font-weight: 700;
    }
    .test3-mapped-material.replace {
        border-color: #f59e0b;
        background: #fffbeb;
    }
    .test3-mapped-material.add {
        border-color: var(--ok-wash, #eaf1f9);
        background: var(--ok-wash, #eaf1f9);
    }
    .test3-mapped-material.same {
        border-color: var(--line-2, #c6ccd5);
        background: var(--panel-2, #f5f6f9);
        color: var(--ink-2, #4a5461);
    }
    .test3-map-role {
        border-radius: 2px;
        background: var(--line, var(--line, #dde1e7));
        color: var(--ink-2, #4a5461);
        font-size: 9px;
        font-weight: 800;
        line-height: 1;
        padding: 2px 3px;
        text-transform: uppercase;
    }
    .test3-map-role.side {
        background: #dbeafe;
        color: #1d4ed8;
    }
    .test3-ref-input {
        width: 78px;
        height: 24px;
        border: 1px solid var(--line-2, #c6ccd5);
        border-radius: 2px;
        padding: 2px 5px;
        font-size: 11px;
    }
    .test3-chip-remove {
        border: 0;
        background: transparent;
        color: var(--ink-2, #4a5461);
        font-size: 12px;
        line-height: 1;
        padding: 0 1px;
    }
    .test3-chip-remove:hover { color: var(--crit, #c8342a); }
    .test3-bom-tray {
        min-width: 0;
        max-height: calc(100vh - 96px);
        overflow: hidden;
        padding: 8px 10px;
        border: 1px solid var(--line-2, #c6ccd5);
        border-radius: 2px;
        background: var(--panel-2, #f5f6f9);
        position: sticky;
        top: 8px;
    }
    .test3-bom-title {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
        margin-bottom: 7px;
    }
    .test3-bom-list {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 4px;
        max-height: calc(100vh - 150px);
        overflow: auto;
    }
    .test3-bom-card {
        cursor: pointer;
        display: grid;
        grid-template-columns: 18px minmax(104px, 140px) minmax(0, 1fr) auto;
        width: 100%;
        text-align: left;
        justify-content: stretch;
        margin: 0;
    }
    .test3-bom-card:hover {
        border-color: #2563eb;
        background: #eff6ff;
    }
    .test3-bom-card.selected {
        border-color: var(--ok, #1f5fa8);
        background: var(--ok-wash, #eaf1f9);
    }
    .test3-bom-card input {
        margin: 0;
        align-self: center;
    }
    .test3-bom-card small {
        color: var(--ink-2, #4a5461);
        font-size: 10px;
        white-space: nowrap;
    }
    .test3-row-actions {
        text-align: center;
        white-space: nowrap;
    }
    .test3-row-actions .btn { font-size: 10px; }
    @@media (max-width: 980px) {
        .test3-shell { grid-template-columns: 1fr; }
        .test3-shell.with-bom { grid-template-columns: 1fr; }
        .test3-bom-tray { position: static; max-height: none; }
        .test3-bom-list { max-height: 260px; }
        .test3-filter { grid-template-columns: 1fr; }
        .test3-toolbar { align-items: stretch; flex-wrap: wrap; }
    }
</style>

@code {
    private List<ProcessMaterialMappingRow> _rows = [];
    private List<ProcessMaterialProcessRow> _processSettings = [];
    private List<string> _modelNames = [];
    private List<RoutingRow> _routingRows = [];
    private Dictionary<string, int> _routingOrderByProcess = new(StringComparer.OrdinalIgnoreCase);
    private string _filterModel = string.Empty;
    private string _filterProcess = string.Empty;
    private string _filterMaterial = string.Empty;
    private List<BmesBomMaterialCandidate> _bomMaterials = [];
    private RoutingProcessOption? _focusedProcess;
    private HashSet<string> _selectedBomMaterialCodes = new(StringComparer.OrdinalIgnoreCase);
    private string _draggedProcessGroupKey = string.Empty;
    private string _dragOverProcessGroupKey = string.Empty;
    private string _loadedBomModel = string.Empty;
    private string _bomError = string.Empty;
    private int _bomLoadVersion;
    private bool _bomBusy;
    private string _statusMessage = string.Empty;
    private bool _statusError;

    private List<ProcessMaterialMappingRow> FilteredRows =>
        _rows
            .Where(IsSelectableMapping)
            .Where(r => Matches(r.ModelName, _filterModel))
            .Where(r => Matches(r.ProcessCode, _filterProcess) || Matches(r.ProcessName, _filterProcess))
            .Where(r => Matches(r.RawMaterialCode, _filterMaterial) || Matches(r.RawMaterialName, _filterMaterial))
            .OrderBy(r => r.ModelName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(r => r.ProcessName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(r => r.RawMaterialName, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private bool IsModelProcessMode => !string.IsNullOrWhiteSpace(_filterModel);

    private List<Test3ProcessRow> ModelProcessRows =>
        !IsModelProcessMode
            ? []
            : GetRoutingProcessOptions(_filterModel)
                .Where(p => Matches(p.ProcessCode, _filterProcess) || Matches(p.ProcessName, _filterProcess))
                .GroupBy(BuildDisplayProcessGroupKey, StringComparer.OrdinalIgnoreCase)
                .Select(g =>
                {
                    var processes = SortLinkedProcesses(g).ToList();
                    var primary = processes[0];
                    var mappings = processes
                        .SelectMany(GetMappingsForProcess)
                        .OrderBy(m => ModelSideSortIndex(m.ModelName))
                        .ThenBy(m => m.ModelName, StringComparer.OrdinalIgnoreCase)
                        .ThenBy(m => m.RawMaterialName, StringComparer.OrdinalIgnoreCase)
                        .ThenBy(m => m.RawMaterialCode, StringComparer.OrdinalIgnoreCase)
                        .ToList();
                    return new Test3ProcessRow(primary, processes, mappings);
                })
                .OrderBy(r => ProcessSortGroup(r.Process))
                .ThenBy(r => ProcessSortKey(r.Process), StringComparer.OrdinalIgnoreCase)
                .ThenBy(r => RoutingSortIndex(r.Process))
                .ThenBy(r => NormalizeKey(r.Process.ProcessCode), StringComparer.OrdinalIgnoreCase)
                .ThenBy(r => ProcessNameGroupSortKey(r.Process), StringComparer.OrdinalIgnoreCase)
                .ThenBy(r => ExtractSideTokenFromModel(r.Process.ModelName), StringComparer.OrdinalIgnoreCase)
                .ThenBy(r => r.Process.ModelName, StringComparer.OrdinalIgnoreCase)
                .ToList();

    private List<BmesBomMaterialCandidate> FilteredBomMaterials =>
        _bomMaterials
            .Where(IsSelectableMaterial)
            .Where(m => Matches(m.MaterialCode, _filterMaterial) || Matches(m.MaterialName, _filterMaterial))
            .OrderBy(m => m.MaterialName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(m => m.MaterialCode, StringComparer.OrdinalIgnoreCase)
            .ToList();

    protected override void OnInitialized()
    {
        _rows = MappingService.GetAll();
        _processSettings = MappingService.GetProcessRows();
        _routingRows = NgRateSettings.GetRoutingRows();
        _routingOrderByProcess = BuildRoutingOrderLookup(_routingRows);
        _modelNames = Repo.GetModelGroups()
            .SelectMany(g => g.MidGroups.Select(m => m.Material))
            .Concat(_routingRows.Select(r => r.ModelName))
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Select(s => s.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(s => s, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

