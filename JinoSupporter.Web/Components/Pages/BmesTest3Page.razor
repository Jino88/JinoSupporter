        => processRows.Any(row => HasProcessRegistration(row.LinkedProcesses));

    private bool HasProcessRegistration(IReadOnlyList<RoutingProcessOption> processes)
        => processes.Any(process => GetProcessSetting(process) is not null);

    private bool HasProcessRegistration(RoutingProcessOption process)
        => GetProcessSetting(process) is not null;

    private HashSet<long> GetProcessRegistrationIds(IEnumerable<RoutingProcessOption> processes)
    {
        var ids = new HashSet<long>();
        foreach (var process in processes)
        {
            var setting = GetProcessSetting(process);
