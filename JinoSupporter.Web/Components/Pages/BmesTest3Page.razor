    }

    private List<MaterialAssignment> BuildMaterialAssignments(IReadOnlyList<Test3ProcessRow> orderedRows)
    {
        var processRows = AllModelProcessRows;
        var result = new List<MaterialAssignment>();
        foreach (var material in FilteredBomMaterials)
        {
            string key = BuildMaterialCandidateKey(material);
            string modelName = ResolveMaterialModelName(material);
            var materialProcessRows = processRows
                .Where(row => string.Equals(
                    row.Process.ModelName,
                    modelName,
                    StringComparison.OrdinalIgnoreCase))
                .ToList();
            var savedMappings = _rows
                .Where(r => IsExactMaterial(
                    r.RawMaterialCode,
                    r.RawMaterialName,
                    material.MaterialCode,
                    material.MaterialName))
                .Where(r => materialProcessRows.Any(row => row.LinkedProcesses.Any(process =>
                    string.Equals(r.ModelName.Trim(), process.ModelName, StringComparison.OrdinalIgnoreCase) &&
                    ProcessMatches(r, process))))
                .OrderBy(r => r.ModelName, StringComparer.OrdinalIgnoreCase)
                .ThenBy(r => r.ProcessName, StringComparer.OrdinalIgnoreCase)
                .ToList();

            var savedProcessRow = orderedRows
                .Where(row => string.Equals(
                    row.Process.ModelName,
                    modelName,
                    StringComparison.OrdinalIgnoreCase))
                .FirstOrDefault(row =>
                savedMappings.Any(mapping => row.LinkedProcesses.Any(process =>
                    string.Equals(mapping.ModelName.Trim(), process.ModelName, StringComparison.OrdinalIgnoreCase) &&
                    ProcessMatches(mapping, process))));

            var firstSaved = savedMappings.FirstOrDefault();
            decimal usageQty = firstSaved?.UsageQty is > 0
                ? firstSaved.UsageQty
                : material.UsageQty is > 0
                    ? material.UsageQty.Value
                    : 1m;
            string usageUnit = FirstNonBlank(firstSaved?.UsageUnit ?? string.Empty, material.UsageUnit, "PC");

            result.Add(new MaterialAssignment(
                key,
                modelName,
                material,
                savedMappings,
                savedProcessRow?.GroupKey ?? string.Empty,
                usageQty,
                usageUnit));
        }

        return result;
    }

    private string BuildMaterialCandidateKey(BmesBomMaterialCandidate material)
    {
        string modelName = NormalizeKey(ResolveMaterialModelName(material));
        string code = NormalizeKey(material.MaterialCode);
        string materialKey = code.Length > 0 ? code : "NAME\t" + NormalizeKey(material.MaterialName);
        return modelName + "\t" + materialKey;
    }

    private string ResolveMaterialModelName(BmesBomMaterialCandidate material)
    {
        var selectedModels = SelectedRoutingModelNames;
        string productCode = material.ProductCode.Trim();
        string exactModel = selectedModels.FirstOrDefault(model =>
            string.Equals(model, productCode, StringComparison.OrdinalIgnoreCase)) ?? string.Empty;
        if (exactModel.Length > 0)
            return exactModel;

        if (_bomModelByProductCode.TryGetValue(NormalizeKey(productCode), out string? mappedModel))
            return mappedModel;

        string materialSide = ExtractSideTokenFromMaterial(material.MaterialCode, material.MaterialName);
        string sideModel = selectedModels.FirstOrDefault(model =>
            string.Equals(ExtractSideTokenFromModel(model), materialSide, StringComparison.OrdinalIgnoreCase)) ?? string.Empty;
        if (sideModel.Length > 0)
            return sideModel;

        return selectedModels.Count == 1 ? selectedModels[0] : string.Empty;
    }

