            ? edit.ProcessGroupKey
            : assignment.SavedProcessGroupKey;

    private void SetMaterialProcessValue(MaterialAssignment assignment, string? value)
        => GetOrCreateMaterialEdit(assignment).ProcessGroupKey = value?.Trim() ?? string.Empty;

    private string GetMaterialUsageQtyText(MaterialAssignment assignment)
        => _materialEdits.TryGetValue(assignment.Key, out var edit)
            ? edit.UsageQtyText
            : assignment.UsageQty.ToString("0.######", CultureInfo.InvariantCulture);

    private void SetMaterialUsageQtyText(MaterialAssignment assignment, string? value)
