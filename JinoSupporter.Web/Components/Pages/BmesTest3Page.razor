@code {
    private bool ReactEditorEnabled { get; } = true;
    private const string BomPlant = "3200";
    private const int BomMaxDepth = 6;
    private const int BomMaxRows = 2000;

    private List<ProcessMaterialMappingRow> _rows = [];
    private List<ProcessMaterialProcessRow> _processSettings = [];
    private List<string> _modelNames = [];
    private List<RoutingRow> _routingRows = [];
    private Dictionary<string, int> _routingOrderByProcess = new(StringComparer.OrdinalIgnoreCase);
    private string _filterModel = string.Empty;
    private string _resolvedModelQuery = "\0";
    private List<string> _selectedRoutingModelNames = [];
    private string _filterProcess = string.Empty;
    private string _filterMaterial = string.Empty;
    private List<BmesBomMaterialCandidate> _bomMaterials = [];
    private Dictionary<string, string> _bomModelByProductCode = new(StringComparer.OrdinalIgnoreCase);
    private RoutingProcessOption? _focusedProcess;
    private HashSet<string> _selectedBomMaterialCodes = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, MaterialEditState> _materialEdits = new(StringComparer.OrdinalIgnoreCase);
    private string _draggedProcessGroupKey = string.Empty;
    private string _dragOverProcessGroupKey = string.Empty;
    private bool _draggedProcessFromSequence;
    private string _loadedBomModel = string.Empty;
    private string _bomLoadSource = string.Empty;
    private string _bomError = string.Empty;
    private int _bomLoadVersion;
    private bool _bomBusy;
    private string _statusMessage = string.Empty;
    private bool _statusError;
    private ElementReference _reactEditorHost;
    private IJSObjectReference? _reactEditorModule;
    private DotNetObjectReference<BmesTest3Page>? _reactEditorReference;

    private List<ProcessMaterialMappingRow> FilteredRows =>
        _rows
            .Where(IsSelectableMapping)
            .Where(r => Matches(r.ModelName, _filterModel))
            .Where(r => Matches(r.ProcessCode, _filterProcess) || Matches(r.ProcessName, _filterProcess))
            .Where(r => Matches(r.RawMaterialCode, _filterMaterial) || Matches(r.RawMaterialName, _filterMaterial))
            .OrderBy(r => r.ModelName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(r => r.ProcessName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(r => r.RawMaterialName, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private List<string> SelectedRoutingModelNames
    {
        get
        {
            string query = _filterModel.Trim();
            if (!string.Equals(_resolvedModelQuery, query, StringComparison.OrdinalIgnoreCase))
            {
                _resolvedModelQuery = query;
                _selectedRoutingModelNames = ResolveSelectedRoutingModelNames(query);
            }

            return _selectedRoutingModelNames;
        }
    }

    private bool IsModelProcessMode => SelectedRoutingModelNames.Count > 0;

    private List<string> ResolveSelectedRoutingModelNames(string value)
    {
        string query = value.Trim();
        if (query.Length == 0)
            return [];

        var routingModels = _routingRows
            .Select(r => r.ModelName.Trim())
            .Where(model => model.Length > 0)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        var sideVariants = routingModels
            .Where(model => IsDirectSideVariant(query, model))
            .OrderBy(ModelSideSortIndex)
            .ThenBy(model => model, StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (sideVariants.Count > 0)
            return sideVariants;

        return routingModels
            .Where(model => string.Equals(model, query, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private static bool IsDirectSideVariant(string baseModel, string candidate)
    {
        string prefix = baseModel.TrimEnd('-') + "-";
        if (!candidate.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
            return false;

        string suffix = candidate[prefix.Length..];
        return string.Equals(suffix, "L", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(suffix, "R", StringComparison.OrdinalIgnoreCase) ||
               suffix.StartsWith("L-", StringComparison.OrdinalIgnoreCase) ||
               suffix.StartsWith("R-", StringComparison.OrdinalIgnoreCase);
    }

    private List<Test3ProcessRow> AllModelProcessRows =>
        !IsModelProcessMode
            ? []
            : SelectedRoutingModelNames
                .SelectMany(GetRoutingProcessOptions)
                .GroupBy(BuildDisplayProcessGroupKey, StringComparer.OrdinalIgnoreCase)
                .Select(g =>
                {
                    var processes = SortLinkedProcesses(g).ToList();
                    var primary = processes[0];
                    var mappings = processes
                        .SelectMany(GetMappingsForProcess)
                        .OrderBy(m => ModelSideSortIndex(m.ModelName))
                        .ThenBy(m => m.ModelName, StringComparer.OrdinalIgnoreCase)
                        .ThenBy(m => m.RawMaterialName, StringComparer.OrdinalIgnoreCase)
                        .ThenBy(m => m.RawMaterialCode, StringComparer.OrdinalIgnoreCase)
                        .ToList();
                    return new Test3ProcessRow(BuildProcessGroupKey(primary), primary, processes, mappings);
                })
                .OrderBy(r => RoutingSortIndex(r.Process))
                .ThenBy(r => NormalizeKey(r.Process.ProcessCode), StringComparer.OrdinalIgnoreCase)
                .ThenBy(r => ProcessNameGroupSortKey(r.Process), StringComparer.OrdinalIgnoreCase)
                .ThenBy(r => ExtractSideTokenFromModel(r.Process.ModelName), StringComparer.OrdinalIgnoreCase)
                .ThenBy(r => r.Process.ModelName, StringComparer.OrdinalIgnoreCase)
                .ToList();

    private List<Test3ProcessRow> OrderedProcessRows =>
        AllModelProcessRows
            .Where(r => !string.IsNullOrWhiteSpace(GetProcessNo(r)))
            .OrderBy(r => BuildProcessNoSortKey(GetProcessNo(r)), StringComparer.OrdinalIgnoreCase)
            .ThenBy(r => RoutingSortIndex(r.Process))
            .ThenBy(r => NormalizeKey(r.Process.ProcessCode), StringComparer.OrdinalIgnoreCase)
            .ThenBy(r => ProcessNameGroupSortKey(r.Process), StringComparer.OrdinalIgnoreCase)
            .ToList();

    private List<Test3ProcessRow> AvailableProcessRows =>
        AllModelProcessRows
            .Where(r => string.IsNullOrWhiteSpace(GetProcessNo(r)))
            .Where(r => Matches(r.Process.ProcessCode, _filterProcess) || Matches(r.Process.ProcessName, _filterProcess))
            .OrderBy(r => RoutingSortIndex(r.Process))
            .ThenBy(r => NormalizeKey(r.Process.ProcessCode), StringComparer.OrdinalIgnoreCase)
            .ThenBy(r => ProcessNameGroupSortKey(r.Process), StringComparer.OrdinalIgnoreCase)
            .ToList();

    private List<BmesBomMaterialCandidate> FilteredBomMaterials =>
        SelectMaterialSourceRows()
            .Where(IsSelectableMaterial)
            .Where(m => Matches(m.MaterialCode, _filterMaterial) || Matches(m.MaterialName, _filterMaterial))
            .OrderBy(m => ModelSideSortIndex(ResolveMaterialModelName(m)))
            .ThenBy(m => ResolveMaterialModelName(m), StringComparer.OrdinalIgnoreCase)
            .ThenBy(m => m.MaterialName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(m => m.MaterialCode, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private List<MaterialAssignment> MaterialAssignments =>
        BuildMaterialAssignments(OrderedProcessRows);

    private List<Test3ProcessLane> BuildProcessLanes(IReadOnlyList<Test3ProcessRow> rows)
        => SelectedRoutingModelNames
            .Select(modelName => new Test3ProcessLane(
                modelName,
                rows.Where(row => string.Equals(
                        row.Process.ModelName,
                        modelName,
                        StringComparison.OrdinalIgnoreCase))
                    .ToList()))
            .ToList();

    private List<Test3MaterialLane> BuildMaterialLanes(IReadOnlyList<MaterialAssignment> assignments)
        => SelectedRoutingModelNames
            .Select(modelName => new Test3MaterialLane(
                modelName,
                assignments.Where(assignment => string.Equals(
                        assignment.ModelName,
                        modelName,
                        StringComparison.OrdinalIgnoreCase))
                    .ToList()))
            .ToList();

    private List<Test3ProcessRow> GetOrderedProcessRows(string modelName)
        => OrderedProcessRows
            .Where(row => string.Equals(
                row.Process.ModelName,
                modelName,
                StringComparison.OrdinalIgnoreCase))
            .ToList();

    protected override void OnInitialized()
    {
        _rows = MappingService.GetAll();
        _processSettings = MappingService.GetProcessRows();
        _routingRows = NgRateSettings.GetRoutingRows();
        _routingOrderByProcess = BuildRoutingOrderLookup(_routingRows);
        _modelNames = Repo.GetModelGroups()
            .SelectMany(g => g.MidGroups.Select(m => m.Material))
            .Concat(_routingRows.Select(r => r.ModelName))
            .Concat(_routingRows.Select(r => BuildRoutingBaseModelName(r.ModelName)))
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Select(s => s.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(s => s, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private void Delete(long id)
    {
        if (MappingService.Delete(id))
        {
            Activity.Log("Test 3", $"Delete mapping id={id}");
            _rows = MappingService.GetAll();
            SetStatus("Deleted.", false);
        }
    }

    private void DeleteProcessRegistration(IReadOnlyList<RoutingProcessOption> processes)
    {
        var ids = GetProcessRegistrationIds(processes);
        if (ids.Count == 0)
            return;

        int removed = DeleteProcessRegistrations(ids);
        Activity.Log("Test 3", $"Delete process registration rows={removed:N0}");
        SetStatus($"Deleted {removed:N0} process registration(s).", false);
    }

    private void ResetVisibleProcessRegistrations(IReadOnlyList<Test3ProcessRow> processRows)
    {
        var ids = GetProcessRegistrationIds(processRows.SelectMany(r => r.LinkedProcesses));
        if (ids.Count == 0)
            return;

        int removed = DeleteProcessRegistrations(ids);
        Activity.Log("Test 3", $"Reset process registrations model={_filterModel.Trim()}, rows={removed:N0}");
        SetStatus($"Reset {removed:N0} process registration(s).", false);
    }

    private int DeleteProcessRegistrations(IReadOnlySet<long> ids)
    {
        int removed = 0;
        foreach (long id in ids)
        {
            if (MappingService.DeleteProcess(id))
                removed++;
        }

        _processSettings = MappingService.GetProcessRows();
        return removed;
    }

    private bool HasProcessRegistrations(IReadOnlyList<Test3ProcessRow> processRows)
        => processRows.Any(row => HasProcessRegistration(row.LinkedProcesses));

    private bool HasProcessRegistration(IReadOnlyList<RoutingProcessOption> processes)
        => processes.Any(process => GetProcessSetting(process) is not null);

    private bool HasProcessRegistration(RoutingProcessOption process)
        => GetProcessSetting(process) is not null;

    private HashSet<long> GetProcessRegistrationIds(IEnumerable<RoutingProcessOption> processes)
    {
        var ids = new HashSet<long>();
        foreach (var process in processes)
        {
            var setting = GetProcessSetting(process);
            if (setting is not null)
                ids.Add(setting.Id);
        }

        return ids;
    }

    private async Task OnFilterModelChangedAsync()
    {
        _focusedProcess = null;
        _selectedBomMaterialCodes.Clear();
        _materialEdits.Clear();
        await LoadBomMaterialsAsync(force: false);
    }

    private Task ReloadBomMaterialsAsync()
        => LoadBomMaterialsAsync(force: true);

    private async Task LoadBomMaterialsAsync(bool force)
    {
        string model = _filterModel.Trim();

        if (model.Length == 0)
        {
            _bomMaterials = [];
            _bomModelByProductCode.Clear();
            _loadedBomModel = string.Empty;
            _bomLoadSource = string.Empty;
            _bomError = string.Empty;
            _bomBusy = false;
            _bomLoadVersion++;
            return;
        }

        if (!IsModelProcessMode)
        {
            _bomMaterials = [];
            _bomModelByProductCode.Clear();
            _loadedBomModel = string.Empty;
            _bomLoadSource = string.Empty;
            _bomError = string.Empty;
            _bomBusy = false;
            _bomLoadVersion++;
            return;
        }

        if (!force && string.Equals(_loadedBomModel, model, StringComparison.OrdinalIgnoreCase))
            return;

        int version = ++_bomLoadVersion;
        _bomBusy = true;
        _bomError = string.Empty;
        _bomLoadSource = string.Empty;
        StateHasChanged();

        try
        {
            var connection = BuildNetworkDbConnection();
            var rows = new List<BmesBomMaterialCandidate>();
            var modelByProductCode = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            int cacheLoads = 0;
            int serverLoads = 0;
            int failedLoads = 0;
            var loadErrors = new List<string>();

            foreach (string modelQuery in GetBomModelQueries(model))
            {
                try
                {
                    var load = await LoadBomRowsForModelAsync(modelQuery, force, connection);
                    rows.AddRange(load.Rows);
                    foreach (var material in load.Rows)
                    {
                        string productCode = NormalizeKey(material.ProductCode);
                        if (productCode.Length > 0)
                            modelByProductCode[productCode] = modelQuery;
                    }
                    if (string.Equals(load.Source, "cache", StringComparison.OrdinalIgnoreCase))
                        cacheLoads++;
                    else if (string.Equals(load.Source, "server", StringComparison.OrdinalIgnoreCase))
                        serverLoads++;
                }
                catch (Exception ex)
                {
                    failedLoads++;
                    loadErrors.Add($"{modelQuery}: {ex.Message}");
                }
            }

            if (version != _bomLoadVersion)
                return;

            _bomMaterials = rows
                .GroupBy(m => FirstNonBlank(m.BomPath, NormalizeKey(m.MaterialCode) + "\t" + NormalizeKey(m.MaterialName)), StringComparer.OrdinalIgnoreCase)
                .Select(g => g.OrderBy(m => m.BomLevel).ThenByDescending(m => m.SourceRows).First())
                .OrderBy(m => ModelSideSortIndex(m.MaterialName))
                .ThenBy(m => m.BomLevel)
                .ThenBy(m => m.MaterialName, StringComparer.OrdinalIgnoreCase)
                .ThenBy(m => m.MaterialCode, StringComparer.OrdinalIgnoreCase)
                .ToList();
            _bomModelByProductCode = modelByProductCode;
            TrimSelectedBomMaterials();
            TrimMaterialEdits();
            _loadedBomModel = model;
            _bomLoadSource = $"BOM 캐시 {cacheLoads:N0} · 서버 {serverLoads:N0}";
            _bomError = rows.Count == 0 && loadErrors.Count > 0
                ? "BOM 자재를 불러오지 못했습니다: " + string.Join(" ", loadErrors.Take(2))
                : failedLoads > 0
                    ? $"일부 모델의 BOM을 불러오지 못했습니다({failedLoads:N0}). " + string.Join(" ", loadErrors.Take(1))
                    : string.Empty;
        }
        catch (Exception ex)
        {
            if (version != _bomLoadVersion)
                return;

            _bomMaterials = [];
            _bomModelByProductCode.Clear();
            _loadedBomModel = model;
            _bomLoadSource = string.Empty;
            _bomError = "BOM 자재를 불러오지 못했습니다: " + ex.Message;
        }
        finally
        {
            if (version == _bomLoadVersion)
            {
                _bomBusy = false;
                StateHasChanged();
            }
        }
    }

    private async Task<BomLoadResult> LoadBomRowsForModelAsync(
        string model,
        bool force,
        BmesFcostDbConnection connection)
    {
        var cacheQuery = new BmesBomCacheQuery(model, BomPlant, DateTime.Today, BomMaxDepth, BomMaxRows);
        if (!force)
        {
            BmesBomCacheEntry? cached = BomCache.TryLoad(cacheQuery);
            if (cached is not null)
                return new BomLoadResult(cached.Rows, "cache");
        }

        if (string.IsNullOrWhiteSpace(connection.Server) || string.IsNullOrWhiteSpace(connection.UserId))
            throw new InvalidOperationException("로컬 BOM 캐시가 없고 네트워크 DB 연결도 설정되지 않았습니다.");

        var rows = await FCostActual.FetchBomTreeAsync(new BmesBomMaterialQuery
        {
            Connection = connection,
            ModelName = model,
            Plant = BomPlant,
            MaxRows = BomMaxRows,
            MaxDepth = BomMaxDepth,
            WorkDate = DateTime.Today,
        });

        BomCache.Save(cacheQuery, rows);
        return new BomLoadResult(rows, "server");
    }

    private bool IsBomMaterialSelected(BmesBomMaterialCandidate material)
        => _selectedBomMaterialCodes.Contains(BuildBomMaterialSelectionKey(material));

    private void ToggleBomMaterialSelection(BmesBomMaterialCandidate material, object? value)
    {
        bool selected = value is bool boolValue
            ? boolValue
            : bool.TryParse(value?.ToString(), out bool parsed) && parsed;
        string key = BuildBomMaterialSelectionKey(material);
        if (string.IsNullOrWhiteSpace(key))
            return;

        if (selected)
            _selectedBomMaterialCodes.Add(key);
        else
            _selectedBomMaterialCodes.Remove(key);
    }

    private void ClearSelectedBomMaterials()
    {
        _selectedBomMaterialCodes.Clear();
        SetStatus("Candidate selection cleared.", false);
    }

    private void TrimSelectedBomMaterials()
    {
        var validKeys = _bomMaterials
            .Select(BuildBomMaterialSelectionKey)
            .Where(s => s.Length > 0)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        _selectedBomMaterialCodes.RemoveWhere(key => !validKeys.Contains(key));
    }

    private string BuildProcessDragRowClass(RoutingProcessOption process)
    {
        string groupKey = BuildProcessGroupKey(process);
        var classes = new List<string>(capacity: 2);
        if (string.Equals(_draggedProcessGroupKey, groupKey, StringComparison.OrdinalIgnoreCase))
            classes.Add("drag-source");
        if (string.Equals(_dragOverProcessGroupKey, groupKey, StringComparison.OrdinalIgnoreCase) &&
            !string.Equals(_draggedProcessGroupKey, groupKey, StringComparison.OrdinalIgnoreCase))
            classes.Add("drag-over");
        return string.Join(" ", classes);
    }

    private void StartProcessDrag(RoutingProcessOption process, bool fromSequence)
    {
        _draggedProcessGroupKey = BuildProcessGroupKey(process);
        _dragOverProcessGroupKey = string.Empty;
        _draggedProcessFromSequence = fromSequence;
    }

    private void DragOverProcessRow(RoutingProcessOption process)
    {
        if (string.IsNullOrWhiteSpace(_draggedProcessGroupKey))
            return;

        _dragOverProcessGroupKey = BuildProcessGroupKey(process);
    }

    private void ClearDragOverProcessRow(RoutingProcessOption process)
    {
        string groupKey = BuildProcessGroupKey(process);
        if (string.Equals(_dragOverProcessGroupKey, groupKey, StringComparison.OrdinalIgnoreCase))
            _dragOverProcessGroupKey = string.Empty;
    }

    private void EndProcessDrag()
    {
        _draggedProcessGroupKey = string.Empty;
        _dragOverProcessGroupKey = string.Empty;
        _draggedProcessFromSequence = false;
    }

    private void DropProcessOnSequence(RoutingProcessOption targetProcess)
    {
        if (string.IsNullOrWhiteSpace(_draggedProcessGroupKey))
            return;

        var ordered = GetOrderedProcessRows(targetProcess.ModelName);
        string targetGroupKey = BuildProcessGroupKey(targetProcess);
        int targetIndex = ordered.FindIndex(g => string.Equals(g.GroupKey, targetGroupKey, StringComparison.OrdinalIgnoreCase));
        if (targetIndex < 0)
        {
            EndProcessDrag();
            return;
        }

        InsertDraggedProcessIntoSequence(targetIndex, targetProcess.ModelName);
    }

    private void DropProcessAtSequenceEnd(string modelName)
    {
        if (string.IsNullOrWhiteSpace(_draggedProcessGroupKey))
            return;

        InsertDraggedProcessIntoSequence(GetOrderedProcessRows(modelName).Count, modelName);
    }

    private void DropProcessBackToAvailable()
    {
        if (string.IsNullOrWhiteSpace(_draggedProcessGroupKey) || !_draggedProcessFromSequence)
            return;

        var row = OrderedProcessRows.FirstOrDefault(r =>
            string.Equals(r.GroupKey, _draggedProcessGroupKey, StringComparison.OrdinalIgnoreCase));
        if (row is not null)
            RemoveProcessFromSequence(row);

        EndProcessDrag();
    }

    private void AddProcessToSequence(Test3ProcessRow processRow)
    {
        var ordered = GetOrderedProcessRows(processRow.Process.ModelName);
        if (ordered.Any(row => string.Equals(row.GroupKey, processRow.GroupKey, StringComparison.OrdinalIgnoreCase)))
            return;

        ordered.Add(processRow);
        SaveProcessSequence(ordered, $"{processRow.Process.ProcessName} 공정을 순서 마지막에 추가했습니다.");
    }

    private void RemoveProcessFromSequence(Test3ProcessRow processRow)
    {
        var ordered = GetOrderedProcessRows(processRow.Process.ModelName)
            .Where(row => !string.Equals(row.GroupKey, processRow.GroupKey, StringComparison.OrdinalIgnoreCase))
            .ToList();

        DeleteProcessRegistrations(GetProcessRegistrationIds(processRow.LinkedProcesses));
        SaveProcessSequence(ordered, $"{processRow.Process.ProcessName} 공정을 순서에서 뺐습니다.");
    }

    private void InsertDraggedProcessIntoSequence(int targetIndex, string targetModelName)
    {
        string sourceGroupKey = _draggedProcessGroupKey;
        var source = AllModelProcessRows.FirstOrDefault(row =>
            string.Equals(row.GroupKey, sourceGroupKey, StringComparison.OrdinalIgnoreCase));
        if (source is null)
        {
            EndProcessDrag();
            return;
        }

        if (!string.Equals(source.Process.ModelName, targetModelName, StringComparison.OrdinalIgnoreCase))
        {
            SetStatus("L 공정과 R 공정은 서로 다른 순서 영역으로 이동할 수 없습니다.", true);
            EndProcessDrag();
            return;
        }

        var ordered = GetOrderedProcessRows(targetModelName);
        int sourceIndex = ordered.FindIndex(row =>
            string.Equals(row.GroupKey, sourceGroupKey, StringComparison.OrdinalIgnoreCase));
        if (sourceIndex >= 0)
        {
            ordered.RemoveAt(sourceIndex);
            if (sourceIndex < targetIndex)
                targetIndex--;
        }
        else if (ordered.Any(row => string.Equals(row.GroupKey, sourceGroupKey, StringComparison.OrdinalIgnoreCase)))
        {
            EndProcessDrag();
            return;
        }

        targetIndex = Math.Clamp(targetIndex, 0, ordered.Count);
        ordered.Insert(targetIndex, source);
        SaveProcessSequence(
            ordered,
            _draggedProcessFromSequence
                ? "드래그한 순서로 공정 순서를 바로 저장했습니다."
                : $"{source.Process.ProcessName} 공정을 드래그한 위치에 추가했습니다.");
        EndProcessDrag();
    }

    private void SaveProcessSequence(IReadOnlyList<Test3ProcessRow> orderedRows, string statusMessage)
    {
        for (int i = 0; i < orderedRows.Count; i++)
        {
            string processNo = (i + 1).ToString(CultureInfo.InvariantCulture);
            string referenceNo = i == 0 ? string.Empty : i.ToString(CultureInfo.InvariantCulture);
            foreach (var target in orderedRows[i].LinkedProcesses)
                UpsertProcessSetting(target, processNo, referenceNo);
        }

        _processSettings = MappingService.GetProcessRows();
        TrimMaterialEdits();
        Activity.Log("Test 3", $"Save adaptive process sequence model={_filterModel.Trim()}, rows={orderedRows.Count:N0}");
        SetStatus(statusMessage, false);
    }

    private List<ProcessOrderGroup> BuildProcessOrderGroups(IReadOnlyList<Test3ProcessRow> processRows)
    {
        var groups = new List<ProcessOrderGroup>();
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var row in processRows)
        {
            string groupKey = BuildProcessGroupKey(row.Process);
            if (!seen.Add(groupKey))
                continue;

            groups.Add(new ProcessOrderGroup(groupKey, row.Process, GetProcessNo(row.Process)));
        }

        return groups;
    }

    private static List<string> BuildPositionProcessNoLabels(IReadOnlyList<ProcessOrderGroup> groups)
    {
        var labels = new List<string>(groups.Count);
        var used = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        int nextNumber = 1;

        for (int i = 0; i < groups.Count; i++)
        {
            string label = NormalizeProcessNo(groups[i].ProcessNo);
            if (string.IsNullOrWhiteSpace(label) || used.Contains(label))
            {
                do
                {
                    label = nextNumber.ToString(CultureInfo.InvariantCulture);
                    nextNumber++;
                }
                while (used.Contains(label));
            }

            labels.Add(label);
            used.Add(label);
        }

        return labels;
    }

    private void ApplyDraggedProcessOrder(
        IReadOnlyList<ProcessOrderGroup> originalGroups,
        IReadOnlyList<ProcessOrderGroup> reorderedGroups,
        IReadOnlyList<string> positionLabels)
    {
        var remap = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        var newNoByGroup = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

        for (int i = 0; i < reorderedGroups.Count; i++)
        {
            string nextNo = NormalizeProcessNo(positionLabels[i]);
            newNoByGroup[reorderedGroups[i].GroupKey] = nextNo;

            string previousNo = NormalizeProcessNo(reorderedGroups[i].ProcessNo);
            if (!string.IsNullOrWhiteSpace(previousNo))
                remap[previousNo] = nextNo;
        }

        var updatedProcesses = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var group in reorderedGroups)
        {
            string nextNo = newNoByGroup[group.GroupKey];
            foreach (var target in GetLinkedProcesses(group.Process))
            {
                UpsertProcessSetting(
                    target,
                    nextNo,
                    RemapProcessNo(GetReferenceProcessNo(target), remap));
                updatedProcesses.Add(BuildExactProcessKey(target));
            }
        }

        foreach (var process in GetRoutingProcessOptions(_filterModel))
        {
            if (updatedProcesses.Contains(BuildExactProcessKey(process)))
                continue;

            string referenceNo = GetReferenceProcessNo(process);
            string remappedReferenceNo = RemapProcessNo(referenceNo, remap);
            if (!string.Equals(referenceNo, remappedReferenceNo, StringComparison.OrdinalIgnoreCase))
                UpsertProcessSetting(process, GetProcessNo(process), remappedReferenceNo);
        }

        _processSettings = MappingService.GetProcessRows();
        Activity.Log("Test 3", $"Drag reorder process groups={originalGroups.Count:N0}");
        SetStatus("Process order updated by drag.", false);
    }

    private static string RemapProcessNo(string processNo, IReadOnlyDictionary<string, string> remap)
    {
        string normalized = NormalizeProcessNo(processNo);
        return remap.TryGetValue(normalized, out string? nextNo) ? nextNo : normalized;
    }

    private async Task AddSelectedBomMaterialsToFocusedProcessAsync()
    {
        if (_focusedProcess is null)
        {
            SetStatus("Click DROP BOM Material Here first.", true);
            return;
        }

        var selectedMaterials = _bomMaterials
            .Where(IsBomMaterialSelected)
            .Where(IsSelectableMaterial)
            .ToList();

        if (selectedMaterials.Count == 0)
        {
            SetStatus("Select BOM material candidates first.", true);
            return;
        }

        int added = 0;
        int skipped = 0;
        var targetProcesses = GetSimultaneousMappingProcesses(_focusedProcess);
        var localMappings = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        try
        {
            foreach (var selected in selectedMaterials)
            {
                foreach (var resolved in ResolveMaterialsToMap(selected))
                {
                    foreach (var targetProcess in targetProcesses)
                    {
                        var targetMaterial = ResolveMaterialForTargetProcess(resolved, targetProcess);
                        if (targetMaterial is null)
                        {
                            skipped++;
                            continue;
                        }

                        string localKey = BuildLocalMappingKey(targetProcess, targetMaterial);
                        if (!localMappings.Add(localKey))
                        {
                            skipped++;
                            continue;
                        }

                        if (IsDuplicateMapping(targetProcess, targetMaterial))
                        {
                            skipped++;
                            continue;
                        }

                        var edit = BuildMappingEdit(targetProcess, targetMaterial, selected);
                        var replacement = FindReferenceReplacement(targetProcess, targetMaterial.MaterialCode, targetMaterial.MaterialName);
                        if (replacement is not null)
                        {
                            edit.Note = FirstNonBlank(
                                $"Replace Ref {GetReferenceProcessNo(targetProcess)}: {replacement.RawMaterialCode}",
                                edit.Note);
                        }
                        else if (!IsExactMaterial(
                            resolved.MaterialCode,
                            resolved.MaterialName,
                            targetMaterial.MaterialCode,
                            targetMaterial.MaterialName))
                        {
                            edit.Note = FirstNonBlank(
                                $"Auto L/R pair from {resolved.MaterialCode}",
                                edit.Note);
                        }

                        MappingService.Upsert(edit);
                        added++;
                    }
                }
            }

            if (added > 0)
            {
                Activity.Log(
                    "Test 3",
                    $"Batch mapping model={_focusedProcess.ModelName}, process={_focusedProcess.ProcessName}, targetProcesses={targetProcesses.Count:N0}, materials={added:N0}, skipped={skipped:N0}");
                _rows = MappingService.GetAll();
                _selectedBomMaterialCodes.Clear();
                SetStatus(
                    skipped > 0
                        ? $"Mapped {added:N0} material(s) to {targetProcesses.Count:N0} linked process(es). Skipped {skipped:N0}."
                        : $"Mapped {added:N0} material(s) to {targetProcesses.Count:N0} linked process(es).",
                    false);
            }
            else
            {
                SetStatus("Selected material candidate(s) are already mapped to that process.", true);
            }
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, true);
        }

        await Task.CompletedTask;
    }

    private static string BuildBomMaterialSelectionKey(BmesBomMaterialCandidate material)
        => NormalizeKey(material.MaterialCode);

    private List<BmesBomMaterialCandidate> SelectMaterialSourceRows()
    {
        var bomRows = _bomMaterials
            .Where(IsSelectableMaterial);

        var savedRows = AllModelProcessRows
            .SelectMany(r => r.Mappings)
            .Where(IsSelectableMapping)
            .Select(r => new BmesBomMaterialCandidate
            {
                ProductCode = r.ModelName,
                ProductName = r.ModelName,
                MaterialCode = r.RawMaterialCode,
                MaterialName = r.RawMaterialName,
                UsageQty = r.UsageQty,
                UsageUnit = r.UsageUnit,
                Source = "saved mapping",
            });

        return bomRows
            .Concat(savedRows)
            .GroupBy(BuildMaterialCandidateKey, StringComparer.OrdinalIgnoreCase)
            .Select(g => g
                .OrderBy(m => string.Equals(m.Source, "saved mapping", StringComparison.OrdinalIgnoreCase) ? 1 : 0)
                .ThenBy(m => m.BomLevel)
                .ThenByDescending(m => m.SourceRows)
                .First())
            .ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !ReactEditorEnabled)
            return;

        try
        {
            _reactEditorReference = DotNetObjectReference.Create(this);
            _reactEditorModule = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./test3-editor/test3-editor.js?v=20260815-1");
            await _reactEditorModule.InvokeVoidAsync(
                "mount",
                _reactEditorHost,
                _reactEditorReference,
                BuildReactEditorSnapshot());
        }
        catch (Exception ex)
        {
            Activity.Log("Test 3", "React editor mount failed: " + ex.Message);
            SetStatus("React 공정 편집기를 불러오지 못했습니다: " + ex.Message, true);
        }
    }

