    private Test3EditorSnapshot BuildReactEditorSnapshot()
    {
        var allRows = AllModelProcessRows;
        var orderedRows = GetReactOrderedRows();
        var sides = new List<Test3EditorSide>();

        foreach (string modelName in SelectedRoutingModelNames)
        {
            var modelRows = allRows
                .Where(row => string.Equals(row.Process.ModelName, modelName, StringComparison.OrdinalIgnoreCase))
                .ToList();
            var assignedRows = modelRows
                .Select(row => new { Row = row, Setting = GetExactProcessSetting(row.Process) })
                .Where(item => !string.IsNullOrWhiteSpace(item.Setting?.ProcessNo))
                .ToList();
            var laneCodes = assignedRows
                .Select(item => ResolveLaneCode(item.Setting))
                .Append("MAIN")
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(LaneSortIndex)
                .ThenBy(value => value, StringComparer.OrdinalIgnoreCase)
                .ToList();
            var lanes = new List<Test3EditorLane>();

            foreach (string laneCode in laneCodes)
            {
                var laneItems = assignedRows
                    .Where(item => string.Equals(ResolveLaneCode(item.Setting), laneCode, StringComparison.OrdinalIgnoreCase))
                    .OrderBy(item => ResolveLaneOrder(item.Setting))
                    .ThenBy(item => RoutingSortIndex(item.Row.Process))
                    .ToList();
                string mergeProcessNo = laneItems.LastOrDefault()?.Setting?.MergeProcessNo.Trim() ?? string.Empty;
                var mergeTarget = assignedRows.FirstOrDefault(item =>
                    string.Equals(ResolveLaneCode(item.Setting), "MAIN", StringComparison.OrdinalIgnoreCase) &&
                    string.Equals(NormalizeProcessNo(item.Setting?.ProcessNo), NormalizeProcessNo(mergeProcessNo), StringComparison.OrdinalIgnoreCase));
                lanes.Add(new Test3EditorLane
                {
                    LaneCode = laneCode,
                    MergeTargetProcessId = mergeTarget?.Row.GroupKey ?? string.Empty,
                    MergeTargetLabel = mergeTarget is null ? string.Empty : BuildReactProcessLabel(mergeTarget.Row, mergeTarget.Setting),
                    Processes = laneItems
                        .Select(item => BuildReactProcess(item.Row, item.Setting))
                        .ToList(),
                });
            }

            var assignedIds = assignedRows
                .Select(item => item.Row.GroupKey)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);
            sides.Add(new Test3EditorSide
            {
                ModelName = modelName,
                SideLabel = BuildModelSideLabel(modelName),
                Lanes = lanes,
                AvailableProcesses = modelRows
                    .Where(row => !assignedIds.Contains(row.GroupKey))
                    .OrderBy(row => RoutingSortIndex(row.Process))
                    .ThenBy(row => row.Process.ProcessName, StringComparer.OrdinalIgnoreCase)
                    .Select(row => BuildReactProcess(row, null))
                    .ToList(),
            });
        }

        var rowById = orderedRows.ToDictionary(row => row.GroupKey, StringComparer.OrdinalIgnoreCase);
        var materials = BuildMaterialAssignments(orderedRows)
            .Select(assignment =>
            {
                rowById.TryGetValue(assignment.SavedProcessGroupKey, out var assignedRow);
                var setting = assignedRow is null ? null : GetExactProcessSetting(assignedRow.Process);
                string laneCode = ResolveLaneCode(setting);
                string laneMergeProcessNo = string.Equals(laneCode, "MAIN", StringComparison.OrdinalIgnoreCase)
                    ? string.Empty
                    : orderedRows
                        .Where(row => string.Equals(row.Process.ModelName, assignment.ModelName, StringComparison.OrdinalIgnoreCase))
                        .Select(row => GetExactProcessSetting(row.Process))
                        .Where(candidate => string.Equals(ResolveLaneCode(candidate), laneCode, StringComparison.OrdinalIgnoreCase))
                        .OrderByDescending(ResolveLaneOrder)
                        .Select(candidate => candidate?.MergeProcessNo.Trim() ?? string.Empty)
                        .FirstOrDefault() ?? string.Empty;
                return new Test3EditorMaterial
                {
                    Id = assignment.Key,
                    ModelName = assignment.ModelName,
                    SideLabel = BuildModelSideLabel(assignment.ModelName),
                    MaterialCode = assignment.RawMaterialCode,
                    MaterialName = assignment.RawMaterialName,
                    UsageQty = assignment.UsageQty,
                    UsageUnit = assignment.UsageUnit,
                    AssignedProcessId = assignedRow?.GroupKey ?? string.Empty,
                    AssignedProcessLabel = assignedRow is null ? string.Empty : BuildReactProcessLabel(assignedRow, setting),
                    ScopeLabel = assignedRow is null ? "미설정" : BuildReactMaterialScope(laneCode, setting, laneMergeProcessNo),
                };
            })
            .OrderBy(item => ModelSideSortIndex(item.ModelName))
            .ThenBy(item => item.MaterialName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(item => item.MaterialCode, StringComparer.OrdinalIgnoreCase)
            .ToList();

        return new Test3EditorSnapshot
        {
            ModelNames = _modelNames,
            SelectedModel = _filterModel.Trim(),
            Sides = sides,
            Materials = materials,
            BomBusy = _bomBusy,
            BomSource = _bomLoadSource,
            BomError = _bomError,
            StatusMessage = _statusMessage,
            StatusError = _statusError,
        };
    }

    private void SaveReactLayout(Test3EditorLayoutRequest request)
    {
        var selectedModels = SelectedRoutingModelNames.ToHashSet(StringComparer.OrdinalIgnoreCase);
        if (selectedModels.Count == 0)
            throw new InvalidOperationException("먼저 모델을 선택하세요.");

        var allRows = AllModelProcessRows;
        var rowsById = allRows.ToDictionary(row => row.GroupKey, StringComparer.OrdinalIgnoreCase);
        var requested = new List<(Test3EditorLaneRequest Lane, string LaneCode, Test3ProcessRow Row, int Index)>();
        var usedIds = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        foreach (var lane in request?.Lanes ?? [])
        {
            string modelName = lane.ModelName?.Trim() ?? string.Empty;
            if (!selectedModels.Contains(modelName))
                throw new InvalidOperationException("선택한 L/R 모델과 다른 공정 라인이 포함되어 있습니다.");

            string laneCode = NormalizeLaneCode(lane.LaneCode);
            for (int index = 0; index < lane.ProcessIds.Count; index++)
            {
                string processId = lane.ProcessIds[index]?.Trim() ?? string.Empty;
                if (!rowsById.TryGetValue(processId, out var row) ||
                    !string.Equals(row.Process.ModelName, modelName, StringComparison.OrdinalIgnoreCase))
                {
                    throw new InvalidOperationException("공정 목록이 변경되었습니다. 모델을 다시 불러온 뒤 재시도하세요.");
                }

                if (!usedIds.Add(processId))
                    throw new InvalidOperationException("같은 공정은 하나의 MAIN/SUB 라인에만 배치할 수 있습니다.");
                requested.Add((lane, laneCode, row, index));
            }
        }

        var processNoById = requested.ToDictionary(
            item => item.Row.GroupKey,
            item => BuildLaneProcessNo(item.LaneCode, item.Index + 1),
            StringComparer.OrdinalIgnoreCase);
        var requestedById = requested.ToDictionary(item => item.Row.GroupKey, StringComparer.OrdinalIgnoreCase);

        foreach (var setting in _processSettings
                     .Where(setting => selectedModels.Contains(setting.ModelName.Trim()))
                     .ToList())
        {
            var row = allRows.FirstOrDefault(candidate =>
                candidate.LinkedProcesses.Any(process => ProcessSettingMatches(setting, process)));
            if (row is null || !usedIds.Contains(row.GroupKey))
                MappingService.DeleteProcess(setting.Id);
        }

        foreach (var item in requested)
        {
            string processNo = processNoById[item.Row.GroupKey];
            string referenceNo = item.Index == 0
                ? string.Empty
                : BuildLaneProcessNo(item.LaneCode, item.Index);
            string mergeProcessNo = string.Empty;

            if (!string.Equals(item.LaneCode, "MAIN", StringComparison.OrdinalIgnoreCase) &&
                item.Index == item.Lane.ProcessIds.Count - 1 &&
                !string.IsNullOrWhiteSpace(item.Lane.MergeTargetProcessId))
            {
                string targetId = item.Lane.MergeTargetProcessId.Trim();
                if (!requestedById.TryGetValue(targetId, out var target) ||
                    !string.Equals(target.Row.Process.ModelName, item.Row.Process.ModelName, StringComparison.OrdinalIgnoreCase) ||
                    !string.Equals(target.LaneCode, "MAIN", StringComparison.OrdinalIgnoreCase))
                {
                    throw new InvalidOperationException($"{item.LaneCode}의 합류 지점은 같은 L/R의 MAIN 공정이어야 합니다.");
                }

                mergeProcessNo = processNoById[targetId];
            }

            foreach (var process in item.Row.LinkedProcesses)
                UpsertProcessSetting(process, processNo, referenceNo, item.LaneCode, mergeProcessNo);
        }

        _processSettings = MappingService.GetProcessRows();
        TrimMaterialEdits();
        Activity.Log("Test 3", $"Save React MAIN/SUB layout model={_filterModel.Trim()}, rows={requested.Count:N0}");
    }

    private List<Test3ProcessRow> GetReactOrderedRows()
        => AllModelProcessRows
            .Where(row => !string.IsNullOrWhiteSpace(GetExactProcessSetting(row.Process)?.ProcessNo))
            .OrderBy(row => ModelSideSortIndex(row.Process.ModelName))
            .ThenBy(row => LaneSortIndex(ResolveLaneCode(GetExactProcessSetting(row.Process))))
            .ThenBy(row => ResolveLaneOrder(GetExactProcessSetting(row.Process)))
            .ThenBy(row => RoutingSortIndex(row.Process))
            .ToList();

    private ProcessMaterialProcessRow? GetExactProcessSetting(RoutingProcessOption process)
        => _processSettings.FirstOrDefault(setting => ProcessSettingMatches(setting, process));

    private Test3EditorProcess BuildReactProcess(Test3ProcessRow row, ProcessMaterialProcessRow? setting)
        => new()
        {
            Id = row.GroupKey,
            ModelName = row.Process.ModelName,
            ProcessCode = row.Process.ProcessCode,
            ProcessName = row.Process.ProcessName,
            ProcessType = row.Process.ProcessType,
            LaneCode = string.IsNullOrWhiteSpace(setting?.ProcessNo) ? string.Empty : ResolveLaneCode(setting),
            ProcessNo = setting?.ProcessNo.Trim() ?? string.Empty,
            Order = string.IsNullOrWhiteSpace(setting?.ProcessNo) ? 0 : ResolveLaneOrder(setting),
        };

    private static string BuildReactProcessLabel(Test3ProcessRow row, ProcessMaterialProcessRow? setting)
    {
        string position = setting is null
            ? string.Empty
            : $"{ResolveLaneCode(setting)} #{ResolveLaneOrder(setting)} · ";
        return position + FirstNonBlank(row.Process.ProcessName, row.Process.ProcessCode);
    }

    private static string BuildReactMaterialScope(
        string laneCode,
        ProcessMaterialProcessRow? setting,
        string laneMergeProcessNo)
    {
        int order = ResolveLaneOrder(setting);
        if (string.Equals(laneCode, "MAIN", StringComparison.OrdinalIgnoreCase))
            return $"MAIN #{order} → MAIN 마지막";

        return string.IsNullOrWhiteSpace(laneMergeProcessNo)
            ? $"{laneCode} #{order} → {laneCode} 마지막"
            : $"{laneCode} #{order} → {laneCode} 마지막 → {laneMergeProcessNo} → MAIN 마지막";
    }

    private static string ResolveLaneCode(ProcessMaterialProcessRow? setting)
    {
        if (!string.IsNullOrWhiteSpace(setting?.LaneCode))
            return NormalizeLaneCode(setting.LaneCode);

        string processNo = NormalizeProcessNo(setting?.ProcessNo);
        int separator = processNo.IndexOf('-');
        return separator > 0 ? NormalizeLaneCode(processNo[..separator]) : "MAIN";
    }

    private static int ResolveLaneOrder(ProcessMaterialProcessRow? setting)
    {
        string processNo = NormalizeProcessNo(setting?.ProcessNo);
        int separator = processNo.LastIndexOf('-');
        string number = separator >= 0 ? processNo[(separator + 1)..] : processNo;
        return int.TryParse(number, NumberStyles.Integer, CultureInfo.InvariantCulture, out int value)
            ? value
            : int.MaxValue;
    }

    private static string NormalizeLaneCode(string? value)
    {
        string laneCode = NormalizeKey(value ?? string.Empty);
        if (string.Equals(laneCode, "MAIN", StringComparison.OrdinalIgnoreCase))
            return "MAIN";
        if (laneCode.StartsWith("SUB", StringComparison.OrdinalIgnoreCase) &&
            int.TryParse(laneCode[3..], NumberStyles.Integer, CultureInfo.InvariantCulture, out int number) &&
            number is >= 1 and <= 99)
        {
            return $"SUB{number}";
        }

        throw new InvalidOperationException("공정 라인은 MAIN 또는 SUB1~SUB99 형식이어야 합니다.");
    }

    private static int LaneSortIndex(string laneCode)
    {
        if (string.Equals(laneCode, "MAIN", StringComparison.OrdinalIgnoreCase))
            return 0;
        return int.TryParse(laneCode.AsSpan(Math.Min(3, laneCode.Length)), out int number)
            ? number
            : int.MaxValue;
    }

    private static string BuildLaneProcessNo(string laneCode, int order)
        => $"{NormalizeLaneCode(laneCode)}-{order.ToString(CultureInfo.InvariantCulture)}";

    private static string BuildRoutingBaseModelName(string? modelName)
    {
        string[] parts = (modelName ?? string.Empty)
            .Trim()
            .Split('-', StringSplitOptions.None);
        for (int index = parts.Length - 1; index > 0; index--)
        {
            if (string.Equals(parts[index], "L", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(parts[index], "R", StringComparison.OrdinalIgnoreCase))
            {
                return string.Join('-', parts.Take(index));
            }
        }

        return string.Empty;
    }

