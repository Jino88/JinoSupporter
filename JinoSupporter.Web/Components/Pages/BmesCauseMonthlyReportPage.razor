@using JinoSupporter.Web.Services

<div class="cause-report-shell">
    <div class="cause-report-main">
        <div class="cause-report-header">
            <div>
                <div class="cause-report-title">원인 비중</div>
                <div class="cause-report-subtitle">MODEL / Type / Process / NG NAME / 해당월 불량률 / 원인 / 비중</div>
            </div>
            <div class="cause-report-count">@CauseRows.Count row(s)</div>
        </div>

        <div class="cause-table-wrap">
            <table class="cause-table">
                <thead>
                    <tr>
                        <th style="width:170px;">MODEL</th>
                        <th style="width:86px;">Type</th>
                        <th style="width:230px;">Process</th>
                        <th style="width:180px;">NG NAME</th>
                        @foreach (var col in MonthColumns)
                        {
                            <th style="width:96px;">@FormatCauseMonthHeader(col)</th>
                        }
                        <th style="width:54px;">No</th>
                        <th style="width:170px;">원인</th>
                        <th style="width:70px;">비중</th>
                        @foreach (var col in MonthColumns)
                        {
                            <th style="width:112px;">@FormatWeightedMonthHeader(col)</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < CauseRows.Count; i++)
                    {
                        var row = CauseRows[i];
                        if (row.IsSubtotal)
                        {
                            <tr class="cause-subtotal-row">
                                <td>@row.Model</td>
                                <td></td>
                                <td>SUB TOTAL</td>
                                <td></td>
                                @foreach (var col in MonthColumns)
                                {
                                    double ppm = RowMonthPpm(row, i, col.Key);
                                    <td class="@MonthRateClass(ppm)">@FormatPpm(ppm)</td>
                                }
                                <td></td>
                                <td></td>
                                <td>100%</td>
                                @foreach (var col in MonthColumns)
                                {
                                    double ppm = WeightedMonthPpm(row, i, col.Key);
                                    <td class="@MonthRateClass(ppm)">@FormatPpm(ppm)</td>
                                }
                            </tr>
                        }
                        else
                        {
                            <tr class="@CauseRowClass(row)">
                                <td class="cause-model-cell">@row.Model</td>
                                <td>@row.Type</td>
                                <td>@row.Process</td>
                                <td>@row.NgName</td>
                                @foreach (var col in MonthColumns)
                                {
                                    double ppm = RowMonthPpm(row, i, col.Key);
                                    <td class="@MonthRateClass(ppm)">@FormatPpm(ppm)</td>
                                }
                                <td class="cause-center">@row.No</td>
                                <td>@row.Cause</td>
                                <td class="cause-share">@row.Share</td>
                                @foreach (var col in MonthColumns)
                                {
                                    double ppm = WeightedMonthPpm(row, i, col.Key);
                                    <td class="@MonthRateClass(ppm)">@FormatPpm(ppm)</td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <aside class="cause-monthly-panel">
        <div class="cause-report-header cause-monthly-header">
            <div>
                <div class="cause-report-title">월별 불량률</div>
                <div class="cause-report-subtitle">선택 모델 기준 PPM</div>
            </div>
            @if (_startDate is not null && _endDate is not null)
            {
                <div class="cause-report-count">@_startDate.Value.ToString("yyyy-MM-dd") ~ @_endDate.Value.ToString("yyyy-MM-dd")</div>
            }
        </div>

        @if (_hierarchy?.ByMid is null)
        {
            <div class="cause-empty">
                상단에서 기간과 Sub Group을 선택한 뒤 Generate Report를 실행하면 월별 불량률이 표시됩니다.
            </div>
        }
        else if (MonthColumns.Count == 0)
        {
            <div class="cause-empty">선택 기간에 표시할 월별 데이터가 없습니다.</div>
        }
        else
        {
            <div class="cause-monthly-wrap">
                <table class="cause-monthly-table">
                    <thead>
                        <tr>
                            <th style="min-width:150px;">MODEL</th>
                            @foreach (var col in MonthColumns)
                            {
                                <th>@FormatCauseMonthHeader(col)</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (string model in Models)
                        {
                            <tr>
                                <td class="cause-month-model">@model</td>
                                @foreach (var col in MonthColumns)
                                {
                                    double ppm = ModelMonthPpm(model, col.Key);
                                    <td class="@PpmClass(ppm)">
                                        @FormatPpm(ppm)
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </aside>
</div>

<style>
    .cause-report-shell {
        display: grid;
        grid-template-columns: minmax(720px, 1fr) minmax(360px, 460px);
        gap: 16px;
        align-items: start;
        padding: 0 12px 18px;
    }

    .cause-report-main,
    .cause-monthly-panel {
        min-width: 0;
        border: 1px solid #d7dee8;
        background: var(--panel, #fff);
    }

    .cause-report-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 10px 12px;
        border-bottom: 1px solid var(--line, var(--line, #dde1e7));
        background: var(--panel-2, #f5f6f9);
    }

    .cause-report-title {
        font-size: 13px;
        font-weight: 700;
        color: var(--ink, #0f1319);
    }

    .cause-report-subtitle,
    .cause-report-count {
        font-size: 11px;
        color: var(--ink-2, #4a5461);
        white-space: nowrap;
    }

    .cause-table-wrap,
    .cause-monthly-wrap {
        overflow: auto;
        max-height: calc(100vh - 285px);
    }

    .cause-table,
    .cause-monthly-table {
        width: max-content;
        min-width: 100%;
        border-collapse: collapse;
        font-size: 12px;
        white-space: nowrap;
    }

    .cause-table th,
    .cause-monthly-table th {
        position: sticky;
        top: 0;
        z-index: 1;
        background: #eaf1f8;
        color: var(--ink-2, #4a5461);
        border-bottom: 1px solid var(--line-2, #c6ccd5);
        padding: 7px 9px;
        font-size: 11px;
        font-weight: 700;
        text-align: left;
    }

    .cause-table td,
    .cause-monthly-table td {
        border-bottom: 1px solid #eef2f7;
        padding: 6px 9px;
        color: var(--ink, #0f1319);
        vertical-align: middle;
    }

    .cause-row-empty td {
        color: var(--ink-2, #4a5461);
    }

    .cause-model-cell,
    .cause-month-model {
        font-weight: 600;
        color: var(--ink, #0f1319);
    }

    .cause-center,
    .cause-month-rate,
    .cause-share,
    .cause-monthly-table td:not(.cause-month-model) {
        text-align: right;
        font-variant-numeric: tabular-nums;
    }

    .cause-subtotal-row td {
        background: var(--panel-3, #eceef2);
        border-top: 1px solid var(--line-2, #c6ccd5);
        border-bottom: 1px solid var(--line-2, #c6ccd5);
        font-weight: 700;
        color: var(--ink, #0f1319);
    }

    .cause-subtotal-row td:nth-child(3) {
        text-align: center;
        letter-spacing: .2px;
    }

    .cause-share {
        font-weight: 700;
    }

    .cause-month-rate {
        color: var(--ink, #0f1319) !important;
        font-weight: 700;
    }

    .cause-monthly-header {
        min-height: 58px;
    }

    .cause-empty {
        padding: 28px 20px;
        color: var(--ink-2, #4a5461);
        font-size: 12px;
        text-align: center;
    }

    .cause-ppm-zero {
        color: var(--line-2, #c6ccd5) !important;
    }

    .cause-ppm-value {
        color: var(--ink, #0f1319) !important;
        font-weight: 700;
    }

    @@media (max-width: 1200px) {
        .cause-report-shell {
            grid-template-columns: 1fr;
        }

        .cause-table-wrap,
        .cause-monthly-wrap {
            max-height: none;
        }
    }
</style>

@code {
    private DateTime? _startDate;
    private DateTime? _endDate;
    private HierReports? _hierarchy;
    private List<ModelGroupRecord> _selectedGroups = [];

    // ── Static-HTML export mode ────────────────────────────────────────────────
    // Fed the shared Daily hierarchy (no DB access of its own) via HtmlRenderer.
    [Parameter] public bool ExportMode { get; set; }
    [Parameter] public DateTime? ExportStart { get; set; }
    [Parameter] public DateTime? ExportEnd { get; set; }
    [Parameter] public IReadOnlyList<ModelGroupRecord>? ExportGroups { get; set; }
    [Parameter] public HierReports? ExportSharedHierarchy { get; set; }
    private bool _exportGenerated;

    protected override async Task OnParametersSetAsync()
    {
        if (ExportMode && !_exportGenerated
            && ExportStart is { } start && ExportEnd is { } end
            && ExportGroups is { Count: > 0 } groups && ExportSharedHierarchy is { } hierarchy)
        {
            _exportGenerated = true;
            await UseSharedHierarchyReportAsync(start, end, groups, hierarchy);
        }
    }

    private IReadOnlyList<NgRateReportService.PeriodColumn> MonthColumns =>
        _hierarchy?.ByMid?.MonthCols ?? [];

    private static IReadOnlyList<string> Models =>
        CauseRows.Select(r => r.Model)
            .Where(m => !string.IsNullOrWhiteSpace(m))
            .Distinct(StringComparer.Ordinal)
            .ToList();

    public Task UseSharedHierarchyReportAsync(
        DateTime startDate,
        DateTime endDate,
        IReadOnlyList<ModelGroupRecord> selectedGroups,
        HierReports sharedHierarchy,
        IProgress<string>? progress = null)
    {
        _startDate = startDate.Date;
        _endDate = endDate.Date;
        _selectedGroups = selectedGroups.ToList();
        _hierarchy = sharedHierarchy;
        progress?.Report("Using Daily report data.");
        return InvokeAsync(StateHasChanged);
    }

    private double RowMonthPpm(CauseRow row, int rowIndex, string colKey)
    {
        if (string.IsNullOrWhiteSpace(row.Model) || string.IsNullOrWhiteSpace(colKey)) return 0;

        if (row.IsSubtotal)
            return SubtotalMonthPpm(rowIndex, colKey);

        return DetailMonthPpm(row, colKey);
    }

    private double SubtotalMonthPpm(int subtotalIndex, string colKey)
    {
        if (subtotalIndex < 0 || subtotalIndex >= CauseRows.Count) return 0;

        string model = CauseRows[subtotalIndex].Model;
        double total = 0;
        for (int i = subtotalIndex + 1; i < CauseRows.Count; i++)
        {
            var child = CauseRows[i];
            if (child.IsSubtotal) break;
            if (!string.Equals(child.Model, model, StringComparison.Ordinal)) break;

            total += DetailMonthPpm(child, colKey);
        }

        return total;
    }

    private double DetailMonthPpm(CauseRow row, string colKey)
    {
        if (string.IsNullOrWhiteSpace(row.Process) || string.IsNullOrWhiteSpace(row.NgName))
            return 0;

        return ProcessNgMonthPpm(row, colKey);
    }

    private double WeightedMonthPpm(CauseRow row, int rowIndex, string colKey)
    {
        double share = ParseShare(row.Share);
        if (share <= 0) return 0;

        int subtotalIndex = row.IsSubtotal ? rowIndex : ParentSubtotalIndex(rowIndex);
        if (subtotalIndex < 0) return 0;

        return SubtotalMonthPpm(subtotalIndex, colKey) * share;
    }

    private static double ParseShare(string share)
    {
        string text = (share ?? string.Empty).Trim().TrimEnd('%').Trim();
        if (!double.TryParse(
                text,
                System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture,
                out double value))
        {
            return 0;
        }

        return value > 1 ? value / 100d : value;
    }

    private static int ParentSubtotalIndex(int rowIndex)
    {
        if (rowIndex < 0 || rowIndex >= CauseRows.Count) return -1;

        string model = CauseRows[rowIndex].Model;
        for (int i = rowIndex - 1; i >= 0; i--)
        {
            var row = CauseRows[i];
            if (!string.Equals(row.Model, model, StringComparison.Ordinal)) break;
            if (row.IsSubtotal) return i;
        }

        return -1;
    }

    private double ProcessNgMonthPpm(CauseRow row, string colKey)
    {
        var report = _hierarchy?.ByMid;
        if (report is null) return 0;

        var keys = FindModelKeys(row.Model).ToHashSet(StringComparer.Ordinal);
        if (keys.Count == 0) return 0;

        double rawSum = 0;
        int rawCount = 0;
        foreach (var item in report.GroupRawIn)
        {
            var key = item.Key;
            if (!keys.Contains(key.Group)) continue;
            if (!string.Equals(key.PeriodKey, colKey, StringComparison.Ordinal)) continue;
            if (!LooseTextMatches(key.PN, row.Process)) continue;
            if (!LooseTextMatches(key.NG, row.NgName)) continue;
            if (!string.IsNullOrWhiteSpace(row.Type) && !LooseTextMatches(key.PT, row.Type)) continue;

            double ppm = ToPpm(item.Value.I, item.Value.N);
            if (ppm <= 0) continue;

            rawSum += ppm;
            rawCount++;
        }

        if (rawCount > 0)
            return rawSum / rawCount;

        double sum = 0;
        int count = 0;
        foreach (var reasonRow in report.ReasonRows.Where(r => !r.IsTotal))
        {
            if (!LooseTextMatches(reasonRow.ProcessName, row.Process)) continue;
            if (!LooseTextMatches(reasonRow.NgName, row.NgName)) continue;
            if (!string.IsNullOrWhiteSpace(row.Type) &&
                !LooseTextMatches(reasonRow.ProcessType, row.Type))
            {
                continue;
            }

            foreach (var group in reasonRow.Groups)
            {
                if (!keys.Contains(group.GroupName)) continue;

                double value = group.Ppm.GetValueOrDefault(colKey);
                if (value <= 0) continue;

                sum += value;
                count++;
            }
        }

        return count == 0 ? 0 : sum / count;
    }

    private static double ToPpm(double input, double ng)
        => input > 0 ? Math.Round((ng / input) * 1_000_000, 0) : 0;

    private double ModelMonthPpm(string model, string colKey)
    {
        if (_hierarchy?.ByMid is null) return 0;

        var keys = FindModelKeys(model).ToList();
        if (keys.Count == 0) return 0;

        double sum = 0;
        int count = 0;
        foreach (string key in keys)
        {
            var rows = _hierarchy.ByMid.GroupSummary.GetValueOrDefault(key);
            double value = rows?.FirstOrDefault(r => r.IsTotal)?.Ppm.GetValueOrDefault(colKey) ?? 0;
            if (value <= 0) continue;

            sum += value;
            count++;
        }

        return count == 0 ? 0 : sum / count;
    }

    private IEnumerable<string> FindModelKeys(string model)
    {
        if (_hierarchy?.ByMid is null) yield break;

        var seen = new HashSet<string>(StringComparer.Ordinal);
        foreach (var group in _selectedGroups)
        {
            foreach (var mid in group.MidGroups)
            {
                if (ModelMatches(mid.Material, model))
                {
                    string key = NgRateModeSupport.ModelKey(group.Name, mid.Material);
                    if (seen.Add(key))
                        yield return key;
                }
            }
        }

        foreach (string key in _hierarchy.ByMid.GroupSummary.Keys)
        {
            string material = MaterialNameFromKey(key);
            if (ModelMatches(material, model) && seen.Add(key))
                yield return key;
        }
    }

    private static bool ModelMatches(string material, string requestedModel)
    {
        string materialKey = NormalizeModel(material);
        if (materialKey.Length == 0) return false;

        foreach (string alias in ModelAliases(requestedModel))
        {
            string aliasKey = NormalizeModel(alias);
            if (aliasKey.Length == 0) continue;
            if (string.Equals(materialKey, aliasKey, StringComparison.OrdinalIgnoreCase))
                return true;
            if (materialKey.Contains(aliasKey, StringComparison.OrdinalIgnoreCase) ||
                aliasKey.Contains(materialKey, StringComparison.OrdinalIgnoreCase))
                return true;
        }

        return false;
    }

    private static IEnumerable<string> ModelAliases(string model)
    {
        yield return model;

        string[] parts = model.Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length <= 1) yield break;

        string prefix = string.Empty;
        int dash = parts[0].LastIndexOf("-", StringComparison.Ordinal);
        if (dash >= 0)
            prefix = parts[0][..(dash + 1)];

        foreach (string part in parts)
        {
            yield return part;
            if (!string.IsNullOrEmpty(prefix) && !part.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
                yield return prefix + part;
        }
    }

    private static string MaterialNameFromKey(string key)
    {
        int idx = key.IndexOf("::", StringComparison.Ordinal);
        return idx >= 0 && idx + 2 < key.Length ? key[(idx + 2)..] : key;
    }

    private static string NormalizeModel(string value)
        => new((value ?? string.Empty)
            .ToUpperInvariant()
            .Where(char.IsLetterOrDigit)
            .ToArray());

    private static string FormatPpm(double ppm)
        => ppm <= 0 ? string.Empty : ((long)Math.Round(ppm)).ToString("N0");

    private static string PpmClass(double ppm)
        => ppm <= 0 ? "cause-ppm-zero" : "cause-ppm-value";

    private static string MonthRateClass(double ppm)
        => ppm <= 0
            ? "cause-month-rate cause-ppm-zero"
            : "cause-month-rate cause-ppm-value";

    private static string FormatCauseMonthHeader(NgRateReportService.PeriodColumn col)
        => FormatMonthLabel(col.Key, col.Header);

    private static string FormatWeightedMonthHeader(NgRateReportService.PeriodColumn col)
        => FormatMonthLabel(col.Key, col.Header) + " NG Rate";

    private static string FormatMonthLabel(string key, string fallback)
    {
        string raw = key.StartsWith("M:", StringComparison.Ordinal) ? key[2..] : key;
        return raw.Length >= 6 &&
               int.TryParse(raw[4..], out int month)
            ? month.ToString(System.Globalization.CultureInfo.InvariantCulture) + "월"
            : fallback;
    }

    private static string CauseRowClass(CauseRow row)
        => string.IsNullOrWhiteSpace(row.Cause) && string.IsNullOrWhiteSpace(row.Share)
            ? "cause-row-empty"
            : string.Empty;

    private static bool LooseTextMatches(string left, string right)
    {
        string leftKey = NormalizeTextKey(left);
        string rightKey = NormalizeTextKey(right);
        if (leftKey.Length == 0 || rightKey.Length == 0) return false;
        return string.Equals(leftKey, rightKey, StringComparison.OrdinalIgnoreCase) ||
               leftKey.Contains(rightKey, StringComparison.OrdinalIgnoreCase) ||
               rightKey.Contains(leftKey, StringComparison.OrdinalIgnoreCase);
    }

    private static string NormalizeTextKey(string value)
        => new((value ?? string.Empty)
            .ToUpperInvariant()
            .Where(char.IsLetterOrDigit)
            .ToArray());

    private static CauseRow Subtotal(string model) => new(model, "", "", "", "", "", "", true);

    private static CauseRow Row(
        string model,
        string type,
        string process,
        string ngName,
        string no = "",
        string cause = "",
        string share = "")
        => new(model, type, process, ngName, no, cause, share, false);

    private sealed record CauseRow(
        string Model,
        string Type,
        string Process,
        string NgName,
        string No,
        string Cause,
        string Share,
        bool IsSubtotal);

    private static readonly IReadOnlyList<CauseRow> CauseRows =
