@page "/bmes/daily-report"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Globalization
@using JinoSupporter.Web.Services
@implements IDisposable
@inject BmesDailyReportService DailyReport

<PageTitle>DAILY REPORT</PageTitle>

<div class="dr-root">

    <div class="dr-titlebar">
        <div>
            <div class="dr-kicker">BMES · Defect rate trend by model</div>
            <h1>DAILY REPORT</h1>
            <div class="dr-subtitle">
                @if (_snapshot is not null)
                {
                    <span>@_snapshot.StartDate.ToString("yyyy-MM-dd") ~ @_snapshot.EndDate.ToString("yyyy-MM-dd")</span>
                    <span class="dr-dot">·</span>
                    <span>as of @_snapshot.GeneratedAt.ToString("MM-dd HH:mm")</span>
                }
                else
                {
                    <span>Last 2 months – yesterday</span>
                }
            </div>
        </div>
        <div class="dr-actions">
            @if (DailyReport.IsRefreshing)
            {
                <span class="dr-refreshing"><span class="dr-spinner"></span>Fetching from BMES…</span>
            }
            <button class="dr-btn" @onclick="RefreshNow" disabled="@DailyReport.IsRefreshing">Refresh now</button>
            <a class="dr-btn dr-btn-ghost" href="report/bmes">Full report →</a>
        </div>
    </div>

    @if (_snapshot is null)
    {
        <div class="dr-empty">
            @if (DailyReport.IsRefreshing)
            {
                <span class="dr-spinner dr-spinner-lg"></span>
                <p>Aggregating the last two months from BMES. This can take a few minutes.</p>
                @if (RecentLogs() is { Count: > 0 } logs)
                {
                    <div class="dr-log">
                        @foreach (string line in logs)
                        {
                            <div>@line</div>
                        }
                    </div>
                }
            }
            else
            {
                <p>No report yet. Click <strong>Refresh now</strong> to build the first one.</p>
            }
        </div>
    }
    else if (!string.IsNullOrEmpty(_snapshot.Error))
    {
        <div class="dr-error">
            <strong>Could not build the report.</strong>
            <span>@_snapshot.Error</span>
        </div>
    }
    else
    {
        @* ── Headline stats: single numbers, so no chart ──────────────────── *@
        <div class="dr-stats">
            <div class="dr-stat">
                <div class="dr-stat-label">Latest week (@_snapshot.RecentWeekHeader) overall PPM</div>
                <div class="dr-stat-value">@Ppm(_snapshot.OverallRecentPpm)</div>
            </div>
            <div class="dr-stat">
                <div class="dr-stat-label">Previous week (@_snapshot.PreviousWeekHeader) overall PPM</div>
                <div class="dr-stat-value dr-muted">@Ppm(_snapshot.OverallPreviousPpm)</div>
            </div>
            <div class="dr-stat">
                <div class="dr-stat-label">
                    Week-over-week change
                    @if (!string.IsNullOrEmpty(_snapshot.PreviousWeekHeader))
                    {
                        <span class="dr-stat-sub">vs @_snapshot.PreviousWeekHeader</span>
                    }
                </div>
                @{
                    double overallDelta = _snapshot.OverallRecentPpm - _snapshot.OverallPreviousPpm;
                }
                <div class="dr-stat-value @DeltaClass(overallDelta)">
                    @SignedPpm(overallDelta)
                </div>
            </div>
            <div class="dr-stat">
                <div class="dr-stat-label">Latest day (@_snapshot.RecentDayHeader) overall PPM</div>
                <div class="dr-stat-value">@Ppm(_snapshot.OverallRecentDayPpm)</div>
            </div>
            <div class="dr-stat">
                <div class="dr-stat-label">
                    Day-over-day change
                    @if (!string.IsNullOrEmpty(_snapshot.PreviousDayHeader))
                    {
                        <span class="dr-stat-sub">vs @_snapshot.PreviousDayHeader</span>
                    }
                </div>
                @{
                    double dayDelta = _snapshot.OverallRecentDayPpm - _snapshot.OverallPreviousDayPpm;
                }
                <div class="dr-stat-value @DeltaClass(dayDelta)">
                    @SignedPpm(dayDelta)
                </div>
            </div>
            <div class="dr-stat">
                <div class="dr-stat-label">Models analysed</div>
                <div class="dr-stat-value dr-muted">@_snapshot.ModelCount</div>
            </div>
        </div>

        @* One grid holds both blocks: Worsened and Improved sit side by side, week over
           week on the first row and day over day underneath. Auto-fit drops everything
           back to a single column when the window is too narrow for two tables. *@
        <div class="dr-sections">
            @foreach (RankBlock block in BuildBlocks(_snapshot))
            {
                <div class="dr-block-head">
                    <h2>@block.Title</h2>
                    <span class="dr-block-note">@block.Note</span>
                </div>

                @foreach (RankSection sec in block.Sections)
                {
                    <section class="dr-section">
                        <div class="dr-section-head">
                            <h2>
                                <span class="dr-badge @(sec.IsWorse ? "dr-badge-worse" : "dr-badge-better")">
                                    @(sec.IsWorse ? "+ Worsened" : "− Improved")
                                </span>
                                Top @sec.Rows.Count models
                            </h2>
                            <div class="dr-section-note">@sec.Note</div>
                        </div>

                        @if (sec.Rows.Count == 0)
                        {
                            <div class="dr-none">@sec.EmptyText</div>
                        }
                        else
                        {
                            <div class="dr-table-wrap">
                                <table class="dr-table">
                                    <thead>
                                        <tr>
                                            <th class="dr-th-rank">#</th>
                                            <th>Model</th>
                                            <th class="dr-th-num">Latest</th>
                                            <th class="dr-th-num">Baseline</th>
                                            <th class="dr-th-num">Change</th>
                                            <th class="dr-th-bar">@(sec.IsWorse ? "Increase" : "Decrease")</th>
                                            <th class="dr-th-spark">@(sec.IsDaily ? "Daily" : "Weekly") trend <span class="dr-th-hint">← latest</span></th>
                                            <th class="dr-th-cause">Top 5 defect causes <span class="dr-th-hint">vs baseline</span></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < sec.Rows.Count; i++)
                                        {
                                            BmesDailyReportModelRow row = sec.Rows[i];
                                            <tr>
                                                <td class="dr-td-rank">@(i + 1)</td>
                                                <td class="dr-td-name">
                                                    <div class="dr-model" title="@row.ModelName">@row.ModelName</div>
                                                    <div class="dr-model-group" title="@ModelPath(row)">@ModelPath(row)</div>
                                                </td>
                                                <td class="dr-td-num dr-strong">@Ppm(row.RecentPpm)</td>
                                                @* Which period the comparison actually landed on. A model
                                                   idle last week is measured against the last week it ran,
                                                   so the label under the number is what makes the Change
                                                   column readable. *@
                                                <td class="dr-td-num dr-muted">
                                                    @if (row.BaselineStepsBack > 0)
                                                    {
                                                        @Ppm(row.PreviousPpm)
                                                        <div class="dr-baseline" title="@BaselineTooltip(row, sec)">
                                                            @row.BaselineHeader
                                                            @if (row.BaselineStepsBack > 1)
                                                            {
                                                                <span class="dr-baseline-gap">−@(row.BaselineStepsBack)@(sec.StepUnit)</span>
                                                            }
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span class="dr-spark-empty">—</span>
                                                        <div class="dr-baseline">no earlier @sec.PeriodNoun</div>
                                                    }
                                                </td>
                                                <td class="dr-td-num @DeltaClass(row.DeltaPpm)">
                                                    @SignedPpm(row.DeltaPpm)
                                                    <span class="dr-pct">@Pct(row.DeltaPercent)</span>
                                                </td>
                                                <td class="dr-td-bar">
                                                    <div class="dr-bar-track" title="@DeltaTooltip(row, sec.IsWorse)">
                                                        <div class="dr-bar @(sec.IsWorse ? "dr-bar-worse" : "dr-bar-better")"
                                                             style="width:@BarWidth(row.DeltaPpm, sec.MaxAbsDelta)"></div>
                                                    </div>
                                                </td>
                                                <td class="dr-td-spark">
                                                    @if (Spark(row.TrendPpm) is SparkGeometry spark)
                                                    {
                                                        <svg class="dr-spark" width="@SparkWidth" height="@SparkHeight"
                                                             viewBox="0 0 @SparkWidth @SparkHeight" role="img"
                                                             aria-label="@SparkLabel(row, sec)">
                                                            <polyline points="@spark.Points" fill="none"
                                                                      stroke="#94a3b8" stroke-width="2"
                                                                      stroke-linejoin="round" stroke-linecap="round" />
                                                            <circle cx="@spark.RecentX" cy="@spark.RecentY" r="3.5"
                                                                    fill="@(sec.IsWorse ? "#c8342a" : "#1f5fa8")"
                                                                    stroke="#fff" stroke-width="2" />
                                                        </svg>
                                                    }
                                                    else
                                                    {
                                                        <span class="dr-spark-empty">—</span>
                                                    }
                                                </td>
                                                <td class="dr-td-cause">
                                                    @if (row.TopCauses.Count == 0)
                                                    {
                                                        <span class="dr-spark-empty">No defect data for the latest @sec.PeriodNoun</span>
                                                    }
                                                    else
                                                    {
                                                        <ul class="dr-causes">
                                                            @foreach (BmesDailyReportCause cause in row.TopCauses)
                                                            {
                                                                <li title="@CauseTooltip(cause, sec)">
                                                                    <span class="dr-cause-ng">@cause.NgName</span>
                                                                    <span class="dr-cause-ppm">@Ppm(cause.Ppm)</span>
                                                                    <span class="dr-cause-delta @DeltaClass(cause.DeltaPpm, cause.IsNew)">
                                                                        @CauseDeltaText(cause)
                                                                    </span>
                                                                    <span class="dr-cause-proc">
                                                                        @if (!string.IsNullOrWhiteSpace(cause.ProcessType))
                                                                        {
                                                                            <span class="dr-pt @PtClass(cause.ProcessType)">@cause.ProcessType</span>
                                                                        }
                                                                        @cause.ProcessName
                                                                    </span>
                                                                    <span class="dr-cause-prev">
                                                                        prev @(cause.IsNew ? "—" : Ppm(cause.PreviousPpm))
                                                                    </span>
                                                                </li>
                                                            }
                                                        </ul>
                                                        <div class="dr-cause-total">@row.RecentNgQty.ToString("N0") defects in the latest @sec.PeriodNoun</div>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </section>
                }
            }
        </div>
    }
</div>

<style>
    /* Wide enough for the two ranking tables to stand next to each other; the reading
       width used to be 1180px, when they were stacked. */
    .dr-root {
        max-width: 1720px;
        padding: 4px 2px 32px;
    }

    /* ── Title bar ─────────────────────────────────────────────────────── */
    .dr-titlebar {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 18px;
    }

    .dr-kicker {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: .6px;
        text-transform: uppercase;
        color: var(--ink-2, #4a5461);
        margin-bottom: 4px;
    }

    .dr-titlebar h1 {
        font-size: 22px;
        font-weight: 700;
        letter-spacing: -.3px;
        color: var(--ink, #0f1319);
        margin: 0 0 4px;
    }

    .dr-subtitle {
        font-size: 12.5px;
        color: var(--ink-2, #4a5461);
    }

    .dr-dot { margin: 0 6px; color: var(--line-2, #c6ccd5); }

    .dr-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .dr-btn {
        font-size: 12.5px;
        font-weight: 500;
        padding: 6px 13px;
        border-radius: 2px;
        border: 1px solid var(--signal, #16202b);
        background: var(--signal, #16202b);
        color: var(--panel, var(--panel, #fff));
        cursor: pointer;
        text-decoration: none;
        transition: all .15s ease;
    }

    .dr-btn:hover:not(:disabled) { background: var(--signal-hot, #24313f); border-color: var(--signal-hot, #24313f); }
    .dr-btn:disabled { opacity: .55; cursor: default; }

    .dr-btn-ghost {
        background: var(--panel, var(--panel, #fff));
        border-color: var(--line, var(--line, #dde1e7));
        color: var(--ink-2, #4a5461);
    }

    .dr-btn-ghost:hover { background: var(--panel-2, #f5f6f9); border-color: var(--line-2, #c6ccd5); }

    .dr-refreshing {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: 12px;
        color: var(--ink-2, #4a5461);
    }

    .dr-spinner {
        width: 12px;
        height: 12px;
        border: 2px solid var(--line-2, #c6ccd5);
        border-top-color: var(--signal, #16202b);
        border-radius: 50%;
        display: inline-block;
        animation: dr-spin .7s linear infinite;
    }

    .dr-spinner-lg { width: 22px; height: 22px; border-width: 3px; }

    @@keyframes dr-spin { to { transform: rotate(360deg); } }

    /* ── Stat tiles ────────────────────────────────────────────────────── */
    .dr-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 12px;
        margin-bottom: 22px;
    }

    .dr-stat {
        background: var(--panel, var(--panel, #fff));
        border: 1px solid var(--line, var(--line, #dde1e7));
        border-radius: 2px;
        padding: 12px 14px;
    }

    .dr-stat-label {
        font-size: 11.5px;
        font-weight: 500;
        color: var(--ink-2, #4a5461);
        margin-bottom: 6px;
    }

    /* Which period the change was measured against — the baseline can be older than the
       period immediately before when nothing was produced then. */
    .dr-stat-sub {
        font-size: 10.5px;
        color: var(--ink-3, #7f8a98);
        margin-left: 3px;
    }

    .dr-stat-value {
        font-size: 25px;
        font-weight: 700;
        letter-spacing: -.6px;
        color: var(--ink, #0f1319);
        font-variant-numeric: tabular-nums;
    }

    .dr-unit {
        font-size: 14px;
        font-weight: 500;
        color: var(--ink-3, #7f8a98);
        margin-left: 3px;
    }

    /* ── Sections ──────────────────────────────────────────────────────── */
    /* Two tracks whenever both tables fit, one otherwise — the tables are dense, so a
       fixed 2-column grid would only trade stacking for inner scrollbars. The 760px
       floor is what one table needs to render without scrolling sideways. */
    .dr-sections {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(760px, 1fr));
        gap: 18px;
        align-items: start;
    }

    .dr-section { min-width: 0; }

    /* Spans every track so the two rankings underneath read as one block. */
    .dr-block-head {
        grid-column: 1 / -1;
        display: flex;
        align-items: baseline;
        gap: 10px;
        flex-wrap: wrap;
        border-top: 1px solid var(--line, var(--line, #dde1e7));
        padding-top: 14px;
        margin-top: 4px;
    }

    .dr-sections > .dr-block-head:first-child {
        border-top: 0;
        padding-top: 0;
        margin-top: 0;
    }

    .dr-block-head h2 {
        font-size: 13px;
        font-weight: 700;
        letter-spacing: .5px;
        text-transform: uppercase;
        color: var(--ink-2, #4a5461);
        margin: 0;
    }

    .dr-block-note {
        font-size: 11.5px;
        color: var(--ink-3, #7f8a98);
    }

    .dr-section-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 9px;
    }

    .dr-section-head h2 {
        font-size: 14.5px;
        font-weight: 650;
        color: var(--ink, #0f1319);
        margin: 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .dr-section-note {
        font-size: 11.5px;
        color: var(--ink-3, #7f8a98);
    }

    .dr-badge {
        font-size: 11px;
        font-weight: 700;
        padding: 3px 9px;
        border-radius: 2px;
        letter-spacing: .2px;
    }

    .dr-badge-worse  { background: var(--crit-wash, #fbedec); color: var(--crit, #c8342a); }
    .dr-badge-better { background: var(--ok-wash, #eaf1f9); color: var(--ok, #1f5fa8); }

    /* ── Table ─────────────────────────────────────────────────────────── */
    .dr-table-wrap {
        background: var(--panel, var(--panel, #fff));
        border: 1px solid var(--line-2, #c6ccd5);
        border-radius: 2px;
        overflow-x: auto;
    }

    .dr-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
        /* Matches the grid track minimum, so a side-by-side column never scrolls. */
        min-width: 640px;
    }

    /* Header band + ruled cells: this table is cropped into reports, so a
       fragment of it has to still look like a table. */
    .dr-table th {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: .3px;
        text-transform: uppercase;
        color: var(--ink-2, #4a5461);
        background: var(--panel-2, #f5f6f9);
        text-align: left;
        padding: 8px 9px;
        border: 1px solid var(--line, var(--line, #dde1e7));
        border-bottom-color: var(--line-2, #c6ccd5);
        white-space: nowrap;
    }

    .dr-th-num  { text-align: right; }
    .dr-th-rank { width: 34px; text-align: center; }
    .dr-th-bar  { width: 96px; }
    .dr-th-spark{ width: 124px; }
    .dr-th-cause{ width: 210px; }

    .dr-table td {
        padding: 8px 9px;
        border: 1px solid var(--line, var(--line, #dde1e7));
        vertical-align: middle;
    }

    .dr-table tbody tr:hover { background: #fbfcfd; }

    .dr-td-rank {
        text-align: center;
        font-size: 12px;
        font-weight: 600;
        color: var(--ink-3, #7f8a98);
        font-variant-numeric: tabular-nums;
    }

    .dr-td-name { max-width: 190px; }

    /* Which period the baseline number came from, under the number itself. */
    .dr-baseline {
        font-size: 10.5px;
        font-weight: 500;
        color: var(--ink-3, #7f8a98);
        margin-top: 1px;
        white-space: nowrap;
    }

    /* Only shown when periods were skipped, so it earns a stronger colour. */
    .dr-baseline-gap {
        margin-left: 3px;
        padding: 0 4px;
        border-radius: 2px;
        background: var(--panel-3, #eceef2);
        color: var(--ink-2, #4a5461);
        font-variant-numeric: tabular-nums;
    }

    .dr-model {
        font-weight: 600;
        color: var(--ink, #0f1319);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .dr-model-group {
        font-size: 11px;
        color: var(--ink-3, #7f8a98);
        margin-top: 1px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    /* ── Per-model cause breakdown ─────────────────────────────────────── */
    .dr-td-cause { min-width: 210px; }

    .dr-causes {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .dr-causes li {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto auto;
        align-items: baseline;
        gap: 6px;
        font-size: 12px;
        line-height: 1.5;
    }

    .dr-cause-ng {
        color: var(--ink, #0f1319);
        font-weight: 550;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .dr-cause-proc {
        grid-column: 1;
        grid-row: 2;
        font-size: 10.5px;
        color: var(--ink-3, #7f8a98);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    /* Process class (MAIN / SUB / …) — monochrome by design, see PtClass. */
    .dr-pt {
        display: inline-block;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: .4px;
        line-height: 1.4;
        padding: 0 4px;
        border-radius: 2px;
        margin-right: 4px;
        vertical-align: 1px;
    }

    .dr-pt-main {
        background: var(--ink-2, #4a5461);
        color: var(--panel, var(--panel, #fff));
    }

    .dr-pt-other {
        background: var(--panel, var(--panel, #fff));
        color: var(--ink-2, #4a5461);
        box-shadow: inset 0 0 0 1px var(--line-2, #c6ccd5);
    }

    .dr-cause-ppm {
        font-variant-numeric: tabular-nums;
        color: var(--ink-2, #4a5461);
        font-size: 11.5px;
        white-space: nowrap;
    }

    .dr-cause-delta {
        font-variant-numeric: tabular-nums;
        font-size: 10.5px;
        font-weight: 700;
        min-width: 56px;
        text-align: right;
        white-space: nowrap;
    }

    .dr-cause-prev {
        grid-column: 2 / span 2;
        grid-row: 2;
        font-variant-numeric: tabular-nums;
        font-size: 10px;
        color: var(--line-2, #c6ccd5);
        text-align: right;
        white-space: nowrap;
    }

    .dr-th-hint {
        font-weight: 500;
        text-transform: none;
        letter-spacing: 0;
        color: var(--line-2, #c6ccd5);
        margin-left: 3px;
    }

    .dr-cause-total {
        margin-top: 5px;
        font-size: 10.5px;
        color: var(--ink-3, #7f8a98);
    }

    .dr-td-num {
        text-align: right;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

    .dr-strong { font-weight: 650; color: var(--ink, #0f1319); }
    .dr-muted  { color: var(--ink-2, #4a5461); }
    .dr-worse  { color: var(--crit, #c8342a); font-weight: 650; }
    .dr-better { color: var(--ok, #1f5fa8); font-weight: 650; }

    /* Under the signed PPM rather than beside it: side by side, the Change column alone
       cost ~60px of intrinsic table width, which is what pushed the side-by-side tables
       into a horizontal scrollbar. It also lines up with the baseline label opposite. */
    .dr-pct {
        display: block;
        font-size: 11px;
        font-weight: 500;
        color: var(--ink-3, #7f8a98);
        margin-top: 1px;
    }

    /* ── Bars: 4px rounded data-end, anchored to a recessive track ─────── */
    .dr-bar-track {
        background: var(--panel-3, #eceef2);
        border-radius: 2px;
        height: 9px;
        width: 100%;
        overflow: hidden;
    }

    .dr-bar {
        height: 100%;
        border-radius: 2px;
        min-width: 3px;
    }

    .dr-bar-worse  { background: var(--crit, #c8342a); }
    .dr-bar-better { background: var(--ok, #1f5fa8); }

    .dr-spark { display: block; }
