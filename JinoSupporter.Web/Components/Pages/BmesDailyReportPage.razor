@code {
    private BmesDailyReportSnapshot? _snapshot;
    private Timer? _progressTick;

    protected override void OnInitialized()
    {
        _snapshot = DailyReport.Load();
        DailyReport.SnapshotChanged += OnSnapshotChanged;

        // Cache-first: whatever is stored renders immediately above; a stale
        // snapshot kicks off one shared background refresh that swaps itself in.
        DailyReport.EnsureFresh();
        SyncProgressTick();
    }

    private void OnSnapshotChanged()
    {
        _snapshot = DailyReport.Load();
        StopProgressTick();
        InvokeAsync(StateHasChanged);
    }

    private void RefreshNow()
    {
        DailyReport.EnsureFresh(force: true);
        SyncProgressTick();
    }

    /// <summary>The refresh runs off-circuit, so poll while it is in flight to keep
    /// the progress log moving. <see cref="OnSnapshotChanged"/> stops the timer.</summary>
    private void SyncProgressTick()
    {
        if (!DailyReport.IsRefreshing) return;
        _progressTick ??= new Timer(
            _ => InvokeAsync(StateHasChanged),
            null,
            TimeSpan.FromSeconds(2),
            TimeSpan.FromSeconds(2));
    }

    private void StopProgressTick()
    {
        _progressTick?.Dispose();
        _progressTick = null;
    }

    private const int VisibleLogLines = 6;

    private List<string> RecentLogs() =>
        DailyReport.Logs.TakeLast(VisibleLogLines).ToList();

    // ── Sections ──────────────────────────────────────────────────────────────
    /// <summary>One ranking table. <paramref name="IsDaily"/> only switches wording —
    /// the rows are already built against the right granularity by the service.</summary>
    private sealed record RankSection(
        bool IsWorse,
        bool IsDaily,
        string Note,
        string EmptyText,
        List<BmesDailyReportModelRow> Rows)
    {
        public double MaxAbsDelta => Rows.Count == 0 ? 0 : Rows.Max(r => Math.Abs(r.DeltaPpm));

        public string PeriodNoun => IsDaily ? "day" : "week";

        /// <summary>Suffix for the "how far back the baseline sits" marker: −2w / −3d.</summary>
        public string StepUnit => IsDaily ? "d" : "w";
    }

    /// <summary>The two rankings of one granularity, under a heading that spans the grid.</summary>
    private sealed record RankBlock(string Title, string Note, List<RankSection> Sections);

    /// <summary>Both blocks are always emitted with both of their sections, even when a
    /// list is empty: the grid places them two-up, and dropping a section would slide the
    /// day-over-day tables up next to the weekly ones.</summary>
    private static List<RankBlock> BuildBlocks(BmesDailyReportSnapshot snapshot) =>
    [
        new RankBlock(
            Title: "Week over week",
            Note:  BlockNote(snapshot.RecentWeekHeader, snapshot.PreviousWeekHeader, "week"),
            Sections:
            [
                new RankSection(IsWorse: true, IsDaily: false,
                    Note: "Latest week PPM − baseline week PPM, largest increase first",
                    EmptyText: "No models worsened.",
                    Rows: snapshot.Worsened),
                new RankSection(IsWorse: false, IsDaily: false,
                    Note: "Largest decrease first",
                    EmptyText: "No models improved.",
                    Rows: snapshot.Improved),
            ]),
        new RankBlock(
            Title: "Day over day",
            Note:  BlockNote(snapshot.RecentDayHeader, snapshot.PreviousDayHeader, "day"),
            Sections:
            [
                new RankSection(IsWorse: true, IsDaily: true,
                    Note: "Latest day PPM − baseline day PPM, largest increase first",
                    EmptyText: "No models worsened.",
                    Rows: snapshot.WorsenedDaily),
                new RankSection(IsWorse: false, IsDaily: true,
                    Note: "Largest decrease first",
                    EmptyText: "No models improved.",
                    Rows: snapshot.ImprovedDaily),
            ]),
    ];

    /// <summary>Headline for a block: which two periods the overall figures compare. Each
    /// row may still sit on an older baseline of its own — that is labelled per row.</summary>
    private static string BlockNote(string recent, string previous, string noun)
    {
        if (string.IsNullOrEmpty(recent)) return string.Empty;
        return string.IsNullOrEmpty(previous)
            ? $"{recent} · no earlier {noun} with data"
            : $"{recent} vs {previous} · each model against the last {noun} it was produced in";
    }

    // ── Sparkline geometry ────────────────────────────────────────────────────
    private const double SparkWidth  = 118;
    private const double SparkHeight = 26;
    private const double SparkPad    = 3;

    /// <param name="RecentX">Marker position for the latest week — the leftmost point.</param>
    private sealed record SparkGeometry(string Points, string RecentX, string RecentY);

    /// <summary>Weekly PPM is stored newest-first, so it plots straight to screen:
    /// leftmost point = most recent week, running back in time to the right.
    /// Null when there is nothing to draw (fewer than two weeks, or all zeroes).</summary>
    private static SparkGeometry? Spark(List<double> points)
    {
        if (points.Count < 2) return null;
        double max = points.Max();
        if (max <= 0) return null;

        double stepX = (SparkWidth - SparkPad * 2) / (points.Count - 1);
        double Y(double v) => SparkHeight - SparkPad - (v / max) * (SparkHeight - SparkPad * 2);

        string plotted = string.Join(' ', points.Select((v, i) =>
            $"{Num(SparkPad + stepX * i)},{Num(Y(v))}"));

        return new SparkGeometry(plotted, Num(SparkPad), Num(Y(points[0])));
    }

    private static string Num(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);

    /// <summary>Where the row sits in the tree: model group → model.</summary>
    private static string ModelPath(BmesDailyReportModelRow row) =>
        string.IsNullOrWhiteSpace(row.ParentModelName)
            ? row.GroupName
            : $"{row.GroupName} · {row.ParentModelName}";

    private static string SparkLabel(BmesDailyReportModelRow row, RankSection sec) =>
        $"{row.ModelName} {sec.PeriodNoun}ly PPM trend, most recent on the left, " +
        $"latest {sec.PeriodNoun} {Ppm(row.RecentPpm)}";

    /// <summary>Spells out a baseline that is not the immediately preceding period, which
    /// is the case the row label abbreviates to "−3d".</summary>
    private static string BaselineTooltip(BmesDailyReportModelRow row, RankSection sec)
    {
        string what = $"Compared against {row.BaselineHeader} ({Ppm(row.PreviousPpm)} PPM)";
        return row.BaselineStepsBack <= 1
            ? $"{what} — the previous {sec.PeriodNoun}"
            : $"{what} — {row.BaselineStepsBack} {sec.PeriodNoun}s back; " +
              $"this model was not produced in the {sec.PeriodNoun}s in between";
    }

    private static string DeltaTooltip(BmesDailyReportModelRow row, bool isWorse) =>
        $"{row.ModelName}: {(isWorse ? "+" : "−")}{Ppm(Math.Abs(row.DeltaPpm))} PPM";

    /// <summary>MAIN reads as the stronger, filled badge; everything else stays
    /// outlined. Deliberately monochrome — the red/blue in this column already means
    /// increase/decrease, and a coloured process badge would compete with it.</summary>
    private static string PtClass(string processType) =>
        processType.Trim().StartsWith("MAIN", StringComparison.OrdinalIgnoreCase)
            ? "dr-pt-main"
            : "dr-pt-other";

    // ── Week-over-week movement ───────────────────────────────────────────────
    // Rising defect rate is red and signed "+"; falling is blue and signed "−".
    // The sign carries the meaning on its own, so the colour is never the only cue.
    private static string DeltaClass(double delta, bool isNew = false) =>
        isNew || delta > 0 ? "dr-worse"
        : delta < 0        ? "dr-better"
        : "dr-muted";

    /// <summary>Signed magnitude, e.g. <c>+1,204</c> / <c>−980</c>.</summary>
    private static string SignedPpm(double delta)
    {
        if (delta == 0) return "0";
        return (delta > 0 ? "+" : "−") + Ppm(Math.Abs(delta));
    }

    private static string CauseDeltaText(BmesDailyReportCause cause)
    {
        if (cause.IsNew) return "NEW";
        if (cause.DeltaPpm == 0) return "–";
        return SignedPpm(cause.DeltaPpm);
    }

    private static string CauseTooltip(BmesDailyReportCause cause, RankSection sec)
    {
        string movement = cause.IsNew
            ? $"Not present in the baseline {sec.PeriodNoun} (new)"
            : $"Baseline {sec.PeriodNoun} {Ppm(cause.PreviousPpm)} → latest {sec.PeriodNoun} {Ppm(cause.Ppm)} "
              + $"({(cause.DeltaPpm > 0 ? "+" : "")}{cause.DeltaPercent.ToString("0.#", CultureInfo.InvariantCulture)}%)";

        return $"{cause.NgName} · {cause.ProcessName}\n{movement}";
    }

    // ── Formatting ────────────────────────────────────────────────────────────
    private static string Ppm(double value) => value.ToString("N0", CultureInfo.InvariantCulture);

    private static string Pct(double value) =>
        $"({(value > 0 ? "+" : "")}{value.ToString("0.#", CultureInfo.InvariantCulture)}%)";


    private static string BarWidth(double delta, double maxAbsDelta)
    {
        if (maxAbsDelta <= 0) return "0%";
        double pct = Math.Abs(delta) / maxAbsDelta * 100;
        return pct.ToString("0.#", CultureInfo.InvariantCulture) + "%";
    }

    public void Dispose()
    {
        DailyReport.SnapshotChanged -= OnSnapshotChanged;
        StopProgressTick();
    }
}
