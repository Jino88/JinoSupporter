    private async Task ExportDailySummaryCsvAsync()
    {
        if (_isExportingDailySummary) return;

        _isExportingDailySummary = true;
        _copyError = string.Empty;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        try
        {
            if (_report is null)
            {
                _copyError = "No CSV rows to export.";
                return;
            }

            Activity.Log("NG Rate Daily", "Export daily Sub Group summary CSV");
            byte[] bytes = BuildDailySummaryCsv();
