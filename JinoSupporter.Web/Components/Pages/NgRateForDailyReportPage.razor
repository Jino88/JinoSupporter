@using System.Globalization
@using JinoSupporter.Web.Services
@inject NgRateService         NgRate
@inject NgRateSettingsService NgRateSettings
@inject NgRateReportService   NgRateReportSvc
@inject WebRepository         Repo
@inject IJSRuntime            JS
@inject AppActivityLogger     Activity

<NgRateReportStyles />
@ExportPeriodMeta()

@if (ShowTitle)
{
    <div class="d-flex align-items-center gap-2 mb-3">
        <h5 class="mb-0 fw-semibold">Report - NG Rate Daily</h5>
    </div>
}

@if (ShowSetup)
{
    <NgRateSetupPanel LayoutClass="ngrate-flow"
                      DataCellClass="ngrate-flow-data"
                      ProgressCellClass="ngrate-flow-progress"
                      StartDate="@_startDate"
                      StartDateChanged="@((DateTime d) => _startDate = d)"
                      EndDate="@_endDate"
                      EndDateChanged="@((DateTime d) => _endDate = d)"
                      IsBusy="@_isBusy"
                      IsReportBusy="@_isReportBusy"
                      IsCredentialsConfigured="@NgRateSettings.IsCredentialsConfigured"
                      LoginId="@NgRateSettings.LoginId"
                      SavedDbPath="@_savedDbPath"
                      ErrorMessage="@_errorMessage"
                      ShowClearResult="false"
                      LogElementId="@LogElementId"
                      Logs="@_logs"
                      HasSuccessfulResult="@(_report is not null)"
                      OnSetToday="SetToday"
                      OnClearLogs="@(() => _logs.Clear())">
        <AdditionalSettings>
            <div>
                <label class="form-label small fw-semibold mb-1" for="dailyReasonPpmThreshold">Reason Table minimum PPM</label>
                <input id="dailyReasonPpmThreshold"
                       type="number"
                       class="form-control form-control-sm"
                       style="max-width:180px;"
                       min="1"
                       step="1"
                       @bind="DailyReasonPpmThreshold"
                       @bind:event="oninput" />
            </div>
        </AdditionalSettings>
        <GroupPicker>
            <NgRateSimpleGroupPicker Groups="@_groups"
                                     SelectedGroupNames="@_selectedGroupNames"
                                     IsBusy="@_isBusy"
                                     IsReportBusy="@_isReportBusy"
                                     IsCredentialsConfigured="@NgRateSettings.IsCredentialsConfigured"
                                     OnReload="ReloadGroups"
                                     OnSelectAll="SelectAllGroups"
                                     OnClearSelection="ClearSelectedGroups"
                                     OnToggleGroup="ToggleGroup"
                                     OnGetReport="GetReportAsync" />
        </GroupPicker>
    </NgRateSetupPanel>
}

@if (_report is not null && _reportByMid is not null)
{
    @if (!ReasonOnly)
    {
    <div class="card mt-3 ngrate-report-card"
         data-daily-section="@ExportSectionKey("summary")" data-daily-label="Summary">
        <div class="card-header ngrate-card-header small fw-semibold d-flex align-items-center gap-2">
            <span>Summary - Group / Model x Date / Week / Month (PPM)</span>
            <span class="text-muted" style="font-size:11px;">
                D @VisibleDateCols.Count/@_report.DateCols.Count - W @VisibleWeekCols.Count/@_report.WeekCols.Count - M @VisibleMonthCols.Count/@_report.MonthCols.Count - @_report.TotalRows rows
            </span>
            <div class="d-flex align-items-center gap-2 ms-auto">
                <button type="button"
                        class="btn btn-outline-secondary btn-sm daily-copy-btn"
                        @onclick="() => CopyElementToClipboardAsync(DailySummaryCopyTargetId)"
                        disabled="@(IsCopying(DailySummaryCopyTargetId) || !string.IsNullOrEmpty(_reportError) || TotalColCount == 0)">
                    @CopyButtonText(DailySummaryCopyTargetId)
                </button>
                <button type="button"
                        class="btn btn-outline-success btn-sm daily-copy-btn"
                        @onclick="ExportDailySummaryCsvAsync"
                        disabled="@(_isExportingDailySummary || !string.IsNullOrEmpty(_reportError) || TotalColCount == 0)">
                    @if (_isExportingDailySummary)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        <span>Exporting...</span>
                    }
                    else
                    {
                        <span>Export CSV</span>
                    }
                </button>
                <label class="form-check form-check-inline d-flex align-items-center gap-1 m-0" style="font-size:11px;">
                    <input type="checkbox" class="form-check-input m-0" @bind="_showDailySummaryDelta" />
                    <span>증감률</span>
                </label>
                <div class="btn-group btn-group-sm">
                    @if (HiddenMonthCount > 0 || _monthExpanded)
                    {
                        <button class="btn btn-outline-warning"
                                @onclick="() => _monthExpanded = !_monthExpanded">
                            @(_monthExpanded ? $"Month ({_report.MonthCols.Count - DefaultMonthCap} hide)" : $"Month (+{HiddenMonthCount})")
                        </button>
                    }
                </div>
            </div>
        </div>
        <div class="card-body ngrate-card-body p-0">
            @if (!string.IsNullOrEmpty(_copyError))
            {
                <div class="alert alert-warning m-3 py-2 small">@_copyError</div>
            }
            @if (!string.IsNullOrEmpty(_reportError))
            {
                <div class="alert alert-danger m-3 py-2 small">@_reportError</div>
            }
            else if (TotalColCount == 0)
            {
                <div class="text-muted small p-4 text-center">No data.</div>
            }
            else
            {
                <div id="@DailySummaryCopyTargetId" class="pivot-wrap">
                    <table class="pivot-table text-fit-table daily-summary-table">
                        <thead>
                            <tr>
                                <th class="label-th" style="width:260px;" rowspan="2">Group / Model</th>
                                @if (VisibleDateCols.Count > 0)
                                {
                                    <th class="blk-date" colspan="@VisibleDateCols.Count">Date</th>
                                    <th class="sep-th" rowspan="2"></th>
                                }
                                @if (VisibleWeekCols.Count > 0)
                                {
                                    <th class="blk-week" colspan="@VisibleWeekCols.Count">Week</th>
                                    <th class="sep-th" rowspan="2"></th>
                                }
                                @if (VisibleMonthCols.Count > 0)
                                {
                                    <th class="blk-month" colspan="@VisibleMonthCols.Count">Month</th>
                                }
                            </tr>
                            <tr>
                                @foreach (var col in VisibleDateCols)  { <th>@col.Header</th> }
                                @foreach (var col in VisibleWeekCols)  { <th>@col.Header</th> }
                                @foreach (var col in VisibleMonthCols) { <th>@col.Header</th> }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var group in SelectedGroups)
                            {
                                string groupName = group.Name;

                                <tr class="grp-total-row">
                                    <td class="label-td">
                                        <span class="ngrate-hier-level">GROUP</span>
                                        <strong>@ReportGroupDisplayName(groupName)</strong>
                                    </td>
                                    @foreach (var col in VisibleDateCols)
                                    {
                                        double v = MeanOfMembers(groupName, col.Key, null);
                                        @SummaryPpmCell(v, PreviousDatePpm(col, key => MeanOfMembers(groupName, key, null)))
                                    }
                                    @if (VisibleDateCols.Count > 0) { <td class="sep-td"></td> }
                                    @foreach (var col in VisibleWeekCols)
                                    {
                                        double v = MeanOfMembers(groupName, col.Key, null);
                                        @SummaryPpmCell(v, PreviousWeekPpm(col, key => MeanOfMembers(groupName, key, null)))
                                    }
                                    @if (VisibleWeekCols.Count > 0) { <td class="sep-td"></td> }
                                    @foreach (var col in VisibleMonthCols)
                                    {
                                        double v = MeanOfMembers(groupName, col.Key, null);
                                        @SummaryPpmCell(v, PreviousMonthPpm(col, key => MeanOfMembers(groupName, key, null)))
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
    }
    else
    {
        <div class="d-flex align-items-center gap-2 mt-3 px-3">
            <span class="small fw-semibold">고질 불량 - Model Reason</span>
            <button type="button"
                    class="btn btn-outline-success btn-sm ms-auto"
                    @onclick="ExportChronicReasonCsvAsync"
                    disabled="@(_isExportingReason || TotalColCount == 0)">
                @if (_isExportingReason)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    <span>Exporting...</span>
                }
                else
                {
                    <span>Export CSV</span>
                }
            </button>
        </div>
        @if (!string.IsNullOrEmpty(_copyError))
        {
            <div class="alert alert-warning mx-3 mt-2 mb-0 py-2 small">@_copyError</div>
        }
    }

    @foreach (var model in OrderedModels.Where(ModelHasVisibleData))
    {
        var summaryRows = GetModelSummaryRows(model.Key);
        bool showReasonTable = ReasonOnly || IsDailyReasonModelVisible(model.Key);
        var dailyReasonReferenceCol = DailyReasonReferenceDateColumn(model.Key);
        var reasonRows = showReasonTable
            ? GetModelReasonRows(model.Key, dailyReasonReferenceCol?.Key)
            : new List<DailyReasonRow>();
        bool enableReasonCollapse = ReasonOnly;
        string dailyReasonReferenceHeader = dailyReasonReferenceCol?.Header ?? "Last Date";
        var modelCopyTargetId = ModelCopyTargetId(model.Key);

        <div id="@modelCopyTargetId" class="daily-model-copy-target"
             data-daily-section="@ExportSectionKey(model.Key)" data-daily-label="@model.Material">
            @if (!ReasonOnly)
            {
            <div class="card mt-3 ngrate-report-card">
                <div class="card-header ngrate-card-header small fw-semibold d-flex align-items-center gap-2">
                    <span class="ngrate-hier-level">MODEL</span>
                    <span>@model.Material</span>
                    <span class="text-muted" style="font-size:11px;">@model.GroupName - Process Type</span>
                    <button type="button"
                            class="btn btn-outline-secondary btn-sm ms-auto daily-copy-btn"
                            data-copy-hidden="true"
                            @onclick="() => CopyElementToClipboardAsync(modelCopyTargetId)"
                            disabled="@IsCopying(modelCopyTargetId)">
                        @CopyButtonText(modelCopyTargetId)
                    </button>
                </div>
                <div class="card-body ngrate-card-body p-0">
                    @if (summaryRows.Count == 0)
                    {
                        <div class="text-muted small p-4 text-center">No process data.</div>
                    }
                    else
                    {
                        <div class="pivot-wrap">
                            <table class="pivot-table text-fit-table">
                                <thead>
                                    <tr>
                                        <th class="label-th" style="width:160px;">Process Type</th>
                                        @foreach (var col in VisibleDateCols)  { <th>@col.Header</th> }
                                        @if (VisibleDateCols.Count > 0) { <th class="sep-th"></th> }
                                        @foreach (var col in VisibleWeekCols)  { <th>@col.Header</th> }
                                        @if (VisibleWeekCols.Count > 0) { <th class="sep-th"></th> }
                                        @foreach (var col in VisibleMonthCols) { <th>@col.Header</th> }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in summaryRows)
                                    {
                                        <tr class="@(row.IsTotal ? "total-row" : "rank-row")">
                                            <td class="label-td">@row.ProcessType</td>
                                            @foreach (var col in VisibleDateCols)
                                            {
                                                double v = row.Ppm.GetValueOrDefault(col.Key);
                                                <td class="@PpmClass(v)">@FormatPpm(v)</td>
                                            }
                                            @if (VisibleDateCols.Count > 0) { <td class="sep-td"></td> }
                                            @foreach (var col in VisibleWeekCols)
                                            {
                                                double v = row.Ppm.GetValueOrDefault(col.Key);
                                                <td class="@PpmClass(v)">@FormatPpm(v)</td>
                                            }
                                            @if (VisibleWeekCols.Count > 0) { <td class="sep-td"></td> }
                                            @foreach (var col in VisibleMonthCols)
                                            {
                                                double v = row.Ppm.GetValueOrDefault(col.Key);
                                                <td class="@PpmClass(v)">@FormatPpm(v)</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                }
                </div>
            </div>
            }

            <div class="card ngrate-report-card @(ReasonOnly ? "mt-3" : "mt-2")">
                <div class="card-header ngrate-card-header small fw-semibold d-flex align-items-center gap-2">
                    <span class="ngrate-hier-level">MODEL</span>
                    <span>@model.Material</span>
                    <span class="text-muted" style="font-size:11px;">
                        @model.GroupName -
                        @if (ReasonOnly)
                        {
                            <text>Reason</text>
                        }
                        else
                        {
                            @* In a static export the threshold is a viewer setting, so the
                               heading carries a template the toolbar rewrites on change. *@
                            <span data-ppm-label="@ExportReasonLabelTemplate(dailyReasonReferenceHeader)">@($"Reason Detail >= {FormatPpm(DailyReasonPpmThreshold)} PPM ({dailyReasonReferenceHeader})")</span>
                        }
                    </span>
                    @if (!ReasonOnly)
                    {
                        <button type="button"
                                class="btn btn-outline-secondary btn-sm ms-auto daily-copy-btn"
                                @onclick="() => ToggleDailyReasonModel(model.Key)">
                            @(showReasonTable ? "Hide" : "Load")
                        </button>
                    }
                </div>
                <div class="card-body ngrate-card-body p-0">
                    @if (!showReasonTable)
                    {
                    }
                    else if (reasonRows.Count == 0)
                    {
                        <div class="text-muted small p-4 text-center">
                            @(ReasonOnly ? "No reason data." : $"No reason data at or above {FormatPpm(DailyReasonPpmThreshold)} PPM.")
                        </div>
                    }
                    else
                    {
                        <div class="pivot-wrap">
                            <table class="pivot-table text-fit-table">
                            <thead>
                                <tr>
                                    <th class="label-th" style="min-width:110px;">Reason</th>
                                    <th class="label-th" style="width:44px;">No</th>
                                    <th class="label-th" style="width:80px;">Type</th>
                                    <th class="label-th process-name-col" style="min-width:160px;">Process Name</th>
                                    <th class="label-th ng-name-col" style="min-width:120px;">NG Name</th>
                                    @foreach (var col in VisibleDateCols)  { <th>@col.Header</th> }
                                    @if (VisibleDateCols.Count > 0) { <th class="sep-th"></th> }
                                    @foreach (var col in VisibleWeekCols)  { <th>@col.Header</th> }
                                    @if (VisibleWeekCols.Count > 0) { <th class="sep-th"></th> }
                                    @foreach (var col in VisibleMonthCols) { <th>@col.Header</th> }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in reasonRows)
                                {
                                    bool collapsed = enableReasonCollapse && IsReasonSectionCollapsed(model.Key, row.Reason);
                                    if (!row.IsTotal && collapsed)
                                    {
                                        continue;
                                    }

                                    if (row.IsTotal)
                                    {
                                        <tr class="total-row">
                                            @if (enableReasonCollapse)
                                            {
                                                <td class="toggle-cell label-td fw-bold"
                                                    @onclick="@(() => ToggleReasonSection(model.Key, row.Reason))">
                                                    <span class="toggle-icon">@(collapsed ? ">" : "v")</span>
                                                    @row.Reason
                                                </td>
                                            }
                                            else
                                            {
                                                <td class="label-td fw-bold">@row.Reason</td>
                                            }
                                            <td></td>
                                            <td></td>
                                            <td class="label-td text-muted" style="font-size:10px;">Total</td>
                                            <td></td>
                                            @foreach (var col in VisibleDateCols)
                                            {
                                                double v = row.Ppm.GetValueOrDefault(col.Key);
                                                <td class="@PpmClass(v)">@FormatPpm(v)</td>
                                            }
                                            @if (VisibleDateCols.Count > 0) { <td class="sep-td"></td> }
                                            @foreach (var col in VisibleWeekCols)
                                            {
                                                double v = row.Ppm.GetValueOrDefault(col.Key);
                                                <td class="@PpmClass(v)">@FormatPpm(v)</td>
                                            }
                                            @if (VisibleWeekCols.Count > 0) { <td class="sep-td"></td> }
                                            @foreach (var col in VisibleMonthCols)
                                            {
                                                double v = row.Ppm.GetValueOrDefault(col.Key);
                                                <td class="@PpmClass(v)">@FormatPpm(v)</td>
                                            }
                                        </tr>
                                    }
                                    else
                                    {
                                        <tr class="rank-row" data-ppm="@ExportReasonPpm(row, dailyReasonReferenceCol?.Key)">
                                            <td class="label-td" style="color:#94a3b8; font-size:10px;">@row.Reason</td>
                                            <td class="label-td">@row.No</td>
                                            <td class="label-td"><span class="pt-badge">@row.ProcessType</span></td>
                                            <td class="label-td process-name-col">@row.ProcessName</td>
                                            <td class="label-td ng-name-col">@row.NgName</td>
                                            @foreach (var col in VisibleDateCols)
                                            {
                                                double v = row.Ppm.GetValueOrDefault(col.Key);
                                                <td class="@PpmClass(v)">@FormatPpm(v)</td>
                                            }
                                            @if (VisibleDateCols.Count > 0) { <td class="sep-td"></td> }
                                            @foreach (var col in VisibleWeekCols)
                                            {
                                                double v = row.Ppm.GetValueOrDefault(col.Key);
                                                <td class="@PpmClass(v)">@FormatPpm(v)</td>
                                            }
                                            @if (VisibleWeekCols.Count > 0) { <td class="sep-td"></td> }
                                            @foreach (var col in VisibleMonthCols)
                                            {
                                                double v = row.Ppm.GetValueOrDefault(col.Key);
                                                <td class="@PpmClass(v)">@FormatPpm(v)</td>
                                            }
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
        </div>
    }
}

@code {
    [Parameter] public bool ShowTitle { get; set; } = true;
    [Parameter] public bool ShowSetup { get; set; } = true;
    [Parameter] public bool ReasonOnly { get; set; }
    [Parameter] public double DailyReasonPpmThreshold { get; set; } = 1000d;

    // ── Static-HTML export mode ────────────────────────────────────────────────
    // When ExportMode is set (used by BmesReportHtmlExportService via HtmlRenderer),
    // the component auto-generates from the Export* inputs during its lifecycle,
    // shows every period column (no caps — a static snapshot cannot expand), and
    // pushes its computed shared hierarchy back out via OnExportComputed so the
    // other report tabs can reuse it without re-scraping BMES.
    [Parameter] public bool ExportMode { get; set; }
    [Parameter] public DateTime? ExportStart { get; set; }
    [Parameter] public DateTime? ExportEnd { get; set; }
    [Parameter] public IReadOnlyList<ModelGroupRecord>? ExportGroups { get; set; }
    [Parameter] public Action<HierReports?, NgRateReportService.NgRateReport?>? OnExportComputed { get; set; }
    [Parameter] public IProgress<string>? ExportProgress { get; set; }
    private bool _exportGenerated;

    protected override async Task OnParametersSetAsync()
    {
        if (ExportMode && !_exportGenerated
            && ExportStart is { } start && ExportEnd is { } end
            && ExportGroups is { Count: > 0 } groups)
        {
            _exportGenerated = true;
            await GenerateReportAsync(start, end, groups, ExportProgress);
            OnExportComputed?.Invoke(CurrentHierarchyReports, CurrentSummaryReport);
        }
    }

    private DateTime _startDate = DateTime.Today;
    private DateTime _endDate = DateTime.Today;
    private bool _isBusy;
    private bool _isReportBusy;
    private string? _savedDbPath;
    private string _errorMessage = string.Empty;
    private string _reportError = string.Empty;
    private readonly List<string> _logs = new();
    private const string LogElementId = "ngRateLogDaily";
    private IProgress<string>? _externalProgress;

    private List<ModelGroupRecord> _groups = new();
    private IReadOnlyList<ModelGroupRecord>? _groupOverride;
    private HashSet<string> _selectedGroupNames = new(StringComparer.Ordinal);
    private List<DailyModelRef> _modelOrder = new();
    private HashSet<string> _expandedReasonSections = new(StringComparer.Ordinal);
    private HashSet<string> _visibleDailyReasonModels = new(StringComparer.Ordinal);

    private NgRateReportService.NgRateReport? _report;
    private NgRateReportService.NgRateReport? _reportByMid;
    private NgRateReportService.NgRateReport? _reportByModel;
    private NgRateReportService.NgRateReport? _reportBySubGroup;
    private NgRateReportService.NgRateReport? _reportBySubLeaf;
    private HierPpmLookup _hierLookup = new();
    private IReadOnlyList<ModelGroupRecord> _allGroups = [];
    private Dictionary<long, string> _allGroupNamesById = new();

    private const string DailySummaryCopyTargetId = "dailySummaryCopyTarget";
    private const int DefaultDateCap = 7;
    private const int DefaultWeekCap = 3;
    private const int DefaultMonthCap = 3;
    private const int MaxDisplayReasonRows = 10;
    private const string OtherReason = "Other";
    private bool _monthExpanded;
    private bool _showDailySummaryDelta = true;
    private bool _isExportingDailySummary;
    private bool _isExportingReason;
    private string _copyingElementId = string.Empty;
    private string _copiedElementId = string.Empty;
    private string _copyError = string.Empty;

    private sealed record DailyModelRef(string Key, string GroupName, string Material, int LineShiftCount);

    private sealed record DailyReasonRow(
        string Reason,
        int No,
        bool IsTotal,
        string ProcessType,
        string ProcessName,
        string NgName,
        Dictionary<string, double> Ppm);

    private sealed record ChronicProcessCsvExport(
        string ReferencePeriodKey,
        IReadOnlyList<NgRateReportService.PeriodColumn> DateColumns,
        IReadOnlyList<NgRateReportService.PeriodColumn> WeekColumns,
        IReadOnlyList<NgRateReportService.PeriodColumn> MonthColumns,
        IReadOnlyList<ChronicProcessCsvRow> Rows);

    private sealed record ChronicBucketRef(
        string Key,
        string BGrName,
        string ModelName,
        string GroupName);

    private sealed record ChronicProcessCsvRow(
        string BGrName,
        string ModelName,
        string ProcessType,
        string ProcessName,
        string NgName,
        bool IsTotal,
        Dictionary<string, double> Ppm);

    private sealed record DeltaDisplay(string Text, string CssClass);

    private IReadOnlyList<NgRateReportService.PeriodColumn> VisibleDateCols =>
        _report is null ? Array.Empty<NgRateReportService.PeriodColumn>()
        : ExportMode ? _report.DateCols
        : _report.DateCols.Take(DefaultDateCap).ToList();

    private IReadOnlyList<NgRateReportService.PeriodColumn> VisibleWeekCols =>
        _report is null ? Array.Empty<NgRateReportService.PeriodColumn>()
        : ExportMode ? _report.WeekCols
        : _report.WeekCols.Take(DefaultWeekCap).ToList();

    private IReadOnlyList<NgRateReportService.PeriodColumn> VisibleMonthCols =>
        _report is null ? Array.Empty<NgRateReportService.PeriodColumn>()
        : ExportMode || _monthExpanded ? _report.MonthCols
        : _report.MonthCols.Take(DefaultMonthCap).ToList();

    private int HiddenDateCount => _report is null ? 0 : Math.Max(0, _report.DateCols.Count - VisibleDateCols.Count);
    private int HiddenWeekCount => _report is null ? 0 : Math.Max(0, _report.WeekCols.Count - VisibleWeekCols.Count);
    private int HiddenMonthCount => _report is null ? 0 : Math.Max(0, _report.MonthCols.Count - VisibleMonthCols.Count);

    private int TotalColCount =>
        _report is null ? 0 : VisibleDateCols.Count + VisibleWeekCols.Count + VisibleMonthCols.Count;

    private List<ModelGroupRecord> SelectedGroups =>
        _groups.Where(g => _selectedGroupNames.Contains(g.Name)).ToList();

    public NgRateReportService.NgRateReport? CurrentSummaryReport => _report;

    public HierReports? CurrentHierarchyReports =>
        _report is null
            ? null
            : new HierReports
            {
                ByGroup = _report,
                ByMid = _reportByMid,
                BySub1 = _reportBySubGroup,
                BySub2 = _reportBySubLeaf,
                ByLs = _reportByModel,
                Groups = SelectedGroups,
            };

    private List<DailyModelRef> OrderedModels =>
        _modelOrder
            .Where(m => _selectedGroupNames.Contains(m.GroupName))
            .ToList();

    protected override void OnInitialized()
    {
        _allGroups = Repo.GetModelGroups();
        _allGroupNamesById = _allGroups.ToDictionary(g => g.Id, g => g.Name);
        ReloadGroups();
    }

    private void ReloadGroups()
    {
        if (_groupOverride is null)
        {
            if (_allGroups.Count == 0)
            {
                _allGroups = Repo.GetModelGroups();
                _allGroupNamesById = _allGroups.ToDictionary(g => g.Id, g => g.Name);
            }

            _groups = _allGroups.ToList();
        }
        else
        {
            _groups = _groupOverride.ToList();
        }

        _selectedGroupNames.RemoveWhere(n => !_groups.Any(g => g.Name == n));
        SyncModelOrder();
    }

    private void SelectAllGroups()
    {
        _selectedGroupNames = new HashSet<string>(_groups.Select(g => g.Name), StringComparer.Ordinal);
        SyncModelOrder();
    }

    private void ClearSelectedGroups()
    {
        _selectedGroupNames.Clear();
        SyncModelOrder();
    }

    private void ToggleGroup(string name, bool selected)
    {
        if (selected) _selectedGroupNames.Add(name);
        else _selectedGroupNames.Remove(name);
        SyncModelOrder();
    }

