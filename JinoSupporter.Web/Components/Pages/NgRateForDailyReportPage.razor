    private async Task ExportChronicReasonCsvAsync()
    {
        if (_isExportingReason) return;

        _isExportingReason = true;
        _copyError = string.Empty;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(50);

        try
        {
            var export = BuildChronicProcessCsvExport();
            if (export is null || export.Rows.Count == 0)
            {
                _copyError = "No CSV rows to export.";
                return;
            }

            Activity.Log("NG Rate Daily", $"Export chronic process CSV rows={export.Rows.Count:N0}");
            byte[] bytes = await Task.Run(() => BuildChronicProcessCsv(export));
            if (bytes.Length == 0)
            {
                _copyError = "CSV export produced an empty file.";
                return;
            }

            string name = $"NgRate_ChronicProcess_{DateTime.Now:yyyyMMdd_HHmmss}.csv";
            await BrowserDownload.DownloadBytesAsync(JS, name, bytes, CsvExportUtility.ContentType);
        }
        catch (Exception ex)
        {
            _copyError = $"Export failed: {ex.Message}";
        }
        finally
        {
            _isExportingReason = false;
            StateHasChanged();
        }
    }

    private byte[] BuildDailySummaryCsv()
    {
        if (_report is null)
            return Array.Empty<byte>();

        var dateCols = _report.DateCols.ToList();
        var weekCols = _report.WeekCols.ToList();
        var monthCols = _report.MonthCols.ToList();
        var columns = DistinctPeriodColumns(dateCols.Concat(weekCols).Concat(monthCols)).ToList();
        if (columns.Count == 0)
            return Array.Empty<byte>();

        var sb = new System.Text.StringBuilder();
        CsvExportUtility.AppendRow(sb, new[] { "Level", "Group", "Model", "Sub Group", "Process Type" }
            .Concat(columns.Select(c => c.Header)));

        void AddRow(
            string level,
            string group,
            string model,
            string bGr,
            string processType,
            Func<string, double> valueOf)
        {
            var values = new List<string> { level, group, model, bGr, processType };
            foreach (var col in columns)
                values.Add(FormatCsvPpm(valueOf(col.Key)));
            CsvExportUtility.AppendRow(sb, values);
        }

        AddRow("Total", string.Empty, string.Empty, "TOTAL", string.Empty, MeanOfGroups);

        foreach (var group in SelectedGroups)
        {
            string groupName = group.Name;
            bool shouldSplitByBuckets = !IsRootSelection(group);
            var buckets = shouldSplitByBuckets
                ? BuildChronicBucketRefs()
                    .Where(b => string.Equals(b.GroupName, groupName, StringComparison.Ordinal) &&
                                BGrHasData(b, dateCols, weekCols, monthCols))
                    .ToList()
                : new List<ChronicBucketRef>();

            AddRow("Group", groupName, string.Empty, "TOTAL", "TOTAL",
                key => MeanOfMembers(groupName, key, null));

            if (shouldSplitByBuckets)
            {
                foreach (var bucket in buckets)
                {
                    AddRow("Sub Group", groupName, bucket.ModelName, bucket.BGrName, "TOTAL",
                        key => BGrPpm(bucket.Key, key));

                    foreach (var processRow in GetBGrSummaryRows(bucket.Key).Where(r => !r.IsTotal))
                    {
                        AddRow("Process Type", groupName, bucket.ModelName, bucket.BGrName, processRow.ProcessType,
                            key => processRow.Ppm.GetValueOrDefault(key));
                    }
                }
            }
        }

        return CsvExportUtility.ToUtf8BomBytes(sb);
    }

    private static byte[] BuildChronicProcessCsv(ChronicProcessCsvExport export)
    {
        var columns = DistinctPeriodColumns(export.DateColumns
            .Concat(export.WeekColumns)
            .Concat(export.MonthColumns))
            .ToList();
        var sb = new System.Text.StringBuilder();

        CsvExportUtility.AppendRow(sb, new[] { "Sub Group", "MODEL", "Type", "Process", "NG NAME", "Reference PPM" }
            .Concat(columns.Select(c => c.Header)));

        foreach (var row in export.Rows)
        {
            var values = new List<string>
            {
                row.BGrName,
                row.ModelName,
                row.ProcessType,
                row.ProcessName,
                row.NgName,
                FormatCsvPpm(CsvRefValue(row.Ppm, export.ReferencePeriodKey)),
            };

            foreach (var col in columns)
            {
                double v = row.Ppm.GetValueOrDefault(col.Key);
                values.Add(FormatCsvPpm(v));
            }

            CsvExportUtility.AppendRow(sb, values);
        }

        return CsvExportUtility.ToUtf8BomBytes(sb);
    }

    private static string FormatCsvPpm(double value)
        => NgRateModeSupport.FormatPpm(value);

    private static double CsvRefValue(IReadOnlyDictionary<string, double> ppm, string referencePeriodKey)
    {
        if (!string.IsNullOrEmpty(referencePeriodKey))
            return ppm.GetValueOrDefault(referencePeriodKey);

        return ppm.Values.DefaultIfEmpty(0).Max();
    }

    private static IEnumerable<NgRateReportService.PeriodColumn> DistinctPeriodColumns(
        IEnumerable<NgRateReportService.PeriodColumn> columns)
    {
        var seen = new HashSet<string>(StringComparer.Ordinal);
        foreach (var column in columns)
        {
            if (seen.Add(column.Key))
                yield return column;
        }
    }

    private static void AppendCsvRow(System.Text.StringBuilder sb, IEnumerable<string> values)
    {
        bool first = true;
        foreach (string value in values)
        {
            if (!first) sb.Append(',');
            first = false;
            sb.Append(EscapeCsv(value));
        }
        sb.AppendLine();
    }

    private static string EscapeCsv(string? value)
    {
        string text = value ?? string.Empty;
        if (!text.Contains('"') && !text.Contains(',') && !text.Contains('\r') && !text.Contains('\n'))
            return text;

        return "\"" + text.Replace("\"", "\"\"", StringComparison.Ordinal) + "\"";
    }

    private ChronicProcessCsvExport? BuildChronicProcessCsvExport()
    {
        if (_report is null || _reportBySubGroup is null)
            return null;

        var dateCols = _report.DateCols.ToList();
        var weekCols = _report.WeekCols.ToList();
        var monthCols = _report.MonthCols.ToList();
        if (dateCols.Count == 0 && weekCols.Count == 0 && monthCols.Count == 0)
            return null;

        var periodKeys = DistinctPeriodColumns(dateCols.Concat(weekCols).Concat(monthCols))
            .Select(c => c.Key)
            .ToList();
        if (periodKeys.Count == 0)
            return null;

        var rows = new List<ChronicProcessCsvRow>();
        foreach (var model in OrderedModels)
        {
            var details = BuildChronicProcessCsvDetails(model, periodKeys);
            if (details.Count == 0)
                continue;

            var typeGroups = details
                .GroupBy(r => r.ProcessType)
                .Select(g =>
                {
                    var typeRows = g.ToList();
                    return new
                    {
                        ProcessType = g.Key,
                        Rows = typeRows,
                        Total = SumPpm(typeRows, periodKeys),
                    };
                })
                .OrderByDescending(g => RefValue(g.Total))
                .ThenBy(g => ProcessTypeRank(g.ProcessType))
                .ThenBy(g => g.ProcessType, StringComparer.Ordinal)
                .ToList();

            foreach (var typeGroup in typeGroups)
            {
                rows.Add(new ChronicProcessCsvRow(
                    BGrName: model.GroupName,
                    ModelName: model.Material,
                    ProcessType: typeGroup.ProcessType,
                    ProcessName: "TOTAL",
                    NgName: string.Empty,
                    IsTotal: true,
                    Ppm: typeGroup.Total));

                var processGroups = typeGroup.Rows
                    .GroupBy(r => r.ProcessName)
                    .Select(g =>
                    {
                        var processRows = g.ToList();
                        return new
                        {
                            ProcessName = g.Key,
                            Rows = processRows,
                            Total = SumPpm(processRows, periodKeys),
                        };
                    })
                    .OrderByDescending(g => RefValue(g.Total))
                    .ThenBy(g => g.ProcessName, StringComparer.Ordinal)
                    .ToList();

                foreach (var processGroup in processGroups)
                {
                    foreach (var detail in processGroup.Rows
                        .OrderByDescending(r => RefValue(r.Ppm))
                        .ThenBy(r => r.NgName, StringComparer.Ordinal))
                    {
                        rows.Add(detail);
                    }
                }
            }
        }

        return new ChronicProcessCsvExport(
            ReferencePeriodKey: SortRefKey().Key,
            DateColumns: dateCols,
            WeekColumns: weekCols,
            MonthColumns: monthCols,
            Rows: rows);
    }

    private IEnumerable<ChronicBucketRef> BuildChronicBucketRefs()
    {
        var seen = new HashSet<string>(StringComparer.Ordinal);

        foreach (var model in OrderedModels)
        {
            var group = _groups.FirstOrDefault(g =>
                string.Equals(g.Name, model.GroupName, StringComparison.Ordinal));
            var mid = group?.MidGroups.FirstOrDefault(m =>
                string.Equals(m.Material, model.Material, StringComparison.Ordinal));
            if (group is null || mid is null)
                continue;

            foreach (var sub in mid.SubGroups)
            {
                if (string.IsNullOrWhiteSpace(sub.Name) || !sub.AllLineShifts.Any())
                    continue;

                string key = ModelGroupPickerHelpers.SubGroupKeyOf(group.Name, mid.Material, sub);
                if (!seen.Add(key))
                    continue;

                yield return new ChronicBucketRef(
                    Key: key,
                    BGrName: sub.Name,
                    ModelName: mid.Material,
                    GroupName: group.Name);
            }
        }
    }

    private List<ChronicProcessCsvRow> BuildChronicProcessCsvDetails(
        DailyModelRef model,
        IReadOnlyList<string> periodKeys)
    {
        var rows = new Dictionary<(string ProcessType, string ProcessName, string NgName), Dictionary<string, double>>();
        if (_reportByMid is null)
            return new List<ChronicProcessCsvRow>();

        foreach (var row in _reportByMid.ReasonRows.Where(r => !r.IsTotal))
        {
            var groupPpm = row.Groups.FirstOrDefault(g =>
                string.Equals(g.GroupName, model.Key, StringComparison.Ordinal));
            if (groupPpm is null)
                continue;

            var ppm = PeriodDict(periodKeys, key => groupPpm.Ppm.GetValueOrDefault(key));
            if (!HasAnyPpm(ppm))
                continue;

            var key = (row.ProcessType, row.ProcessName, row.NgName);
            if (!rows.TryGetValue(key, out var current))
            {
                current = PeriodDict(periodKeys, _ => 0);
                rows[key] = current;
            }

            foreach (string periodKey in periodKeys)
                current[periodKey] += ppm.GetValueOrDefault(periodKey);
        }

        return rows
            .Select(kv => new ChronicProcessCsvRow(
                BGrName: model.GroupName,
                ModelName: model.Material,
                ProcessType: kv.Key.ProcessType,
                ProcessName: kv.Key.ProcessName,
                NgName: kv.Key.NgName,
                IsTotal: false,
                Ppm: kv.Value))
            .Where(r => HasAnyPpm(r.Ppm))
            .ToList();
    }

    private static Dictionary<string, double> SumPpm(
        IEnumerable<ChronicProcessCsvRow> rows,
        IEnumerable<string> periodKeys)
    {
        var rowList = rows.ToList();
        return PeriodDict(periodKeys, key => rowList.Sum(r => r.Ppm.GetValueOrDefault(key)));
    }

