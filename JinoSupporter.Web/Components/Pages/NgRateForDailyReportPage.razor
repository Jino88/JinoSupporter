        _copyError = string.Empty;
        SyncModelOrder();
        ExpandDailyReasonModelsByDefault();
        progress?.Report("Using Daily report data.");

        return InvokeAsync(StateHasChanged);
    }

    private async Task GetReportAsync()
    {
        if (_isReportBusy || _isBusy || _selectedGroupNames.Count == 0) return;
        if (_endDate < _startDate)
        {
            _reportError = "End date must be on or after start date.";
            return;
        }
        if (!NgRateSettings.IsCredentialsConfigured)
        {
            _reportError = "BMES credentials are not configured.";
            return;
        }

        _isReportBusy = true;
        _isBusy = true;
        _reportError = string.Empty;
        _errorMessage = string.Empty;
        _savedDbPath = null;
        _report = null;
        _reportByMid = null;
        _reportByModel = null;
        _reportBySubGroup = null;
        _reportBySubLeaf = null;
        _hierLookup = new();
        _expandedReasonSections.Clear();
        _visibleDailyReasonModels.Clear();
        _monthExpanded = false;
        _logs.Clear();
        Activity.Log("NG Rate Daily", $"Get Data {_startDate:yyyy-MM-dd} ~ {_endDate:yyyy-MM-dd}");
        StateHasChanged();

        IProgress<string> progress = new Progress<string>(AddLog);

        try
        {
            progress.Report($"Fetching data: {_startDate:yyyy-MM-dd} ~ {_endDate:yyyy-MM-dd}");
            List<ModelGroupRecord> selectedGroups = SelectedGroups;
            List<string> selectedLineShifts = selectedGroups
                .SelectMany(group => group.MidGroups)
                .SelectMany(mid => mid.LineShifts)
                .Where(lineShift => !string.IsNullOrWhiteSpace(lineShift))
                .Select(lineShift => lineShift.Trim())
                .Distinct(StringComparer.Ordinal)
                .ToList();
            string? dbPath = await NgRate.GetOrFetchAsync(
                _startDate,
                _endDate,
                progress,
                selectedLineShifts);
            _isBusy = false;

            if (string.IsNullOrEmpty(dbPath))
            {
                _errorMessage = "Data fetch or save failed - check the log.";
                _reportError = _errorMessage;
                return;
            }

            _savedDbPath = dbPath;
            ReloadGroups();
            selectedGroups = SelectedGroups;
            Activity.Log("NG Rate Daily", $"Generate Report selectedGroups={selectedGroups.Count:N0}");
            progress.Report($"Using DB: {Path.GetFileName(dbPath)}");

            var hier = await HierReportBuilder.BuildAsync(
                NgRateReportSvc, dbPath, selectedGroups, progress,
                _startDate, _endDate,
                includeMidDetailReport: true);

            if (!hier.HasData || hier.ByGroup is null || hier.ByMid is null)
            {
                _reportError = "No LineShift found in the selected groups.";
                return;
            }

            _report = hier.ByGroup;
            _reportByMid = hier.ByMid;
            _reportByModel = hier.ByLs;
            _reportBySubGroup = hier.BySub1;
            _reportBySubLeaf = hier.BySub2;
            _hierLookup = HierPpmLookup.From(hier);
            SyncModelOrder();
            ExpandDailyReasonModelsByDefault();
        }
        catch (Exception ex)
        {
            _reportError = $"Error: {ex.Message}";
            _logs.Add($"[{DateTime.Now:HH:mm:ss}] [ERROR] {ex}");
        }
        finally
        {
            _isBusy = false;
            _isReportBusy = false;
            StateHasChanged();
        }
    }

    private void SyncModelOrder()
    {
        var available = BuildDefaultModelOrder();
        var byKey = available.ToDictionary(m => m.Key, StringComparer.Ordinal);
        var synced = new List<DailyModelRef>();

        foreach (var existing in _modelOrder)
        {
            if (byKey.Remove(existing.Key, out var current))
                synced.Add(current);
        }

        synced.AddRange(available.Where(m => byKey.ContainsKey(m.Key)));
        _modelOrder = synced;
        var visibleKeys = _modelOrder.Select(m => m.Key).ToHashSet(StringComparer.Ordinal);
        _visibleDailyReasonModels.RemoveWhere(k => !visibleKeys.Contains(k));
    }

    private void ExpandDailyReasonModelsByDefault()
    {
        if (ReasonOnly) return;

        foreach (var model in OrderedModels.Where(ModelHasVisibleData))
            _visibleDailyReasonModels.Add(model.Key);
    }

    private List<DailyModelRef> BuildDefaultModelOrder()
    {
        var result = new List<DailyModelRef>();
        foreach (var group in _groups.Where(g => _selectedGroupNames.Contains(g.Name)))
        {
            foreach (var mid in group.MidGroups)
            {
                if (string.IsNullOrEmpty(mid.Material) || mid.LineShifts.Count == 0) continue;
                string key = ModelKey(group.Name, mid.Material);
                result.Add(new DailyModelRef(key, group.Name, mid.Material, mid.LineShifts.Count));
            }
        }
        return result;
    }

    private void ResetModelOrder()
    {
        _modelOrder = BuildDefaultModelOrder();
    }

    private void RemoveModel(string key)
    {
        _modelOrder.RemoveAll(m => string.Equals(m.Key, key, StringComparison.Ordinal));
        _expandedReasonSections.RemoveWhere(k => k.StartsWith(key + "||", StringComparison.Ordinal));
        _visibleDailyReasonModels.Remove(key);
    }

    private void MoveModel(string key, int delta)
    {
        var current = _modelOrder.FirstOrDefault(m => string.Equals(m.Key, key, StringComparison.Ordinal));
        if (current is null) return;

        var groupIndexes = _modelOrder
            .Select((model, index) => new { model, index })
            .Where(x => string.Equals(x.model.GroupName, current.GroupName, StringComparison.Ordinal))
            .Select(x => x.index)
            .ToList();

        int pos = groupIndexes.FindIndex(i => string.Equals(_modelOrder[i].Key, key, StringComparison.Ordinal));
        int newPos = pos + delta;
        if (pos < 0 || newPos < 0 || newPos >= groupIndexes.Count) return;

        int idx = groupIndexes[pos];
        int newIdx = groupIndexes[newPos];
        (_modelOrder[idx], _modelOrder[newIdx]) = (_modelOrder[newIdx], _modelOrder[idx]);
        _copiedElementId = string.Empty;
    }

    private bool IsFirstOrderedModel(string key)
    {
        var current = OrderedModels.FirstOrDefault(m => string.Equals(m.Key, key, StringComparison.Ordinal));
        if (current is null) return true;

        return OrderedModels
            .Where(m => string.Equals(m.GroupName, current.GroupName, StringComparison.Ordinal))
            .FirstOrDefault()?.Key == key;
    }

    private bool IsLastOrderedModel(string key)
    {
        var current = OrderedModels.FirstOrDefault(m => string.Equals(m.Key, key, StringComparison.Ordinal));
        if (current is null) return true;

        return OrderedModels
            .Where(m => string.Equals(m.GroupName, current.GroupName, StringComparison.Ordinal))
            .LastOrDefault()?.Key == key;
    }

