    private List<DailyReasonRow> GetModelReasonRows(
        string modelKey,
        IReadOnlyList<NgRateReportService.PeriodColumn> dateCols,
        IReadOnlyList<NgRateReportService.PeriodColumn> weekCols,
        IReadOnlyList<NgRateReportService.PeriodColumn> monthCols,
        string? referenceDateKey = null)
    {
        var result = new List<DailyReasonRow>();
        if (_reportByMid is null) return result;

        var periodKeys = PeriodKeys(dateCols, weekCols, monthCols).ToList();
        if (periodKeys.Count == 0) return result;
        bool showDailyHighPpmDetails = !ReasonOnly;
        referenceDateKey = string.IsNullOrEmpty(referenceDateKey)
            ? dateCols.FirstOrDefault()?.Key ?? string.Empty
            : referenceDateKey;
        if (showDailyHighPpmDetails && string.IsNullOrEmpty(referenceDateKey))
            return result;

        var sections = _reportByMid.ReasonRows
            .Where(r => !r.IsTotal)
            .GroupBy(r => r.Reason)
            .Select(group =>
            {
                var details = new List<DailyReasonRow>();
                foreach (var row in group)
                {
                    var groupPpm = row.Groups.FirstOrDefault(g =>
                        string.Equals(g.GroupName, modelKey, StringComparison.Ordinal));
                    if (groupPpm is null) continue;

                    var ppm = PeriodDict(periodKeys, key => groupPpm.Ppm.GetValueOrDefault(key));
                    if (!HasAnyPpm(ppm)) continue;

                    var detail = new DailyReasonRow(
                        Reason: row.Reason,
                        No: row.No,
                        IsTotal: false,
                        ProcessType: row.ProcessType,
                        ProcessName: row.ProcessName,
                        NgName: row.NgName,
                        Ppm: ppm);

                    if (showDailyHighPpmDetails &&
                        detail.Ppm.GetValueOrDefault(referenceDateKey) < DailyReasonPpmThreshold)
                    {
                        continue;
                    }

                    details.Add(detail);
                }

                var total = PeriodDict(periodKeys, key => details.Sum(r => r.Ppm.GetValueOrDefault(key)));
                double referencePpm = showDailyHighPpmDetails
                    ? total.GetValueOrDefault(referenceDateKey)
                    : RefValue(total);
                return new { Reason = group.Key, Details = details, Total = total, Ref = referencePpm };
            })
            .Where(s => s.Details.Count > 0)
            .OrderBy(s => showDailyHighPpmDetails ? 0 : IsOtherReason(s.Reason) ? 1 : 0)
            .ThenByDescending(s => s.Ref)
            .ThenBy(s => s.Reason, StringComparer.Ordinal)
            .ToList();

        var visibleSections = showDailyHighPpmDetails
            ? sections
            : sections.Take(MaxDisplayReasonRows);

        foreach (var section in visibleSections)
        {
            result.Add(new DailyReasonRow(
                Reason: section.Reason,
                No: 0,
                IsTotal: true,
                ProcessType: string.Empty,
                ProcessName: "Total",
                NgName: string.Empty,
                Ppm: section.Total));

            int no = 0;
            IEnumerable<DailyReasonRow> visibleDetails = section.Details
                .OrderByDescending(d => showDailyHighPpmDetails
                    ? d.Ppm.GetValueOrDefault(referenceDateKey)
                    : RefValue(d.Ppm))
                .ThenBy(d => d.ProcessType, StringComparer.Ordinal)
                .ThenBy(d => d.ProcessName, StringComparer.Ordinal)
                .ThenBy(d => d.NgName, StringComparer.Ordinal);

            if (!showDailyHighPpmDetails)
                visibleDetails = visibleDetails.Take(MaxDisplayReasonRows);

            foreach (var detail in visibleDetails)
            {
                no++;
                result.Add(detail with { No = no });
            }
        }

        return result;
    }

    private NgRateReportService.PeriodColumn? DailyReasonReferenceDateColumn(string modelKey)
    {
        if (VisibleDateCols.Count == 0)
            return null;

        foreach (var col in VisibleDateCols)
        {
            if (ModelHasDailyReasonPpm(modelKey, col.Key, DailyReasonPpmThreshold))
                return col;
        }

        foreach (var col in VisibleDateCols)
        {
            if (ModelHasDailyReasonPpm(modelKey, col.Key, 0d))
                return col;
        }

        return VisibleDateCols[0];
    }

    private bool ModelHasDailyReasonPpm(string modelKey, string dateKey, double threshold)
    {
        if (_reportByMid is null || string.IsNullOrEmpty(dateKey))
            return false;

        foreach (var row in _reportByMid.ReasonRows)
        {
            if (row.IsTotal)
                continue;

            var groupPpm = row.Groups.FirstOrDefault(g =>
                string.Equals(g.GroupName, modelKey, StringComparison.Ordinal));
            if (groupPpm is null)
                continue;

            double ppm = groupPpm.Ppm.GetValueOrDefault(dateKey);
            if (threshold <= 0d ? ppm > 0d : ppm >= threshold)
                return true;
        }

        return false;
    }

    /// <summary>
    /// Marks a top-level block of the Daily tab so the static export can split it into
    /// sub-tabs (Summary + one per model) and keep only the selected one mounted. Null
    /// outside export mode, which drops the attribute and leaves the interactive page as a
    /// single continuous scroll.
    /// </summary>
    private string? ExportSectionKey(string key) => ExportMode ? key : null;

    /// <summary>
    /// Reference-date PPM of a reason detail row, as a <c>data-ppm</c> value for the static
    /// export's viewer toolbar. Null outside export mode so Blazor omits the attribute and
    /// the interactive page's markup is unchanged.
    /// </summary>
    private string? ExportReasonPpm(DailyReasonRow row, string? referenceDateKey)
        => !ExportMode || string.IsNullOrEmpty(referenceDateKey)
            ? null
            : row.Ppm.GetValueOrDefault(referenceDateKey)
                 .ToString("0.####", System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>Heading template whose <c>{v}</c> the viewer toolbar replaces with the live
    /// threshold. Null outside export mode.</summary>
    private string? ExportReasonLabelTemplate(string referenceHeader)
        => ExportMode ? $"Reason Detail >= {{v}} PPM ({referenceHeader})" : null;

    /// <summary>
    /// Period block sizes for the static export's viewer toolbar. Every table in this tab
    /// lays its period columns out as date → week → month at the right edge of each row,
    /// so the viewer can locate them by counting back from the end once it knows these
    /// three counts — no per-cell tagging needed. Emitted once per tab body.
    /// </summary>
    private MarkupString ExportPeriodMeta()
    {
        if (!ExportMode) return default;
        string json = System.Text.Json.JsonSerializer.Serialize(new
        {
            date  = VisibleDateCols.Count,
            week  = VisibleWeekCols.Count,
            month = VisibleMonthCols.Count,
        });
        return new MarkupString($"<script type=\"application/json\" data-periods>{json}</script>");
    }

    private double MeanOfGroups(string colKey)
        => WeightedReportPpm(_report, SelectedGroups.Select(g => g.Name), colKey, null);

    private double MeanOfMembers(string groupName, string colKey, string? processType)
        => ReadSummaryPpm(_report, groupName, colKey, processType);

    private double MidPpmAvgOfSubs(string groupName, string material, string colKey)
        => MidGroupPpm(groupName, material, colKey);

    private double MidGroupPpm(string groupName, string material, string colKey, string? processType = null)
    {
        if (_reportByMid is null) return 0;
        string key = ModelKey(groupName, material);
        var rows = _reportByMid.GroupSummary.GetValueOrDefault(key);
        if (rows is null) return 0;

        var row = processType is null
            ? rows.FirstOrDefault(r => r.IsTotal)
            : rows.FirstOrDefault(r => !r.IsTotal && r.ProcessType == processType);
        return row?.Ppm.GetValueOrDefault(colKey) ?? 0;
    }

    private List<NgRateReportService.SummaryPivotRow> GetBGrSummaryRows(string bGrKey)
    {
        if (_reportBySubGroup is null) return [];
        var rows = _reportBySubGroup.GroupSummary.GetValueOrDefault(bGrKey);
        return rows ?? [];
    }

    private double BGrPpm(string bGrKey, string colKey, string? processType = null)
    {
        var rows = GetBGrSummaryRows(bGrKey);
        var row = processType is null
            ? rows.FirstOrDefault(r => r.IsTotal)
            : rows.FirstOrDefault(r => !r.IsTotal && string.Equals(r.ProcessType, processType, StringComparison.Ordinal));
        return row?.Ppm.GetValueOrDefault(colKey) ?? 0;
    }

    private static double ReadSummaryPpm(
        NgRateReportService.NgRateReport? report,
        string groupName,
        string colKey,
        string? processType = null)
    {
        if (report is null) return 0;
        var rows = report.GroupSummary.GetValueOrDefault(groupName);
        var row = processType is null
            ? rows?.FirstOrDefault(r => r.IsTotal)
            : rows?.FirstOrDefault(r => !r.IsTotal && string.Equals(r.ProcessType, processType, StringComparison.Ordinal));
        return row?.Ppm.GetValueOrDefault(colKey) ?? 0;
    }

    private static double WeightedReportPpm(
        NgRateReportService.NgRateReport? report,
        IEnumerable<string> groupNames,
        string colKey,
        string? processType)
    {
        if (report is null) return 0;
        var selected = groupNames.Where(g => !string.IsNullOrWhiteSpace(g)).ToHashSet(StringComparer.Ordinal);
        if (selected.Count == 0) return 0;

        if (report.GroupRawIn.Count > 0)
        {
            return report.GroupRawIn
                .Where(kv => selected.Contains(kv.Key.Item4) &&
                             kv.Key.Item5 == colKey &&
                             (processType is null || string.Equals(kv.Key.Item1, processType, StringComparison.Ordinal)))
                .GroupBy(kv => (kv.Key.Item1, kv.Key.Item2, kv.Key.Item3))
                .Sum(g => ToPpm(g.Sum(kv => kv.Value.I), g.Sum(kv => kv.Value.N)));
        }

        double sum = 0;
        int count = 0;
        foreach (string groupName in selected)
        {
            double v = ReadSummaryPpm(report, groupName, colKey, processType);
            if (v <= 0) continue;
            sum += v;
            count++;
        }
        return count == 0 ? 0 : sum / count;
    }

    private static double ToPpm(double input, double ng)
        => input <= 0 || ng <= 0 ? 0 : ng / input * 1_000_000d;

    private bool IsRootSelection(ModelGroupRecord group)
        => _allGroupNamesById.TryGetValue(group.Id, out string? rootName)
            ? string.Equals(rootName, group.Name, StringComparison.Ordinal)
            : _groupOverride is null;

    private bool BGrHasData(
        ChronicBucketRef bucket,
        IReadOnlyList<NgRateReportService.PeriodColumn> dateCols,
        IReadOnlyList<NgRateReportService.PeriodColumn> weekCols,
        IReadOnlyList<NgRateReportService.PeriodColumn> monthCols)
    {
        foreach (var col in dateCols) if (BGrPpm(bucket.Key, col.Key) > 0) return true;
        foreach (var col in weekCols) if (BGrPpm(bucket.Key, col.Key) > 0) return true;
        foreach (var col in monthCols) if (BGrPpm(bucket.Key, col.Key) > 0) return true;
        return false;
    }

    private bool ModelHasVisibleData(DailyModelRef model)
    {
        foreach (var col in VisibleDateCols) if (MidPpmAvgOfSubs(model.GroupName, model.Material, col.Key) > 0) return true;
        foreach (var col in VisibleWeekCols) if (MidPpmAvgOfSubs(model.GroupName, model.Material, col.Key) > 0) return true;
        foreach (var col in VisibleMonthCols) if (MidPpmAvgOfSubs(model.GroupName, model.Material, col.Key) > 0) return true;
        return false;
    }

    private bool ModelHasData(
        DailyModelRef model,
        IReadOnlyList<NgRateReportService.PeriodColumn> dateCols,
        IReadOnlyList<NgRateReportService.PeriodColumn> weekCols,
        IReadOnlyList<NgRateReportService.PeriodColumn> monthCols)
    {
        foreach (var col in dateCols) if (MidPpmAvgOfSubs(model.GroupName, model.Material, col.Key) > 0) return true;
        foreach (var col in weekCols) if (MidPpmAvgOfSubs(model.GroupName, model.Material, col.Key) > 0) return true;
        foreach (var col in monthCols) if (MidPpmAvgOfSubs(model.GroupName, model.Material, col.Key) > 0) return true;
        return false;
    }

    private IEnumerable<string> VisiblePeriodKeys()
        => PeriodKeys(VisibleDateCols, VisibleWeekCols, VisibleMonthCols);

    private static IEnumerable<string> PeriodKeys(
        IReadOnlyList<NgRateReportService.PeriodColumn> dateCols,
        IReadOnlyList<NgRateReportService.PeriodColumn> weekCols,
        IReadOnlyList<NgRateReportService.PeriodColumn> monthCols)
        => dateCols.Select(c => c.Key)
            .Concat(weekCols.Select(c => c.Key))
            .Concat(monthCols.Select(c => c.Key));

    private (string Key, string Bucket) SortRefKey()
    {
        if (VisibleWeekCols.Count >= 2) return (VisibleWeekCols[1].Key, "week");
        if (VisibleWeekCols.Count == 1) return (VisibleWeekCols[0].Key, "week");
        if (VisibleDateCols.Count > 0) return (VisibleDateCols[0].Key, "date");
        if (VisibleMonthCols.Count > 0) return (VisibleMonthCols[0].Key, "month");
        return (string.Empty, string.Empty);
    }

    private double RefValue(Dictionary<string, double> ppm)
    {
        var (key, _) = SortRefKey();
        if (!string.IsNullOrEmpty(key)) return ppm.GetValueOrDefault(key);
        return ppm.Values.DefaultIfEmpty(0).Max();
    }

    private static Dictionary<string, double> PeriodDict(
        IEnumerable<string> keys,
        Func<string, double> valueOf)
    {
        var dict = new Dictionary<string, double>(StringComparer.Ordinal);
        foreach (string key in keys)
        {
            if (!dict.ContainsKey(key))
                dict[key] = valueOf(key);
        }

        return dict;
    }

    private static bool HasAnyPpm(Dictionary<string, double> ppm)
        => ppm.Values.Any(v => v > 0);

    private static bool IsOtherReason(string reason)
        => string.Equals(reason, OtherReason, StringComparison.OrdinalIgnoreCase);

    private static string ModelKey(string groupName, string material)
        => NgRateModeSupport.ModelKey(groupName, material);

    private static string ModelCopyTargetId(string modelKey)
        => "dailyModelCopy_" + new string(modelKey.Select(ch => char.IsLetterOrDigit(ch) ? ch : '_').ToArray());

    private static string FormatPpm(double v)
        => NgRateModeSupport.FormatPpm(v);

    private static string PpmClass(double v)
        => NgRateModeSupport.PpmClass(v);

    private RenderFragment SummaryPpmCell(double value, double? previous) => builder =>
    {
        int seq = 0;
        builder.OpenElement(seq++, "td");
        builder.AddAttribute(seq++, "class", PpmClass(value));
        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "class", "ppm-cell-value");
        builder.AddContent(seq++, FormatPpm(value));
        builder.CloseElement();

        if (_showDailySummaryDelta)
        {
            var delta = BuildDeltaDisplay(value, previous);
            if (delta is not null)
            {
                builder.OpenElement(seq++, "span");
                builder.AddAttribute(seq++, "class", delta.CssClass);
                builder.AddContent(seq++, delta.Text);
                builder.CloseElement();
            }
        }

        builder.CloseElement();
    };

    private double? PreviousDatePpm(NgRateReportService.PeriodColumn col, Func<string, double> valueOf)
        => PreviousColumnPpm(_report?.DateCols, col, valueOf);

    private double? PreviousWeekPpm(NgRateReportService.PeriodColumn col, Func<string, double> valueOf)
        => PreviousColumnPpm(_report?.WeekCols, col, valueOf);

    private double? PreviousMonthPpm(NgRateReportService.PeriodColumn col, Func<string, double> valueOf)
        => PreviousColumnPpm(_report?.MonthCols, col, valueOf);

    private static double? PreviousColumnPpm(
        IReadOnlyList<NgRateReportService.PeriodColumn>? cols,
        NgRateReportService.PeriodColumn col,
        Func<string, double> valueOf)
    {
        if (cols is null) return null;

        for (int i = 0; i < cols.Count; i++)
        {
            if (!string.Equals(cols[i].Key, col.Key, StringComparison.Ordinal)) continue;
            if (i + 1 >= cols.Count) return null;

            for (int j = i + 1; j < cols.Count; j++)
            {
                double previous = valueOf(cols[j].Key);
                if (previous > 0) return previous;
            }

            return valueOf(cols[i].Key);
        }

        return null;
    }

    private static DeltaDisplay? BuildDeltaDisplay(double current, double? previous)
    {
        if (current <= 0) return null;
        if (!previous.HasValue) return null;

        long delta = (long)Math.Round(current - previous.Value);
        if (delta == 0)
            return new DeltaDisplay("0", "ppm-delta ppm-delta-flat");

        string text = delta > 0
            ? "+" + delta.ToString("N0", CultureInfo.InvariantCulture)
            : delta.ToString("N0", CultureInfo.InvariantCulture);
        string css = delta > 0 ? "ppm-delta ppm-delta-up" : "ppm-delta ppm-delta-down";
        return new DeltaDisplay(text, css);
    }

    private static string ReportGroupDisplayName(string groupName)
    {
        if (string.IsNullOrWhiteSpace(groupName)) return string.Empty;

        int idx = groupName.IndexOf('_', StringComparison.Ordinal);
        return idx >= 0 && idx + 1 < groupName.Length
            ? groupName[(idx + 1)..]
            : groupName;
    }

    private void AddLog(string message)
    {
        _logs.Add($"[{DateTime.Now:HH:mm:ss}] {message}");
        _externalProgress?.Report(message);
        _ = InvokeAsync(StateHasChanged);
    }

