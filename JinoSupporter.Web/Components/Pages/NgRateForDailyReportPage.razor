        _isReportBusy = false;
        _errorMessage = string.Empty;
        _reportError = string.Empty;
        _savedDbPath = sharedHierarchy.ByGroup.DbPath;
        _report = sharedHierarchy.ByGroup;
        _reportByMid = sharedHierarchy.ByMid;
        _reportByModel = sharedHierarchy.ByLs;
        _reportBySubGroup = sharedHierarchy.BySub1;
