@code {
    private static readonly int[] MaxRowChoices = [500, 2000, 5000, 10000, 20000];

    /// <summary>The offered caps with whatever is in force folded in — the window can be opened
    /// with ?max= from QR SUMMARY, which is not necessarily one of the presets.</summary>
    private IEnumerable<int> MaxRowOptions =>
        MaxRowChoices.Append(_maxRows).Where(value => value > 0).Distinct().OrderBy(value => value);

    /// <summary>
    /// Markers the SVG will draw, shared out between the visible series. Beyond this the strips
    /// are solid anyway, so the points are sampled evenly — the statistics still run over every
    /// reading, never the sample.
    /// </summary>
    private const int MaxPlottedPoints = 8000;

    /// <summary>A hover title per circle is one extra DOM node each; only worth it on a small cloud.</summary>
    private const int MaxTitledPoints = 1500;

    /// <summary>Matches QR SUMMARY: how long typing has to settle before a date edit reloads.</summary>
    private const int DateSettleMs = 900;

    private const double PlotLeft = 74;
    private const double PlotRight = 890;
    private const double PlotTop = 34;
    private const double PlotBottom = 500;

    /// <summary>Fraction of a series' slot inside a date column that the jittered strip may fill.</summary>
    private const double JitterFill = 0.36;

    /// <summary>Left edge of the normal-curve panel and how far full density reaches to the right.</summary>
    private const double CurveBase = 946;
    private const double CurveWidth = 150;

    private const int HistogramBins = 34;

    /// <summary>Vertical pitch of the value column beside a box — 10px type needs this much room.</summary>
    private const double BoxLabelPitch = 12;

    private const string MarkColor = "#16202b";

    private const string ValueColor = "#1f5fa8";
    private const string Value2Color = "#8a4fb8";

    [SupplyParameterFromQuery(Name = "from")] public string? FromQuery { get; set; }
    [SupplyParameterFromQuery(Name = "to")] public string? ToQuery { get; set; }
    [SupplyParameterFromQuery(Name = "max")] public string? MaxQuery { get; set; }
    [SupplyParameterFromQuery(Name = "series")] public string? SeriesQuery { get; set; }

    // Both readings of every round are kept, so toggling a series costs no query.
    private List<GaussPoint> _value = [];
    private List<GaussPoint> _value2 = [];

    // Derived once per data or filter change. The render loops read these thousands of times,
    // so recomputing them per access would re-sort the whole series on every marker.
    private List<SeriesView> _views = [];
    private List<DateOnly> _dates = [];
    private Dictionary<DateOnly, int> _dateIndex = [];
    private List<DateColumn> _columns = [];
    private Scale _scale = Scale.Unit;
    private double _band = PlotRight - PlotLeft;

    /// <summary>The last fetch, kept so the model dropdown can re-derive the points without a query.</summary>
    private QrSummaryResult? _result;

    /// <summary>Model code currently plotted; empty means every model.</summary>
    private string _modelCode = string.Empty;
    private IReadOnlyList<ModelOption> _modelOptions = [];
    private readonly HashSet<string> _knownCodes = new(StringComparer.OrdinalIgnoreCase);

    private sealed record ModelOption(string Code, string Label);

    private QrSummaryBounds _bounds = new(null, null, null);
    private CancellationTokenSource? _dateSettle;
    private DateOnly _from;
    private DateOnly _to;
    private int _maxRows = 2000;
    private bool _showValue = true;
    private bool _showValue2 = true;
    private bool _ngOnly;
    private DateTime _fetchedAt;
    private string _error = string.Empty;
    private bool _busy;

    /// <param name="Jitter">Stable −1..1 offset inside the slot, so a redraw never reshuffles the strip.</param>
    private sealed record GaussPoint(string ProductId, DateTimeOffset Time, DateOnly Date, double Value, bool IsNg, double Jitter);

    private sealed record DateColumn(int Index, DateOnly Date, string Label, int Count, double Left, double Center, bool ShowLabel);

    private sealed record HistogramBar(double Top, double Height, double Width);

    private sealed record SigmaMark(double Y, string Label);

    /// <param name="LineY">Where the value actually sits on the axis.</param>
    /// <param name="TextY">Where the label ended up after the column was spread out.</param>
    private sealed record BoxLabel(string Text, double LineY, double TextY, string Fill)
    {
        public bool Nudged => Math.Abs(TextY - 3.4 - LineY) > 1.5;
    }

    private sealed record Stats(int N, double Mean, double Median, double Min, double Max, double Q1, double Q3, double StdDev)
    {
        public static readonly Stats Empty = new(0, 0, 0, 0, 0, 0, 0, 0);
    }

    /// <summary>Everything one visible series contributes to the chart, resolved once per rebuild.</summary>
    /// <param name="Slot">0 for Value, 1 for Value 2 — also the series' lane inside a date column.</param>
    private sealed record SeriesView(
        int Slot,
        int Lane,
        int LaneCount,
        string Label,
        string Color,
        List<GaussPoint> Points,
        List<GaussPoint> Plotted,
        Stats Stats,
        int NgCount,
        double? NgRatePpm,
        List<HistogramBar> Histogram,
        List<SigmaMark> SigmaMarks,
        List<BoxLabel> BoxLabels,
        string Curve,
        double BoxCenter,
        double BoxHalf,
        double CapHalf,
        double LabelX)
    {
        public bool ShowTitles => Points.Count <= MaxTitledPoints;
    }

    /// <summary>Linear value-to-pixel mapping plus the ticks that were chosen for it.</summary>
    private sealed record Scale(double Lo, double Hi, IReadOnlyList<double> Ticks)
    {
        public static readonly Scale Unit = new(0, 1, []);

        public double Map(double value)
        {
            double span = Hi - Lo;
            double t = span <= 0 ? 0.5 : (value - Lo) / span;
            return PlotBottom - t * (PlotBottom - PlotTop);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _from = ParseDate(FromQuery);
        _to = ParseDate(ToQuery);
        // The window is opened from QR SUMMARY with ?max=, which wins; a direct visit falls back
        // to the cap last picked on either page.
        _maxRows = int.TryParse(MaxQuery, NumberStyles.Integer, CultureInfo.InvariantCulture, out int max) && max > 0
            ? max
            : QrViewPreferenceService.Resolve(QrViewPrefs.MaxQr, _maxRows);

        // series=1 / series=2 open the window on one reading; anything else shows both.
        if (string.Equals(SeriesQuery, "1", StringComparison.Ordinal))
            _showValue2 = false;
        else if (string.Equals(SeriesQuery, "2", StringComparison.Ordinal))
            _showValue = false;

        if (QrSummary.IsConfigured)
            await LoadAsync();
    }

    private void RedirectToLogin() =>
        Nav.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(Nav.Uri)}", forceLoad: true);

    /// <summary>Toggles one reading on or off; the last visible one stays on so the chart is never empty.</summary>
    private void ToggleSeries(int slot)
    {
        if (slot == 0)
        {
            if (_showValue && !_showValue2)
                return;
            _showValue = !_showValue;
        }
        else
        {
            if (_showValue2 && !_showValue)
                return;
            _showValue2 = !_showValue2;
        }
        Rebuild();
    }

    private void SetNgOnly(bool ngOnly)
    {
        _ngOnly = ngOnly;
        Rebuild();
    }

    private async Task ReloadAsync()
    {
        CancelDateSettle();
        await LoadAsync();
    }

    private void OnFromChanged(ChangeEventArgs args)
    {
        if (TryParseDate(args.Value, out DateOnly value))
        {
            _from = value;
            QueueDateReload();
        }
    }

    private void OnToChanged(ChangeEventArgs args)
    {
        if (TryParseDate(args.Value, out DateOnly value))
        {
            _to = value;
            QueueDateReload();
        }
    }

    /// <summary>
    /// Reloads once the user stops editing the date. Nothing is re-rendered while the timer
    /// runs, so the input being typed into is never touched — see <see cref="DateSettleMs"/>.
    /// </summary>
    private void QueueDateReload()
    {
        CancelDateSettle();
        var settle = new CancellationTokenSource();
        _dateSettle = settle;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(DateSettleMs, settle.Token);
                await InvokeAsync(LoadAsync);
            }
            catch (OperationCanceledException)
            {
                // Superseded by a newer keystroke, or the window went away.
            }
        });
    }

    private void CancelDateSettle()
    {
        CancellationTokenSource? settle = _dateSettle;
        _dateSettle = null;
        if (settle is null)
            return;

        settle.Cancel();
        settle.Dispose();
    }

    public void Dispose() => CancelDateSettle();

    private async Task OnMaxRowsChanged(ChangeEventArgs args)
    {
        if (int.TryParse(Convert.ToString(args.Value, CultureInfo.InvariantCulture), out int value) && value > 0)
        {
            _maxRows = value;
            QrViewPrefs.SetMaxQr(value);
            await LoadAsync();
        }
    }

    /// <summary>Sets the window to the newest day with data, going back <paramref name="daysBack"/> days.</summary>
    private async Task ApplyQuickRangeAsync(int daysBack)
    {
        CancelDateSettle();
        DateOnly anchor = _bounds.MaxDate ?? DateOnly.FromDateTime(DateTime.Today);
        _to = anchor;
        _from = anchor.AddDays(-daysBack);
        await LoadAsync();
    }

    private int TotalPoints => _views.Sum(v => v.Points.Count);

    private int PlottedPoints => _views.Sum(v => v.Plotted.Count);

    private async Task LoadAsync()
    {
        if (_busy)
            return;

        _busy = true;
        _error = string.Empty;
        StateHasChanged();

        try
        {
            QrSummaryResult result = await QrSummary.FetchAsync(new QrSummaryQuery
            {
                From = _from,
                To = _to,
                MaxRows = _maxRows,
            });

            _result = result;
            _from = result.From;
            _to = result.To;
            _maxRows = result.MaxRows;
            _bounds = result.Bounds;
            _fetchedAt = result.FetchedAt;

            BuildModelOptions();
            BuildPoints();
            Rebuild();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    /// <summary>Re-derives the visible series, the shared axis, the date columns and both panels.</summary>
    private void Rebuild()
    {
        var lanes = new List<(int Slot, string Label, string Color, List<GaussPoint> Points)>(2);
        if (_showValue)
            lanes.Add((0, "Value", ValueColor, Filter(_value)));
        if (_showValue2)
            lanes.Add((1, "Value 2", Value2Color, Filter(_value2)));

        int laneCount = Math.Max(lanes.Count, 1);
        int total = lanes.Sum(l => l.Points.Count);

        // The two readings share one axis on purpose: side-by-side boxes only compare if the
        // scale under them is the same one.
        double lo = double.MaxValue;
        double hi = double.MinValue;
        foreach ((_, _, _, List<GaussPoint> points) in lanes)
        {
            foreach (GaussPoint p in points)
            {
                if (p.Value < lo) lo = p.Value;
                if (p.Value > hi) hi = p.Value;
            }
        }

        _scale = total == 0 ? Scale.Unit : BuildScale(lo, hi);

        BuildDateColumns(lanes.SelectMany(l => l.Points));

        int budget = Math.Max(MaxPlottedPoints / laneCount, 1);
        var views = new List<SeriesView>(lanes.Count);
        for (int i = 0; i < lanes.Count; i++)
        {
            (int slot, string label, string color, List<GaussPoint> points) = lanes[i];
            Stats stats = Describe(points);
            List<GaussPoint> raw = slot == 0 ? _value : _value2;
            int ng = raw.Count(p => p.IsNg);

            // With one series its histogram sits behind the curve; with two the bars would
            // only muddy each other, so the curves carry the comparison alone.
            bool single = lanes.Count == 1;

            // Every box carries its own value column, so two of them have to share the 200px right
            // of the curve (946..1096 stays the curve's): narrower boxes, 100px apart, label column
            // 8px off each box. The single box keeps its old width and reads on the same footing.
            double boxCenter = single ? 1180 : 1116 + i * 100;
            double boxHalf = single ? 38 : 16;

            views.Add(new SeriesView(
                slot,
                i,
                laneCount,
                label,
                color,
                points,
                Sample(points, budget),
                stats,
                ng,
                raw.Count == 0 ? null : ng / (double)raw.Count * 1_000_000d,
                single ? BuildHistogram(points) : [],
                single ? BuildSigmaMarks(stats) : [],
                BuildBoxLabels(stats, color),
                BuildNormalCurve(stats),
                boxCenter,
                boxHalf,
                single ? 28 : 12,
                boxCenter + boxHalf + 12));
        }
        _views = views;
    }

    private List<GaussPoint> Filter(List<GaussPoint> points) =>
        _ngOnly ? points.Where(p => p.IsNg).ToList() : points;

    /// <summary>
    /// One column per test date, evenly spaced. The axis is categorical on purpose: a two-day
    /// window gets exactly two columns, whatever hours the tests actually ran at.
    /// </summary>
    private void BuildDateColumns(IEnumerable<GaussPoint> points)
    {
        var counts = new Dictionary<DateOnly, int>();
        foreach (GaussPoint p in points)
            counts[p.Date] = counts.GetValueOrDefault(p.Date) + 1;

        _dates = counts.Keys.OrderBy(static d => d).ToList();
        _dateIndex = _dates.Select(static (date, i) => (date, i)).ToDictionary(t => t.date, t => t.i);
        if (_dates.Count == 0)
        {
            _columns = [];
            _band = PlotRight - PlotLeft;
            return;
        }

        _band = (PlotRight - PlotLeft) / _dates.Count;

        // Past roughly 16 columns the MM-dd labels start colliding, so only every nth is drawn.
        int labelStride = (int)Math.Ceiling(_dates.Count / 16d);

        var columns = new List<DateColumn>(_dates.Count);
        for (int i = 0; i < _dates.Count; i++)
        {
            DateOnly date = _dates[i];
            columns.Add(new DateColumn(
                i,
                date,
                date.ToString("MM-dd", CultureInfo.InvariantCulture),
                counts[date],
                PlotLeft + i * _band,
                PlotLeft + (i + 0.5) * _band,
                i % labelStride == 0));
        }
        _columns = columns;
    }

    /// <summary>The readings' own distribution, as bars growing right from the curve baseline.</summary>
    private List<HistogramBar> BuildHistogram(List<GaussPoint> points)
    {
        double span = _scale.Hi - _scale.Lo;
        if (points.Count == 0 || span <= 0)
            return [];

        double binSpan = span / HistogramBins;
        var bins = new int[HistogramBins];
        foreach (GaussPoint p in points)
        {
            int index = (int)((p.Value - _scale.Lo) / binSpan);
            bins[Math.Clamp(index, 0, HistogramBins - 1)]++;
        }

        int tallest = bins.Max();
        if (tallest == 0)
            return [];

        var bars = new List<HistogramBar>(HistogramBins);
        for (int i = 0; i < HistogramBins; i++)
        {
            if (bins[i] == 0)
                continue;

            double binLo = _scale.Lo + i * binSpan;
            double top = _scale.Map(binLo + binSpan);
            double bottom = _scale.Map(binLo);
            bars.Add(new HistogramBar(top, Math.Max(bottom - top, 0.6), bins[i] / (double)tallest * CurveWidth));
        }
        return bars;
    }

    /// <summary>
    /// The normal curve fitted from the mean and standard deviation, drawn vertically: value on
    /// the shared Y axis, density to the right. The peak is normalised to the full panel width so
    /// it sits on the same footing as the tallest histogram bar.
    /// </summary>
    private string BuildNormalCurve(Stats stats)
    {
        double span = _scale.Hi - _scale.Lo;
        if (stats.N == 0 || stats.StdDev <= 0 || span <= 0)
            return string.Empty;

        var curve = new System.Text.StringBuilder(2048);
        const int Steps = 160;
        for (int i = 0; i <= Steps; i++)
        {
            double v = _scale.Lo + span * i / Steps;
            double z = (v - stats.Mean) / stats.StdDev;
            double density = Math.Exp(-0.5 * z * z);
            if (curve.Length > 0)
                curve.Append(' ');
            curve.Append(F(CurveBase + density * CurveWidth)).Append(',').Append(F(_scale.Map(v)));
        }
        return curve.ToString();
    }

    /// <summary>
    /// The six numbers that go beside a box. A tight IQR puts Q1, Q2, Q3 and the mean within a few
    /// pixels of each other — Value 2's IQR of 3 lands them inside 7px — so the column is spread to
    /// a readable pitch and each label that had to move keeps a leader back to its own line.
    /// </summary>
    private List<BoxLabel> BuildBoxLabels(Stats stats, string accent)
    {
        if (stats.N == 0)
            return [];

        (string Text, double Value, string Fill)[] source =
        [
            ($"MAX {MarkNum(stats.Max)}", stats.Max, MarkColor),
            ($"Q3 {MarkNum(stats.Q3)}", stats.Q3, MarkColor),
            ($"Q2 {MarkNum(stats.Median)}", stats.Median, MarkColor),
            ($"MEAN {MarkNum(stats.Mean)}", stats.Mean, accent),
            ($"Q1 {MarkNum(stats.Q1)}", stats.Q1, MarkColor),
            ($"MIN {MarkNum(stats.Min)}", stats.Min, MarkColor),
        ];

        List<BoxLabel> labels = source
            .Select(s => new BoxLabel(s.Text, _scale.Map(s.Value), _scale.Map(s.Value) + 3.4, s.Fill))
            .OrderBy(static l => l.LineY)
            .ToList();

        for (int i = 1; i < labels.Count; i++)
        {
            double floor = labels[i - 1].TextY + BoxLabelPitch;
            if (labels[i].TextY < floor)
                labels[i] = labels[i] with { TextY = floor };
        }

        // Spreading downwards can push the last label under the panel; when it does, hang the
        // column off the bottom instead and let it grow upwards.
        double limit = PlotBottom + 13;
        if (labels[^1].TextY > limit)
        {
            labels[^1] = labels[^1] with { TextY = limit };
            for (int i = labels.Count - 2; i >= 0; i--)
            {
                double ceiling = labels[i + 1].TextY - BoxLabelPitch;
                if (labels[i].TextY > ceiling)
                    labels[i] = labels[i] with { TextY = ceiling };
            }
        }

        return labels;
    }

    private List<SigmaMark> BuildSigmaMarks(Stats stats)
    {
        if (stats.N == 0 || stats.StdDev <= 0)
            return [];

        var marks = new List<SigmaMark>(4);
        foreach (int k in new[] { -2, -1, 1, 2 })
        {
            double v = stats.Mean + k * stats.StdDev;
            if (v < _scale.Lo || v > _scale.Hi)
                continue;

            marks.Add(new SigmaMark(_scale.Map(v), $"{(k > 0 ? "+" : "−")}{Math.Abs(k)}σ"));
        }
        return marks;
    }

    /// <summary>
    /// Each date column is split into one lane per visible reading, so Value and Value 2 stand
    /// beside each other on the same date instead of overprinting.
    /// </summary>
    private double XMap(GaussPoint point, SeriesView view)
    {
        int index = _dateIndex.GetValueOrDefault(point.Date);
        double lane = _band / view.LaneCount;
        double center = PlotLeft + index * _band + (view.Lane + 0.5) * lane;
        return center + point.Jitter * lane * JitterFill;
    }

    /// <summary>The markers actually drawn: every point, or an even sample once the strips are solid.</summary>
    private static List<GaussPoint> Sample(List<GaussPoint> points, int budget)
    {
        if (points.Count <= budget)
            return points;

        int stride = (int)Math.Ceiling(points.Count / (double)budget);
        var sampled = new List<GaussPoint>(budget + 1);
        for (int i = 0; i < points.Count; i += stride)
            sampled.Add(points[i]);
        return sampled;
    }

    private void OnModelChanged(ChangeEventArgs args)
    {
        _modelCode = (Convert.ToString(args.Value, CultureInfo.InvariantCulture) ?? string.Empty).Trim();
        BuildPoints();
        Rebuild();
    }

    /// <summary>Re-derives both series from the last fetch, keeping only the selected model.</summary>
    private void BuildPoints()
    {
        var value = new List<GaussPoint>();
        var value2 = new List<GaussPoint>();

        // Every round counts, not just the newest: dispersion is exactly what the retests show.
        foreach (QrSummaryRow product in _result?.Rows ?? [])
        {
            if (!MatchesModel(product.ProductId))
                continue;

            Collect(product.ProductId, product, value, value2);
            foreach (QrSummaryRow older in product.Older)
                Collect(product.ProductId, older, value, value2);
        }

        value.Sort(static (a, b) => a.Time.CompareTo(b.Time));
        value2.Sort(static (a, b) => a.Time.CompareTo(b.Time));
        _value = value;
        _value2 = value2;
    }

    private bool MatchesModel(string productId)
    {
        if (_modelCode.Length == 0)
            return true;

        string code = QrModelCodeService.ExtractCode(productId);
        return string.Equals(_modelCode, QrModelCodeService.UnmappedCode, StringComparison.Ordinal)
            ? !_knownCodes.Contains(code)
            : string.Equals(code, _modelCode, StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>Offers only the models the fetched QR actually contain, each with its QR count.</summary>
    private void BuildModelOptions()
    {
        _knownCodes.Clear();
        _modelOptions = [];
        if (_result is null)
            return;

        var names = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (QrModelCode entry in QrModelCodes.Codes)
        {
            _knownCodes.Add(entry.Code);
            names[entry.Code] = string.IsNullOrWhiteSpace(entry.Name) ? entry.Code : entry.Name;
        }

        var counts = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        int unmapped = 0;
        foreach (QrSummaryRow row in _result.Rows)
        {
            string code = QrModelCodeService.ExtractCode(row.ProductId);
            if (_knownCodes.Contains(code))
                counts[code] = counts.TryGetValue(code, out int seen) ? seen + 1 : 1;
            else
                unmapped++;
        }

        var options = new List<ModelOption>();
        foreach ((string code, string name) in names.OrderBy(entry => entry.Key, StringComparer.Ordinal))
        {
            if (counts.TryGetValue(code, out int count))
                options.Add(new ModelOption(code, $"{name} ({code}) · {count:N0} QR"));
        }

        if (unmapped > 0)
            options.Add(new ModelOption(QrModelCodeService.UnmappedCode, $"Other · {unmapped:N0} QR"));

        _modelOptions = options;

        if (_modelCode.Length > 0 && !options.Any(option => string.Equals(option.Code, _modelCode, StringComparison.OrdinalIgnoreCase)))
            _modelCode = string.Empty;
    }

    private static void Collect(string productId, QrSummaryRow row, List<GaussPoint> value, List<GaussPoint> value2)
    {
        if (row.Gauss is not QrSummaryCell cell || cell.TestTime is not DateTimeOffset time)
            return;

        bool ng = cell.Verdict == QrVerdict.Fail;
        DateOnly date = DateOnly.FromDateTime(time.LocalDateTime);
        Add(value, cell.ItemAt(0), 0);
        Add(value2, cell.ItemAt(1), 1);

        void Add(List<GaussPoint> target, QrSummaryItem? item, int slot)
        {
            if (item is not null && TryParseNumber(item.Value, out double parsed))
                target.Add(new GaussPoint(productId, time, date, parsed, ng, Jitter(productId, time, slot)));
        }
    }

    /// <summary>
    /// A repeatable −1..1 spread for one reading. Hashing the QR and its timestamp rather than
    /// drawing at random keeps a point in the same place across re-renders, so toggling a series
    /// does not reshuffle the strip under the user.
    /// </summary>
    private static double Jitter(string productId, DateTimeOffset time, int slot)
    {
        // FNV-1a over the identity of the reading; string.GetHashCode is per-process randomised.
        unchecked
        {
            uint hash = 2166136261;
            foreach (char c in productId)
                hash = (hash ^ c) * 16777619;

            hash = (hash ^ (uint)time.Ticks) * 16777619;
            hash = (hash ^ (uint)(time.Ticks >> 32)) * 16777619;
            hash = (hash ^ (uint)slot) * 16777619;
            return hash / (double)uint.MaxValue * 2 - 1;
        }
    }

    /// <summary>
    /// GSTD readings arrive as text (the summary query casts every column to nvarchar), and a
    /// tester occasionally appends a unit. Take the leading numeric token and ignore the rest.
    /// </summary>
    private static bool TryParseNumber(string? text, out double value)
    {
        value = 0;
        if (string.IsNullOrWhiteSpace(text))
            return false;

        ReadOnlySpan<char> span = text.AsSpan().Trim();
        int end = 0;
        while (end < span.Length &&
               (char.IsAsciiDigit(span[end]) || span[end] is '+' or '-' or '.' or 'e' or 'E'))
        {
            end++;
        }

        return double.TryParse(
            span[..end],
            NumberStyles.Float,
            CultureInfo.InvariantCulture,
            out value)
            && !double.IsNaN(value)
            && !double.IsInfinity(value);
    }

    private static Stats Describe(List<GaussPoint> points)
    {
        double[] sorted = points.Select(p => p.Value).OrderBy(static v => v).ToArray();
        if (sorted.Length == 0)
            return Stats.Empty;

        double mean = sorted.Average();
        double variance = sorted.Length < 2
            ? 0
            : sorted.Sum(v => (v - mean) * (v - mean)) / (sorted.Length - 1);

        return new Stats(
            sorted.Length,
            mean,
            Quantile(sorted, 0.5),
            sorted[0],
            sorted[^1],
            Quantile(sorted, 0.25),
            Quantile(sorted, 0.75),
            Math.Sqrt(variance));
    }

    /// <summary>Linear interpolation between order statistics (the R type 7 / Excel PERCENTILE rule).</summary>
    private static double Quantile(double[] sorted, double q)
    {
        if (sorted.Length == 1)
            return sorted[0];

        double pos = (sorted.Length - 1) * q;
        int lo = (int)Math.Floor(pos);
        int hi = (int)Math.Ceiling(pos);
        return lo == hi ? sorted[lo] : sorted[lo] + (pos - lo) * (sorted[hi] - sorted[lo]);
    }

    private static Scale BuildScale(double min, double max)
    {
        double lo = min;
        double hi = max;

        // A run that never moved would otherwise collapse the axis onto a single pixel.
        if (hi - lo <= 0)
        {
            double flat = Math.Abs(hi) > 0 ? Math.Abs(hi) * 0.05 : 1;
            lo -= flat;
            hi += flat;
        }
        else
        {
            double pad = (hi - lo) * 0.08;
            lo -= pad;
            hi += pad;
        }

        double step = NiceStep((hi - lo) / 6);
        double first = Math.Ceiling(lo / step) * step;
        var ticks = new List<double>(10);
        for (double t = first; t <= hi + step * 1e-6 && ticks.Count < 14; t += step)
            ticks.Add(t);

        return new Scale(lo, hi, ticks);
    }

    private static double NiceStep(double raw)
    {
        if (raw <= 0 || double.IsNaN(raw) || double.IsInfinity(raw))
            return 1;

        double power = Math.Pow(10, Math.Floor(Math.Log10(raw)));
        double fraction = raw / power;
        double nice = fraction <= 1 ? 1 : fraction <= 2 ? 2 : fraction <= 2.5 ? 2.5 : fraction <= 5 ? 5 : 10;
        return nice * power;
    }

    private static string Diamond(double cx, double cy) =>
        string.Create(
            CultureInfo.InvariantCulture,
            $"{cx:0.##},{cy - 5:0.##} {cx + 5:0.##},{cy:0.##} {cx:0.##},{cy + 5:0.##} {cx - 5:0.##},{cy:0.##}");

    private static DateOnly ParseDate(string? text) =>
        DateOnly.TryParseExact(text, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out DateOnly parsed)
            ? parsed
            : default;

    private static bool TryParseDate(object? value, out DateOnly parsed) =>
        DateOnly.TryParse(
            Convert.ToString(value, CultureInfo.InvariantCulture),
            CultureInfo.InvariantCulture,
            DateTimeStyles.None,
            out parsed);

    /// <summary>SVG coordinates must be invariant — a Korean locale would emit "12,3" and break the path.</summary>
    private static string F(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);

    private static string Num(double value)
    {
        double magnitude = Math.Abs(value);
        string format = magnitude >= 1000 ? "N1" : magnitude >= 10 ? "N2" : "N3";
        return value.ToString(format, CultureInfo.CurrentCulture);
    }

    /// <summary>Y axis ticks read as whole gauss values — the decimals only add noise on the axis.</summary>
    private static string AxisNum(double value) =>
        Math.Round(value, MidpointRounding.AwayFromZero).ToString("N0", CultureInfo.CurrentCulture);

    /// <summary>Box labels share a narrow column, so they carry at most one decimal.</summary>
    private static string MarkNum(double value) =>
        value.ToString(Math.Abs(value) >= 100 ? "N0" : "0.#", CultureInfo.CurrentCulture);

    private static string FormatPpm(double? value) =>
        value is double ppm ? $"{ppm.ToString("N0", CultureInfo.CurrentCulture)} ppm" : "-";
}
