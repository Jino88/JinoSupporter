@page "/qr/gauss-scatter"
@rendermode InteractiveServer
@attribute [Authorize]
@layout EmptyLayout
@using System.Globalization
@using JinoSupporter.Web.Components.Layout
@using JinoSupporter.Web.Services
@inject QrSummaryService QrSummary
@inject QrModelCodeService QrModelCodes
@inject QrViewPreferenceService QrViewPrefs
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>GAUSS SCATTER</PageTitle>

<AuthorizeView>
    <NotAuthorized>
        @{ RedirectToLogin(); }
    </NotAuthorized>
    <Authorized>
        <div class="gsc-page">
            <header class="gsc-titlebar">
                <div>
                    <div class="gsc-kicker">GAUSS · dbo.GSTD · DISPERSION</div>
                    <h1>GAUSS SCATTER</h1>
                    <p>One column per test date. Value and Value 2 are drawn together in their own colours, each with its own normal curve and box.</p>
                </div>
                <div class="gsc-actions">
                    <div class="gsc-quick">
                        <button class="gsc-chip gsc-swatch-chip @(_showValue ? "gsc-on" : "")"
                                type="button" @onclick="() => ToggleSeries(0)">
                            <i class="gsc-dot" style="background:@ValueColor"></i>Value
                        </button>
                        <button class="gsc-chip gsc-swatch-chip @(_showValue2 ? "gsc-on" : "")"
                                type="button" @onclick="() => ToggleSeries(1)">
                            <i class="gsc-dot" style="background:@Value2Color"></i>Value 2
                        </button>
                    </div>
                    <div class="gsc-quick">
                        <button class="gsc-chip @(_ngOnly ? "" : "gsc-on")"
                                type="button" @onclick="() => SetNgOnly(false)">All</button>
                        <button class="gsc-chip @(_ngOnly ? "gsc-on" : "")"
                                type="button" @onclick="() => SetNgOnly(true)">NG only</button>
                    </div>
                </div>
            </header>

            <div class="gsc-toolbar">
                @* Same reason as QR SUMMARY: a native date input fires "change" for every complete
                   date typed through on the way to the intended one, so the reload is debounced and
                   the inputs are never disabled mid-entry. *@
                <label class="gsc-field">
                    <span>From</span>
                    <input type="date"
                           value="@_from.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
                           @onchange="OnFromChanged" />
                </label>
                <label class="gsc-field">
                    <span>To</span>
                    <input type="date"
                           value="@_to.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
                           @onchange="OnToChanged" />
                </label>
                <div class="gsc-quick">
                    <button class="gsc-chip" type="button" disabled="@_busy" @onclick="() => ApplyQuickRangeAsync(0)">Latest day</button>
                    <button class="gsc-chip" type="button" disabled="@_busy" @onclick="() => ApplyQuickRangeAsync(1)">2 days</button>
                    <button class="gsc-chip" type="button" disabled="@_busy" @onclick="() => ApplyQuickRangeAsync(6)">7 days</button>
                    <button class="gsc-chip" type="button" disabled="@_busy" @onclick="() => ApplyQuickRangeAsync(29)">30 days</button>
                </div>
                <label class="gsc-field">
                    <span>Max QR</span>
                    <select disabled="@_busy" @onchange="OnMaxRowsChanged">
                        @foreach (int option in MaxRowOptions)
                        {
                            <option value="@option" selected="@(option == _maxRows)">@option.ToString("N0")</option>
                        }
                    </select>
                </label>
                @* Model comes from characters 11-12 of the QR; names from Setting → QR Model Codes.
                   Re-filters the points already fetched, so picking one costs no query. *@
                <label class="gsc-field">
                    <span>Model</span>
                    <select disabled="@_busy" @onchange="OnModelChanged">
                        <option value="" selected="@(_modelCode.Length == 0)">All models</option>
                        @foreach (ModelOption option in _modelOptions)
                        {
                            <option value="@option.Code" selected="@(option.Code == _modelCode)">@option.Label</option>
                        }
                    </select>
                </label>
                <button class="gsc-btn gsc-primary" type="button" @onclick="ReloadAsync" disabled="@_busy">
                    @if (_busy)
                    {
                        <span class="gsc-spinner" aria-hidden="true"></span>
                        <span>Loading</span>
                    }
                    else
                    {
                        <span>Refresh</span>
                    }
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="gsc-alert gsc-danger">@_error</div>
            }

            @if (!QrSummary.IsConfigured)
            {
                <div class="gsc-alert gsc-warning">QR DB password is not configured on the server.</div>
            }
            else if (_busy && _value.Count == 0 && _value2.Count == 0)
            {
                <div class="gsc-state">
                    <span class="gsc-spinner" aria-hidden="true"></span>
                    <span>Reading GSTD from TCDB.</span>
                </div>
            }
            else if (TotalPoints == 0)
            {
                <div class="gsc-state">No numeric gauss reading in @_from.ToString("yyyy-MM-dd") ~ @_to.ToString("yyyy-MM-dd").</div>
            }
            else
            {
                <div class="gsc-stats">
                    <table>
                        <thead>
                            <tr>
                                <th>Series</th><th>Points</th><th>Mean</th><th>σ</th><th>Median</th>
                                <th>Q1</th><th>Q3</th><th>Min</th><th>Max</th><th>Range</th><th>IQR</th><th>NG</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (SeriesView view in _views)
                            {
                                <tr>
                                    <th scope="row"><i class="gsc-dot" style="background:@view.Color"></i>@view.Label</th>
                                    <td>@view.Stats.N.ToString("N0")</td>
                                    <td>@Num(view.Stats.Mean)</td>
                                    <td>@Num(view.Stats.StdDev)</td>
                                    <td>@Num(view.Stats.Median)</td>
                                    <td>@Num(view.Stats.Q1)</td>
                                    <td>@Num(view.Stats.Q3)</td>
                                    <td>@Num(view.Stats.Min)</td>
                                    <td>@Num(view.Stats.Max)</td>
                                    <td>@Num(view.Stats.Max - view.Stats.Min)</td>
                                    <td>@Num(view.Stats.Q3 - view.Stats.Q1)</td>
                                    <td>@view.NgCount.ToString("N0") · @FormatPpm(view.NgRatePpm)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <span class="gsc-stats-note">@_dates.Count.ToString("N0") test date(s) · @_from.ToString("yyyy-MM-dd") ~ @_to.ToString("yyyy-MM-dd")</span>
                </div>

                <div class="gsc-plot">
                    <svg viewBox="0 0 1320 566" preserveAspectRatio="xMidYMid meet" role="img"
                         aria-label="GAUSS Value and Value 2 by test date, each with its fitted normal curve and a box labelled with max, Q3, Q2, mean, Q1, min and IQR">

                        @* ---- Y grid, shared by both panels ----
                           The <g> is not decoration: Razor reads a bare <text> right after a C#
                           statement as its own @@<text> escape tag, so a loop body that draws text
                           has to open with some other element. *@
                        @foreach (double tick in _scale.Ticks)
                        {
                            <g>
                                <line x1="74" y1="@F(_scale.Map(tick))" x2="890" y2="@F(_scale.Map(tick))" stroke="#e4e8ee" stroke-width="1" />
                                <line x1="930" y1="@F(_scale.Map(tick))" x2="1300" y2="@F(_scale.Map(tick))" stroke="#e4e8ee" stroke-width="1" />
                                <text x="68" y="@F(_scale.Map(tick) + 3.4)" text-anchor="end" class="gsc-axis">@AxisNum(tick)</text>
                            </g>
                        }

                        <rect x="74" y="34" width="816" height="466" fill="none" stroke="#c6ccd5" stroke-width="1" />
                        <rect x="930" y="34" width="370" height="466" fill="none" stroke="#c6ccd5" stroke-width="1" />
                        <text x="482" y="548" text-anchor="middle" class="gsc-axis-title">Test date</text>
                        <text x="1115" y="548" text-anchor="middle" class="gsc-axis-title">Normal fit · distribution</text>
                        <text x="18" y="267" text-anchor="middle" class="gsc-axis-title" transform="rotate(-90 18 267)">GAUSS reading</text>

                        @* ---- One column per date ---- *@
                        @foreach (DateColumn column in _columns)
                        {
                            <g>
                                @if (column.Index > 0)
                                {
                                    <line x1="@F(column.Left)" y1="34" x2="@F(column.Left)" y2="500" stroke="#eef1f5" stroke-width="1" />
                                }
                                <line x1="@F(column.Center)" y1="500" x2="@F(column.Center)" y2="505" stroke="#c6ccd5" stroke-width="1" />
                                @if (column.ShowLabel)
                                {
                                    <g>
                                        <text x="@F(column.Center)" y="518" text-anchor="middle" class="gsc-axis">@column.Label</text>
                                        <text x="@F(column.Center)" y="530" text-anchor="middle" class="gsc-axis gsc-faint">@column.Count.ToString("N0")</text>
                                    </g>
                                }
                            </g>
                        }

                        @* ---- Each series: its mean / median guides, then its own strip per date ---- *@
                        @foreach (SeriesView view in _views)
                        {
                            <g>
                                <line x1="74" y1="@F(_scale.Map(view.Stats.Median))" x2="890" y2="@F(_scale.Map(view.Stats.Median))"
                                      stroke="@view.Color" stroke-width="1.3" stroke-opacity="0.85" />
                                <line x1="74" y1="@F(_scale.Map(view.Stats.Mean))" x2="890" y2="@F(_scale.Map(view.Stats.Mean))"
                                      stroke="@view.Color" stroke-width="1.3" stroke-opacity="0.85" stroke-dasharray="6 4" />

                                @foreach (GaussPoint p in view.Plotted)
                                {
                                    <circle cx="@F(XMap(p, view))" cy="@F(_scale.Map(p.Value))" r="2.3"
                                            fill="@view.Color" fill-opacity="0.5">
                                        @if (view.ShowTitles)
                                        {
                                            <title>@p.ProductId · @view.Label @Num(p.Value) · @p.Time.ToString("MM-dd HH:mm:ss", CultureInfo.InvariantCulture)</title>
                                        }
                                    </circle>
                                }
                            </g>
                        }

                        @* ---- Vertical normal curve per series: value on the shared Y axis, density
                               growing to the right. With a single series the readings' own histogram
                               sits behind it, so the departure from the fitted bell is visible rather
                               than assumed; with both series the bars would only muddy each other. ---- *@
                        <line x1="946" y1="34" x2="946" y2="500" stroke="#c6ccd5" stroke-width="1" />
                        @foreach (SeriesView view in _views)
                        {
                            <g>
                                @foreach (HistogramBar bar in view.Histogram)
                                {
                                    <rect x="946" y="@F(bar.Top)" width="@F(bar.Width)" height="@F(bar.Height)"
                                          fill="@view.Color" fill-opacity="0.13" />
                                }

                                @if (view.Curve.Length > 0)
                                {
                                    <polyline points="@view.Curve" fill="none" stroke="@view.Color" stroke-width="1.8" />
                                }

                                @foreach (SigmaMark mark in view.SigmaMarks)
                                {
                                    <g>
                                        <line x1="946" y1="@F(mark.Y)" x2="1096" y2="@F(mark.Y)"
                                              stroke="#9aa6b4" stroke-width="1" stroke-dasharray="3 3" />
                                        <text x="1100" y="@F(mark.Y + 3.4)" class="gsc-axis">@mark.Label</text>
                                    </g>
                                }
                            </g>
                        }

                        @* ---- One box per series: whiskers to min/max, box over Q1..Q3,
                               median solid, mean dashed with a diamond ---- *@
                        @foreach (SeriesView view in _views)
                        {
                            <g>
                                @{
                                    double top = _scale.Map(view.Stats.Max);
                                    double bottom = _scale.Map(view.Stats.Min);
                                    double q3 = _scale.Map(view.Stats.Q3);
                                    double q1 = _scale.Map(view.Stats.Q1);
                                    double med = _scale.Map(view.Stats.Median);
                                    double mean = _scale.Map(view.Stats.Mean);
                                    double boxTop = Math.Min(q1, q3);
                                    double boxHeight = Math.Max(Math.Abs(q1 - q3), 1);
                                }

                                <line x1="@F(view.BoxCenter)" y1="@F(top)" x2="@F(view.BoxCenter)" y2="@F(bottom)"
                                      stroke="@view.Color" stroke-width="1.2" />
                                <line x1="@F(view.BoxCenter - view.CapHalf)" y1="@F(top)" x2="@F(view.BoxCenter + view.CapHalf)" y2="@F(top)"
                                      stroke="@view.Color" stroke-width="1.6" />
                                <line x1="@F(view.BoxCenter - view.CapHalf)" y1="@F(bottom)" x2="@F(view.BoxCenter + view.CapHalf)" y2="@F(bottom)"
                                      stroke="@view.Color" stroke-width="1.6" />

                                <rect x="@F(view.BoxCenter - view.BoxHalf)" y="@F(boxTop)"
                                      width="@F(view.BoxHalf * 2)" height="@F(boxHeight)"
                                      fill="@view.Color" fill-opacity="0.08" stroke="@view.Color" stroke-width="1.3" />

                                <line x1="@F(view.BoxCenter - view.BoxHalf)" y1="@F(med)" x2="@F(view.BoxCenter + view.BoxHalf)" y2="@F(med)"
                                      stroke="@view.Color" stroke-width="2.4" />
                                <line x1="@F(view.BoxCenter - view.BoxHalf)" y1="@F(mean)" x2="@F(view.BoxCenter + view.BoxHalf)" y2="@F(mean)"
                                      stroke="@view.Color" stroke-width="2" stroke-dasharray="6 4" />
                                <polygon points="@Diamond(view.BoxCenter, mean)" fill="@view.Color" />

                                <text x="@F(view.BoxCenter)" y="524" text-anchor="middle" class="gsc-mark" fill="@view.Color">@view.Label</text>
                                <text x="@F(view.BoxCenter)" y="536" text-anchor="middle" class="gsc-axis">IQR @MarkNum(view.Stats.Q3 - view.Stats.Q1)</text>

                                @* ---- The numbers the box is made of, in a column beside it. They are
                                       already spread far enough apart to stay readable, so a label that
                                       had to leave its own line gets a leader back to it. ---- *@
                                @foreach (BoxLabel label in view.BoxLabels)
                                {
                                    <g>
                                        @if (label.Nudged)
                                        {
                                            <line x1="@F(view.BoxCenter + view.BoxHalf + 1)" y1="@F(label.LineY)"
                                                  x2="@F(view.LabelX - 3)" y2="@F(label.TextY - 3.4)"
                                                  stroke="@view.Color" stroke-width="0.8" stroke-opacity="0.45" />
                                        }
                                        <text x="@F(view.LabelX)" y="@F(label.TextY)" class="gsc-mark" fill="@label.Fill">@label.Text</text>
                                    </g>
                                }
                            </g>
                        }
                    </svg>
                </div>

                <footer class="gsc-foot">
                    @foreach (SeriesView view in _views)
                    {
                        <span class="gsc-key"><i class="gsc-dot" style="background:@view.Color"></i>@view.Label</span>
                    }
                    <span class="gsc-key"><i class="gsc-line"></i>Median</span>
                    <span class="gsc-key"><i class="gsc-line gsc-dashed"></i>Mean</span>
                    <span class="gsc-key"><i class="gsc-box"></i>Q1 – Q3, whiskers to min / max</span>
                    <span class="gsc-key"><i class="gsc-curve"></i>Normal fit@(_views.Count == 1 ? " over the reading histogram" : "")</span>
                    @if (PlottedPoints < TotalPoints)
                    {
                        <span>Drawing @PlottedPoints.ToString("N0") of @TotalPoints.ToString("N0") points — statistics use all of them</span>
                    }
                    @if (_fetchedAt != default)
                    {
                        <span>as of @_fetchedAt.ToString("yyyy-MM-dd HH:mm:ss")</span>
                    }
                </footer>
            }
        </div>
    </Authorized>
</AuthorizeView>

<style>
    .gsc-page {
        display: flex;
        min-height: 100vh;
        padding: 0.8rem 1rem 1rem;
        flex-direction: column;
        background: var(--plane, #e8eaee);
        color: var(--ink, #0f1319);
        font-family: var(--sans, "Segoe UI", "Malgun Gothic", sans-serif);
    }

    .gsc-titlebar {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 0.6rem;
        flex: 0 0 auto;
    }

    .gsc-kicker {
        margin-bottom: 0.2rem;
        color: var(--crit, #c8342a);
        font-family: var(--mono, Bahnschrift, Consolas, monospace);
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.04em;
    }

    .gsc-titlebar h1 { margin: 0; font-size: 1.12rem; line-height: 1.25; }

    .gsc-titlebar p {
        margin: 0.16rem 0 0;
        color: var(--ink-2, #4a5461);
        font-size: 0.76rem;
    }

    .gsc-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .gsc-toolbar {
        display: flex;
        margin-bottom: 0.6rem;
        padding: 0.5rem 0.6rem;
        align-items: flex-end;
        gap: 0.6rem;
        flex: 0 0 auto;
        flex-wrap: wrap;
        border: 1px solid var(--line-2, #c6ccd5);
        border-radius: 2px;
        background: var(--panel, #fff);
    }

    .gsc-field {
        display: flex;
        min-width: 0;
        flex-direction: column;
        gap: 0.18rem;
    }

    .gsc-field > span {
        color: var(--ink-3, #7f8a98);
        font-size: 0.64rem;
        font-weight: 700;
        letter-spacing: 0.02em;
    }

    .gsc-field input,
    .gsc-field select {
        min-height: 1.9rem;
        padding: 0.24rem 0.4rem;
        border: 1px solid var(--line-2, #c6ccd5);
        border-radius: 2px;
        background: var(--panel, #fff);
        color: var(--ink, #0f1319);
        font: 400 0.72rem var(--mono, Bahnschrift, Consolas, monospace);
    }

    .gsc-quick { display: flex; gap: 0.25rem; }

    .gsc-btn {
        display: inline-flex;
        min-height: 1.9rem;
        padding: 0.32rem 0.72rem;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
        border: 1px solid var(--line-2, #c6ccd5);
        border-radius: 2px;
        background: var(--panel, #fff);
        color: var(--ink, #0f1319);
        font: 700 0.7rem var(--sans, "Segoe UI", sans-serif);
        cursor: pointer;
    }

    .gsc-btn.gsc-primary {
        border-color: var(--signal, #16202b);
        background: var(--signal, #16202b);
        color: var(--panel, #fff);
    }

    .gsc-btn:disabled,
    .gsc-chip:disabled { cursor: default; opacity: 0.55; }

    .gsc-chip {
        min-height: 1.9rem;
        padding: 0.28rem 0.6rem;
        border: 1px solid var(--line-2, #c6ccd5);
        border-radius: 2px;
        background: var(--panel, #fff);
        color: var(--ink-2, #4a5461);
        font: 700 0.68rem var(--sans, "Segoe UI", sans-serif);
        cursor: pointer;
    }

    .gsc-chip:hover:not(:disabled) { border-color: var(--ink, #0f1319); }

    .gsc-chip.gsc-on {
        border-color: var(--signal, #16202b);
        background: var(--signal, #16202b);
        color: var(--panel, #fff);
    }

    /* The swatch keeps its series colour whether or not the chip is switched on. */
    .gsc-swatch-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }

    .gsc-swatch-chip:not(.gsc-on) { opacity: 0.62; }

    .gsc-alert,
    .gsc-state {
        margin-bottom: 0.65rem;
        padding: 0.58rem 0.72rem;
        border: 1px solid var(--line-2, #c6ccd5);
        border-radius: 2px;
        background: var(--panel, #fff);
        color: var(--ink-2, #4a5461);
        font-size: 0.76rem;
    }

    .gsc-state {
        display: flex;
        min-height: 8rem;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
    }

    .gsc-alert.gsc-danger {
        border-color: var(--crit, #c8342a);
        background: var(--crit-wash, #fbedec);
        color: var(--crit, #c8342a);
    }

    .gsc-alert.gsc-warning {
        border-color: var(--line-2, #c6ccd5);
        background: var(--panel-2, #f5f6f9);
    }

    .gsc-spinner {
        display: inline-block;
        width: 0.78rem;
        height: 0.78rem;
        border: 2px solid var(--line-2, #c6ccd5);
        border-top-color: currentColor;
        border-radius: 50%;
        animation: gsc-spin 0.75s linear infinite;
    }

    .gsc-stats {
        margin-bottom: 0.6rem;
        padding: 0.45rem 0.6rem;
        flex: 0 0 auto;
        border: 1px solid var(--line-2, #c6ccd5);
        border-radius: 2px;
        background: var(--panel, #fff);
        overflow-x: auto;
    }

    .gsc-stats table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.7rem;
    }

    .gsc-stats th,
    .gsc-stats td {
        padding: 0.24rem 0.5rem;
        border-bottom: 1px solid var(--line, #dde1e7);
        text-align: right;
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
    }

    .gsc-stats thead th {
        border-bottom-color: var(--line-2, #c6ccd5);
        color: var(--ink-3, #7f8a98);
        font-size: 0.63rem;
        font-weight: 700;
    }

    .gsc-stats tbody tr:last-child th,
    .gsc-stats tbody tr:last-child td { border-bottom: 0; }

    .gsc-stats tbody th {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        text-align: left;
        font-weight: 800;
    }

    .gsc-stats td {
        font-family: var(--mono, Bahnschrift, Consolas, monospace);
    }

    .gsc-stats thead th:first-child { text-align: left; }

    .gsc-stats-note {
        display: block;
        padding-top: 0.3rem;
        color: var(--ink-3, #7f8a98);
        font-size: 0.63rem;
    }

    .gsc-plot {
        min-height: 0;
        padding: 0.4rem;
        flex: 1 1 auto;
        border: 1px solid var(--line-2, #c6ccd5);
        border-radius: 2px;
        background: var(--panel, #fff);
    }

    .gsc-plot svg { display: block; width: 100%; height: 100%; }

    .gsc-axis {
        fill: #7f8a98;
        font-family: var(--mono, Bahnschrift, Consolas, monospace);
        font-size: 10px;
    }

    .gsc-axis.gsc-faint { fill: #b3bcc7; font-size: 9px; }

    .gsc-axis-title {
        fill: #4a5461;
        font-family: var(--sans, "Segoe UI", sans-serif);
        font-size: 11px;
        font-weight: 700;
    }

    .gsc-mark {
        fill: #16202b;
        font-family: var(--mono, Bahnschrift, Consolas, monospace);
        font-size: 10px;
        font-weight: 700;
    }

    .gsc-foot {
        display: flex;
        padding-top: 0.45rem;
        gap: 0.9rem;
        flex: 0 0 auto;
        flex-wrap: wrap;
        align-items: center;
        color: var(--ink-3, #7f8a98);
        font-size: 0.66rem;
        font-variant-numeric: tabular-nums;
    }

    .gsc-key { display: inline-flex; align-items: center; gap: 0.3rem; }

    .gsc-dot {
        display: inline-block;
        width: 0.5rem;
        height: 0.5rem;
        flex: 0 0 auto;
        border-radius: 50%;
