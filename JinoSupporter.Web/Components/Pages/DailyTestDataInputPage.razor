    {
        var sb = new System.Text.StringBuilder();
        sb.Append("===== EXCEL COM EXTRACT: ").Append(fileName).AppendLine(" =====");
        sb.Append("SourceWorkbookPath: ").AppendLine(workbookPath);
        sb.Append("ExtractedTextPath: ").AppendLine(extracted.ExtractedTextPath);
        sb.Append("RenderedRequestPath: ").AppendLine(extracted.RenderedRequestPath);
        sb.Append("Sheets: ").Append(extracted.SheetCount)
            .Append(", Rows: ").Append(extracted.RowCount)
            .Append(", Cells: ").Append(extracted.CellCount)
            .Append(", Images: ").Append(extracted.ImageCount)
            .AppendLine();
        sb.AppendLine("ReadMode: Excel COM programExtract. Use this extracted text as the workbook source; do not reopen the DRM workbook.");
        sb.AppendLine("MergedCellMode: A merged cell value applies to every row and column in that merged range.");
        sb.AppendLine();
        sb.AppendLine((extractedText ?? "").TrimEnd());
        sb.Append("===== END EXCEL COM EXTRACT: ").Append(fileName).AppendLine(" =====");
        return sb.ToString().TrimEnd();
    }

    private List<XlsxAttachment> GetAttachedXlsxFiles()
        => ExtractAttachedXlsxFiles(_dataText);

    private static List<XlsxAttachment> ExtractAttachedXlsxFiles(string dataText)
    {
        var files = new List<XlsxAttachment>();
        if (string.IsNullOrWhiteSpace(dataText)) return files;

        foreach (string line in dataText.Split('\n'))
        {
            string trimmed = line.TrimEnd('\r');
            if (!trimmed.StartsWith(XlsxAttachmentPrefix, StringComparison.Ordinal)) continue;

            string[] parts = trimmed[XlsxAttachmentPrefix.Length..].Split('\t', 2);
            if (parts.Length != 2) continue;

            string fileName = parts[0].Trim();
            string path = parts[1].Trim();
            if (string.IsNullOrWhiteSpace(path) || !File.Exists(path)) continue;
            files.Add(new XlsxAttachment(fileName, path));
        }

        return files
            .GroupBy(f => f.Path, StringComparer.OrdinalIgnoreCase)
            .Select(g => g.First())
            .ToList();
    }

    private static bool HasMeaningfulPriorSnapshot(DailyTestDataHistoryRecord h)
        => !string.IsNullOrWhiteSpace(h.DataText)
           || HasHistoryAnalysis(h)
           || !string.IsNullOrWhiteSpace(h.ParametersJson) && h.ParametersJson.Trim() != "{}";

    private static string SnapshotDataKey(string dataText)
        => (dataText ?? "").Replace("\r\n", "\n").Replace('\r', '\n').Trim();

    private static string SnapshotDataHash(string dataText)
    {
        byte[] bytes = System.Text.Encoding.UTF8.GetBytes(SnapshotDataKey(dataText));
        byte[] hash = System.Security.Cryptography.SHA256.HashData(bytes);
        return Convert.ToHexString(hash).ToLowerInvariant();
    }

    private static string SnapshotPromptKey(string promptText)
        => (promptText ?? "").Replace("\r\n", "\n").Replace('\r', '\n').Trim();

    private static bool IsGeneratedCumulativeDataText(string dataText)
    {
        string text = (dataText ?? "").Replace("\r\n", "\n").Replace('\r', '\n').TrimStart();
        return text.StartsWith(HistoryDataMarkerPrefix, StringComparison.Ordinal)
               || text.Contains("\n" + CurrentInputDataMarker, StringComparison.Ordinal)
               || text.StartsWith(CurrentInputDataMarker, StringComparison.Ordinal);
    }

    private static bool IsGeneratedCumulativePromptText(string promptText)
    {
        string text = (promptText ?? "").Replace("\r\n", "\n").Replace('\r', '\n').TrimStart();
        return text.StartsWith(HistoryPromptMarkerPrefix, StringComparison.Ordinal)
               || text.Contains("\n" + CurrentPromptMarker, StringComparison.Ordinal)
               || text.StartsWith(CurrentPromptMarker, StringComparison.Ordinal);
    }

    private static bool IsMeaningfulCurrentInputData(string dataText)
    {
        string text = (dataText ?? "").Replace("\r\n", "\n").Replace('\r', '\n').Trim();
        if (string.IsNullOrWhiteSpace(text)) return false;
        if (text.Contains(XlsxAttachmentPrefix, StringComparison.Ordinal)) return true;

        string[] lines = text.Split('\n')
            .Select(line => line.Trim())
            .Where(line => !string.IsNullOrWhiteSpace(line))
            .ToArray();
        if (lines.Length == 0) return false;

        bool hasTableDelimiter = text.Contains('\t') || text.Contains(',');
        bool hasMultipleDataLines = lines.Length >= 2;
        bool hasNumbers = System.Text.RegularExpressions.Regex.IsMatch(text, @"\d");
        bool hasKnownDataLabels = System.Text.RegularExpressions.Regex.IsMatch(
            text,
            @"\b(VP\s*#|IR\d+|HEARING|SIGMA|AIR\s+LEAK|Vision|DATE|TIME|TOTAL)\b",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        return (hasTableDelimiter && hasNumbers)
               || (hasMultipleDataLines && hasNumbers)
               || (hasKnownDataLabels && hasNumbers)
               || text.Length >= 80;
    }

    private static DailyTestProgramSummary BuildProgramExtractSummary(string dataText)
    {
        string text = (dataText ?? "").Replace("\r\n", "\n").Replace('\r', '\n');
        var summary = new DailyTestProgramSummary
        {
            Source = text.Contains("===== EXCEL COM EXTRACT", StringComparison.Ordinal)
                ? "EXCEL COM EXTRACT"
                : ""
        };
        if (string.IsNullOrWhiteSpace(summary.Source))
            return summary;

        summary.FileName = FirstRegexGroup(text, @"^===== EXCEL COM EXTRACT:\s*(.+?)\s*=====$");
        summary.SourceWorkbookPath = FirstRegexGroup(text, @"^SourceWorkbookPath:\s*(.+)$");
        summary.ReadMode = FirstRegexGroup(text, @"^ReadMode:\s*(.+)$");
        var meta = System.Text.RegularExpressions.Regex.Match(
            text,
            @"^Sheets:\s*(\d+),\s*Rows:\s*(\d+),\s*Cells:\s*(\d+),\s*Images:\s*(\d+)",
            System.Text.RegularExpressions.RegexOptions.Multiline);
        if (meta.Success)
        {
            summary.WorkbookSheetCount = ParseInt(meta.Groups[1].Value);
            summary.WorkbookRowCount = ParseInt(meta.Groups[2].Value);
            summary.WorkbookCellCount = ParseInt(meta.Groups[3].Value);
            summary.WorkbookImageCount = ParseInt(meta.Groups[4].Value);
        }

        string currentSheet = "";
        var sheetCells = new Dictionary<string, DailyTestSheetSummary>(StringComparer.OrdinalIgnoreCase);
        foreach (string rawLine in text.Split('\n'))
        {
            string line = rawLine.TrimEnd('\r');
            if (line.StartsWith("## Sheet:", StringComparison.Ordinal))
            {
                currentSheet = line.Split(':', 2)[1].Trim();
                if (!sheetCells.ContainsKey(currentSheet))
                    sheetCells[currentSheet] = new DailyTestSheetSummary { SheetName = currentSheet };
                continue;
            }

            if (currentSheet.Length == 0
                || !System.Text.RegularExpressions.Regex.IsMatch(line, @"^[A-Z]+\d+\t\d+\t\d+\t"))
            {
                continue;
            }

            string[] parts = line.Split('\t', 4);
            if (parts.Length != 4
                || !int.TryParse(parts[1], out int row)
                || !int.TryParse(parts[2], out int col))
            {
                continue;
            }

            DailyTestSheetSummary sheet = sheetCells[currentSheet];
            sheet.CellCount++;
            sheet.RowStart = sheet.RowStart == 0 ? row : Math.Min(sheet.RowStart, row);
            sheet.RowEnd = Math.Max(sheet.RowEnd, row);
            sheet.ColumnStart = sheet.ColumnStart == 0 ? col : Math.Min(sheet.ColumnStart, col);
            sheet.ColumnEnd = Math.Max(sheet.ColumnEnd, col);
            if (row <= 3 && !string.IsNullOrWhiteSpace(parts[3]))
            {
                sheet.HeaderCells.Add(new Dictionary<string, object>
                {
                    ["row"] = row,
                    ["column"] = col,
                    ["text"] = parts[3].Trim()
                });
            }
        }

        summary.Sheets = sheetCells.Values
            .OrderBy(s => s.SheetName, StringComparer.OrdinalIgnoreCase)
            .ToList();
        summary.Available = summary.Sheets.Count > 0;
        return summary;
    }

    private static string FirstRegexGroup(string text, string pattern)
    {
        var match = System.Text.RegularExpressions.Regex.Match(
            text ?? "",
            pattern,
            System.Text.RegularExpressions.RegexOptions.Multiline);
        return match.Success ? match.Groups[1].Value.Trim() : "";
    }

    private static int ParseInt(string value)
        => int.TryParse(value, out int n) ? n : 0;

    private static string SafeFileName(string fileName)
    {
        string safe = string.Join("_", (fileName ?? "workbook.xlsx").Split(Path.GetInvalidFileNameChars()));
        return string.IsNullOrWhiteSpace(safe) ? "workbook.xlsx" : safe;
    }

    private static bool IsSupportedExcelFileName(string fileName)
    {
        string lower = (fileName ?? "").ToLowerInvariant();
        return lower.EndsWith(".xlsx")
               || lower.EndsWith(".xlsm")
               || lower.EndsWith(".xlsb")
               || lower.EndsWith(".xls");
    }

    private static bool HasReusableDailyTestParameters(string parametersJson)
    {
        if (string.IsNullOrWhiteSpace(parametersJson)) return false;

        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(parametersJson);
            var root = doc.RootElement;
            if (root.ValueKind != System.Text.Json.JsonValueKind.Object) return false;
            if (!root.EnumerateObject().Any()) return false;

            return root.TryGetProperty("analysisData", out var analysisData)
                       && analysisData.ValueKind == System.Text.Json.JsonValueKind.Object
                   || root.TryGetProperty("analysisContract", out var analysisContract)
                       && analysisContract.ValueKind == System.Text.Json.JsonValueKind.Object;
        }
        catch
        {
            return false;
        }
    }

    private static void WriteDailyTestAnalysisRequest(
        string requestPath,
        string runId,
        DateTime startedUtc,
        long itemId,
        string name,
        string dataText,
        string promptText,
        string parametersJson,
        string existingAnalysisMarkdown,
        string existingAnalysisHtml,
        string existingAnalysisAt,
        string analysisPrompt,
        IReadOnlyList<XlsxAttachment> xlsxFiles,
        IReadOnlyList<DailyTestPriorSnapshot> priorSnapshots,
        DailyTestPriorSnapshot? previousSnapshot,
        string workflowPhase,
        DailyTestAiResult? currentAdditionAnalysis,
        string? cumulativeDataTextOverride = null,
        string? cumulativePromptTextOverride = null,
        IReadOnlyList<XlsxAttachment>? cumulativeXlsxFilesOverride = null,
        bool omitPriorSnapshotRawData = false)
    {
        string cumulativeDataText = cumulativeDataTextOverride
            ?? BuildCumulativeDataText(priorSnapshots, dataText);
        string cumulativePromptText = cumulativePromptTextOverride
            ?? BuildCumulativePromptText(priorSnapshots, promptText);
        IReadOnlyList<XlsxAttachment> cumulativeXlsxFiles = cumulativeXlsxFilesOverride
            ?? BuildCumulativeXlsxFiles(priorSnapshots, xlsxFiles);
        string currentKey = SnapshotDataKey(dataText);
        DailyTestProgramSummary currentProgramSummary = BuildProgramExtractSummary(dataText);
        DailyTestProgramSummary cumulativeProgramSummary = string.Equals(SnapshotDataKey(cumulativeDataText), currentKey, StringComparison.Ordinal)
            ? currentProgramSummary
            : BuildProgramExtractSummary(cumulativeDataText);
        string standaloneOutputPath = ExtractRequestedStandaloneOutputPath(promptText, cumulativePromptText, analysisPrompt);
        bool standaloneHtmlRequested = !string.IsNullOrWhiteSpace(standaloneOutputPath)
                                       || WantsStandaloneDailyTestHtml(promptText)
                                       || WantsStandaloneDailyTestHtml(cumulativePromptText)
                                       || WantsStandaloneDailyTestHtml(analysisPrompt);
        string outputMode = standaloneHtmlRequested ? "standalone_html_document" : "html_fragment";
        string dataTextHash = SnapshotDataHash(dataText);
        string cumulativeDataTextHash = SnapshotDataHash(cumulativeDataText);
        bool omitCurrentRawData = false;
        bool omitCumulativeRawData = false;
        string requestDataText = omitCurrentRawData ? "" : dataText;
        string requestCumulativeDataText = omitCumulativeRawData ? "" : cumulativeDataText;
        bool promptOnlyReanalysis = string.Equals(workflowPhase, "cumulative_update", StringComparison.Ordinal)
                                    && string.IsNullOrWhiteSpace(dataText)
                                    && !string.IsNullOrWhiteSpace(promptText);
        object[] requestPriorSnapshots = priorSnapshots.Select(s => ToRequestSnapshot(s, omitPriorSnapshotRawData)).ToArray();
        object? requestPreviousSnapshot = previousSnapshot is null ? null : ToRequestSnapshot(previousSnapshot, omitPriorSnapshotRawData);
        var request = new
        {
            runId,
            itemId,
            name,
            dataText = requestDataText,
            dataTextOmitted = omitCurrentRawData,
            dataTextHash,
            promptText,
            outputMode,
            allowStandaloneHtml = standaloneHtmlRequested,
            standaloneOutputPath,
            existingParametersJson = string.IsNullOrWhiteSpace(parametersJson) ? "{}" : parametersJson,
            existingAnalysis = new
            {
                analysisMarkdown = TrimContext(existingAnalysisMarkdown, ExistingAnalysisContextMaxChars),
                analysisContext = BuildAnalysisContextText(existingAnalysisMarkdown, existingAnalysisHtml, ExistingAnalysisContextMaxChars),
                analysisHtmlOmitted = true,
                generatedAt = existingAnalysisAt ?? ""
            },
            analysisPrompt,
            xlsxFiles,
            currentInput = new { dataText = requestDataText, dataTextOmitted = omitCurrentRawData, dataTextHash, promptText, xlsxFiles },
            cumulativeDataText = requestCumulativeDataText,
            cumulativeDataTextOmitted = omitCumulativeRawData,
            cumulativeDataTextHash,
            cumulativePromptText,
            cumulativeXlsxFiles,
            programExtractSummary = new
            {
                currentInput = currentProgramSummary,
                cumulative = cumulativeProgramSummary
            },
            cumulativeDataSource = string.IsNullOrWhiteSpace(cumulativeDataText)
                                   && currentAdditionAnalysis is not null
                                   && HasReusableDailyTestParameters(parametersJson)
                ? "existing parameters plus current addition analysis"
                : omitPriorSnapshotRawData
                    ? "saved canonical cumulative data file"
                    : "history snapshots plus current input",
            priorSnapshotRawDataOmitted = omitPriorSnapshotRawData,
            priorSnapshots = requestPriorSnapshots,
            previousSnapshot = requestPreviousSnapshot,
            workflowPhase,
            promptOnlyReanalysis,
            currentAdditionAnalysis = currentAdditionAnalysis is null
                ? null
                : new
                {
                    parameters = currentAdditionAnalysis.ParametersJson,
                    analysisMarkdown = currentAdditionAnalysis.AnalysisMarkdown,
                    historyParameters = currentAdditionAnalysis.HistoryParametersJson,
                    historyAnalysisMarkdown = currentAdditionAnalysis.HistoryAnalysisMarkdown
                },
            historySnapshotCount = priorSnapshots.Count,
            historySnapshotIds = priorSnapshots.Select(s => s.Id).ToArray(),
            uniqueDataSegmentCount = CountUniqueDataSegments(priorSnapshots, dataText),
            currentInputAlreadyInHistory = currentKey.Length > 0
                && priorSnapshots.Any(s => string.Equals(SnapshotDataKey(s.DataText), currentKey, StringComparison.Ordinal)),
            historyScopeSummary = BuildHistoryScopeSummary(priorSnapshots, dataText),
            analysisMode = workflowPhase,
            createdAt = startedUtc.ToString("o")
        };

        File.WriteAllText(
            requestPath,
            System.Text.Json.JsonSerializer.Serialize(
                request,
                new System.Text.Json.JsonSerializerOptions { WriteIndented = true }),
            new System.Text.UTF8Encoding(encoderShouldEmitUTF8Identifier: false));
    }

    private static object ToRequestSnapshot(DailyTestPriorSnapshot snapshot, bool omitRawData)
        => new
        {
            id = snapshot.Id,
            createdAt = snapshot.CreatedAt,
            dataText = omitRawData ? "" : snapshot.DataText,
            dataTextOmitted = omitRawData,
            promptText = snapshot.PromptText,
            parametersJson = TrimContext(snapshot.ParametersJson, RequestParametersContextMaxChars),
            analysisMarkdown = TrimContext(snapshot.AnalysisMarkdown, PriorAnalysisContextMaxChars),
            analysisContext = BuildAnalysisContextText(snapshot.AnalysisMarkdown, snapshot.AnalysisHtml, PriorAnalysisContextMaxChars),
            analysisHtmlOmitted = true,
            xlsxFiles = omitRawData ? Array.Empty<XlsxAttachment>() : snapshot.XlsxFiles
        };

    private static void WriteDailyTestTypoCorrectionRequest(
        string requestPath,
        string runId,
        long itemId,
        string name,
        string sourceLabel,
        IReadOnlyList<DailyTestTypoCandidate> candidates)
    {
        var request = new
        {
            runId,
            itemId,
            name,
            sourceLabel,
            candidates,
            rules = new[]
            {
                "Return only corrections for obvious human-language typos in labels or descriptions.",
                "Do not correct product codes, model names, lot IDs, VP/IR labels, file paths, numbers, dates, formulas, units, or acronyms.",
                "If unsure, omit the candidate.",
                "Return replacements only; do not rewrite the full source text."
            },
            createdAt = DateTime.UtcNow.ToString("o")
        };

        File.WriteAllText(
            requestPath,
            System.Text.Json.JsonSerializer.Serialize(
                request,
                new System.Text.Json.JsonSerializerOptions { WriteIndented = true }),
            new System.Text.UTF8Encoding(encoderShouldEmitUTF8Identifier: false));
    }

