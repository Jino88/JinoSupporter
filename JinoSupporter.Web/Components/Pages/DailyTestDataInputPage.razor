    private static bool TryLaunchCodexTerminal(
        string workDir,
        string prompt,
        string title,
        string outputPath,
        string donePath,
        string reasoningEffort = "xhigh",
        string statusLabel = "Running Codex analysis")
    {
        string launchId = Guid.NewGuid().ToString("N")[..12];
        string promptPath = Path.Combine(workDir, $"_daily_test_prompt_codex_{launchId}.txt");
        string scriptPath = Path.Combine(workDir, $"_daily_test_launch_codex_{launchId}.ps1");

        try
        {
            File.WriteAllText(promptPath, prompt, new System.Text.UTF8Encoding(encoderShouldEmitUTF8Identifier: false));
            File.WriteAllText(scriptPath, BuildCodexLauncherScript(workDir, promptPath, scriptPath, title, outputPath, donePath, reasoningEffort, statusLabel),
                new System.Text.UTF8Encoding(encoderShouldEmitUTF8Identifier: false));
        }
        catch
        {
            return false;
        }

        try
        {
            var wt = new System.Diagnostics.ProcessStartInfo
            {
                FileName = "wt.exe",
                UseShellExecute = false,
                CreateNoWindow = false,
            };
            wt.ArgumentList.Add("-d");
            wt.ArgumentList.Add(workDir);
            wt.ArgumentList.Add("powershell.exe");
            wt.ArgumentList.Add("-NoExit");
            wt.ArgumentList.Add("-NoProfile");
            wt.ArgumentList.Add("-ExecutionPolicy");
            wt.ArgumentList.Add("Bypass");
            wt.ArgumentList.Add("-File");
            wt.ArgumentList.Add(scriptPath);
            var proc = System.Diagnostics.Process.Start(wt);
            if (proc is not null) ChildProcessJob.Assign(proc);
            return proc is not null;
        }
        catch { }

        try
        {
            var psi = new System.Diagnostics.ProcessStartInfo
            {
                FileName = "cmd.exe",
                WorkingDirectory = workDir,
                UseShellExecute = false,
                CreateNoWindow = false,
            };
            psi.ArgumentList.Add("/k");
            psi.ArgumentList.Add("powershell.exe");
            psi.ArgumentList.Add("-NoExit");
            psi.ArgumentList.Add("-NoProfile");
            psi.ArgumentList.Add("-ExecutionPolicy");
            psi.ArgumentList.Add("Bypass");
            psi.ArgumentList.Add("-File");
            psi.ArgumentList.Add(scriptPath);
            var proc = System.Diagnostics.Process.Start(psi);
            if (proc is not null) ChildProcessJob.Assign(proc);
            return proc is not null;
        }
        catch
        {
            return false;
        }
    }

    private static string BuildCodexLauncherScript(
        string workDir,
        string promptPath,
        string scriptPath,
        string title,
        string outputPath,
        string donePath,
        string reasoningEffort,
        string statusLabel)
    {
        static string Q(string value) => "'" + (value ?? "").Replace("'", "''") + "'";
        string effortConfig = Q("model_reasoning_effort=\"" + reasoningEffort + "\"");
        return string.Join(Environment.NewLine, new[]
        {
            "$ErrorActionPreference = 'Continue'",
            "$utf8NoBom = New-Object System.Text.UTF8Encoding -ArgumentList $false",
            "[Console]::InputEncoding = $utf8NoBom",
            "[Console]::OutputEncoding = $utf8NoBom",
            "$OutputEncoding = $utf8NoBom",
            "try { chcp 65001 | Out-Null } catch {}",
            $"try {{ $Host.UI.RawUI.WindowTitle = {Q(title)} }} catch {{}}",
            $"Set-Location -LiteralPath {Q(workDir)}",
            "",
            $"$promptPath = {Q(promptPath)}",
            $"$scriptPath = {Q(scriptPath)}",
            $"$outputPath = {Q(outputPath)}",
            $"$donePath = {Q(donePath)}",
            $"$statusLabel = {Q(statusLabel)}",
            $"$title = {Q(title)}",
            "Remove-Item -LiteralPath $outputPath -Force -ErrorAction SilentlyContinue",
            "Remove-Item -LiteralPath $donePath -Force -ErrorAction SilentlyContinue",
            "Write-Host 'Daily Test Data Codex step' -ForegroundColor Cyan",
            "Write-Host ('Title: ' + $title)",
            "Write-Host ('Step: ' + $statusLabel) -ForegroundColor Yellow",
            "Write-Host ('Started: ' + (Get-Date -Format 'yyyy-MM-dd HH:mm:ss'))",
            "Write-Host ('Prompt: ' + $promptPath) -ForegroundColor DarkGray",
            "Write-Host ('Output: ' + $outputPath) -ForegroundColor DarkGray",
            "Write-Host ''",
            "$prompt = Get-Content -LiteralPath $promptPath -Raw -Encoding UTF8",
            "$exitCode = 0",
            "try {",
            "    Write-Host 'Codex exec is running. Wait until the done file is written...' -ForegroundColor Cyan",
            $"    $prompt | & codex exec -c {effortConfig} --cd {Q(workDir)} --dangerously-bypass-approvals-and-sandbox --skip-git-repo-check --color never --output-last-message $outputPath -",
            "    $exitCode = if ($null -eq $LASTEXITCODE) { 0 } else { $LASTEXITCODE }",
            "} catch {",
            "    $exitCode = 1",
            "    $_ | Out-String | Tee-Object -FilePath $outputPath -Append",
            "}",
            "if ($exitCode -ne 0) {",
            "    Write-Host ('Codex exited with code ' + $exitCode + '.') -ForegroundColor Yellow",
            "} else {",
            "    Write-Host 'Codex finished successfully.' -ForegroundColor Green",
            "}",
            "$done = @{ exitCode = $exitCode; completedAt = [DateTime]::UtcNow.ToString('o') } | ConvertTo-Json -Compress",
            "Set-Content -LiteralPath $donePath -Value $done -Encoding UTF8",
            "Write-Host ('Done: ' + $donePath) -ForegroundColor Green",
            "Remove-Item -LiteralPath $promptPath -Force -ErrorAction SilentlyContinue",
            "Remove-Item -LiteralPath $scriptPath -Force -ErrorAction SilentlyContinue",
        });
    }

    private static void TryDeleteFile(string path)
    {
        try
        {
            if (!string.IsNullOrWhiteSpace(path) && File.Exists(path))
                File.Delete(path);
        }
        catch { }
    }

    private static string FindRepoRoot()
    {
        string dir = AppContext.BaseDirectory;
        for (int i = 0; i < 8; i++)
        {
            if (File.Exists(Path.Combine(dir, "JinoSupporter.sln"))) return dir;
            string? parent = Path.GetDirectoryName(dir.TrimEnd('\\', '/'));
            if (string.IsNullOrEmpty(parent) || parent == dir) break;
            dir = parent;
        }

        string current = Directory.GetCurrentDirectory();
        dir = current;
        for (int i = 0; i < 8; i++)
        {
            if (File.Exists(Path.Combine(dir, "JinoSupporter.sln"))) return dir;
            string? parent = Path.GetDirectoryName(dir.TrimEnd('\\', '/'));
            if (string.IsNullOrEmpty(parent) || parent == dir) break;
            dir = parent;
        }

        return current;
    }

    private static bool WasAnalyzedAfter(string analyzedAt, DateTime startedUtc)
    {
        if (!DateTime.TryParse(analyzedAt, null, System.Globalization.DateTimeStyles.RoundtripKind, out var dt))
            return false;
        return dt.ToUniversalTime() >= startedUtc.AddSeconds(-2);
    }

    public ValueTask DisposeAsync()
    {
        try { _cliWaitCts?.Cancel(); } catch { }
        _cliWaitCts?.Dispose();
        return ValueTask.CompletedTask;
    }
