@page "/daily-test-data/input"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject WebRepository Repo
@inject AiProviderSettingsService AiProviders
@inject DailyTestExtractionSettingsService ExtractionSettings
@inject AppActivityLogger ActivityLog
@inject InputDataTestBatchExtractor ExcelComExtractor
@inject IJSRuntime JS

<PageTitle>Daily Test Data - Input Data</PageTitle>

<div class="daily-root">
    <aside class="daily-sidebar">
        <div class="daily-side-head">
            <div class="daily-side-title">항목</div>
            <button class="btn btn-primary btn-sm" @onclick="CreateItem" disabled="@_isBusy">New</button>
        </div>
        <input class="form-control form-control-sm"
               @bind="_newName"
               @bind:event="oninput"
               placeholder="새 항목 이름" />

        <div class="daily-item-list">
            @if (_items.Count == 0)
            {
                <div class="daily-empty">No item.</div>
            }
            @foreach (var item in _items)
            {
                <button class="@ItemClass(item.Id)"
                        @onclick="() => SelectItem(item.Id)"
                        disabled="@_isBusy">
                    <span class="daily-item-name">@item.Name</span>
                    <span class="daily-item-meta">@FormatDate(item.UpdatedAt)</span>
                    @if (!string.IsNullOrWhiteSpace(item.ParametersJson) && item.ParametersJson.Trim() != "{}")
                    {
                        <span class="daily-item-badge">PARAM</span>
                    }
                </button>
            }
        </div>

        @if (_selectedId is not null)
        {
            <div class="daily-history">
                <div class="daily-history-head">
                    <span>History</span>
                    <div class="daily-history-actions">
                        <label class="btn btn-primary btn-sm py-0 px-2 daily-add-file-label @AddDataPickerDisabledClass"
                                title="현재 데이터를 History로 옮기고 Input Data / Prompt를 비웁니다.">
                            DATA 추가하기
                            <InputFile class="daily-add-file-native"
                                       OnChange="OnAddDataXlsxSelected"
                                       accept=".xlsx,.xlsm,.xlsb,.xls"
                                       multiple
                                       disabled="@(_isBusy || _selectedId is null)" />
                        </label>
                        @if (_viewingHistory)
                        {
                            <button class="btn btn-outline-secondary btn-sm py-0 px-2"
                                    @onclick="ReturnToCurrent"
                                    disabled="@_isBusy">
                                Current
                            </button>
                        }
                    </div>
                </div>
                @if (_history.Count == 0)
                {
                    <div class="daily-empty">No history.</div>
                }
                @foreach (var h in _history)
                {
                    <button class="@HistoryClass(h.Id)"
                            @onclick="() => SelectHistory(h.Id)"
                            disabled="@_isBusy"
                            title="@HistoryTooltip(h)">
                        <span class="daily-history-top">
                            <span class="daily-history-title">@HistoryTitle(h)</span>
                            <span class="@HistoryAnalysisBadgeClass(h)">@HistoryAnalysisBadgeText(h)</span>
                        </span>
                        <span class="daily-history-meta">@HistoryDataMeta(h)</span>
                    </button>
                }
            </div>
        }
    </aside>

    <main class="daily-main">
        @if (_selectedId is null)
        {
            <div class="daily-placeholder">왼쪽에서 항목을 만들거나 선택하세요.</div>
        }
        else
        {
            <div class="daily-toolbar">
                <input class="form-control form-control-sm daily-name"
                       @bind="_name"
                       @bind:event="oninput"
                       disabled="@_isBusy" />
                <button class="btn btn-outline-secondary btn-sm" @onclick="SaveCurrent" disabled="@(_isBusy || _viewingHistory)">Save</button>
                <label class="btn btn-outline-primary btn-sm daily-add-file-label @AddDataPickerDisabledClass">
                    DATA 추가하기
                    <InputFile class="daily-add-file-native"
                               OnChange="OnAddDataXlsxSelected"
                               accept=".xlsx,.xlsm,.xlsb,.xls"
                               multiple
                               disabled="@(_isBusy || _selectedId is null)" />
                </label>
                <button class="btn btn-outline-secondary btn-sm" @onclick="ToggleExtractionSettings">
                    Extraction settings
                </button>
                <button class="btn btn-primary btn-sm" @onclick="AnalyzeAsync"
                        disabled="@(_isBusy || _viewingHistory || !AiProviders.CodexCliEnabled || !HasAnalysisRequest)">
                    @if (_isBusy)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    AI Analyze
                </button>
                @if (_isWaitingCli)
                {
                    <button class="btn btn-outline-danger btn-sm" @onclick="CancelCliWait">
                        Cancel wait
                    </button>
                }
                <button class="btn btn-outline-danger btn-sm" @onclick="DeleteCurrent" disabled="@_isBusy">Delete</button>
            </div>

            @if (_showExtractionSettings)
            {
                <div class="daily-extract-settings">
                    <div class="daily-extract-settings-row">
                        <label class="daily-setting-field wide">
                            <span>Extraction mode</span>
                            <select class="form-select form-select-sm"
                                    @bind="_extractionSettings.ExtractionMode"
                                    disabled="@_isBusy">
                                <option value="@DailyTestExtractionModes.ExcelComMergedCells">Excel COM merged-cell text</option>
                                <option value="@DailyTestExtractionModes.SavedExtractText">Saved extract text only</option>
                            </select>
                        </label>
                        <label class="daily-setting-field">
                            <span>Max cells / sheet</span>
                            <input class="form-control form-control-sm"
                                   type="number"
                                   min="@DailyTestExtractionSettingsService.MinMaxProgramCellsPerSheet"
                                   max="@DailyTestExtractionSettingsService.MaxMaxProgramCellsPerSheet"
                                   step="1000"
                                   @bind="_extractionSettings.MaxProgramCellsPerSheet"
                                   @bind:event="oninput"
                                   disabled="@_isBusy" />
                        </label>
                        <label class="daily-setting-field wide">
                            <span>Saved extract refresh</span>
                            <select class="form-select form-select-sm"
                                    @bind="_extractionSettings.SavedExtractRefreshMode"
                                    disabled="@(_isBusy || IsSavedExtractTextOnly)">
                                <option value="@DailyTestSavedExtractRefreshModes.RefreshLimited">Refresh 5,000-cell extracts</option>
                                <option value="@DailyTestSavedExtractRefreshModes.RefreshAll">Refresh every saved extract</option>
                                <option value="@DailyTestSavedExtractRefreshModes.Never">Never refresh saved extracts</option>
                            </select>
                        </label>
                        <button class="btn btn-primary btn-sm"
                                @onclick="SaveExtractionSettings"
                                disabled="@_isBusy">
                            Apply
                        </button>
                    </div>
                    <div class="daily-extract-settings-summary">@ExtractionSettingsSummary</div>
                </div>
            }

            @if (!AiProviders.CodexCliEnabled)
            {
                <div class="alert alert-warning py-2 small mb-2">
                    Codex CLI is disabled. 저장은 가능하지만 AI 분석은 사용할 수 없습니다.
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_status))
            {
                <div class="@StatusClass">@_status</div>
            }
            @if (HasPendingCurrentInputData)
            {
                <div class="daily-pending-analysis">
                    <span class="@PendingCurrentInputBadgeClass">@PendingCurrentInputBadgeText</span>
                    <span>@PendingCurrentInputText</span>
                </div>
            }
            @if (CurrentAttachedDataFiles.Count > 0)
            {
                <section class="daily-attached-files">
                    <div class="daily-attached-files-head">
                        <span>첨부 파일</span>
                        <span>@CurrentAttachedDataFiles.Count.ToString("N0") file(s)</span>
                    </div>
                    <div class="daily-attached-files-list">
                        @foreach (string file in CurrentAttachedDataFiles)
                        {
                            <span class="daily-attached-file" title="@file">@file</span>
                        }
                    </div>
                </section>
            }
            @if (_viewingHistory && ActiveHistoryDiff is { } historyDiff)
            {
                <section class="daily-history-diff-panel">
                    <div class="daily-history-diff-head">
                        <span>History diff</span>
                        <span>@historyDiff.BaseTitle -> @historyDiff.Title</span>
                        <span class="daily-diff-stat add">+@historyDiff.AddedCount.ToString("N0")</span>
                        <span class="daily-diff-stat remove">-@historyDiff.RemovedCount.ToString("N0")</span>
                    </div>
                    <div class="daily-history-diff-body">
                        @if (historyDiff.Lines.Count == 0)
                        {
                            <div class="daily-history-diff-empty">No line-level difference found.</div>
                        }
                        else
                        {
                            @foreach (DailyTestDiffLine line in historyDiff.Lines)
                            {
                                <div class="@DiffLineClass(line.Kind)">
                                    <span class="daily-diff-kind">@line.Kind</span>
                                    <span class="daily-diff-text">@line.Text</span>
                                </div>
                            }
                            @if (historyDiff.Truncated)
                            {
                                <div class="daily-history-diff-empty">Diff preview truncated.</div>
                            }
                        }
                    </div>
                </section>
            }

            <div class="daily-grid daily-prompt-grid">
                <section class="daily-panel daily-prompt-panel">
                    <div class="daily-panel-head">
                        <span>Prompt</span>
                        <div class="daily-panel-actions">
                            <span class="daily-muted">@DataCharCount</span>
                            <InputFile class="form-control form-control-sm daily-file-input"
                                       OnChange="OnXlsxSelected"
                                       accept=".xlsx,.xlsm,.xlsb,.xls"
                                       multiple
                                       disabled="@(_isBusy || _viewingHistory)" />
                            <button class="btn btn-outline-secondary btn-sm py-0 px-2" @onclick="CopyGeneratedPrompt" disabled="@_isBusy">Copy built prompt</button>
                        </div>
                    </div>
                    <textarea class="form-control daily-textarea daily-prompt-textarea"
                              @bind="_promptText"
                              @bind:event="oninput"
                              disabled="@(_isBusy || _viewingHistory)"
                              placeholder="AI에게 시킬 분석 지시를 작성하세요. 예: 모델/라인별 NG 증가 원인, 파라미터 변화, 전일 대비 이상 항목을 찾아줘."></textarea>
                </section>
            </div>

            <div class="daily-result-grid">
                <section class="daily-panel">
                    <div class="daily-panel-head">
                        <span>Input Summary</span>
                        <span class="daily-muted">from attached Excel / pasted data</span>
                    </div>
                    <div class="daily-summary">
                        @RenderDataSummary()
                    </div>
                </section>

                <section class="daily-panel">
                    <div class="daily-panel-head">
                        <span>AI Analysis HTML Result</span>
                        @if (!string.IsNullOrWhiteSpace(_analyzedAt))
                        {
                            <span class="daily-muted">@FormatDate(_analyzedAt)</span>
                        }
                        <button class="btn btn-outline-secondary btn-sm py-0 px-2"
                                @onclick="OpenAnalysisHtml"
                                disabled="@(string.IsNullOrWhiteSpace(_analysisMarkdown) && string.IsNullOrWhiteSpace(_analysisHtml))">
                            Open HTML
                        </button>
                    </div>
                    @if (string.IsNullOrWhiteSpace(_analysisMarkdown) && string.IsNullOrWhiteSpace(_analysisHtml))
                    {
                        <div class="daily-empty result">분석 결과가 없습니다.</div>
                    }
                    else if (!string.IsNullOrWhiteSpace(_analysisHtml))
                    {
                        <div class="daily-html-report daily-generated-html">
                            @RenderStoredHtml(_analysisHtml)
                        </div>
                    }
                    else
                    {
                        <div class="daily-html-report">
                            @RenderAnalysisHtml(_analysisMarkdown)
                        </div>
                    }
                </section>
            </div>
        }
    </main>
</div>

<style>
    .daily-root {
        /* the shell hands this route a definite height (instrument.css 8b);
           --view-h keeps the classic shell close to the old value */
        height: var(--view-h, calc(100vh - 24px));
        display: grid;
        grid-template-columns: 290px minmax(0, 1fr);
        gap: 12px;
        padding: 10px;
        background: #f6f8fb;
        overflow: hidden;
    }
    .daily-sidebar {
        border: 1px solid #d8e0eb;
        background: var(--panel, #fff);
        border-radius: 2px;
        padding: 10px;
        display: flex;
        flex-direction: column;
        min-height: 0;
    }
    .daily-side-head, .daily-toolbar, .daily-panel-head {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .daily-side-head { margin-bottom: 8px; }
    .daily-side-title { font-size: 14px; font-weight: 800; color: var(--ink, #0f1319); flex: 1; }
    .daily-item-list { margin-top: 10px; display: flex; flex-direction: column; gap: 6px; overflow-y: auto; min-height: 0; }
    .daily-item, .daily-history-card {
        text-align: left;
        border: 1px solid var(--line, var(--line, #dde1e7));
        background: var(--panel, #fff);
        border-radius: 2px;
        padding: 8px;
        display: grid;
        gap: 3px;
        color: var(--ink, #0f1319);
    }
    .daily-item:hover { border-color: #93c5fd; background: #f8fbff; }
    .daily-item.active { border-color: #2563eb; background: #eff6ff; }
    .daily-history {
        margin-top: 12px;
        border-top: 1px solid var(--line, var(--line, #dde1e7));
        padding-top: 10px;
        display: flex;
        flex-direction: column;
        gap: 6px;
        max-height: calc(var(--view-h, 100vh) * .38);
        overflow-y: auto;
        flex-shrink: 0;
    }
    .daily-history-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        font-size: 12px;
        font-weight: 800;
        color: var(--ink-2, #4a5461);
    }
    .daily-history-actions {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-shrink: 0;
    }
    .daily-history-card {
        padding: 7px;
        gap: 2px;
    }
    .daily-history-card:hover { border-color: #86efac; background: #f7fff9; }
    .daily-history-card.active { border-color: #16a34a; background: #f0fdf4; }
    .daily-history-top { display: flex; align-items: center; gap: 5px; min-width: 0; }
    .daily-history-title { min-width: 0; flex: 1; font-size: 11px; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .daily-history-meta { font-size: 10px; color: var(--ink-2, #4a5461); }
    .daily-history-badge {
        flex: 0 0 auto;
        border-radius: 2px;
        border: 1px solid;
        padding: 1px 4px;
        font-size: 9px;
        font-weight: 800;
        line-height: 1.35;
        white-space: nowrap;
    }
    .daily-history-badge.done { color: #166534; border-color: #86efac; background: #dcfce7; }
    .daily-history-badge.pending { color: #92400e; border-color: #fcd34d; background: #fef3c7; }
    .daily-item-name { font-weight: 700; font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .daily-item-meta, .daily-muted { font-size: 11px; color: var(--ink-2, #4a5461); }
    .daily-item-badge {
        justify-self: start;
        font-size: 10px;
        color: #166534;
        border: 1px solid #bbf7d0;
        background: #f0fdf4;
        border-radius: 2px;
        padding: 1px 5px;
        font-weight: 700;
    }
    .daily-main { min-width: 0; overflow-y: auto; }
    .daily-toolbar {
        border: 1px solid #d8e0eb;
        background: var(--panel, #fff);
        border-radius: 2px;
        padding: 8px;
        margin-bottom: 8px;
        flex-wrap: wrap;
    }
    .daily-extract-settings {
        border: 1px solid #d8e0eb;
        background: var(--panel, #fff);
        border-radius: 2px;
        padding: 10px;
        margin-bottom: 8px;
    }
    .daily-extract-settings-row {
        display: flex;
        align-items: end;
        gap: 8px;
        flex-wrap: wrap;
    }
    .daily-setting-field {
        display: grid;
        gap: 3px;
        min-width: 160px;
        margin: 0;
        font-size: 11px;
        font-weight: 700;
        color: var(--ink-2, #4a5461);
    }
    .daily-setting-field.wide { min-width: 220px; }
    .daily-extract-settings-summary {
        margin-top: 6px;
        font-size: 11px;
        color: var(--ink-2, #4a5461);
    }
    .daily-name { max-width: 460px; font-weight: 700; }
    .daily-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(360px, 0.45fr);
        gap: 10px;
        margin-bottom: 10px;
    }
    .daily-prompt-grid {
        grid-template-columns: minmax(0, 1fr);
    }
    .daily-pending-analysis {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
        border: 1px solid #fcd34d;
        background: #fffbeb;
        color: #78350f;
        border-radius: 2px;
        padding: 7px 10px;
        margin-bottom: 8px;
        font-size: 12px;
        font-weight: 700;
    }
    .daily-pending-analysis span:last-child {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .daily-pending-badge {
        flex: 0 0 auto;
        border-radius: 2px;
        border: 1px solid #f59e0b;
        background: #fef3c7;
        color: #92400e;
        padding: 1px 6px;
        font-size: 10px;
        font-weight: 900;
    }
    .daily-pending-badge.busy {
        border-color: #93c5fd;
        background: #dbeafe;
        color: #1d4ed8;
    }
    .daily-attached-files {
        border: 1px solid #d8e0eb;
        background: var(--panel, #fff);
        border-radius: 2px;
        padding: 8px 10px;
        margin-bottom: 8px;
        min-width: 0;
    }
    .daily-attached-files-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin-bottom: 6px;
        font-size: 12px;
        font-weight: 800;
        color: var(--ink, #0f1319);
    }
    .daily-attached-files-head span:last-child {
        flex: 0 0 auto;
        font-size: 11px;
        color: var(--ink-2, #4a5461);
        font-weight: 700;
    }
    .daily-attached-files-list {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        min-width: 0;
    }
    .daily-attached-file {
        max-width: min(100%, 520px);
        border: 1px solid #bfdbfe;
        background: #eff6ff;
        color: #1e3a8a;
        border-radius: 2px;
        padding: 3px 7px;
        font-size: 11px;
        font-weight: 700;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .daily-history-diff-panel {
        border: 1px solid #d8e0eb;
        background: var(--panel, #fff);
        border-radius: 2px;
        margin-bottom: 8px;
        min-width: 0;
        overflow: hidden;
    }
    .daily-history-diff-head {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 7px 10px;
        border-bottom: 1px solid var(--line, var(--line, #dde1e7));
        background: var(--panel-2, #f5f6f9);
        font-size: 12px;
        font-weight: 800;
        color: var(--ink, #0f1319);
        min-width: 0;
    }
    .daily-history-diff-head span:nth-child(2) {
        flex: 1;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: var(--ink-2, #4a5461);
        font-size: 11px;
        font-weight: 700;
    }
    .daily-diff-stat {
        border-radius: 2px;
        padding: 1px 6px;
        font-size: 11px;
        font-weight: 800;
    }
    .daily-diff-stat.add { background: #dcfce7; color: #166534; }
    .daily-diff-stat.remove { background: #fee2e2; color: #991b1b; }
    .daily-history-diff-body {
        max-height: 260px;
        overflow: auto;
        font: 11px/1.45 Consolas, "Courier New", monospace;
    }
    .daily-diff-line {
        display: grid;
        grid-template-columns: 18px minmax(0, 1fr);
        gap: 6px;
        padding: 1px 8px;
        white-space: pre-wrap;
        word-break: break-word;
    }
    .daily-diff-line.add { background: #ecfdf5; color: #14532d; }
    .daily-diff-line.remove { background: #fef2f2; color: #7f1d1d; }
    .daily-diff-kind {
        font-weight: 900;
        text-align: center;
    }
    .daily-history-diff-empty {
        padding: 9px 10px;
        color: var(--ink-2, #4a5461);
        font-size: 12px;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    .daily-result-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 10px;
        margin-bottom: 10px;
    }
    .daily-panel {
        border: 1px solid #d8e0eb;
        background: var(--panel, #fff);
        border-radius: 2px;
        padding: 10px;
        min-width: 0;
    }
    .daily-panel-head {
        justify-content: space-between;
        font-size: 13px;
        font-weight: 800;
        color: var(--ink, #0f1319);
        margin-bottom: 8px;
    }
    .daily-panel-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 8px;
        min-width: 0;
    }
    .daily-textarea {
        min-height: 260px;
        resize: vertical;
        font-family: Consolas, "Courier New", monospace;
        font-size: 12px;
        line-height: 1.45;
    }
    .daily-prompt-textarea {
        min-height: 300px;
    }
    .daily-pre {
        white-space: pre-wrap;
        overflow: auto;
        max-height: calc(var(--view-h, 100vh) * .64);
        margin: 0;
        font-size: 12px;
        line-height: 1.5;
        color: var(--ink, #0f1319);
        background: var(--panel-2, #f5f6f9);
        border: 1px solid var(--line, var(--line, #dde1e7));
        border-radius: 2px;
        padding: 10px;
    }
    .daily-html-report {
        overflow: auto;
        max-height: calc(var(--view-h, 100vh) * .68);
        font-size: 12px;
        line-height: 1.55;
        color: var(--ink, #0f1319);
        background: var(--panel, #fff);
        border: 1px solid var(--line, var(--line, #dde1e7));
        border-radius: 2px;
        padding: 12px;
    }
    .daily-html-report h2 {
        font-size: 16px;
        margin: 12px 0 8px;
        color: var(--ink, #0f1319);
    }
    .daily-html-report h3 {
        font-size: 14px;
        margin: 10px 0 6px;
        color: var(--ink, #0f1319);
    }
    .daily-html-report p { margin: 0 0 8px; }
    .daily-html-report ul { margin: 0 0 8px 18px; padding: 0; }
    .daily-html-report table {
        width: 100%;
        border-collapse: collapse;
        margin: 8px 0 12px;
        font-size: 12px;
    }
    .daily-html-report th,
    .daily-html-report td {
        border: 1px solid #d8e0eb;
        padding: 6px 7px;
        vertical-align: top;
    }
    .daily-html-report th {
        background: #eef4ff;
        font-weight: 800;
        color: var(--ink, #0f1319);
    }
