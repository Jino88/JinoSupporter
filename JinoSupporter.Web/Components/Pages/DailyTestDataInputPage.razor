    private static string ConvertAnalysisMarkdownToHtml(string? markdown)
    {
        string[] lines = (markdown ?? "").Replace("\r\n", "\n").Replace('\r', '\n').Split('\n');
        var sb = new System.Text.StringBuilder();
        bool inList = false;

        static string Enc(string value) => System.Net.WebUtility.HtmlEncode(value ?? "");
        static string Inline(string value)
        {
            string html = Enc(value);
            html = System.Text.RegularExpressions.Regex.Replace(html, @"\*\*(.+?)\*\*", "<strong>$1</strong>");
            html = System.Text.RegularExpressions.Regex.Replace(html, @"`([^`]+)`", "<code>$1</code>");
            return html;
        }
        static bool IsTableLine(string line) => line.Trim().StartsWith("|", StringComparison.Ordinal)
                                             && line.Trim().EndsWith("|", StringComparison.Ordinal);
        static bool IsSeparator(string line)
        {
            string t = line.Trim().Trim('|').Replace(" ", "");
            return t.Length > 0 && t.All(ch => ch == '-' || ch == ':' || ch == '|');
        }
        static List<string> Cells(string line)
            => line.Trim().Trim('|').Split('|').Select(x => x.Trim()).ToList();

        void CloseList()
        {
            if (!inList) return;
            sb.AppendLine("</ul>");
            inList = false;
        }

        for (int i = 0; i < lines.Length; i++)
        {
            string trim = lines[i].Trim();
            if (string.IsNullOrWhiteSpace(trim))
            {
                CloseList();
                continue;
            }

            if (trim.StartsWith("```", StringComparison.Ordinal))
            {
                CloseList();
                var block = new System.Text.StringBuilder();
                i++;
                while (i < lines.Length && !lines[i].Trim().StartsWith("```", StringComparison.Ordinal))
                {
                    block.AppendLine(lines[i]);
                    i++;
                }
                sb.Append("<pre><code>").Append(Enc(block.ToString())).AppendLine("</code></pre>");
                continue;
            }

            if (IsTableLine(trim) && i + 1 < lines.Length && IsSeparator(lines[i + 1]))
            {
                CloseList();
                var headers = Cells(trim);
                i += 2;
                sb.AppendLine("<table><thead><tr>");
                foreach (string h in headers) sb.Append("<th>").Append(Inline(h)).AppendLine("</th>");
                sb.AppendLine("</tr></thead><tbody>");
                while (i < lines.Length && IsTableLine(lines[i]))
                {
                    sb.AppendLine("<tr>");
                    foreach (string c in Cells(lines[i])) sb.Append("<td>").Append(Inline(c)).AppendLine("</td>");
                    sb.AppendLine("</tr>");
                    i++;
                }
                i--;
                sb.AppendLine("</tbody></table>");
                continue;
            }

            int heading = trim.TakeWhile(ch => ch == '#').Count();
            if (heading is >= 1 and <= 4 && trim.Length > heading && trim[heading] == ' ')
            {
                CloseList();
                int level = Math.Min(heading + 1, 3);
                sb.Append("<h").Append(level).Append(">")
                  .Append(Inline(trim[(heading + 1)..].Trim()))
                  .Append("</h").Append(level).AppendLine(">");
                continue;
            }

            if (trim.StartsWith("- ", StringComparison.Ordinal) || trim.StartsWith("* ", StringComparison.Ordinal))
            {
                if (!inList)
                {
                    sb.AppendLine("<ul>");
                    inList = true;
                }
                sb.Append("<li>").Append(Inline(trim[2..].Trim())).AppendLine("</li>");
                continue;
            }

            CloseList();
            sb.Append("<p>").Append(Inline(trim)).AppendLine("</p>");
        }

        CloseList();
        return sb.ToString();
    }

    private static string SanitizeHtmlFragment(string html)
    {
        string text = (html ?? "").Trim();
        if (string.IsNullOrWhiteSpace(text)) return "";

        var body = System.Text.RegularExpressions.Regex.Match(
            text,
            @"<body\b[^>]*>(.*?)</body>",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.Singleline);
        if (body.Success) text = body.Groups[1].Value;

        text = System.Text.RegularExpressions.Regex.Replace(
            text,
            @"<\s*(script|iframe|object|embed|style|link|meta|base)\b[^>]*>.*?<\s*/\s*\1\s*>",
            "",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.Singleline);
        text = System.Text.RegularExpressions.Regex.Replace(
            text,
            @"<\s*(script|iframe|object|embed|style|link|meta|base)\b[^>]*/?\s*>",
            "",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        text = System.Text.RegularExpressions.Regex.Replace(
            text,
            @"\s+on\w+\s*=\s*(""[^""]*""|'[^']*'|[^\s>]+)",
            "",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        text = System.Text.RegularExpressions.Regex.Replace(
            text,
            @"\s+(href|src)\s*=\s*(['""])\s*javascript:[^'""]*\2",
            " $1=\"#\"",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        return text;
    }

    private static string NormalizeAnalysisHtmlForStorage(string html)
    {
        string text = StripMarkdownHtmlFence(html ?? "").Trim();
        if (string.IsNullOrWhiteSpace(text)) return "";
        return LooksLikeStandaloneHtmlDocument(text) ? text : SanitizeHtmlFragment(text);
    }

    private static bool LooksLikeStandaloneHtmlDocument(string html)
    {
        string text = (html ?? "").TrimStart('\uFEFF', ' ', '\t', '\r', '\n');
        if (text.StartsWith("```", StringComparison.Ordinal))
            text = StripMarkdownHtmlFence(text).TrimStart('\uFEFF', ' ', '\t', '\r', '\n');
        return text.StartsWith("<!doctype", StringComparison.OrdinalIgnoreCase)
               || System.Text.RegularExpressions.Regex.IsMatch(
                   text,
                   @"<html\b",
                   System.Text.RegularExpressions.RegexOptions.IgnoreCase);
    }

    private static bool WantsStandaloneDailyTestHtml(string text)
    {
        text = (text ?? "").Trim();
        if (string.IsNullOrWhiteSpace(text)) return false;

        string lower = text.ToLowerInvariant();
        return text.Contains("단독 실행", StringComparison.Ordinal)
               || text.Contains("외부 서버 없이", StringComparison.Ordinal)
               || text.Contains("검색창", StringComparison.Ordinal)
               || text.Contains("개선 날짜", StringComparison.Ordinal)
               || lower.Contains("javascript", StringComparison.Ordinal)
               || lower.Contains("canvas", StringComparison.Ordinal)
               || lower.Contains("<script", StringComparison.Ordinal)
               || lower.Contains("standalone", StringComparison.Ordinal)
               || lower.Contains("full html", StringComparison.Ordinal)
               || lower.Contains("doctype", StringComparison.Ordinal)
               || lower.Contains("html file", StringComparison.Ordinal)
               || lower.Contains("html 파일", StringComparison.Ordinal)
               || lower.Contains("apply 버튼", StringComparison.Ordinal);
    }

    private static string ExtractRequestedStandaloneOutputPath(params string?[] texts)
    {
        foreach (string? source in texts)
        {
            string text = source ?? "";
            foreach (System.Text.RegularExpressions.Match match in System.Text.RegularExpressions.Regex.Matches(
                         text,
                         @"(?<path>(?:[A-Za-z]:\\|\\\\)[^\r\n""<>|?*]+?\.html?)",
                         System.Text.RegularExpressions.RegexOptions.IgnoreCase))
            {
                string path = match.Groups["path"].Value
                    .Trim()
                    .Trim('`', '\'', '"', ' ', '\t', '.', ',', ';', ')', ']', '}');
                if (path.EndsWith(".html", StringComparison.OrdinalIgnoreCase)
                    || path.EndsWith(".htm", StringComparison.OrdinalIgnoreCase))
                    return path;
            }
        }
        return "";
    }

    private static string TryWriteRequestedStandaloneHtmlFile(string promptText, string analysisPrompt, string analysisHtml)
    {
        if (!LooksLikeStandaloneHtmlDocument(analysisHtml)) return "";

        string outputPath = ExtractRequestedStandaloneOutputPath(promptText, analysisPrompt);
        if (string.IsNullOrWhiteSpace(outputPath)) return "";

        try
        {
            string fullPath = Path.GetFullPath(outputPath);
            if (!fullPath.EndsWith(".html", StringComparison.OrdinalIgnoreCase)
                && !fullPath.EndsWith(".htm", StringComparison.OrdinalIgnoreCase))
                return "";

            string? dir = Path.GetDirectoryName(fullPath);
            if (!string.IsNullOrWhiteSpace(dir)) Directory.CreateDirectory(dir);
            File.WriteAllText(
                fullPath,
                analysisHtml.Trim(),
                new System.Text.UTF8Encoding(encoderShouldEmitUTF8Identifier: false));
            return fullPath;
        }
        catch
        {
            return "";
        }
    }

    private static string HtmlTitle(string name)
        => string.IsNullOrWhiteSpace(name) ? "Daily Test Data Analysis" : $"{name} - Daily Test Data Analysis";

    private static string HistoryTitle(DailyTestDataHistoryRecord h)
    {
        List<string> sources = ExtractHistoryDataSources(h.DataText);
        if (sources.Count > 0)
        {
            string title = sources.Count == 1
                ? $"추가 DATA: {sources[0]}"
                : $"추가 DATA: {sources[0]} +{sources.Count - 1:N0}";
            return ShortText(title, 42);
        }

        string prompt = (h.PromptText ?? "").Trim();
        if (!string.IsNullOrWhiteSpace(prompt)) return ShortText(prompt, 42);

        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(string.IsNullOrWhiteSpace(h.ParametersJson) ? "{}" : h.ParametersJson);
            if (doc.RootElement.TryGetProperty("dataSummary", out var summary))
            {
                string range = JsonText(summary, "monthRange", "dateRangeStart");
                if (!string.IsNullOrWhiteSpace(range)) return ShortText(range, 42);
            }
        }
        catch { }

        return "Analysis snapshot";
    }

    private static string HistoryDataMeta(DailyTestDataHistoryRecord h)
    {
        var parts = new List<string>();
        string created = FormatDate(h.CreatedAt);
        if (!string.IsNullOrWhiteSpace(created)) parts.Add(created);

        var summary = ExtractHistoryDataSummary(h.ParametersJson, h.DataText);
        if (!string.IsNullOrWhiteSpace(summary.RowCount)) parts.Add($"{summary.RowCount} rows");

        string range = "";
        if (!string.IsNullOrWhiteSpace(summary.StartDate) && !string.IsNullOrWhiteSpace(summary.EndDate))
            range = string.Equals(summary.StartDate, summary.EndDate, StringComparison.Ordinal)
                ? summary.StartDate
                : $"{summary.StartDate}~{summary.EndDate}";
        else if (!string.IsNullOrWhiteSpace(summary.StartDate))
            range = summary.StartDate;
        else if (!string.IsNullOrWhiteSpace(summary.EndDate))
            range = summary.EndDate;
        if (!string.IsNullOrWhiteSpace(range)) parts.Add(range);

        return string.Join(" · ", parts);
    }

    private static string HistoryAnalysisBadgeClass(DailyTestDataHistoryRecord h)
        => HasHistoryAnalysis(h) ? "daily-history-badge done" : "daily-history-badge pending";

    private static string HistoryAnalysisBadgeText(DailyTestDataHistoryRecord h)
        => HasHistoryAnalysis(h) ? "AI 완료" : "AI 대기";

    private static string HistoryTooltip(DailyTestDataHistoryRecord h)
    {
        var lines = new List<string>();
        lines.Add(HasHistoryAnalysis(h) ? "AI 분석 완료" : "AI 분석 대기");

        List<string> sources = ExtractHistoryDataSources(h.DataText);
        if (sources.Count > 0)
        {
            lines.Add("추가 DATA");
            lines.AddRange(sources);
        }

        string meta = HistoryDataMeta(h);
        if (!string.IsNullOrWhiteSpace(meta)) lines.Add(meta);

        if (lines.Count == 0 && !string.IsNullOrWhiteSpace(h.PromptText))
            lines.Add(ShortText(h.PromptText, 300));

        return string.Join(Environment.NewLine, lines);
    }

    private static List<string> ExtractHistoryDataSources(string dataText)
    {
        var names = new List<string>();
        if (string.IsNullOrWhiteSpace(dataText)) return names;

        foreach (string rawLine in dataText.Replace("\r\n", "\n").Replace('\r', '\n').Split('\n'))
        {
            string line = rawLine.Trim();
            if (string.IsNullOrWhiteSpace(line)) continue;

            if (line.StartsWith(XlsxAttachmentPrefix, StringComparison.Ordinal))
            {
                string[] parts = line[XlsxAttachmentPrefix.Length..].Split('\t', 2);
                AddHistorySourceName(names, parts.Length > 0 ? parts[0] : "");
                continue;
            }

            var extract = System.Text.RegularExpressions.Regex.Match(
                line,
                @"^=+\s*EXCEL COM EXTRACT:\s*(.*?)\s*=+$",
                System.Text.RegularExpressions.RegexOptions.IgnoreCase);
            if (extract.Success)
            {
                AddHistorySourceName(names, extract.Groups[1].Value);
                continue;
            }

            if (line.StartsWith("File:", StringComparison.OrdinalIgnoreCase))
            {
                AddHistorySourceName(names, line["File:".Length..]);
                continue;
            }

            if (names.Count == 0 && line.StartsWith("SourceWorkbookPath:", StringComparison.OrdinalIgnoreCase))
            {
                string path = line["SourceWorkbookPath:".Length..].Trim();
                AddHistorySourceName(names, Path.GetFileName(path));
            }
        }

        return names
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(6)
            .ToList();
    }

    private static void AddHistorySourceName(List<string> names, string value)
    {
        string name = CleanHistorySourceName(value);
        if (string.IsNullOrWhiteSpace(name)) return;
        if (!names.Contains(name, StringComparer.OrdinalIgnoreCase))
            names.Add(name);
    }

    private static string CleanHistorySourceName(string value)
    {
        string name = (value ?? "").Trim().Trim('"', '\'');
        if (string.IsNullOrWhiteSpace(name)) return "";

        if (name.IndexOfAny(Path.GetInvalidPathChars()) < 0)
        {
            try
            {
                string fileName = Path.GetFileName(name);
                if (!string.IsNullOrWhiteSpace(fileName)) name = fileName;
            }
            catch { }
        }

        name = System.Text.RegularExpressions.Regex.Replace(
            name,
            @"^\d{14}_[0-9a-f]{32}_",
            "",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        return name.Trim();
    }

    private static (string RowCount, string StartDate, string EndDate) ExtractHistoryDataSummary(
        string parametersJson,
        string dataText)
    {
        string rowCount = "";
        string startDate = "";
        string endDate = "";

        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(string.IsNullOrWhiteSpace(parametersJson) ? "{}" : parametersJson);
            if (doc.RootElement.TryGetProperty("dataSummary", out var summary)
                && summary.ValueKind == System.Text.Json.JsonValueKind.Object)
            {
                rowCount = JsonText(summary, "rowCount", "totalRows", "rows", "recordCount");
                startDate = JsonText(summary, "dateRangeStart", "startDate", "fromDate", "firstDate");
                endDate = JsonText(summary, "dateRangeEnd", "endDate", "toDate", "lastDate");
            }
        }
        catch { }

        if (string.IsNullOrWhiteSpace(rowCount) && !string.IsNullOrWhiteSpace(dataText))
        {
            var sheets = System.Text.RegularExpressions.Regex.Match(
                dataText,
                @"^Sheets:\s*\d+\s*,\s*Rows:\s*([0-9,]+)",
                System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.Multiline);
            if (sheets.Success) rowCount = sheets.Groups[1].Value.Replace(",", "");
        }

        return (rowCount, startDate, endDate);
    }

    private static string ShortText(string text, int max)
    {
        text = (text ?? "").Replace("\r", " ").Replace("\n", " ").Trim();
        return text.Length <= max ? text : text[..Math.Max(0, max - 1)] + "...";
    }

