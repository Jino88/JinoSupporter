    private string BuildCumulativeUpdatePrompt(
        IReadOnlyList<DailyTestPriorSnapshot> priorSnapshots,
        IReadOnlyList<XlsxAttachment> currentXlsxFiles,
        string currentDataText,
        string currentPromptText,
        string existingAnalysisMarkdown,
        string existingAnalysisHtml,
        string existingAnalysisAt,
        DailyTestAiResult? currentAdditionAnalysis,
        string? cumulativeDataTextOverride = null,
        string? cumulativePromptTextOverride = null,
        IReadOnlyList<XlsxAttachment>? cumulativeXlsxFilesOverride = null,
        bool usingCanonicalCumulativeStore = false,
        bool usingAggregateOnlyCumulativeUpdate = false)
    {
        string prompt = BuildAnalysisPrompt(priorSnapshots, currentXlsxFiles, currentDataText, currentPromptText,
            existingAnalysisMarkdown, existingAnalysisHtml, existingAnalysisAt,
            cumulativeDataTextOverride, cumulativePromptTextOverride, cumulativeXlsxFilesOverride,
            usingCanonicalCumulativeStore,
            usingAggregateOnlyCumulativeUpdate);
        if (currentAdditionAnalysis is null)
        {
            if (string.IsNullOrWhiteSpace(currentDataText) && !string.IsNullOrWhiteSpace(currentPromptText))
            {
                return prompt + Environment.NewLine + Environment.NewLine
                    + AiPromptRegistry.Read("daily-test-data/cumulative-prompt-only-reanalysis.md");
            }

            return prompt + Environment.NewLine + Environment.NewLine
                + AiPromptRegistry.Read("daily-test-data/cumulative-update-no-current-addition.md");
        }

        return prompt + Environment.NewLine + Environment.NewLine + AiPromptRegistry.Render(
            "daily-test-data/cumulative-update-with-current-addition.md",
            ("currentAdditionAnalysis", FormatAiResultForPrompt(currentAdditionAnalysis)));
    }

    private static string FormatAiResultForPrompt(DailyTestAiResult result)
    {
        var sb = new System.Text.StringBuilder();
        if (!string.IsNullOrWhiteSpace(result.ParametersJson))
        {
            sb.AppendLine("parameters:");
            sb.AppendLine(result.ParametersJson.Trim());
        }
        if (!string.IsNullOrWhiteSpace(result.AnalysisMarkdown))
        {
            if (sb.Length > 0) sb.AppendLine();
            sb.AppendLine("analysisMarkdown:");
            sb.AppendLine(result.AnalysisMarkdown.Trim());
        }
        if (!string.IsNullOrWhiteSpace(result.HistoryAnalysisMarkdown))
        {
            if (sb.Length > 0) sb.AppendLine();
            sb.AppendLine("historyAnalysisMarkdown:");
            sb.AppendLine(result.HistoryAnalysisMarkdown.Trim());
        }
        if (sb.Length == 0) return "(none)";
        return sb.ToString();
    }

