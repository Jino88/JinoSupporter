    private DailyTestHistoryDiff? BuildActiveHistoryDiff()
    {
        if (_activeHistoryId is null) return null;

        DailyTestDataHistoryRecord? current = _history.FirstOrDefault(h => h.Id == _activeHistoryId.Value);
        if (current is null) return null;

        List<DailyTestDataHistoryRecord> ordered = _history
            .OrderBy(h => h.CreatedAt, StringComparer.Ordinal)
            .ThenBy(h => h.Id)
            .ToList();
        int index = ordered.FindIndex(h => h.Id == current.Id);
        DailyTestDataHistoryRecord? previous = index > 0 ? ordered[index - 1] : null;
        string baseText = previous?.DataText ?? "";
        string baseTitle = previous is null ? "empty" : HistoryTitle(previous);

        return BuildHistoryDiff(baseText, current.DataText, baseTitle, HistoryTitle(current));
    }

    private static DailyTestHistoryDiff BuildHistoryDiff(string baseText, string targetText, string baseTitle, string title)
    {
        const int maxLines = 320;
        List<string> baseLines = NormalizeDiffLines(baseText);
        List<string> targetLines = NormalizeDiffLines(targetText);
        Dictionary<string, int> baseCounts = CountDiffLines(baseLines);
        Dictionary<string, int> targetCounts = CountDiffLines(targetLines);

        var preview = new List<DailyTestDiffLine>();
        int added = 0;
        int removed = 0;

        foreach (string line in targetLines)
        {
            if (baseCounts.TryGetValue(line, out int count) && count > 0)
            {
                baseCounts[line] = count - 1;
                continue;
            }

            added++;
            if (preview.Count < maxLines)
                preview.Add(new DailyTestDiffLine("+", ShortDiffLine(line)));
        }

        foreach (string line in baseLines)
        {
            if (targetCounts.TryGetValue(line, out int count) && count > 0)
            {
                targetCounts[line] = count - 1;
                continue;
            }

            removed++;
            if (preview.Count < maxLines)
                preview.Add(new DailyTestDiffLine("-", ShortDiffLine(line)));
        }

        return new DailyTestHistoryDiff(
            title,
            baseTitle,
            added,
            removed,
            preview,
            added + removed > preview.Count);
    }

    private static List<string> NormalizeDiffLines(string text)
        => (text ?? "")
            .Replace("\r\n", "\n")
            .Replace('\r', '\n')
            .Split('\n')
            .Select(line => line.TrimEnd())
            .Where(line => !string.IsNullOrWhiteSpace(line))
            .ToList();

    private static Dictionary<string, int> CountDiffLines(IEnumerable<string> lines)
    {
        var counts = new Dictionary<string, int>(StringComparer.Ordinal);
        foreach (string line in lines)
        {
            counts.TryGetValue(line, out int count);
            counts[line] = count + 1;
        }
        return counts;
    }

    private static string ShortDiffLine(string line)
