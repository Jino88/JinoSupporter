    private async Task<DailyTestTypoCorrectionResult> CorrectDailyTestDataTextTyposIfNeededAsync(
        string workDir,
        string tmpDir,
        long itemId,
        string name,
        string dataText,
        string sourceLabel)
    {
        if (string.IsNullOrWhiteSpace(dataText))
            return new DailyTestTypoCorrectionResult(true, dataText, 0, false);

        IReadOnlyList<DailyTestTypoCandidate> candidates = BuildTypoCorrectionCandidates(dataText);
        if (candidates.Count == 0)
            return new DailyTestTypoCorrectionResult(true, dataText, 0, false);

        if (!AiProviders.CodexCliEnabled)
        {
            SetStatus("Codex CLI is disabled. AI typo correction is required before saving this added data.", true);
            return new DailyTestTypoCorrectionResult(false, dataText, 0, false);
        }

        string runId = Guid.NewGuid().ToString("N")[..12];
        string requestPath = Path.Combine(tmpDir, $"daily_test_typo_request_{runId}.json");
        string outputPath = Path.Combine(tmpDir, $"daily_test_typo_output_{runId}.txt");
        string donePath = Path.Combine(tmpDir, $"daily_test_typo_done_{runId}.json");

        WriteDailyTestTypoCorrectionRequest(requestPath, runId, itemId, name, sourceLabel, candidates);
        IReadOnlyList<DailyTestTypoReplacement>? replacements = await RunCliTypoCorrectionAsync(
            workDir,
            requestPath,
            outputPath,
            donePath,
            $"Daily Test Data typo check ({name})",
            $"AI typo checking {candidates.Count:N0} candidate text(s)");
        if (replacements is null)
            return new DailyTestTypoCorrectionResult(false, dataText, 0, true);

        string corrected = ApplyTypoReplacements(dataText, replacements, candidates, out int applied);
        if (applied > 0)
        {
            ActivityLog.Log("DailyTest", $"typo correction applied item={itemId} source={sourceLabel} changes={applied}");
            SetStatus($"AI typo correction applied {applied:N0} replacement(s).", false);
        }
        else
        {
            SetStatus("AI typo correction finished. No changes were needed.", false);
        }

        return new DailyTestTypoCorrectionResult(true, corrected, applied, true);
    }

    private async Task<IReadOnlyList<DailyTestTypoReplacement>?> RunCliTypoCorrectionAsync(
        string workDir,
        string requestPath,
        string outputPath,
        string donePath,
        string title,
        string statusLabel)
    {
        TryDeleteFile(outputPath);
        TryDeleteFile(donePath);

        string prompt = BuildDailyTestTypoCorrectionCliPrompt(requestPath);
        ActivityLog.Log("DailyTest", $"launch Codex CLI typo correction '{title}' request={requestPath}");
        if (!TryLaunchCodexTerminal(workDir, prompt, title, outputPath, donePath, "medium", statusLabel))
        {
            SetStatus("Failed to launch Codex CLI terminal for typo correction.", true);
            return null;
        }

        _isWaitingCli = true;
        _cliWaitCts?.Cancel();
        _cliWaitCts?.Dispose();
        _cliWaitCts = new CancellationTokenSource(TimeSpan.FromMinutes(TypoCorrectionWaitTimeoutMinutes));
        CancellationToken token = _cliWaitCts.Token;
        DateTime waitStarted = DateTime.Now;

        try
        {
            while (!token.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(2), token);

                if (File.Exists(donePath))
                {
                    if (!File.Exists(outputPath))
                    {
                        SetStatus("AI typo correction finished but no output file was captured.", true);
                        return null;
                    }

                    string raw = await File.ReadAllTextAsync(outputPath, token);
                    IReadOnlyList<DailyTestTypoReplacement>? replacements = ParseTypoReplacements(raw);
                    if (replacements is null)
                    {
                        SetStatus("AI typo correction finished, but the captured output did not contain valid replacement JSON.", true);
                        return null;
                    }

                    TryDeleteFile(requestPath);
                    TryDeleteFile(outputPath);
                    TryDeleteFile(donePath);
                    return replacements;
                }

                TimeSpan elapsed = DateTime.Now - waitStarted;
                SetStatus($"{statusLabel}. Waiting for replacement JSON... {DateTime.Now:HH:mm:ss} / elapsed {elapsed:mm\\:ss}", false);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            SetStatus($"AI typo correction wait was cancelled or exceeded {TypoCorrectionWaitTimeoutMinutes:N0} minutes. Data was not saved.", true);
            return null;
        }
        finally
        {
            _isWaitingCli = false;
        }

        return null;
    }

    private static IReadOnlyList<DailyTestTypoCandidate> BuildTypoCorrectionCandidates(string dataText)
    {
        var order = new List<string>();
        var counts = new Dictionary<string, int>(StringComparer.Ordinal);
        foreach (string line in (dataText ?? "").Replace("\r\n", "\n").Replace('\r', '\n').Split('\n'))
        {
            foreach (string value in ExtractTypoCandidateTexts(line))
            {
                string candidate = NormalizeTypoCandidateText(value);
                if (!ShouldIncludeTypoCandidate(candidate)) continue;

                if (!counts.ContainsKey(candidate))
                {
                    if (order.Count >= TypoCorrectionMaxCandidates) continue;
                    counts[candidate] = 0;
                    order.Add(candidate);
                }
                counts[candidate]++;
            }
        }

        return order
            .Select((text, index) => new DailyTestTypoCandidate(index + 1, text, counts[text]))
            .ToList();
    }

    private static IEnumerable<string> ExtractTypoCandidateTexts(string line)
    {
        string trimmed = (line ?? "").Trim();
        if (string.IsNullOrWhiteSpace(trimmed) || IsTypoStructuralLine(trimmed))
            yield break;

        string[] tabParts = (line ?? "").TrimEnd('\r').Split('\t');
        if (tabParts.Length >= 4
            && LooksLikeExcelAddress(tabParts[0])
            && int.TryParse(tabParts[1], out _)
            && int.TryParse(tabParts[2], out _))
        {
            yield return string.Join("\t", tabParts.Skip(3));
            yield break;
        }

        if (tabParts.Length > 1)
        {
            foreach (string part in tabParts)
                yield return part;
            yield break;
        }

        yield return trimmed;
    }

    private static bool ShouldIncludeTypoCandidate(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return false;
        if (text.Length < 2 || text.Length > TypoCorrectionMaxCandidateChars) return false;
        if (IsTypoStructuralLine(text)) return false;
        if (text.Contains("://", StringComparison.Ordinal) || text.Contains(@":\", StringComparison.Ordinal)) return false;
        if (text.StartsWith("\\\\", StringComparison.Ordinal)) return false;
        if (text.StartsWith("=", StringComparison.Ordinal)) return false;
        if (IsTypoNumericLike(text)) return false;
        if (!text.Any(char.IsLetter)) return false;

        string compact = System.Text.RegularExpressions.Regex.Replace(text, @"[\s._\-/#%+]+", "");
        if (compact.Length <= 5 && System.Text.RegularExpressions.Regex.IsMatch(compact, @"^[A-Za-z0-9]+$"))
            return false;
        if (System.Text.RegularExpressions.Regex.IsMatch(text, @"^(IR|VP|BRS|LOT)[#A-Za-z0-9._\-/ ]+$", System.Text.RegularExpressions.RegexOptions.IgnoreCase))
            return false;
        if (string.Equals(text.Trim(), "obs.", StringComparison.OrdinalIgnoreCase))
            return false;

        int digitCount = text.Count(char.IsDigit);
        if (digitCount > 0 && digitCount >= Math.Max(3, text.Length / 2))
            return false;

        return true;
    }

    private static bool IsTypoStructuralLine(string text)
    {
        string value = (text ?? "").Trim();
        return value.StartsWith("=====", StringComparison.Ordinal)
               || value.StartsWith(XlsxAttachmentPrefix, StringComparison.Ordinal)
               || value.StartsWith("SourceWorkbookPath:", StringComparison.OrdinalIgnoreCase)
               || value.StartsWith("ExtractedTextPath:", StringComparison.OrdinalIgnoreCase)
               || value.StartsWith("RenderedRequestPath:", StringComparison.OrdinalIgnoreCase)
               || value.StartsWith("Sheets:", StringComparison.OrdinalIgnoreCase)
               || value.StartsWith("ReadMode:", StringComparison.OrdinalIgnoreCase)
               || value.StartsWith("MergedCellMode:", StringComparison.OrdinalIgnoreCase)
               || value.StartsWith("File:", StringComparison.OrdinalIgnoreCase)
               || value.StartsWith("## Sheet", StringComparison.OrdinalIgnoreCase)
               || value.Equals("Address\tRow\tColumn\tText", StringComparison.OrdinalIgnoreCase);
    }

    private static bool LooksLikeExcelAddress(string value)
        => System.Text.RegularExpressions.Regex.IsMatch((value ?? "").Trim(), @"^\$?[A-Z]{1,4}\$?\d+$", System.Text.RegularExpressions.RegexOptions.IgnoreCase);

    private static bool IsTypoNumericLike(string text)
    {
        string value = (text ?? "").Trim().Replace(",", "");
        if (string.IsNullOrWhiteSpace(value)) return false;
        if (value.EndsWith("%", StringComparison.Ordinal)) value = value[..^1];
        if (value.StartsWith("(", StringComparison.Ordinal) && value.EndsWith(")", StringComparison.Ordinal))
            value = "-" + value[1..^1];
        return double.TryParse(value, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out _);
    }

    private static string NormalizeTypoCandidateText(string value)
    {
        string text = (value ?? "").Replace('\u00a0', ' ').Trim();
        text = System.Text.RegularExpressions.Regex.Replace(text, @"[ \t]+", " ");
        return text;
    }

    private static string ApplyTypoReplacements(
        string dataText,
        IReadOnlyList<DailyTestTypoReplacement> replacements,
        IReadOnlyList<DailyTestTypoCandidate> candidates,
        out int applied)
    {
        applied = 0;
        if (replacements.Count == 0) return dataText;

        var candidateSet = candidates.Select(c => c.Text).ToHashSet(StringComparer.Ordinal);
        var map = new Dictionary<string, string>(StringComparer.Ordinal);
        foreach (DailyTestTypoReplacement replacement in replacements)
        {
            string original = NormalizeTypoCandidateText(replacement.Original);
            string corrected = NormalizeTypoCandidateText(replacement.Corrected);
            if (string.IsNullOrWhiteSpace(original)
                || string.IsNullOrWhiteSpace(corrected)
                || string.Equals(original, corrected, StringComparison.Ordinal)
                || corrected.Length > TypoCorrectionMaxCandidateChars
                || corrected.Contains('\n')
                || corrected.Contains('\t')
                || !candidateSet.Contains(original))
            {
                continue;
            }

            map[original] = corrected;
        }

        if (map.Count == 0) return dataText;

        int appliedCount = 0;
        string ApplyField(string value)
        {
            string normalized = NormalizeTypoCandidateText(value);
            if (!map.TryGetValue(normalized, out string? corrected)) return value;
            appliedCount++;
            string leading = value[..(value.Length - value.TrimStart().Length)];
            string trailing = value[(value.TrimEnd().Length)..];
            return leading + corrected + trailing;
        }

        var output = new List<string>();
        foreach (string line in (dataText ?? "").Replace("\r\n", "\n").Replace('\r', '\n').Split('\n'))
        {
            string trimmed = line.Trim();
            if (IsTypoStructuralLine(trimmed))
            {
                output.Add(line);
                continue;
            }

            string[] tabParts = line.Split('\t');
            if (tabParts.Length >= 4
                && LooksLikeExcelAddress(tabParts[0])
                && int.TryParse(tabParts[1], out _)
                && int.TryParse(tabParts[2], out _))
            {
                string cellText = string.Join("\t", tabParts.Skip(3));
                string corrected = ApplyField(cellText);
                output.Add(string.Join("\t", tabParts.Take(3).Concat(new[] { corrected })));
                continue;
            }

            if (tabParts.Length > 1)
            {
                output.Add(string.Join("\t", tabParts.Select(ApplyField)));
                continue;
            }

            output.Add(ApplyField(line));
        }

        applied = appliedCount;
        return string.Join(Environment.NewLine, output);
    }

    private long SaveCurrentSnapshotToHistoryIfNeeded()
    {
        if (_selectedId is null || !HasCurrentSnapshot()) return 0;
        if (IsGeneratedCumulativeDataText(_dataText))
            return _history.FirstOrDefault()?.Id ?? 0;

        DailyTestDataHistoryRecord? existing = _history.FirstOrDefault(IsSameSnapshotAsCurrent);
        if (existing is not null) return existing.Id;

        return Repo.SaveDailyTestDataHistory(
            _selectedId.Value,
            _name,
            _dataText,
            _promptText,
            _parametersJson,
            _analysisMarkdown,
            _analysisHtml,
            CurrentSnapshotTime());
    }

    private bool HasCurrentSnapshot()
        => !string.IsNullOrWhiteSpace(_dataText)
           || !string.IsNullOrWhiteSpace(_promptText)
           || !string.IsNullOrWhiteSpace(_analysisMarkdown)
           || !string.IsNullOrWhiteSpace(_analysisHtml);

    private bool IsSameSnapshotAsCurrent(DailyTestDataHistoryRecord h)
        => string.Equals(h.DataText, _dataText, StringComparison.Ordinal)
           && string.Equals(h.PromptText, _promptText, StringComparison.Ordinal)
           && string.Equals(h.ParametersJson, _parametersJson, StringComparison.Ordinal)
           && string.Equals(h.AnalysisMarkdown, _analysisMarkdown, StringComparison.Ordinal)
           && string.Equals(h.AnalysisHtml, _analysisHtml, StringComparison.Ordinal);

    private string CurrentSnapshotTime()
    {
        if (!string.IsNullOrWhiteSpace(_htmlGeneratedAt)) return _htmlGeneratedAt;
        if (!string.IsNullOrWhiteSpace(_analyzedAt)) return _analyzedAt;
        return DateTime.UtcNow.ToString("o");
    }

    private async Task OnAddDataXlsxSelected(InputFileChangeEventArgs e)
    {
        if (_selectedId is null || _isBusy) return;
        if (_viewingHistory) ReturnToCurrent();

        bool attached = await AttachXlsxFilesAsync(e, prepareAddedDataSlot: true, autoAnalyzeAfterAttach: true);
        if (!attached || _selectedId is null || _isBusy || _viewingHistory) return;

        SetStatus("Added data attached. Starting AI analysis and cumulative HTML update.", false);
        await InvokeAsync(StateHasChanged);
        await AnalyzeAsync();
    }

    private async Task OnXlsxSelected(InputFileChangeEventArgs e)
    {
        await AttachXlsxFilesAsync(e, prepareAddedDataSlot: false, autoAnalyzeAfterAttach: false);
    }

    private async Task<bool> AttachXlsxFilesAsync(
        InputFileChangeEventArgs e,
        bool prepareAddedDataSlot,
        bool autoAnalyzeAfterAttach)
    {
        if (_selectedId is null || _isBusy || _viewingHistory) return false;

        IReadOnlyList<IBrowserFile> files;
        try
        {
            files = e.GetMultipleFiles(MaxXlsxUploadFiles);
        }
        catch (Exception ex)
        {
            SetStatus($"Select up to {MaxXlsxUploadFiles:N0} Excel files at once. {ex.Message}", true);
            return false;
        }

        if (files.Count == 0) return false;

        List<string> invalidFiles = files
            .Where(file =>
            {
                string lower = file.Name.ToLowerInvariant();
                return !IsSupportedExcelFileName(lower);
            })
            .Select(file => file.Name)
            .ToList();
        if (invalidFiles.Count > 0)
        {
            string invalid = string.Join(", ", invalidFiles.Take(5));
            if (invalidFiles.Count > 5) invalid += $", +{invalidFiles.Count - 5:N0} more";
            SetStatus($"Only .xlsx, .xlsm, .xlsb, or .xls files can be attached. Invalid: {invalid}", true);
            return false;
        }

        if (prepareAddedDataSlot)
        {
            bool prepared = await PrepareNewInputForAddedDataAsync();
            if (!prepared) return false;
        }

        _isBusy = true;
        SetStatus(autoAnalyzeAfterAttach
            ? $"Attaching {files.Count:N0} added Excel file(s). AI analysis will start automatically."
            : $"Attaching {files.Count:N0} Excel file(s). Excel COM extraction will run when AI Analyze starts.", false);
        StateHasChanged();

        try
        {
            string workDir = FindRepoRoot();
            string attachDir = Path.Combine(workDir, "tmp", "daily-test-data", _selectedId.Value.ToString());
            Directory.CreateDirectory(attachDir);

            var attachmentMarkers = new List<string>();
            for (int i = 0; i < files.Count; i++)
            {
                var file = files[i];
                SetStatus($"Attaching Excel file {i + 1:N0}/{files.Count:N0}: {file.Name}", false);
                await InvokeAsync(StateHasChanged);

                string storedName = $"{DateTime.UtcNow:yyyyMMddHHmmss}_{Guid.NewGuid():N}_{SafeFileName(file.Name)}";
                string storedPath = Path.Combine(attachDir, storedName);

                await using (var src = file.OpenReadStream(MaxXlsxUploadBytes))
                await using (var dst = File.Create(storedPath))
                {
                    await src.CopyToAsync(dst);
                }

                attachmentMarkers.Add(BuildAttachmentMarker(file.Name, storedPath));
                ActivityLog.Log("DailyTest", $"attach excel '{file.Name}' to '{_name}' path={storedPath}");
            }

            string markerBlock = string.Join(Environment.NewLine, attachmentMarkers);
            _dataText = string.IsNullOrWhiteSpace(_dataText)
                ? markerBlock
                : _dataText.TrimEnd() + Environment.NewLine + markerBlock;

            Repo.UpdateDailyTestDataItem(_selectedId.Value, _name, _dataText, _promptText);
            ReloadItems();
            string attached = string.Join(", ", files.Select(file => file.Name).Take(5));
            if (files.Count > 5) attached += $", +{files.Count - 5:N0} more";
            SetStatus(autoAnalyzeAfterAttach
                ? $"Attached {files.Count:N0} added Excel file(s). Starting AI Analyze: {attached}"
                : $"Attached {files.Count:N0} Excel file(s). Click AI Analyze to run Excel COM extraction: {attached}", false);
            return true;
        }
        catch (Exception ex)
        {
            SetStatus($"Excel attach failed: {ex.Message}", true);
            return false;
        }
        finally
        {
            _isBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ConvertLegacyXlsxAttachmentsToExcelComExtractsAsync(DailyTestExtractionSettingsSnapshot extractionSettings)
    {
        if (_selectedId is null || !_dataText.Contains(XlsxAttachmentPrefix, StringComparison.Ordinal))
            return;
        if (DailyTestExtractionModes.IsSavedExtractText(extractionSettings.ExtractionMode))
            return;

        List<XlsxAttachment> files = ExtractAttachedXlsxFiles(_dataText);
        if (files.Count == 0) return;

        var preservedLines = _dataText
            .Replace("\r\n", "\n")
            .Replace('\r', '\n')
            .Split('\n')
            .Where(line => !line.TrimEnd().StartsWith(XlsxAttachmentPrefix, StringComparison.Ordinal))
            .Select(line => line.TrimEnd())
            .ToList();

        var extractBlocks = new List<string>();
        for (int i = 0; i < files.Count; i++)
        {
            XlsxAttachment file = files[i];
            SetStatus($"Excel COM extracting legacy attachment {i + 1:N0}/{files.Count:N0}: {file.FileName}", false);
            await InvokeAsync(StateHasChanged);

            var progress = new Progress<string>(message =>
            {
                SetStatus($"Excel COM extracting legacy attachment {i + 1:N0}/{files.Count:N0}: {file.FileName} - {message}", false);
                _ = InvokeAsync(StateHasChanged);
            });
            InputDataTestBatchExtractResult extracted = await ExcelComExtractor.ExtractFileAsync(
                file.Path,
                _name,
                renderImages: false,
                progress: progress,
                maxProgramCellsPerSheet: extractionSettings.MaxProgramCellsPerSheet);
            string extractedText = File.Exists(extracted.ExtractedTextPath)
                ? await File.ReadAllTextAsync(extracted.ExtractedTextPath, System.Text.Encoding.UTF8)
                : File.Exists(extracted.StructureTextPath)
                    ? await File.ReadAllTextAsync(extracted.StructureTextPath, System.Text.Encoding.UTF8)
                    : "";

            extractBlocks.Add(BuildExcelComExtractBlock(file.FileName, file.Path, extracted, extractedText));
            ActivityLog.Log("DailyTest", $"excel com extract legacy attachment '{file.FileName}' to '{_name}' path={file.Path} cells={extracted.CellCount}");
        }

        string preserved = string.Join(Environment.NewLine, preservedLines).Trim();
        string extractedBlock = string.Join(Environment.NewLine + Environment.NewLine, extractBlocks);
        _dataText = string.IsNullOrWhiteSpace(preserved)
            ? extractedBlock
            : preserved + Environment.NewLine + Environment.NewLine + extractedBlock;

        Repo.UpdateDailyTestDataItem(_selectedId.Value, _name, _dataText, _promptText);
        ReloadItems();
        SetStatus($"Converted {files.Count:N0} legacy XLSX attachment(s) to Excel COM extracted text.", false);
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshLimitedExcelComExtractsAsync(string workDir, long itemId, DailyTestExtractionSettingsSnapshot extractionSettings)
    {
        if (_selectedId is null
            || string.IsNullOrWhiteSpace(_dataText)
            || !_dataText.Contains("EXCEL COM EXTRACT", StringComparison.OrdinalIgnoreCase))
            return;
        if (DailyTestExtractionModes.IsSavedExtractText(extractionSettings.ExtractionMode)
            || DailyTestSavedExtractRefreshModes.IsNever(extractionSettings.SavedExtractRefreshMode))
            return;

        var rx = new System.Text.RegularExpressions.Regex(
            @"^=+\s*EXCEL COM EXTRACT:\s*(?<name>.*?)\s*=+\s*\r?\n(?<body>.*?)(?:\r?\n)=+\s*END EXCEL COM EXTRACT:\s*.*?\s*=+\s*$",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase
            | System.Text.RegularExpressions.RegexOptions.Multiline
            | System.Text.RegularExpressions.RegexOptions.Singleline);
        var matches = rx.Matches(_dataText);
        if (matches.Count == 0) return;

        var refreshed = new System.Text.StringBuilder();
        int position = 0;
        int refreshedCount = 0;

        foreach (System.Text.RegularExpressions.Match match in matches)
        {
            refreshed.Append(_dataText, position, match.Index - position);
            position = match.Index + match.Length;

            string block = match.Value;
            if (!ShouldRefreshExcelComExtractBlock(block, extractionSettings, out string sourceWorkbookPath, out int cellCount))
            {
                refreshed.Append(block);
                continue;
            }

            string fileName = match.Groups["name"].Value.Trim();
            SetStatus($"Excel COM re-extracting limited extract ({cellCount:N0} cells): {fileName}", false);
            await InvokeAsync(StateHasChanged);

            try
            {
                var progress = new Progress<string>(message =>
                {
                    SetStatus($"Excel COM re-extracting limited extract: {fileName} - {message}", false);
                    _ = InvokeAsync(StateHasChanged);
                });
                InputDataTestBatchExtractResult extracted = await ExcelComExtractor.ExtractFileAsync(
                    sourceWorkbookPath,
                    _name,
                    renderImages: false,
                    progress: progress,
                    maxProgramCellsPerSheet: extractionSettings.MaxProgramCellsPerSheet);
                string extractedText = File.Exists(extracted.ExtractedTextPath)
                    ? await File.ReadAllTextAsync(extracted.ExtractedTextPath, System.Text.Encoding.UTF8)
                    : File.Exists(extracted.StructureTextPath)
                        ? await File.ReadAllTextAsync(extracted.StructureTextPath, System.Text.Encoding.UTF8)
                        : "";

                refreshed.Append(BuildExcelComExtractBlock(fileName, sourceWorkbookPath, extracted, extractedText));
                refreshedCount++;
                ActivityLog.Log("DailyTest", $"re-extract limited excel com block '{fileName}' cells {cellCount}->{extracted.CellCount} path={sourceWorkbookPath}");
            }
            catch (Exception ex)
            {
                refreshed.Append(block);
                ActivityLog.Log("DailyTest", $"re-extract limited excel com block failed '{fileName}': {ex.Message}");
                SetStatus($"Excel COM re-extract skipped for {fileName}: {ex.Message}", true);
            }
        }

        refreshed.Append(_dataText, position, _dataText.Length - position);
        if (refreshedCount == 0) return;

        _dataText = refreshed.ToString().TrimEnd();
        Repo.UpdateDailyTestDataItem(itemId, _name, _dataText, _promptText);
        if (IsGeneratedCumulativeDataText(_dataText))
            SaveCumulativeStore(workDir, itemId, _dataText, _promptText);
        ReloadItems();
        SetStatus($"Re-extracted {refreshedCount:N0} limited Excel COM extract block(s) with the current cell limit.", false);
        await InvokeAsync(StateHasChanged);
    }

    private static bool ShouldRefreshExcelComExtractBlock(
        string block,
        DailyTestExtractionSettingsSnapshot extractionSettings,
        out string sourceWorkbookPath,
        out int cellCount)
    {
        sourceWorkbookPath = FirstRegexGroup(block, @"^SourceWorkbookPath:\s*(.+)$");
        cellCount = 0;
        if (string.IsNullOrWhiteSpace(sourceWorkbookPath) || !File.Exists(sourceWorkbookPath))
            return false;

        var meta = System.Text.RegularExpressions.Regex.Match(
            block,
            @"^Sheets:\s*\d+\s*,\s*Rows:\s*\d+\s*,\s*Cells:\s*([0-9,]+)\s*,\s*Images:\s*\d+",
            System.Text.RegularExpressions.RegexOptions.Multiline);
        if (!meta.Success) return false;

        cellCount = ParseInt(meta.Groups[1].Value);
        if (cellCount <= 0) return false;
        if (DailyTestSavedExtractRefreshModes.IsRefreshAll(extractionSettings.SavedExtractRefreshMode))
            return true;
        return cellCount <= DailyTestExtractionSettingsService.LegacyLimitedCellThreshold;
    }

    private async Task AnalyzeAsync()
    {
        if (_selectedId is null) return;
        if (!HasAnalysisRequest)
        {
            SetStatus("Input Data, XLSX attachment, or Prompt is required.", true);
            return;
        }
        if (!AiProviders.CodexCliEnabled)
        {
            SetStatus(AiProviders.ProviderDisabledMessage("Codex CLI"), true);
            return;
        }
        _extractionSettings = DailyTestExtractionSettingsService.Normalize(_extractionSettings);
        ExtractionSettings.Save(_extractionSettings);
        DailyTestExtractionSettingsSnapshot extractionSettings = _extractionSettings;
        if (DailyTestExtractionModes.IsSavedExtractText(extractionSettings.ExtractionMode)
            && _dataText.Contains(XlsxAttachmentPrefix, StringComparison.Ordinal))
        {
            SetStatus("Extraction mode is 'Saved extract text only', but this item still has XLSX attachment markers. Switch to Excel COM extraction or run extraction first.", true);
            return;
        }

        _isBusy = true;
        _isWaitingCli = false;
        _status = "";
        StateHasChanged();

        try
        {
            long itemId = _selectedId.Value;
            string workDir = FindRepoRoot();
            string tmpDir = Path.Combine(workDir, "tmp");
            Directory.CreateDirectory(tmpDir);
            StartDailyTestStatusConsole(workDir, itemId, _name);
            WriteDailyTestConsoleStatus($"AI Analyze clicked for '{_name}'.", false);

            await ConvertLegacyXlsxAttachmentsToExcelComExtractsAsync(extractionSettings);
            await RefreshLimitedExcelComExtractsAsync(workDir, itemId, extractionSettings);
            Repo.UpdateDailyTestDataItem(itemId, _name, _dataText, _promptText);

            DateTime startedUtc = DateTime.UtcNow;
            var savedItem = Repo.GetDailyTestDataItem(itemId);
            string existingParametersJson = string.IsNullOrWhiteSpace(savedItem?.ParametersJson)
                ? _parametersJson
                : savedItem.ParametersJson;
            string existingAnalysisMarkdown = savedItem?.AnalysisMarkdown ?? _analysisMarkdown;
            string existingAnalysisHtml = savedItem?.AnalysisHtml ?? _analysisHtml;
            string existingAnalysisAt = string.IsNullOrWhiteSpace(savedItem?.HtmlGeneratedAt)
                ? savedItem?.AnalyzedAt ?? (string.IsNullOrWhiteSpace(_htmlGeneratedAt) ? _analyzedAt : _htmlGeneratedAt)
                : savedItem.HtmlGeneratedAt;
            string currentDataText = IsGeneratedCumulativeDataText(_dataText) ? "" : _dataText;
            if (!IsMeaningfulCurrentInputData(currentDataText))
                currentDataText = "";
            if (!string.IsNullOrWhiteSpace(currentDataText))
            {
                var correction = await CorrectDailyTestDataTextTyposIfNeededAsync(
                    workDir,
                    tmpDir,
                    itemId,
                    _name,
                    currentDataText,
                    "added data analysis save");
                if (!correction.Succeeded) return;
                if (!string.Equals(correction.DataText, currentDataText, StringComparison.Ordinal))
                {
                    currentDataText = correction.DataText;
                    _dataText = currentDataText;
                    Repo.UpdateDailyTestDataItem(itemId, _name, _dataText, _promptText);
                }
            }
            string currentPromptText = IsGeneratedCumulativePromptText(_promptText) ? "" : _promptText;
            List<XlsxAttachment> xlsxFiles = ExtractAttachedXlsxFiles(currentDataText);
            ReloadHistory();
            List<DailyTestPriorSnapshot> priorSnapshots = BuildPriorSnapshotsForAnalysis(currentDataText);
            DailyTestCumulativeStore cumulativeStore = LoadOrSeedCumulativeStore(
                workDir,
                itemId,
                savedItem?.DataText ?? _dataText,
                savedItem?.PromptText ?? _promptText,
                priorSnapshots);
            string canonicalCumulativeDataText = cumulativeStore.DataText;
            string canonicalCumulativePromptText = cumulativeStore.PromptText;

            if (IsDuplicateCurrentData(currentDataText, priorSnapshots)
                || ContainsNormalizedBlock(canonicalCumulativeDataText, currentDataText))
            {
                currentDataText = "";
                xlsxFiles = [];
                if (IsDuplicateCurrentPrompt(currentPromptText, priorSnapshots)
                    || ContainsNormalizedBlock(canonicalCumulativePromptText, currentPromptText))
                    currentPromptText = "";
            }

            bool standaloneHtmlRequested = WantsStandaloneDailyTestHtml(currentPromptText)
                                           || WantsStandaloneDailyTestHtml(canonicalCumulativePromptText);
            DailyTestAiResult? addedResult = null;
            long addedHistoryId = 0;
            string standaloneHtmlOutputPath = "";
            bool seedItemWithFirstHistoryResult = priorSnapshots.Count == 0
                                                  && string.IsNullOrWhiteSpace(existingAnalysisMarkdown)
                                                  && string.IsNullOrWhiteSpace(existingAnalysisHtml);
            if (!string.IsNullOrWhiteSpace(currentDataText))
            {
                addedResult = await TryRecoverCompletedCurrentInputAnalysisAsync(
                    tmpDir,
                    itemId,
                    currentDataText,
                    currentPromptText);
                if (addedResult is null)
                {
                    string addedRunId = Guid.NewGuid().ToString("N")[..12];
                    string addedRequestPath = Path.Combine(tmpDir, $"daily_test_analysis_request_added_{addedRunId}.json");
                    string addedOutputPath = Path.Combine(tmpDir, $"daily_test_analysis_output_added_{addedRunId}.txt");
                    string addedDonePath = Path.Combine(tmpDir, $"daily_test_analysis_done_added_{addedRunId}.json");
                    string addedPrompt = BuildCurrentInputAnalysisPrompt(priorSnapshots, xlsxFiles, currentDataText, currentPromptText,
                        existingAnalysisMarkdown, existingAnalysisHtml, existingAnalysisAt);
                    WriteDailyTestAnalysisRequest(addedRequestPath, addedRunId, startedUtc, itemId,
                        _name, currentDataText, currentPromptText, existingParametersJson,
                        existingAnalysisMarkdown, existingAnalysisHtml, existingAnalysisAt, addedPrompt, xlsxFiles,
                        priorSnapshots, priorSnapshots.LastOrDefault(), "current_input_analysis", null,
                        canonicalCumulativeDataText, canonicalCumulativePromptText,
                        ExtractAttachedXlsxFiles(canonicalCumulativeDataText), true);

                    addedResult = await RunCliAnalysisAsync(workDir, addedRequestPath, addedOutputPath, addedDonePath,
                        $"Daily Test Data added ({_name})", "Analyzing added data");
                }
                if (addedResult is null) return;

                string historyParameters = string.IsNullOrWhiteSpace(addedResult.HistoryParametersJson)
                    ? addedResult.ParametersJson
                    : addedResult.HistoryParametersJson;
                string historyMarkdown = string.IsNullOrWhiteSpace(addedResult.HistoryAnalysisMarkdown)
                    ? addedResult.AnalysisMarkdown
                    : addedResult.HistoryAnalysisMarkdown;
                string historyHtml = string.IsNullOrWhiteSpace(addedResult.HistoryAnalysisHtml)
                    ? addedResult.AnalysisHtml
                    : addedResult.HistoryAnalysisHtml;

                string historyCreatedAt = DateTime.UtcNow.ToString("o");
                addedHistoryId = Repo.SaveDailyTestDataHistory(itemId, _name, currentDataText,
                    currentPromptText, historyParameters, historyMarkdown, historyHtml, historyCreatedAt);
                _activeHistoryId = addedHistoryId;
                canonicalCumulativeDataText = AppendUniqueCumulativeDataSegment(
                    canonicalCumulativeDataText,
                    addedHistoryId,
                    historyCreatedAt,
                    currentDataText);
                canonicalCumulativePromptText = AppendUniqueCumulativePromptSegment(
                    canonicalCumulativePromptText,
                    addedHistoryId,
                    historyCreatedAt,
                    currentPromptText);
                SaveCumulativeStore(workDir, itemId, canonicalCumulativeDataText, canonicalCumulativePromptText);
                if (seedItemWithFirstHistoryResult)
                {
                    Repo.SaveDailyTestDataAnalysisResult(itemId, canonicalCumulativeDataText, canonicalCumulativePromptText,
                        addedResult.ParametersJson, addedResult.AnalysisMarkdown, addedResult.AnalysisHtml);
                    standaloneHtmlOutputPath = TryWriteRequestedStandaloneHtmlFile(canonicalCumulativePromptText, currentPromptText, addedResult.AnalysisHtml);
                }
                ReloadHistory();
                priorSnapshots = BuildPriorSnapshotsForAnalysis("");
                currentDataText = "";
                currentPromptText = "";
                xlsxFiles = [];

                if (!string.IsNullOrWhiteSpace(canonicalCumulativeDataText))
                {
                    Repo.UpdateDailyTestDataItem(itemId, _name, canonicalCumulativeDataText, canonicalCumulativePromptText);
                }

                if (seedItemWithFirstHistoryResult)
                {
                    var seededItem = Repo.GetDailyTestDataItem(itemId);
                    if (seededItem is null)
                    {
                        SetStatus("Initial item report saved, but the item could not be reloaded.", true);
                        return;
                    }

                    _name = seededItem.Name;
                    _dataText = seededItem.DataText;
                    _promptText = seededItem.PromptText;
                    _parametersJson = string.IsNullOrWhiteSpace(seededItem.ParametersJson) ? "{}" : seededItem.ParametersJson;
                    _analysisMarkdown = seededItem.AnalysisMarkdown;
                    _analysisHtml = seededItem.AnalysisHtml;
                    _analyzedAt = seededItem.AnalyzedAt;
                    _htmlGeneratedAt = seededItem.HtmlGeneratedAt;
                    _activeHistoryId = addedHistoryId == 0 ? null : addedHistoryId;
                    _viewingHistory = false;
                    ReloadItems();
                    ReloadHistory();

                    string initialStatus = "Added-data history analysis saved as the initial cumulative item report.";
                    if (!string.IsNullOrWhiteSpace(standaloneHtmlOutputPath))
                        initialStatus += $" Standalone HTML file written: {standaloneHtmlOutputPath}";
                    SetStatus(initialStatus, false);
                    return;
                }

                string addedParametersForBuilder = string.IsNullOrWhiteSpace(addedResult.HistoryParametersJson)
                    ? addedResult.ParametersJson
                    : addedResult.HistoryParametersJson;
                if (!standaloneHtmlRequested
                    && DailyTestReportBuilder.HasBuilderSpec(existingParametersJson)
                    && DailyTestReportBuilder.TryMergeParameters(existingParametersJson, addedParametersForBuilder, out string mergedParametersJson)
                    && DailyTestReportBuilder.TryRenderHtml(mergedParametersJson, out string programBuiltHtml))
                {
                    string programBuiltMarkdown = HtmlToContextText(programBuiltHtml);
                    SaveCumulativeStore(workDir, itemId, canonicalCumulativeDataText, canonicalCumulativePromptText);
                    Repo.SaveDailyTestDataAnalysisResult(itemId, canonicalCumulativeDataText, canonicalCumulativePromptText,
                        mergedParametersJson, programBuiltMarkdown, programBuiltHtml);

                    var rebuiltItem = Repo.GetDailyTestDataItem(itemId);
                    if (rebuiltItem is null)
                    {
                        SetStatus("Program-built report saved, but the item could not be reloaded.", true);
                        return;
                    }

                    _name = rebuiltItem.Name;
                    _dataText = rebuiltItem.DataText;
                    _promptText = rebuiltItem.PromptText;
                    _parametersJson = string.IsNullOrWhiteSpace(rebuiltItem.ParametersJson) ? "{}" : rebuiltItem.ParametersJson;
                    _analysisMarkdown = rebuiltItem.AnalysisMarkdown;
                    _analysisHtml = rebuiltItem.AnalysisHtml;
                    _analyzedAt = rebuiltItem.AnalyzedAt;
                    _htmlGeneratedAt = rebuiltItem.HtmlGeneratedAt;
                    _activeHistoryId = addedHistoryId == 0 ? null : addedHistoryId;
                    _viewingHistory = false;
                    ReloadItems();
                    ReloadHistory();
                    SetStatus("Added-data history analysis saved, then cumulative HTML was rebuilt by the saved HTML Maker.", false);
                    return;
                }

                var blockedReasons = new List<string>();
                if (standaloneHtmlRequested)
                    blockedReasons.Add("standalone HTML output was requested");
                if (!HasReusableDailyTestParameters(existingParametersJson))
                    blockedReasons.Add("existing item parametersJson is not merge-ready");
                if (!HasReusableDailyTestParameters(addedParametersForBuilder))
                    blockedReasons.Add("added-data parametersJson is not merge-ready");
                if (!DailyTestReportBuilder.HasBuilderSpec(existingParametersJson))
                    blockedReasons.Add("existing item has no saved HTML Maker spec");
                else if (!DailyTestReportBuilder.TryMergeParameters(existingParametersJson, addedParametersForBuilder, out string blockedMergedParametersJson))
                    blockedReasons.Add("parameter merge failed");
                else if (!DailyTestReportBuilder.TryRenderHtml(blockedMergedParametersJson, out _))
                    blockedReasons.Add("HTML Maker render failed");

                string reasonText = blockedReasons.Count == 0
                    ? "program merge did not produce a report"
                    : string.Join("; ", blockedReasons.Distinct(StringComparer.OrdinalIgnoreCase));
                SetStatus($"Added-data AI analysis was saved, but cumulative AI rebuild was skipped to avoid re-analyzing existing data. Fix the saved parameters/HTML Maker spec, then rebuild by program merge. Reason: {reasonText}.", true);
                return;
            }

            string fullRunId = Guid.NewGuid().ToString("N")[..12];
            string fullRequestPath = Path.Combine(tmpDir, $"daily_test_analysis_request_full_{fullRunId}.json");
            string fullOutputPath = Path.Combine(tmpDir, $"daily_test_analysis_output_full_{fullRunId}.txt");
            string fullDonePath = Path.Combine(tmpDir, $"daily_test_analysis_done_full_{fullRunId}.json");
            string cumulativeDataText = string.IsNullOrWhiteSpace(currentDataText)
                ? canonicalCumulativeDataText
                : AppendUniqueCumulativeDataSegment(canonicalCumulativeDataText, 0, "", currentDataText);
            string cumulativePromptText = AppendUniqueCumulativePromptSegment(
                canonicalCumulativePromptText,
                0,
                "",
                currentPromptText);
            IReadOnlyList<XlsxAttachment> cumulativeXlsxFiles = ExtractAttachedXlsxFiles(cumulativeDataText);
            bool aggregateOnlyCumulativeUpdate = addedResult is not null
                                                  && HasReusableDailyTestParameters(existingParametersJson)
                                                  && HasReusableDailyTestParameters(addedResult.ParametersJson);
            string requestCumulativeDataText = aggregateOnlyCumulativeUpdate ? "" : cumulativeDataText;
            IReadOnlyList<XlsxAttachment> requestCumulativeXlsxFiles = aggregateOnlyCumulativeUpdate
                ? Array.Empty<XlsxAttachment>()
                : cumulativeXlsxFiles;
            if (string.IsNullOrWhiteSpace(cumulativeDataText)
                && cumulativeXlsxFiles.Count == 0
                && !aggregateOnlyCumulativeUpdate)
            {
                SetStatus("Prompt-only analysis needs saved data/history or an attached XLSX workbook.", true);
                return;
            }

            bool promptOnlyReanalysis = string.IsNullOrWhiteSpace(currentDataText)
                                        && !string.IsNullOrWhiteSpace(currentPromptText);
            string fullPrompt = BuildCumulativeUpdatePrompt(priorSnapshots, xlsxFiles, currentDataText, currentPromptText,
                existingAnalysisMarkdown, existingAnalysisHtml, existingAnalysisAt, addedResult,
                requestCumulativeDataText, cumulativePromptText, requestCumulativeXlsxFiles, true,
                aggregateOnlyCumulativeUpdate);
            WriteDailyTestAnalysisRequest(fullRequestPath, fullRunId, startedUtc, itemId,
                _name, currentDataText, currentPromptText, existingParametersJson,
                existingAnalysisMarkdown, existingAnalysisHtml, existingAnalysisAt, fullPrompt, xlsxFiles,
                priorSnapshots, priorSnapshots.LastOrDefault(), "cumulative_update", addedResult,
                requestCumulativeDataText, cumulativePromptText, requestCumulativeXlsxFiles, true);

            DailyTestAiResult? fullResult = await RunCliAnalysisAsync(workDir, fullRequestPath, fullOutputPath, fullDonePath,
                $"Daily Test Data full ({_name})", "Updating cumulative report");
            if (fullResult is null) return;

            string itemDataText = string.IsNullOrWhiteSpace(cumulativeDataText)
                ? currentDataText
                : cumulativeDataText;
            string itemPromptText = string.IsNullOrWhiteSpace(cumulativePromptText)
                ? currentPromptText
                : cumulativePromptText;

            SaveCumulativeStore(workDir, itemId, itemDataText, itemPromptText);
            Repo.SaveDailyTestDataAnalysisResult(itemId, itemDataText, itemPromptText,
                fullResult.ParametersJson, fullResult.AnalysisMarkdown, fullResult.AnalysisHtml);
            standaloneHtmlOutputPath = TryWriteRequestedStandaloneHtmlFile(itemPromptText, fullPrompt, fullResult.AnalysisHtml);

            var item = Repo.GetDailyTestDataItem(itemId);
            if (item is null)
            {
                SetStatus("Analysis saved, but the item could not be reloaded.", true);
                return;
            }

            _name = item.Name;
            _dataText = item.DataText;
            _promptText = item.PromptText;
            _parametersJson = string.IsNullOrWhiteSpace(item.ParametersJson) ? "{}" : item.ParametersJson;
            _analysisMarkdown = item.AnalysisMarkdown;
            _analysisHtml = item.AnalysisHtml;
            _analyzedAt = item.AnalyzedAt;
            _htmlGeneratedAt = item.HtmlGeneratedAt;
            _activeHistoryId = addedHistoryId == 0 ? null : addedHistoryId;
            _viewingHistory = false;
            ReloadItems();
            ReloadHistory();
            string statusMessage = addedHistoryId == 0
                ? promptOnlyReanalysis
                    ? "Prompt-only cumulative item report updated."
                    : "Cumulative item report updated."
                : "Added-data history analysis saved, then cumulative item report updated.";
            if (!string.IsNullOrWhiteSpace(standaloneHtmlOutputPath))
                statusMessage += $" Standalone HTML file written: {standaloneHtmlOutputPath}";
            SetStatus(statusMessage, false);
        }
        catch (Exception ex)
        {
            SetStatus($"Analysis failed: {ex.Message}", true);
        }
        finally
        {
            CompleteDailyTestStatusConsole(
                string.IsNullOrWhiteSpace(_status) ? "Daily Test Data AI Analyze ended." : _status,
                _statusError);
            _cliWaitCts?.Dispose();
            _cliWaitCts = null;
            _isWaitingCli = false;
            _isBusy = false;
            StateHasChanged();
        }
    }

    private async Task<DailyTestAiResult?> RunCliAnalysisAsync(
        string workDir,
        string requestPath,
        string outputPath,
        string donePath,
        string title,
        string statusLabel)
    {
        TryDeleteFile(outputPath);
        TryDeleteFile(donePath);

        string prompt = BuildDailyTestCliPrompt(requestPath);
        ActivityLog.Log("DailyTest", $"launch Codex CLI '{title}' request={requestPath}");
        if (!TryLaunchCodexTerminal(workDir, prompt, title, outputPath, donePath, "xhigh", statusLabel))
        {
            SetStatus("Failed to launch Codex CLI terminal.", true);
            return null;
        }

        _isWaitingCli = true;
        _cliWaitCts?.Cancel();
        _cliWaitCts?.Dispose();
        _cliWaitCts = new CancellationTokenSource(TimeSpan.FromMinutes(DailyTestCliWaitTimeoutMinutes));
        CancellationToken token = _cliWaitCts.Token;
        DateTime waitStarted = DateTime.Now;

        try
        {
            while (!token.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(2), token);

                if (File.Exists(donePath))
                {
                    if (!File.Exists(outputPath))
                    {
                        SetStatus($"{statusLabel} finished but no output file was captured.", true);
                        return null;
                    }

                    string raw = await File.ReadAllTextAsync(outputPath, token);
                    var result = ParseAiResult(raw);
                    if (string.IsNullOrWhiteSpace(result.AnalysisHtml))
                    {
                        SetStatus($"{statusLabel} finished, but the captured output did not contain valid HTML.", true);
                        return null;
                    }

                    TryDeleteFile(requestPath);
                    TryDeleteFile(outputPath);
                    TryDeleteFile(donePath);
                    return result;
                }

                TimeSpan elapsed = DateTime.Now - waitStarted;
                SetStatus($"{statusLabel}. Waiting for captured HTML... {DateTime.Now:HH:mm:ss} / elapsed {elapsed:mm\\:ss}", false);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            SetStatus($"{statusLabel} wait was cancelled or exceeded {DailyTestCliWaitTimeoutMinutes:N0} minutes. The Codex CLI terminal may still finish; click AI Analyze again to recover a completed output if one exists.", true);
            return null;
        }

        return null;
    }

    private async Task<DailyTestAiResult?> TryRecoverCompletedCurrentInputAnalysisAsync(
        string tmpDir,
        long itemId,
        string currentDataText,
        string currentPromptText)
    {
        if (!Directory.Exists(tmpDir)) return null;

        const string requestPrefix = "daily_test_analysis_request_added_";
        foreach (string requestPath in Directory.EnumerateFiles(tmpDir, $"{requestPrefix}*.json")
                     .OrderByDescending(File.GetLastWriteTimeUtc))
        {
            string requestName = Path.GetFileNameWithoutExtension(requestPath);
            if (!requestName.StartsWith(requestPrefix, StringComparison.Ordinal)) continue;

            string runId = requestName[requestPrefix.Length..];
            string outputPath = Path.Combine(tmpDir, $"daily_test_analysis_output_added_{runId}.txt");
            string donePath = Path.Combine(tmpDir, $"daily_test_analysis_done_added_{runId}.json");
            if (!File.Exists(outputPath) || !File.Exists(donePath)) continue;
            if (!IsMatchingCurrentInputRequest(requestPath, itemId, currentDataText, currentPromptText)) continue;

            string raw = await File.ReadAllTextAsync(outputPath);
            DailyTestAiResult result = ParseAiResult(raw);
            if (string.IsNullOrWhiteSpace(result.AnalysisHtml))
            {
                continue;
            }

            TryDeleteFile(requestPath);
            TryDeleteFile(outputPath);
            TryDeleteFile(donePath);
            SetStatus("Recovered completed added-data Codex output. Continuing cumulative report update.", false);
            await InvokeAsync(StateHasChanged);
            return result;
        }

        return null;
    }

    private static bool IsMatchingCurrentInputRequest(
        string requestPath,
        long itemId,
        string currentDataText,
        string currentPromptText)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(File.ReadAllText(requestPath));
            var root = doc.RootElement;
            if (root.ValueKind != System.Text.Json.JsonValueKind.Object) return false;
            if (!root.TryGetProperty("itemId", out var idEl) || idEl.GetInt64() != itemId) return false;
            if (!string.Equals(JsonString(root, "workflowPhase"), "current_input_analysis", StringComparison.Ordinal))
                return false;

            string requestData = JsonString(root, "dataText");
            string requestPrompt = JsonString(root, "promptText");
            string requestDataHash = JsonString(root, "dataTextHash");
            if (root.TryGetProperty("currentInput", out var inputEl)
                && inputEl.ValueKind == System.Text.Json.JsonValueKind.Object)
            {
                if (string.IsNullOrWhiteSpace(requestData)) requestData = JsonString(inputEl, "dataText");
                if (string.IsNullOrWhiteSpace(requestPrompt)) requestPrompt = JsonString(inputEl, "promptText");
                if (string.IsNullOrWhiteSpace(requestDataHash)) requestDataHash = JsonString(inputEl, "dataTextHash");
            }

            bool dataMatches = string.IsNullOrWhiteSpace(requestData) && !string.IsNullOrWhiteSpace(requestDataHash)
                ? string.Equals(requestDataHash, SnapshotDataHash(currentDataText), StringComparison.Ordinal)
                : string.Equals(SnapshotDataKey(requestData), SnapshotDataKey(currentDataText), StringComparison.Ordinal);
            return dataMatches
                   && string.Equals(SnapshotPromptKey(requestPrompt), SnapshotPromptKey(currentPromptText), StringComparison.Ordinal);
        }
        catch
        {
            return false;
        }
    }

    private static string JsonString(System.Text.Json.JsonElement root, string name)
    {
        if (!root.TryGetProperty(name, out var value)) return "";
        return value.ValueKind == System.Text.Json.JsonValueKind.String
            ? value.GetString() ?? ""
            : value.ToString();
    }

    private void CancelCliWait()
    {
        try { _cliWaitCts?.Cancel(); } catch { }
        _isWaitingCli = false;
        _isBusy = false;
        SetStatus("Stopped waiting. The Codex CLI terminal may still be running.", true);
    }

    private void DeleteCurrent()
    {
        if (_selectedId is null) return;
        long id = _selectedId.Value;
        string oldName = _name;
        string workDir = FindRepoRoot();
        Repo.DeleteDailyTestDataItem(id);
        DeleteDailyTestRuntimeFiles(workDir, id);
        ReloadItems();
        CleanupOrphanDailyTestRuntimeFiles(workDir, _items.Select(i => i.Id).ToHashSet());
        _selectedId = null;
        _activeHistoryId = null;
        _viewingHistory = false;
        _history = [];
        _name = _dataText = _promptText = _analysisMarkdown = _analysisHtml = _analyzedAt = _htmlGeneratedAt = "";
        _parametersJson = "{}";
        SetStatus($"Deleted '{oldName}' and cleared its history/runtime files.", false);
        ActivityLog.Log("DailyTest", $"delete item '{oldName}'");
    }

    private static void DeleteDailyTestRuntimeFiles(string workDir, long itemId)
    {
        try
        {
            string root = Path.GetFullPath(Path.Combine(workDir, "tmp", "daily-test-data"));
            string target = Path.GetFullPath(Path.Combine(root, itemId.ToString()));
            string rootWithSeparator = root.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar)
                                      + Path.DirectorySeparatorChar;
            if (!target.StartsWith(rootWithSeparator, StringComparison.OrdinalIgnoreCase))
                return;
            if (Directory.Exists(target))
                Directory.Delete(target, recursive: true);
        }
        catch
        {
            // Runtime files are cache/attachments. DB deletion remains authoritative.
        }
    }

    private static void CleanupOrphanDailyTestRuntimeFiles(string workDir, HashSet<long> existingItemIds)
    {
        try
        {
            string root = Path.GetFullPath(Path.Combine(workDir, "tmp", "daily-test-data"));
            if (!Directory.Exists(root)) return;

            string rootWithSeparator = root.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar)
                                      + Path.DirectorySeparatorChar;
            foreach (string dir in Directory.EnumerateDirectories(root))
            {
                string name = Path.GetFileName(dir);
                if (!long.TryParse(name, out long itemId) || existingItemIds.Contains(itemId))
                    continue;

                string target = Path.GetFullPath(dir);
                if (!target.StartsWith(rootWithSeparator, StringComparison.OrdinalIgnoreCase))
                    continue;

                Directory.Delete(target, recursive: true);
            }
        }
        catch
        {
            // Runtime files are cache/attachments. DB state remains authoritative.
        }
    }

