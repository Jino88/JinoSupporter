    private Microsoft.AspNetCore.Components.MarkupString RenderDataSummary()
    {
        var values = BuildDataSummary();
        static string Enc(string value) => System.Net.WebUtility.HtmlEncode(value ?? "");

        var sb = new System.Text.StringBuilder();
        sb.AppendLine("<div class=\"daily-summary-grid\">");
        foreach (var (label, value) in values.Cards)
        {
            sb.Append("<div class=\"daily-summary-card\"><strong>")
              .Append(Enc(label))
              .Append("</strong><span>")
              .Append(Enc(value))
              .AppendLine("</span></div>");
        }
        sb.AppendLine("</div>");
        if (!string.IsNullOrWhiteSpace(values.Note))
        {
            sb.Append("<div class=\"daily-summary-note\">")
              .Append(Enc(values.Note))
              .AppendLine("</div>");
        }
        return new Microsoft.AspNetCore.Components.MarkupString(sb.ToString());
    }

    private (List<(string Label, string Value)> Cards, string Note) BuildDataSummary()
    {
        string rowCount = "";
        string startDate = "";
        string endDate = "";
        string monthRange = "";
        string workbookCount = "";
        string sheetCount = "";
        string source = "";
        string note = "";
        DailyTestInputExtractSummary excelSummary = BuildExcelComInputSummary(_dataText);
        bool useStoredSummary = !HasPendingCurrentInputData;

        if (useStoredSummary)
        {
            try
            {
                using var doc = System.Text.Json.JsonDocument.Parse(string.IsNullOrWhiteSpace(_parametersJson) ? "{}" : _parametersJson);
                if (doc.RootElement.ValueKind == System.Text.Json.JsonValueKind.Object)
                {
                    System.Text.Json.JsonElement summary = default;
                    bool hasSummary = doc.RootElement.TryGetProperty("dataSummary", out summary)
                                      || doc.RootElement.TryGetProperty("summary", out summary)
                                      || doc.RootElement.TryGetProperty("basicInfo", out summary);
                    if (hasSummary && summary.ValueKind == System.Text.Json.JsonValueKind.Object)
                    {
                        rowCount = JsonText(summary, "rowCount", "totalRows", "rows", "recordCount");
                        startDate = JsonText(summary, "startDate", "dateRangeStart", "fromDate", "firstDate");
                        endDate = JsonText(summary, "endDate", "dateRangeEnd", "toDate", "lastDate");
                        monthRange = JsonText(summary, "monthRange", "months", "coveredMonths");
                        workbookCount = JsonText(summary, "workbookCount", "fileCount", "xlsxCount");
                        sheetCount = JsonText(summary, "sheetCount", "worksheetCount");
                        source = JsonSummarySourceText(summary, "sourceFiles", "files", "source");
                        note = JsonText(summary, "note", "notes", "description", "coverage");
                    }
                }
            }
            catch { }
        }

        if (excelSummary.HasExcelComExtract)
        {
            if (excelSummary.RowCount > 0) rowCount = $"{excelSummary.RowCount:N0}";
            if (excelSummary.WorkbookCount > 0) workbookCount = $"{excelSummary.WorkbookCount:N0}";
            if (excelSummary.SheetCount > 0) sheetCount = $"{excelSummary.SheetCount:N0}";
            if (excelSummary.Sources.Count > 0) source = FormatSummarySources(excelSummary.Sources);
            if (string.IsNullOrWhiteSpace(note))
            {
                var details = new List<string>();
                if (excelSummary.CellCount > 0) details.Add($"{excelSummary.CellCount:N0} cell(s)");
                if (excelSummary.ImageCount > 0) details.Add($"{excelSummary.ImageCount:N0} image(s)");
                note = details.Count == 0
                    ? "Excel COM extracted data is used for the summary."
                    : $"Excel COM extracted {string.Join(", ", details)}.";
            }
        }

        int attachmentCount = GetAttachedXlsxFiles().Count;
        List<string> currentSources = CurrentAttachedDataFiles;
        int nonEmptyLines = excelSummary.HasExcelComExtract
            ? 0
            : _dataText.Replace("\r\n", "\n").Replace('\r', '\n')
                .Split('\n')
                .Count(line => !string.IsNullOrWhiteSpace(line) && !line.StartsWith(XlsxAttachmentPrefix, StringComparison.Ordinal));
        var dates = ExtractDates(_dataText);

        if (string.IsNullOrWhiteSpace(rowCount)) rowCount = nonEmptyLines > 0 ? $"{nonEmptyLines:N0}+ text line(s)" : "-";
        if (string.IsNullOrWhiteSpace(workbookCount))
        {
            int workbookFallbackCount = attachmentCount > 0 ? attachmentCount : currentSources.Count;
            workbookCount = workbookFallbackCount > 0 ? $"{workbookFallbackCount:N0}" : "-";
        }
        if (string.IsNullOrWhiteSpace(startDate) && dates.Count > 0) startDate = dates.Min().ToString("yyyy-MM-dd");
        if (string.IsNullOrWhiteSpace(endDate) && dates.Count > 0) endDate = dates.Max().ToString("yyyy-MM-dd");
        if (string.IsNullOrWhiteSpace(monthRange) && dates.Count > 0)
        {
            var min = dates.Min();
            var max = dates.Max();
            monthRange = min.ToString("yyyy-MM") == max.ToString("yyyy-MM")
                ? min.ToString("yyyy-MM")
                : $"{min:yyyy-MM} ~ {max:yyyy-MM}";
        }
        if (string.IsNullOrWhiteSpace(source) && attachmentCount > 0)
            source = string.Join(", ", GetAttachedXlsxFiles().Select(f => f.FileName));
        if (string.IsNullOrWhiteSpace(source) && currentSources.Count > 0)
            source = string.Join(", ", currentSources);
        if (string.IsNullOrWhiteSpace(note) && string.IsNullOrWhiteSpace(_analysisMarkdown))
            note = "Analyze to generate row/date/file coverage from the actual data.";

        return ([
            ("Rows / records", rowCount),
            ("Date start", string.IsNullOrWhiteSpace(startDate) ? "-" : startDate),
            ("Date end", string.IsNullOrWhiteSpace(endDate) ? "-" : endDate),
            ("Month range", string.IsNullOrWhiteSpace(monthRange) ? "-" : monthRange),
            ("Workbook(s)", workbookCount),
            ("Sheet(s)", string.IsNullOrWhiteSpace(sheetCount) ? "-" : sheetCount),
            ("Source", string.IsNullOrWhiteSpace(source) ? "-" : source),
        ], note);
    }

    private static DailyTestInputExtractSummary BuildExcelComInputSummary(string dataText)
    {
        string text = (dataText ?? "").Replace("\r\n", "\n").Replace('\r', '\n');
        var summary = new DailyTestInputExtractSummary();
        if (string.IsNullOrWhiteSpace(text)
            || !text.Contains("EXCEL COM EXTRACT", StringComparison.OrdinalIgnoreCase))
        {
            return summary;
        }

        foreach (System.Text.RegularExpressions.Match match in System.Text.RegularExpressions.Regex.Matches(
                     text,
                     @"^=+\s*EXCEL COM EXTRACT:\s*(.*?)\s*=+\s*$",
                     System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.Multiline))
        {
            AddHistorySourceName(summary.Sources, match.Groups[1].Value);
        }

        int metadataBlockCount = 0;
        foreach (System.Text.RegularExpressions.Match match in System.Text.RegularExpressions.Regex.Matches(
                     text,
                     @"^Sheets:\s*([0-9,]+)\s*,\s*Rows:\s*([0-9,]+)\s*,\s*Cells:\s*([0-9,]+)\s*,\s*Images:\s*([0-9,]+)",
                     System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.Multiline))
        {
            metadataBlockCount++;
            summary.SheetCount += ParseSummaryInt(match.Groups[1].Value);
            summary.RowCount += ParseSummaryInt(match.Groups[2].Value);
            summary.CellCount += ParseSummaryInt(match.Groups[3].Value);
            summary.ImageCount += ParseSummaryInt(match.Groups[4].Value);
        }

        summary.WorkbookCount = Math.Max(summary.Sources.Count, metadataBlockCount);
        return summary;
    }

    private static int ParseSummaryInt(string value)
        => int.TryParse(
            (value ?? "").Replace(",", "").Trim(),
            System.Globalization.NumberStyles.Integer,
            System.Globalization.CultureInfo.InvariantCulture,
            out int number)
            ? number
            : 0;

    private static string FormatSummarySources(IReadOnlyList<string> sources)
    {
        var clean = sources
            .Where(source => !string.IsNullOrWhiteSpace(source))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (clean.Count <= 6) return string.Join(", ", clean);
        return string.Join(", ", clean.Take(6)) + $" +{clean.Count - 6:N0} more";
    }

    private static string JsonText(System.Text.Json.JsonElement obj, params string[] names)
    {
        foreach (string name in names)
        {
            if (!obj.TryGetProperty(name, out var value)) continue;
            if (value.ValueKind == System.Text.Json.JsonValueKind.Array)
                return string.Join(", ", value.EnumerateArray().Select(x => x.ToString()).Where(x => !string.IsNullOrWhiteSpace(x)));
            string text = value.ToString();
            if (!string.IsNullOrWhiteSpace(text)) return text;
        }
        return "";
    }

    private static string JsonSummarySourceText(System.Text.Json.JsonElement obj, params string[] names)
    {
        foreach (string name in names)
        {
            if (!obj.TryGetProperty(name, out var value)) continue;

            if (value.ValueKind == System.Text.Json.JsonValueKind.Array)
            {
                var sources = new List<string>();
                foreach (var item in value.EnumerateArray())
                {
                    string source = item.ValueKind == System.Text.Json.JsonValueKind.Object
                        ? JsonText(item, "fileName", "name", "sourceFile", "source", "path")
                        : item.ToString();
                    source = CleanHistorySourceName(source);
                    if (!string.IsNullOrWhiteSpace(source)
                        && !sources.Contains(source, StringComparer.OrdinalIgnoreCase))
                    {
                        sources.Add(source);
                    }
                }
                if (sources.Count > 0) return string.Join(", ", sources);
                continue;
            }

            if (value.ValueKind == System.Text.Json.JsonValueKind.Object)
            {
                string source = JsonText(value, "fileName", "name", "sourceFile", "source", "path");
                source = CleanHistorySourceName(source);
                if (!string.IsNullOrWhiteSpace(source)) return source;
                continue;
            }

            string text = value.ToString();
            if (!string.IsNullOrWhiteSpace(text)) return CleanHistorySourceName(text);
        }

        return "";
    }

    private static List<DateTime> ExtractDates(string text)
    {
        var dates = new List<DateTime>();
        foreach (System.Text.RegularExpressions.Match m in System.Text.RegularExpressions.Regex.Matches(
                     text ?? "",
                     @"\b(20\d{2})[-./ ](0?[1-9]|1[0-2])[-./ ](0?[1-9]|[12]\d|3[01])\b"))
        {
            if (DateTime.TryParse($"{m.Groups[1].Value}-{m.Groups[2].Value}-{m.Groups[3].Value}", out var dt))
                dates.Add(dt.Date);
        }
        return dates;
    }

    private async Task OpenAnalysisHtml()
    {
        if (string.IsNullOrWhiteSpace(_analysisMarkdown) && string.IsNullOrWhiteSpace(_analysisHtml)) return;

        try
        {
            string html;
            if (!string.IsNullOrWhiteSpace(_analysisHtml) && LooksLikeStandaloneHtmlDocument(_analysisHtml))
            {
                html = _analysisHtml.Trim();
            }
            else
            {
                string bodyHtml = string.IsNullOrWhiteSpace(_analysisHtml)
                    ? ConvertAnalysisMarkdownToHtml(_analysisMarkdown)
                    : SanitizeHtmlFragment(_analysisHtml);
                string date = string.IsNullOrWhiteSpace(_analysisHtml) ? _analyzedAt : _htmlGeneratedAt;
                html = BuildStandaloneAnalysisHtml(_name, bodyHtml, date);
            }
            bool opened = await JS.InvokeAsync<bool>("jinoDailyTest.openHtml", HtmlTitle(_name), html);
            if (!opened) SetStatus("Browser blocked the HTML report window.", true);
        }
        catch (Exception ex)
        {
            SetStatus($"Open HTML failed: {ex.Message}", true);
        }
    }

