        return sb.Length == 0 ? "(none)" : sb.ToString();
    }

    private static string BuildAnalysisContextText(string markdown, string html, int maxChars)
    {
        string body = !string.IsNullOrWhiteSpace(markdown)
            ? markdown.Trim()
            : HtmlToContextText(html);
        return TrimContext(body, maxChars);
    }

    private static string TrimContext(string text, int maxChars)
    {
        text = (text ?? "").Trim();
        if (maxChars <= 0 || text.Length <= maxChars) return text;

        const string marker = "\n\n[... middle omitted to keep the analysis request small ...]\n\n";
        int headLen = Math.Max(0, (maxChars - marker.Length) * 2 / 3);
        int tailLen = Math.Max(0, maxChars - marker.Length - headLen);
        return text[..headLen].TrimEnd() + marker + text[^tailLen..].TrimStart();
    }

    private static string HtmlToContextText(string html)
    {
        string text = SanitizeHtmlFragment(html ?? "");
        if (string.IsNullOrWhiteSpace(text)) return "";

        text = System.Text.RegularExpressions.Regex.Replace(
            text,
            @"<\s*br\s*/?\s*>",
            Environment.NewLine,
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        text = System.Text.RegularExpressions.Regex.Replace(
            text,
            @"<\s*/\s*(p|div|h[1-6]|tr|li|table|thead|tbody)\s*>",
            Environment.NewLine,
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        text = System.Text.RegularExpressions.Regex.Replace(text, "<[^>]+>", " ");
        text = System.Net.WebUtility.HtmlDecode(text);
        text = System.Text.RegularExpressions.Regex.Replace(text, @"[ \t]+", " ");
        text = System.Text.RegularExpressions.Regex.Replace(
            text,
            @"(\r?\n\s*){3,}",
            Environment.NewLine + Environment.NewLine);
        return text.Trim();
    }

    private static string BuildAttachmentMarker(string fileName, string path)
        => XlsxAttachmentPrefix + fileName.Replace('\t', ' ') + "\t" + path;

    private static string BuildExcelComExtractBlock(
        string fileName,
        string workbookPath,
        InputDataTestBatchExtractResult extracted,
