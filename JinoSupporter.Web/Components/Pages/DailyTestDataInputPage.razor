    private static string BuildPriorAnalysisText(IReadOnlyList<DailyTestPriorSnapshot> priorSnapshots)
    {
        var sb = new System.Text.StringBuilder();
        foreach (var snapshot in priorSnapshots)
        {
            string body = BuildAnalysisContextText(snapshot.AnalysisMarkdown, snapshot.AnalysisHtml, PriorAnalysisContextMaxChars);
            if (string.IsNullOrWhiteSpace(body)) continue;

            if (sb.Length > 0) sb.AppendLine().AppendLine();
            sb.AppendLine($"===== HISTORY ANALYSIS {snapshot.Id} ({snapshot.CreatedAt}) =====");
