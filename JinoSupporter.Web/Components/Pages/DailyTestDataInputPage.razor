        string existingAnalysisAt,
        string? cumulativeDataTextOverride = null,
        string? cumulativePromptTextOverride = null,
        IReadOnlyList<XlsxAttachment>? cumulativeXlsxFilesOverride = null,
        bool usingCanonicalCumulativeStore = false,
        bool usingAggregateOnlyCumulativeUpdate = false)
    {
        string userPrompt = string.IsNullOrWhiteSpace(currentPromptText)
            ? AiPromptRegistry.Read("daily-test-data/default-cumulative-request.md")
            : currentPromptText.Trim();
        string safeName = _name.Replace("\\", "\\\\").Replace("\"", "\\\"");
        string currentAttachedXlsx = FormatXlsxList(currentXlsxFiles);
        IReadOnlyList<XlsxAttachment> cumulativeXlsxFiles = cumulativeXlsxFilesOverride
            ?? BuildCumulativeXlsxFiles(priorSnapshots, currentXlsxFiles);
        string cumulativeAttachedXlsx = FormatXlsxList(cumulativeXlsxFiles);
        string cumulativeDataText = cumulativeDataTextOverride
            ?? BuildCumulativeDataText(priorSnapshots, currentDataText);
        string cumulativePromptText = cumulativePromptTextOverride
            ?? BuildCumulativePromptText(priorSnapshots, currentPromptText);
        string existingAnalysisText = "See request.existingAnalysis.analysisContext.";
        string priorAnalysisText = "See request.priorSnapshots[].analysisContext.";
        string scopeSummary = BuildHistoryScopeSummary(priorSnapshots, currentDataText);
        string cumulativeSourceNote = usingAggregateOnlyCumulativeUpdate
            ? "Cumulative data source: aggregate-only update. Raw cumulative data text is intentionally omitted for speed. Use existingParametersJson as the prior cumulative aggregate/contract and currentAdditionAnalysis.parameters as the newly added aggregate. Merge those aggregates to produce updated cumulative parameters and analysisHtml."
            : usingCanonicalCumulativeStore
                ? "Cumulative data source: saved canonical cumulative data file for this item. Prior snapshot raw data may be omitted from request JSON; do not reconstruct the cumulative scope by rereading each history snapshot."
                : "Cumulative data source: request cumulative data assembled from history snapshots and current input.";

        return AiPromptRegistry.Render(
            "daily-test-data/cumulative-analysis.md",
            ("projectName", _name),
            ("userPrompt", userPrompt),
            ("cumulativePromptText", cumulativePromptText),
            ("existingAnalysisText", existingAnalysisText),
            ("priorAnalysisText", priorAnalysisText),
            ("existingParameters", "See request.existingParametersJson."),
            ("scopeSummary", scopeSummary),
            ("cumulativeSourceNote", cumulativeSourceNote),
            ("cumulativeDataText", "See request.cumulativeDataText."),
            ("currentDataText", "See request.currentInput.dataText."),
            ("cumulativeAttachedXlsx", cumulativeAttachedXlsx),
            ("currentAttachedXlsx", currentAttachedXlsx),
            ("safeProjectName", safeName));
    }

    private static DailyTestAiResult ParseAiResult(string raw)
    {
        raw = (raw ?? "").Trim();
        string json = ExtractJson(raw);
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var root = doc.RootElement;

            static string RawJsonProp(System.Text.Json.JsonElement root, params string[] names)
            {
                foreach (string name in names)
                {
                    if (!root.TryGetProperty(name, out var value)) continue;
                    if (value.ValueKind is System.Text.Json.JsonValueKind.Object or System.Text.Json.JsonValueKind.Array)
                        return value.GetRawText();
                    string text = value.ValueKind == System.Text.Json.JsonValueKind.String
                        ? value.GetString() ?? ""
                        : value.ToString();
                    if (!string.IsNullOrWhiteSpace(text)) return text;
                }
                return "";
            }

            static string StringProp(System.Text.Json.JsonElement root, params string[] names)
            {
                foreach (string name in names)
                {
                    if (!root.TryGetProperty(name, out var value)) continue;
                    string text = value.ValueKind == System.Text.Json.JsonValueKind.String
                        ? value.GetString() ?? ""
                        : value.ToString();
                    if (!string.IsNullOrWhiteSpace(text)) return text;
                }
                return "";
            }

            string parameters = RawJsonProp(root, "parameters");
            if (string.IsNullOrWhiteSpace(parameters)) parameters = "{}";
            string analysis = StringProp(root, "analysisMarkdown");
            string html = NormalizeAnalysisHtmlForStorage(StringProp(root, "analysisHtml"));
            if (string.IsNullOrWhiteSpace(html))
                html = NormalizeAnalysisHtmlForStorage(StringProp(root, "html", "reportHtml", "bodyHtml"));
            if (string.IsNullOrWhiteSpace(html) && !string.IsNullOrWhiteSpace(analysis))
                html = ConvertAnalysisMarkdownToHtml(analysis);
            if (string.IsNullOrWhiteSpace(analysis) && !string.IsNullOrWhiteSpace(html))
                analysis = HtmlToContextText(html);

            string historyParameters = RawJsonProp(root, "historyParameters", "currentParameters", "currentInputParameters");
            string historyAnalysis = StringProp(root,
                "historyAnalysisMarkdown",
                "currentAnalysisMarkdown",
                "currentInputAnalysisMarkdown");
            string historyHtml = SanitizeHtmlFragment(StringProp(root,
                "historyAnalysisHtml",
                "currentAnalysisHtml",
                "currentInputAnalysisHtml"));
            if (string.IsNullOrWhiteSpace(historyHtml) && !string.IsNullOrWhiteSpace(historyAnalysis))
                historyHtml = ConvertAnalysisMarkdownToHtml(historyAnalysis);
            if (string.IsNullOrWhiteSpace(historyHtml))
                historyHtml = html;
            if (string.IsNullOrWhiteSpace(historyAnalysis) && !string.IsNullOrWhiteSpace(historyHtml))
                historyAnalysis = HtmlToContextText(historyHtml);

            return new DailyTestAiResult(parameters, analysis, html, historyParameters, historyAnalysis, historyHtml);
        }
        catch
        {
            if (TryParseLooseAiResult(raw, out DailyTestAiResult looseResult))
                return looseResult;

            if (LooksLikeJson(raw))
                return new DailyTestAiResult("{}", "", "", "{}", "", "");

            string html = NormalizeAnalysisHtmlForStorage(StripMarkdownHtmlFence(raw));
            if (string.IsNullOrWhiteSpace(html)) return new DailyTestAiResult("{}", "", "", "{}", "", "");
            return new DailyTestAiResult("{}", HtmlToContextText(html), html, "{}", HtmlToContextText(html), html);
        }
    }

    private static bool TryParseLooseAiResult(string raw, out DailyTestAiResult result)
    {
        result = new DailyTestAiResult("{}", "", "", "{}", "", "");
        string text = StripMarkdownHtmlFence(raw ?? "");
        if (string.IsNullOrWhiteSpace(text)) return false;

        string parameters = LooseRawJsonProp(text, "parameters");
        if (string.IsNullOrWhiteSpace(parameters)) parameters = "{}";

        string analysis = LooseStringProp(text, "analysisMarkdown");
        string html = NormalizeAnalysisHtmlForStorage(LooseStringProp(text, "analysisHtml", "html", "reportHtml", "bodyHtml"));
        if (string.IsNullOrWhiteSpace(html) && !string.IsNullOrWhiteSpace(analysis))
            html = ConvertAnalysisMarkdownToHtml(analysis);
        if (string.IsNullOrWhiteSpace(html)
            && !string.IsNullOrWhiteSpace(parameters)
            && DailyTestReportBuilder.TryRenderHtml(parameters, out string programHtml))
        {
            html = NormalizeAnalysisHtmlForStorage(programHtml);
        }
        if (string.IsNullOrWhiteSpace(analysis) && !string.IsNullOrWhiteSpace(html))
            analysis = HtmlToContextText(html);

        string historyParameters = LooseRawJsonProp(text, "historyParameters", "currentParameters", "currentInputParameters");
        if (string.IsNullOrWhiteSpace(historyParameters)) historyParameters = "{}";
        string historyAnalysis = LooseStringProp(text, "historyAnalysisMarkdown", "currentAnalysisMarkdown", "currentInputAnalysisMarkdown");
        string historyHtml = SanitizeHtmlFragment(LooseStringProp(text, "historyAnalysisHtml", "currentAnalysisHtml", "currentInputAnalysisHtml"));
        if (string.IsNullOrWhiteSpace(historyHtml) && !string.IsNullOrWhiteSpace(historyAnalysis))
            historyHtml = ConvertAnalysisMarkdownToHtml(historyAnalysis);
        if (string.IsNullOrWhiteSpace(historyHtml))
            historyHtml = html;
        if (string.IsNullOrWhiteSpace(historyAnalysis) && !string.IsNullOrWhiteSpace(historyHtml))
            historyAnalysis = HtmlToContextText(historyHtml);

        if (string.IsNullOrWhiteSpace(html)) return false;
        result = new DailyTestAiResult(parameters, analysis, html, historyParameters, historyAnalysis, historyHtml);
        return true;
    }

    private static string LooseRawJsonProp(string text, params string[] names)
    {
        foreach (string name in names)
        {
            if (!TryExtractJsonPropertyValue(text, name, out string rawValue)) continue;
            try
            {
                using var doc = System.Text.Json.JsonDocument.Parse(rawValue);
                var root = doc.RootElement;
                if (root.ValueKind is System.Text.Json.JsonValueKind.Object or System.Text.Json.JsonValueKind.Array)
                    return root.GetRawText();
                if (root.ValueKind == System.Text.Json.JsonValueKind.String)
                    return root.GetString() ?? "";
                return root.ToString();
            }
            catch
            {
                if (!string.IsNullOrWhiteSpace(rawValue)) return rawValue;
            }
        }
        return "";
    }

    private static string LooseStringProp(string text, params string[] names)
    {
        foreach (string name in names)
        {
            if (!TryExtractJsonPropertyValue(text, name, out string rawValue)) continue;
            try
            {
                using var doc = System.Text.Json.JsonDocument.Parse(rawValue);
                var root = doc.RootElement;
                string value = root.ValueKind == System.Text.Json.JsonValueKind.String
                    ? root.GetString() ?? ""
                    : root.ToString();
                if (!string.IsNullOrWhiteSpace(value)) return value;
            }
            catch
            {
                if (!string.IsNullOrWhiteSpace(rawValue)) return rawValue.Trim().Trim('"');
            }
        }
        return "";
    }

    private static bool TryExtractJsonPropertyValue(string text, string name, out string rawValue)
    {
        rawValue = "";
        if (string.IsNullOrWhiteSpace(text) || string.IsNullOrWhiteSpace(name)) return false;

        string needle = "\"" + name + "\"";
        for (int start = text.IndexOf(needle, StringComparison.Ordinal); start >= 0; start = text.IndexOf(needle, start + needle.Length, StringComparison.Ordinal))
        {
            int colon = text.IndexOf(':', start + needle.Length);
            if (colon < 0) return false;
            int valueStart = colon + 1;
            while (valueStart < text.Length && char.IsWhiteSpace(text[valueStart])) valueStart++;
            if (valueStart >= text.Length) return false;

            if (TryExtractJsonValueAt(text, valueStart, out rawValue))
                return true;
        }

        return false;
    }

    private static bool TryExtractJsonValueAt(string text, int valueStart, out string rawValue)
    {
        rawValue = "";
        if (valueStart < 0 || valueStart >= text.Length) return false;
        char first = text[valueStart];
        if (first == '{')
            return TryExtractBalancedJsonObject(text, valueStart, out rawValue);
        if (first == '[')
            return TryExtractBalancedJsonArray(text, valueStart, out rawValue);
        if (first == '"')
            return TryExtractJsonString(text, valueStart, out rawValue);

        int end = valueStart;
        while (end < text.Length && text[end] != ',' && text[end] != '}') end++;
        rawValue = text[valueStart..end].Trim();
        return rawValue.Length > 0;
    }

    private static bool TryExtractJsonString(string text, int open, out string jsonString)
    {
        jsonString = "";
        if (open < 0 || open >= text.Length || text[open] != '"') return false;
        bool escape = false;
        for (int i = open + 1; i < text.Length; i++)
        {
            char ch = text[i];
            if (escape)
            {
                escape = false;
                continue;
            }
            if (ch == '\\')
            {
                escape = true;
                continue;
            }
            if (ch == '"')
            {
                jsonString = text[open..(i + 1)];
                return true;
            }
        }
        return false;
    }

    private static IReadOnlyList<DailyTestTypoReplacement>? ParseTypoReplacements(string raw)
    {
        string text = StripMarkdownHtmlFence(raw ?? "").Trim();
        if (TryParseTypoReplacementPayload(text, out IReadOnlyList<DailyTestTypoReplacement> replacements))
            return replacements;

        int arrayOpen = text.IndexOf('[');
        int arrayClose = text.LastIndexOf(']');
        if (arrayOpen >= 0
            && arrayClose > arrayOpen
            && TryParseTypoReplacementPayload(text[arrayOpen..(arrayClose + 1)], out replacements))
        {
            return replacements;
        }

        for (int open = text.LastIndexOf('{'); open >= 0;)
        {
            if (TryExtractBalancedJsonObject(text, open, out string candidate)
                && TryParseTypoReplacementPayload(candidate, out replacements))
            {
                return replacements;
            }
            if (open == 0) break;
            open = text.LastIndexOf('{', open - 1);
        }

        return null;
    }

    private static bool TryParseTypoReplacementPayload(
        string json,
        out IReadOnlyList<DailyTestTypoReplacement> replacements)
    {
        replacements = Array.Empty<DailyTestTypoReplacement>();
        if (string.IsNullOrWhiteSpace(json)) return false;

        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var root = doc.RootElement;
            System.Text.Json.JsonElement items = root;
            if (root.ValueKind == System.Text.Json.JsonValueKind.Object)
            {
                if (!root.TryGetProperty("replacements", out items)
                    && !root.TryGetProperty("corrections", out items)
                    && !root.TryGetProperty("typoCorrections", out items))
                {
                    return false;
                }
            }

            if (items.ValueKind != System.Text.Json.JsonValueKind.Array) return false;

            static string Prop(System.Text.Json.JsonElement item, params string[] names)
            {
                foreach (string name in names)
                {
                    if (!item.TryGetProperty(name, out var value)) continue;
                    string text = value.ValueKind == System.Text.Json.JsonValueKind.String
                        ? value.GetString() ?? ""
                        : value.ToString();
                    if (!string.IsNullOrWhiteSpace(text)) return text;
                }
                return "";
            }

            var list = new List<DailyTestTypoReplacement>();
            foreach (System.Text.Json.JsonElement item in items.EnumerateArray())
            {
                if (item.ValueKind != System.Text.Json.JsonValueKind.Object) continue;
                string original = Prop(item, "original", "source", "sourceText", "from");
                string corrected = Prop(item, "corrected", "replacement", "target", "to");
                if (string.IsNullOrWhiteSpace(original) || string.IsNullOrWhiteSpace(corrected)) continue;
                string reason = Prop(item, "reason");
                list.Add(new DailyTestTypoReplacement(original, corrected, reason));
            }

            replacements = list;
            return true;
        }
        catch
        {
            return false;
        }
    }

    private static string StripMarkdownHtmlFence(string raw)
    {
        string text = (raw ?? "").Trim();
        if (!text.StartsWith("```", StringComparison.Ordinal)) return text;

        int nl = text.IndexOf('\n');
        if (nl >= 0) text = text[(nl + 1)..];
        if (text.TrimEnd().EndsWith("```", StringComparison.Ordinal))
            text = text[..text.LastIndexOf("```", StringComparison.Ordinal)];
        return text.Trim();
    }

    private static string ExtractJson(string raw)
    {
        raw = (raw ?? "").Trim();
        if (raw.StartsWith("```", StringComparison.Ordinal))
        {
            int nl = raw.IndexOf('\n');
            if (nl >= 0) raw = raw[(nl + 1)..];
            if (raw.TrimEnd().EndsWith("```", StringComparison.Ordinal))
                raw = raw[..raw.LastIndexOf("```", StringComparison.Ordinal)];
        }

        foreach (string resultStart in new[] { "{\"analysisHtml\"", "{\"html\"", "{\"parameters\"" })
        {
            for (int searchEnd = raw.Length - 1; searchEnd >= 0;)
            {
                int resultOpen = raw.LastIndexOf(resultStart, searchEnd, StringComparison.Ordinal);
                if (resultOpen < 0) break;
                if (TryExtractBalancedJsonObject(raw, resultOpen, out string candidate) && IsAiResultJson(candidate))
                    return candidate;
                if (resultOpen == 0) break;
                searchEnd = resultOpen - 1;
            }
        }

        for (int open = raw.LastIndexOf('{'); open >= 0;)
        {
            if (TryExtractBalancedJsonObject(raw, open, out string candidate) && IsAiResultJson(candidate))
                return candidate;
            if (open == 0) break;
            open = raw.LastIndexOf('{', open - 1);
        }

        int firstOpen = raw.IndexOf('{');
        int close = raw.LastIndexOf('}');
        return firstOpen >= 0 && close > firstOpen ? raw[firstOpen..(close + 1)] : raw;

        static bool IsAiResultJson(string value)
        {
            try
            {
                using var doc = System.Text.Json.JsonDocument.Parse(value);
                var root = doc.RootElement;
                return root.ValueKind == System.Text.Json.JsonValueKind.Object
                       && (root.TryGetProperty("analysisHtml", out _)
                           || root.TryGetProperty("html", out _)
                           || root.TryGetProperty("reportHtml", out _)
                           || root.TryGetProperty("bodyHtml", out _));
            }
            catch
            {
                return false;
            }
        }
    }

    private static bool TryExtractBalancedJsonObject(string text, int open, out string json)
    {
        json = "";
        if (open < 0 || open >= text.Length || text[open] != '{') return false;

        bool inString = false;
        bool escape = false;
        int depth = 0;
        for (int i = open; i < text.Length; i++)
        {
            char ch = text[i];
            if (inString)
            {
                if (escape)
                {
                    escape = false;
                }
                else if (ch == '\\')
                {
                    escape = true;
                }
                else if (ch == '"')
                {
                    inString = false;
                }
                continue;
            }

            if (ch == '"')
            {
                inString = true;
                continue;
            }

            if (ch == '{')
            {
                depth++;
            }
            else if (ch == '}')
            {
                depth--;
                if (depth == 0)
                {
                    json = text[open..(i + 1)];
                    return true;
                }
                if (depth < 0) return false;
            }
        }

        return false;
    }

    private static bool TryExtractBalancedJsonArray(string text, int open, out string json)
    {
        json = "";
        if (open < 0 || open >= text.Length || text[open] != '[') return false;

        bool inString = false;
        bool escape = false;
        int depth = 0;
        for (int i = open; i < text.Length; i++)
        {
            char ch = text[i];
            if (inString)
            {
                if (escape)
                {
                    escape = false;
                }
                else if (ch == '\\')
                {
                    escape = true;
                }
                else if (ch == '"')
                {
                    inString = false;
                }
                continue;
            }

            if (ch == '"')
            {
                inString = true;
                continue;
            }

            if (ch == '[')
            {
                depth++;
            }
            else if (ch == ']')
            {
                depth--;
                if (depth == 0)
                {
                    json = text[open..(i + 1)];
                    return true;
                }
                if (depth < 0) return false;
            }
        }

        return false;
    }

    private static bool LooksLikeJson(string raw)
    {
        string text = StripMarkdownHtmlFence(raw ?? "").TrimStart();
        return text.StartsWith("{", StringComparison.Ordinal)
               || text.StartsWith("[", StringComparison.Ordinal);
    }

    private static string PrettyJson(string json)
    {
        if (string.IsNullOrWhiteSpace(json)) return "{}";
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            return System.Text.Json.JsonSerializer.Serialize(doc.RootElement, new System.Text.Json.JsonSerializerOptions
            {
                WriteIndented = true
            });
        }
        catch
        {
            return json;
        }
    }

