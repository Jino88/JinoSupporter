        => DateTimeOffset.TryParse(
            value,
            System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.AssumeUniversal | System.Globalization.DateTimeStyles.AdjustToUniversal,
            out var dt)
            ? dt
            : DateTimeOffset.MinValue;

    private void SetStatus(string message, bool error)
    {
        _status = message;
        _statusError = error;
        WriteDailyTestConsoleStatus(message, error);
    }

    private void StartDailyTestStatusConsole(string workDir, long itemId, string itemName)
    {
        try
        {
            string runId = DateTime.Now.ToString("yyyyMMdd_HHmmss") + "_" + Guid.NewGuid().ToString("N")[..8];
            string dir = Path.Combine(workDir, "tmp", "daily-test-data", itemId.ToString());
            Directory.CreateDirectory(dir);

            _dailyTestConsoleLogPath = Path.Combine(dir, $"analysis_status_{runId}.log");
            _dailyTestConsoleDonePath = Path.Combine(dir, $"analysis_status_done_{runId}.flag");
            string scriptPath = Path.Combine(dir, $"analysis_status_{runId}.ps1");

            File.WriteAllText(
                _dailyTestConsoleLogPath,
                $"[{DateTime.Now:HH:mm:ss}] Daily Test Data AI Analyze status console started for '{itemName}'.{Environment.NewLine}",
                new System.Text.UTF8Encoding(encoderShouldEmitUTF8Identifier: false));
            File.WriteAllText(
                scriptPath,
                BuildDailyTestStatusConsoleScript(_dailyTestConsoleLogPath, _dailyTestConsoleDonePath, scriptPath, itemName),
                new System.Text.UTF8Encoding(encoderShouldEmitUTF8Identifier: false));

            TryLaunchDailyTestStatusConsole(workDir, scriptPath);
        }
        catch
        {
            _dailyTestConsoleLogPath = null;
            _dailyTestConsoleDonePath = null;
        }
    }

    private void CompleteDailyTestStatusConsole(string message, bool error)
    {
        WriteDailyTestConsoleStatus(message, error);
        try
        {
            if (!string.IsNullOrWhiteSpace(_dailyTestConsoleDonePath))
                File.WriteAllText(_dailyTestConsoleDonePath, DateTime.UtcNow.ToString("o"));
        }
        catch { }
        finally
        {
            _dailyTestConsoleLogPath = null;
            _dailyTestConsoleDonePath = null;
        }
    }

    private void WriteDailyTestConsoleStatus(string message, bool error)
    {
        if (string.IsNullOrWhiteSpace(_dailyTestConsoleLogPath) || string.IsNullOrWhiteSpace(message))
            return;

        try
        {
            string prefix = error ? "ERROR" : "INFO ";
            string line = $"[{DateTime.Now:HH:mm:ss}] [{prefix}] {message.Trim()}{Environment.NewLine}";
            File.AppendAllText(_dailyTestConsoleLogPath, line, new System.Text.UTF8Encoding(encoderShouldEmitUTF8Identifier: false));
        }
        catch { }
    }

    private static bool TryLaunchDailyTestStatusConsole(string workDir, string scriptPath)
    {
        try
        {
            var wt = new System.Diagnostics.ProcessStartInfo
            {
                FileName = "wt.exe",
                UseShellExecute = false,
                CreateNoWindow = false,
            };
            wt.ArgumentList.Add("-d");
            wt.ArgumentList.Add(workDir);
            wt.ArgumentList.Add("powershell.exe");
            wt.ArgumentList.Add("-NoExit");
            wt.ArgumentList.Add("-NoProfile");
            wt.ArgumentList.Add("-ExecutionPolicy");
            wt.ArgumentList.Add("Bypass");
            wt.ArgumentList.Add("-File");
            wt.ArgumentList.Add(scriptPath);
            var proc = System.Diagnostics.Process.Start(wt);
            if (proc is not null) ChildProcessJob.Assign(proc);
            return proc is not null;
        }
        catch { }

        try
        {
            var psi = new System.Diagnostics.ProcessStartInfo
            {
                FileName = "cmd.exe",
                WorkingDirectory = workDir,
                UseShellExecute = false,
                CreateNoWindow = false,
            };
            psi.ArgumentList.Add("/k");
            psi.ArgumentList.Add("powershell.exe");
            psi.ArgumentList.Add("-NoExit");
            psi.ArgumentList.Add("-NoProfile");
            psi.ArgumentList.Add("-ExecutionPolicy");
            psi.ArgumentList.Add("Bypass");
            psi.ArgumentList.Add("-File");
            psi.ArgumentList.Add(scriptPath);
            var proc = System.Diagnostics.Process.Start(psi);
            if (proc is not null) ChildProcessJob.Assign(proc);
            return proc is not null;
        }
        catch
        {
            return false;
        }
    }

    private static string BuildDailyTestStatusConsoleScript(string logPath, string donePath, string scriptPath, string itemName)
    {
        static string Q(string value) => "'" + (value ?? "").Replace("'", "''") + "'";
        string title = "Daily Test Data Status - " + itemName;
        return string.Join(Environment.NewLine, new[]
        {
            "$ErrorActionPreference = 'Continue'",
            "$utf8NoBom = New-Object System.Text.UTF8Encoding -ArgumentList $false",
            "[Console]::InputEncoding = $utf8NoBom",
            "[Console]::OutputEncoding = $utf8NoBom",
            "$OutputEncoding = $utf8NoBom",
            "try { chcp 65001 | Out-Null } catch {}",
            $"try {{ $Host.UI.RawUI.WindowTitle = {Q(title)} }} catch {{}}",
            $"$logPath = {Q(logPath)}",
            $"$donePath = {Q(donePath)}",
            $"$scriptPath = {Q(scriptPath)}",
            "Write-Host 'Daily Test Data AI Analyze status' -ForegroundColor Cyan",
            "Write-Host ('Log: ' + $logPath) -ForegroundColor DarkGray",
            "Write-Host ''",
            "$seen = 0",
            "while ($true) {",
            "    if (Test-Path -LiteralPath $logPath) {",
            "        $lines = @(Get-Content -LiteralPath $logPath -Encoding UTF8)",
            "        for ($i = $seen; $i -lt $lines.Count; $i++) {",
            "            $line = [string]$lines[$i]",
            "            if ($line.Contains('[ERROR]')) { Write-Host $line -ForegroundColor Red }",
            "            elseif ($line.Contains('finished') -or $line.Contains('updated') -or $line.Contains('saved')) { Write-Host $line -ForegroundColor Green }",
            "            else { Write-Host $line }",
            "        }",
            "        $seen = $lines.Count",
            "    }",
            "    if (Test-Path -LiteralPath $donePath) { break }",
            "    Start-Sleep -Seconds 1",
            "}",
            "Write-Host ''",
            "Write-Host 'Status stream ended. You can close this window.' -ForegroundColor Cyan",
            "Remove-Item -LiteralPath $scriptPath -Force -ErrorAction SilentlyContinue",
        });
    }

