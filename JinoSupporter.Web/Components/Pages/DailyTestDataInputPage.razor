               && priorSnapshots.Any(s => string.Equals(SnapshotDataKey(s.DataText), currentKey, StringComparison.Ordinal));
    }

    private static bool IsDuplicateCurrentPrompt(
        string currentPromptText,
        IReadOnlyList<DailyTestPriorSnapshot> priorSnapshots)
    {
        string currentKey = SnapshotPromptKey(currentPromptText);
        return currentKey.Length > 0
               && priorSnapshots.Any(s => string.Equals(SnapshotPromptKey(s.PromptText), currentKey, StringComparison.Ordinal));
    }

    private static string BuildHistoryScopeSummary(
        IReadOnlyList<DailyTestPriorSnapshot> priorSnapshots,
        string currentDataText)
    {
        string ids = priorSnapshots.Count == 0
            ? "none"
            : string.Join(", ", priorSnapshots.Select(s => $"{s.Id}@{FormatDate(s.CreatedAt)}"));
        string currentKey = SnapshotDataKey(currentDataText);
        bool currentAlreadyInHistory = currentKey.Length > 0
            && priorSnapshots.Any(s => string.Equals(SnapshotDataKey(s.DataText), currentKey, StringComparison.Ordinal));

        string currentScope = currentKey.Length == 0
            ? "no current input segment"
            : currentAlreadyInHistory
                ? "current input duplicates an existing history segment"
                : "current input is a new segment";

        return string.Join("; ", new[]
        {
            $"history snapshots: {priorSnapshots.Count} ({ids})",
            $"unique raw data segments: {CountUniqueDataSegments(priorSnapshots, currentDataText)}",
            currentScope
        });
    }

