    private static DailyTestCumulativeStore LoadOrSeedCumulativeStore(
        string workDir,
        long itemId,
        string itemDataText,
        string itemPromptText,
        IReadOnlyList<DailyTestPriorSnapshot> priorSnapshots)
    {
        string dataPath = CumulativeStorePath(workDir, itemId, CumulativeDataFileName);
        string promptPath = CumulativeStorePath(workDir, itemId, CumulativePromptFileName);

        string dataText = ReadTextIfExists(dataPath);
        if (string.IsNullOrWhiteSpace(dataText))
        {
            dataText = IsGeneratedCumulativeDataText(itemDataText)
                ? itemDataText.Trim()
                : BuildCumulativeDataText(priorSnapshots, "");
            WriteTextIfUseful(dataPath, dataText);
        }

        string promptText = ReadTextIfExists(promptPath);
        if (string.IsNullOrWhiteSpace(promptText))
        {
            promptText = IsGeneratedCumulativePromptText(itemPromptText)
                ? itemPromptText.Trim()
                : BuildCumulativePromptText(priorSnapshots, "");
            WriteTextIfUseful(promptPath, promptText);
        }

        return new DailyTestCumulativeStore(dataText, promptText);
    }

    private static void SaveCumulativeStore(
        string workDir,
        long itemId,
        string dataText,
        string promptText)
    {
        WriteTextIfUseful(CumulativeStorePath(workDir, itemId, CumulativeDataFileName), dataText);
        WriteTextIfUseful(CumulativeStorePath(workDir, itemId, CumulativePromptFileName), promptText);
    }

    private static string CumulativeStorePath(string workDir, long itemId, string fileName)
    {
        string dir = Path.Combine(workDir, "tmp", "daily-test-data", itemId.ToString());
        Directory.CreateDirectory(dir);
        return Path.Combine(dir, fileName);
    }

    private static string ReadTextIfExists(string path)
    {
        try
        {
            return File.Exists(path) ? File.ReadAllText(path).Trim() : "";
        }
        catch
        {
            return "";
        }
    }

    private static void WriteTextIfUseful(string path, string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return;
        Directory.CreateDirectory(Path.GetDirectoryName(path) ?? ".");
        File.WriteAllText(path, text.Trim() + Environment.NewLine, new System.Text.UTF8Encoding(encoderShouldEmitUTF8Identifier: false));
    }

    private static string AppendUniqueCumulativeDataSegment(
        string cumulativeDataText,
        long historyId,
        string createdAt,
        string dataText)
    {
        string marker = historyId > 0
            ? $"{HistoryDataMarkerPrefix}{historyId} ({createdAt}) ====="
            : CurrentInputDataMarker;
        return AppendUniqueCumulativeSegment(cumulativeDataText, marker, dataText);
    }

    private static string AppendUniqueCumulativePromptSegment(
        string cumulativePromptText,
        long historyId,
        string createdAt,
        string promptText)
    {
        string marker = historyId > 0
            ? $"{HistoryPromptMarkerPrefix}{historyId} ({createdAt}) ====="
            : CurrentPromptMarker;
        return AppendUniqueCumulativeSegment(cumulativePromptText, marker, promptText);
    }

    private static string AppendUniqueCumulativeSegment(string cumulativeText, string marker, string segmentText)
    {
        string segment = (segmentText ?? "").Trim();
        if (string.IsNullOrWhiteSpace(segment)) return (cumulativeText ?? "").Trim();

        string cumulative = (cumulativeText ?? "").Trim();
        if (ContainsNormalizedBlock(cumulative, segment)) return cumulative;

        var sb = new System.Text.StringBuilder(cumulative);
        if (sb.Length > 0) sb.AppendLine().AppendLine();
        sb.AppendLine(marker);
        sb.AppendLine(segment);
        return sb.ToString().Trim();
    }

    private static bool ContainsNormalizedBlock(string text, string block)
    {
        string normalizedText = SnapshotDataKey(text);
        string normalizedBlock = SnapshotDataKey(block);
        return normalizedBlock.Length > 0
               && normalizedText.Contains(normalizedBlock, StringComparison.Ordinal);
    }

    private static List<XlsxAttachment> BuildCumulativeXlsxFiles(
        IReadOnlyList<DailyTestPriorSnapshot> priorSnapshots,
        IReadOnlyList<XlsxAttachment> currentFiles)
        => priorSnapshots
            .SelectMany(s => s.XlsxFiles)
            .Concat(currentFiles)
            .Where(f => !string.IsNullOrWhiteSpace(f.Path))
            .GroupBy(f => f.Path, StringComparer.OrdinalIgnoreCase)
            .Select(g => g.First())
            .ToList();

    private static string BuildCumulativeDataText(
        IReadOnlyList<DailyTestPriorSnapshot> priorSnapshots,
        string currentDataText)
    {
        var sb = new System.Text.StringBuilder();
        var seenData = new HashSet<string>(StringComparer.Ordinal);

        foreach (var snapshot in priorSnapshots)
        {
            string dataKey = SnapshotDataKey(snapshot.DataText);
            if (dataKey.Length == 0 || !seenData.Add(dataKey)) continue;

            if (sb.Length > 0) sb.AppendLine().AppendLine();
            sb.AppendLine($"{HistoryDataMarkerPrefix}{snapshot.Id} ({snapshot.CreatedAt}) =====");
            sb.AppendLine(snapshot.DataText.Trim());
        }

        string currentKey = SnapshotDataKey(currentDataText);
        if (currentKey.Length > 0 && seenData.Add(currentKey))
        {
            if (sb.Length > 0) sb.AppendLine().AppendLine();
            sb.AppendLine(CurrentInputDataMarker);
            sb.AppendLine(currentDataText.Trim());
        }

        return sb.ToString();
    }

    private static string BuildCumulativePromptText(
        IReadOnlyList<DailyTestPriorSnapshot> priorSnapshots,
        string currentPromptText)
    {
        var sb = new System.Text.StringBuilder();
        var seenPrompts = new HashSet<string>(StringComparer.Ordinal);

        foreach (var snapshot in priorSnapshots)
        {
            string promptKey = SnapshotPromptKey(snapshot.PromptText);
            if (promptKey.Length == 0 || !seenPrompts.Add(promptKey)) continue;

            if (sb.Length > 0) sb.AppendLine().AppendLine();
            sb.AppendLine($"{HistoryPromptMarkerPrefix}{snapshot.Id} ({snapshot.CreatedAt}) =====");
            sb.AppendLine(snapshot.PromptText.Trim());
        }

        string currentKey = SnapshotPromptKey(currentPromptText);
        if (currentKey.Length > 0 && seenPrompts.Add(currentKey))
        {
            if (sb.Length > 0) sb.AppendLine().AppendLine();
            sb.AppendLine(CurrentPromptMarker);
            sb.AppendLine(currentPromptText.Trim());
        }

        return sb.ToString();
    }

    private List<DailyTestPriorSnapshot> BuildPriorSnapshotsForAnalysis(string? currentDataText = null)
    {
        var snapshots = new List<DailyTestPriorSnapshot>();

        foreach (var h in _history.OrderBy(h => SortableDate(h.CreatedAt)).ThenBy(h => h.Id))
        {
            if (!HasMeaningfulPriorSnapshot(h)) continue;
            if (IsGeneratedCumulativeDataText(h.DataText)) continue;
            string snapshotDataText = IsMeaningfulCurrentInputData(h.DataText) ? h.DataText : "";

            snapshots.Add(new DailyTestPriorSnapshot(
                h.Id,
                h.CreatedAt,
                snapshotDataText,
                h.PromptText,
                string.IsNullOrWhiteSpace(h.ParametersJson) ? "{}" : h.ParametersJson,
                h.AnalysisMarkdown,
                h.AnalysisHtml,
                ExtractAttachedXlsxFiles(snapshotDataText)));
        }

        return snapshots;
    }

    private static int CountUniqueDataSegments(
        IReadOnlyList<DailyTestPriorSnapshot> priorSnapshots,
        string currentDataText)
    {
        var seenData = new HashSet<string>(StringComparer.Ordinal);
        foreach (var snapshot in priorSnapshots)
        {
            string dataKey = SnapshotDataKey(snapshot.DataText);
            if (dataKey.Length > 0) seenData.Add(dataKey);
        }

        string currentKey = SnapshotDataKey(currentDataText);
        if (currentKey.Length > 0) seenData.Add(currentKey);
        return seenData.Count;
    }

    private static bool IsDuplicateCurrentData(
        string currentDataText,
