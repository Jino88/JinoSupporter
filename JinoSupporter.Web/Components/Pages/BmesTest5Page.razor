@page "/bmes/test5"
@rendermode InteractiveServer
@using System.Globalization
@using System.Net
@using System.Text
@using JinoSupporter.Web.Services
@inject BmesFcostActualService FCostActual
@inject BmesBomCacheService BomCache
@inject BmesPdmScrapeService Pdm
@inject AppPathsService AppPaths
@inject WebRepository Repo
@inject AppActivityLogger Activity
@inject IJSRuntime JS

<PageTitle>BOM &amp; Drawing</PageTitle>

<div class="d-flex align-items-center gap-2 mb-3">
    <span class="fw-semibold" style="font-size:18px;">B&amp;D</span>
    <h5 class="mb-0 fw-semibold">BOM &amp; Drawing</h5>
</div>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger py-2 small mb-3">@_errorMessage</div>
}

<div class="t5-toolbar mb-3">
    <div class="t5-group">
        <span class="text-muted small">
            Model
            @if (_modelCatalog.Count > 0)
            {
                <span>(@_modelCatalog.Count.ToString("N0", CultureInfo.InvariantCulture) local names)</span>
            }
        </span>
        <input class="form-control form-control-sm"
               placeholder="Type a similar model name"
               autocomplete="off"
               value="@_modelFilter"
               @oninput="OnModelSearchInput"
               disabled="@(_busy || _modelSearchBusy)" />
        @if (!_suppressModelSuggestions &&
             (_modelSearchBusy || _modelCandidates.Count > 0 || _modelSearchHasRun))
        {
            <span class="t5-suggestions">
                @if (_modelSearchBusy)
                {
                    <span class="t5-suggestion-status">
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                        Synchronizing model names from BMES once...
                    </span>
                }
                @foreach (var candidate in _modelCandidates)
                {
                    <button type="button"
                            class="t5-suggestion"
                            title="@candidate.Hint"
                            @onclick="() => LoadSuggestedModelAsync(candidate)">
                        <span class="t5-suggestion-main">
                            <span>@candidate.Name</span>
                            @if (!string.IsNullOrWhiteSpace(candidate.ProductCode))
                            {
                                <small>@candidate.ProductCode</small>
                            }
                        </span>
                        @if (_cachedModelNames.Contains(candidate.Name))
                        {
                            <span class="badge bg-success">cached</span>
                        }
                        else if (candidate.Source == "catalog")
                        {
                            <span class="badge bg-primary">local</span>
                        }
                    </button>
                }
                @if (!_modelSearchBusy && _modelCandidates.Count == 0)
                {
                    <span class="t5-suggestion-status @(string.IsNullOrWhiteSpace(_modelSearchError) ? "" : "text-danger")">
                        @(string.IsNullOrWhiteSpace(_modelSearchError)
                            ? (_modelCatalog.Count == 0
                                ? "No local model-name cache. Click Sync model names."
                                : "No cached model name matches.")
                            : _modelSearchError)
                    </span>
                }
                else if (!_modelSearchBusy && !string.IsNullOrWhiteSpace(_modelSearchError))
                {
                    <span class="t5-suggestion-status text-danger">@_modelSearchError</span>
                }
            </span>
        }
    </div>

    <button class="btn btn-outline-secondary btn-sm"
            @onclick="RefreshModelCatalogAsync"
            disabled="@(_busy || _modelSearchBusy)"
            title="@ModelCatalogTitle">
        @(_modelSearchBusy ? "Syncing names…" : "Sync model names")
    </button>

    <label class="t5-depth">
        <span class="text-muted small">Depth</span>
        <input type="number" class="form-control form-control-sm" min="1" max="12" @bind="_maxDepth" disabled="@_busy" />
    </label>

    <label class="t5-depth">
        <span class="text-muted small">Plant</span>
        <input class="form-control form-control-sm" @bind="Plant" disabled="@(_busy || _modelSearchBusy)" />
    </label>

    <label class="t5-date">
        <span class="text-muted small">Work date</span>
        <input type="date" class="form-control form-control-sm" @bind="_workDate" disabled="@_busy" />
    </label>

    <label class="t5-check">
        <input type="checkbox" class="form-check-input" @bind="_hideNoiseCodes" disabled="@_busy" />
        <span class="small">Hide M-P / C-S codes</span>
    </label>

    <label class="t5-check" title="Unchecked: use the local model cache first. Cache misses are fetched from BMES automatically.">
        <input type="checkbox" class="form-check-input" @bind="_loadBomFromServer" disabled="@_busy" />
        <span class="small">Load BOM from server</span>
    </label>

    <button class="btn btn-primary btn-sm" @onclick="LoadBomAsync" disabled="@(_busy || SelectedModels.Count == 0)">
        Load BOM
    </button>
    <button class="btn btn-outline-secondary btn-sm" @onclick="DownloadHtmlAsync" disabled="@(_busy || _results.Count == 0)">
        Download HTML
    </button>
    <button class="btn btn-outline-secondary btn-sm"
            @onclick="FetchPdmAsync"
            disabled="@(_busy || _pdmBusy)"
            title="@($"PDM master: {_pdmTotal:N0} row(s){(string.IsNullOrWhiteSpace(_pdmFetchedAt) ? "" : ", fetched " + _pdmFetchedAt)}")">
        @(_pdmBusy ? "Fetching…" : "Fetch PDM")
    </button>
</div>

@{
    var filteredModels = FilteredCachedModels;
}
<div class="t5-models mb-3">
    <div class="t5-models-head">
        <span class="fw-semibold small">Cached models</span>
        <span class="badge bg-secondary">@SelectedModels.Count.ToString("N0", CultureInfo.InvariantCulture) selected</span>
        <span class="text-muted small">@filteredModels.Count.ToString("N0", CultureInfo.InvariantCulture) / @_cachedModelEntries.Count.ToString("N0", CultureInfo.InvariantCulture) shown</span>
        <button class="btn btn-link btn-sm p-0 ms-2" @onclick="SelectAllModels" disabled="@_busy">All</button>
        <button class="btn btn-link btn-sm p-0" @onclick="ClearModelSelection" disabled="@_busy">None</button>
    </div>
    @if (_cachedModelEntries.Count == 0)
    {
        <div class="text-muted small">No successfully cached BOM model yet. Type a similar model name above to load the first one.</div>
    }
    else if (filteredModels.Count == 0)
    {
        <div class="text-muted small">No model matches "@_modelFilter".</div>
    }
    else
    {
        <div class="t5-model-chips">
            @foreach (var model in filteredModels)
            {
                <label class="t5-chip @(_selectedModels.Contains(model.Name) ? "selected" : "")" title="@model.Groups">
                    <input type="checkbox"
                           checked="@_selectedModels.Contains(model.Name)"
                           @onchange="e => ToggleModel(model.Name, e.Value)"
                           disabled="@_busy" />
                    <span>@model.Name</span>
                </label>
            }
        </div>
    }
</div>

@if (!string.IsNullOrWhiteSpace(_pdmStatus))
{
    <div class="small @(_pdmError ? "text-danger" : "text-muted") mb-2">@_pdmStatus</div>
}

@if (_busy)
{
    <div class="alert alert-info py-2 small mb-3 d-flex align-items-center gap-2">
        <span class="spinner-border spinner-border-sm" role="status"></span>
        <span>@_statusMessage</span>
    </div>
}
else if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <div class="alert alert-success py-2 small mb-3">@_statusMessage</div>
}

@foreach (var result in _results)
{
    var rows = VisibleRows(result);
    <section class="t5-card mb-3">
        <header class="t5-card-head">
            <span class="fw-semibold">@result.Model</span>
            <span class="badge bg-secondary">@rows.Count.ToString("N0", CultureInfo.InvariantCulture) rows</span>
            @if (_hideNoiseCodes && result.Rows.Count != rows.Count)
            {
                <span class="text-muted small">@((result.Rows.Count - rows.Count).ToString("N0", CultureInfo.InvariantCulture)) hidden</span>
            }
            @{
                var matched = MatchedProducts(result);
            }
            @if (matched.Count > 0)
            {
                <span class="text-muted small" title="Products matched in MATE for this model name">
                    matched: @string.Join(", ", matched)
                </span>
            }
            @if (!string.IsNullOrWhiteSpace(result.LoadSource))
            {
                <span class="badge @(result.LoadSource == "cache" ? "bg-success" : "bg-primary")"
                      title="@result.FetchedAt">
                    @result.LoadSource
                </span>
            }
            @if (!string.IsNullOrWhiteSpace(result.Warning))
            {
                <span class="badge bg-warning text-dark" title="@result.Warning">cache warning</span>
            }
            @if (!string.IsNullOrWhiteSpace(result.Error))
            {
                <span class="badge bg-danger">@result.Error</span>
            }
        </header>
        @if (rows.Count > 0)
        {
            <div class="t5-table-wrap">
                <table class="table table-sm table-hover t5-table mb-0">
                    <colgroup>
                        <col class="t5-col-level" />
                        <col class="t5-col-material" />
                        <col class="t5-col-code" />
                        <col class="t5-col-pdm" />
                        <col class="t5-col-type" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>Lv</th>
                            <th>Material</th>
                            <th>Code</th>
                            <th>PDMNO</th>
                            <th>PDTNO_TX</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in ByProduct(rows))
                        {
                            <tr class="t5-product @(product.IsShared ? "shared" : "")">
                                <td colspan="5">
                                    @product.Product
                                    <span class="badge bg-light text-dark ms-1">@product.Rows.Count.ToString("N0", CultureInfo.InvariantCulture)</span>
                                </td>
                            </tr>
                            @foreach (var row in product.Rows)
                            {
                                <tr class="t5-lv@(Math.Clamp(row.BomLevel, 1, 6))">
                                    <td class="text-muted">@row.BomLevel</td>
                                    <td title="@row.BomPathText">
                                        <span class="t5-tree-item" style="padding-left:@(((Math.Max(row.BomLevel, 1) - 1) * 18))px;">
                                            <span class="t5-tree-marker">@(row.HasChildren ? "▾" : "·")</span>
                                            <span>@DisplayName(row)</span>
                                        </span>
                                    </td>
                                    <td class="text-muted small">@row.MaterialCode</td>
                                    @{
                                        var pdm = FindPdm(row);
                                    }
                                    <td class="small">
                                        @if (pdm is not null && !string.IsNullOrWhiteSpace(pdm.Pdmno))
                                        {
                                            <button class="btn btn-link btn-sm p-0 t5-dwg"
                                                    @onclick="() => DownloadDrawingAsync(pdm.Pdmno, pdm.Pdmvr)"
                                                    disabled="@_downloadBusy"
                                                    title="Download the DWG for this drawing">
                                                @pdm.Pdmno
                                            </button>
                                        }
                                    </td>
                                    <td class="text-muted small">@(pdm?.PdtnoTx ?? "")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (string.IsNullOrWhiteSpace(result.Error))
        {
            <div class="t5-empty text-muted small">No BOM rows found for this model.</div>
        }
    </section>
}

