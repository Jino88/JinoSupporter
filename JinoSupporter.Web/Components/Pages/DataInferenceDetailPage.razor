@page "/data-inference/detail"
@rendermode InteractiveServer
@inject WebRepository Repo

<PageTitle>@(string.IsNullOrEmpty(Name) ? "Data Inference — Detail" : $"📄 {Name}")</PageTitle>

<div class="didet-root">

@if (string.IsNullOrWhiteSpace(Name))
{
    <div class="didet-empty">No dataset name specified.</div>
}
else if (_info is null)
{
    <div class="didet-empty">Dataset <strong>@Name</strong> not found.</div>
}
else
{
    <div class="didet-header">
        <div>
            <div class="didet-title">📄 @_info.DatasetName</div>
            <div class="didet-meta">
                <span class="didet-chip didet-chip-prod">@(_info.ProductType ?? "")</span>
                <span class="didet-chip">📅 @_info.ReportDate</span>
                <span class="didet-chip">🖼 @_info.ImageCount</span>
                <span class="didet-chip">📐 @_info.MeasurementCount rows</span>
                <span class="didet-chip didet-chip-dim">Saved @FormatDate(_info.CreatedAt)</span>
            </div>
        </div>
    </div>

    <div class="didet-body">
        @if (_summary is not null)
        {
            <section class="didet-card">
                <div class="didet-card-head">
                    <div class="didet-card-title">📊 AI Analysis</div>
                    @* Language picker. "en" = original AI output; "ko"/"vi" come
                       from the post-analyze translate step. Disabled if a lang
                       wasn't translated (e.g. older datasets). *@
                    <div class="didet-lang-row">
                        @foreach (var (code, label) in _availableLangs)
                        {
                            <button class="didet-lang @(code == _lang ? "active" : "")"
                                    @onclick="() => _lang = code">@label</button>
                        }
                    </div>
                </div>
                @{
                    bool hasV2 = !string.IsNullOrWhiteSpace(_summary.Verdict)
                               || !string.IsNullOrWhiteSpace(_summary.Headline)
                               || _summary.Evidence.Count > 0
                               || _summary.Actions.Count  > 0;

                    // Pre-resolve language-aware values once so the if-bodies
                    // below contain only markup (Razor can't open `@{ }` as the
                    // first non-markup token inside an `@if { … }` body).
                    string  vHeadline = hasV2 ? LangHeadline() : "";
                    var     vActions  = hasV2 ? LangActions()  : new List<ActionItem>();
                    AnalysisContext? vCtx = hasV2 ? LangContext() : null;
                    (string v2Verdict, string v2VerdictClass) =
                        hasV2 ? VerdictLabel(_summary.Verdict) : ("", "");

                    string lgSummary           = !hasV2 ? LangText(s => s.Summary,           _summary.Summary)           : "";
                    string lgPurpose           = !hasV2 ? LangText(s => s.Purpose,           _summary.Purpose)           : "";
                    string lgTestConditions    = !hasV2 ? LangText(s => s.TestConditions,    _summary.TestConditions)    : "";
                    string lgKeyFindings       = !hasV2 ? LangText(s => s.KeyFindings,       _summary.KeyFindings)       : "";
                    string lgDecision          = !hasV2 ? LangText(s => s.Decision,          _summary.Decision)          : "";
                    string lgRootCause         = !hasV2 ? LangText(s => s.RootCause,         _summary.RootCause)         : "";
                    string lgRecommendedAction = !hasV2 ? LangText(s => s.RecommendedAction, _summary.RecommendedAction) : "";
                    (string lgVerdict, string lgVerdictClass) =
                        !hasV2 ? ParseVerdict(lgDecision) : ("", "");

                    var topNumbers = !hasV2 ? TakeBullets(lgKeyFindings, 3).ToList() : new List<string>();
                    var topActions = !hasV2 ? TakeBullets(lgRecommendedAction, 2).ToList() : new List<string>();

                    // v2 dashboard pre-resolve
                    EvidenceRow? hero = hasV2 && _summary.Evidence.Count > 0 ? _summary.Evidence[0] : null;
                    bool anyNote     = hasV2 && _summary.Evidence.Take(4).Any(e => !string.IsNullOrEmpty(e.Note));

                    // v7 reportType branching
                    string reportType = (_summary.ReportType ?? "").Trim().ToLowerInvariant();
                    bool isMultiArm   = reportType == "multi_arm";
                    bool isDoe        = reportType == "doe_factorial";
                    bool isReliab     = reportType == "reliability_validation";
                    bool isTrend      = reportType == "trend_analysis";
                    bool isQualityLog = reportType == "quality_log";
                    (string rtLabel, string rtClass) = ReportTypeBadge(_summary.ReportType);
                }
                @if (hasV2)
                {
                    @* Side-panel dashboard layout: left aside = at-a-glance KPIs,
                       right main = evidence grid + actions + context. *@
                    <div class="didet-dash">
                        <aside class="didet-dash-side">
                            @* quality_log hides the verdict chip — there's no judgement to make. *@
                            @if (!isQualityLog && !string.IsNullOrEmpty(v2Verdict))
                            {
                                <span class="didet-verdict didet-verdict-lg @v2VerdictClass">@v2Verdict</span>
                            }
                            @if (!string.IsNullOrEmpty(rtLabel))
                            {
                                <span class="didet-rt-badge @rtClass" title="Report type">@rtLabel</span>
                            }
                            @if (hero is not null && !isQualityLog)
                            {
                                <div class="didet-kpi-hero">
                                    <div class="didet-kpi-value @DeltaClass(hero.DeltaSign)">@hero.DeltaText</div>
                                    <div class="didet-kpi-label">@hero.Metric</div>
                                </div>
                            }
                            <div class="didet-kpi-meta">
                                <div><span class="didet-kpi-meta-n">@_summary.Evidence.Count</span> metrics</div>
                                <div><span class="didet-kpi-meta-n">@_summary.Actions.Count</span> actions</div>
                            </div>
                            @if (!string.IsNullOrEmpty(vHeadline))
                            {
                                <div class="didet-dash-headline">@vHeadline</div>
                            }
                            @if (_summary.Tags.Count > 0)
                            {
                                <div class="didet-tags didet-tags-side">
                                    @foreach (var t in _summary.Tags)
                                    {
                                        <span class="didet-tag">🏷 @t</span>
                                    }
                                </div>
                            }
                        </aside>
                        <main class="didet-dash-main">
                            @if (_summary.Evidence.Count > 0)
                            {
                                <div class="didet-dash-section-title">📊 Evidence</div>
                                <div class="didet-evidence-wrap">
                                    <table class="didet-evidence">
                                        <thead>
                                            <tr>
                                                <th>Metric</th>
                                                <th>Baseline</th>
                                                <th>Variant</th>
                                                <th class="n">Δ</th>
                                                @if (anyNote) { <th>Note</th> }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var ev in _summary.Evidence.Take(4))
                                            {
                                                @if (ev.Comparisons is { Count: > 0 })
                                                {
                                                    @* multi-arm row: one metric + N comparisons stacked in a single cell *@
                                                    <tr>
                                                        <td class="didet-ev-metric">
                                                            @ev.Metric
                                                            @if (!string.IsNullOrEmpty(ev.DeltaText))
                                                            {
                                                                <div class="didet-ev-range">@ev.DeltaText</div>
                                                            }
                                                        </td>
                                                        <td colspan="@(anyNote ? 4 : 3)">
                                                            <div class="didet-ev-comparisons">
                                                                @foreach (var c in ev.Comparisons)
                                                                {
                                                                    <div class="didet-ev-comp @(c.IsBest ? "didet-comp-best" : "") @(c.IsWorst ? "didet-comp-worst" : "") @(c.IsBaseline ? "didet-comp-baseline" : "")">
                                                                        <span class="didet-ev-comp-label">@c.Label</span>
                                                                        <span class="didet-ev-comp-val">@c.Value</span>
                                                                        @if (c.N > 0) { <span class="didet-ev-comp-n">n=@c.N</span> }
                                                                        @if (c.IsBaseline) { <span class="didet-ev-comp-flag baseline">base</span> }
                                                                        @if (c.IsBest)     { <span class="didet-ev-comp-flag best">best</span> }
                                                                        @if (c.IsWorst)    { <span class="didet-ev-comp-flag worst">worst</span> }
                                                                    </div>
                                                                }
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td class="didet-ev-metric">@ev.Metric</td>
                                                        <td>
                                                            @if (!string.IsNullOrEmpty(ev.BaselineLabel))
                                                            {
                                                                <div class="didet-ev-label">@ev.BaselineLabel</div>
                                                            }
                                                            <div class="didet-ev-val">@ev.BaselineValue</div>
                                                        </td>
                                                        <td>
                                                            @if (!string.IsNullOrEmpty(ev.VariantLabel))
                                                            {
                                                                <div class="didet-ev-label">@ev.VariantLabel</div>
                                                            }
                                                            <div class="didet-ev-val">@ev.VariantValue</div>
                                                        </td>
                                                        <td class="n didet-ev-delta @DeltaClass(ev.DeltaSign)">@ev.DeltaText</td>
                                                        @if (anyNote)
                                                        {
                                                            <td class="didet-ev-note-cell">@ev.Note</td>
                                                        }
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }

                            @if (isDoe && _summary.DoeGrid is not null && _summary.DoeGrid.Factor1Levels.Count > 0 && _summary.DoeGrid.Factor2Levels.Count > 0)
                            {
                                @* DOE 2-D mini grid. Cells are coloured by status. *@
                                <div class="didet-dash-section-title">🔬 DOE Grid — @_summary.DoeGrid.Factor1Name × @_summary.DoeGrid.Factor2Name</div>
                                <div class="didet-doe-wrap">
                                    <table class="didet-doe">
                                        <thead>
                                            <tr>
                                                <th></th>
                                                @foreach (var f2 in _summary.DoeGrid.Factor2Levels)
                                                {
                                                    <th>@(_summary.DoeGrid.Factor2Name)=@f2</th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var f1 in _summary.DoeGrid.Factor1Levels)
                                            {
                                                <tr>
                                                    <th>@(_summary.DoeGrid.Factor1Name)=@f1</th>
                                                    @foreach (var f2 in _summary.DoeGrid.Factor2Levels)
                                                    {
                                                        var cell = _summary.DoeGrid.Cells.FirstOrDefault(c => c.F1 == f1 && c.F2 == f2);
                                                        var status = (cell?.Status ?? "empty").ToLowerInvariant();
                                                        <td class="didet-doe-cell didet-doe-@status" title="@cell?.Value">
                                                            @(cell?.Value ?? "—")
                                                        </td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }

                            @if (isTrend && _summary.TrendPoints is { Count: > 0 })
                            {
                                <div class="didet-dash-section-title">📈 Trend</div>
                                <ol class="didet-trend">
                                    @foreach (var p in _summary.TrendPoints.Take(12))
                                    {
                                        <li>
                                            <span class="didet-trend-label">@p.Label</span>
                                            <span class="didet-trend-value">@p.Value</span>
                                            @if (!string.IsNullOrEmpty(p.Note))
                                            {
                                                <span class="didet-trend-note">@p.Note</span>
                                            }
                                        </li>
                                    }
                                </ol>
                            }

                            @if (vActions.Count > 0)
                            {
                                <div class="didet-dash-section-title">✅ Actions</div>
                                <ol class="didet-actions">
                                    @foreach (var a in vActions.OrderBy(x => x.Priority).Take(3))
                                    {
                                        <li class="didet-action-@(a.Kind?.ToLowerInvariant() ?? "action")">
                                            <span class="didet-action-kind">@KindGlyph(a.Kind)</span>
                                            <span class="didet-action-text">@a.Text</span>
                                        </li>
                                    }
                                </ol>
                            }

                            @if (vCtx is not null &&
                                 (!string.IsNullOrEmpty(vCtx.Process) ||
                                  !string.IsNullOrEmpty(vCtx.Stage)   ||
                                  !string.IsNullOrEmpty(vCtx.BaselineReason)))
                            {
                                <button class="didet-show-details" @onclick="() => _showContext = !_showContext">
                                    @(_showContext ? "▴ Hide context" : "▾ Context")
                                </button>
                                @if (_showContext)
                                {
                                    <dl class="didet-context">
                                        @if (!string.IsNullOrEmpty(vCtx.Process))
                                        {
                                            <dt>Process</dt><dd>@vCtx.Process</dd>
                                        }
                                        @if (!string.IsNullOrEmpty(vCtx.Stage))
                                        {
                                            <dt>Stage</dt><dd>@vCtx.Stage</dd>
                                        }
                                        @if (!string.IsNullOrEmpty(vCtx.BaselineReason))
                                        {
                                            <dt>Baseline</dt><dd>@vCtx.BaselineReason</dd>
                                        }
                                    </dl>
                                }
                            }
                        </main>
                    </div>
                }
                else
                {
                    <div class="didet-verdict-row">
                        @if (!string.IsNullOrEmpty(lgVerdict))
                        {
                            <span class="didet-verdict @lgVerdictClass">@lgVerdict</span>
                        }
                        @if (!string.IsNullOrEmpty(lgSummary))
                        {
                            <span class="didet-card-conclusion">@lgSummary</span>
                        }
                    </div>
                    @if (topNumbers.Count > 0)
                    {
                        <ul class="didet-card-list">
                            @foreach (var b in topNumbers) { <li>@b</li> }
                        </ul>
                    }
                    @if (topActions.Count > 0)
                    {
                        <ul class="didet-card-list didet-card-actions">
                            @foreach (var b in topActions) { <li>@b</li> }
                        </ul>
                    }
                    <button class="didet-show-details" @onclick="() => _showFullSummary = !_showFullSummary">
                        @(_showFullSummary ? "▴ Hide details" : "▾ Show details (legacy view)")
                    </button>
                    @if (_showFullSummary)
                    {
                        @if (!string.IsNullOrEmpty(lgPurpose))
                        {
                            <div class="didet-field"><div class="didet-field-label">① Test Goal</div>
                                <pre class="didet-bullet-block">@lgPurpose</pre></div>
                        }
                        @if (!string.IsNullOrEmpty(lgTestConditions))
                        {
                            <div class="didet-field didet-field-setup">
                                <div class="didet-field-label">② Comparison Setup (baseline vs variant)</div>
                                <pre class="didet-bullet-block">@lgTestConditions</pre>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(lgKeyFindings))
                        {
                            <div class="didet-field"><div class="didet-field-label">③ Key Numbers (full)</div>
                                <pre class="didet-bullet-block">@lgKeyFindings</pre></div>
                        }
                        @if (!string.IsNullOrEmpty(lgDecision))
                        {
                            <div class="didet-field didet-field-effect">
                                <div class="didet-field-label">④ Effect</div>
                                <pre class="didet-bullet-block">@lgDecision</pre>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(lgRootCause))
                        {
                            <div class="didet-field"><div class="didet-field-label">⑤ Motivation / Cause</div>
                                <pre class="didet-bullet-block">@lgRootCause</pre></div>
                        }
                        @if (!string.IsNullOrEmpty(lgRecommendedAction))
                        {
                            <div class="didet-field"><div class="didet-field-label">⑥ Actions / Risks (full)</div>
                                <pre class="didet-bullet-block">@lgRecommendedAction</pre></div>
                        }
                    }
                }

                @if (!hasV2 && _summary.Tags.Count > 0)
                {
                    @* v2 dashboard renders tags in the side aside; this fallback
                       is only for legacy 7-field cards. *@
                    <div class="didet-tags">
                        @foreach (var t in _summary.Tags)
                        {
                            <span class="didet-tag">🏷 @t</span>
                        }
                    </div>
                }
            </section>
        }

        @* ── Correlation: Line × CheckType heatmap of NG% averages.
             Computed locally from _measurements; no backend round-trip.
             Skip 1×N or N×1 matrices (a "heatmap" of a single column is just
             a list and adds visual noise). Collapsed by default. ── *@
        @if (_corrCells.Count > 0 && _corrLines.Count >= 2 && _corrCheckTypes.Count >= 2)
        {
            <section class="didet-card didet-collapsible">
                <button class="didet-section-toggle" @onclick="() => _showHeatmap = !_showHeatmap">
                    <span>🌡 @_corrRowLabel × @_corrColLabel — avg NG%</span>
                    <span class="didet-section-arrow">@(_showHeatmap ? "▴" : "▾")</span>
                </button>
                @if (_showHeatmap)
                {
                <div class="didet-table-wrap">
                    <table class="didet-heatmap">
                        <thead>
                            <tr>
                                <th></th>
                                @foreach (var c in _corrCheckTypes)
                                {
                                    <th>@c</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in _corrLines)
                            {
                                <tr>
                                    <th>@line</th>
                                    @foreach (var c in _corrCheckTypes)
                                    {
                                        var key = (line, c);
                                        if (_corrCells.TryGetValue(key, out var v))
                                        {
                                            <td title="@v.RowCount measurement row(s)" style="background:@HeatColor(v.AvgNg);">
                                                <div class="didet-heat-pct">@v.AvgNg.ToString("F1")%</div>
                                                <div class="didet-heat-ratio">(@v.NgSum.ToString("N0")/@v.InputSum.ToString("N0"))</div>
                                                @if (v.Defects.Count > 1)
                                                {
                                                    <div class="didet-heat-defects">
                                                        @foreach (var d in v.Defects.Take(5))
                                                        {
                                                            <div>@d.Type: @d.Count.ToString("N0")</div>
                                                        }
                                                        @if (v.Defects.Count > 5)
                                                        {
                                                            <div>+@(v.Defects.Count - 5) more</div>
                                                        }
                                                    </div>
                                                }
                                            </td>
                                        }
                                        else
                                        {
                                            <td class="didet-heat-empty">—</td>
                                        }
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="didet-heat-legend">
                    <span style="background:@HeatColor(0.0);">0%</span>
                    <span style="background:@HeatColor(2.5);">2.5%</span>
                    <span style="background:@HeatColor(5.0);">5%</span>
                    <span style="background:@HeatColor(10.0);">10%+</span>
                </div>
                }
            </section>
        }

        @if (_measurements.Count > 0)
        {
            <section class="didet-card didet-collapsible">
                <button class="didet-section-toggle" @onclick="() => _showMeasurements = !_showMeasurements">
                    <span>📐 Extracted Measurements — @_measurements.Count row(s)</span>
                    <span class="didet-section-arrow">@(_showMeasurements ? "▴" : "▾")</span>
                </button>
                @if (_showMeasurements)
                {
                <div class="didet-table-wrap">
                    <table class="didet-table">
                        <thead>
                            <tr>
                                <th>Variable</th>
                                <th>Group</th>
                                <th>Line</th>
                                <th>CheckType</th>
                                <th>Input</th>
                                <th>NG</th>
                                <th>NG%</th>
                                <th>Defect Type</th>
                                <th>Category</th>
                                <th>Count</th>
                                <th>Intervention</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in _measurements)
                            {
                                <tr>
                                    <td>@m.Variable</td>
                                    <td>@m.VariableGroup</td>
                                    <td>@m.Line</td>
                                    <td>@m.CheckType</td>
                                    <td class="n">@m.InputQty</td>
                                    <td class="n">@m.NgTotal</td>
                                    <td class="n">@m.NgRate.ToString("F1")%</td>
                                    <td>@m.DefectType</td>
                                    <td>@m.DefectCategory</td>
                                    <td class="n">@m.DefectCount</td>
                                    <td>@m.Intervention</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                }
            </section>
        }

        @if (_images.Count > 0)
        {
            <section class="didet-card didet-collapsible">
                <button class="didet-section-toggle" @onclick="() => _showImages = !_showImages">
                    <span>🖼 Analysis Images (@_images.Count)</span>
                    <span class="didet-section-arrow">@(_showImages ? "▴" : "▾")</span>
                </button>
                @if (_showImages)
                {
                <div class="didet-imgs-grid">
                    @foreach (var (img, idx) in _images.Select((x, i) => (x, i)))
                    {
                        <div class="didet-img-thumb" @onclick="() => OpenViewer(img.DataUrl)">
                            <img src="@img.DataUrl" alt="@img.FileName" loading="lazy" />
                            <div class="didet-img-num">@(idx + 1)</div>
                        </div>
                    }
                </div>
                }
            </section>
        }

        @if (_files.Count > 0)
        {
            <section class="didet-card">
                <div class="didet-card-title">📎 Backup Files (@_files.Count)</div>
                <div class="didet-files">
                    @foreach (var f in _files)
                    {
                        <a class="didet-file-chip" href="/data-inference/file/@f.Id" download="@f.FileName" target="_blank">
                            <span>📄</span>
                            <span class="didet-file-name" title="@f.FileName">@f.FileName</span>
                            <span class="didet-file-size">@FormatSize(f.FileSize)</span>
                        </a>
                    }
                </div>
            </section>
        }
    </div>
}

@if (_viewerUrl is not null)
{
    <div class="didet-viewer" @onclick="() => _viewerUrl = null">
        <img src="@_viewerUrl" @onclick:stopPropagation="true" />
        <button class="didet-viewer-close" @onclick="() => _viewerUrl = null">✕</button>
    </div>
}

</div>

<style>
    .didet-root {
        min-height: 100vh; background: var(--panel-2, #f5f6f9); padding: 20px 24px;
        font-family: 'Segoe UI', sans-serif;
    }
    .didet-empty { padding: 60px; text-align: center; color: var(--ink-3, #7f8a98); font-size: 14px; }
    .didet-header {
        background: var(--panel, #fff); border: 1px solid var(--line, var(--line, #dde1e7)); border-radius: 2px;
        padding: 14px 18px; margin-bottom: 14px;
    }
    .didet-title { font-size: 17px; font-weight: 700; color: var(--ink, #0f1319); margin-bottom: 6px; }
    .didet-meta  { display: flex; flex-wrap: wrap; gap: 6px; }
    .didet-chip  {
        display: inline-flex; align-items: center; padding: 2px 10px;
        border-radius: 2px; font-size: 11px; font-weight: 600;
        background: var(--panel-3, #eceef2); color: var(--ink-2, #4a5461);
    }
    .didet-chip-prod { background: var(--signal-wash, #edf0f4); color: var(--signal, #16202b); }
    .didet-chip-dim  { background: transparent; color: var(--ink-3, #7f8a98); font-weight: 500; }

    .didet-body { display: flex; flex-direction: column; gap: 12px; }
    .didet-card {
        background: var(--panel, #fff); border: 1px solid var(--line, var(--line, #dde1e7)); border-radius: 2px;
        padding: 14px 18px;
    }
    .didet-card-title { font-size: 13px; font-weight: 700; color: var(--ink, #0f1319); margin-bottom: 8px; }

    /* Collapsible sub-section header — replaces the title in cards whose body
       is heavy enough that it should be opt-in (heatmap / raw rows / images). */
    .didet-collapsible { padding: 0; }
    .didet-collapsible > .didet-section-toggle { width: 100%; }
    .didet-collapsible > .didet-section-toggle ~ * { padding-left: 18px; padding-right: 18px; }
