@code {
    private sealed record ImgThumb(string MediaType, string DataUrl, string FileName);

    [Parameter, SupplyParameterFromQuery] public string? Name { get; set; }

    private RawReportInfo?              _info         = null;
    private DatasetSummaryRecord?       _summary      = null;
    private List<NormalizedMeasurement> _measurements = [];
    private List<ImgThumb>              _images       = [];
    private List<RawFileInfo>           _files        = [];
    private string?                     _viewerUrl    = null;

    // Lang picker. Default "en" = the original analysis output.
    private string                      _lang         = "en";

    // Compact card by default; full 7-field detail behind toggle.
    private bool _showFullSummary;
    // v2: context block (process/stage/baselineReason) is hidden by default
    private bool _showContext;

    // Below-the-fold sections collapsed by default to keep the page short
    // for pass-style reports (where heatmap / raw rows / hundreds of images
    // add no decision-relevant info).
    private bool _showHeatmap;
    private bool _showMeasurements;
    private bool _showImages;

    private static IEnumerable<string> TakeBullets(string field, int n)
    {
        if (string.IsNullOrWhiteSpace(field)) yield break;
        int count = 0;
        foreach (var raw in field.Split('\n'))
        {
            string s = raw.Trim();
            if (s.Length == 0) continue;
            yield return s;
            if (++count >= n) yield break;
        }
    }

    private static (string Label, string CssClass) ParseVerdict(string decision)
    {
        if (string.IsNullOrWhiteSpace(decision)) return ("", "");
        string first = decision.Split('\n', 2)[0].Trim();
        string head = new string(first.TakeWhile(c => char.IsLetter(c) || c == '_').ToArray())
            .ToLowerInvariant();
        return VerdictLabel(head);
    }

    /// <summary>Map the v7 verdict enum to a UI label + CSS class.</summary>
    private static (string Label, string CssClass) VerdictLabel(string verdict)
    {
        string head = (verdict ?? "").Trim().ToLowerInvariant();
        return head switch
        {
            "improved"        => ("IMPROVED",        "didet-v-good"),
            "worsened"        => ("WORSENED",        "didet-v-bad"),
            "partial"         => ("PARTIAL",         "didet-v-partial"),
            "no_clear_effect" => ("NO CLEAR EFFECT", "didet-v-neutral"),
            "inconclusive"    => ("INCONCLUSIVE",    "didet-v-neutral"),
            "unclear"         => ("UNCLEAR",         "didet-v-neutral"),
            "passed"          => ("PASSED",          "didet-v-good"),
            "failed"          => ("FAILED",          "didet-v-bad"),
            ""                => ("", ""),
            _                 => (head.ToUpperInvariant(), "didet-v-neutral"),
        };
    }

    /// <summary>UI badge for reportType — small chip beside verdict.</summary>
    private static (string Label, string CssClass) ReportTypeBadge(string rt)
    {
        string head = (rt ?? "").Trim().ToLowerInvariant();
        return head switch
        {
            "comparison_study"       => ("Compare",      "didet-rt-default"),
            "multi_arm"              => ("Multi-arm",    "didet-rt-multi"),
            "doe_factorial"          => ("DOE",          "didet-rt-doe"),
            "reliability_validation" => ("Reliability",  "didet-rt-reli"),
            "trend_analysis"         => ("Trend",        "didet-rt-trend"),
            "quality_log"            => ("Log",          "didet-rt-log"),
            "intervention_test"      => ("Intervention", "didet-rt-default"),
            ""                       => ("", ""),
            _                        => (head, "didet-rt-default"),
        };
    }

    private static string DeltaClass(string sign) => (sign ?? "").ToLowerInvariant() switch
    {
        "down"      => "didet-ev-down",
        "up"        => "didet-ev-up",
        "no_change" => "didet-ev-flat",
        _           => "",
    };

    private static string KindGlyph(string kind) => (kind ?? "").ToLowerInvariant() switch
    {
        "investigate" => "🔍",
        "risk"        => "⚠",
        _             => "→",
    };

    /// <summary>Picks the v2 headline for the active language (falls back to en).</summary>
    private string LangHeadline()
    {
        if (_summary is null) return "";
        if (_lang != "en" && _summary.Translations.TryGetValue(_lang, out var tr)
            && !string.IsNullOrWhiteSpace(tr.Headline))
            return tr.Headline;
        return _summary.Headline ?? "";
    }

    /// <summary>Picks the v2 actions for the active language (falls back to en).</summary>
    private List<ActionItem> LangActions()
    {
        if (_summary is null) return [];
        if (_lang != "en" && _summary.Translations.TryGetValue(_lang, out var tr)
            && tr.Actions is { Count: > 0 })
            return tr.Actions;
        return _summary.Actions ?? [];
    }

    /// <summary>Picks the v2 context for the active language (falls back to en).</summary>
    private AnalysisContext? LangContext()
    {
        if (_summary is null) return null;
        if (_lang != "en" && _summary.Translations.TryGetValue(_lang, out var tr) && tr.Context is not null)
            return tr.Context;
        return _summary.Context;
    }
    private List<(string Code, string Label)> _availableLangs = [];

    // Correlation pivot data: (row, col) → aggregate NG counts.
    // Per cell: NgSum and InputSum are the totals across all measurement rows
    // that fell into this bucket; AvgNg is NgSum/InputSum*100 (a weighted
    // ratio that lines up with the (NG/Input) numbers shown next to the %).
    // Defects: per-DefectType count, sorted desc — surfaces in cells with >1
    // defect type so the user can see the breakdown at a glance.
    private List<string> _corrLines      = [];
    private List<string> _corrCheckTypes = [];
    private Dictionary<(string Row, string Col),
                       (double AvgNg, long NgSum, long InputSum, int RowCount,
                        List<(string Type, long Count)> Defects)> _corrCells = new();

    protected override void OnParametersSet() => Load();

    private void Load()
    {
        _info = null; _summary = null; _measurements = []; _images = []; _files = [];
        if (string.IsNullOrWhiteSpace(Name)) return;

        _info = Repo.GetAllRawReports().FirstOrDefault(r => r.DatasetName == Name);
        if (_info is null) return;

        _summary      = Repo.GetDatasetSummaryRecord(Name);
        _measurements = Repo.GetNormalizedMeasurements(Name);
        _images       = Repo.GetRawReportImages(Name).Select((img, i) =>
        {
            string b64     = Convert.ToBase64String(img.Data);
            string dataUrl = $"data:{img.MediaType};base64,{b64}";
            string fname   = img.FileName.Length > 0 ? img.FileName : $"img-{i + 1}";
            return new ImgThumb(img.MediaType, dataUrl, fname);
        }).ToList();
        _files = Repo.GetRawReportFileInfos(Name);

        // Lang picker: always offer "en" (the base record). ko/vi only when
        // the translations table actually has them for this dataset.
        _availableLangs = [("en", "EN")];
        if (_summary is not null)
        {
            if (_summary.Translations.ContainsKey("ko")) _availableLangs.Add(("ko", "한국어"));
            if (_summary.Translations.ContainsKey("vi")) _availableLangs.Add(("vi", "Tiếng Việt"));
        }
        if (!_availableLangs.Any(l => l.Code == _lang)) _lang = "en";

        BuildCorrelationPivot();
    }

    /// <summary>Pivot _measurements into a 2-D heatmap of avg NG%. The two
    /// dimensions are auto-picked: prefer the (categorical) fields with the
    /// most variation. We try (Variable × Group) first because most of our
    /// reports compare baseline groups (normal/before/test/after) within a
    /// model variant — that matches the design.md "baseline vs variant"
    /// intent. Falls back to (Line × CheckType) if Variable/Group are too
    /// uniform. Empty values bucket under "(none)" but if EVERY row in a
    /// dimension is "(none)" we drop that dimension and try the next pair.</summary>
    private void BuildCorrelationPivot()
    {
        _corrLines.Clear(); _corrCheckTypes.Clear(); _corrCells.Clear();
        if (_measurements.Count == 0) return;

        // Candidate axis pairs in priority order. Each tuple: row-getter, col-getter, label-pair.
        var candidates = new (Func<NormalizedMeasurement, string> Row,
                              Func<NormalizedMeasurement, string> Col,
                              string RowLabel, string ColLabel)[]
        {
            (m => m.Variable,      m => m.VariableGroup, "Variable",  "Group"),
            (m => m.Line,          m => m.CheckType,     "Line",      "CheckType"),
            (m => m.VariableGroup, m => m.CheckType,     "Group",     "CheckType"),
        };

        foreach (var (getRow, getCol, rowLbl, colLbl) in candidates)
        {
            var byCell = new Dictionary<(string, string), (long NgSum, long InputSum, int N)>();
            var byDefect = new Dictionary<(string, string), Dictionary<string, long>>();
            var rowSet = new HashSet<string>(); var colSet = new HashSet<string>();

            foreach (var m in _measurements)
            {
                if (m.InputQty <= 0) continue;
                string r = string.IsNullOrWhiteSpace(getRow(m)) ? "(none)" : getRow(m).Trim();
                string c = string.IsNullOrWhiteSpace(getCol(m)) ? "(none)" : getCol(m).Trim();
                rowSet.Add(r); colSet.Add(c);
                byCell.TryGetValue((r, c), out var acc);
                byCell[(r, c)] = (acc.NgSum + m.NgTotal, acc.InputSum + m.InputQty, acc.N + 1);

                // Track per-defect-type counts within this cell. Skip empty
                // defect rows (header / aggregate-only entries).
                if (!string.IsNullOrWhiteSpace(m.DefectType) && m.DefectCount > 0)
                {
                    if (!byDefect.TryGetValue((r, c), out var d))
                        byDefect[(r, c)] = d = new(StringComparer.OrdinalIgnoreCase);
                    string dt = m.DefectType.Trim();
                    d.TryGetValue(dt, out long prev);
                    d[dt] = prev + m.DefectCount;
                }
            }

            // Need at least 2 non-empty values along EACH axis for the heatmap
            // to be informative — a 1×N or N×1 matrix is just a bar chart in
            // disguise. Try the next candidate pair.
            int rowsWithValue = rowSet.Count(s => s != "(none)");
            int colsWithValue = colSet.Count(s => s != "(none)");
            if (rowsWithValue < 2 && colsWithValue < 2) continue;

            _corrLines      = rowSet.OrderBy(s => s).ToList();
            _corrCheckTypes = colSet.OrderBy(s => s).ToList();
            foreach (var (key, val) in byCell)
            {
                double pct = val.InputSum > 0 ? (100.0 * val.NgSum / val.InputSum) : 0;
                var defects = byDefect.TryGetValue(key, out var d)
                    ? d.Select(kv => (kv.Key, kv.Value)).OrderByDescending(x => x.Value).ToList()
                    : new List<(string, long)>();
                _corrCells[key] = (pct, val.NgSum, val.InputSum, val.N, defects);
            }
            _corrRowLabel = rowLbl;
            _corrColLabel = colLbl;
            return;
        }

        // No candidate had enough variation — leave _corrCells empty so the UI
        // hides the heatmap.
    }

    private string _corrRowLabel = "Variable";
    private string _corrColLabel = "Group";

    /// <summary>Resolve a single field for the active language: fall back to
    /// the original (en) value when the translation is missing/empty.</summary>
    private string LangText(Func<DatasetSummaryTranslation, string> pick, string original)
    {
        if (_lang == "en" || _summary is null) return original;
        if (_summary.Translations.TryGetValue(_lang, out var tr))
        {
            string v = pick(tr);
            if (!string.IsNullOrWhiteSpace(v)) return v;
        }
        return original;
    }

    /// <summary>Map an NG% value to a CSS color along a green→yellow→red ramp.
    /// 0% = green, 5% = yellow, ≥10% = red. Anything below 10% gets clamped
    /// onto the gradient.</summary>
    private static string HeatColor(double ngPercent)
    {
        double t = Math.Clamp(ngPercent / 10.0, 0.0, 1.0);
        // green (#16a34a) → yellow (#facc15) → red (#dc2626)
        (int r, int g, int b) = t < 0.5
            ? Lerp((22,163,74),  (250,204,21),  t * 2.0)
            : Lerp((250,204,21), (220,38,38),   (t - 0.5) * 2.0);
        return $"rgb({r},{g},{b})";

        static (int r, int g, int b) Lerp((int r,int g,int b) a, (int r,int g,int b) b2, double t)
            => (
                (int)Math.Round(a.r + (b2.r - a.r) * t),
                (int)Math.Round(a.g + (b2.g - a.g) * t),
                (int)Math.Round(a.b + (b2.b - a.b) * t)
            );
    }

    private void OpenViewer(string dataUrl) => _viewerUrl = dataUrl;

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / 1024.0 / 1024.0:F1} MB";
    }

    private static string FormatDate(string iso)
    {
        if (DateTime.TryParse(iso, null, System.Globalization.DateTimeStyles.RoundtripKind, out DateTime dt))
            return dt.ToLocalTime().ToString("yyyy-MM-dd HH:mm");
        return iso;
    }
