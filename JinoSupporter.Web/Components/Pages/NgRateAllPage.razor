@page "/ng-rate-all"
@rendermode InteractiveServer
@* TODO: NG Rate All - copy of NgRatePage.razor, to be customised later. Admin-only. *@
@using JinoSupporter.Web.Services
@inject NgRateService         NgRate
@inject NgRateSettingsService NgRateSettings
@inject NgRateReportService   NgRateReport
@inject WebRepository         Repo
@inject IJSRuntime            JS
@inject AppActivityLogger     Activity
@implements IAsyncDisposable

<PageTitle>NG Rate</PageTitle>

<NgRateReportStyles />
<NgRateViewNav CurrentView="by-section" />

<NgRateSetupPanel StartDate="@_startDate"
                  StartDateChanged="@((DateTime d) => _startDate = d)"
                  EndDate="@_endDate"
                  EndDateChanged="@((DateTime d) => _endDate = d)"
                  IsBusy="@_isBusy"
                  IsReportBusy="@_isReportBusy"
                  IsCredentialsConfigured="@NgRateSettings.IsCredentialsConfigured"
                  LoginId="@NgRateSettings.LoginId"
                  SavedDbPath="@_savedDbPath"
                  ErrorMessage="@_errorMessage"
                  LogElementId="@LogElementId"
                  Logs="@_logs"
                  HasSuccessfulResult="@(_savedDbPath is not null || _reports.Count > 0)"
                  OnSetToday="SetToday"
                  OnClearResult="ClearResult"
                  OnClearLogs="@(() => _logs.Clear())">
    <GroupPicker>
        <NgRateModelGroupPicker Groups="@_dbGroups"
                                SelectedGroupIds="@_selectedGroupIds"
                                SelectedSubEntries="@_selectedSubEntries"
                                ActiveProductGroup="@_activePg"
                                ActiveProductGroupChanged="@((string pg) => _activePg = pg)"
                                ChildEntryProvider="@ModelGroupPickerHelpers.EnumerateMidEntries"
                                IsBusy="@_isBusy"
                                IsReportBusy="@_isReportBusy"
                                IsCredentialsConfigured="@NgRateSettings.IsCredentialsConfigured"
                                ReportError="@_reportError"
                                OnRefresh="RefreshGroups"
                                OnToggleGroup="ToggleGroup"
                                OnToggleSubEntry="ToggleSubEntry"
                                OnGetReport="GetReportAsync" />
    </GroupPicker>
</NgRateSetupPanel>

@if (_reports.Count > 0)
{
    <div class="mt-4">

        <!-- Section tabs (defect report type) + global controls + Export -->
        <div class="d-flex align-items-end justify-content-between mb-0 flex-wrap gap-2">
            <ul class="nav nav-tabs mb-0" style="border-bottom:none;">
                @foreach (var s in SectionTabs)
                {
                    string sk = s.Key;
                    bool active = _activeSection == sk;
                    <li class="nav-item">
                        <button class="nav-link @(active ? "active fw-semibold" : "")"
                                style="font-size:13px; padding:6px 14px;"
                                @onclick="@(() => SwitchSectionAsync(sk))">
                            @s.Label
                        </button>
                    </li>
                }
            </ul>
            <div class="d-flex gap-2 align-items-center">
                @{
                    int maxDateCols  = _reports.Max(r => r.Report.DateCols.Count);
                    int maxWeekCols  = _reports.Max(r => r.Report.WeekCols.Count);
                    int maxMonthCols = _reports.Max(r => r.Report.MonthCols.Count);
                }
                @if (maxDateCols > DateVisibleLimit)
                {
                    <button class="expand-btn" @onclick="ToggleDateCols">
                        Date @(_dateExpanded ? "Collapse" : $"+{maxDateCols - DateVisibleLimit}")
                    </button>
                }
                @if (maxWeekCols > WeekVisibleLimit)
                {
                    <button class="expand-btn" @onclick="ToggleWeekCols">
                        Week @(_weekExpanded ? "Collapse" : $"+{maxWeekCols - WeekVisibleLimit}")
                    </button>
                }
                @if (maxMonthCols > MonthVisibleLimit)
                {
                    <button class="expand-btn" @onclick="ToggleMonthCols">
                        Month @(_monthExpanded ? "Collapse" : $"+{maxMonthCols - MonthVisibleLimit}")
                    </button>
                }
                <button class="btn btn-outline-success btn-sm"
                        style="font-size:12px;"
                        @onclick="ExportExcelAsync"
                        disabled="@_isExporting">
                    @if (_isExporting)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    }
                    else
                    {
                        <span>Export Excel</span>
                    }
                </button>
                <button class="btn btn-link btn-sm p-0 text-secondary"
                        @onclick="ClearReportAsync">Clear</button>
            </div>
        </div>
        <div style="border-top:2px solid #e2e8f0; margin-bottom:12px;"></div>

        <!-- Hierarchy Summary: Group -> Mid -> Sub1 -> Sub2 -> LineShift -->
        @if (_hier is not null && _hier.HasData && _reports.Count > 0)
        {
            var hierDateCols  = GetVisibleDateCols(_reports[0].Report).ToList();
            var hierWeekCols  = GetVisibleWeekCols(_reports[0].Report).ToList();
            var hierMonthCols = GetVisibleMonthCols(_reports[0].Report).ToList();
            <div class="card mb-3 shadow-sm">
                <div class="card-header small fw-semibold">
                    Group -> Model -> Line -> Shift - TOTAL PPM (collapsible)
                </div>
                <div class="card-body p-0">
                    <div class="pivot-wrap">
                        <table class="pivot-table text-fit-table">
                            <thead>
                                <tr>
                                    <th class="label-th" style="min-width:280px;" rowspan="2">Group / Model / Line / Shift</th>
                                    @if (hierDateCols.Count > 0)
                                    {
                                        <th class="blk-date" colspan="@hierDateCols.Count">Date</th>
                                        <th class="sep-th" rowspan="2"></th>
                                    }
                                    @if (hierWeekCols.Count > 0)
                                    {
                                        <th class="blk-week" colspan="@hierWeekCols.Count">Week</th>
                                        <th class="sep-th" rowspan="2"></th>
                                    }
                                    @if (hierMonthCols.Count > 0)
                                    {
                                        <th class="blk-month" colspan="@hierMonthCols.Count">Month</th>
                                    }
                                </tr>
                                <tr>
                                    @foreach (var col in hierDateCols)  { <th>@col.Header</th> }
                                    @foreach (var col in hierWeekCols)  { <th>@col.Header</th> }
                                    @foreach (var col in hierMonthCols) { <th>@col.Header</th> }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var g in _hier.Groups)
                                {
                                    string gName = g.Name;
                                    bool gExp    = _hierExpandedGroups.Contains(gName);
                                    var visibleMids = g.MidGroups
                                        .Where(mid => HierMidHasVisibleData(gName, mid, hierDateCols, hierWeekCols, hierMonthCols))
                                        .ToList();
                                    <tr class="hier-group-row" @onclick="() => HierToggleGroup(gName)">
                                        <td class="label-td">
                                            <span class="tog-icon">@(gExp ? "v" : ">")</span>
                                            <strong>@gName</strong>
                                            <span class="text-muted ms-1" style="font-size:10px;">@visibleMids.Count models</span>
                                        </td>
                                        @foreach (var col in hierDateCols)
                                        {
                                            double v = _hierLookup.GroupAvgOfMids(g, col.Key);
                                            <td class="@(v <= 0 ? "ppm-zero" : "ppm-val")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                        }
                                        @if (hierDateCols.Count > 0) { <td class="sep-td"></td> }
                                        @foreach (var col in hierWeekCols)
                                        {
                                            double v = _hierLookup.GroupAvgOfMids(g, col.Key);
                                            <td class="@(v <= 0 ? "ppm-zero" : "ppm-val")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                        }
                                        @if (hierWeekCols.Count > 0) { <td class="sep-td"></td> }
                                        @foreach (var col in hierMonthCols)
                                        {
                                            double v = _hierLookup.GroupAvgOfMids(g, col.Key);
                                            <td class="@(v <= 0 ? "ppm-zero" : "ppm-val")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                        }
                                    </tr>
                                    @if (gExp)
                                    {
                                        @foreach (var mid in visibleMids)
                                        {
                                            string midKey = $"{gName}::{mid.Material}";
                                            bool midExp   = _hierExpandedMids.Contains(midKey);
                                            <tr class="hier-mid-row" @onclick="() => HierToggleMid(midKey)">
                                                <td class="label-td" style="padding-left:32px; font-size:11.5px;">
                                                    <span class="tog-icon">@(midExp ? "v" : ">")</span>
                                                    <span class="ms-1">@mid.Material</span>
                                                </td>
                                                @foreach (var col in hierDateCols)
                                                {
                                                    double v = _hierLookup.MidAvgOfSubs(gName, mid, col.Key);
                                                    <td class="@(v <= 0 ? "ppm-zero" : "ppm-val")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                                }
                                                @if (hierDateCols.Count > 0) { <td class="sep-td"></td> }
                                                @foreach (var col in hierWeekCols)
                                                {
                                                    double v = _hierLookup.MidAvgOfSubs(gName, mid, col.Key);
                                                    <td class="@(v <= 0 ? "ppm-zero" : "ppm-val")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                                }
                                                @if (hierWeekCols.Count > 0) { <td class="sep-td"></td> }
                                                @foreach (var col in hierMonthCols)
                                                {
                                                    double v = _hierLookup.MidAvgOfSubs(gName, mid, col.Key);
                                                    <td class="@(v <= 0 ? "ppm-zero" : "ppm-val")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                                }
                                            </tr>
                                            @if (midExp)
                                            {
                                                <HierSubRows GroupName="@gName" Mid="@mid" Lookup="@_hierLookup"
                                                             DateCols="@hierDateCols" WeekCols="@hierWeekCols" MonthCols="@hierMonthCols"
                                                             Expanded="@_hierExpandedSub1s"
                                                             Sub1RowClass="hier-sub1-row"
                                                             Sub2RowClass="hier-sub2-row"
                                                             LineShiftRowClass="hier-ls-row"
                                                             ExpandableRowClass="hier-sub-expandable" />
                                            }
                                        }
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        <!-- Per-model sections (vertically stacked) -->
        @for (int _mi = 0; _mi < _reports.Count; _mi++)
        {
            int mi      = _mi;
            var rpt     = _reports[mi].Report;
            string lbl  = _reports[mi].Label;
            var dateCols  = GetVisibleDateCols(rpt).ToList();
            var weekCols  = GetVisibleWeekCols(rpt).ToList();
            var monthCols = GetVisibleMonthCols(rpt).ToList();

            <!-- Model header -->
            <div class="d-flex align-items-center gap-2 mb-2 @(mi > 0 ? "mt-4 pt-3 border-top" : "mt-2")">
                <span class="badge bg-secondary" style="font-size:11px;">@(mi + 1)</span>
                <h6 class="mb-0 fw-semibold" style="color:#1e40af;">@lbl</h6>
                <span class="small text-muted ms-1">
                    @Path.GetFileName(rpt.DbPath) |
                    @rpt.TotalRows.ToString("N0") rows |
                    @rpt.GeneratedAt.ToString("HH:mm:ss")
                </span>
            </div>

            @if (_activeSection == "summary")
            {
                <!-- Summary -->
                <div class="card mb-3 shadow-sm">
                    <div class="card-header small fw-semibold d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span>Summary - NG PPM by Process Type</span>
                            @if (rpt.GroupNames.Count > 0)
                            {
                                <div class="d-flex flex-wrap gap-1 ms-1">
                                    @foreach (var grp in rpt.GroupNames)
                                    {
                                        bool groupVisible = !IsSummaryGroupCollapsed(mi, grp);
                                        <span class="group-chip @(groupVisible ? "active" : "")"
                                              title="Toggle this group's rows in the summary table"
                                              @onclick="@(() => ToggleSummaryGroup(mi, grp))">@grp</span>
                                    }
                                </div>
                            }
                        </div>
                        @if (rpt.GroupSummary.Count > 0)
                        {
                            <div class="d-flex gap-2 align-items-center">
                                <button class="expand-btn" @onclick="@(() => ExpandAllSummaryFor(mi))">Expand All</button>
                                <span class="text-muted" style="font-size:10px;">|</span>
                                <button class="expand-btn" @onclick="@(() => CollapseAllSummaryFor(mi))">Collapse All</button>
                            </div>
                        }
                    </div>
                    <div class="card-body p-2">
                        <div class="pivot-wrap">
                            <table class="pivot-table text-fit-table">
                                <thead>
                                    <tr>
                                        <th class="label-th" style="min-width:20px; text-align:center;"></th>
                                        <th class="label-th">Process Type</th>
                                        @foreach (var col in dateCols)  { <th>@col.Header</th> }
                                        <th class="sep-th"></th>
                                        @foreach (var col in weekCols)  { <th>@col.Header</th> }
                                        <th class="sep-th"></th>
                                        @foreach (var col in monthCols) { <th>@col.Header</th> }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var sumRow in rpt.Summary)
                                    {
                                        bool summaryHasGroups = rpt.GroupSummary.Count > 0;
                                        string sumPt          = sumRow.ProcessType;
                                        string sumKey         = $"{mi}|{sumPt}";
                                        bool summaryExpanded  = _expandedSummary.Contains(sumKey);
                                        <tr class="@(sumRow.IsTotal ? "total-row" : "rank-row")">
                                            <td class="toggle-cell" @onclick="@(() => { if (summaryHasGroups) ToggleSummary(mi, sumPt); })">
                                                @if (summaryHasGroups)
                                                {
                                                    <span class="toggle-icon">@(summaryExpanded ? "v" : ">")</span>
                                                }
                                            </td>
                                            <td class="label-td">@sumRow.ProcessType</td>
                                            @foreach (var col in dateCols)
                                            {
                                                double v = sumRow.Ppm.GetValueOrDefault(col.Key);
                                                <td class="@(v <= 0 ? "ppm-zero" : "ppm-val")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                            }
                                            <td class="sep-td"></td>
                                            @foreach (var col in weekCols)
                                            {
                                                double v = sumRow.Ppm.GetValueOrDefault(col.Key);
                                                <td class="@(v <= 0 ? "ppm-zero" : "ppm-val")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                            }
                                            <td class="sep-td"></td>
                                            @foreach (var col in monthCols)
                                            {
                                                double v = sumRow.Ppm.GetValueOrDefault(col.Key);
                                                <td class="@(v <= 0 ? "ppm-zero" : "ppm-val")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                            }
                                        </tr>
                                        @if (summaryExpanded)
                                        {
                                            @foreach (var grp in rpt.GroupNames)
                                            {
                                                if (!IsSummaryGroupCollapsed(mi, grp)
                                                    && rpt.GroupSummary.TryGetValue(grp, out var grpRows))
                                                {
                                                    var grpRow = grpRows.FirstOrDefault(sr => sr.ProcessType == sumPt);
                                                    if (grpRow is not null)
                                                    {
                                                        <tr class="group-row">
                                                            <td></td>
                                                            <td class="label-td group-name-td">@grp</td>
                                                            @foreach (var col in dateCols)
                                                            {
                                                                double v = grpRow.Ppm.GetValueOrDefault(col.Key);
                                                                <td class="@(v <= 0 ? "ppm-zero" : "")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                                            }
                                                            <td class="sep-td"></td>
                                                            @foreach (var col in weekCols)
                                                            {
                                                                double v = grpRow.Ppm.GetValueOrDefault(col.Key);
                                                                <td class="@(v <= 0 ? "ppm-zero" : "")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                                            }
                                                            <td class="sep-td"></td>
                                                            @foreach (var col in monthCols)
                                                            {
                                                                double v = grpRow.Ppm.GetValueOrDefault(col.Key);
                                                                <td class="@(v <= 0 ? "ppm-zero" : "")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                                            }
                                                        </tr>
                                                    }
                                                }
                                            }
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div style="position:relative; height:200px; margin-top:12px;">
                            <canvas id="@($"summaryChart_m{mi}")"></canvas>
                        </div>
                    </div>
                </div>
            }
            else if (_activeSection == "process")
            {
                <!-- Process 10 NG -->
                <div class="card mb-3 shadow-sm">
                    <div class="card-header small fw-semibold d-flex justify-content-between align-items-center">
                        <span>Process 10 NG - Top 10 Worst Processes by PPM</span>
                        @if (rpt.Top10Process.Any(r => r.Groups.Count > 0))
                        {
                            <div class="d-flex gap-2">
                                <button class="expand-btn" @onclick="@(() => ExpandAllProcessFor(mi))">Expand All</button>
                                <span class="text-muted" style="font-size:10px;">|</span>
                                <button class="expand-btn" @onclick="@(() => CollapseAllProcessFor(mi))">Collapse All</button>
                            </div>
                        }
                    </div>
                    <div class="card-body p-2">
                        <div class="pivot-wrap">
                            <table class="pivot-table text-fit-table">
                                <thead>
                                    <tr>
                                        <th class="label-th" style="min-width:28px; text-align:center;">#</th>
                                        <th class="label-th" style="min-width:72px;">Type</th>
                                        <th class="label-th process-name-col" style="min-width:150px;">Process Name</th>
                                        @foreach (var col in dateCols)  { <th>@col.Header</th> }
                                        <th class="sep-th"></th>
                                        @foreach (var col in weekCols)  { <th>@col.Header</th> }
                                        <th class="sep-th"></th>
                                        @foreach (var col in monthCols) { <th>@col.Header</th> }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in rpt.Top10Process)
                                    {
                                        string procKey    = $"{mi}|{row.Rank}";
                                        bool procExpanded = _expandedProcess.Contains(procKey);
                                        <tr class="rank-row">
                                            <td class="toggle-cell" @onclick="@(() => ToggleProcess(mi, row.Rank))">
                                                @if (row.Groups.Count > 0)
                                                {
                                                    <span class="toggle-icon">@(procExpanded ? "v" : ">")</span>
                                                }
                                                @row.Rank
                                            </td>
                                            <td class="label-td"><span class="pt-badge">@row.ProcessType</span></td>
                                            <td class="label-td process-name-col">@row.ProcessName</td>
                                            @foreach (var col in dateCols)
                                            {
                                                double v = row.Ppm.GetValueOrDefault(col.Key);
                                                <td class="@(v <= 0 ? "ppm-zero" : "ppm-val")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                            }
                                            <td class="sep-td"></td>
                                            @foreach (var col in weekCols)
                                            {
                                                double v = row.Ppm.GetValueOrDefault(col.Key);
                                                <td class="@(v <= 0 ? "ppm-zero" : "ppm-val")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                            }
                                            <td class="sep-td"></td>
                                            @foreach (var col in monthCols)
                                            {
                                                double v = row.Ppm.GetValueOrDefault(col.Key);
                                                <td class="@(v <= 0 ? "ppm-zero" : "ppm-val")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                            }
                                        </tr>
                                        @if (procExpanded)
                                        {
                                            @foreach (var grp in row.Groups)
                                            {
                                                <tr class="group-row">
                                                    <td></td>
                                                    <td></td>
                                                    <td class="label-td group-name-td">@grp.GroupName</td>
                                                    @foreach (var col in dateCols)
                                                    {
                                                        double v = grp.Ppm.GetValueOrDefault(col.Key);
                                                        <td class="@(v <= 0 ? "ppm-zero" : "")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                                    }
                                                    <td class="sep-td"></td>
                                                    @foreach (var col in weekCols)
                                                    {
                                                        double v = grp.Ppm.GetValueOrDefault(col.Key);
                                                        <td class="@(v <= 0 ? "ppm-zero" : "")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                                    }
                                                    <td class="sep-td"></td>
                                                    @foreach (var col in monthCols)
                                                    {
                                                        double v = grp.Ppm.GetValueOrDefault(col.Key);
                                                        <td class="@(v <= 0 ? "ppm-zero" : "")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                                    }
                                                </tr>
                                            }
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else if (_activeSection == "ng")
            {
                <!-- Worst 10 NG -->
                <div class="card mb-3 shadow-sm">
                    <div class="card-header small fw-semibold d-flex justify-content-between align-items-center">
                        <span>Worst 10 NG - Top 10 Worst NG Names by PPM</span>
                        @if (rpt.Top10Ng.Any(r => r.Groups.Count > 0))
                        {
                            <div class="d-flex gap-2">
                                <button class="expand-btn" @onclick="@(() => ExpandAllNgFor(mi))">Expand All</button>
                                <span class="text-muted" style="font-size:10px;">|</span>
                                <button class="expand-btn" @onclick="@(() => CollapseAllNgFor(mi))">Collapse All</button>
                            </div>
                        }
                    </div>
                    <div class="card-body p-2">
                        <div class="pivot-wrap">
                            <table class="pivot-table text-fit-table">
                                <thead>
                                    <tr>
                                        <th class="label-th" style="min-width:28px; text-align:center;">#</th>
                                        <th class="label-th" style="min-width:72px;">Type</th>
                                        <th class="label-th process-name-col" style="min-width:150px;">Process Name</th>
                                        <th class="label-th ng-name-col" style="min-width:130px;">NG Name</th>
                                        @foreach (var col in dateCols)  { <th>@col.Header</th> }
                                        <th class="sep-th"></th>
                                        @foreach (var col in weekCols)  { <th>@col.Header</th> }
                                        <th class="sep-th"></th>
                                        @foreach (var col in monthCols) { <th>@col.Header</th> }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in rpt.Top10Ng)
                                    {
                                        string ngKey    = $"{mi}|{row.Rank}";
                                        bool ngExpanded = _expandedNg.Contains(ngKey);
                                        <tr class="rank-row">
                                            <td class="toggle-cell" @onclick="@(() => ToggleNg(mi, row.Rank))">
                                                @if (row.Groups.Count > 0)
                                                {
                                                    <span class="toggle-icon">@(ngExpanded ? "v" : ">")</span>
                                                }
                                                @row.Rank
                                            </td>
                                            <td class="label-td"><span class="pt-badge">@row.ProcessType</span></td>
                                            <td class="label-td process-name-col">@row.ProcessName</td>
                                            <td class="label-td ng-name-col">@row.NgName</td>
                                            @foreach (var col in dateCols)
                                            {
                                                double v = row.Ppm.GetValueOrDefault(col.Key);
                                                <td class="@(v <= 0 ? "ppm-zero" : "ppm-val")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                            }
                                            <td class="sep-td"></td>
                                            @foreach (var col in weekCols)
                                            {
                                                double v = row.Ppm.GetValueOrDefault(col.Key);
                                                <td class="@(v <= 0 ? "ppm-zero" : "ppm-val")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                            }
                                            <td class="sep-td"></td>
                                            @foreach (var col in monthCols)
                                            {
                                                double v = row.Ppm.GetValueOrDefault(col.Key);
                                                <td class="@(v <= 0 ? "ppm-zero" : "ppm-val")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                            }
                                        </tr>
                                        @if (ngExpanded)
                                        {
                                            @foreach (var grp in row.Groups)
                                            {
                                                <tr class="group-row">
                                                    <td></td>
                                                    <td></td>
                                                    <td class="label-td group-name-td">@grp.GroupName</td>
                                                    <td></td>
                                                    @foreach (var col in dateCols)
                                                    {
                                                        double v = grp.Ppm.GetValueOrDefault(col.Key);
                                                        <td class="@(v <= 0 ? "ppm-zero" : "")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                                    }
                                                    <td class="sep-td"></td>
                                                    @foreach (var col in weekCols)
                                                    {
                                                        double v = grp.Ppm.GetValueOrDefault(col.Key);
                                                        <td class="@(v <= 0 ? "ppm-zero" : "")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                                    }
                                                    <td class="sep-td"></td>
                                                    @foreach (var col in monthCols)
                                                    {
                                                        double v = grp.Ppm.GetValueOrDefault(col.Key);
                                                        <td class="@(v <= 0 ? "ppm-zero" : "")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                                    }
                                                </tr>
                                            }
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else if (_activeSection == "reason")
            {
                <!-- Reason -->
                @if (rpt.ReasonRows.Count > 0)
                {
                    <div class="card mb-3 shadow-sm">
                        <div class="card-header small fw-semibold d-flex justify-content-between align-items-center">
                            <span>Reason - Defect Cause Classification</span>
                            @if (rpt.ReasonRows.Any(r => !r.IsTotal && r.Groups.Count > 0))
                            {
                                <div class="d-flex gap-2">
                                    <button class="expand-btn" @onclick="@(() => ExpandAllReasonFor(mi))">Expand All</button>
                                    <span class="text-muted" style="font-size:10px;">|</span>
                                    <button class="expand-btn" @onclick="@(() => CollapseAllReasonFor(mi))">Collapse All</button>
                                </div>
                            }
                        </div>
                        <div class="card-body p-2">
                            <div class="pivot-wrap">
                                <table class="pivot-table text-fit-table">
                                    <thead>
                                        <tr>
                                            <th class="label-th" style="min-width:90px;">Reason</th>
                                            <th class="label-th" style="min-width:28px; text-align:center;">No</th>
                                            <th class="label-th" style="min-width:72px;">Type</th>
                                            <th class="label-th process-name-col" style="min-width:160px;">Process Name</th>
                                            <th class="label-th ng-name-col" style="min-width:120px;">NG Name</th>
                                            @foreach (var col in dateCols)  { <th>@col.Header</th> }
                                            <th class="sep-th"></th>
                                            @foreach (var col in weekCols)  { <th>@col.Header</th> }
                                            <th class="sep-th"></th>
                                            @foreach (var col in monthCols) { <th>@col.Header</th> }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            string? lastReason = null;
                                            var reasonRowsToShow = rpt.ReasonRows
                                                .Where(r => r.IsTotal || r.Ppm.Values.Any(v => v > 0));
                                        }
                                        @foreach (var row in reasonRowsToShow)
                                        {
                                            bool reasonChanged = row.Reason != lastReason;
                                            lastReason = row.Reason;
                                            string reasonCatKey = $"{mi}|{row.Reason}";
                                            bool categoryCollapsed = _collapsedReasonCategory.Contains(reasonCatKey);
                                            if (!row.IsTotal && categoryCollapsed)
                                            {
                                                continue;
                                            }
                                            if (row.IsTotal)
                                            {
                                                <tr class="total-row">
                                                    <td class="toggle-cell label-td fw-bold"
                                                        @onclick="@(() => ToggleReasonCategory(reasonCatKey))">
                                                        <span class="toggle-icon">@(categoryCollapsed ? "v" : ">")</span>
                                                        @row.Reason
                                                    </td>
                                                    <td></td>
                                                    <td></td>
                                                    <td class="label-td text-muted" style="font-size:10px;">Total</td>
                                                    <td></td>
                                                    @foreach (var col in dateCols)
                                                    {
                                                        double v = row.Ppm.GetValueOrDefault(col.Key);
                                                        <td class="@(v <= 0 ? "ppm-zero" : "ppm-val")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                                    }
                                                    <td class="sep-td"></td>
                                                    @foreach (var col in weekCols)
                                                    {
                                                        double v = row.Ppm.GetValueOrDefault(col.Key);
                                                        <td class="@(v <= 0 ? "ppm-zero" : "ppm-val")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                                    }
                                                    <td class="sep-td"></td>
                                                    @foreach (var col in monthCols)
                                                    {
                                                        double v = row.Ppm.GetValueOrDefault(col.Key);
                                                        <td class="@(v <= 0 ? "ppm-zero" : "ppm-val")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                                    }
                                                </tr>
                                            }
                                            else
                                            {
                                                string reasonKey = $"{mi}|{row.Reason}|{row.No}";
                                                bool reasonExpanded = _expandedReason.Contains(reasonKey);
                                                <tr class="rank-row">
                                                    <td class="label-td" style="color:#94a3b8; font-size:10px;">@(reasonChanged ? row.Reason : "")</td>
                                                    <td class="toggle-cell" @onclick="@(() => ToggleReason(reasonKey))">
                                                        @if (row.Groups.Count > 0)
                                                        {
                                                            <span class="toggle-icon">@(reasonExpanded ? "v" : ">")</span>
                                                        }
                                                        @row.No
                                                    </td>
                                                    <td class="label-td"><span class="pt-badge">@row.ProcessType</span></td>
                                                    <td class="label-td process-name-col">@row.ProcessName</td>
                                                    <td class="label-td ng-name-col">@row.NgName</td>
                                                    @foreach (var col in dateCols)
                                                    {
                                                        double v = row.Ppm.GetValueOrDefault(col.Key);
                                                        <td class="@(v <= 0 ? "ppm-zero" : "ppm-val")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                                    }
                                                    <td class="sep-td"></td>
                                                    @foreach (var col in weekCols)
                                                    {
                                                        double v = row.Ppm.GetValueOrDefault(col.Key);
                                                        <td class="@(v <= 0 ? "ppm-zero" : "ppm-val")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                                    }
                                                    <td class="sep-td"></td>
                                                    @foreach (var col in monthCols)
                                                    {
                                                        double v = row.Ppm.GetValueOrDefault(col.Key);
                                                        <td class="@(v <= 0 ? "ppm-zero" : "ppm-val")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                                    }
                                                </tr>
                                                @if (reasonExpanded)
                                                {
                                                    @foreach (var grp in row.Groups)
                                                    {
                                                        <tr class="group-row">
                                                            <td></td>
                                                            <td></td>
                                                            <td></td>
                                                            <td class="label-td group-name-td">@grp.GroupName</td>
                                                            <td></td>
                                                            @foreach (var col in dateCols)
                                                            {
                                                                double v = grp.Ppm.GetValueOrDefault(col.Key);
                                                                <td class="@(v <= 0 ? "ppm-zero" : "")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                                            }
                                                            <td class="sep-td"></td>
                                                            @foreach (var col in weekCols)
                                                            {
                                                                double v = grp.Ppm.GetValueOrDefault(col.Key);
                                                                <td class="@(v <= 0 ? "ppm-zero" : "")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                                            }
                                                            <td class="sep-td"></td>
                                                            @foreach (var col in monthCols)
                                                            {
                                                                double v = grp.Ppm.GetValueOrDefault(col.Key);
                                                                <td class="@(v <= 0 ? "ppm-zero" : "")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                                            }
                                                        </tr>
                                                    }
                                                }
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
            }
        }

    </div>
}

@code {
    // Get Data state
    private DateTime     _startDate    = DateTime.Today;
    private DateTime     _endDate      = DateTime.Today;
    private bool         _isBusy       = false;
    private string?      _savedDbPath  = null;
    private string?      _errorMessage = null;
    private List<string> _logs         = new();
    private const string LogElementId  = "ngRateLogBySection";
    private int          _lastLogScrollCount = -1;

    // Model Groups state (from ModelGroups DB)
    private List<ModelGroupRecord> _dbGroups           = new();
    private HashSet<long>          _selectedGroupIds   = new();
    private HashSet<string>        _selectedSubEntries = new(StringComparer.Ordinal);
    private string                 _activePg           = "ETC";

    // Report state
    private bool   _isReportBusy = false;
    private string _reportError  = string.Empty;
    private List<(string Label, NgRateReportService.NgRateReport Report)> _reports = new();

    // Group -> Mid -> Sub1 -> Sub2 -> LineShift hierarchy (shared across sections)
    // Bundled by HierReportBuilder; rendered through the <HierSubRows> component.
    private HierReports?    _hier;
    private HierPpmLookup   _hierLookup = new();
    private HashSet<string> _hierExpandedGroups = new(StringComparer.Ordinal);
    private HashSet<string> _hierExpandedMids   = new(StringComparer.Ordinal);
    private HashSet<string> _hierExpandedSub1s  = new(StringComparer.Ordinal);

    private void HierToggleGroup(string g) { if (!_hierExpandedGroups.Remove(g)) _hierExpandedGroups.Add(g); }
    private void HierToggleMid(string k)   { if (!_hierExpandedMids.Remove(k))   _hierExpandedMids.Add(k); }

    private bool HierMidHasVisibleData(
        string groupName,
        MidGroupRecord mid,
        IReadOnlyList<NgRateReportService.PeriodColumn> dateCols,
        IReadOnlyList<NgRateReportService.PeriodColumn> weekCols,
        IReadOnlyList<NgRateReportService.PeriodColumn> monthCols)
    {
        if (mid.LineShifts.Count == 0 || string.IsNullOrEmpty(mid.Material)) return false;
        foreach (var col in dateCols)  if (_hierLookup.MidAvgOfSubs(groupName, mid, col.Key) > 0) return true;
        foreach (var col in weekCols)  if (_hierLookup.MidAvgOfSubs(groupName, mid, col.Key) > 0) return true;
        foreach (var col in monthCols) if (_hierLookup.MidAvgOfSubs(groupName, mid, col.Key) > 0) return true;
        return false;
    }

    private List<ModelGroupRecord> ResolveHierGroups()
    {
        var groupSet = new HashSet<long>(_selectedGroupIds);
        foreach (string key in _selectedSubEntries)
        {
            var parts = key.Split('|');
            if (parts.Length >= 1 && long.TryParse(parts[0], out long gid)) groupSet.Add(gid);
        }
        if (groupSet.Count == 0)
            foreach (var g in _dbGroups) groupSet.Add(g.Id);
        return _dbGroups.Where(g => groupSet.Contains(g.Id)).ToList();
    }

    // Section tabs (defect report type)
    private static readonly (string Key, string Label)[] SectionTabs = new[]
    {
        ("summary", "Summary"),
        ("process", "Process 10 NG"),
        ("ng",      "Worst 10 NG"),
        ("reason",  "Reason"),
    };
    private string _activeSection = "summary";

    // Chart state
    private bool _pendingChartRender = false;

    // Export state
    private bool _isExporting = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await ScrollLogToBottomIfNeededAsync();

        if (_pendingChartRender && _activeSection == "summary" && _reports.Count > 0)
        {
            _pendingChartRender = false;
            for (int i = 0; i < _reports.Count; i++)
                await RenderSummaryChartAsync(i);
        }
    }

    private async Task ScrollLogToBottomIfNeededAsync()
    {
        if (_logs.Count == 0)
        {
            _lastLogScrollCount = 0;
            return;
        }
        _lastLogScrollCount = _logs.Count;
        try { await JS.InvokeVoidAsync("ngRateLog.scrollToBottom", LogElementId, LogElementId + "Bottom"); } catch { }
    }

    private async Task RenderSummaryChartAsync(int modelIdx)
    {
        if (modelIdx < 0 || modelIdx >= _reports.Count) return;
        var rpt = _reports[modelIdx].Report;

        var dateCols  = GetVisibleDateCols(rpt).ToList();
        var weekCols  = GetVisibleWeekCols(rpt).ToList();
        var monthCols = GetVisibleMonthCols(rpt).ToList();
        bool hasWeek  = weekCols.Count > 0;
        bool hasMonth = monthCols.Count > 0;

        // Insert empty label ("") as separator between sections
        var labels = new List<string>();
        labels.AddRange(dateCols.Select(c => c.Header));
        if (hasWeek)  { labels.Add(""); labels.AddRange(weekCols.Select(c  => c.Header)); }
        if (hasMonth) { labels.Add(""); labels.AddRange(monthCols.Select(c => c.Header)); }

        // Data array builder: insert null at separator positions
        double?[] BuildData(Dictionary<string, double> ppm)
        {
            var d = new List<double?>();
            foreach (var c in dateCols)  d.Add(GetChartVal(ppm, c.Key));
            if (hasWeek)  { d.Add(null); foreach (var c in weekCols)  d.Add(GetChartVal(ppm, c.Key)); }
            if (hasMonth) { d.Add(null); foreach (var c in monthCols) d.Add(GetChartVal(ppm, c.Key)); }
            return d.ToArray();
        }

        // TOTAL line chart
        var totalRow = rpt.Summary.FirstOrDefault(r => r.IsTotal);
        object? totalDs = totalRow is null ? null : new
        {
            label           = "TOTAL",
            data            = BuildData(totalRow.Ppm),
            borderColor     = "#4f46e5",
            backgroundColor = "rgba(79,70,229,0.08)",
            borderWidth     = 2,
            pointRadius     = 3,
            pointBackgroundColor = "#4f46e5",
            pointBorderColor     = "#4f46e5",
            tension         = 0.4,
            fill            = false,
            yAxisID         = "y1",
            order           = 0,
            spanGaps        = false,
        };

        // ProcessType bars
        int fi = 0;
        var barDatasets = rpt.Summary
            .Where(r => !r.IsTotal)
            .Select(r =>
            {
                var ds = (object)new
                {
                    type            = "bar",
                    label           = r.ProcessType,
                    data            = BuildData(r.Ppm),
                    backgroundColor = GetPtColor(r.ProcessType, fi),
                    stack           = "pt",
                    order           = 1,
                };
                fi++;
                return ds;
            })
            .ToArray();

        await JS.InvokeVoidAsync("ngRateChart.render", $"summaryChart_m{modelIdx}", labels.ToArray(), barDatasets, totalDs);
    }

    private static double? GetChartVal(Dictionary<string, double> ppm, string key)
        => ppm.TryGetValue(key, out double v) && v > 0 ? v : null;

    private static string GetPtColor(string pt, int fi)
    {
        if (pt.StartsWith("SUB",    StringComparison.OrdinalIgnoreCase)) return "rgba(239,68,68,0.85)";
        if (pt == "MAIN")                                                 return "rgba(34,197,94,0.85)";
        if (pt == "FUNCTION")                                             return "rgba(168,85,247,0.85)";
        if (pt.StartsWith("VISUAL", StringComparison.OrdinalIgnoreCase)) return "rgba(6,182,212,0.85)";
        string[] fb = ["rgba(249,115,22,0.85)", "rgba(234,179,8,0.85)", "rgba(99,102,241,0.85)", "rgba(236,72,153,0.85)"];
        return fb[fi % fb.Length];
    }

    private async Task DestroyAllChartsAsync()
    {
        for (int i = 0; i < _reports.Count; i++)
            try { await JS.InvokeVoidAsync("ngRateChart.destroy", $"summaryChart_m{i}"); } catch { }
    }

    private async Task ClearReportAsync()
    {
        await DestroyAllChartsAsync();
        _reports.Clear();
        _activeSection = "summary";
        _expandedSummary.Clear();
        _expandedProcess.Clear();
        _expandedNg.Clear();
        _expandedReason.Clear();
        _collapsedSummaryGroups.Clear();
        _collapsedReasonCategory.Clear();
    }

    public async ValueTask DisposeAsync() => await DestroyAllChartsAsync();

    // Expand/Collapse state (keys are model-prefixed: "{mi}|...")
    private HashSet<string> _expandedSummary = new();
    private HashSet<string> _expandedProcess = new();
    private HashSet<string> _expandedNg      = new();
    private HashSet<string> _expandedReason  = new();
    private HashSet<string> _collapsedSummaryGroups = new(StringComparer.Ordinal);
    private HashSet<string> _collapsedReasonCategory = new();

    private static string SummaryGroupKey(int mi, string groupName)
        => $"{mi}|{groupName}";

    private bool IsSummaryGroupCollapsed(int mi, string groupName)
        => _collapsedSummaryGroups.Contains(SummaryGroupKey(mi, groupName));

    private void ToggleSummaryGroup(int mi, string groupName)
    {
        string key = SummaryGroupKey(mi, groupName);
        if (!_collapsedSummaryGroups.Remove(key)) _collapsedSummaryGroups.Add(key);
    }

    private void ToggleSummary(int mi, string pt)
    {
        string key = $"{mi}|{pt}";
        if (!_expandedSummary.Remove(key)) _expandedSummary.Add(key);
    }
    private void ExpandAllSummaryFor(int mi)
    {
        foreach (var r in _reports[mi].Report.Summary)
            _expandedSummary.Add($"{mi}|{r.ProcessType}");
    }
    private void CollapseAllSummaryFor(int mi)
        => _expandedSummary.RemoveWhere(k => k.StartsWith($"{mi}|"));

    private void ToggleProcess(int mi, int rank)
    {
        string key = $"{mi}|{rank}";
        if (!_expandedProcess.Remove(key)) _expandedProcess.Add(key);
    }
    private void ToggleNg(int mi, int rank)
    {
        string key = $"{mi}|{rank}";
        if (!_expandedNg.Remove(key)) _expandedNg.Add(key);
    }
    private void ToggleReason(string key)
    {
        if (!_expandedReason.Remove(key)) _expandedReason.Add(key);
    }
    private void ToggleReasonCategory(string key)
    {
        if (!_collapsedReasonCategory.Remove(key)) _collapsedReasonCategory.Add(key);
    }

    private void ExpandAllProcessFor(int mi)
    {
        foreach (var r in _reports[mi].Report.Top10Process)
            _expandedProcess.Add($"{mi}|{r.Rank}");
    }
    private void CollapseAllProcessFor(int mi)
        => _expandedProcess.RemoveWhere(k => k.StartsWith($"{mi}|"));

    private void ExpandAllNgFor(int mi)
    {
        foreach (var r in _reports[mi].Report.Top10Ng)
            _expandedNg.Add($"{mi}|{r.Rank}");
    }
    private void CollapseAllNgFor(int mi)
        => _expandedNg.RemoveWhere(k => k.StartsWith($"{mi}|"));

    private void ExpandAllReasonFor(int mi)
    {
        foreach (var r in _reports[mi].Report.ReasonRows.Where(r => !r.IsTotal))
            _expandedReason.Add($"{mi}|{r.Reason}|{r.No}");
    }
    private void CollapseAllReasonFor(int mi)
        => _expandedReason.RemoveWhere(k => k.StartsWith($"{mi}|"));

    // Column visibility
    private const int DateVisibleLimit  = 14;
    private const int WeekVisibleLimit  = 4;
    private const int MonthVisibleLimit = 3;

    private bool _dateExpanded  = false;
    private bool _weekExpanded  = false;
    private bool _monthExpanded = false;

    private IEnumerable<NgRateReportService.PeriodColumn> GetVisibleDateCols(NgRateReportService.NgRateReport rpt)
        => !_dateExpanded && rpt.DateCols.Count > DateVisibleLimit
            ? rpt.DateCols.Take(DateVisibleLimit)
            : rpt.DateCols;

    private IEnumerable<NgRateReportService.PeriodColumn> GetVisibleWeekCols(NgRateReportService.NgRateReport rpt)
        => !_weekExpanded && rpt.WeekCols.Count > WeekVisibleLimit
            ? rpt.WeekCols.Take(WeekVisibleLimit)
            : rpt.WeekCols;

    private IEnumerable<NgRateReportService.PeriodColumn> GetVisibleMonthCols(NgRateReportService.NgRateReport rpt)
        => !_monthExpanded && rpt.MonthCols.Count > MonthVisibleLimit
            ? rpt.MonthCols.Take(MonthVisibleLimit)
            : rpt.MonthCols;

    private void ToggleDateCols()  { _dateExpanded  = !_dateExpanded;  _pendingChartRender = true; }
    private void ToggleWeekCols()  { _weekExpanded  = !_weekExpanded;  _pendingChartRender = true; }
    private void ToggleMonthCols() { _monthExpanded = !_monthExpanded; _pendingChartRender = true; }

    protected override void OnInitialized() => RefreshGroups();

    // Model Groups helpers

    private void RefreshGroups()
    {
        _dbGroups = Repo.GetModelGroups();
        _selectedGroupIds.RemoveWhere(id => !_dbGroups.Any(g => g.Id == id));
        var live = _dbGroups.SelectMany(ModelGroupPickerHelpers.EnumerateMidEntries).Select(c => c.Key).ToHashSet(StringComparer.Ordinal);
        _selectedSubEntries.RemoveWhere(k => !live.Contains(k));
        if (!_dbGroups.Any(g => g.ProductGroup == _activePg))
            _activePg = ModelGroupPickerHelpers.FirstProductGroupWithRows(_dbGroups);
    }

    private void ToggleGroup(long id)
    {
        if (!_selectedGroupIds.Remove(id))
            _selectedGroupIds.Add(id);
    }

    private void ToggleSubEntry(string key)
    {
        if (!_selectedSubEntries.Remove(key))
            _selectedSubEntries.Add(key);
    }

    private static (Dictionary<string, string> mapping, List<string> groups) BuildGroupMapping(
        IEnumerable<ModelGroupRecord> selected)
    {
        var mapping = new Dictionary<string, string>(StringComparer.Ordinal);
        var groups  = new List<string>();
        foreach (var g in selected)
        {
            if (!groups.Contains(g.Name)) groups.Add(g.Name);
            foreach (var mid in g.MidGroups)
                foreach (var ls in mid.LineShifts)
                    if (!string.IsNullOrEmpty(ls))
                        mapping[ls] = g.Name;
        }
        return (mapping, groups);
    }

    /// <summary>Resolves a <see cref="ModelGroupChildEntry.Key"/> into a flat mapping scoped to that
    /// mid-group only. One section is emitted per selected mid-group.</summary>
    private (string label, Dictionary<string, string> mapping, List<string> groupList)?
        BuildChildEntryMapping(string key)
    {
        var parts = key.Split('|');
        if (parts.Length != 3 || parts[1] != "mid") return null;
        if (!long.TryParse(parts[0], out long gid)) return null;
        var g = _dbGroups.FirstOrDefault(x => x.Id == gid);
        if (g is null) return null;

        string material = parts[2];
        var mid = g.MidGroups.FirstOrDefault(m => m.Material == material);
        if (mid is null) return null;

        var mapping = new Dictionary<string, string>(StringComparer.Ordinal);
        foreach (var ls in mid.LineShifts)
            if (!string.IsNullOrEmpty(ls)) mapping[ls] = material;
        if (mapping.Count == 0) return null;
        return (material, mapping, new List<string> { material });
    }

    // Get Data

    private void SetToday()
    {
        _startDate = DateTime.Today;
        _endDate   = DateTime.Today;
    }

    private async Task GetDataAsync()
    {
        if (_endDate < _startDate)
        {
            _errorMessage = "End date must be on or after start date.";
            return;
        }

        _isBusy       = true;
        _errorMessage = null;
        _savedDbPath  = null;
        _logs.Clear();
        Activity.Log("NG Rate By Section", $"Get Data {_startDate:yyyy-MM-dd} ~ {_endDate:yyyy-MM-dd}");

        var progress = new Progress<string>(msg =>
        {
            AddLog(msg);
        });

        try
        {
            string? dbPath = await NgRate.FetchAndSaveAsync(
                _startDate, _endDate, progress);

            if (string.IsNullOrEmpty(dbPath))
                _errorMessage = "Data fetch or save failed - check the log.";
            else
            {
                _savedDbPath = dbPath;
                RefreshGroups();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Exception: {ex.Message}";
            AddLog($"[ERROR] {ex}");
        }
        finally
        {
            _isBusy = false;
            await InvokeAsync(async () =>
            {
                StateHasChanged();
                await Task.Delay(20);
                await ScrollLogToBottomIfNeededAsync();
            });
        }
    }

    private void ClearResult()
    {
        _savedDbPath  = null;
        _errorMessage = null;
    }

    // Get Report

    private async Task GetReportAsync()
    {
        if (_isReportBusy || _isBusy) return;
        if (_endDate < _startDate)
        {
            _reportError = "End date must be on or after start date.";
            return;
        }
        if (!NgRateSettings.IsCredentialsConfigured)
        {
            _reportError = "BMES credentials are not configured.";
            return;
        }

        _reportError     = string.Empty;
        await DestroyAllChartsAsync();
        _reports.Clear();
        _activeSection = "summary";
        _isReportBusy    = true;
        _isBusy          = true;
        _savedDbPath     = null;
        _errorMessage    = null;
        _logs.Clear();
        _expandedSummary.Clear();
        _expandedProcess.Clear();
        _expandedNg.Clear();
        _expandedReason.Clear();
        _collapsedSummaryGroups.Clear();
        _collapsedReasonCategory.Clear();
        _dateExpanded  = false;
        _weekExpanded  = false;
        _monthExpanded = false;
        _hier        = null;
        _hierLookup  = new();
        _hierExpandedGroups.Clear();
        _hierExpandedMids.Clear();
        _hierExpandedSub1s.Clear();
        Activity.Log("NG Rate By Section", $"Get Data {_startDate:yyyy-MM-dd} ~ {_endDate:yyyy-MM-dd}");
        await InvokeAsync(StateHasChanged);

        IProgress<string> progress = new Progress<string>(msg =>
        {
            AddLog(msg);
        });

        try
        {
            progress.Report($"Fetching data: {_startDate:yyyy-MM-dd} ~ {_endDate:yyyy-MM-dd}");
            string? dbPath = await NgRate.GetOrFetchAsync(_startDate, _endDate, progress);
            _isBusy = false;

            if (string.IsNullOrEmpty(dbPath))
            {
                _errorMessage = "Data fetch or save failed - check the log.";
                _reportError  = _errorMessage;
                return;
            }

            _savedDbPath = dbPath;
            RefreshGroups();
            Activity.Log("NG Rate By Section", $"Generate Report selectedGroups={_selectedGroupIds.Count:N0}, selectedEntries={_selectedSubEntries.Count:N0}");
            progress.Report($"Using DB: {Path.GetFileName(dbPath)}");

            if (_selectedGroupIds.Count == 0 && _selectedSubEntries.Count == 0)
            {
                // No selection: single "All" section across every group.
                var flat = NgRateModeSupport.BuildFlatMapping(_dbGroups);
                var mapping = flat.Mapping;
                var groupList = flat.Groups;
                if (mapping.Count == 0)
                {
                    _reportError = "No LineShift found in the selected groups.";
                    return;
                }
                var r = await NgRateReport.GenerateReportAsync(dbPath, mapping, groupList, progress, _startDate, _endDate);
                _reports.Add(("All", r));
            }
            else
            {
                // Whole-group selections: one section each.
                foreach (var g in _dbGroups
                    .Where(g => _selectedGroupIds.Contains(g.Id))
                    .OrderBy(g => g.Name, StringComparer.Ordinal))
                {
                    progress.Report($"--- {g.Name}");
                    var flat = NgRateModeSupport.BuildFlatMapping(new[] { g });
                    var mapping = flat.Mapping;
                    var groupList = flat.Groups;
                    if (mapping.Count == 0)
                    {
                        progress.Report($"  (skipped: no LineShift)");
                        continue;
                    }
                    var r = await NgRateReport.GenerateReportAsync(dbPath, mapping, groupList, progress, _startDate, _endDate);
                    _reports.Add((g.Name, r));
                }

                // Mid-group selections: one section scoped to that Material only.
                foreach (string key in _selectedSubEntries.OrderBy(k => k, StringComparer.Ordinal))
                {
                    var spec = NgRateModeSupport.BuildMidChildFlatReport(_dbGroups, key);
                    if (spec is null)
                    {
                        progress.Report($"--- {key}  (skipped: not found)");
                        continue;
                    }
                    progress.Report($"--- {spec.Label}");
                    var r = await NgRateReport.GenerateReportAsync(
                        dbPath, spec.Mapping, spec.Groups, progress, _startDate, _endDate);
                    _reports.Add((spec.Label, r));
                }
            }

            _pendingChartRender = true;

            // Hierarchy reports for the Group -> Mid -> Sub1 -> Sub2 summary card
            _hier       = await HierReportBuilder.BuildAsync(NgRateReport, dbPath, ResolveHierGroups(), progress, _startDate, _endDate);
            _hierLookup = HierPpmLookup.From(_hier);
        }
        catch (Exception ex)
        {
            _reportError = $"Error: {ex.Message}";
            AddLog($"[ERROR] {ex}");
        }
        finally
        {
            _isBusy = false;
            _isReportBusy = false;
            await InvokeAsync(async () =>
            {
                StateHasChanged();
                await Task.Delay(20);
                await ScrollLogToBottomIfNeededAsync();
            });
        }
    }

    private async Task ExportExcelAsync()
    {
        if (_isExporting) return;
        _isExporting = true;
        _reportError = string.Empty;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        try
        {
            if (_reports.Count == 0) return;

            Activity.Log("NG Rate By Section", $"Export Excel reports={_reports.Count:N0}");
            var bytes   = await Task.Run(() => NgRateExcelExporter.Export(_reports));
            string name = $"NgRate_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";
            await BrowserDownload.DownloadBytesAsync(JS, name, bytes, BrowserDownload.XlsxContentType);
        }
        catch (Exception ex)
        {
            _reportError = $"Export failed: {ex.Message}";
        }
        finally
        {
            _isExporting = false;
        }
    }

    private async Task SwitchSectionAsync(string section)
    {
        if (_activeSection == section) return;
        if (_activeSection == "summary")
            await DestroyAllChartsAsync();
        _activeSection = section;
        if (section == "summary")
            _pendingChartRender = true;
    }

    // Utilities

    private static string GetLogClass(string line)
    {
        if (line.Contains("[ERROR]")) return "text-danger";
        if (line.Contains("[WARN]"))  return "text-warning";
        if (line.Contains("---")) return "text-info fw-semibold";
        if (line.Contains("Done") || line.Contains("done") ||
            line.Contains("complete", StringComparison.OrdinalIgnoreCase) ||
            line.Contains("Report"))
            return "text-success";
        return string.Empty;
    }

    private void AddLog(string message)
    {
        _logs.Add($"[{DateTime.Now:HH:mm:ss}] {message}");
        _ = InvokeAsync(async () =>
        {
            StateHasChanged();
            await Task.Delay(20);
            await ScrollLogToBottomIfNeededAsync();
        });
    }
}
