@page "/input-data-batch"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@using System.Text.Json
@using JinoSupporter.Web.Services
@inject IWebHostEnvironment Env
@inject IJSRuntime JS
@inject InputDataComPipelineService ComPipeline
@inject WebRepository Repo

<PageTitle>INPUT DATA</PageTitle>

<div class="input-data-root">
    <header class="page-head">
        <div>
            <div class="kicker">TEST DATA ANALYSIS</div>
            <h1>INPUT DATA</h1>
        </div>
        <span class="status-chip @(_statusError ? "error" : "ok")">@_status</span>
    </header>

    <section class="panel">
        <div class="panel-head">
            <div>
                <h2>Excel Input Data 입력</h2>
                <p>Excel COM으로 원본을 읽고, 병합셀 구조와 raw grid를 DB에 저장합니다.</p>
            </div>
        </div>

        <div class="form-grid">
            <label class="source-field">
                <span>Excel 파일 또는 폴더</span>
                <div class="source-input-row">
                    <input class="form-control form-control-sm"
                           @bind="_inputPath"
                           disabled="@_isRunning" />
                    <label class="btn btn-outline-secondary btn-sm file-picker-button @(_isRunning ? "disabled" : "")"
                           title="Excel 파일 선택">
                        파일 선택
                        <InputFile class="file-picker-input"
                                   OnChange="OnInputFileSelectedAsync"
                                   accept=".xlsx,.xlsm,.xlsb,.xls"
                                   disabled="@_isRunning" />
                    </label>
                </div>
                @if (!string.IsNullOrWhiteSpace(_selectedInputFileStatus))
                {
                    <small class="@(_selectedInputFileError ? "source-status error-text" : "source-status")">
                        @_selectedInputFileStatus
                    </small>
                }
            </label>
            <label>
                <span>데이터셋</span>
                <input class="form-control form-control-sm"
                       @bind="_dataset"
                       disabled="@_isRunning" />
            </label>
            <label>
                <span>처리 개수</span>
                <input class="form-control form-control-sm"
                       type="number"
                       min="0"
                       @bind="_limitText"
                       disabled="@_isRunning" />
            </label>
        </div>

        <div class="toolbar">
            <label class="check">
                <input type="checkbox" @bind="_runAiReviewCase" disabled="@_isRunning" />
                AI 인식/추출 적합성 점검까지 실행
            </label>

            @if (_isRunning)
            {
                <button class="btn btn-outline-danger btn-sm" type="button" @onclick="CancelRun">
                    중지
                </button>
            }
            else
            {
                <button class="btn btn-primary btn-sm" type="button" @onclick="RunPipelineAsync">
                    실행
                </button>
            }
        </div>
    </section>

    @if (_lastRun is not null)
    {
        <section class="panel">
            <div class="panel-head">
                <div>
                    <h2>마지막 실행 결과</h2>
                    <p>@_lastRun.FinishedAt</p>
                </div>
            </div>

            <div class="summary-grid">
                <div><span>파일</span><strong>@_lastRun.SuccessCount / @_lastRun.FileCount OK</strong></div>
                <div><span>시트</span><strong>@_lastRun.SheetCount.ToString("N0")</strong></div>
                <div><span>셀</span><strong>@_lastRun.TotalCells.ToString("N0")</strong></div>
                <div><span>병합셀</span><strong>@_lastRun.MergeCount.ToString("N0")</strong></div>
                <div><span>후보</span><strong>@_lastRun.CandidateCount.ToString("N0")</strong></div>
                <div><span>AI 점검</span><strong>@_lastRun.ReviewCaseCount.ToString("N0")</strong></div>
            </div>

            @if (_lastRun.Files.Count > 0)
            {
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>파일</th>
                                <th>상태</th>
                                <th>Grid</th>
                                <th>병합셀</th>
                                <th>AI</th>
                                <th>검토</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _lastRun.Files)
                            {
                                <tr>
                                    <td title="@row.SourcePath">@row.SourceFileName</td>
                                    <td class="@(row.Success ? "ok-text" : "error-text")" title="@row.Error">
                                        @(row.Success ? "OK" : "Failed")
                                    </td>
                                    <td>@row.SheetCount.ToString("N0") sheets / @row.TotalCells.ToString("N0") cells</td>
                                    <td>@row.MergeCount.ToString("N0")</td>
                                    <td>@AiStatus(row)</td>
                                    <td>
                                        <button class="btn btn-outline-secondary btn-sm"
                                                type="button"
                                                title="@row.SourcePath"
                                                disabled="@(!CanOpenSourcePath(row.SourcePath))"
                                                @onclick="@(() => OpenExcelFile(row.SourcePath))">
                                            Excel 열기
                                        </button>
                                        @if (row.AiSaved && row.WorkbookId > 0)
                                        {
                                            <button class="btn btn-outline-primary btn-sm"
                                                    type="button"
                                                    @onclick="@(() => LoadReviewCase(row))">
                                                보기
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="muted">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }

    @if (_recentReviewCases.Count > 0)
    {
        <section class="panel">
            <div class="panel-head">
                <div>
                    <h2>저장된 AI 인식 결과</h2>
                    <p>이 데이터셋에 DB 저장된 최신 AI 인식/추출 점검 결과입니다.</p>
                </div>
                <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="RefreshRecentReviewCases">
                    새로고침
                </button>
            </div>

            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>파일</th>
                            <th>상태</th>
                            <th>Ask AI</th>
                            <th>생성시각</th>
                            <th>검토</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (InputDataReviewCaseListRecord row in _recentReviewCases)
                        {
                            <tr>
                                <td title="@row.SourcePath">@row.SourceFileName</td>
                                <td>@DisplayStatus(row.Status)</td>
                                <td class="@(row.ApprovedForAskAi ? "ok-text" : "error-text")">
                                    @(row.ApprovedForAskAi ? "승인됨" : "확인 필요")
                                </td>
                                <td>@row.CreatedAt</td>
                                <td>
                                    <button class="btn btn-outline-secondary btn-sm"
                                            type="button"
                                            title="@row.SourcePath"
                                            disabled="@(!CanOpenSourcePath(row.SourcePath))"
                                            @onclick="@(() => OpenExcelFile(row.SourcePath))">
                                        Excel 열기
                                    </button>
                                    <button class="btn btn-outline-primary btn-sm"
                                            type="button"
                                            @onclick="@(() => LoadReviewCase(row.WorkbookId, row.SourceFileName, row.SourcePath))">
                                        보기
                                    </button>
                                    <button class="btn btn-outline-danger btn-sm"
                                            type="button"
                                            @onclick="@(() => DeleteReviewCaseAsync(row))">
                                        삭제
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    @if (_selectedReviewCase is not null && _reviewView is not null)
    {
        <section class="panel review-panel">
            <div class="panel-head">
                <div>
                    <h2>AI 인식 결과 검토</h2>
                    <p>@_selectedReviewFileName</p>
                </div>
                <div class="review-badges">
                    <span class="status-chip @(_selectedReviewCase.ApprovedForAskAi ? "ok" : "error")">
                        @(_selectedReviewCase.ApprovedForAskAi ? "Ask AI 추출 가능" : "데이터 확인 필요")
                    </span>
                    <span class="status-chip">@DisplayStatus(_selectedReviewCase.Status)</span>
                    <button class="btn btn-outline-secondary btn-sm"
                            type="button"
                            title="@_selectedReviewSourcePath"
                            disabled="@(!CanOpenSourcePath(_selectedReviewSourcePath))"
                            @onclick="@(() => OpenExcelFile(_selectedReviewSourcePath))">
                        원본 Excel 열기
                    </button>
                    <button class="btn btn-outline-danger btn-sm"
                            type="button"
                            @onclick="DeleteSelectedReviewCaseAsync">
                        인식 결과 삭제
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_openFileStatus))
            {
                <p class="open-file-status">@_openFileStatus</p>
            }

            <div class="review-grid">
                <div class="review-block">
                    <span>AI 요약</span>
                    <p>@_reviewView.Summary</p>
                </div>
                <div class="review-block">
                    <span>신뢰도</span>
                    <strong>@DisplayConfidence(_reviewView.Confidence)</strong>
                </div>
                <div class="review-block">
                    <span>추출 상태</span>
                    <strong>@DisplayStatus(_reviewView.VerificationStatus)</strong>
                </div>
            </div>

            @if (_reviewView.Cases.Count > 0)
            {
                <h3>AI 인식 결과</h3>
                @foreach (GeneratedCaseView item in _reviewView.Cases)
                {
                    <div class="recognition-card">
                        <div class="case-title">
                            <strong>@item.Title</strong>
                            <span>@item.ReviewCaseId</span>
                        </div>
                        <p>@item.Purpose</p>

                        @if (item.ChangedFactors.Count > 0)
                        {
                            <div class="recognized-factors">
                                @foreach (ChangedFactorView factor in item.ChangedFactors)
                                {
                                    <div class="recognized-factor">
                                        <span>데이터 구분</span>
                                        <strong>@factor.Domain</strong>
                                        <dl>
                                            <dt>항목</dt>
                                            <dd>@factor.Name</dd>
                                            <dt>기준</dt>
                                            <dd>@factor.Baseline</dd>
                                            <dt>비교</dt>
                                            <dd>@factor.Changed</dd>
                                        </dl>
                                        @if (factor.SubgroupKeys.Count > 0)
                                        {
                                            <div class="chip-row">
                                                @foreach (string key in factor.SubgroupKeys.Take(18))
                                                {
                                                    <span>@key</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }

                        @if (item.Outcomes.Count > 0)
                        {
                            <div class="recognized-outcomes">
                                <table>
                                    <thead>
                                        <tr>
                                            <th>데이터 영역</th>
                                            <th>인식한 데이터</th>
                                            <th>AI 인식 내용</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (OutcomeView outcome in item.Outcomes)
                                        {
                                            <tr>
                                                <td>
                                                    <strong>@outcome.Domain</strong>
                                                </td>
                                                <td>@outcome.Metric</td>
                                                <td>@outcome.Summary</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        @if (item.Outcomes.Any(outcome => outcome.RecognizedTables.Count > 0))
                        {
                            <div class="recognized-data-tables">
                                @foreach (OutcomeView outcome in item.Outcomes.Where(outcome => outcome.RecognizedTables.Count > 0))
                                {
                                    @foreach (RecognizedTableView table in outcome.RecognizedTables)
                                    {
                                        <div class="recognized-data-table">
                                            <div class="recognized-data-head">
                                                <strong>@FirstNonBlank(table.Title, outcome.Domain)</strong>
                                                <span>@outcome.Metric</span>
                                            </div>
                                            <div class="recognized-data-scroll">
                                                <table>
                                                    @if (table.Headers.Count > 0)
                                                    {
                                                        <thead>
                                                            <tr>
                                                                @foreach (string header in table.Headers)
                                                                {
                                                                    <th>@header</th>
                                                                }
                                                            </tr>
                                                        </thead>
                                                    }
                                                    <tbody>
                                                        @foreach (IReadOnlyList<string> dataRow in table.Rows)
                                                        {
                                                            <tr>
                                                                @foreach (string cell in dataRow)
                                                                {
                                                                    <td>@cell</td>
                                                                }
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                }
            }

            @if (_reviewView.Issues.Count > 0)
            {
                <h3>이슈 / 주의사항</h3>
                <ul class="review-list">
                    @foreach (string item in _reviewView.Issues)
                    {
                        <li>@item</li>
                    }
                </ul>
            }

            @if (_reviewView.GenerationInvalid)
            {
                <h3>AI 생성 실패</h3>
                <p class="review-warning">
                    AI 인식 JSON이 유효하지 않아서 사용자 확인 질문을 받지 않습니다.
                    원본 Excel을 열어 확인한 뒤 다시 실행해야 합니다.
                </p>
            }
            else if (_reviewView.RequiredQuestions.Count > 0 && _reviewView.Cases.Count == 0)
            {
                <h3>AI 생성 불완전</h3>
                <p class="review-warning">
                    AI 인식 결과가 없어서 사용자 확인 질문을 받지 않습니다.
                    원본 Excel을 열어 확인한 뒤 다시 실행해야 합니다.
                </p>
            }
            else if (_reviewView.RequiredQuestions.Count > 0)
            {
                <h3>사용자 확인 필요</h3>
                <div class="answer-panel">
                    @for (int i = 0; i < _reviewView.RequiredQuestions.Count; i++)
                    {
                        <label class="answer-row">
                            <span>질문 @(i + 1)</span>
                            <strong>@DisplayQuestion(_reviewView.RequiredQuestions[i])</strong>
                            @if (i < _reviewView.QuestionRowReferences.Count && _reviewView.QuestionRowReferences[i].Count > 0)
                            {
                                <div class="question-row-preview">
                                    <div class="question-row-preview-title">질문에서 언급한 원본 행</div>
                                    @foreach (QuestionRowReferenceView rowRef in _reviewView.QuestionRowReferences[i])
                                    {
                                        <div class="question-ref-row">
                                            <div class="question-ref-head">
                                                <span class="row-ref-chip">@rowRef.RequestedRef</span>
                                                @if (!rowRef.RequestedRef.Equals(rowRef.ActualRef, StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <span class="actual-ref">실제 @rowRef.ActualRef</span>
                                                }
                                            </div>
                                            @if (rowRef.Cells.Count > 0)
                                            {
                                                <div class="question-ref-cells">
                                                    @foreach (QuestionCellView cell in rowRef.Cells)
                                                    {
                                                        <span><b>@cell.Label</b>@cell.Value</span>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="question-ref-missing">저장된 COM grid에서 해당 행을 찾지 못했습니다.</div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            <textarea class="form-control form-control-sm"
                                      rows="2"
                                      @bind="_questionAnswers[i]"
                                      placeholder="여기에 답변을 입력하세요. 예: 1min을 기준군으로 승인 / 단위는 mm"></textarea>
                        </label>
                    }

                    <label class="answer-row">
                        <span>추가 메모</span>
                        <textarea class="form-control form-control-sm"
                                  rows="2"
                                  @bind="_reviewMemo"
                                  placeholder="필요하면 추가 확인 내용이나 수정 지시를 입력하세요."></textarea>
                    </label>

                    <label class="check approval-check">
                        <input type="checkbox" @bind="_approveForAskAi" />
                        위 답변 기준으로 Ask AI 추출에 사용 가능
                    </label>

                    <div class="toolbar">
                        <button class="btn btn-primary btn-sm" type="button" @onclick="SaveUserReviewAsync">
                            답변 저장
                        </button>
                        @if (!string.IsNullOrWhiteSpace(_reviewSaveStatus))
                        {
                            <span class="save-status">@_reviewSaveStatus</span>
                        }
                    </div>
                </div>
            }

            @if (_reviewView.CorrectionPlan.Count > 0)
            {
                <h3>보정 방향</h3>
                <ul class="review-list">
                    @foreach (string item in _reviewView.CorrectionPlan)
                    {
                        <li>@item</li>
                    }
                </ul>
            }

            @if (!string.IsNullOrWhiteSpace(_reviewView.EvidencePolicy))
            {
                <h3>근거 사용 기준</h3>
                <p class="review-text">@_reviewView.EvidencePolicy</p>
            }

            <details>
                <summary>검증 JSON 원문</summary>
                <pre class="json-view">@_reviewView.VerificationJsonPretty</pre>
            </details>
            <details>
                <summary>AI 인식 JSON 원문</summary>
                <pre class="json-view">@_reviewView.GenerationJsonPretty</pre>
            </details>
        </section>
    }
    else if (!string.IsNullOrWhiteSpace(_reviewLoadError))
    {
        <section class="panel">
            <h2>AI 인식 결과 검토</h2>
            <p class="error-text">@_reviewLoadError</p>
        </section>
    }

    @if (_log.Count > 0)
    {
        <section class="panel">
            <div class="panel-head">
                <h2>Log</h2>
                <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="_log.Clear" disabled="@_isRunning">
                    Clear
                </button>
            </div>
            <pre class="log" @ref="_logRef">@string.Join(Environment.NewLine, _log)</pre>
        </section>
    }
</div>

@code {
    private const string DefaultInputPath = @"D:\000. MyWorks\test\result\InputDataFinish";
    private const long MaxSelectedInputFileBytes = 512L * 1024 * 1024;

    private readonly List<string> _log = [];
    private List<InputDataReviewCaseListRecord> _recentReviewCases = [];
    private readonly object _logLock = new();
    private CancellationTokenSource? _cts;
    private InputDataComPipelineResult? _lastRun;
    private InputDataReviewCaseRecord? _selectedReviewCase;
    private ReviewCaseView? _reviewView;
    private ElementReference _logRef;

    private string _inputPath = DefaultInputPath;
    private string _dataset = "InputData";
    private string _limitText = "";
    private string _status = "Ready";
    private bool _statusError;
    private string _selectedInputFileStatus = "";
    private bool _selectedInputFileError;
    private bool _runAiReviewCase;
    private bool _isRunning;
    private bool _scrollLog;
    private string _selectedReviewFileName = "";
    private string _selectedReviewSourcePath = "";
    private string _reviewLoadError = "";
    private string _openFileStatus = "";
    private List<string> _questionAnswers = [];
    private string _reviewMemo = "";
    private bool _approveForAskAi;
    private string _reviewSaveStatus = "";

    protected override void OnInitialized()
    {
        RefreshRecentReviewCases();
    }

    private async Task OnInputFileSelectedAsync(InputFileChangeEventArgs e)
    {
        if (_isRunning) return;

        IBrowserFile? file = e.File;
        if (file is null) return;

        try
        {
            string selectedDir = Path.Combine(
                Env.ContentRootPath,
                "tmp",
                "input-data-selected",
                DateTime.UtcNow.ToString("yyyyMMdd_HHmmss_fff"));
            Directory.CreateDirectory(selectedDir);

            string targetPath = Path.Combine(selectedDir, SafeFileName(file.Name));
            await using FileStream output = File.Create(targetPath);
            await using Stream input = file.OpenReadStream(MaxSelectedInputFileBytes);
            await input.CopyToAsync(output);

            _inputPath = targetPath;
            _selectedInputFileError = false;
            _selectedInputFileStatus = $"선택됨: {file.Name} ({FormatBytes(file.Size)})";
            _statusError = false;
            _status = "File selected";
        }
        catch (Exception ex)
        {
            _selectedInputFileError = true;
            _selectedInputFileStatus = $"파일 선택 실패: {ex.Message}";
            _statusError = true;
            _status = "File select failed";
            AddLogLine(ex.ToString());
        }
    }

    private async Task RunPipelineAsync()
    {
        if (_isRunning) return;

        _isRunning = true;
        _statusError = false;
        _status = _runAiReviewCase ? "Running COM + AI pipeline..." : "Running COM extraction...";
        _log.Clear();
        ClearReviewSelection();
        _cts = new CancellationTokenSource();

        try
        {
            var request = new InputDataComPipelineRequest(
                _inputPath.Trim(),
                _dataset.Trim(),
                ParseLimit(),
                _runAiReviewCase);

            _lastRun = await ComPipeline.RunAsync(request, AddLogLine, _cts.Token);
            _status = $"Complete: {_lastRun.SuccessCount:N0}/{_lastRun.FileCount:N0} file(s), {_lastRun.TotalCells:N0} cell(s), {_lastRun.MergeCount:N0} merge(s)";
            RefreshRecentReviewCases();
            AutoSelectReviewCase(_lastRun);
        }
        catch (OperationCanceledException)
        {
            _statusError = true;
            _status = "Stopped";
        }
        catch (Exception ex)
        {
            _statusError = true;
            _status = ex.Message;
            AddLogLine(ex.ToString());
        }
        finally
        {
            _isRunning = false;
            _cts?.Dispose();
            _cts = null;
        }
    }

    private void CancelRun() => _cts?.Cancel();

    private void OpenExcelFile(string sourcePath)
    {
        string path = (sourcePath ?? "").Trim().Trim('"');
        if (string.IsNullOrWhiteSpace(path) || !File.Exists(path))
        {
            _openFileStatus = $"Excel 파일을 찾을 수 없습니다: {path}";
            return;
        }

        try
        {
            var psi = new System.Diagnostics.ProcessStartInfo
            {
                FileName = Path.GetFullPath(path),
                UseShellExecute = true,
                Verb = "open",
                WorkingDirectory = Path.GetDirectoryName(path) ?? ""
            };
            System.Diagnostics.Process.Start(psi);
            _openFileStatus = $"Excel 열기 요청 완료: {Path.GetFileName(path)}";
        }
        catch (Exception ex)
        {
            _openFileStatus = $"Excel 열기 실패: {ex.Message}";
        }
    }

    private static bool CanOpenSourcePath(string sourcePath)
        => !string.IsNullOrWhiteSpace(sourcePath) && File.Exists(sourcePath.Trim().Trim('"'));

    private void AddLogLine(string line)
    {
        lock (_logLock)
        {
            _log.Add(line);
            if (_log.Count > 300)
                _log.RemoveRange(0, _log.Count - 300);
        }

        _scrollLog = true;
        _ = InvokeAsync(StateHasChanged);
    }

    private void AutoSelectReviewCase(InputDataComPipelineResult result)
    {
        InputDataComPipelineFileResult? row = result.Files.FirstOrDefault(x => x.AiSaved && x.WorkbookId > 0);
        if (row is not null)
            LoadReviewCase(row);
    }

    private void RefreshRecentReviewCases()
    {
        try
        {
            _recentReviewCases = Repo.GetRecentInputDataReviewCases(_dataset.Trim(), 20);
        }
        catch (Exception ex)
        {
            _reviewLoadError = ex.Message;
        }
    }

    private void LoadReviewCase(InputDataComPipelineFileResult row)
        => LoadReviewCase(row.WorkbookId, row.SourceFileName, row.SourcePath);

    private void LoadReviewCase(long workbookId, string sourceFileName, string sourcePath = "")
    {
        ClearReviewSelection();
        _selectedReviewFileName = sourceFileName;
        _selectedReviewSourcePath = sourcePath;

        try
        {
            List<InputDataReviewCaseRecord> cases = Repo.GetInputDataReviewCases(workbookId);
            if (cases.Count == 0)
            {
                _reviewLoadError = $"No AI recognition row was found for workbookId={workbookId}.";
                return;
            }

            _selectedReviewCase = cases[0];
            _reviewView = BuildReviewView(_selectedReviewCase);
            AttachRecognizedDataTables(_selectedReviewCase.WorkbookId, _reviewView);
            AttachQuestionRowReferences(_selectedReviewCase.WorkbookId, _reviewView);
            LoadUserReviewState(_selectedReviewCase, _reviewView);
        }
        catch (Exception ex)
        {
            _reviewLoadError = ex.Message;
        }
    }

    private void AttachQuestionRowReferences(long workbookId, ReviewCaseView view)
    {
        view.QuestionRowReferences.Clear();
        List<string> knownSheets = KnownEvidenceSheetNames(view);

        foreach (string question in view.RequiredQuestions)
        {
            List<string> requestedRefs = ExtractQuestionRowRefs(question);
            List<string> lookupRefs = ResolveQuestionLookupRefs(requestedRefs, knownSheets);
            List<InputDataComRowPreview> rows = lookupRefs.Count == 0
                ? []
                : Repo.GetInputDataComRows(workbookId, lookupRefs);

            var rowsByRef = rows.ToDictionary(row => row.RowRef, StringComparer.OrdinalIgnoreCase);
            var questionRefs = new List<QuestionRowReferenceView>();
            foreach (string requestedRef in requestedRefs)
            {
                InputDataComRowPreview? row = null;
                if (!rowsByRef.TryGetValue(requestedRef, out row)
                    && ParseInputDataRowRef(requestedRef) is { } parsed)
                {
                    foreach (string sheetName in knownSheets)
                    {
                        if (rowsByRef.TryGetValue($"{sheetName}!{parsed.RowNumber}", out row))
                            break;
                    }
                }

                questionRefs.Add(BuildQuestionRowReference(requestedRef, row));
            }

            view.QuestionRowReferences.Add(questionRefs);
        }
    }

    private void AttachRecognizedDataTables(long workbookId, ReviewCaseView view)
    {
        foreach (GeneratedCaseView reviewCase in view.Cases)
        {
            foreach (OutcomeView outcome in reviewCase.Outcomes)
            {
                bool isTension = IsTensionOutcome(outcome);
                if (!isTension && outcome.RecognizedTables.Count > 0) continue;

                List<string> baseRowRefs = (outcome.EvidenceRows.Count > 0 ? outcome.EvidenceRows : outcome.ComparisonRows)
                    .Where(row => !string.IsNullOrWhiteSpace(row))
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .ToList();
                List<string> rowRefs = isTension
                    ? ExpandRowRefs(baseRowRefs, before: 24, after: 6, maxRows: 160)
                    : baseRowRefs.Take(80).ToList();
                if (rowRefs.Count == 0) continue;

                List<InputDataComRowPreview> rows = Repo.GetInputDataComRows(workbookId, rowRefs);
                if (isTension && !HasTensionStatsTable(outcome))
                {
                    RecognizedTableView? tensionTable = BuildTensionMeasurementTable(rows);
                    if (tensionTable is not null)
                        outcome.RecognizedTables.Insert(0, tensionTable);
                }

                if (outcome.RecognizedTables.Count > 0) continue;

                RecognizedTableView? table = BuildRecognizedTableFromRawGrid(outcome, rows);
                if (table is not null)
                    outcome.RecognizedTables.Add(table);
            }
        }
    }

