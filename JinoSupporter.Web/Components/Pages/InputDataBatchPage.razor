    private enum ComparisonRoleKind
    {
        None,
        Normal,
        Test
    }

    private readonly record struct ComparisonRole(ComparisonRoleKind Kind, bool IsRatio);

    private sealed class ComparisonRowGroup
    {
        public List<string>? NormalMain { get; private set; }
        public List<string>? TestMain { get; private set; }
        public List<string>? NormalRatio { get; private set; }
        public List<string>? TestRatio { get; private set; }
        public bool HasAny => NormalMain is not null || TestMain is not null || NormalRatio is not null || TestRatio is not null;

        public bool HasMain(ComparisonRoleKind kind)
            => kind == ComparisonRoleKind.Normal ? NormalMain is not null : TestMain is not null;

        public bool HasAnyOpposite(ComparisonRoleKind kind)
            => kind == ComparisonRoleKind.Normal
                ? TestMain is not null || TestRatio is not null
                : NormalMain is not null || NormalRatio is not null;

        public void Set(ComparisonRole role, List<string> row)
        {
            if (role.Kind == ComparisonRoleKind.Normal)
            {
                if (role.IsRatio) NormalRatio = row;
                else NormalMain = row;
            }
            else if (role.Kind == ComparisonRoleKind.Test)
            {
                if (role.IsRatio) TestRatio = row;
                else TestMain = row;
            }
        }
    }

    private sealed class ChangedFactorView
    {
        public string Domain { get; set; } = "";
        public string Name { get; set; } = "";
        public string Baseline { get; set; } = "";
        public string Changed { get; set; } = "";
        public List<string> SubgroupKeys { get; set; } = [];
        public List<string> EvidenceRows { get; set; } = [];
        public List<string> EvidenceCells { get; set; } = [];
    }
}

