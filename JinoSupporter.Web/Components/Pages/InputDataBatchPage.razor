    private void ClearReviewSelection()
    {
        _selectedReviewCase = null;
        _reviewView = null;
        _selectedReviewFileName = "";
        _selectedReviewSourcePath = "";
        _reviewLoadError = "";
        _openFileStatus = "";
        _questionAnswers = [];
        _reviewMemo = "";
        _approveForAskAi = false;
        _reviewSaveStatus = "";
    }

    private void LoadUserReviewState(InputDataReviewCaseRecord row, ReviewCaseView view)
    {
        _questionAnswers = Enumerable.Repeat("", view.RequiredQuestions.Count).ToList();
        _reviewMemo = "";
        _approveForAskAi = row.ApprovedForAskAi;
        _reviewSaveStatus = string.IsNullOrWhiteSpace(row.UserReviewedAt)
            ? ""
            : $"저장됨: {row.UserReviewedAt}";

        try
        {
            using JsonDocument doc = JsonDocument.Parse(row.UserAnswerJson);
            JsonElement root = doc.RootElement;
            if (TryGetProperty(root, "answers", out JsonElement answers) && answers.ValueKind == JsonValueKind.Array)
            {
                int i = 0;
                foreach (JsonElement answer in answers.EnumerateArray())
                {
                    if (i >= _questionAnswers.Count) break;
                    _questionAnswers[i] = JsonString(answer, "answer");
                    i++;
                }
            }

            _reviewMemo = JsonString(root, "memo");
        }
        catch
        {
            // Older rows have no user review JSON.
        }
    }

    private Task SaveUserReviewAsync()
    {
        if (_selectedReviewCase is null || _reviewView is null) return Task.CompletedTask;

        string now = DateTime.UtcNow.ToString("O");
        var payload = new
        {
            source = "InputDataBatchPage",
            reviewedAt = now,
            approvedForAskAi = _approveForAskAi,
            questions = _reviewView.RequiredQuestions,
            answers = _reviewView.RequiredQuestions.Select((question, index) => new
            {
                question,
                answer = index < _questionAnswers.Count ? _questionAnswers[index].Trim() : ""
            }).ToList(),
            memo = _reviewMemo.Trim()
        };

        string json = JsonSerializer.Serialize(payload, new JsonSerializerOptions { WriteIndented = false });
        Repo.SaveInputDataReviewCaseUserReview(new InputDataReviewCaseUserReviewSave(
            _selectedReviewCase.Id,
            json,
            _approveForAskAi,
            now));

        LoadReviewCase(_selectedReviewCase.WorkbookId, _selectedReviewFileName);
        RefreshRecentReviewCases();
        _reviewSaveStatus = _approveForAskAi
            ? "답변 저장 및 Ask AI 추출 사용 가능 처리"
            : "답변 저장 완료";
        return Task.CompletedTask;
    }

