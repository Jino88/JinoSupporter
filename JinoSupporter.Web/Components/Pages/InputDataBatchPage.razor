    private static ReviewCaseView BuildReviewView(InputDataReviewCaseRecord row)
    {
        var view = new ReviewCaseView
        {
            Status = row.Status,
            ApprovedForAskAi = row.ApprovedForAskAi,
            GenerationJsonPretty = PrettyJson(row.GenerationJson),
            VerificationJsonPretty = PrettyJson(row.VerificationJson)
        };

        try
        {
            using JsonDocument doc = JsonDocument.Parse(row.VerificationJson);
            JsonElement root = doc.RootElement;
            view.VerificationStatus = FirstNonBlank(JsonString(root, "verificationStatus"), JsonString(root, "status"));
            view.Confidence = JsonString(root, "confidence");
            view.Summary = JsonString(root, "summary");
            view.EvidencePolicy = JsonString(root, "evidencePolicy");
            view.Issues = JsonStringList(root, "issues");
            view.RequiredQuestions = JsonStringList(root, "requiredUserQuestions");
            view.CorrectionPlan = JsonStringList(root, "correctionPlan");
        }
        catch (Exception ex)
        {
            view.Summary = $"Verification JSON could not be parsed: {ex.Message}";
        }

        try
        {
            using JsonDocument doc = JsonDocument.Parse(row.GenerationJson);
            JsonElement root = doc.RootElement;
            if (TryGetProperty(root, "reviewCases", out JsonElement cases) && cases.ValueKind == JsonValueKind.Array)
            {
                foreach (JsonElement caseElement in cases.EnumerateArray())
                {
                    var item = new GeneratedCaseView
                    {
                        ReviewCaseId = FirstNonBlank(JsonString(caseElement, "reviewCaseId"), row.ReviewCaseId),
                        Title = FirstNonBlank(JsonString(caseElement, "reviewTitle"), row.ReviewCaseId),
                        Purpose = JsonString(caseElement, "reviewPurpose"),
                        EvidenceRows = JsonStringList(caseElement, "evidenceRows"),
                        EvidenceCells = JsonStringList(caseElement, "evidenceCells"),
                        Limitations = JsonStringList(caseElement, "limitations")
                    };

                    if (TryGetProperty(caseElement, "changedFactors", out JsonElement factors) && factors.ValueKind == JsonValueKind.Array)
                    {
                        foreach (JsonElement factorElement in factors.EnumerateArray())
                        {
                            item.ChangedFactors.Add(new ChangedFactorView
                            {
                                Domain = JsonString(factorElement, "changeDomain"),
                                Name = JsonString(factorElement, "changedFactor"),
                                Baseline = JsonString(factorElement, "baselineCondition"),
                                Changed = JsonString(factorElement, "changedCondition"),
                                SubgroupKeys = JsonStringList(factorElement, "subgroupKeys"),
                                EvidenceRows = JsonStringList(factorElement, "evidenceRows"),
                                EvidenceCells = JsonStringList(factorElement, "evidenceCells")
                            });
                        }
                    }

                    if (TryGetProperty(caseElement, "outcomes", out JsonElement outcomes)
                        && outcomes.ValueKind != JsonValueKind.Undefined
                        && outcomes.ValueKind != JsonValueKind.Null
                        && outcomes.GetRawText() != "[]")
                    {
                        item.Outcomes = ReadOutcomeViews(outcomes);
                        item.OutcomesJson = PrettyJson(outcomes.GetRawText());
                    }

                    view.Cases.Add(item);
                }
            }
        }
        catch
        {
            view.GenerationInvalid = true;
        }

        if (view.Cases.Count == 0 && LooksLikeGenerationFailure(view))
            view.GenerationInvalid = true;
        if (view.GenerationInvalid)
            view.RequiredQuestions.Clear();

        if (string.IsNullOrWhiteSpace(view.Summary) && view.Cases.Count > 0)
            view.Summary = view.Cases[0].Title;
        if (string.IsNullOrWhiteSpace(view.VerificationStatus))
            view.VerificationStatus = row.Status;
        if (string.IsNullOrWhiteSpace(view.Confidence))
            view.Confidence = "-";

        return view;
    }

    private static List<OutcomeView> ReadOutcomeViews(JsonElement outcomes)
    {
        var rows = new List<OutcomeView>();
        if (outcomes.ValueKind != JsonValueKind.Array) return rows;

        foreach (JsonElement outcome in outcomes.EnumerateArray())
        {
            string raw = outcome.GetRawText();
            var row = new OutcomeView
            {
                OutcomeId = JsonString(outcome, "outcomeId"),
                Domain = FirstNonBlank(JsonString(outcome, "outcomeDomain"), JsonString(outcome, "domain"), "-"),
                Metric = FirstNonBlank(JsonString(outcome, "outcomeMetric"), JsonString(outcome, "metric"), JsonString(outcome, "item"), "-"),
                Summary = FirstNonBlank(JsonString(outcome, "resultSummary"), JsonString(outcome, "summary"), JsonString(outcome, "result"), "-"),
                ComparisonRows = JsonStringList(outcome, "comparisonRows"),
                EvidenceRows = JsonStringList(outcome, "evidenceRows"),
                EvidenceCells = JsonStringList(outcome, "evidenceCells"),
                RecognizedTables = ReadRecognizedTables(outcome),
                RawJsonPretty = PrettyJson(raw)
            };

            if (row.ComparisonRows.Count == 0)
                row.ComparisonRows = JsonStringList(outcome, "sourceRows");

            rows.Add(row);
        }

        return rows;
    }

    private static bool IsTensionOutcome(OutcomeView outcome)
    {
        string text = string.Join(" ", new[] { outcome.OutcomeId, outcome.Domain, outcome.Metric, outcome.Summary });
        return text.Contains("tension", StringComparison.OrdinalIgnoreCase)
               || text.Contains("RESULT CHECKING TENSION", StringComparison.OrdinalIgnoreCase);
    }

    private static bool HasTensionStatsTable(OutcomeView outcome)
        => outcome.RecognizedTables.Any(table =>
            table.Headers.Any(header => header.Contains("Long S-MG", StringComparison.OrdinalIgnoreCase))
            && table.Rows.Any(row => row.Count > 0 && row[0].Contains("Std", StringComparison.OrdinalIgnoreCase)));

    private static List<string> ExpandRowRefs(IReadOnlyList<string> rowRefs, int before, int after, int maxRows)
    {
        List<(string SheetName, int RowNumber)> parsed = rowRefs
            .Select(ParseInputDataRowRef)
            .Where(row => row.HasValue)
            .Select(row => row!.Value)
            .ToList();
        if (parsed.Count == 0)
            return rowRefs.Take(maxRows).ToList();

        var expanded = new List<string>();
        foreach (IGrouping<string, (string SheetName, int RowNumber)> group in parsed.GroupBy(row => row.SheetName, StringComparer.OrdinalIgnoreCase))
        {
            int start = Math.Max(1, group.Min(row => row.RowNumber) - before);
            int end = group.Max(row => row.RowNumber) + after;
            for (int rowNumber = start; rowNumber <= end; rowNumber++)
                expanded.Add($"{group.Key}!{rowNumber}");
        }

        return expanded
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(maxRows)
            .ToList();
    }

    private static (string SheetName, int RowNumber)? ParseInputDataRowRef(string rowRef)
    {
        string text = (rowRef ?? "").Trim();
        int bang = text.LastIndexOf('!');
        if (bang <= 0 || bang >= text.Length - 1) return null;

        string sheetName = text[..bang].Trim();
        string rowText = text[(bang + 1)..].Trim();
        return int.TryParse(rowText, out int rowNumber) && rowNumber > 0 && !string.IsNullOrWhiteSpace(sheetName)
            ? (sheetName, rowNumber)
            : null;
    }

    private static List<string> ExtractQuestionRowRefs(string question)
    {
        string text = question ?? "";
        return System.Text.RegularExpressions.Regex.Matches(text, @"([A-Za-z0-9_. \-]+)!(\d+)")
            .Cast<System.Text.RegularExpressions.Match>()
            .Select(match => $"{match.Groups[1].Value.Trim()}!{match.Groups[2].Value.Trim()}")
            .Where(rowRef => ParseInputDataRowRef(rowRef).HasValue)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(16)
            .ToList();
    }

    private static List<string> ResolveQuestionLookupRefs(IReadOnlyList<string> requestedRefs, IReadOnlyList<string> knownSheets)
    {
        var refs = new List<string>();
        foreach (string requestedRef in requestedRefs)
        {
            refs.Add(requestedRef);
            if (ParseInputDataRowRef(requestedRef) is not { } parsed) continue;

            foreach (string sheetName in knownSheets)
                refs.Add($"{sheetName}!{parsed.RowNumber}");
        }

        return refs
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(80)
            .ToList();
    }

    private static List<string> KnownEvidenceSheetNames(ReviewCaseView view)
    {
        var rowRefs = new List<string>();
        foreach (GeneratedCaseView reviewCase in view.Cases)
        {
            rowRefs.AddRange(reviewCase.EvidenceRows);
            foreach (ChangedFactorView factor in reviewCase.ChangedFactors)
                rowRefs.AddRange(factor.EvidenceRows);
            foreach (OutcomeView outcome in reviewCase.Outcomes)
            {
                rowRefs.AddRange(outcome.EvidenceRows);
                rowRefs.AddRange(outcome.ComparisonRows);
            }
        }

        return rowRefs
            .Select(ParseInputDataRowRef)
            .Where(row => row.HasValue)
            .Select(row => row!.Value.SheetName)
            .Where(sheetName => !string.IsNullOrWhiteSpace(sheetName))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(8)
            .ToList();
    }

    private static QuestionRowReferenceView BuildQuestionRowReference(string requestedRef, InputDataComRowPreview? row)
    {
        var view = new QuestionRowReferenceView
        {
            RequestedRef = requestedRef,
            ActualRef = row?.RowRef ?? requestedRef
        };

        if (row is null) return view;

        view.Cells = row.Cells
            .Where(cell => !string.IsNullOrWhiteSpace(cell.CellValue))
            .OrderBy(cell => cell.ColNumber)
            .Take(18)
            .Select(cell => new QuestionCellView(
                FirstNonBlank(cell.ColLabel, cell.CellAddress) + ": ",
                CleanTableText(cell.CellValue)))
            .ToList();

        return view;
    }

    private static RecognizedTableView? BuildTensionMeasurementTable(IReadOnlyList<InputDataComRowPreview> sourceRows)
    {
        List<InputDataComRowPreview> rows = sourceRows
            .OrderBy(row => row.SheetName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(row => row.RowNumber)
            .ToList();
        if (rows.Count == 0) return null;

        int categoryIndex = rows.FindIndex(row =>
            RowContains(row, "Long S-MG")
            && RowContains(row, "Short")
            && RowContains(row, "YOKE"));
        if (categoryIndex < 0) return null;

        int conditionIndex = -1;
        for (int i = categoryIndex + 1; i < Math.Min(rows.Count, categoryIndex + 5); i++)
        {
            int conditionCount = rows[i].Cells.Count(cell => IsBondCondition(cell.CellValue));
            if (conditionCount >= 2)
            {
                conditionIndex = i;
                break;
            }
        }

        if (conditionIndex < 0) return null;

        int dataStartIndex = -1;
        int noCol = 0;
        for (int i = conditionIndex + 1; i < Math.Min(rows.Count, conditionIndex + 8); i++)
        {
            if (TryFindMeasurementNoColumn(rows[i], out noCol))
            {
                dataStartIndex = i;
                break;
            }
        }

        if (dataStartIndex < 0 || noCol <= 0) return null;

        List<TensionValueColumn> valueColumns = BuildTensionValueColumns(
            rows[categoryIndex],
            rows[conditionIndex],
            rows[dataStartIndex],
            noCol);
        if (valueColumns.Count == 0) return null;

        var table = new RecognizedTableView { Title = "RESULT CHECKING TENSION - Measurement" };
        table.Headers.Add("No");
        table.Headers.AddRange(valueColumns.Select(column => $"{column.Group} {column.Condition}"));

        var numericValues = valueColumns.ToDictionary(column => column.ColNumber, _ => new List<double>());
        for (int i = dataStartIndex; i < rows.Count; i++)
        {
            InputDataComRowPreview row = rows[i];
            if (RowLooksLikeQtyCheckHeader(row)) break;

            string label = CleanTableText(FirstNonBlank(CellValueAt(row, noCol), FirstNonEmptyCellValue(row)));
            bool isMeasurementRow = TryParseIntegerLabel(label, out _);
            bool isSummaryRow = IsTensionSummaryLabel(label);
            if (!isMeasurementRow && !isSummaryRow)
            {
                if (table.Rows.Count > 0 && !RowHasAnyValue(row, valueColumns.Select(column => column.ColNumber)))
                    break;
                continue;
            }

            var cells = new List<string> { label };
            foreach (TensionValueColumn column in valueColumns)
            {
                string value = CleanTableText(CellValueAt(row, column.ColNumber));
                cells.Add(value);
                if (isMeasurementRow && TryParseDouble(value, out double numericValue))
                    numericValues[column.ColNumber].Add(numericValue);
            }

            table.Rows.Add(cells);
            if (label.Equals("AVG", StringComparison.OrdinalIgnoreCase))
                break;
        }

        if (table.Rows.Count == 0) return null;

        var stdDevRow = new List<string> { "Std Dev" };
        foreach (TensionValueColumn column in valueColumns)
            stdDevRow.Add(FormatStatValue(SampleStdDev(numericValues[column.ColNumber])));
        table.Rows.Add(stdDevRow);
        return table;
    }

    private static List<TensionValueColumn> BuildTensionValueColumns(
        InputDataComRowPreview categoryRow,
        InputDataComRowPreview conditionRow,
        InputDataComRowPreview firstDataRow,
        int noCol)
    {
        var categoryColumns = categoryRow.Cells
            .Where(cell => !string.IsNullOrWhiteSpace(cell.CellValue))
            .Select(cell => (cell.ColNumber, Group: NormalizeTensionGroup(cell.CellValue)))
            .Where(cell => !string.IsNullOrWhiteSpace(cell.Group))
            .OrderBy(cell => cell.ColNumber)
            .ToList();

        List<int> dataColumns = firstDataRow.Cells
            .Where(cell => cell.ColNumber > noCol && TryParseDouble(cell.CellValue, out _))
            .Select(cell => cell.ColNumber)
            .OrderBy(col => col)
            .Take(8)
            .ToList();

        var columns = new List<TensionValueColumn>();
        for (int i = 0; i < dataColumns.Count; i++)
        {
            int colNumber = dataColumns[i];
            string group = ResolveTensionGroup(categoryColumns, colNumber, i);
            if (string.IsNullOrWhiteSpace(group)) continue;

            string condition = CleanTableText(CellValueAt(conditionRow, colNumber));
            if (string.IsNullOrWhiteSpace(condition))
                condition = CleanTableText(NearestNonEmptyCellValue(conditionRow, colNumber));
            if (string.IsNullOrWhiteSpace(condition))
                condition = $"Value {i + 1}";

            columns.Add(new TensionValueColumn(colNumber, group, condition));
        }

        return columns;
    }

    private static string ResolveTensionGroup(List<(int ColNumber, string Group)> categoryColumns, int colNumber, int index)
    {
        for (int i = categoryColumns.Count - 1; i >= 0; i--)
        {
            if (categoryColumns[i].ColNumber <= colNumber)
                return categoryColumns[i].Group;
        }

        return index switch
        {
            0 or 1 => "Long S-MG",
            2 or 3 => "Short - S-MG",
            _ => "YOKE"
        };
    }

    private static string NormalizeTensionGroup(string value)
    {
        string text = CleanTableText(value);
        if (text.Contains("Long", StringComparison.OrdinalIgnoreCase) && text.Contains("S-MG", StringComparison.OrdinalIgnoreCase))
            return "Long S-MG";
        if (text.Contains("Short", StringComparison.OrdinalIgnoreCase) && text.Contains("S-MG", StringComparison.OrdinalIgnoreCase))
            return "Short - S-MG";
        if (text.Equals("YOKE", StringComparison.OrdinalIgnoreCase) || text.Contains("YOKE", StringComparison.OrdinalIgnoreCase))
            return "YOKE";
        return "";
    }

    private static bool TryFindMeasurementNoColumn(InputDataComRowPreview row, out int noCol)
    {
        foreach (InputDataComCellPreview cell in row.Cells.Where(cell => !string.IsNullOrWhiteSpace(cell.CellValue)).OrderBy(cell => cell.ColNumber))
        {
            if (!TryParseIntegerLabel(cell.CellValue, out _)) continue;

            int numericValues = row.Cells.Count(candidate =>
                candidate.ColNumber > cell.ColNumber
                && TryParseDouble(candidate.CellValue, out _));
            if (numericValues >= 3)
            {
                noCol = cell.ColNumber;
                return true;
            }
        }

        noCol = 0;
        return false;
    }

    private static bool RowContains(InputDataComRowPreview row, string value)
        => row.Cells.Any(cell => cell.CellValue.Contains(value, StringComparison.OrdinalIgnoreCase));

    private static bool IsBondCondition(string value)
    {
        string text = CleanTableText(value);
        return text.Contains("New Bond", StringComparison.OrdinalIgnoreCase)
               || text.Contains("Normal Bond", StringComparison.OrdinalIgnoreCase)
               || text.Contains("G06-", StringComparison.OrdinalIgnoreCase);
    }

    private static bool RowLooksLikeQtyCheckHeader(InputDataComRowPreview row)
    {
        string text = string.Join(" ", row.Cells.Select(cell => CleanTableText(cell.CellValue)));
        return text.Contains("Q'ty check", StringComparison.OrdinalIgnoreCase)
               || (text.Contains("Date", StringComparison.OrdinalIgnoreCase)
                   && text.Contains("Line", StringComparison.OrdinalIgnoreCase)
                   && text.Contains("NG Rate", StringComparison.OrdinalIgnoreCase));
    }

    private static bool RowHasAnyValue(InputDataComRowPreview row, IEnumerable<int> columnNumbers)
        => columnNumbers.Any(colNumber => !string.IsNullOrWhiteSpace(CellValueAt(row, colNumber)));

    private static string FirstNonEmptyCellValue(InputDataComRowPreview row)
        => CleanTableText(row.Cells
            .OrderBy(cell => cell.ColNumber)
            .FirstOrDefault(cell => !string.IsNullOrWhiteSpace(cell.CellValue))
            ?.CellValue ?? "");

    private static string NearestNonEmptyCellValue(InputDataComRowPreview row, int colNumber)
        => CleanTableText(row.Cells
            .Where(cell => !string.IsNullOrWhiteSpace(cell.CellValue))
            .OrderBy(cell => Math.Abs(cell.ColNumber - colNumber))
            .ThenBy(cell => cell.ColNumber)
            .FirstOrDefault()
            ?.CellValue ?? "");

    private static bool IsTensionSummaryLabel(string label)
    {
        string text = CleanTableText(label).Trim();
        return text.Equals("Min", StringComparison.OrdinalIgnoreCase)
               || text.Equals("Max", StringComparison.OrdinalIgnoreCase)
               || text.Equals("AVG", StringComparison.OrdinalIgnoreCase)
               || text.Equals("Average", StringComparison.OrdinalIgnoreCase);
    }

    private static bool TryParseIntegerLabel(string value, out int number)
    {
        number = 0;
        if (!TryParseDouble(value, out double numeric)) return false;
        int rounded = (int)Math.Round(numeric);
        if (rounded <= 0 || Math.Abs(numeric - rounded) > 0.0001) return false;

        number = rounded;
        return true;
    }

    private static bool TryParseDouble(string value, out double number)
    {
        string text = CleanTableText(value).TrimEnd('%');
        return double.TryParse(text, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out number)
               || double.TryParse(text, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.CurrentCulture, out number);
    }

    private static double SampleStdDev(IReadOnlyList<double> values)
    {
        if (values.Count <= 1) return 0;

        double average = values.Average();
        double variance = values.Sum(value => Math.Pow(value - average, 2)) / (values.Count - 1);
        return Math.Sqrt(variance);
    }

    private static string FormatStatValue(double value)
        => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private static string CleanTableText(string text)
    {
        string value = (text ?? "")
            .Replace("\r", " ", StringComparison.Ordinal)
            .Replace("\n", " ", StringComparison.Ordinal)
            .Replace("\"", "", StringComparison.Ordinal)
            .Trim();
        while (value.Contains("  ", StringComparison.Ordinal))
            value = value.Replace("  ", " ", StringComparison.Ordinal);
        return value;
    }

    private static List<RecognizedTableView> ReadRecognizedTables(JsonElement outcome)
    {
        var tables = new List<RecognizedTableView>();
        AddRecognizedTablesFromProperty(outcome, "recognizedTables", tables);
        AddRecognizedTablesFromProperty(outcome, "recognizedTable", tables);
        AddRecognizedTablesFromProperty(outcome, "dataTables", tables);
        AddRecognizedTablesFromProperty(outcome, "dataTable", tables);
        AddRecognizedTablesFromProperty(outcome, "table", tables);

        if (tables.Count == 0 && TryGetProperty(outcome, "subResults", out JsonElement subResults))
            AddRecognizedTableFromElement(subResults, "AI 인식 상세", tables);

        return tables
            .Where(table => table.Headers.Count > 0 && table.Rows.Count > 0)
            .Take(8)
            .ToList();
    }

    private static void AddRecognizedTablesFromProperty(JsonElement root, string name, List<RecognizedTableView> tables)
    {
        if (!TryGetProperty(root, name, out JsonElement value)) return;

        if (value.ValueKind == JsonValueKind.Array)
        {
            foreach (JsonElement item in value.EnumerateArray())
                AddRecognizedTableFromElement(item, "", tables);
        }
        else
        {
            AddRecognizedTableFromElement(value, "", tables);
        }
    }

    private static void AddRecognizedTableFromElement(JsonElement value, string fallbackTitle, List<RecognizedTableView> tables)
    {
        if (value.ValueKind == JsonValueKind.Object)
        {
            string title = FirstNonBlank(JsonString(value, "title"), JsonString(value, "name"), fallbackTitle);
            List<string> headers = JsonStringList(value, "columns");
            if (headers.Count == 0) headers = JsonStringList(value, "headers");

            JsonElement rowsElement = default;
            if (!TryGetProperty(value, "rows", out rowsElement)
                && !TryGetProperty(value, "dataRows", out rowsElement)
                && !TryGetProperty(value, "items", out rowsElement))
            {
                return;
            }

            RecognizedTableView table = BuildRecognizedTable(title, headers, rowsElement);
            if (table.Rows.Count > 0)
                tables.Add(table);
            return;
        }

        if (value.ValueKind == JsonValueKind.Array)
        {
            RecognizedTableView table = BuildRecognizedTable(fallbackTitle, [], value);
            if (table.Rows.Count > 0)
                tables.Add(table);
        }
    }

    private static RecognizedTableView BuildRecognizedTable(string title, List<string> headers, JsonElement rowsElement)
    {
        var table = new RecognizedTableView { Title = title };
        table.Headers.AddRange(headers.Where(header => !string.IsNullOrWhiteSpace(header)));
        if (rowsElement.ValueKind != JsonValueKind.Array) return table;

        foreach (JsonElement row in rowsElement.EnumerateArray())
        {
            if (row.ValueKind == JsonValueKind.Array)
            {
                List<string> cells = row.EnumerateArray().Select(JsonCellText).ToList();
                if (table.Headers.Count == 0)
                    table.Headers.AddRange(Enumerable.Range(1, cells.Count).Select(index => $"값 {index}"));
                table.Rows.Add(NormalizeTableRow(cells, table.Headers.Count));
            }
            else if (row.ValueKind == JsonValueKind.Object)
            {
                if (table.Headers.Count == 0)
                {
                    table.Headers.AddRange(row.EnumerateObject()
                        .Select(prop => prop.Name)
                        .Where(name => !LooksLikeEvidenceProperty(name))
                        .ToList());
                }

                var cells = new List<string>();
                foreach (string header in table.Headers)
                {
                    cells.Add(TryGetProperty(row, header, out JsonElement cell) ? JsonCellText(cell) : "");
                }

                table.Rows.Add(NormalizeTableRow(cells, table.Headers.Count));
            }
        }

        table.Rows = table.Rows
            .Where(row => row.Any(cell => !string.IsNullOrWhiteSpace(cell)))
            .Take(80)
            .ToList();
        FinalizeRecognizedTable(table);
        return table;
    }

    private static bool LooksLikeEvidenceProperty(string name)
        => name.Equals("evidenceRows", StringComparison.OrdinalIgnoreCase)
           || name.Equals("evidenceCells", StringComparison.OrdinalIgnoreCase)
           || name.Equals("rowId", StringComparison.OrdinalIgnoreCase)
           || name.Equals("sheetName", StringComparison.OrdinalIgnoreCase)
           || name.Equals("rowNumber", StringComparison.OrdinalIgnoreCase);

    private static string JsonCellText(JsonElement value)
    {
        string text = value.ValueKind == JsonValueKind.String ? value.GetString() ?? "" : value.GetRawText();
        text = text.Replace("\r", " ", StringComparison.Ordinal).Replace("\n", " ", StringComparison.Ordinal).Trim();
        return text.Length <= 260 ? text : text[..260] + "...";
    }

    private static List<string> NormalizeTableRow(List<string> cells, int width)
    {
        if (cells.Count > width)
            return cells.Take(width).ToList();
        if (cells.Count < width)
            cells.AddRange(Enumerable.Repeat("", width - cells.Count));
        return cells;
    }

    private static RecognizedTableView? BuildRecognizedTableFromRawGrid(OutcomeView outcome, IReadOnlyList<InputDataComRowPreview> sourceRows)
    {
        IReadOnlyList<InputDataComCellPreview> columns = RecognizedColumns(sourceRows);
        if (columns.Count == 0) return null;

        var table = new RecognizedTableView
        {
            Title = outcome.Domain
        };
        table.Headers.AddRange(columns.Select(column => column.ColLabel));

        foreach (InputDataComRowPreview row in sourceRows)
        {
            List<string> cells = columns
                .Select(column => CellValueAt(row, column.ColNumber))
                .ToList();
            if (cells.Any(cell => !string.IsNullOrWhiteSpace(cell)))
                table.Rows.Add(cells);
        }

        FinalizeRecognizedTable(table);
        return table.Rows.Count == 0 ? null : table;
    }

    private static void FinalizeRecognizedTable(RecognizedTableView table)
    {
        NormalizeContinuationRatioRows(table);
        PivotComparisonRows(table);
    }

    private static void NormalizeContinuationRatioRows(RecognizedTableView table)
    {
        if (table.Headers.Count == 0 || table.Rows.Count == 0) return;

        int labelIndex = FindHeaderIndex(table.Headers, "Type");
        if (labelIndex < 0) labelIndex = FindHeaderIndex(table.Headers, "Item");
        if (labelIndex < 0) labelIndex = FindHeaderIndex(table.Headers, "Result");
        if (labelIndex < 0) labelIndex = 0;

        List<string>? previousMainRow = null;
        var normalizedRows = new List<IReadOnlyList<string>>();
        foreach (IReadOnlyList<string> rawRow in table.Rows)
        {
            var row = rawRow.ToList();
            NormalizeTableRow(row, table.Headers.Count);

            if (previousMainRow is not null && LooksLikeContinuationRatioRow(table.Headers, row))
            {
                string previousLabel = labelIndex < previousMainRow.Count ? previousMainRow[labelIndex] : "";
                row[labelIndex] = $"{FirstNonBlank(previousLabel, "이전 조건")} 비율";

                for (int i = 0; i < row.Count; i++)
                {
                    if (i == labelIndex || IsIdentityHeader(table.Headers[i])) continue;
                    if (TryParseDouble(row[i], out double value) && value >= 0 && value <= 1)
                        row[i] = FormatPercent(value);
                }
            }
            else if (HasIdentityValue(table.Headers, row))
            {
                previousMainRow = row.ToList();
            }

            normalizedRows.Add(row);
        }

        table.Rows = normalizedRows;
    }

    private static void PivotComparisonRows(RecognizedTableView table)
    {
        if (table.Headers.Count == 0 || table.Rows.Count < 2) return;
        if (LooksAlreadyPivoted(table.Headers)) return;

        int conditionIndex = FindComparisonConditionIndex(table.Headers, table.Rows);
        if (conditionIndex < 0) return;

        List<int> sharedIndices = Enumerable.Range(0, table.Headers.Count)
            .Where(index => index != conditionIndex && IsSharedComparisonHeader(table.Headers[index]))
            .ToList();
        List<int> valueIndices = Enumerable.Range(0, table.Headers.Count)
            .Where(index => index != conditionIndex && !sharedIndices.Contains(index))
            .ToList();
        if (valueIndices.Count == 0) return;

        var groups = new List<ComparisonRowGroup>();
        var passthrough = new List<IReadOnlyList<string>>();
        ComparisonRowGroup current = new();

        foreach (IReadOnlyList<string> rawRow in table.Rows)
        {
            List<string> row = NormalizeTableRow(rawRow.ToList(), table.Headers.Count);
            string condition = conditionIndex < row.Count ? row[conditionIndex] : "";
            ComparisonRole role = DetermineComparisonRole(condition);
            if (role.Kind == ComparisonRoleKind.None)
            {
                passthrough.Add(row);
                continue;
            }

            if (!role.IsRatio && current.HasMain(role.Kind) && current.HasAnyOpposite(role.Kind))
            {
                groups.Add(current);
                current = new ComparisonRowGroup();
            }

            current.Set(role, row);
        }

        if (current.HasAny)
            groups.Add(current);

        if (groups.Count == 0 || !groups.Any(group => group.TestMain is not null && group.NormalMain is not null))
            return;

        var headers = new List<string>();
        headers.AddRange(sharedIndices.Select(index => table.Headers[index]));
        headers.Add("대조군");
        headers.Add("비교군");
        headers.AddRange(valueIndices.Select(index => $"대조군 {table.Headers[index]}"));
        headers.AddRange(valueIndices.Select(index => $"비교군 {table.Headers[index]}"));

        bool hasRatioRows = groups.Any(group => group.NormalRatio is not null || group.TestRatio is not null);
        if (hasRatioRows)
        {
            headers.AddRange(valueIndices.Select(index => $"대조군 비율 {table.Headers[index]}"));
            headers.AddRange(valueIndices.Select(index => $"비교군 비율 {table.Headers[index]}"));
        }

        var rows = new List<IReadOnlyList<string>>();
        foreach (ComparisonRowGroup group in groups.Where(group => group.TestMain is not null && group.NormalMain is not null))
        {
            List<string> normal = group.NormalMain!;
            List<string> test = group.TestMain!;
            var row = new List<string>();

            foreach (int index in sharedIndices)
                row.Add(MergeSharedCell(index < normal.Count ? normal[index] : "", index < test.Count ? test[index] : ""));

            row.Add(conditionIndex < normal.Count ? normal[conditionIndex] : "Normal");
            row.Add(conditionIndex < test.Count ? test[conditionIndex] : "Test");
            row.AddRange(valueIndices.Select(index => index < normal.Count ? normal[index] : ""));
            row.AddRange(valueIndices.Select(index => index < test.Count ? test[index] : ""));

            if (hasRatioRows)
            {
                List<string>? normalRatio = group.NormalRatio;
                List<string>? testRatio = group.TestRatio;
                row.AddRange(valueIndices.Select(index => normalRatio is not null && index < normalRatio.Count ? normalRatio[index] : ""));
                row.AddRange(valueIndices.Select(index => testRatio is not null && index < testRatio.Count ? testRatio[index] : ""));
            }

            rows.Add(row);
        }

        if (rows.Count == 0) return;

        table.Headers = headers;
        table.Rows = rows.Concat(passthrough).Take(80).ToList();
    }

    private static int FindComparisonConditionIndex(IReadOnlyList<string> headers, IReadOnlyList<IReadOnlyList<string>> rows)
    {
        foreach (string candidate in new[] { "Type", "Item", "Condition", "Result" })
        {
            int index = FindHeaderIndex(headers, candidate);
            if (index >= 0 && rows.Any(row => index < row.Count && DetermineComparisonRole(row[index]).Kind != ComparisonRoleKind.None))
                return index;
        }

        for (int index = 0; index < headers.Count; index++)
        {
            if (rows.Any(row => index < row.Count && DetermineComparisonRole(row[index]).Kind != ComparisonRoleKind.None))
                return index;
        }

        return -1;
    }

    private static bool IsSharedComparisonHeader(string header)
    {
        string text = CleanTableText(header).ToLowerInvariant();
        return text is "date" or "line" or "process" or "section" or "model" or "sheet"
               || text.Contains("검토", StringComparison.OrdinalIgnoreCase)
               || text.Contains("영역", StringComparison.OrdinalIgnoreCase);
    }

    private static bool LooksAlreadyPivoted(IReadOnlyList<string> headers)
    {
        bool hasNormal = headers.Any(header =>
            header.Contains("대조군", StringComparison.OrdinalIgnoreCase)
            || header.Contains("Normal ", StringComparison.OrdinalIgnoreCase)
            || header.StartsWith("Normal", StringComparison.OrdinalIgnoreCase));
        bool hasTest = headers.Any(header =>
            header.Contains("비교군", StringComparison.OrdinalIgnoreCase)
            || header.Contains("Test ", StringComparison.OrdinalIgnoreCase)
            || header.StartsWith("Test", StringComparison.OrdinalIgnoreCase));
        return hasNormal && hasTest && FindHeaderIndex(headers, "Type") < 0;
    }

    private static ComparisonRole DetermineComparisonRole(string value)
    {
        string text = CleanTableText(value);
        if (string.IsNullOrWhiteSpace(text)) return new ComparisonRole(ComparisonRoleKind.None, false);

        bool isRatio = text.Contains("비율", StringComparison.OrdinalIgnoreCase)
                       || text.Contains("rate", StringComparison.OrdinalIgnoreCase)
                       || text.Contains("%", StringComparison.OrdinalIgnoreCase);
        if (text.Contains("Normal", StringComparison.OrdinalIgnoreCase)
            || text.Contains("Control", StringComparison.OrdinalIgnoreCase)
            || text.Contains("Baseline", StringComparison.OrdinalIgnoreCase)
            || text.Contains("대조", StringComparison.OrdinalIgnoreCase)
            || text.Contains("기준", StringComparison.OrdinalIgnoreCase))
        {
            return new ComparisonRole(ComparisonRoleKind.Normal, isRatio);
        }

        if (text.Contains("Test", StringComparison.OrdinalIgnoreCase)
            || text.Contains("New ", StringComparison.OrdinalIgnoreCase)
            || text.StartsWith("New", StringComparison.OrdinalIgnoreCase)
            || text.Contains("Changed", StringComparison.OrdinalIgnoreCase)
            || text.Contains("비교", StringComparison.OrdinalIgnoreCase)
            || text.Contains("변경", StringComparison.OrdinalIgnoreCase))
        {
            return new ComparisonRole(ComparisonRoleKind.Test, isRatio);
        }

        return new ComparisonRole(ComparisonRoleKind.None, false);
    }

    private static string MergeSharedCell(string normalValue, string testValue)
    {
        string normal = CleanTableText(normalValue);
        string test = CleanTableText(testValue);
        if (string.IsNullOrWhiteSpace(normal)) return test;
        if (string.IsNullOrWhiteSpace(test)) return normal;
        return normal.Equals(test, StringComparison.OrdinalIgnoreCase) ? normal : $"{normal} / {test}";
    }

    private static bool LooksLikeContinuationRatioRow(IReadOnlyList<string> headers, IReadOnlyList<string> row)
    {
        if (HasIdentityValue(headers, row)) return false;

        int numericCount = 0;
        int ratioLikeCount = 0;
        for (int i = 0; i < Math.Min(headers.Count, row.Count); i++)
        {
            if (IsIdentityHeader(headers[i])) continue;
            if (!TryParseDouble(row[i], out double value)) continue;

            numericCount++;
            if (value >= 0 && value <= 1)
                ratioLikeCount++;
        }

        return numericCount > 0 && ratioLikeCount == numericCount;
    }

    private static bool HasIdentityValue(IReadOnlyList<string> headers, IReadOnlyList<string> row)
    {
        for (int i = 0; i < Math.Min(headers.Count, row.Count); i++)
        {
            if (!IsIdentityHeader(headers[i])) continue;
            if (!string.IsNullOrWhiteSpace(row[i]))
                return true;
        }

        return false;
    }

    private static bool IsIdentityHeader(string header)
    {
        string text = CleanTableText(header).ToLowerInvariant();
        return text is "no" or "date" or "line" or "type" or "item"
               || text.Contains("q'ty check", StringComparison.OrdinalIgnoreCase)
               || text == "input"
               || text == "ok"
               || text == "ng"
               || text == "total ng"
               || text == "ng rate"
               || text == "total ng rate";
    }

    private static int FindHeaderIndex(IReadOnlyList<string> headers, string name)
    {
        for (int i = 0; i < headers.Count; i++)
        {
            if (headers[i].Equals(name, StringComparison.OrdinalIgnoreCase))
                return i;
        }

        return -1;
    }

    private static string FormatPercent(double value)
        => (value * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";

    private static IReadOnlyList<InputDataComCellPreview> RecognizedColumns(IReadOnlyList<InputDataComRowPreview> rows)
    {
        List<InputDataComCellPreview> cells = rows.SelectMany(row => row.Cells).ToList();
        if (cells.Count == 0) return [];

        List<InputDataComCellPreview> nonEmpty = cells
            .Where(cell => !string.IsNullOrWhiteSpace(cell.CellValue))
            .ToList();
        if (nonEmpty.Count == 0) return [];

        int minCol = nonEmpty.Min(cell => cell.ColNumber);
        int maxCol = nonEmpty.Max(cell => cell.ColNumber);
        return cells
            .Where(cell => cell.ColNumber >= minCol && cell.ColNumber <= maxCol)
            .GroupBy(cell => cell.ColNumber)
            .Select(group => group.First())
            .OrderBy(cell => cell.ColNumber)
            .ToList();
    }

    private static string CellValueAt(InputDataComRowPreview row, int colNumber)
        => row.Cells.FirstOrDefault(cell => cell.ColNumber == colNumber)?.CellValue ?? "";

    private static bool LooksLikeGenerationFailure(ReviewCaseView view)
    {
        string joined = string.Join(" | ", new[] { view.Summary, view.EvidencePolicy }
            .Concat(view.Issues)
            .Concat(view.CorrectionPlan));
        return joined.Contains("generatedReviewCaseJsonPath", StringComparison.OrdinalIgnoreCase)
               || joined.Contains("유효한 JSON", StringComparison.OrdinalIgnoreCase)
               || joined.Contains("valid JSON", StringComparison.OrdinalIgnoreCase)
               || joined.Contains("JSON으로 파싱", StringComparison.OrdinalIgnoreCase);
    }

    private static bool TryGetProperty(JsonElement root, string name, out JsonElement value)
    {
        if (root.ValueKind == JsonValueKind.Object)
        {
            foreach (JsonProperty prop in root.EnumerateObject())
            {
                if (string.Equals(prop.Name, name, StringComparison.OrdinalIgnoreCase))
                {
                    value = prop.Value;
                    return true;
                }
            }
        }

        value = default;
        return false;
    }

    private static string JsonString(JsonElement root, string name)
    {
        if (!TryGetProperty(root, name, out JsonElement value)) return "";
        return value.ValueKind == JsonValueKind.String
            ? value.GetString() ?? ""
            : value.ValueKind is JsonValueKind.Null or JsonValueKind.Undefined
                ? ""
                : value.GetRawText();
    }

    private static List<string> JsonStringList(JsonElement root, string name)
    {
        var list = new List<string>();
        if (!TryGetProperty(root, name, out JsonElement value)) return list;

        if (value.ValueKind == JsonValueKind.Array)
        {
            foreach (JsonElement item in value.EnumerateArray())
                list.Add(JsonElementText(item));
        }
        else if (value.ValueKind != JsonValueKind.Null && value.ValueKind != JsonValueKind.Undefined)
        {
            list.Add(JsonElementText(value));
        }

        return list.Where(x => !string.IsNullOrWhiteSpace(x)).ToList();
    }

    private static string JsonElementText(JsonElement value)
        => value.ValueKind == JsonValueKind.String ? value.GetString() ?? "" : value.GetRawText();

    private static string PrettyJson(string json)
    {
        try
        {
            using JsonDocument doc = JsonDocument.Parse(json);
            return JsonSerializer.Serialize(doc.RootElement, new JsonSerializerOptions { WriteIndented = true });
        }
        catch
        {
            return json;
        }
    }

    private static string FirstNonBlank(params string[] values)
        => values.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x)) ?? "";

