@page "/data-inference/batch"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject WebRepository Repo
@inject ClaudeService  Claude
@inject AiProviderSettingsService AiProviders
@inject IJSRuntime     JS

<PageTitle>Data Inference — AI Batch</PageTitle>

<div class="dib-root">

<!-- ── Header ──────────────────────────────────────────────────────────────── -->
<div class="dib-header">
    <span class="dib-title">🤖 AI Batch Analysis</span>
    <span class="dib-count">@_unprocessed.Count pending · @_processed.Count done (out of @_reports.Count total)</span>
    <div style="flex:1;"></div>

    @* Per v4 policy: only excel_paste TSV is sent to AI. Vision / OCR→Text
       modes are gone. The mode enum stays in code so older logs that mention
       "Text-only" still resolve, but the UI is fixed to the text-only path. *@

    <button class="btn btn-outline-primary btn-sm" @onclick="ToggleProductTypeMapper" disabled="@_isBusy">
        Mapping (@MissingProductTypeReports.Count)
    </button>
    <button class="btn btn-outline-secondary btn-sm" @onclick="Refresh" disabled="@_isBusy">↻ Refresh</button>
    @* Current AI_EXCEL_PROC writes AiDocuments/AiResults via the CLI helper.
       The old API path wrote legacy DatasetSummary/NormalizedMeasurements, so
       it is blocked here to avoid mixing schemas. *@
    <button class="btn btn-primary btn-sm" @onclick="StartApiAsync"
            disabled="@(_isBusy || !Claude.IsConfigured || _selected.Count == 0)"
            title="Disabled for current schema: use Analyze (CLI).">
        @if (_isBusy) { <span class="spinner-border spinner-border-sm me-1"></span> }
        ▶ Analyze (API legacy) (@_selected.Count)
    </button>
    <button class="btn btn-success btn-sm" @onclick="StartCliAsync"
            disabled="@(_isBusy || !AiProviders.ClaudeCliEnabled || _selected.Count == 0)"
            title="Run via Claude Code CLI — uses your Claude subscription, no Anthropic API credit.">
        🖥 Analyze (Claude CLI) (@_selected.Count)
    </button>
    <button class="btn btn-dark btn-sm" @onclick="StartCodexCliAsync"
            disabled="@(_isBusy || !AiProviders.CodexCliEnabled || _selected.Count == 0)"
            title="Run via Codex CLI using the same AI prompt workflow.">
        Analyze (Codex CLI) (@_selected.Count)
    </button>
    <button class="btn btn-warning btn-sm" @onclick="StartSplitCliAsync"
            disabled="@(_isBusy || !AiProviders.ClaudeCliEnabled || !AiProviders.CodexCliEnabled || _selected.Count == 0)"
            title="Split selected datasets into separate Claude and Codex target lists.">
        Claude + Codex (@_selected.Count)
    </button>
</div>

@if (!string.IsNullOrEmpty(_status))
{
    <div class="dib-status @(_statusError ? "dib-error" : "dib-ok")">@_status</div>
}

@* Confirmation banner — surfaces only when "Analyze Selected" finds at least
   one dataset that already has results. User picks once for the whole batch. *@
@if (_confirmTargets is not null)
{
    <div class="dib-confirm">
        <div class="dib-confirm-title">
            ⚠ @_confirmExisting.Count of @_confirmTargets.Count selected dataset(s) already analyzed
        </div>
        <div class="dib-confirm-body">
            Some datasets in this batch already have measurements / summaries on file.
            What should the run do for them?
        </div>
        <div class="dib-confirm-list">
            @foreach (var n in _confirmExisting.Take(8))
            {
                <span class="dib-confirm-chip">@n</span>
            }
            @if (_confirmExisting.Count > 8)
            {
                <span class="dib-confirm-chip dib-confirm-more">+@(_confirmExisting.Count - 8) more</span>
            }
        </div>
        <div class="dib-confirm-actions">
            <button class="btn btn-primary btn-sm" @onclick="() => RunConfirmedAsync(BatchRunMode.Reanalyze)">
                ▶ Re-analyze (full)
            </button>
            <button class="btn btn-success btn-sm" @onclick="() => RunConfirmedAsync(BatchRunMode.TranslateOnly)">
                🌐 Translate only (ko + vi)
            </button>
            <button class="btn btn-outline-secondary btn-sm" @onclick="CancelConfirm">
                ✕ Cancel
            </button>
        </div>
    </div>
}

<!-- ── Filter tabs ─────────────────────────────────────────────────────────── -->
<div class="dib-tabs">
    <button class="dib-tab @(_filter == Filter.Pending ? "active" : "")"
            @onclick="() => SetFilter(Filter.Pending)">⏳ Pending (@_unprocessed.Count)</button>
    <button class="dib-tab @(_filter == Filter.Done ? "active" : "")"
            @onclick="() => SetFilter(Filter.Done)">✅ Done (@_processed.Count)</button>
    <button class="dib-tab @(_filter == Filter.Issues ? "active" : "")"
            @onclick="() => SetFilter(Filter.Issues)">⚠ Issues (@_issueDatasets.Count)</button>
    @* "No OCR" tab removed — v4 policy ignores OCR cache entirely. *@
    <button class="dib-tab @(_filter == Filter.All ? "active" : "")"
            @onclick="() => SetFilter(Filter.All)">All (@_reports.Count)</button>
    <div style="flex:1;"></div>
    <label class="dib-filter-check" title="Hide datasets that already have AI Batch results.">
        <input type="checkbox"
               checked="@_showNotDoneOnly"
               disabled="@_isBusy"
               @onchange="ToggleNotDoneOnly" />
        <span>Not done only (@_unprocessed.Count)</span>
    </label>
    <button class="btn btn-outline-secondary btn-sm" @onclick="ToggleAllVisible" disabled="@_isBusy">
        @(AllVisibleSelected ? $"☐ Unselect Visible ({Visible.Count})" : $"☑ Select Visible ({Visible.Count})")
    </button>
</div>

<!-- ── Table ───────────────────────────────────────────────────────────────── -->
<datalist id="dib-product-type-options">
    @foreach (var opt in _productTypeOptions)
    {
        <option value="@opt"></option>
    }
</datalist>

<div class="dib-content @(_showProductTypeMapper ? "with-map" : "")">
<div class="dib-main">
@if (Visible.Count == 0)
{
    <div class="dib-empty">
        @if (_filter == Filter.Pending) { <text>No datasets awaiting AI analysis.</text> }
        else if (_filter == Filter.Done) { <text>No analyzed datasets yet.</text> }
        else if (_filter == Filter.NoOcr) { <text>All datasets have cached OCR text.</text> }
        else { <text>No saved datasets — save one from Input Data first.</text> }
    </div>
}
else
{
    <div class="dib-table-wrap">
        <table class="dib-table">
            <thead>
                <tr>
                    <th style="width:28px;"></th>
                    <th>Dataset Name</th>
                    <th>Product Type</th>
                    <th>Date</th>
                    <th>Images</th>
                    <th>Measurements</th>
                    <th>Status</th>
                    <th style="width:140px;">Batched At</th>
                    <th style="width:120px;">Progress</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Visible)
                {
                    bool isDone = IsAiBatchDone(r);
                    string? state = _runState.GetValueOrDefault(r.DatasetName);
                    <tr>
                        <td>
                            <input type="checkbox" checked="@_selected.Contains(r.DatasetName)"
                                   disabled="@_isBusy"
                                   @onchange="e => ToggleSelect(r.DatasetName, (bool)e.Value!)" />
                        </td>
                        <td><strong>@r.DatasetName</strong></td>
                        <td>
                            @if (string.IsNullOrWhiteSpace(r.ProductType))
                            {
                                <button class="dib-map-inline" @onclick="() => OpenMappingFor(r.DatasetName)" disabled="@_isBusy">
                                    Map
                                </button>
                            }
                            else
                            {
                                @r.ProductType
                            }
                        </td>
                        <td>@r.ReportDate</td>
                        <td class="n">@r.ImageCount</td>
                        <td class="n">@r.MeasurementCount</td>
                        <td>
                            @if (isDone)
                            {
                                int issueCount = _issueCount.GetValueOrDefault(r.DatasetName);
                                <span class="dib-badge dib-badge-done">Done</span>
                                @if (issueCount > 0)
                                {
                                    <a class="dib-badge dib-badge-warn ms-1 text-decoration-none"
                                       href="/data-inference/validation" target="_blank"
                                       title="@issueCount checksum mismatch(es) — see Validation page">
                                        ⚠ @issueCount
                                    </a>
                                }
                            }
                            else
                            {
                                <span class="dib-badge dib-badge-pending">Pending</span>
                            }
                        </td>
                        <td class="dib-batched-at">
                            @if (isDone && !string.IsNullOrEmpty(r.BatchedAt))
                            {
                                <span title="@r.BatchedAt">@FormatBatchedAt(r.BatchedAt)</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            @if (state == "running")
                            {
                                <span class="dib-badge dib-badge-run"><span class="spinner-border spinner-border-sm me-1"></span>Analyzing</span>
                            }
                            else if (state == "ok")
                            {
                                <span class="dib-badge dib-badge-ok">✓</span>
                            }
                            else if (state == "err")
                            {
                                <button class="dib-badge dib-badge-err dib-badge-btn"
                                        title="@_runError.GetValueOrDefault(r.DatasetName)"
                                        @onclick="() => ShowError(r.DatasetName)">✗ Error</button>
                            }
                            else if (state == "stopped")
                            {
                                <button class="dib-badge dib-badge-stop dib-badge-btn"
                                        title="@_runError.GetValueOrDefault(r.DatasetName)"
                                        @onclick="() => ShowError(r.DatasetName)">Stopped</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

</div>

@if (_showProductTypeMapper)
{
    var missing = MissingProductTypeReports;
    var modelNames = ProductTypeMapRows;
    var matchedAll = string.IsNullOrWhiteSpace(_ptMapToken)
        ? new List<RawReportInfo>()
        : _reports.Where(r => DatasetHasToken(r.DatasetName, _ptMapToken)).ToList();
    var matchedBlank = matchedAll.Where(r => string.IsNullOrWhiteSpace(r.ProductType)).ToList();
    var selectedModel = modelNames.FirstOrDefault(c => SameModelToken(c.Token, _ptMapToken));

    <aside class="dib-map-panel">
        <div class="dib-map-head">
            <div>
                <div class="dib-map-title">Product Type Mapping</div>
                <div class="dib-map-count">@missing.Count blank / @_reports.Count total dataset(s)</div>
            </div>
            <button class="dib-map-close" @onclick="ToggleProductTypeMapper">x</button>
        </div>

        <label class="dib-map-label">Model Names From Title</label>
            @if (modelNames.Count == 0)
            {
                <div class="dib-map-empty">No model-like title code found.</div>
            }
            else
            {
                <div class="dib-map-candidates">
                    @foreach (var c in modelNames.Take(80))
                    {
                        <button class="dib-map-candidate @(SameModelToken(c.Token, _ptMapToken) ? "active" : "")"
                                @onclick="() => SelectPtMapToken(c.Token)">
                            <span>
                                @c.Token
                                @if (!string.IsNullOrWhiteSpace(c.MappedTo))
                                {
                                    <span class="dib-map-alias">→ @c.MappedTo</span>
                                }
                            </span>
                            <span class="dib-map-candidate-count">@c.BlankCount/@c.Count</span>
                        </button>
                    }
                </div>
            }

            @if (selectedModel is not null)
            {
                <div class="dib-map-recognition">
                    <div class="dib-map-recognition-head">
                        Recognized as <strong>@selectedModel.Token</strong>
                        <span>@matchedBlank.Count blank / @matchedAll.Count matched</span>
                    </div>
                    @foreach (var row in matchedAll.Take(12))
                    {
                        <div class="dib-map-recognition-row" title="@row.DatasetName">
                            <span>@row.DatasetName</span>
                            <em>@(string.IsNullOrWhiteSpace(row.ProductType) ? "(blank)" : row.ProductType)</em>
                        </div>
                    }
                    @if (matchedAll.Count > 12)
                    {
                        <div class="dib-map-recognition-more">+@(matchedAll.Count - 12) more</div>
                    }
                </div>
            }

            <label class="dib-map-label mt-2">Change To</label>
            <input class="form-control form-control-sm"
                   list="dib-product-type-options"
                   placeholder="Type Product Type or pick existing"
                   value="@_ptMapProductType"
                   @oninput="e => _ptMapProductType = e.Value?.ToString() ?? string.Empty" />

            @if (_productTypeOptions.Count > 0)
            {
                <div class="dib-map-options">
                    @foreach (var opt in _productTypeOptions.Take(28))
                    {
                        <button type="button" class="dib-map-option" @onclick="() => SetProductTypeDraft(opt)">@opt</button>
                    }
                </div>
            }

            <div class="dib-map-actions">
                <button class="btn btn-primary btn-sm"
                        @onclick="ApplyProductTypeMapping"
                        disabled="@(_isBusy || string.IsNullOrWhiteSpace(_ptMapToken) || string.IsNullOrWhiteSpace(_ptMapProductType))">
                    Save auto map + update @matchedAll.Count
                </button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="ClearProductTypeMappingDraft">Clear</button>
            </div>

            @if (!string.IsNullOrWhiteSpace(_ptMapMessage))
            {
                <div class="dib-map-message @(_ptMapMessageError ? "err" : "ok")">@_ptMapMessage</div>
            }
    </aside>
}
</div>

@if (_errorDialog is not null)
{
    <div class="dib-overlay" @onclick="CloseError">
        <div class="dib-error-dialog" @onclick:stopPropagation="true">
            <div class="dib-error-head">
                <span>❌ Analyze Error — @_errorDialog.Value.Name</span>
                <button class="dib-error-close" @onclick="CloseError">✕</button>
            </div>
            <pre class="dib-error-body">@_errorDialog.Value.Message</pre>
            <div class="dib-error-foot">
                <button class="btn btn-outline-secondary btn-sm" @onclick="() => CopyErrorAsync()">📋 Copy</button>
                <button class="btn btn-primary btn-sm" @onclick="CloseError">Close</button>
            </div>
        </div>
    </div>
}

</div>

<style>
    .dib-root {
        flex: 1; min-height: 0; display: flex; flex-direction: column;
        overflow: hidden; background: var(--panel-2, #f5f6f9);
    }
    .dib-header {
        display: flex; align-items: center; gap: 10px; padding: 10px 14px;
        background: var(--panel, #fff); border-bottom: 1px solid var(--line, var(--line, #dde1e7)); flex-shrink: 0;
    }
    .dib-title   { font-size: 15px; font-weight: 700; color: var(--ink, #0f1319); }
    .dib-count   { font-size: 12px; color: var(--ink-3, #7f8a98); }
    .dib-status  { padding: 5px 14px; font-size: 12px; flex-shrink: 0; }
    .dib-ok      { color: var(--ok, #1f5fa8); background: var(--ok-wash, #eaf1f9); border-bottom: 1px solid var(--ok-wash, #eaf1f9); }
    .dib-error   { color: var(--crit, #c8342a); background: var(--crit-wash, #fbedec); border-bottom: 1px solid var(--crit-wash, #fbedec); }

    .dib-tabs {
        display: flex; align-items: center; gap: 6px; padding: 8px 14px;
        background: var(--panel, #fff); border-bottom: 1px solid var(--line, var(--line, #dde1e7)); flex-shrink: 0;
    }
    .dib-tab {
        padding: 4px 12px; font-size: 12px; font-weight: 600;
        border: 1px solid var(--line, var(--line, #dde1e7)); border-radius: 2px;
        background: var(--panel-2, #f5f6f9); color: var(--ink-2, #4a5461); cursor: pointer; transition: all .12s;
    }
    .dib-tab:hover         { background: var(--panel-3, #eceef2); }
    .dib-tab.active        { background: var(--signal, #16202b); color: var(--panel, #fff); border-color: var(--signal, #16202b); }

    .dib-empty { padding: 60px; text-align: center; color: var(--ink-3, #7f8a98); font-size: 14px; }

    .dib-content { flex: 1; min-height: 0; display: flex; overflow: hidden; }
    .dib-main { flex: 1; min-width: 0; min-height: 0; display: flex; flex-direction: column; }
    .dib-table-wrap { flex: 1; overflow: auto; }
    .dib-table      { border-collapse: collapse; width: 100%; font-size: 13px; }
    .dib-table th, .dib-table td {
        border: 1px solid var(--line, #dde1e7); padding: 7px 10px; text-align: left;
    }
    .dib-table thead th {
        background: var(--panel-3, #eceef2); font-weight: 600; color: var(--ink-2, #4a5461);
        position: sticky; top: 0; z-index: 1;
    }
    /* scoped: a bare `td.n` in this shared document reached every screen's tables */
    .dib-root td.n { text-align: right; font-variant-numeric: tabular-nums; }

    .dib-map-inline {
        border: 1px solid #bfdbfe; background: #eff6ff; color: #1d4ed8;
        border-radius: 2px; padding: 2px 8px; font-size: 11px; font-weight: 700;
    }
    .dib-map-inline:hover { background: #dbeafe; }
    .dib-map-panel {
        width: 360px; flex: 0 0 360px; min-height: 0; overflow: auto;
        background: var(--panel, #fff); border-left: 1px solid var(--line, var(--line, #dde1e7)); padding: 12px;
    }
    .dib-map-head {
        display: flex; align-items: flex-start; justify-content: space-between;
        gap: 10px; padding-bottom: 10px; border-bottom: 1px solid var(--line, var(--line, #dde1e7));
    }
    .dib-map-title { font-size: 14px; font-weight: 800; color: var(--ink, #0f1319); }
    .dib-map-count { margin-top: 2px; font-size: 11px; color: var(--ink-2, #4a5461); }
    .dib-map-close {
        border: none; background: var(--panel-3, #eceef2); color: var(--ink-2, #4a5461); border-radius: 2px;
        width: 24px; height: 24px; line-height: 22px; font-weight: 800;
    }
    .dib-map-close:hover { background: var(--line, var(--line, #dde1e7)); color: var(--ink, #0f1319); }
    .dib-map-label {
        display: block; margin: 12px 0 6px; font-size: 11px; font-weight: 800;
        color: var(--ink-2, #4a5461); text-transform: uppercase;
    }
    .dib-map-candidates { display: flex; flex-direction: column; gap: 5px; }
    .dib-map-candidate {
        display: flex; align-items: center; justify-content: space-between; gap: 8px;
        width: 100%; border: 1px solid var(--line, var(--line, #dde1e7)); background: var(--panel-2, #f5f6f9); color: var(--ink-2, #4a5461);
        border-radius: 2px; padding: 6px 8px; font-size: 12px; font-weight: 700;
    }
    .dib-map-candidate:hover { background: var(--panel-3, #eceef2); }
    .dib-map-candidate.active { border-color: var(--signal, #16202b); background: var(--signal-wash, #edf0f4); color: #1e3a8a; }
    .dib-map-alias { display: block; margin-top: 1px; font-size: 10px; color: var(--ink-2, #4a5461); font-weight: 700; }
    .dib-map-candidate-count {
        min-width: 24px; text-align: center; border-radius: 2px; padding: 1px 6px;
        background: rgba(15, 23, 42, .08); font-size: 11px;
    }
    .dib-map-samples {
        margin-top: 8px; padding: 8px; background: var(--panel-2, #f5f6f9); border: 1px solid var(--line, var(--line, #dde1e7));
        border-radius: 2px; color: var(--ink-2, #4a5461); font-size: 11px;
    }
    .dib-map-samples div {
        overflow: hidden; white-space: nowrap; text-overflow: ellipsis; line-height: 1.6;
    }
    .dib-map-recognition {
        margin-top: 8px; padding: 8px; background: var(--panel-2, #f5f6f9); border: 1px solid var(--line, var(--line, #dde1e7));
        border-radius: 2px; font-size: 11px;
    }
    .dib-map-recognition-head {
        display: flex; align-items: center; justify-content: space-between; gap: 8px;
        color: var(--ink-2, #4a5461); margin-bottom: 6px;
    }
    .dib-map-recognition-head span { color: var(--ink-2, #4a5461); font-weight: 700; }
    .dib-map-recognition-row {
        display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px;
        align-items: center; line-height: 1.7;
    }
    .dib-map-recognition-row span { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: var(--ink-2, #4a5461); }
    .dib-map-recognition-row em { font-style: normal; color: var(--ink-2, #4a5461); font-weight: 700; }
    .dib-map-recognition-more { margin-top: 4px; color: var(--ink-2, #4a5461); font-weight: 700; }
    .dib-map-options { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 8px; }
    .dib-map-option {
        border: 1px solid var(--line, var(--line, #dde1e7)); background: var(--panel, #fff); color: var(--ink-2, #4a5461);
        border-radius: 2px; padding: 3px 7px; font-size: 11px; font-weight: 700;
    }
    .dib-map-option:hover { background: var(--panel-2, #f5f6f9); border-color: var(--line-2, #c6ccd5); }
    .dib-map-actions { display: flex; gap: 6px; margin-top: 12px; }
    .dib-map-message {
        margin-top: 10px; border-radius: 2px; padding: 7px 8px; font-size: 12px; font-weight: 700;
    }
    .dib-map-message.ok { background: var(--ok-wash, #eaf1f9); color: var(--ok, #1f5fa8); border: 1px solid var(--ok-wash, #eaf1f9); }
    .dib-map-message.err { background: var(--crit-wash, #fbedec); color: var(--crit, #c8342a); border: 1px solid var(--crit-wash, #fbedec); }
    .dib-map-empty {
        margin-top: 12px; padding: 24px 10px; text-align: center; color: var(--ink-3, #7f8a98);
        background: var(--panel-2, #f5f6f9); border: 1px solid var(--line, var(--line, #dde1e7)); border-radius: 2px; font-size: 13px;
    }

    .dib-badge {
        display: inline-flex; align-items: center; padding: 2px 9px;
        border-radius: 2px; font-size: 11px; font-weight: 600;
    }
    .dib-badge-done    { background: var(--ok-wash, #eaf1f9); color: var(--ok, #1f5fa8); }
    .dib-badge-pending { background: var(--warn-wash, #fdf4e0); color: var(--warn-ink, #92610a); }
    .dib-badge-skip    { background: var(--line, var(--line, #dde1e7)); color: var(--ink-2, #4a5461); }
    .dib-badge-run     { background: #dbeafe; color: #1d4ed8; }
    .dib-badge-ok      { background: var(--ok-wash, #eaf1f9); color: var(--ok, #1f5fa8); }
    .dib-badge-err     { background: var(--crit-wash, #fbedec); color: var(--crit, #c8342a); }
    .dib-badge-stop    { background: var(--panel-3, #eceef2); color: var(--ink-2, #4a5461); }
    .dib-badge-warn    { background: var(--warn-wash, #fdf4e0); color: var(--warn-ink, #92610a); cursor: pointer; }
    .dib-badge-warn:hover { background: var(--warn-line, #f0cf8a); }
    .dib-badge-btn     { border: none; cursor: pointer; text-decoration: underline dotted; }
    .dib-badge-btn:hover { background: var(--crit-wash, #fbedec); }
