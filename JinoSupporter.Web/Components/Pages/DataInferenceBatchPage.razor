    /// <summary>Open one Claude Code session in its own terminal window with
    /// the given prompt. The prompt is written to a UTF-8 file first so cmd/wt
    /// quoting never gets a chance to split long Korean/English instructions
    /// into bogus executable names.</summary>
    private static bool TryLaunchClaudeTerminal(string workDir, string prompt, string title, string targetsPath, string dbPath)
    {
        string launchId = Guid.NewGuid().ToString("N")[..12];
        string promptPath = Path.Combine(workDir, $"_batch_prompt_{launchId}.txt");
        string scriptPath = Path.Combine(workDir, $"_batch_launch_{launchId}.ps1");

        try
        {
            File.WriteAllText(promptPath, prompt, new System.Text.UTF8Encoding(encoderShouldEmitUTF8Identifier: false));
            File.WriteAllText(scriptPath, BuildClaudeLauncherScript(workDir, promptPath, scriptPath, title, targetsPath, dbPath),
                new System.Text.UTF8Encoding(encoderShouldEmitUTF8Identifier: false));
        }
        catch
        {
            return false;
        }

        // For both spawn paths: switch UseShellExecute=false so Process.Start
        // returns a real Process handle we can assign to the Job Object. With
        // UseShellExecute=true Windows hands the call to ShellExecuteEx and
        // returns a "wrapper" Process that has no Handle property — no way
        // to add it to a job, so closing the web wouldn't kill these
        // terminals. Tradeoff: we lose ShellExecute's PATH search for wt.exe
        // (mitigated by trying cmd.exe fallback).
        try
        {
            var wt = new System.Diagnostics.ProcessStartInfo
            {
                FileName        = "wt.exe",
                UseShellExecute = false,
                CreateNoWindow  = false,
            };
            wt.ArgumentList.Add("-d");
            wt.ArgumentList.Add(workDir);
            wt.ArgumentList.Add("powershell.exe");
            wt.ArgumentList.Add("-NoExit");
            wt.ArgumentList.Add("-NoProfile");
            wt.ArgumentList.Add("-ExecutionPolicy");
            wt.ArgumentList.Add("Bypass");
            wt.ArgumentList.Add("-File");
            wt.ArgumentList.Add(scriptPath);
            var proc = System.Diagnostics.Process.Start(wt);
            if (proc is not null) ChildProcessJob.Assign(proc);
            return true;
        }
        catch { /* wt.exe missing — fall through */ }

        try
        {
            var psi = new System.Diagnostics.ProcessStartInfo
            {
                FileName         = "cmd.exe",
                WorkingDirectory = workDir,
                UseShellExecute  = false,
                CreateNoWindow   = false,
            };
            psi.ArgumentList.Add("/k");
            psi.ArgumentList.Add("powershell.exe");
            psi.ArgumentList.Add("-NoExit");
            psi.ArgumentList.Add("-NoProfile");
            psi.ArgumentList.Add("-ExecutionPolicy");
            psi.ArgumentList.Add("Bypass");
            psi.ArgumentList.Add("-File");
            psi.ArgumentList.Add(scriptPath);
            var proc = System.Diagnostics.Process.Start(psi);
            if (proc is not null) ChildProcessJob.Assign(proc);
            return true;
        }
        catch { return false; }
    }

