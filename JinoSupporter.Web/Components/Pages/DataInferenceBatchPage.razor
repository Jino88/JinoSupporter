            "    $now = (Get-Date).ToUniversalTime().ToString('yyyy-MM-ddTHH:mm:ss')",
            "    $rec = [ordered]@{ name = [string]$Target; status = $Status; phase = $Phase; runner = $runnerName; prompt = $promptFileName; at = $now }",
            "    try { ($rec | ConvertTo-Json -Compress) | Add-Content -LiteralPath $env:AI_BATCH_PROGRESS_FILE -Encoding UTF8 } catch {}",
            "}",
            "Write-Host ('Unattended per-file Codex batch started for ' + $targets.Count + ' target(s). effort=high') -ForegroundColor Cyan",
            "$total = $targets.Count",
            "$index = 0",
            "foreach ($dataset in $targets) {",
            "    $index++",
            "    $safe = ([BitConverter]::ToString([System.Security.Cryptography.SHA1]::Create().ComputeHash([System.Text.Encoding]::UTF8.GetBytes($dataset))).Replace('-', '').Substring(0, 12).ToLowerInvariant())",
            "    $oneTarget = Join-Path (Get-Location) ('_batch_one_' + $safe + '.txt')",
            "    Set-Content -LiteralPath $oneTarget -Value $dataset -Encoding UTF8",
            "    $env:AI_BATCH_TARGETS_FILE = $oneTarget",
            "    $prompt = $promptTemplate.Replace('__AI_BATCH_TARGET_FILE__', (Split-Path -Leaf $oneTarget))",
            "    Write-BatchProgress $dataset 'started' ('dataset ' + $index + '/' + $total)",
            "    Write-Host ('[' + $index + '/' + $total + '] Codex analyzing: ' + $dataset) -ForegroundColor Cyan",
            $"    $prompt | & codex exec -c 'model_reasoning_effort=\"high\"' --cd {Q(workDir)} --dangerously-bypass-approvals-and-sandbox --skip-git-repo-check -",
            "    $exitCode = if ($null -eq $LASTEXITCODE) { 0 } else { $LASTEXITCODE }",
            "    if ($exitCode -ne 0) {",
            "        $reason = 'Codex exited with code ' + $exitCode",
            "        Write-BatchProgress $dataset 'failed' $reason",
            "        Add-Content -LiteralPath $env:AI_BATCH_FAILED_FILE -Value ($dataset + \"`t\" + $reason) -Encoding UTF8",
            "        Write-Host $reason -ForegroundColor Yellow",
            "    }",
            "    Remove-Item -LiteralPath $oneTarget -Force -ErrorAction SilentlyContinue",
            "}",
            "",
            "Remove-Item -LiteralPath $masterTargetsPath -Force -ErrorAction SilentlyContinue",
            "Remove-Item -LiteralPath $promptPath -Force -ErrorAction SilentlyContinue",
            "Remove-Item -LiteralPath $scriptPath -Force -ErrorAction SilentlyContinue",
        });
    }

    private static string FindRepoRoot()
        => AiPromptRegistry.FindRepositoryRoot();

    private void ShowError(string name)
    {
        string msg = _runError.GetValueOrDefault(name) ?? "(no error detail recorded)";
        _errorDialog = (name, msg);
    }

    private void CloseError() => _errorDialog = null;

    private async Task CopyErrorAsync()
    {
        if (_errorDialog is null) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _errorDialog.Value.Message);
        }
        catch { }
    }

    public async ValueTask DisposeAsync()
    {
        try { _cliProgressCts?.Cancel(); } catch { }
        _cliProgressCts?.Dispose();
        try { await JS.InvokeVoidAsync("diFullPage.leave"); } catch { }
    }

    private static string FormatBatchedAt(string iso)
    {
        if (string.IsNullOrEmpty(iso)) return "";
        if (DateTime.TryParse(iso, null, System.Globalization.DateTimeStyles.RoundtripKind, out DateTime dt))
            return dt.ToLocalTime().ToString("yyyy-MM-dd HH:mm");
        return iso;
    }
}
