@code {
    private enum Filter { Pending, Done, Issues, NoOcr, All }
    private enum AnalysisMode { Vision, OcrText }
    private sealed record ProductTypeMapRow(string Token, int Count, int BlankCount, string MappedTo, List<string> Samples);

    private AnalysisMode _mode = AnalysisMode.Vision;

    private List<RawReportInfo>        _reports        = [];
    private List<RawReportInfo>        _unprocessed    = [];
    private List<RawReportInfo>        _processed      = [];
    private List<RawReportInfo>        _issueDatasets  = [];
    private List<RawReportInfo>        _noOcrDatasets  = [];
    private HashSet<string>            _ocrCached      = new(StringComparer.Ordinal);
    private Dictionary<string, int>    _issueCount     = new(StringComparer.Ordinal);
    private HashSet<string>            _selected       = new(StringComparer.Ordinal);
    private System.Collections.Concurrent.ConcurrentDictionary<string, string> _runState = new();
    private System.Collections.Concurrent.ConcurrentDictionary<string, string> _runError = new();
    private (string Name, string Message)? _errorDialog;
    private System.Threading.CancellationTokenSource? _cliProgressCts;
    private Filter                     _filter         = Filter.Pending;
    private bool                       _isBusy;
    private string                     _status         = "";
    private bool                       _statusError;
    private List<string>               _productTypeOptions = [];
    private bool                       _showProductTypeMapper;
    private bool                       _showNotDoneOnly;
    private string                     _ptMapToken = "";
    private string                     _ptMapProductType = "";
    private string                     _ptMapMessage = "";
    private bool                       _ptMapMessageError;
    private Dictionary<string, string> _dataInputAliases = new(StringComparer.OrdinalIgnoreCase);

    private List<RawReportInfo> Visible
    {
        get
        {
            IEnumerable<RawReportInfo> query = _filter switch
            {
                Filter.Pending => _unprocessed,
                Filter.Done    => _processed,
                Filter.Issues  => _issueDatasets,
                Filter.NoOcr   => _noOcrDatasets,
                _              => _reports,
            };

            if (_showNotDoneOnly)
            {
                query = query.Where(r => !IsAiBatchDone(r));
            }

            return query.ToList();
        }
    }

    private bool AllVisibleSelected =>
        Visible.Count > 0 && Visible.All(r => _selected.Contains(r.DatasetName));

    private List<RawReportInfo> MissingProductTypeReports => _reports
        .Where(r => string.IsNullOrWhiteSpace(r.ProductType))
        .ToList();

    private List<ProductTypeMapRow> ProductTypeMapRows =>
        BuildProductTypeMapRows(_reports, _dataInputAliases);

    protected override void OnInitialized() => LoadReports();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await JS.InvokeVoidAsync("diFullPage.enter");
    }

    private void LoadReports()
    {
        _reports     = Repo.GetAllRawReports().Where(r => !r.BatchExcluded).ToList();
        _productTypeOptions = Repo.GetAllProductTypes();
        _dataInputAliases = Repo.GetDataInputAliases();
        _unprocessed = _reports.Where(r => !IsAiBatchDone(r)).ToList();
        _processed   = _reports.Where(IsAiBatchDone).ToList();

        _ocrCached     = Repo.GetDatasetsWithExtractedText();
        _noOcrDatasets = _reports
            .Where(r => r.ImageCount > 0 && !_ocrCached.Contains(r.DatasetName))
            .ToList();

        // Run checksum validator per done dataset
        _issueCount.Clear();
        foreach (var r in _processed)
        {
            var rows   = Repo.GetNormalizedMeasurements(r.DatasetName);
            var issues = MeasurementValidator.FindIssues(rows);
            if (issues.Count > 0) _issueCount[r.DatasetName] = issues.Count;
        }
        _issueDatasets = _processed.Where(r => _issueCount.ContainsKey(r.DatasetName)).ToList();
        ApplyBatchProgressFromFile();
    }

    private void Refresh()
    {
        LoadReports();
        _selected.RemoveWhere(n => !_reports.Any(r => r.DatasetName == n));
        if (_showNotDoneOnly)
        {
            _selected.RemoveWhere(n => _reports.Any(r => r.DatasetName == n && IsAiBatchDone(r)));
        }
    }

    private static bool IsAiBatchDone(RawReportInfo r)
        => r.MeasurementCount > 0 || !string.IsNullOrWhiteSpace(r.BatchedAt);

    private void SetFilter(Filter f) => _filter = f;

    private void ToggleNotDoneOnly(ChangeEventArgs e)
    {
        _showNotDoneOnly = e.Value is bool b && b;
        if (_showNotDoneOnly)
        {
            _selected.RemoveWhere(name =>
                _reports.Any(r => string.Equals(r.DatasetName, name, StringComparison.Ordinal)
                                  && IsAiBatchDone(r)));
            foreach (var r in Visible)
            {
                _selected.Add(r.DatasetName);
            }
        }
    }

    private void ToggleSelect(string name, bool sel)
    {
        if (sel) _selected.Add(name);
        else     _selected.Remove(name);
    }

    private void ToggleAllVisible()
    {
        if (AllVisibleSelected)
        {
            foreach (var r in Visible) _selected.Remove(r.DatasetName);
        }
        else
        {
            foreach (var r in Visible) _selected.Add(r.DatasetName);
        }
    }

    private void ToggleProductTypeMapper()
    {
        _showProductTypeMapper = !_showProductTypeMapper;
        if (_showProductTypeMapper && string.IsNullOrWhiteSpace(_ptMapToken))
        {
            ProductTypeMapRow? first = ProductTypeMapRows.FirstOrDefault();
            if (first is not null) SelectPtMapToken(first.Token);
        }
    }

    private void OpenMappingFor(string datasetName)
    {
        _showProductTypeMapper = true;
        string? token = ExtractDatasetTokens(datasetName).FirstOrDefault();
        if (!string.IsNullOrWhiteSpace(token)) SelectPtMapToken(token);
    }

    private void SelectPtMapToken(string token)
    {
        _ptMapToken = token;
        _ptMapMessage = "";
        _ptMapMessageError = false;
        if (TryGetAliasForModelToken(token, _dataInputAliases, out string mapped))
        {
            _ptMapProductType = mapped;
        }
        else
        {
            _ptMapProductType = "";
        }
    }

    private void ClearProductTypeMappingDraft()
    {
        _ptMapProductType = "";
        _ptMapMessage = "";
        _ptMapMessageError = false;
    }

    private void SetProductTypeDraft(string productType)
    {
        _ptMapProductType = productType;
        _ptMapMessage = "";
        _ptMapMessageError = false;
    }

    private void ApplyProductTypeMapping()
    {
        string token = _ptMapToken.Trim();
        string productType = _ptMapProductType.Trim();
        if (string.IsNullOrWhiteSpace(token) || string.IsNullOrWhiteSpace(productType))
        {
            SetProductTypeMapMessage("Select a token and Product Type first.", true);
            return;
        }

        List<RawReportInfo> targets = _reports
            .Where(r => DatasetHasToken(r.DatasetName, token))
            .ToList();

        Repo.SaveDataInputAlias(token, productType);
        int updated = 0;
        foreach (RawReportInfo r in targets)
            updated += Repo.UpdateRawReportProductType(r.DatasetName, productType);

        LoadReports();
        _selected.RemoveWhere(n => !_reports.Any(r => r.DatasetName == n));
        SetProductTypeMapMessage($"Auto map saved: {token} -> {productType}. Updated {updated} matched dataset(s).", false);
    }

    private void SetProductTypeMapMessage(string message, bool error)
    {
        _ptMapMessage = message;
        _ptMapMessageError = error;
    }

    private static bool DatasetHasToken(string datasetName, string token) =>
        ExtractDatasetTokens(datasetName).Any(t => SameModelToken(t, token));

    private static List<ProductTypeMapRow> BuildProductTypeMapRows(
        IEnumerable<RawReportInfo> reports,
        Dictionary<string, string> aliases)
    {
        return reports
            .SelectMany(r => ExtractDatasetTokens(r.DatasetName).Select(t => (Token: t, Report: r)))
            .GroupBy(x => AliasLookupKey(x.Token), StringComparer.OrdinalIgnoreCase)
            .Select(g =>
            {
                List<string> samples = g.Select(x => x.Report.DatasetName)
                    .Distinct(StringComparer.Ordinal)
                    .Take(5)
                    .ToList();
                int count = g.Select(x => x.Report.DatasetName).Distinct(StringComparer.Ordinal).Count();
                int blankCount = g
                    .Where(x => string.IsNullOrWhiteSpace(x.Report.ProductType))
                    .Select(x => x.Report.DatasetName)
                    .Distinct(StringComparer.Ordinal)
                    .Count();
                string token = g.Select(x => x.Token)
                    .OrderBy(t => t.Contains('-') ? 0 : 1)
                    .ThenBy(t => t.Length)
                    .First();
                TryGetAliasForModelToken(token, aliases, out string mappedTo);
                return new ProductTypeMapRow(token, count, blankCount, mappedTo, samples);
            })
            .OrderByDescending(c => c.BlankCount)
            .ThenByDescending(c => c.Count)
            .ThenBy(c => c.Token, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private static readonly System.Text.RegularExpressions.Regex ModelTokenRx =
        new(@"(?:^|[^A-Za-z0-9])([A-Za-z]{2,4}(?:\s*[-_]\s*)?[A-Za-z]?\d{3,}(?:S\d{2}[A-Za-z]{0,2})?)",
            System.Text.RegularExpressions.RegexOptions.Compiled | System.Text.RegularExpressions.RegexOptions.IgnoreCase);

    private static List<string> ExtractDatasetTokens(string datasetName)
    {
        var tokens = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        if (string.IsNullOrWhiteSpace(datasetName)) return [];

        foreach (System.Text.RegularExpressions.Match m in ModelTokenRx.Matches(datasetName))
        {
            AddToken(tokens, m.Groups[1].Value);
        }

        return tokens.OrderBy(t => t, StringComparer.OrdinalIgnoreCase).ToList();
    }

    private static void AddToken(HashSet<string> tokens, string raw)
    {
        string token = CanonicalizeDatasetToken(raw);
        if (token.Length >= 3) tokens.Add(token);
    }

    private static string CanonicalizeDatasetToken(string raw)
    {
        string value = (raw ?? "").Trim().Trim('-', '_').ToUpperInvariant();
        value = System.Text.RegularExpressions.Regex.Replace(value, @"\s+", "");
        value = value.Replace('_', '-');
        value = System.Text.RegularExpressions.Regex.Replace(value, @"-+", "-");
        return value;
    }

    private static bool SameModelToken(string left, string right) =>
        string.Equals(AliasLookupKey(left), AliasLookupKey(right), StringComparison.OrdinalIgnoreCase);

    private static string AliasLookupKey(string token)
    {
        if (string.IsNullOrWhiteSpace(token)) return "";
        return new string(token
            .Where(char.IsLetterOrDigit)
            .Select(char.ToUpperInvariant)
            .ToArray());
    }

    private static bool TryGetAliasForModelToken(
        string token,
        Dictionary<string, string> aliases,
        out string material)
    {
        material = "";
        if (aliases.TryGetValue(token, out string? exact) && !string.IsNullOrWhiteSpace(exact))
        {
            material = exact;
            return true;
        }

        string key = AliasLookupKey(token);
        foreach (var kv in aliases)
        {
            if (!string.IsNullOrWhiteSpace(kv.Value) && AliasLookupKey(kv.Key) == key)
            {
                material = kv.Value;
                return true;
            }
        }
        return false;
    }

    /// <summary>What a batch run does to each selected dataset. <see cref="Reanalyze"/>
    /// is the legacy / default behaviour: re-extract measurements + re-translate.
    /// <see cref="TranslateOnly"/> skips Normalize and only refreshes the ko/vi
    /// translations of an already-saved summary — useful when the user wants to
    /// retry a botched translation without burning a Normalize call.</summary>
    private enum BatchRunMode  { Reanalyze, TranslateOnly }
    private enum BatchExecutor { Api, ClaudeCli, CodexCli, SplitCli }

    private List<RawReportInfo>? _confirmTargets;
    private List<string>         _confirmExisting = [];
    private BatchExecutor        _pendingExecutor = BatchExecutor.Api;

    private Task StartApiAsync()
    {
        SetStatus("Analyze (API) is legacy and is disabled for the current AiDocuments schema. Use Analyze (CLI).", true);
        return Task.CompletedTask;
    }
    private Task StartCliAsync() => StartAsync(BatchExecutor.ClaudeCli);
    private Task StartCodexCliAsync() => StartAsync(BatchExecutor.CodexCli);
    private Task StartSplitCliAsync() => StartAsync(BatchExecutor.SplitCli);

    private async Task StartAsync(BatchExecutor executor)
    {
        if (_selected.Count == 0) { SetStatus("No datasets selected.", true); return; }
        if (executor == BatchExecutor.ClaudeCli && !AiProviders.ClaudeCliEnabled)
        {
            SetStatus(AiProviders.ProviderDisabledMessage("Claude CLI"), true);
            return;
        }
        if (executor == BatchExecutor.CodexCli && !AiProviders.CodexCliEnabled)
        {
            SetStatus(AiProviders.ProviderDisabledMessage("Codex CLI"), true);
            return;
        }
        if (executor == BatchExecutor.SplitCli && (!AiProviders.ClaudeCliEnabled || !AiProviders.CodexCliEnabled))
        {
            SetStatus("Claude + Codex split requires both Claude CLI and Codex CLI to be enabled in ai-provider-settings.json.", true);
            return;
        }
        _pendingExecutor = executor;

        var targets = _reports.Where(r => _selected.Contains(r.DatasetName)).ToList();
        if (_showNotDoneOnly)
        {
            targets = targets.Where(r => !IsAiBatchDone(r)).ToList();
        }
        // "Existing" = anything already saved that would be overwritten by a
        // Reanalyze: measurements OR a summary record. Re-running on these is
        // wasteful if the user only wants the translation refreshed — same
        // confirmation flow regardless of executor.
        var existing = targets.Where(r =>
            IsAiBatchDone(r) ||
            Repo.GetDatasetSummaryRecord(r.DatasetName) is not null
        ).Select(r => r.DatasetName).ToList();

        if (existing.Count > 0)
        {
            _confirmTargets  = targets;
            _confirmExisting = existing;
            return;
        }
        await DispatchAsync(targets, BatchRunMode.Reanalyze);
    }

    private void CancelConfirm()
    {
        _confirmTargets  = null;
        _confirmExisting = [];
        SetStatus("Cancelled.", false);
    }

    private async Task RunConfirmedAsync(BatchRunMode mode)
    {
        var targets = _confirmTargets ?? [];
        _confirmTargets = null; _confirmExisting = [];
        await DispatchAsync(targets, mode);
    }

    private Task DispatchAsync(List<RawReportInfo> targets, BatchRunMode mode)
    {
        if (_pendingExecutor == BatchExecutor.ClaudeCli ||
            _pendingExecutor == BatchExecutor.CodexCli)
        {
            LaunchCliWithMode(targets, mode, _pendingExecutor);
            return Task.CompletedTask;
        }
        if (_pendingExecutor == BatchExecutor.SplitCli)
        {
            LaunchSplitCliWithMode(targets, mode);
            return Task.CompletedTask;
        }
        return RunBatchCoreAsync(targets, mode);
    }

    private async Task RunBatchCoreAsync(List<RawReportInfo> targets, BatchRunMode mode)
    {
        if (targets.Count == 0) { SetStatus("No datasets selected.", true); return; }
        _isBusy = true;
        string modeLabel = mode == BatchRunMode.TranslateOnly ? "Translate-only" :
                           (_mode == AnalysisMode.OcrText ? "OCR→Text" : "Text-only");
        SetStatus($"Starting batch [{modeLabel}] — {targets.Count} dataset(s)", false);
        _runState.Clear(); _runError.Clear();

        int ok = 0, err = 0, done = 0;

        // Bounded parallelism — Anthropic tier-1 paid limits are ~50 RPM, plenty
        // of room for 3 concurrent datasets (each does 1 normalize + 2 translate
        // = 3 in-flight requests per slot, peak ~9 RPS). 5+ would risk 429s on
        // long bursts; 1 (sequential) was the previous bottleneck.
        const int Parallelism = 3;
        using var sem = new SemaphoreSlim(Parallelism, Parallelism);

        var tasks = targets.Select(async r =>
        {
            await sem.WaitAsync();
            try
            {
                _runState[r.DatasetName] = "running";
                await InvokeAsync(StateHasChanged);

                try
                {
                    bool handled = await ProcessDatasetAsync(r, mode);
                    if (handled)
                    {
                        _runState[r.DatasetName] = "ok";
                        Interlocked.Increment(ref ok);
                    }
                    else
                    {
                        // ProcessDatasetAsync set _runError + state already.
                        Interlocked.Increment(ref err);
                    }
                }
                catch (Exception ex)
                {
                    _runState[r.DatasetName] = "err";
                    _runError[r.DatasetName] = $"{ex.GetType().Name}: {ex.Message}\n\n{ex.StackTrace}";
                    Interlocked.Increment(ref err);
                }
            }
            finally
            {
                int d = Interlocked.Increment(ref done);
                SetStatus($"[{modeLabel}] {d}/{targets.Count} done — {ok} ok / {err} err", err > 0);
                await InvokeAsync(StateHasChanged);
                sem.Release();
            }
        }).ToList();

        await Task.WhenAll(tasks);

        _isBusy = false;
        LoadReports();
        _selected.Clear();
        SetStatus($"Done — {ok} success / {err} failed", err > 0);
    }

    /// <summary>One dataset's worth of work. Returns <c>true</c> on success
    /// (caller increments ok counter); <c>false</c> if a recoverable skip
    /// happened (this method already wrote _runState/_runError). Re-throws on
    /// unexpected exceptions so the caller can capture the stack.</summary>
    private async Task<bool> ProcessDatasetAsync(RawReportInfo r, BatchRunMode mode)
    {
        // Translate-only: skip Normalize entirely, refresh ko/vi from saved summary.
        if (mode == BatchRunMode.TranslateOnly)
        {
            var saved = Repo.GetDatasetSummaryRecord(r.DatasetName);
            if (saved is null)
            {
                _runState[r.DatasetName] = "err";
                _runError[r.DatasetName] = "Translate-only: no saved summary to translate.";
                return false;
            }
            var srcResult = new NormalizeResult
            {
                Summary           = saved.Summary,
                KeyFindings       = saved.KeyFindings,
                Purpose           = saved.Purpose,
                TestConditions    = saved.TestConditions,
                RootCause         = saved.RootCause,
                Decision          = saved.Decision,
                RecommendedAction = saved.RecommendedAction,
            };
            DatasetSummaryTranslation? koTr2 = null, viTr2 = null;
            try
            {
                var koTask = Claude.TranslateAnalysisAsync(srcResult, "Korean");
                var viTask = Claude.TranslateAnalysisAsync(srcResult, "Vietnamese");
                await Task.WhenAll(koTask, viTask);
                koTr2 = koTask.Result; viTr2 = viTask.Result;
            }
            catch (Exception tex)
            {
                _runState[r.DatasetName] = "err";
                _runError[r.DatasetName] = $"Translate failed: {tex.Message}";
                return false;
            }
            await Task.Run(() =>
            {
                if (koTr2 is not null) Repo.SaveDatasetSummaryTranslation(r.DatasetName, "ko", koTr2);
                if (viTr2 is not null) Repo.SaveDatasetSummaryTranslation(r.DatasetName, "vi", viTr2);
            });
            return true;
        }

        // Reanalyze: NormalizeFromText + ko/vi translate. Excel paste is the only input.
        string? excelPaste = Repo.GetExtractedText(r.DatasetName, WebRepository.TextKindExcelPaste);
        if (string.IsNullOrWhiteSpace(excelPaste))
        {
            _runState[r.DatasetName] = "err";
            _runError[r.DatasetName] = "No Excel raw text — re-input via Data Input (DRM Excel)";
            return false;
        }
        NormalizeResult result = await Claude.NormalizeFromTextAsync(
            excelPaste, r.DatasetName, r.ProductType, r.ReportDate);

        DatasetSummaryTranslation? koTr = null, viTr = null;
        try
        {
            var koTask = Claude.TranslateAnalysisAsync(result, "Korean");
            var viTask = Claude.TranslateAnalysisAsync(result, "Vietnamese");
            await Task.WhenAll(koTask, viTask);
            koTr = koTask.Result; viTr = viTask.Result;
        }
        catch { /* non-fatal */ }

        await Task.Run(() =>
        {
            if (result.Measurements.Count > 0)
                Repo.SaveNormalizedMeasurements(r.DatasetName, result.Measurements);
            bool hasAnySummary =
                !string.IsNullOrEmpty(result.Summary) || !string.IsNullOrEmpty(result.Headline) ||
                (result.Tags?.Count ?? 0) > 0;
            if (hasAnySummary)
                Repo.SaveDatasetSummaryRecord(r.DatasetName, r.ProductType, result);
            if (koTr is not null) Repo.SaveDatasetSummaryTranslation(r.DatasetName, "ko", koTr);
            if (viTr is not null) Repo.SaveDatasetSummaryTranslation(r.DatasetName, "vi", viTr);
        });
        return true;
    }

    private void SetStatus(string msg, bool err)
    {
        _status = msg; _statusError = err;
    }

    /// <summary>How many parallel Claude Code sessions to fan out for CLI mode.
    /// Each session is one terminal window with its own _batch_selected_N.txt
    /// chunk. Uses Claude Code subscription only — no Anthropic API credit.
    /// SQLite WAL mode tolerates concurrent commits since each session writes
    /// to a different DatasetName.</summary>
    private const int ClaudeCliParallelSessions = 1;
    private const int CodexCliParallelSessions = 3;

    private void LaunchCliWithMode(List<RawReportInfo> targets, BatchRunMode mode, BatchExecutor executor)
    {
        if (targets.Count == 0)
        {
            SetStatus("Select at least one dataset first.", true);
            return;
        }
        string workDir = FindRepoRoot();
        bool useCodex = executor == BatchExecutor.CodexCli;
        string providerName = useCodex ? "Codex" : "Claude";
        if (!useCodex && !AiProviders.ClaudeCliEnabled)
        {
            SetStatus(AiProviders.ProviderDisabledMessage("Claude CLI"), true);
            return;
        }
        if (useCodex && !AiProviders.CodexCliEnabled)
        {
            SetStatus(AiProviders.ProviderDisabledMessage("Codex CLI"), true);
            return;
        }

        // Split selected datasets into provider-specific chunks. Each
        // launch uses a **fresh unique prefix** so that concurrent / back-to-
        // back launches don't trample each other's target files. The agent's
        // prompt names its specific file, and the agent deletes only that
        // file when done — no shared state.
        int parallelSessions = useCodex ? CodexCliParallelSessions : ClaudeCliParallelSessions;
        int n = Math.Min(parallelSessions, targets.Count);
        int chunkSize = (int)Math.Ceiling(targets.Count / (double)n);

        // Stable prefix per launch — timestamp keeps lexicographic order, the
        // GUID tail rules out collisions when two launches happen in the same
        // second. NO stale cleanup: previously-running sessions own their own
        // files and clean them up themselves per the runbook.
        string runId = $"{DateTime.Now:yyyyMMdd_HHmmss}_{Guid.NewGuid():N}".Substring(0, 23);

        var chunkFiles = new List<string>();
        var sortedTargets = targets
            .Select(t => t.DatasetName)
            .OrderBy(s => s, StringComparer.Ordinal)
            .ToList();
        foreach (string name in sortedTargets)
        {
            _runState[name] = "running";
            _runError.TryRemove(name, out _);
        }

        for (int i = 0; i < n; i++)
        {
            var chunk = sortedTargets.Skip(i * chunkSize).Take(chunkSize).ToList();
            if (chunk.Count == 0) break;
            string path = Path.Combine(workDir, $"_batch_selected_{runId}_{i + 1}.txt");
            try
            {
                File.WriteAllLines(path, chunk, System.Text.Encoding.UTF8);
                chunkFiles.Add(path);
            }
            catch (Exception ex)
            {
                SetStatus($"Failed to write {path}: {ex.Message}", true);
                return;
            }
        }

        string modeHint = mode == BatchRunMode.TranslateOnly
            ? "Translate-only"
            : "Reanalyze";

        // Inline the production DB path so the agent skips workhost-settings
        // discovery (a big preprocessing time sink — settings.json points
        // at a stale path per project memory). Runbook v5 trusts this hint.
        const string DbPathHint = @"D:\000. MyWorks\002. DB\process-review.db";

        int launched = 0;
        for (int i = 0; i < chunkFiles.Count; i++)
        {
            string fileName = Path.GetFileName(chunkFiles[i]);
            int chunkCount = File.ReadAllLines(chunkFiles[i]).Length;
            string prompt = BuildAiBatchCliPrompt("__AI_BATCH_TARGET_FILE__", 1, modeHint, DbPathHint);
            string title = chunkFiles.Count == 1
                ? $"AI Batch ({providerName})"
                : $"AI Batch ({providerName}) {i + 1}/{chunkFiles.Count}";
            bool launchedThis = useCodex
                ? TryLaunchCodexTerminal(workDir, prompt, title, chunkFiles[i], DbPathHint)
                : TryLaunchClaudeTerminal(workDir, prompt, title, chunkFiles[i], DbPathHint);
            if (launchedThis) launched++;
        }

        if (launched == 0)
        {
            SetStatus($"Failed to launch any {providerName} CLI terminal — neither wt.exe nor cmd.exe started.", true);
            return;
        }
        SetStatus(
            $"Launched {launched} {providerName} CLI session(s) for {targets.Count} dataset(s). " +
            $"Each terminal window will process its target list sequentially; this page will heartbeat while it runs.",
            false);
        StartCliProgressPolling(sortedTargets, providerName);
    }

    private void LaunchSplitCliWithMode(List<RawReportInfo> targets, BatchRunMode mode)
    {
        if (targets.Count == 0)
        {
            SetStatus("Select at least one dataset first.", true);
            return;
        }
        if (!AiProviders.ClaudeCliEnabled || !AiProviders.CodexCliEnabled)
        {
            SetStatus("Claude + Codex split requires both Claude CLI and Codex CLI to be enabled in ai-provider-settings.json.", true);
            return;
        }

        string workDir = FindRepoRoot();
        string runId = $"{DateTime.Now:yyyyMMdd_HHmmss}_{Guid.NewGuid():N}".Substring(0, 23);
        string modeHint = mode == BatchRunMode.TranslateOnly ? "Translate-only" : "Reanalyze";
        const string DbPathHint = @"D:\000. MyWorks\002. DB\process-review.db";

        var sortedTargets = targets
            .Select(t => t.DatasetName)
            .OrderBy(s => s, StringComparer.Ordinal)
            .ToList();

        int claudeCount = (int)Math.Ceiling(sortedTargets.Count / 2.0);
        var claudeTargets = sortedTargets.Take(claudeCount).ToList();
        var codexTargets = sortedTargets.Skip(claudeCount).ToList();
        var launchErrors = new List<string>();

        int LaunchProvider(BatchExecutor executor, List<string> names)
        {
            if (names.Count == 0) return 0;

            bool useCodex = executor == BatchExecutor.CodexCli;
            string providerName = useCodex ? "Codex" : "Claude";
            string suffix = providerName.ToLowerInvariant();
            int parallelSessions = useCodex ? CodexCliParallelSessions : ClaudeCliParallelSessions;
            int sessionCount = Math.Min(parallelSessions, names.Count);
            int chunkSize = (int)Math.Ceiling(names.Count / (double)sessionCount);
            int launchedCount = 0;

            for (int i = 0; i < sessionCount; i++)
            {
                var chunk = names.Skip(i * chunkSize).Take(chunkSize).ToList();
                if (chunk.Count == 0) break;

                string chunkSuffix = sessionCount == 1 ? suffix : $"{suffix}_{i + 1}";
                string path = Path.Combine(workDir, $"_batch_selected_{runId}_{chunkSuffix}.txt");

                try
                {
                    File.WriteAllLines(path, chunk, System.Text.Encoding.UTF8);
                }
                catch (Exception ex)
                {
                    launchErrors.Add($"{providerName} {i + 1}/{sessionCount}: failed to write targets ({ex.Message})");
                    foreach (string name in chunk)
                    {
                        _runState[name] = "err";
                        _runError[name] = $"{providerName} target file write failed: {ex.Message}";
                    }
                    continue;
                }

                string prompt = BuildAiBatchCliPrompt("__AI_BATCH_TARGET_FILE__", 1, modeHint, DbPathHint);
                string title = sessionCount == 1
                    ? $"AI Batch ({providerName}) split"
                    : $"AI Batch ({providerName}) split {i + 1}/{sessionCount}";
                bool launched = useCodex
                    ? TryLaunchCodexTerminal(workDir, prompt, title, path, DbPathHint)
                    : TryLaunchClaudeTerminal(workDir, prompt, title, path, DbPathHint);

                if (!launched)
                {
                    launchErrors.Add($"{providerName} {i + 1}/{sessionCount}: terminal launch failed");
                    foreach (string name in chunk)
                    {
                        _runState[name] = "err";
                        _runError[name] = $"{providerName} CLI terminal launch failed.";
                    }
                    continue;
                }

                launchedCount++;
                foreach (string name in chunk)
                {
                    _runState[name] = "running";
                    _runError.TryRemove(name, out _);
                }
            }

            return launchedCount;
        }

        int claudeLaunched = LaunchProvider(BatchExecutor.ClaudeCli, claudeTargets);
        int codexLaunched = LaunchProvider(BatchExecutor.CodexCli, codexTargets);
        int launched = claudeLaunched + codexLaunched;

        if (launched == 0)
        {
            SetStatus("Failed to launch Claude + Codex CLI terminals. " + string.Join(" / ", launchErrors), true);
            return;
        }

        string status = $"Launched split CLI: Claude {claudeTargets.Count} dataset(s) in {claudeLaunched} session(s), Codex {codexTargets.Count} dataset(s) in {codexLaunched} session(s).";
        if (launchErrors.Count > 0) status += " Launch warning: " + string.Join(" / ", launchErrors);
        SetStatus(status, false);
        StartCliProgressPolling(sortedTargets, "Claude + Codex");
    }

    private void StartCliProgressPolling(IReadOnlyCollection<string> targetNames, string providerName)
    {
        _cliProgressCts?.Cancel();
        _cliProgressCts?.Dispose();
        _cliProgressCts = new System.Threading.CancellationTokenSource();

        var targets = targetNames.Where(n => !string.IsNullOrWhiteSpace(n)).Distinct(StringComparer.Ordinal).ToList();
        if (targets.Count == 0) return;

        DateTime startedUtc = DateTime.UtcNow;
        var token = _cliProgressCts.Token;

        _ = Task.Run(async () =>
        {
            while (!token.IsCancellationRequested)
            {
                try
                {
                    await Task.Delay(TimeSpan.FromSeconds(5), token);
                }
                catch (OperationCanceledException)
                {
                    break;
                }

                try
                {
                    await InvokeAsync(() =>
                    {
                        LoadReports();
                        int finished = targets.Count(IsCliTargetFinished);
                        TimeSpan elapsed = DateTime.UtcNow - startedUtc;
                        SetStatus(
                            $"{providerName} CLI running — {finished}/{targets.Count} finished, elapsed {FormatElapsed(elapsed)}, heartbeat {DateTime.Now:HH:mm:ss}.",
                            false);
                        StateHasChanged();

                        if (finished >= targets.Count)
                        {
                            SetStatus($"{providerName} CLI finished — {finished}/{targets.Count} done. Refresh if the list has not moved yet.", false);
                            _cliProgressCts?.Cancel();
                        }
                    });
                }
                catch
                {
                    // Keep polling best-effort; the terminal process owns the real work.
                }
            }
        }, CancellationToken.None);
    }

    private bool IsCliTargetFinished(string datasetName)
    {
        if (_processed.Any(r => string.Equals(r.DatasetName, datasetName, StringComparison.Ordinal))) return true;
        string? state = _runState.GetValueOrDefault(datasetName);
        return state == "ok" || state == "err" || state == "stopped";
    }

    private void ApplyBatchProgressFromFile()
    {
        string path;
        try { path = Path.Combine(FindRepoRoot(), "_ai_batch_progress.jsonl"); }
        catch { return; }
        if (!File.Exists(path)) return;

        var latest = new Dictionary<string, (string Status, string Detail, DateTime? At)>(StringComparer.Ordinal);
        try
        {
            foreach (string line in File.ReadLines(path))
            {
                if (string.IsNullOrWhiteSpace(line)) continue;
                try
                {
                    using var doc = System.Text.Json.JsonDocument.Parse(line);
                    var root = doc.RootElement;
                    if (!root.TryGetProperty("name", out var nameEl) ||
                        !root.TryGetProperty("status", out var statusEl)) continue;

                    string name = nameEl.GetString() ?? "";
                    string status = statusEl.GetString() ?? "";
                    if (string.IsNullOrWhiteSpace(name) || string.IsNullOrWhiteSpace(status)) continue;

                    string detail = "";
                    if (root.TryGetProperty("reason", out var reasonEl)) detail = reasonEl.GetString() ?? "";
                    else if (root.TryGetProperty("error", out var errorEl)) detail = errorEl.GetString() ?? "";
                    else if (root.TryGetProperty("phase", out var phaseEl)) detail = phaseEl.GetString() ?? "";

                    DateTime? at = null;
                    if (root.TryGetProperty("at", out var atEl) &&
                        DateTime.TryParse(atEl.GetString(), null, System.Globalization.DateTimeStyles.AssumeUniversal, out DateTime parsed))
                    {
                        at = parsed.ToUniversalTime();
                    }

                    if (!latest.TryGetValue(name, out var old) ||
                        (at ?? DateTime.MinValue) >= (old.At ?? DateTime.MinValue))
                    {
                        latest[name] = (status, detail, at);
                    }
                }
                catch { }
            }
        }
        catch { return; }

        DateTime cutoff = DateTime.UtcNow.AddHours(-6);
        foreach (var kv in latest)
        {
            string normalized = kv.Value.Status.Trim().ToLowerInvariant();
            if (normalized == "ok")
            {
                _runState[kv.Key] = "ok";
                _runError.TryRemove(kv.Key, out _);
            }
            else if (normalized is "failed" or "error" or "err")
            {
                _runState[kv.Key] = "err";
                _runError[kv.Key] = string.IsNullOrWhiteSpace(kv.Value.Detail) ? normalized : kv.Value.Detail;
            }
            else if (normalized is "stopped" or "stop" or "aborted" or "abort")
            {
                _runState[kv.Key] = "stopped";
                _runError[kv.Key] = string.IsNullOrWhiteSpace(kv.Value.Detail) ? normalized : kv.Value.Detail;
            }
            else if (normalized is "started" or "running")
            {
                if (kv.Value.At is null || kv.Value.At.Value >= cutoff)
                    _runState[kv.Key] = "running";
            }
        }
    }

    private static string FormatElapsed(TimeSpan elapsed)
    {
        if (elapsed.TotalHours >= 1)
            return $"{(int)elapsed.TotalHours:D2}:{elapsed.Minutes:D2}:{elapsed.Seconds:D2}";
        return $"{elapsed.Minutes:D2}:{elapsed.Seconds:D2}";
    }

    private static string BuildAiBatchCliPrompt(string fileName, int targetCount, string modeHint, string dbPath)
        => AiPromptRegistry.Render(
            "data-inference/ai-batch-cli.md",
            ("fileName", fileName),
            ("targetCount", targetCount.ToString(System.Globalization.CultureInfo.InvariantCulture)),
