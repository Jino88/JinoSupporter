    private static string BuildClaudeLauncherScript(string workDir, string promptPath, string scriptPath, string title, string targetsPath, string dbPath)
    {
        static string Q(string value) => "'" + (value ?? "").Replace("'", "''") + "'";
        string progressPath = Path.Combine(workDir, "_ai_batch_progress.jsonl");
        string failedPath = Path.Combine(workDir, "_ai_batch_failed.txt");

        return string.Join(Environment.NewLine, new[]
        {
            "$ErrorActionPreference = 'Continue'",
            "$utf8NoBom = New-Object System.Text.UTF8Encoding -ArgumentList $false",
            "[Console]::InputEncoding = $utf8NoBom",
            "[Console]::OutputEncoding = $utf8NoBom",
            "$OutputEncoding = $utf8NoBom",
            "try { chcp 65001 | Out-Null } catch {}",
            $"try {{ $Host.UI.RawUI.WindowTitle = {Q(title)} }} catch {{}}",
            $"Set-Location -LiteralPath {Q(workDir)}",
            $"$env:AI_BATCH_DB_PATH = {Q(dbPath)}",
            $"$env:AI_BATCH_PROGRESS_FILE = {Q(progressPath)}",
            $"$env:AI_BATCH_FAILED_FILE = {Q(failedPath)}",
            "",
            $"$promptPath = {Q(promptPath)}",
            $"$scriptPath = {Q(scriptPath)}",
            $"$masterTargetsPath = {Q(targetsPath)}",
            "$promptTemplate = Get-Content -LiteralPath $promptPath -Raw -Encoding UTF8",
            "$targets = @(Get-Content -LiteralPath $masterTargetsPath -Encoding UTF8 | Where-Object { -not [string]::IsNullOrWhiteSpace($_) })",
            "$runnerName = 'Claude'",
            "$promptFileName = [System.IO.Path]::GetFileName($promptPath)",
            "$maxAttempts = 5",
            "$retryDelays = @(30, 60, 120, 240, 360)",
            "function Write-BatchProgress {",
            "    param([string]$Target, [string]$Status, [string]$Phase)",
            "    $now = (Get-Date).ToUniversalTime().ToString('yyyy-MM-ddTHH:mm:ss')",
            "    $rec = [ordered]@{ name = [string]$Target; status = $Status; phase = $Phase; runner = $runnerName; prompt = $promptFileName; at = $now }",
            "    try { ($rec | ConvertTo-Json -Compress) | Add-Content -LiteralPath $env:AI_BATCH_PROGRESS_FILE -Encoding UTF8 } catch {}",
            "}",
            "function Test-ClaudeTransientError {",
            "    param([string]$Text)",
            "    return ($Text -match '(?i)\\b529\\b|overloaded|temporar|rate.?limit|timeout|timed.?out|service unavailable|connection reset|ECONNRESET|ETIMEDOUT|EAI_AGAIN')",
            "}",
            "function Test-ClaudeUsageLimit {",
            "    param([string]$Text)",
            "    return ($Text -match '(?i)monthly usage limit|org.?s monthly usage limit|usage limit|credit balance|quota exceeded|billing limit')",
            "}",
            "Write-Host ('Unattended per-file Claude batch started for ' + $targets.Count + ' target(s).') -ForegroundColor Cyan",
            "$total = $targets.Count",
            "$index = 0",
            "$abortBatch = $false",
            "foreach ($dataset in $targets) {",
            "    $index++",
            "    $safe = ([BitConverter]::ToString([System.Security.Cryptography.SHA1]::Create().ComputeHash([System.Text.Encoding]::UTF8.GetBytes($dataset))).Replace('-', '').Substring(0, 12).ToLowerInvariant())",
            "    $oneTarget = Join-Path (Get-Location) ('_batch_one_' + $safe + '.txt')",
            "    Set-Content -LiteralPath $oneTarget -Value $dataset -Encoding UTF8",
            "    $env:AI_BATCH_TARGETS_FILE = $oneTarget",
            "    $prompt = $promptTemplate.Replace('__AI_BATCH_TARGET_FILE__', (Split-Path -Leaf $oneTarget))",
            "    Write-BatchProgress $dataset 'started' ('dataset ' + $index + '/' + $total)",
            "    Write-Host ('[' + $index + '/' + $total + '] Claude analyzing: ' + $dataset) -ForegroundColor Cyan",
            "    $attempt = 0",
            "    $exitCode = 1",
            "    $lastOutput = ''",
            "    while ($attempt -lt $maxAttempts) {",
            "        $attempt++",
            "        if ($attempt -gt 1) {",
            "            Write-Host ('[' + $index + '/' + $total + '] Claude retry ' + $attempt + '/' + $maxAttempts + ': ' + $dataset) -ForegroundColor Yellow",
            "        }",
            "        $claudeOutput = @()",
            "        & claude --permission-mode bypassPermissions -p $prompt 2>&1 | Tee-Object -Variable claudeOutput",
            "        $exitCode = if ($null -eq $LASTEXITCODE) { 0 } else { $LASTEXITCODE }",
            "        $lastOutput = ($claudeOutput | Out-String)",
            "        if ($exitCode -eq 0) { break }",
            "        if (Test-ClaudeUsageLimit $lastOutput) {",
            "            $reason = 'Claude monthly usage limit reached; stopping batch without marking remaining targets failed'",
            "            Write-BatchProgress $dataset 'stopped' $reason",
            "            Write-Host $reason -ForegroundColor Red",
            "            $remaining = @()",
            "            if ($index -le $targets.Count) { $remaining = @($targets[($index - 1)..($targets.Count - 1)]) }",
            "            try { Set-Content -LiteralPath $masterTargetsPath -Value $remaining -Encoding UTF8 } catch {}",
            "            foreach ($remainingDataset in $remaining) { Write-BatchProgress $remainingDataset 'stopped' $reason }",
            "            $abortBatch = $true",
            "            break",
            "        }",
            "        if (-not (Test-ClaudeTransientError $lastOutput) -or $attempt -ge $maxAttempts) { break }",
            "        $delay = $retryDelays[[Math]::Min($attempt - 1, $retryDelays.Count - 1)]",
            "        $reason = 'Claude transient overload/network error; retry in ' + $delay + 's (attempt ' + $attempt + '/' + $maxAttempts + ')'",
            "        Write-BatchProgress $dataset 'running' $reason",
            "        Write-Host $reason -ForegroundColor Yellow",
            "        Start-Sleep -Seconds $delay",
            "    }",
            "    if ($abortBatch) {",
            "        Remove-Item -LiteralPath $oneTarget -Force -ErrorAction SilentlyContinue",
            "        break",
            "    }",
            "    if ($exitCode -ne 0) {",
            "        $reason = 'Claude exited with code ' + $exitCode",
            "        if (Test-ClaudeTransientError $lastOutput) { $reason = $reason + ' after transient retries' }",
            "        Write-BatchProgress $dataset 'failed' $reason",
            "        Add-Content -LiteralPath $env:AI_BATCH_FAILED_FILE -Value ($dataset + \"`t\" + $reason) -Encoding UTF8",
            "        Write-Host $reason -ForegroundColor Yellow",
            "    }",
            "    Remove-Item -LiteralPath $oneTarget -Force -ErrorAction SilentlyContinue",
            "}",
            "",
            "if (-not $abortBatch) {",
            "    Remove-Item -LiteralPath $masterTargetsPath -Force -ErrorAction SilentlyContinue",
            "} else {",
            "    Write-Host ('Batch stopped. Remaining targets were kept at: ' + $masterTargetsPath) -ForegroundColor Yellow",
            "}",
            "Remove-Item -LiteralPath $promptPath -Force -ErrorAction SilentlyContinue",
            "Remove-Item -LiteralPath $scriptPath -Force -ErrorAction SilentlyContinue",
        });
    }

