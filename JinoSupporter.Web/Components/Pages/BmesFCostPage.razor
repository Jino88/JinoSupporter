    [Parameter] public bool ShowFCostWeeklyReport { get; set; }
    [Parameter] public bool ShowAllPeriodColumns { get; set; }
    [Parameter] public bool ShowWeeklyActionItems { get; set; } = true;
    [Parameter] public bool ShowRegularFCostDetails { get; set; } = true;

    // ── Static-HTML export mode ────────────────────────────────────────────────
    // BmesReportHtmlExportService renders this page four times (F-COST, F-COST(전체),
    // 목표 불량률, 목표 불량률(전체)). Building the report is expensive — RAW backfill,
    // report build, raw-material breakdown — so only the first instance computes it and
    // publishes the result through OnExportComputed; the other three receive that
    // snapshot via ExportSharedReport and go straight to rendering.
    [Parameter] public bool ExportMode { get; set; }
    [Parameter] public DateTime? ExportStart { get; set; }
    [Parameter] public DateTime? ExportEnd { get; set; }
    [Parameter] public IReadOnlyList<ModelGroupRecord>? ExportGroups { get; set; }
    [Parameter] public NgRateReportService.NgRateReport? ExportSharedNgTrend { get; set; }
    [Parameter] public FCostExportSnapshot? ExportSharedReport { get; set; }
    [Parameter] public Action<FCostExportSnapshot>? OnExportComputed { get; set; }
    [Parameter] public IProgress<string>? ExportProgress { get; set; }
    private bool _exportGenerated;

    public sealed record FCostKpiPeriodValue(
        int ColumnIndex,
        double TotalCost,
        double TotalRate,
        double MainDefectAveragePpm);

    /// <summary>Everything the four F-COST export tabs and the KPI tab render from,
    /// computed once.</summary>
    public sealed record FCostExportSnapshot(
        FCostReport Report,
        NgRateReportService.NgRateReport? NgRateTrendByMid,
        List<ModelGroupRecord> ModelGroups,
        BmesFcostRawBreakdownResult? RawMaterialBreakdown,
        FCostRawStatus? RawStatus,
        IReadOnlyList<FCostKpiPeriodValue> KpiPeriods,
        DateTime StartDate,
        DateTime EndDate);

    protected override async Task OnParametersSetAsync()
    {
        if (!ExportMode || _exportGenerated) return;

        // Follower tab: reuse the leader's computed report, no data access at all.
        if (ExportSharedReport is { } snapshot)
        {
            _exportGenerated = true;
            _report            = snapshot.Report;
            _ngRateTrendByMid  = snapshot.NgRateTrendByMid;
            _reportModelGroups = snapshot.ModelGroups;
            _rawMaterialBreakdown = snapshot.RawMaterialBreakdown;
            _rawStatus         = snapshot.RawStatus;
            _reportStartDate   = snapshot.StartDate;
            _reportEndDate     = snapshot.EndDate;
            return;
        }

        // Leader tab: compute once, then hand the result to the followers.
        if (ExportStart is { } start && ExportEnd is { } end && ExportGroups is { Count: > 0 } groups)
        {
            _exportGenerated = true;
            await GenerateReportAsync(
                start, end,
                progress: ExportProgress,
                selectedGroups: groups,
                sharedNgRateTrendReport: ExportSharedNgTrend);

            if (_report is not null)
            {
                OnExportComputed?.Invoke(new FCostExportSnapshot(
                    _report, _ngRateTrendByMid, _reportModelGroups, _rawMaterialBreakdown,
                    _rawStatus, BuildKpiPeriodValues(), _reportStartDate, _reportEndDate));
            }
        }
    }

