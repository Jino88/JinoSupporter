    private sealed class FCostTrendAggregate
    {
        public FCostTrendAggregate(string display, int columnCount)
        {
            Display = display;
            InputByCol = new double[columnCount];
            CostByCol = new double[columnCount];
        }

        public string Display { get; }
        public double[] InputByCol { get; }
        public double[] CostByCol { get; }
    }

    /// <summary>Compute report totals for the requested columns. Prefer BMES' own
    /// Total triplet when it has both Input and F-COST values; raw range data can
    /// miss the FCOST continuation row, so fall back to materials and SubGroups.</summary>
    private (double[] Input, double[] Cost) ComputeSubGroupTotals(IReadOnlyList<int> columnIndexes)
    {
        int columnCount = columnIndexes.Count;
        var input = new double[columnCount];
        var cost  = new double[columnCount];
        if (_report is null) return (input, cost);

        if (_report.Total is not null)
        {
            for (int i = 0; i < columnCount; i++)
            {
                int sourceIdx = columnIndexes[i] + 1;
                input[i] = _report.Total.Input?.GetCol(sourceIdx) ?? 0;
                cost[i]  = _report.Total.Cost ?.GetCol(sourceIdx) ?? 0;
            }
            if (HasInputAndCost(input, cost)) return (input, cost);
            Array.Clear(input);
            Array.Clear(cost);
        }

        foreach (var mat in _report.Materials)
        {
            for (int i = 0; i < columnCount; i++)
            {
                int sourceIdx = columnIndexes[i] + 1;
                input[i] += mat.Input?.GetCol(sourceIdx) ?? 0;
                cost[i]  += mat.Cost ?.GetCol(sourceIdx) ?? 0;
            }
        }
        if (HasInputAndCost(input, cost)) return (input, cost);
        Array.Clear(input);
        Array.Clear(cost);

        foreach (var sg in _report.SubGroups)
        {
            for (int i = 0; i < columnCount; i++)
            {
                int sourceIdx = columnIndexes[i];
                if (sourceIdx < 0) continue;
                input[i] += ValueAt(sg.InputByCol, sourceIdx);
                cost[i]  += ValueAt(sg.CostByCol, sourceIdx);
            }
        }
        return (input, cost);
    }

    private static bool HasInputAndCost(IReadOnlyList<double> input, IReadOnlyList<double> cost)
        => input.Any(v => v > 0) && cost.Any(v => v > 0);

    private List<FCostTrendModelRow> BuildMajorTrendRows(IReadOnlyList<int> columnIndexes)
    {
        var rows = new List<FCostTrendModelRow>();
        if (_report is null || columnIndexes.Count == 0) return rows;

        int columnCount = _report.ColumnHeaders.Count;
        if (columnCount == 0) columnCount = _report.Columns.Count;
        if (columnCount == 0) return rows;

        var groupRows = BuildSelectedGroupTrendAggregates(columnCount);
        var emitted = new HashSet<string>(StringComparer.Ordinal);
        foreach (var group in _reportModelGroups
            .OrderBy(g => g.SortOrder)
            .ThenBy(g => g.Name, StringComparer.Ordinal))
        {
            if (string.IsNullOrWhiteSpace(group.Name)) continue;
            if (!emitted.Add(group.Name)) continue;
            if (!groupRows.TryGetValue(group.Name, out var groupRow)) continue;
            if (!TrendHasData(groupRow.InputByCol, groupRow.CostByCol, columnIndexes)) continue;

            rows.Add(new FCostTrendModelRow(
                RowId: $"G::{group.Name}",
                ParentRowId: null,
                ModelName: group.Name,
                GroupName: group.Name,
                NgGroupKey: group.Name,
                Depth: 0,
                InputByCol: groupRow.InputByCol,
                CostByCol: groupRow.CostByCol,
                NgPpmByColumn: columnIndexes.ToDictionary(
                    ci => ci,
                    ci => LookupNgTrendPpmByGroupKey(group.Name, ci))));
        }

        if (rows.Count > 0)
        {
            AppendBmesRemainderTrendRow(rows, columnIndexes);
            return rows;
        }

        var fallbackRows = BuildFCostHierarchy()
            .Where(r => r.Depth == 0)
            .Where(r => TrendModelHasData(r, columnIndexes))
            .OrderBy(r => r.Display, StringComparer.Ordinal)
            .Select(r => new FCostTrendModelRow(
                RowId: r.RowId,
                ParentRowId: null,
                ModelName: r.Display,
                GroupName: string.Empty,
                NgGroupKey: r.NgGroupKey,
                Depth: r.Depth,
                InputByCol: r.InputByCol,
                CostByCol: r.CostByCol,
                NgPpmByColumn: columnIndexes.ToDictionary(
                    ci => ci,
                    ci => LookupNgTrendPpmByGroupKey(r.NgGroupKey, ci))))
            .ToList();
        AppendBmesRemainderTrendRow(fallbackRows, columnIndexes);
        return fallbackRows;
    }

    private IReadOnlyList<FCostKpiPeriodValue> BuildKpiPeriodValues()
    {
        if (_report?.Columns is not { Count: > 0 } columns)
            return Array.Empty<FCostKpiPeriodValue>();

        List<int> columnIndexes = Enumerable.Range(0, columns.Count)
            .Where(index => columns[index].Kind is FCostPeriodKind.Week or FCostPeriodKind.Month)
            .ToList();
        if (columnIndexes.Count == 0)
            return Array.Empty<FCostKpiPeriodValue>();

        // Match the visible F-COST Trend model rows. "기타_누락" is a residual bucket,
        // not a model, and a zero PPM is rendered as "-" in that table, so neither
        // contributes to the model-average KPI.
        List<FCostTrendModelRow> modelRows = BuildMajorTrendRows(columnIndexes)
            .Where(row => row.ParentRowId is null &&
                          row.Depth == 0 &&
                          !string.Equals(row.ModelName, "기타_누락", StringComparison.Ordinal))
            .ToList();

        return columnIndexes
            .Select(columnIndex =>
            {
                double[] modelPpm = modelRows
                    .Select(row => row.NgPpmByColumn.GetValueOrDefault(columnIndex))
                    .Where(ppm => ppm > 0)
                    .ToArray();

                return new FCostKpiPeriodValue(
                    columnIndex,
                    GetBmesTotalCost(columnIndex),
                    GetBmesTotalRate(columnIndex),
                    modelPpm.Length > 0 ? modelPpm.Average() : 0);
            })
            .ToList();
    }

    private static string TrendModelDisplayName(string modelName)
    {
        int separator = modelName.IndexOf('_');
        if (separator <= 0 || separator >= modelName.Length - 1)
            return modelName;

        string prefix = modelName[..separator];
        string suffix = modelName[(separator + 1)..];
        return suffix.StartsWith(prefix + "_", StringComparison.Ordinal)
            ? suffix
            : modelName;
    }

    private Dictionary<string, FCostTrendAggregate> BuildSelectedGroupTrendAggregates(int columnCount)
    {
        var result = new Dictionary<string, FCostTrendAggregate>(StringComparer.Ordinal);
        if (_report is null) return result;

        foreach (var sg in _report.SubGroups)
        {
            if (string.IsNullOrWhiteSpace(sg.GroupName)) continue;
            if (!result.TryGetValue(sg.GroupName, out var aggregate))
            {
                aggregate = new FCostTrendAggregate(sg.GroupName, columnCount);
                result[sg.GroupName] = aggregate;
            }

            for (int i = 0; i < columnCount; i++)
            {
                aggregate.InputByCol[i] += ValueAt(sg.InputByCol, i);
                aggregate.CostByCol[i] += ValueAt(sg.CostByCol, i);
            }
        }

        return result;
    }

    private void AppendBmesRemainderTrendRow(List<FCostTrendModelRow> rows, IReadOnlyList<int> columnIndexes)
    {
        if (_report is null || rows.Count == 0 || columnIndexes.Count == 0) return;

        int columnCount = _report.ColumnHeaders.Count;
        if (columnCount == 0) columnCount = _report.Columns.Count;
        if (columnCount == 0) return;

        var totalInputByColumn = ComputeTotalInputByColumn(columnIndexes);
        var totalCostByColumn = ComputeTotalCostByColumn(columnIndexes);
        var shownRows = rows.Where(r => r.ParentRowId is null).ToList();

        var remainderInput = new double[columnCount];
        var remainderCost = new double[columnCount];
        bool hasMeaningfulRemainder = false;

        foreach (int ci in columnIndexes)
        {
            if (ci < 0 || ci >= columnCount) continue;

            double totalInput = totalInputByColumn.GetValueOrDefault(ci);
            double totalCost = totalCostByColumn.GetValueOrDefault(ci);
            double shownInput = shownRows.Sum(r => ValueAt(r.InputByCol, ci));
            double shownCost = shownRows.Sum(r => ValueAt(r.CostByCol, ci));

            double diffInput = totalInput - shownInput;
            double diffCost = totalCost - shownCost;
            if (diffInput < 0 && Math.Abs(diffInput) < 0.5) diffInput = 0;
            if (diffCost < 0 && Math.Abs(diffCost) < 0.5) diffCost = 0;

            remainderInput[ci] = Math.Max(0, diffInput);
            remainderCost[ci] = Math.Max(0, diffCost);

            if (totalCost > 0 && remainderCost[ci] / totalCost * 100.0 >= TrendRemainderMinSharePercent)
                hasMeaningfulRemainder = true;
        }

        if (!hasMeaningfulRemainder) return;

        rows.Add(new FCostTrendModelRow(
            RowId: "M::__BMES_REMAINDER__",
            ParentRowId: null,
            ModelName: "기타_누락",
            GroupName: string.Empty,
            NgGroupKey: string.Empty,
            Depth: 0,
            InputByCol: remainderInput,
            CostByCol: remainderCost,
            NgPpmByColumn: columnIndexes.ToDictionary(ci => ci, _ => 0.0)));
    }

    private static bool TrendModelHasData(FCostHierarchyRow row, IReadOnlyList<int> columnIndexes)
        => TrendHasData(row.InputByCol, row.CostByCol, columnIndexes);

    private static bool TrendHasData(
        IReadOnlyList<double>? inputByCol,
        IReadOnlyList<double>? costByCol,
        IReadOnlyList<int> columnIndexes)
        => columnIndexes.Any(ci =>
            ci >= 0 &&
            ((costByCol is not null && ci < costByCol.Count && costByCol[ci] > 0) ||
             (inputByCol is not null && ci < inputByCol.Count && inputByCol[ci] > 0)));

    private static bool TrendHasCostData(IReadOnlyList<double>? costByCol, IReadOnlyList<int> columnIndexes)
        => columnIndexes.Any(ci => costByCol is not null && ci >= 0 && ci < costByCol.Count && costByCol[ci] > 0);

    private static double TrendCostSum(IReadOnlyList<double>? costByCol, IReadOnlyList<int> columnIndexes)
    {
        if (costByCol is null) return 0;
        double total = 0;
        foreach (int ci in columnIndexes)
        {
            if (ci >= 0 && ci < costByCol.Count)
                total += costByCol[ci];
        }
        return total;
    }

    private Dictionary<string, FCostTrendAggregate> BuildMaterialTrendAggregates()
    {
        var aggregates = new Dictionary<string, FCostTrendAggregate>(StringComparer.OrdinalIgnoreCase);
        if (_report is null) return aggregates;

        int columnCount = _report.ColumnHeaders.Count;
        foreach (var material in _report.Materials)
        {
            foreach (string key in MaterialTrendKeys(material).Distinct(StringComparer.OrdinalIgnoreCase))
            {
                if (string.IsNullOrWhiteSpace(key)) continue;
                if (!aggregates.TryGetValue(key, out var aggregate))
                {
                    aggregate = new FCostTrendAggregate(key, columnCount);
                    aggregates[key] = aggregate;
                }

                for (int i = 1; i <= columnCount; i++)
                {
                    aggregate.InputByCol[i - 1] += material.Input?.GetCol(i) ?? 0;
                    aggregate.CostByCol[i - 1] += material.Cost?.GetCol(i) ?? 0;
                }
            }
        }

        return aggregates;
    }

    private static IEnumerable<string> MaterialTrendKeys(FCostMaterialBlock material)
    {
        string matnrTx = material.Input?.MatnrTx ?? string.Empty;
        if (!string.IsNullOrWhiteSpace(matnrTx))
            yield return matnrTx.Trim();
    }

    private double LookupNgTrendPpmByGroupKey(string groupKey, int fcostColumnIndex)
    {
        if (_ngRateTrendByMid is null || string.IsNullOrWhiteSpace(groupKey)) return 0;

        foreach (string trendKey in NgTrendColumnKeyCandidates(fcostColumnIndex))
        {
            foreach (string keyCandidate in GetNgTrendKeyCandidates(groupKey))
            {
                var rows = _ngRateTrendByMid.GroupSummary.GetValueOrDefault(keyCandidate);
                if (rows is null) continue;

                var total = rows.FirstOrDefault(r => r.IsTotal) ?? rows.FirstOrDefault();
                if (total?.Ppm.TryGetValue(trendKey, out double ppm) == true)
                    return ppm;
            }
        }

        return 0;
    }

    private static IEnumerable<string> GetNgTrendKeyCandidates(string groupKey)
    {
        string? current = groupKey?.Trim();
        if (string.IsNullOrWhiteSpace(current)) yield break;

        yield return current;

        while (true)
        {
            int sep = current.LastIndexOf("::", StringComparison.Ordinal);
            if (sep <= 0) yield break;

            current = current[..sep];
            if (!string.IsNullOrWhiteSpace(current))
                yield return current;
        }
    }

    private IEnumerable<string> NgTrendColumnKeyCandidates(int fcostColumnIndex)
    {
        if (_report?.Columns is not { Count: > 0 } columns ||
            fcostColumnIndex < 0 ||
            fcostColumnIndex >= columns.Count)
            yield break;

        var col = columns[fcostColumnIndex];
        var candidates = col.Kind switch
        {
            FCostPeriodKind.Week => new[]
            {
                NormalizeNgWeekKey(col.PDate),
                NormalizeNgWeekKey(col.Code),
                col.Code,
                col.Code.Replace("-", string.Empty, StringComparison.Ordinal),
                col.PDate,
            },
            FCostPeriodKind.Month => new[]
            {
                NormalizeNgMonthKey(col.PDate),
                NormalizeNgMonthKey(col.Code),
                col.Code,
                col.PDate,
            },
            FCostPeriodKind.Day => new[]
            {
                NormalizeNgDateKey(col.PDate),
                NormalizeNgDateKey(col.Code),
                col.PDate,
                col.Code,
            },
            _ => new[]
            {
                col.Code,
                col.PDate,
            },
        };

        var seen = new HashSet<string>(StringComparer.Ordinal);
        foreach (string candidate in candidates)
        {
            string key = candidate.Trim();
            if (key.Length > 0 && seen.Add(key))
                yield return key;
        }
    }

    private double[] ComputeTotalRates(IReadOnlyList<int> columnIndexes)
    {
        var rates = new double[columnIndexes.Count];
        if (_report is null)
            return rates;

        var usedSource = new bool[columnIndexes.Count];
        if (_report.SubGroups.Count > 0)
        {
            for (int i = 0; i < columnIndexes.Count; i++)
            {
                int ci = columnIndexes[i];
                double weightedSourceRate = 0;
                double sourceInput = 0;

                foreach (var sg in _report.SubGroups)
                {
                    double rateInput = ValueAt(sg.InputByCol, ci);
                    if (rateInput <= 0) continue;

                    weightedSourceRate += ValueAt(sg.SourceRateByCol, ci) * rateInput;
                    sourceInput += rateInput;
                }

                if (sourceInput > 0)
                {
                    rates[i] = weightedSourceRate / sourceInput;
                    usedSource[i] = true;
                }
            }
        }

        var (input, cost) = ComputeSubGroupTotals(columnIndexes);
        for (int i = 0; i < columnIndexes.Count; i++)
            if (!usedSource[i])
                rates[i] = input[i] > 0 ? cost[i] / input[i] * 100.0 : 0;
        return rates;
    }

    private double[] ComputeWeeklyTotalRates(
        IReadOnlyList<int> columnIndexes,
        IReadOnlyList<FCostWeeklyModelRow> modelRows)
    {
        var rates = new double[columnIndexes.Count];
        bool hasNgRate = false;

        for (int i = 0; i < columnIndexes.Count; i++)
        {
            int ci = columnIndexes[i];
            double sum = 0;
            int count = 0;
            foreach (var row in modelRows)
            {
                double rate = ValueAt(row.SourceRateByCol, ci);
                if (rate <= 0) continue;
                sum += rate;
                count++;
            }

            if (count > 0)
            {
                rates[i] = sum / count;
                hasNgRate = true;
            }
        }

        return hasNgRate ? rates : ComputeTotalRates(columnIndexes);
    }

    private double ResolveLatestWeeklyPpm(
        FCostWeeklyModelRow modelRow,
        IReadOnlyList<int> columnIndexes)
    {
        if (_report?.Columns is not { Count: > 0 } columns)
            return 0;

        foreach (int ci in columnIndexes)
        {
            if (ci < 0 || ci >= columns.Count) continue;
            if (columns[ci].Kind != FCostPeriodKind.Week) continue;

            double rate = ValueAt(modelRow.SourceRateByCol, ci);
            if (rate > 0)
                return rate * 10000.0;
        }

        return 0;
    }

    private Dictionary<int, double> ComputeTotalInputByColumn(IReadOnlyList<int> columnIndexes)
    {
        var (input, _) = ComputeSubGroupTotals(columnIndexes);
        var map = new Dictionary<int, double>();
        for (int i = 0; i < columnIndexes.Count; i++)
            map[columnIndexes[i]] = input[i];
        return map;
    }

    private List<int> ReportColumnIndexes()
        => ShowAllPeriodColumns ? AllFCostColumnIndexes() : WeeklyReportColumnIndexes();

    private List<int> WeeklyReportColumnIndexes()
    {
        if (_report?.Columns is not { Count: > 0 } columns) return new List<int>();

        var validVisible = Enumerable.Range(0, columns.Count)
            .ToList();

        var weekColumns = validVisible
            .Where(ci => columns[ci].Kind == FCostPeriodKind.Week)
            .OrderByDescending(ci => FCostPeriodSortKey(columns[ci]))
            .Take(WeeklyReportWeekColumnCount);

        var monthColumns = validVisible
            .Where(ci => columns[ci].Kind == FCostPeriodKind.Month)
            .OrderByDescending(ci => FCostPeriodSortKey(columns[ci]))
            .Take(WeeklyReportMonthColumnCount);

        return weekColumns
            .Concat(monthColumns)
            .ToList();
    }

    private double ComputeWeeklyBasisTotalRate()
    {
        int basisColumnIndex = FindLatestWeekColumnIndex0();
        if (basisColumnIndex < 0) return 0;

        var (input, cost) = ComputeSubGroupTotals(new[] { basisColumnIndex });
        return input.Length > 0 && input[0] > 0 ? cost[0] / input[0] * 100.0 : 0;
    }

    private Dictionary<int, double> ComputeTotalCostByColumn(IReadOnlyList<int> columnIndexes)
    {
        var (_, cost) = ComputeSubGroupTotals(columnIndexes);
        var map = new Dictionary<int, double>();
        for (int i = 0; i < columnIndexes.Count; i++)
            map[columnIndexes[i]] = cost[i];
        return map;
    }

