    private List<FCostWeeklyModelRow> BuildWeeklyModelRows()
    {
        int basisColumnIndex = FindLatestWeekColumnIndex0();
        if (basisColumnIndex < 0) return new List<FCostWeeklyModelRow>();

        var ngModelRows = BuildWeeklyModelRowsFromNgRate(basisColumnIndex);
        if (ngModelRows.Count > 0)
            return ngModelRows;

        var modelRows = BuildFCostHierarchy()
            .Where(r => r.Depth == 0)
            .ToList();

        return modelRows
            .Where(r => ValueAt(r.InputByCol, basisColumnIndex) > 0 &&
                        (ValueAt(r.SourceRateByCol, basisColumnIndex) > 0 ||
                         ValueAt(r.CostByCol, basisColumnIndex) > 0))
            .Select(r => new FCostWeeklyModelRow(
                r.Display,
                ResolveWeeklyRateFromSource(ValueAt(r.SourceRateByCol, basisColumnIndex),
                                          ValueAt(r.InputByCol, basisColumnIndex),
                                          ValueAt(r.CostByCol, basisColumnIndex)),
                ValueAt(r.CostByCol, basisColumnIndex),
                r.InputByCol,
                r.CostByCol,
                r.SourceRateByCol))
            .ToList();
    }

    private List<FCostWeeklyModelRow> BuildWeeklyModelRowsFromNgRate(int basisColumnIndex)
    {
        if (_report is null || _ngRateTrendByMid is null || _reportModelGroups.Count == 0)
            return new List<FCostWeeklyModelRow>();

        int columnCount = _report.ColumnHeaders.Count > 0 ? _report.ColumnHeaders.Count : _report.Columns.Count;
        if (columnCount <= 0)
            return new List<FCostWeeklyModelRow>();

        var rows = new List<FCostWeeklyModelRow>();
        var emitted = new HashSet<string>(StringComparer.Ordinal);
        foreach (var group in _reportModelGroups
            .OrderBy(g => g.SortOrder)
            .ThenBy(g => g.Name, StringComparer.Ordinal))
        {
            foreach (var mid in group.MidGroups)
            {
                if (string.IsNullOrWhiteSpace(mid.Material)) continue;
                if (!emitted.Add($"{group.Name}::{mid.Material}")) continue;

                var rateByCol = new double[columnCount];
                string ngKey = $"{group.Name}::{mid.Material}";
                for (int ci = 0; ci < columnCount; ci++)
                    rateByCol[ci] = PpmToRatePercent(LookupNgTrendPpmByGroupKey(ngKey, ci));

                rows.Add(new FCostWeeklyModelRow(
                    mid.Material,
                    ValueAt(rateByCol, basisColumnIndex),
                    0,
                    new double[columnCount],
                    new double[columnCount],
                    rateByCol));
            }
        }

        return rows;
    }

    private int FindLatestWeekColumnIndex0()
    {
        if (_report?.Columns is not { Count: > 0 } columns) return -1;

        var weekIndexes = columns
            .Where(c => c.Kind == FCostPeriodKind.Week)
            .OrderByDescending(FCostPeriodSortKey)
            .Select(c => c.Index - 1)
            .ToList();

        return weekIndexes.Count > 0 ? weekIndexes[0] : -1;
    }

    private long FCostPeriodSortKey(FCostColumnMeta col)
    {
        string pdate = (col.PDate ?? string.Empty).Trim();
        string code = (col.Code ?? string.Empty).Trim();

        if (col.Kind == FCostPeriodKind.Week)
        {
            foreach (string candidate in new[] { pdate, code })
            {
                string digits = candidate.Replace("-", string.Empty, StringComparison.Ordinal);
                if (long.TryParse(digits, out long value))
                    return value;
            }
        }

        if (col.Kind == FCostPeriodKind.Month)
        {
            foreach (string candidate in new[] { pdate, code })
            {
                if (long.TryParse(candidate, out long value))
                    return value;
            }
        }

        return col.Index;
    }

    private string WeeklySummaryColumnHeader(int columnIndex)
    {
        if (_report?.Columns is { Count: > 0 } columns &&
            columnIndex >= 0 &&
            columnIndex < columns.Count)
        {
            var col = columns[columnIndex];
            if (col.Kind == FCostPeriodKind.Week)
            {
                string code = !string.IsNullOrWhiteSpace(col.Code) ? col.Code : col.Header;
                int dash = code.LastIndexOf('-');
                if (dash >= 0 && dash + 1 < code.Length && int.TryParse(code[(dash + 1)..], out int week))
                    return $"W{week:D2}";
            }

            if (col.Kind == FCostPeriodKind.Month &&
                DateTime.TryParseExact(col.PDate, "yyyyMM", CultureInfo.InvariantCulture, DateTimeStyles.None, out DateTime month))
            {
                return month.ToString("MMM", CultureInfo.InvariantCulture);
            }

            return col.Header;
        }

        return _report is not null &&
               columnIndex >= 0 &&
               columnIndex < _report.ColumnHeaders.Count
            ? _report.ColumnHeaders[columnIndex]
            : string.Empty;
    }

