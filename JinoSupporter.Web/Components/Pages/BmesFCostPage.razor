@* Route and render mode live on BmesFCost.razor, not here: BmesReportHtmlExportService
   renders this component through the standalone HtmlRenderer, which supports no render
   modes at all, so a @@rendermode directive on the component itself makes the export
   fail outright. Keeping it a plain component also matches the other three report tabs. *@
@using System.Diagnostics
@using System.Globalization
@using System.Text.Json
@using JinoSupporter.Web.Services
@inject FCostService          FCost
@inject FCostReportService    FCostReportSvc
@inject BmesFcostActualService FCostActual
@inject NgRateService         NgRate
@inject NgRateReportService   NgRateReportSvc
@inject NgRateSettingsService NgRateSettings
@inject AppPathsService       AppPaths
@inject WebRepository         Repo
@inject IJSRuntime            JS
@inject AppActivityLogger     Activity

@if (ShowPageTitle)
{
    <PageTitle>@(IsTrendReportRoute ? "Report - Major Model Defect Rate Trend" : "BMES - F-Cost")</PageTitle>
}

@if (ShowPageHeader)
{
    <div class="d-flex align-items-center gap-2 mb-3">
        <span class="fw-semibold" style="font-size:20px;">$</span>
        <h5 class="mb-0 fw-semibold">@(IsTrendReportRoute ? "Report - Major Model Defect Rate Trend" : "F-Cost")</h5>
    </div>
}

@if (ShowSetup)
{
<div class="row g-3">

    <div class="col-12">
        <div class="card shadow-sm h-100">
            <div class="card-header small fw-semibold">Report</div>
            <div class="card-body d-flex flex-column gap-2">
                <div class="small text-muted">
                    Builds the report from <code>fcost_raw.db</code>. Missing dates in the selected
                    range are fetched automatically before report generation; the last 3 dates are
                    refreshed every run.
                </div>

                <div class="d-flex align-items-center gap-2 flex-wrap small">
                    <span class="text-muted">BMES:</span>
                    @if (NgRateSettings.IsCredentialsConfigured)
                    {
                        <span class="badge bg-success">Credentials OK</span>
                        <span class="text-muted font-monospace">@NgRateSettings.LoginId</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">Not configured</span>
                        <a href="/setting" class="text-primary">Setting</a>
                    }
                </div>

                <div class="row g-2 align-items-end">
                    <div class="col-sm-auto">
                        <label class="form-label small text-muted mb-1">Start</label>
                        <input type="date" class="form-control form-control-sm"
                               @bind="_reportStartDate" @bind:format="yyyy-MM-dd" />
                    </div>
                    <div class="col-sm-auto">
                        <label class="form-label small text-muted mb-1">End</label>
                        <input type="date" class="form-control form-control-sm"
                               @bind="_reportEndDate" @bind:format="yyyy-MM-dd" />
                    </div>
                </div>

                <!-- Row visibility toggles -->
                <div class="d-flex align-items-center gap-3 mt-1 small">
                    <span class="text-muted fw-semibold" style="font-size:11px;">Show rows:</span>
                    <label class="form-check-inline d-flex align-items-center gap-1 m-0" style="font-size:11px;">
                        <input type="checkbox" class="form-check-input m-0" @bind="_showInput" />
                        <span>INPUT</span>
                    </label>
                    <label class="form-check-inline d-flex align-items-center gap-1 m-0" style="font-size:11px;">
                        <input type="checkbox" class="form-check-input m-0" @bind="_showCost" />
                        <span>F-COST</span>
                    </label>
                    <label class="form-check-inline d-flex align-items-center gap-1 m-0" style="font-size:11px;">
                        <input type="checkbox" class="form-check-input m-0" @bind="_showRate" />
                        <span>RATE %</span>
                    </label>
                </div>

                <div class="small">
                    <div>
                        <span class="text-muted">RAW DB:</span>
                        <span class="font-monospace text-break">@FCost.GetRawDbPath()</span>
                    </div>
                    @if (_rawStatus is not null && _rawStatus.Exists)
                    {
                        <div class="text-muted">
                            Pulls @_rawStatus.SuccessCount:N0 OK / @_rawStatus.FailedCount:N0 failed,
                            rows @_rawStatus.TotalRows:N0,
                            range @_rawStatus.FirstDate - @_rawStatus.LastDate
                        </div>
                    }
                    else
                    {
                        <div class="text-muted">No RAW DB yet. Generate Report will create it.</div>
                    }
                </div>

                <button class="btn btn-success mt-1"
                        @onclick="GetReportAsync"
                        disabled="@(_isReportBusy || !NgRateSettings.IsCredentialsConfigured)">
                    @if (_isReportBusy)
                    { <span class="spinner-border spinner-border-sm me-1"></span><span>Loading...</span> }
                    else { <span>Generate Report</span> }
                </button>
                @if (!NgRateSettings.IsCredentialsConfigured)
                {
                    <div class="small text-muted">BMES credentials are required for recent-date refresh.</div>
                }
                @if (!string.IsNullOrEmpty(_reportStatusMessage))
                {
                    <div class="small text-muted">@_reportStatusMessage</div>
                }
            </div>
        </div>
    </div>
</div>
}

@if (_report is not null)
{
    var weeklyColumnIndexes = ReportColumnIndexes();
    var weeklyTotalInputByColumn = ComputeTotalInputByColumn(weeklyColumnIndexes);
    var weeklyTotalCostByColumn = ComputeTotalCostByColumn(weeklyColumnIndexes);
    var weeklyModelRows = BuildWeeklyModelRows();
    var weeklyTotalRates = ComputeWeeklyTotalRates(weeklyColumnIndexes, weeklyModelRows);
    var trendRows = BuildMajorTrendRows(weeklyColumnIndexes);
    var trendRowsWithChildren = trendRows
        .Where(r => r.ParentRowId is not null)
        .Select(r => r.ParentRowId!)
        .ToHashSet(StringComparer.Ordinal);
    var visibleTrendRows = trendRows
        .Where(r => r.ParentRowId is null || IsHierarchyRowExpanded(_expandedTrendRows, r.ParentRowId))
        .ToList();
    int trendFirstColumnIndex = weeklyColumnIndexes.Count > 0 ? weeklyColumnIndexes[0] : -1;
    double weeklyBasisTotalRate = ComputeWeeklyBasisTotalRate();
    int weeklySummaryRowSpan = weeklyModelRows.Count + 1;

    <div class="d-flex justify-content-end mt-3">
        <button class="btn btn-outline-success btn-sm"
                @onclick="ExportCsvAsync"
                disabled="@_isExportingCsv">
            @if (_isExportingCsv)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                <span>Exporting...</span>
            }
            else
            {
                <span>Export CSV</span>
            }
        </button>
    </div>

    @if ((IsTrendReportRoute || ShowMajorTrendCard) && trendRows.Count > 0)
    {
        <div class="card shadow-sm mt-3 fcost-trend-card">
            <div class="card-body p-0">
                <div class="fcost-trend-title"><span></span> @(ShowAllPeriodColumns ? "FCOST Trend (전체)" : "FCOST Trend")</div>
                <div style="overflow-x:auto;">
                    <table class="fcost-trend-table">
                        <thead>
                            <tr>
                                <th class="trend-model-th">모델</th>
                                <th class="trend-metric-th">지표</th>
                                @foreach (int ci in weeklyColumnIndexes)
                                {
                                    <th class="@(ci == trendFirstColumnIndex ? "trend-period-start" : ColBoundaryClass(ci))">@WeeklySummaryColumnHeader(ci)</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in visibleTrendRows)
                            {
                                bool canExpandTrend = trendRowsWithChildren.Contains(row.RowId);
                                bool expandedTrend = IsHierarchyRowExpanded(_expandedTrendRows, row.RowId);
                                string trendRowId = row.RowId;
                                string trendDepthClass = row.Depth > 0 ? "trend-child-row" : "";
                                <tr class="@($"trend-defect-row {trendDepthClass}")">
                                    <td class="@($"trend-model-td {(row.Depth > 0 ? "trend-child-model" : "")}")">
                                        @if (canExpandTrend)
                                        {
                                            <button type="button"
                                                    class="trend-expand-btn"
                                                    title="Sub Group"
                                                    @onclick="@(() => ToggleTrendRow(trendRowId))">@(expandedTrend ? "-" : "+")</button>
                                        }
                                        else
                                        {
                                            <span class="trend-expand-spacer"></span>
                                        }
                                        @if (row.Depth > 0)
                                        {
                                            <span class="trend-bgroup-badge">Sub Group</span>
                                        }
                                        <strong>@TrendModelDisplayName(row.ModelName)</strong>
                                    </td>
                                     <td class="trend-metric-td">불량률</td>
                                    @foreach (int ci in weeklyColumnIndexes)
                                    {
                                        double v = row.NgPpmByColumn.TryGetValue(ci, out double ppm) ? ppm : 0;
                                        <td class="@(ci == trendFirstColumnIndex ? "trend-period-start" : ColBoundaryClass(ci))">@FormatTrendPpm(v)</td>
                                    }
                                </tr>
                                <tr class="@($"trend-fcost-row {trendDepthClass}")">
                                    <td class="@($"trend-model-td trend-model-muted {(row.Depth > 0 ? "trend-child-model" : "")}")">
                                        <span class="trend-expand-spacer"></span>@TrendModelDisplayName(row.ModelName)
                                    </td>
                                    <td class="trend-metric-td">F-COST</td>
                                    @foreach (int ci in weeklyColumnIndexes)
                                    {
                                        double v = ValueAt(row.CostByCol, ci);
                                        <td class="@(ci == trendFirstColumnIndex ? "trend-period-start" : ColBoundaryClass(ci))">@FormatTrendCurrency(v)</td>
                                    }
                                </tr>
                                <tr class="@($"trend-share-row {trendDepthClass}")">
                                    <td class="@($"trend-model-td trend-model-muted {(row.Depth > 0 ? "trend-child-model" : "")}")">
                                        <span class="trend-expand-spacer"></span>@TrendModelDisplayName(row.ModelName)
                                    </td>
                                     <td class="trend-metric-td">비중</td>
                                    @foreach (int ci in weeklyColumnIndexes)
                                    {
                                        double modelCost = ValueAt(row.CostByCol, ci);
                                        double totalCost = weeklyTotalCostByColumn.TryGetValue(ci, out double tc) ? tc : 0;
                                        double share = totalCost > 0 ? modelCost / totalCost * 100.0 : 0;
                                        <td class="@(ci == trendFirstColumnIndex ? "trend-period-start" : ColBoundaryClass(ci))">@FormatTrendPercent(share)</td>
                                    }
                                </tr>
                            }
                            @if (_report.Total is not null)
                            {
                                <tr class="trend-total-row trend-total-first-row">
                                    <td class="trend-model-td" rowspan="3"><strong>Total (BMES)</strong></td>
                                    <td class="trend-metric-td">Total Input</td>
                                    @foreach (int ci in weeklyColumnIndexes)
                                    {
                                        <td class="@(ci == trendFirstColumnIndex ? "trend-period-start" : ColBoundaryClass(ci))">@FormatTrendNumber(GetBmesTotalInput(ci))</td>
                                    }
                                </tr>
                                <tr class="trend-total-row">
                                    <td class="trend-metric-td">Total FCOST</td>
                                    @foreach (int ci in weeklyColumnIndexes)
                                    {
                                        <td class="@(ci == trendFirstColumnIndex ? "trend-period-start" : ColBoundaryClass(ci))">@FormatTrendCurrency(GetBmesTotalCost(ci))</td>
                                    }
                                </tr>
                                <tr class="trend-total-row">
                                    <td class="trend-metric-td">TOTAL RATE</td>
                                    @foreach (int ci in weeklyColumnIndexes)
                                    {
                                        <td class="@(ci == trendFirstColumnIndex ? "trend-period-start" : ColBoundaryClass(ci))">@FormatTrendRate(GetBmesTotalRate(ci))</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @if (IsTrendReportRoute && !ShowAllPeriodColumns)
    {
        @if (!string.IsNullOrWhiteSpace(_rawBreakdownError))
        {
            <div class="alert alert-warning mt-3 mb-0 small">@_rawBreakdownError</div>
        }
        @if (_rawMaterialBreakdown is not null)
        {
            var rawBreakdownRows = BuildRawBreakdownViewRows();
            int rawBreakdownColSpan = 4 + _rawMaterialBreakdown.Periods.Count;

            <div class="card shadow-sm mt-3 fcost-breakdown-card">
                <div class="card-header small fw-semibold d-flex align-items-center gap-2 flex-wrap">
                    <span>FCOST Raw Material Breakdown</span>
                    <span class="text-muted" style="font-size:11px;">
                        Network DB @_rawMaterialBreakdown.SourceTable,
                        @_rawMaterialBreakdown.Rows.Count.ToString("N0", CultureInfo.InvariantCulture) raw material row(s),
                        Display @_fcostCurrencyMode
                    </span>
                    <div class="fcost-breakdown-actions">
                        <button type="button"
                                class="btn btn-outline-secondary btn-sm"
                                @onclick="ExpandAllRawBreakdownRows"
                                disabled="@(_rawMaterialBreakdown.Rows.Count == 0)">
                            Expand All
                        </button>
                        <button type="button"
                                class="btn btn-outline-secondary btn-sm"
                                @onclick="CollapseAllRawBreakdownRows"
                                disabled="@(_rawMaterialBreakdown.Rows.Count == 0)">
                            Collapse
                        </button>
                        <button type="button"
                                class="btn btn-outline-success btn-sm"
                                @onclick="ExportRawBreakdownExcelAsync"
                                disabled="@(_isExportingRawBreakdownExcel || _rawMaterialBreakdown.Rows.Count == 0)">
                            @if (_isExportingRawBreakdownExcel)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                <span>Exporting...</span>
                            }
                            else
                            {
                                <span>Export Excel</span>
                            }
                        </button>
                    </div>
                    <div class="fcost-currency-tools fcost-breakdown-currency-tools">
                        <label>
                            <span>Display</span>
                            <select class="form-select form-select-sm fcost-currency-select"
                                    value="@_fcostCurrencyMode"
                                    @onchange="SetFCostCurrencyMode">
                                <option value="@CurrencyVnd">VND</option>
                                <option value="@CurrencyUsd">USD</option>
                                <option value="@CurrencyKrw">KRW</option>
                            </select>
                        </label>
                        <span class="fcost-rate-source">@FormatExchangeRateSummary()</span>
                        @if (!string.IsNullOrWhiteSpace(SelectedCurrencyWarning))
                        {
                            <span class="fcost-currency-warning">@SelectedCurrencyWarning</span>
                        }
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(_rawMaterialBreakdown.WarningMessage))
                {
                    <div class="alert alert-warning m-2 mb-0 small">@_rawMaterialBreakdown.WarningMessage</div>
                }
                <div class="card-body p-0">
                    <div style="overflow-x:auto;">
                        <table class="fcost-breakdown-table">
                            <thead>
                                <tr>
                                    <th class="breakdown-group-th">Model Group</th>
                                    <th class="breakdown-model-th">Model</th>
                                    <th class="breakdown-material-th">Raw Material</th>
                                    <th class="breakdown-price-th">
                                        <div>Unit Price (DB)</div>
                                        <div class="breakdown-rate-hint">VND / USD / KRW</div>
                                    </th>
                                    @foreach (var period in _rawMaterialBreakdown.Periods)
                                    {
                                        <th>
                                            <div>@period.Header</div>
                                            @if (!string.IsNullOrWhiteSpace(FormatPeriodExchangeRate(period)))
                                            {
                                                <div class="breakdown-rate-hint">@FormatPeriodExchangeRate(period)</div>
                                            }
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @if (_rawMaterialBreakdown.Rows.Count == 0)
                                {
                                    <tr>
                                        <td colspan="@rawBreakdownColSpan" class="text-center text-muted py-3">
                                            No FCOST raw material data for selected model groups.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var row in rawBreakdownRows)
                                    {
                                        <tr class="@row.CssClass">
                                            <td class="breakdown-group-td">@row.GroupName</td>
                                            <td class="breakdown-model-td">@row.ModelName</td>
                                            <td class="breakdown-material-td">
                                                <div class="@($"breakdown-tree-label depth-{row.Depth}")">
                                                    @if (row.IsExpandable)
                                                    {
                                                        <button type="button"
                                                                class="breakdown-expand-btn"
                                                                title="@(row.IsExpanded ? "Collapse" : "Expand")"
                                                                aria-label="@(row.IsExpanded ? "Collapse row" : "Expand row")"
                                                                @onclick="() => ToggleRawBreakdownRow(row.RowId)">
                                                            @(row.IsExpanded ? "-" : "+")
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <span class="breakdown-expand-spacer"></span>
                                                    }
                                                    <span>
                                                        <span class="fw-semibold">@row.MaterialName</span>
                                                        @if (!string.IsNullOrWhiteSpace(row.MaterialCode))
                                                        {
                                                            <span class="d-block font-monospace text-muted" style="font-size:10px;">@row.MaterialCode</span>
                                                        }
                                                    </span>
                                                </div>
                                            </td>
                                            <td class="breakdown-price-td">@row.UnitPriceText</td>
                                            @foreach (var period in _rawMaterialBreakdown.Periods)
                                            {
                                                decimal value = row.FCostByPeriod.GetValueOrDefault(period.Key);
                                                decimal qty = row.EquivalentQtyByPeriod.GetValueOrDefault(period.Key);
                                                row.PriceByPeriod.TryGetValue(period.Key, out var price);
                                                string qtyText = FormatBreakdownQty(qty, price);
                                                <td class="@(value == 0 ? "zero" : "")">
                                                    <div class="breakdown-amount-qty">
                                                        <span class="breakdown-amount">@FormatDisplayCurrency(value, period)</span>
                                                        <span class="breakdown-qty">@qtyText</span>
                                                    </div>
                                                </td>
                                            }
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }

    @if (ShowFCostWeeklyReport)
    {
    <div class="card shadow-sm mt-3 fcost-weekly-card">
        <div class="card-header small fw-semibold d-flex align-items-center gap-2">
            <span>@(ShowAllPeriodColumns ? "Weekly Report (전체)" : "Weekly Report")</span>
                <span class="text-muted" style="font-size:11px;">@(ShowAllPeriodColumns ? "목표 불량률 (Period 선택 전체 기간)" : "목표 불량률 (WEEK: 4주 내림차순, MONTH: 3달 내림차순)")</span>
        </div>
        <div class="card-body p-0">
            <div style="overflow-x:auto;">
                <table class="fcost-weekly-table">
                    <thead>
                        <tr>
                            <th class="weekly-site-th">구분</th>
                            <th class="weekly-model-th">모델</th>
                            <th class="weekly-target-th">목표 불량률</th>
                            <th class="weekly-target-th">달성률</th>
                            @foreach (int ci in weeklyColumnIndexes)
                            {
                                <th class="@ColBoundaryClass(ci)">@WeeklySummaryColumnHeader(ci)</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @for (int modelIndex = 0; modelIndex < weeklyModelRows.Count; modelIndex++)
                        {
                            var modelRow = modelIndex < weeklyModelRows.Count ? weeklyModelRows[modelIndex] : null;

                            <tr class="weekly-model-row">
                                @if (modelIndex == 0)
                                {
                                    <td class="weekly-site-td" rowspan="@weeklySummaryRowSpan">GN</td>
                                }
                                <td class="weekly-model-td">
                                    @if (modelRow is null)
                                    {
                                        <span class="zero">-</span>
                                    }
                                else
                                {
                                    <strong>@modelRow.ModelName</strong>
                                }
                            </td>
                            <td class="weekly-target-td weekly-model-target-td">
                                @if (modelRow is null)
                                {
                                    <span class="zero">-</span>
                                }
                                else
                                {
                                    <input class="weekly-model-target-input"
                                           type="text"
                                           inputmode="numeric"
                                           value="@GetWeeklyModelTargetRateInput(modelRow.ModelName)"
                                           @oninput="@((ChangeEventArgs e) => SetWeeklyModelTargetRate(modelRow.ModelName, e))" />
                                }
                            </td>
                            <td class="weekly-target-td weekly-model-achievement-td">
                                @if (modelRow is null)
                                {
                                    <span class="zero">-</span>
                                }
                                else
                                {
                                    <span class="weekly-model-achievement">@FormatWeeklyAchievement(modelRow, weeklyColumnIndexes)</span>
                                }
                            </td>
                                 @foreach (int ci in weeklyColumnIndexes)
                                 {
                                     bool hasValue = modelRow is not null &&
                                         (ValueAt(modelRow.SourceRateByCol, ci) > 0 ||
                                          ValueAt(modelRow.InputByCol, ci) > 0 ||
                                          ValueAt(modelRow.CostByCol, ci) > 0);
                                     <td class="@ColBoundaryClass(ci)">
                                         @if (!hasValue || modelRow is null)
                                         {
                                             <span class="zero">-</span>
                                         }
                                         else
                                         {
                                             double rate = ValueAt(modelRow.SourceRateByCol, ci);
                                             if (rate == 0 && ValueAt(modelRow.InputByCol, ci) > 0)
                                                 rate = ValueAt(modelRow.CostByCol, ci) / ValueAt(modelRow.InputByCol, ci) * 100.0;
                                             <span class="weekly-model-rate">@FormatWeeklyPpmFromRate(rate)</span>
                                         }
                                     </td>
                                 }
                            </tr>
                        }
                        <tr class="weekly-total-row">
                            <td class="weekly-total-label" colspan="3"><strong>TOTAL 불량률</strong></td>
                            @for (int i = 0; i < weeklyColumnIndexes.Count; i++)
                            {
                                double v = weeklyTotalRates[i];
                                <td class="@(v == 0 ? "zero" : "") @ColBoundaryClass(weeklyColumnIndexes[i])">@FormatWeeklyPpmFromRate(v)</td>
                            }
                        </tr>
                    </tbody>
                </table>
            </div>
            @if (ShowWeeklyActionItems)
            {
                <div class="fcost-weekly-config">
                    <label class="fcost-weekly-list-editor">
                        <span>주간 항목</span>
                        <textarea class="form-control form-control-sm" rows="2" @bind="_weeklyActionItemsText"></textarea>
                    </label>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <button class="btn btn-primary btn-sm" @onclick="SaveWeeklyReportSettings">저장</button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="ResetWeeklyReportSettings">초기화</button>
                        @if (!string.IsNullOrWhiteSpace(_weeklySettingsStatus))
                        {
                            <span class="small text-muted">@_weeklySettingsStatus</span>
                        }
                    </div>
                    @if (WeeklyActionItems.Count > 0)
                    {
                        <div class="fcost-weekly-saved-list">
                            @foreach (string item in WeeklyActionItems)
                            {
                                <div><span class="weekly-list-bullet"></span> @item</div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
    }
}

<!-- Model / Sub Group roll-up (sums of Input + F-Cost across matching Materials) -->
@if (!IsTrendReportRoute && ShowRegularFCostDetails && _report is not null && HasPeriodColumnToggles)
{
    <div class="d-flex align-items-center gap-2 flex-wrap mt-3 small">
        <span class="text-muted fw-semibold">Columns:</span>
        @if (PeriodColumnCount(FCostPeriodKind.Day) > DayColumnCollapseLimit)
        {
            <button class="btn btn-outline-secondary btn-sm py-0" @onclick="ToggleDayColumns">
                Day @VisiblePeriodColumnCount(FCostPeriodKind.Day)/@PeriodColumnCount(FCostPeriodKind.Day)
                @(_showAllDayColumns ? "Fold" : "Expand")
            </button>
        }
        @if (PeriodColumnCount(FCostPeriodKind.Week) > WeekColumnCollapseLimit)
        {
            <button class="btn btn-outline-secondary btn-sm py-0" @onclick="ToggleWeekColumns">
                Week @VisiblePeriodColumnCount(FCostPeriodKind.Week)/@PeriodColumnCount(FCostPeriodKind.Week)
                @(_showAllWeekColumns ? "Fold" : "Expand")
            </button>
        }
        @if (PeriodColumnCount(FCostPeriodKind.Month) > MonthColumnCollapseLimit)
        {
            <button class="btn btn-outline-secondary btn-sm py-0" @onclick="ToggleMonthColumns">
                Month @VisiblePeriodColumnCount(FCostPeriodKind.Month)/@PeriodColumnCount(FCostPeriodKind.Month)
                @(_showAllMonthColumns ? "Fold" : "Expand")
            </button>
        }
    </div>
}

@if (!IsTrendReportRoute && ShowRegularFCostDetails && _report is not null && (_report.SubGroups.Count > 0 || _report.Total is not null))
{
    var subColumnIndexes = VisibleFCostColumnIndexes();
    <div class="card shadow-sm mt-3">
        <div class="card-header small fw-semibold d-flex align-items-center gap-2">
            <span>Model / Sub Group Summary - Input / F-Cost / 불량률%</span>
            <span class="text-muted" style="font-size:11px;">
                @_report.SubGroups.Count sub group bucket(s), @_report.UnmappedMaterials.Count unmapped
                sorted by previous-week 불량률
            </span>
        </div>
        <div class="card-body p-0">
            <div style="overflow-x:auto;">
                <table class="fcost-table">
                    <thead>
                        <tr>
                            <th class="label-th" style="width:260px;">Model / Building / Line</th>
                            <th class="label-th" style="width:100px;">Type</th>
                            @foreach (int ci in subColumnIndexes)
                            {
                                <th class="@ColBoundaryClass(ci)">@_report.ColumnHeaders[ci]</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int sgRows = VisibleRowCount;
                            bool sgLabelOnInput = _showInput;
                            bool sgLabelOnCost  = !_showInput && _showCost;
                            bool sgLabelOnRate  = !_showInput && !_showCost && _showRate;
                        }
                        @* Total row ??recomputed from the SubGroup sums (same
                           helper feeds the bottom per-Material table's Total row
                           below, so top + bottom always agree). _report.Total
                           from BMES often misses INAMT and would render all
                           "-"; the sum-of-subgroups never has that gap. *@
                        @if (sgRows > 0)
                        {
                            string totalLbl = "Total";
                            int N = subColumnIndexes.Count;
                            var (totalInput, totalCost) = ComputeSubGroupTotals(subColumnIndexes);

                            @if (_showInput)
                            {
                                <tr class="fcost-row-total">
                                    @if (sgLabelOnInput)
                                    {
                                        <td class="label-td" rowspan="@sgRows"><strong>@totalLbl</strong></td>
                                    }
                                    <td class="label-td"><span class="ztype-badge">INPUT</span></td>
                                    @for (int i = 0; i < N; i++)
                                    {
                                        double v = totalInput[i];
                                        <td class="@(v == 0 ? "zero" : "") @ColBoundaryClass(subColumnIndexes[i])">@FormatNum(v)</td>
                                    }
                                </tr>
                            }
                            @if (_showCost)
                            {
                                <tr class="fcost-row-total">
                                    @if (sgLabelOnCost)
                                    {
                                        <td class="label-td" rowspan="@sgRows"><strong>@totalLbl</strong></td>
                                    }
                                    <td class="label-td"><span class="ztype-badge">F-COST</span></td>
                                    @for (int i = 0; i < N; i++)
                                    {
                                        double v = totalCost[i];
                                        <td class="@(v == 0 ? "zero" : "") @ColBoundaryClass(subColumnIndexes[i])">@FormatNum(v)</td>
                                    }
                                </tr>
                            }
                            @if (_showRate)
                            {
                                <tr class="fcost-row-total">
                                    @if (sgLabelOnRate)
                                    {
                                        <td class="label-td" rowspan="@sgRows"><strong>@totalLbl</strong></td>
                                    }
                                    <td class="label-td"><span class="ztype-badge">RATE %</span></td>
                                    @for (int i = 0; i < N; i++)
                                    {
                                        // Weighted rate: 誇cost / 誇input * 100. 0 if input=0.
                                        double v = totalInput[i] > 0
                                            ? totalCost[i] / totalInput[i] * 100.0
                                            : 0;
                                        <td class="@(v == 0 ? "zero" : "") @ColBoundaryClass(subColumnIndexes[i])">@FormatRate(v)</td>
                                    }
                                </tr>
                            }
                        }
                        @* Mid ??Sub1 ??Sub2 expand/collapse hierarchy. Mid rows are always
                           visible; Sub rows render only when their ancestor is expanded.
                           InputByCol/CostByCol on parent rows are sums of leaf descendants. *@
                        @{
                            var hierarchyRows = BuildFCostHierarchy();
                            var fcostById     = hierarchyRows.ToDictionary(r => r.RowId);
                            var fcostHasKids  = hierarchyRows
                                .Where(r => r.ParentId is not null)
                                .Select(r => r.ParentId!)
                                .ToHashSet(StringComparer.Ordinal);
                        }
                        @foreach (var row in hierarchyRows.Where(r => IsFCostRowVisible(r, fcostById)))
                        {
                            if (sgRows == 0) { continue; }
                            int    padPx     = 8 + row.Depth * 16;
                            bool   canExp    = fcostHasKids.Contains(row.RowId);
                            bool   expanded  = IsHierarchyRowExpanded(_expandedFCostRows, row.RowId);
                            string capturedId = row.RowId;
                            string rowCls    = row.Depth switch
                            {
                                0 => "fcost-row-mid",
                                1 => "fcost-row-sub1",
                                _ => "fcost-row-sub2"
                            };
                            @if (_showInput)
                            {
                                <tr class="@($"{rowCls} fcost-row-input")">
                                    @if (sgLabelOnInput)
                                    {
                                        <td class="label-td" rowspan="@sgRows"
                                            style="padding-left: @(padPx)px; cursor: @(canExp ? "pointer" : "default");"
                                            @onclick="@(() => { if (canExp) ToggleFCostRow(capturedId); })">
                                            @if (canExp)
                                            { <span class="fcost-tog">@(expanded ? "[-]" : "[+]")</span> }
                                            else
                                            { <span class="fcost-tog fcost-tog-blank"></span> }
                                            <span class="hier-level-badge">@FCostLevelLabel(row, fcostHasKids)</span>
                                            <strong class="ms-1">@row.Display</strong>
                                        </td>
                                    }
                                    <td class="label-td"><span class="ztype-badge">INPUT</span></td>
                                    @foreach (int ci in subColumnIndexes)
                                    {
                                        double v = ValueAt(row.InputByCol, ci);
                                        <td class="@(v == 0 ? "zero" : "") @ColBoundaryClass(ci, oneBased: false)">@FormatNum(v)</td>
                                    }
                                </tr>
                            }
                            @if (_showCost)
                            {
                                <tr class="@($"{rowCls} fcost-row-cost")">
                                    @if (sgLabelOnCost)
                                    {
                                        <td class="label-td" rowspan="@sgRows"
                                            style="padding-left: @(padPx)px; cursor: @(canExp ? "pointer" : "default");"
                                            @onclick="@(() => { if (canExp) ToggleFCostRow(capturedId); })">
                                            @if (canExp)
                                            { <span class="fcost-tog">@(expanded ? "[-]" : "[+]")</span> }
                                            else
                                            { <span class="fcost-tog fcost-tog-blank"></span> }
                                            <span class="hier-level-badge">@FCostLevelLabel(row, fcostHasKids)</span>
                                            <strong class="ms-1">@row.Display</strong>
                                        </td>
                                    }
                                    <td class="label-td"><span class="ztype-badge">F-COST</span></td>
                                    @foreach (int ci in subColumnIndexes)
                                    {
                                        double v = ValueAt(row.CostByCol, ci);
                                        <td class="@(v == 0 ? "zero" : "") @ColBoundaryClass(ci, oneBased: false)">@FormatNum(v)</td>
                                    }
                                </tr>
                            }
                            @if (_showRate)
                            {
                                <tr class="@($"{rowCls} fcost-row-rate")">
                                    @if (sgLabelOnRate)
                                    {
                                        <td class="label-td" rowspan="@sgRows"
                                            style="padding-left: @(padPx)px; cursor: @(canExp ? "pointer" : "default");"
                                            @onclick="@(() => { if (canExp) ToggleFCostRow(capturedId); })">
                                            @if (canExp)
                                            { <span class="fcost-tog">@(expanded ? "[-]" : "[+]")</span> }
                                            else
                                            { <span class="fcost-tog fcost-tog-blank"></span> }
                                            <span class="hier-level-badge">@FCostLevelLabel(row, fcostHasKids)</span>
                                            <strong class="ms-1">@row.Display</strong>
                                        </td>
                                    }
                                    <td class="label-td"><span class="ztype-badge">RATE %</span></td>
                                    @{ var rate = row.RateByCol; }
                                    @foreach (int ci in subColumnIndexes)
                                    {
                                        double v = ValueAt(rate, ci);
                                        <td class="@(v == 0 ? "zero" : "") @ColBoundaryClass(ci, oneBased: false)">@FormatRate(v)</td>
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            @if (_report.UnmappedMaterials.Count > 0)
            {
                <div class="alert alert-warning small m-3 mb-0">
                    <strong>Unmapped (@_report.UnmappedMaterials.Count):</strong>
                    Materials whose <code>MatnrTx_ModNoTx</code> (or fallback <code>MatnrTx_VeridTx</code>)
                    didn't match any LineShift in the saved ModelGroups ??                    @string.Join(", ", _report.UnmappedMaterials.Take(10).Select(m => m.DisplayName))
                    @(_report.UnmappedMaterials.Count > 10 ? $" ??(+{_report.UnmappedMaterials.Count - 10})" : "")
                    <a class="btn btn-sm btn-outline-dark ms-2 py-0"
                       href="@BuildUnmappedModelGroupUrl(_report.UnmappedMaterials)"
                       target="_blank"
                       rel="noopener">
                        Open Model Group for these
                    </a>
                </div>
            }
        </div>
    </div>
}

<!-- Total + per-Material table -->
@if (!IsTrendReportRoute && ShowRegularFCostDetails && _report is not null)
{
    var materialColumnIndexes = VisibleFCostColumnIndexes();

    <div class="card shadow-sm mt-3">
        <div class="card-header small fw-semibold d-flex align-items-center gap-2">
            <span>F-Cost Query Date @_report.QueryDate</span>
            <span class="text-muted" style="font-size:11px;">
                @_report.Materials.Count materials / @_report.TotalRows rows
            </span>
        </div>
        <div class="card-body p-0">
            <div style="overflow-x:auto;">
                <table class="fcost-table">
                    <thead>
                        <tr>
                            <th class="label-th" style="width:280px;">모델</th>
                            <th class="label-th" style="width:100px;">Type</th>
                            @foreach (int ci in materialColumnIndexes)
                            {
                                <th class="@ColBoundaryClass(ci)">@_report.ColumnHeaders[ci]</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int matRows = VisibleRowCount;
                            bool matLabelOnInput = _showInput;
                            bool matLabelOnCost  = !_showInput && _showCost;
                            bool matLabelOnRate  = !_showInput && !_showCost && _showRate;
                        }
                        @* Bottom Total ??same sum-of-subgroups helper as the
                           top SubGroup Summary uses, so the two Total rows
                           always show identical numbers. *@
                        @if (matRows > 0 && _report.SubGroups.Count > 0)
                        {
                            int Nb = materialColumnIndexes.Count;
                            var (botInput, botCost) = ComputeSubGroupTotals(materialColumnIndexes);
                            string botLbl = _report.Total?.DisplayName is { Length: > 0 } d2 ? d2 : "Total";

                            @if (_showInput)
                            {
                                <tr class="fcost-row-total">
                                    @if (matLabelOnInput)
                                    {
                                        <td class="label-td" rowspan="@matRows"><strong>@botLbl</strong></td>
                                    }
                                    <td class="label-td"><span class="ztype-badge">INPUT</span></td>
                                    @for (int i = 0; i < Nb; i++)
                                    {
                                        double v = botInput[i];
                                        <td class="@(v == 0 ? "zero" : "") @ColBoundaryClass(materialColumnIndexes[i])">@FormatNum(v)</td>
                                    }
                                </tr>
                            }
                            @if (_showCost)
                            {
                                <tr class="fcost-row-total">
                                    @if (matLabelOnCost)
                                    {
                                        <td class="label-td" rowspan="@matRows"><strong>@botLbl</strong></td>
                                    }
                                    <td class="label-td"><span class="ztype-badge">F-COST</span></td>
                                    @for (int i = 0; i < Nb; i++)
                                    {
                                        double v = botCost[i];
                                        <td class="@(v == 0 ? "zero" : "") @ColBoundaryClass(materialColumnIndexes[i])">@FormatNum(v)</td>
                                    }
                                </tr>
                            }
                            @if (_showRate)
                            {
                                <tr class="fcost-row-total">
                                    @if (matLabelOnRate)
                                    {
                                        <td class="label-td" rowspan="@matRows"><strong>@botLbl</strong></td>
                                    }
                                    <td class="label-td"><span class="ztype-badge">RATE %</span></td>
                                    @for (int i = 0; i < Nb; i++)
                                    {
                                        double v = botInput[i] > 0 ? botCost[i] / botInput[i] * 100.0 : 0;
                                        <td class="@(v == 0 ? "zero" : "") @ColBoundaryClass(materialColumnIndexes[i])">@FormatRate(v)</td>
                                    }
                                </tr>
                            }
                        }
                        @foreach (var block in _report.Materials)
                        {
                            if (matRows == 0) { continue; }
                            @if (_showInput)
                            {
                                <tr class="fcost-row-input">
                                    @if (matLabelOnInput)
                                    {
                                        <td class="label-td" rowspan="@matRows">
                                            <strong>@block.DisplayName</strong>
                                            @if (!string.IsNullOrEmpty(block.ProductGroup))
                                            {
                                                <div class="text-muted" style="font-size:10px;">@block.ProductGroup</div>
                                            }
                                        </td>
                                    }
                                    <td class="label-td"><span class="ztype-badge">INPUT</span></td>
                                    @foreach (int ci in materialColumnIndexes)
                                    {
                                        double v = block.Input?.GetCol(ci + 1) ?? 0;
                                        <td class="@(v == 0 ? "zero" : "") @ColBoundaryClass(ci)">@FormatNum(v)</td>
                                    }
                                </tr>
                            }
                            @if (_showCost)
                            {
                                <tr class="fcost-row-cost">
                                    @if (matLabelOnCost)
                                    {
                                        <td class="label-td" rowspan="@matRows">
                                            <strong>@block.DisplayName</strong>
                                            @if (!string.IsNullOrEmpty(block.ProductGroup))
                                            {
                                                <div class="text-muted" style="font-size:10px;">@block.ProductGroup</div>
                                            }
                                        </td>
                                    }
                                    <td class="label-td"><span class="ztype-badge">F-COST</span></td>
                                    @foreach (int ci in materialColumnIndexes)
                                    {
                                        double v = block.Cost?.GetCol(ci + 1) ?? 0;
                                        <td class="@(v == 0 ? "zero" : "") @ColBoundaryClass(ci)">@FormatNum(v)</td>
                                    }
                                </tr>
                            }
                            @if (_showRate)
                            {
                                <tr class="fcost-row-rate">
                                    @if (matLabelOnRate)
                                    {
                                        <td class="label-td" rowspan="@matRows">
                                            <strong>@block.DisplayName</strong>
                                            @if (!string.IsNullOrEmpty(block.ProductGroup))
                                            {
                                                <div class="text-muted" style="font-size:10px;">@block.ProductGroup</div>
                                            }
                                        </td>
                                    }
                                    <td class="label-td"><span class="ztype-badge">RATE %</span></td>
                                    @foreach (int ci in materialColumnIndexes)
                                    {
                                        double input = block.Input?.GetCol(ci + 1) ?? 0;
                                        double cost = block.Cost?.GetCol(ci + 1) ?? 0;
                                        double v = input > 0 ? cost / input * 100.0 : 0;
                                        <td class="@(v == 0 ? "zero" : "") @ColBoundaryClass(ci)">@FormatRate(v)</td>
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
@if (!string.IsNullOrEmpty(_reportError))
{
    <div class="alert alert-danger mt-3 py-2 small">@_reportError</div>
}

