    private string FormatDisplayCurrency(decimal v, BmesFcostRawBreakdownPeriod period)
    {
        if (v == 0)
            return "-";

        decimal? converted = ConvertDisplayCurrency(v, period.Key);
        if (converted is null)
            return "-";

        string format = string.Equals(_fcostCurrencyMode, CurrencyUsd, StringComparison.Ordinal)
            ? "N2"
            : "N0";
        return _fcostCurrencyMode + " " + converted.Value.ToString(format, CultureInfo.InvariantCulture);
    }

    private decimal? ConvertDisplayCurrency(decimal vndValue, string periodKey)
    {
        BmesFcostExchangeRate? rate = GetExchangeRate(periodKey);
        decimal? krwPerUsd = BmesAppliedKrwPerUsd(rate?.KrwPerUsd);
        decimal? krwPerVnd = BmesAppliedKrwPerVnd(rate?.KrwPerVnd);
        return _fcostCurrencyMode switch
        {
            CurrencyUsd => krwPerUsd is > 0 && krwPerVnd is > 0
                ? vndValue * krwPerVnd.Value / krwPerUsd.Value
                : null,
            CurrencyKrw => krwPerVnd is > 0 ? vndValue * krwPerVnd.Value : null,
            _ => vndValue,
        };
    }

    private BmesFcostExchangeRate? GetExchangeRate(string periodKey)
        => _rawMaterialBreakdown?.ExchangeRates.FirstOrDefault(r =>
            string.Equals(r.PeriodKey, periodKey, StringComparison.Ordinal));

    private string FormatExchangeRateSummary()
    {
        if (_rawMaterialBreakdown?.ExchangeRates is not { Count: > 0 } rates)
            return "Exchange rates: none";

        var parts = rates
            .GroupBy(r => r.StandardDate.Date)
            .OrderByDescending(g => g.Key)
            .Select(g =>
            {
                var rate = g.First();
                return $"{rate.StandardDate:yyyy-MM-dd} {FormatExchangeRatePair(rate)}";
            })
            .ToList();

        return "Exchange rates from BMES dbo.TCURR: " + string.Join("; ", parts);
    }

    private string FormatPeriodExchangeRate(BmesFcostRawBreakdownPeriod period)
    {
        if (string.Equals(_fcostCurrencyMode, CurrencyVnd, StringComparison.Ordinal))
            return string.Empty;

        BmesFcostExchangeRate? rate = GetExchangeRate(period.Key);
        if (rate is null)
            return "Rate missing";

        return _fcostCurrencyMode switch
        {
            CurrencyUsd => rate.KrwPerUsd is > 0 && rate.KrwPerVnd is > 0
                ? $"{rate.StandardDate:MM-dd} {FormatKrwUsd(rate.KrwPerUsd)} / {FormatKrwVnd(rate.KrwPerVnd)}"
                : "Rate missing",
            CurrencyKrw => rate.KrwPerVnd is > 0
                ? $"{rate.StandardDate:MM-dd} {FormatKrwVnd(rate.KrwPerVnd)}"
                : "Rate missing",
            _ => string.Empty,
        };
    }

    private static string FormatExchangeRatePair(BmesFcostExchangeRate rate)
        => $"{FormatKrwUsd(rate.KrwPerUsd)}, {FormatKrwVnd(rate.KrwPerVnd)}";

    private static string FormatKrwUsd(decimal? rate)
        => BmesAppliedKrwPerUsd(rate) is { } applied
            ? "KRW/USD " + applied.ToString("N2", CultureInfo.InvariantCulture)
            : "KRW/USD -";

    private static string FormatKrwVnd(decimal? rate)
        => BmesAppliedKrwPerVnd(rate) is { } applied
            ? "KRW/VND " + applied.ToString("N2", CultureInfo.InvariantCulture)
            : "KRW/VND -";

    private static decimal? BmesAppliedKrwPerUsd(decimal? rate)
        => rate is > 0
            ? Math.Round(rate.Value, 2, MidpointRounding.AwayFromZero)
            : null;

    private static decimal? BmesAppliedKrwPerVnd(decimal? rate)
        => rate is > 0
            ? Math.Round(rate.Value, 2, MidpointRounding.AwayFromZero)
            : null;

