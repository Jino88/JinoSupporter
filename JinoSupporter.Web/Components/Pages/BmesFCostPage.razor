    private double ResolveLatestWeeklyRate(FCostWeeklyModelRow modelRow, IReadOnlyList<int> columnIndexes)
    {
        var columns = _report?.Columns ?? Array.Empty<FCostColumnMeta>();
        foreach (int ci in columnIndexes)
        {
            if (ci < 0 || ci >= columns.Count) continue;
            if (columns[ci].Kind != FCostPeriodKind.Week) continue;

            double rate = ValueAt(modelRow.SourceRateByCol, ci);
            if (rate > 0)
                return rate;
        }

        return 0;
    }

