    private string SelectedCurrencyWarning => _fcostCurrencyMode switch
    {
        CurrencyUsd when HasMissingExchangeRate(requireUsd: true) => "BMES exchange rate missing for one or more periods.",
        CurrencyKrw when HasMissingExchangeRate(requireUsd: false) => "BMES KRW/VND exchange rate missing for one or more periods.",
        _ => string.Empty,
    };

    private bool HasMissingExchangeRate(bool requireUsd)
    {
        if (_rawMaterialBreakdown?.Periods is not { Count: > 0 } periods)
            return false;

        foreach (var period in periods)
        {
            BmesFcostExchangeRate? rate = GetExchangeRate(period.Key);
            if (rate?.KrwPerVnd is not > 0)
                return true;
            if (requireUsd && rate.KrwPerUsd is not > 0)
                return true;
        }

        return false;
    }

    private void LoadWeeklyReportSettings()
    {
        _weeklyBaselineRate = ReadWeeklyDoubleSetting(WeeklyBaselineRateSettingKey, DefaultWeeklyBaselineRate);
        _weeklyFirstTargetRate = ReadWeeklyDoubleSetting(WeeklyFirstTargetRateSettingKey, DefaultWeeklyFirstTargetRate);
        _weeklySecondTargetRate = ReadWeeklyDoubleSetting(WeeklySecondTargetRateSettingKey, DefaultWeeklySecondTargetRate);
        _weeklyModelTargetRates = ReadWeeklyModelTargetRatesSetting(WeeklyModelTargetRatesSettingKey);
        _weeklyActionItemsText = Repo.GetSetting(WeeklyActionItemsSettingKey) ?? DefaultWeeklyActionItemsText;
    }

    private double ReadWeeklyDoubleSetting(string key, double defaultValue)
    {
        string? value = Repo.GetSetting(key);
        if (double.TryParse(value, NumberStyles.Float, CultureInfo.InvariantCulture, out double invariantValue))
            return invariantValue;
        if (double.TryParse(value, NumberStyles.Float, CultureInfo.CurrentCulture, out double localValue))
            return localValue;
        return defaultValue;
    }

    private Dictionary<string, double> ReadWeeklyModelTargetRatesSetting(string key)
    {
        string? value = Repo.GetSetting(key);
        if (string.IsNullOrWhiteSpace(value))
            return new Dictionary<string, double>(StringComparer.Ordinal);

        try
        {
            Dictionary<string, double>? loaded = JsonSerializer.Deserialize<Dictionary<string, double>>(value);
            if (loaded is null)
                return new Dictionary<string, double>(StringComparer.Ordinal);

            var normalized = new Dictionary<string, double>(StringComparer.Ordinal);
            foreach (var kvp in loaded)
            {
                if (!string.IsNullOrWhiteSpace(kvp.Key))
                    normalized[kvp.Key.Trim()] = kvp.Value;
            }

            return normalized;
        }
        catch
        {
            return new Dictionary<string, double>(StringComparer.Ordinal);
        }
    }

    private string GetWeeklyModelTargetRateInput(string? modelName)
    {
        if (string.IsNullOrWhiteSpace(modelName))
            return string.Empty;

        return _weeklyModelTargetRates.TryGetValue(modelName.Trim(), out double rate)
            ? Math.Truncate(rate).ToString("N0", CultureInfo.InvariantCulture)
            : string.Empty;
    }

    private double GetWeeklyModelTargetRate(string? modelName)
    {
        if (string.IsNullOrWhiteSpace(modelName))
            return 0;

        return _weeklyModelTargetRates.TryGetValue(modelName.Trim(), out double rate)
            ? rate
            : 0;
    }

    private void SetWeeklyModelTargetRate(string? modelName, ChangeEventArgs e)
    {
        if (string.IsNullOrWhiteSpace(modelName))
            return;

        if (TryParseModelTargetRate(Convert.ToString(e.Value), out double rate))
            _weeklyModelTargetRates[modelName.Trim()] = Math.Truncate(rate);
        else
            _weeklyModelTargetRates.Remove(modelName.Trim());

        SaveWeeklyReportSettings();
    }

    private static bool TryParseModelTargetRate(string? value, out double rate)
    {
        rate = 0;
        if (string.IsNullOrWhiteSpace(value))
            return false;

        string normalized = value.Replace(",", string.Empty, StringComparison.Ordinal);
        return double.TryParse(normalized, NumberStyles.Float, CultureInfo.InvariantCulture, out rate) ||
               double.TryParse(normalized, NumberStyles.Float, CultureInfo.CurrentCulture, out rate);
    }

    private void SaveWeeklyReportSettings()
    {
        Repo.SetSetting(WeeklyBaselineRateSettingKey, _weeklyBaselineRate.ToString(CultureInfo.InvariantCulture));
        Repo.SetSetting(WeeklyFirstTargetRateSettingKey, _weeklyFirstTargetRate.ToString(CultureInfo.InvariantCulture));
        Repo.SetSetting(WeeklySecondTargetRateSettingKey, _weeklySecondTargetRate.ToString(CultureInfo.InvariantCulture));
        Repo.SetSetting(WeeklyModelTargetRatesSettingKey, JsonSerializer.Serialize(_weeklyModelTargetRates));
        Repo.SetSetting(WeeklyActionItemsSettingKey, _weeklyActionItemsText ?? string.Empty);
        _weeklySettingsStatus = "Saved.";
    }

    private void ResetWeeklyReportSettings()
    {
        _weeklyBaselineRate = DefaultWeeklyBaselineRate;
        _weeklyFirstTargetRate = DefaultWeeklyFirstTargetRate;
        _weeklySecondTargetRate = DefaultWeeklySecondTargetRate;
        _weeklyModelTargetRates.Clear();
        _weeklyActionItemsText = DefaultWeeklyActionItemsText;
        SaveWeeklyReportSettings();
        _weeklySettingsStatus = "Reset.";
    }

    private bool HasPeriodColumnToggles =>
        PeriodColumnCount(FCostPeriodKind.Day) > DayColumnCollapseLimit ||
        PeriodColumnCount(FCostPeriodKind.Week) > WeekColumnCollapseLimit ||
        PeriodColumnCount(FCostPeriodKind.Month) > MonthColumnCollapseLimit;

    private void ToggleDayColumns() => _showAllDayColumns = !_showAllDayColumns;
    private void ToggleWeekColumns() => _showAllWeekColumns = !_showAllWeekColumns;
    private void ToggleMonthColumns() => _showAllMonthColumns = !_showAllMonthColumns;

    private int PeriodColumnCount(FCostPeriodKind kind)
        => _report?.Columns.Count(c => c.Kind == kind) ?? 0;

    private int VisiblePeriodColumnCount(FCostPeriodKind kind)
    {
        int total = PeriodColumnCount(kind);
        int limit = PeriodCollapseLimit(kind);
        return IsPeriodExpanded(kind) || total <= limit ? total : limit;
    }

    private List<int> VisibleFCostColumnIndexes()
    {
        if (_report is null) return new List<int>();
        if (_report.Columns.Count == 0)
            return Enumerable.Range(0, _report.ColumnHeaders.Count).ToList();

        int dayTotal = PeriodColumnCount(FCostPeriodKind.Day);
        int weekTotal = PeriodColumnCount(FCostPeriodKind.Week);
        int monthTotal = PeriodColumnCount(FCostPeriodKind.Month);
        int daySeen = 0;
        int weekSeen = 0;
        int monthSeen = 0;
        var indexes = new List<int>(_report.Columns.Count);

        for (int i = 0; i < _report.Columns.Count; i++)
        {
            var kind = _report.Columns[i].Kind;
            bool show = kind switch
            {
                FCostPeriodKind.Day => ShouldShowPeriodColumn(kind, ++daySeen, dayTotal),
                FCostPeriodKind.Week => ShouldShowPeriodColumn(kind, ++weekSeen, weekTotal),
                FCostPeriodKind.Month => ShouldShowPeriodColumn(kind, ++monthSeen, monthTotal),
                _ => true,
            };
            if (show) indexes.Add(i);
        }

        return indexes;
    }

    private static int PeriodCollapseLimit(FCostPeriodKind kind) => kind switch
    {
        FCostPeriodKind.Day => DayColumnCollapseLimit,
        FCostPeriodKind.Week => WeekColumnCollapseLimit,
        FCostPeriodKind.Month => MonthColumnCollapseLimit,
        _ => int.MaxValue,
    };

    // A static snapshot has no Expand button, so export mode always shows every column.
    private bool IsPeriodExpanded(FCostPeriodKind kind) => ExportMode || kind switch
    {
        FCostPeriodKind.Day => _showAllDayColumns,
        FCostPeriodKind.Week => _showAllWeekColumns,
        FCostPeriodKind.Month => _showAllMonthColumns,
        _ => true,
    };

    private bool ShouldShowPeriodColumn(FCostPeriodKind kind, int seen, int total)
    {
        int limit = PeriodCollapseLimit(kind);
        return total <= limit || IsPeriodExpanded(kind) || seen <= limit;
    }

    private void ToggleFCostRow(string rowId)
    {
        if (!_expandedFCostRows.Remove(rowId)) _expandedFCostRows.Add(rowId);
    }

    private void ToggleTrendRow(string rowId)
    {
        if (!_expandedTrendRows.Remove(rowId)) _expandedTrendRows.Add(rowId);
    }

    private void ToggleRawBreakdownRow(string rowId)
    {
        if (!_expandedRawBreakdownRows.Remove(rowId)) _expandedRawBreakdownRows.Add(rowId);
    }

    private void ExpandAllRawBreakdownRows()
    {
        if (_rawMaterialBreakdown?.Rows is not { Count: > 0 } rows)
            return;

        _expandedRawBreakdownRows.Add(RawBreakdownTotalRowId);
        foreach (var groupRows in rows.GroupBy(r => r.GroupName))
        {
            string groupName = RawBreakdownText(groupRows.Key, "Unassigned");
            _expandedRawBreakdownRows.Add(RawBreakdownGroupRowId(groupName));

            foreach (var modelRows in groupRows.GroupBy(r => r.ModelName))
            {
                string modelName = RawBreakdownText(modelRows.Key, "Unassigned");
                _expandedRawBreakdownRows.Add(RawBreakdownModelRowId(groupName, modelName));
            }
        }
    }

    private void CollapseAllRawBreakdownRows()
    {
        _expandedRawBreakdownRows.Clear();
    }

    private List<RawBreakdownViewRow> BuildRawBreakdownViewRows()
    {
        var result = new List<RawBreakdownViewRow>();
        if (_rawMaterialBreakdown is null || _rawMaterialBreakdown.Rows.Count == 0)
            return result;

        var periods = _rawMaterialBreakdown.Periods;
        bool totalExpanded = IsHierarchyRowExpanded(_expandedRawBreakdownRows, RawBreakdownTotalRowId);
        result.Add(new RawBreakdownViewRow(
            RawBreakdownTotalRowId,
            "Total",
            string.Empty,
            "Total",
            string.Empty,
            string.Empty,
            0,
            "breakdown-grand-total-row",
            true,
            totalExpanded,
            SumRawBreakdownPeriods(_rawMaterialBreakdown.Rows, periods),
            new Dictionary<string, decimal>(StringComparer.Ordinal),
            new Dictionary<string, BmesFcostRawMaterialPeriodPrice>(StringComparer.Ordinal)));

        if (!totalExpanded)
            return result;

        foreach (var groupRows in _rawMaterialBreakdown.Rows
            .GroupBy(r => RawBreakdownText(r.GroupName, "Unassigned"))
            .OrderBy(g => g.Key, StringComparer.Ordinal))
        {
            var groupList = groupRows.ToList();
            string groupName = groupRows.Key;
            string groupRowId = RawBreakdownGroupRowId(groupName);
            bool groupExpanded = IsHierarchyRowExpanded(_expandedRawBreakdownRows, groupRowId);
            result.Add(new RawBreakdownViewRow(
                groupRowId,
                groupName,
                "Total",
                "Model Group Total",
                string.Empty,
                string.Empty,
                1,
                "breakdown-total-row",
                true,
                groupExpanded,
                SumRawBreakdownPeriods(groupList, periods),
                new Dictionary<string, decimal>(StringComparer.Ordinal),
                new Dictionary<string, BmesFcostRawMaterialPeriodPrice>(StringComparer.Ordinal)));

            if (!groupExpanded)
                continue;

            foreach (var modelRows in groupList
                .GroupBy(r => RawBreakdownText(r.ModelName, "Unassigned"))
                .OrderBy(g => g.Key, StringComparer.Ordinal))
            {
                var modelList = modelRows.ToList();
                string modelName = modelRows.Key;
                string modelRowId = RawBreakdownModelRowId(groupName, modelName);
                bool modelExpanded = IsHierarchyRowExpanded(_expandedRawBreakdownRows, modelRowId);
                result.Add(new RawBreakdownViewRow(
                    modelRowId,
                    groupName,
                    modelName,
                    "Sub Total",
                    string.Empty,
                    string.Empty,
                    2,
                    "breakdown-subtotal-row",
                    true,
                    modelExpanded,
                    SumRawBreakdownPeriods(modelList, periods),
                    new Dictionary<string, decimal>(StringComparer.Ordinal),
                    new Dictionary<string, BmesFcostRawMaterialPeriodPrice>(StringComparer.Ordinal)));

                if (!modelExpanded)
                    continue;

                foreach (var row in modelList
                    .OrderByDescending(r => r.TotalFCostVnd)
                    .ThenBy(r => DisplayBreakdownName(r.MaterialName, r.MaterialCode), StringComparer.Ordinal)
                    .ThenBy(r => r.MaterialCode, StringComparer.Ordinal))
                {
                    BmesFcostRawMaterialPeriodPrice? unitPrice = PickBreakdownUnitPrice(row.PriceByPeriod, periods);
                    result.Add(new RawBreakdownViewRow(
                        $"RM::{groupName}::{modelName}::{row.MaterialCode}",
                        groupName,
                        modelName,
                        DisplayBreakdownName(row.MaterialName, row.MaterialCode),
                        row.MaterialCode,
                        FormatUnitPrice(unitPrice),
                        3,
                        "breakdown-material-row",
                        false,
                        false,
                        new Dictionary<string, decimal>(row.FCostByPeriod, StringComparer.Ordinal),
                        new Dictionary<string, decimal>(row.EquivalentQtyByPeriod, StringComparer.Ordinal),
                        new Dictionary<string, BmesFcostRawMaterialPeriodPrice>(row.PriceByPeriod, StringComparer.Ordinal)));
                }
            }
        }

        return result;
    }

    private static Dictionary<string, decimal> SumRawBreakdownPeriods(
        IEnumerable<BmesFcostRawMaterialBreakdownRow> rows,
        IReadOnlyList<BmesFcostRawBreakdownPeriod> periods)
    {
        var result = new Dictionary<string, decimal>(StringComparer.Ordinal);
        foreach (var period in periods)
            result[period.Key] = rows.Sum(r => r.FCostByPeriod.GetValueOrDefault(period.Key));
        return result;
    }

    private static string RawBreakdownGroupRowId(string groupName)
        => "RG::" + groupName;

    private static string RawBreakdownModelRowId(string groupName, string modelName)
        => "RMODEL::" + groupName + "::" + modelName;

    private static string RawBreakdownText(string value, string fallback)
        => string.IsNullOrWhiteSpace(value) ? fallback : value.Trim();

    /// <summary>One row in the SubGroup-Summary tree. <see cref="InputByCol"/> /
    /// <see cref="CostByCol"/> are the SUM of every leaf descendant under this node;
    /// <see cref="RateByCol"/> is recomputed from the sums to preserve weighting.</summary>
    private sealed record FCostHierarchyRow(
        string   RowId,
        string?  ParentId,
        string   Display,
        string   NgGroupKey,
        int      Depth,
        int      MatchedMaterialCount,
        double[] InputByCol,
        double[] CostByCol,
        double[] SourceRateByCol)
    {
        public double[] RateByCol
        {
            get
            {
                int count = Math.Max(InputByCol.Length, CostByCol.Length);
                var arr = new double[count];
                for (int i = 0; i < arr.Length; i++)
                {
                    double input = ValueAt(InputByCol, i);
                    double cost = ValueAt(CostByCol, i);
                    arr[i] = input > 0 ? cost / input * 100.0 : 0;
                }
                return arr;
            }
        }
    }

    private static string NormalizeNgWeekKey(string value)
    {
        string text = (value ?? string.Empty).Trim();
        if (text.Length == 0) return string.Empty;
        if (text.StartsWith("W:", StringComparison.Ordinal)) return text;

        string compact = text.Replace("-", string.Empty, StringComparison.Ordinal);
        return compact.Length >= 6 && compact.All(char.IsDigit)
            ? "W:" + compact[..6]
            : string.Empty;
    }

    private static string NormalizeNgMonthKey(string value)
    {
        string text = (value ?? string.Empty).Trim();
        if (text.Length == 0) return string.Empty;
        if (text.StartsWith("M:", StringComparison.Ordinal)) return text;

        string compact = text.Replace("-", string.Empty, StringComparison.Ordinal);
        return compact.Length >= 6 && compact.All(char.IsDigit)
            ? "M:" + compact[..6]
            : string.Empty;
    }

    private static string NormalizeNgDateKey(string value)
    {
        string text = (value ?? string.Empty).Trim();
        if (text.Length == 0) return string.Empty;
        if (DateTime.TryParseExact(text, "yyyyMMdd", CultureInfo.InvariantCulture, DateTimeStyles.None, out DateTime day))
            return day.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        return text;
    }

    private static double ValueAt(IReadOnlyList<double>? values, int index)
        => values is not null && index >= 0 && index < values.Count ? values[index] : 0;

    private static double ResolveWeeklyRateFromSource(double sourceRate, double input, double cost)
        => sourceRate > 0 ? sourceRate : (input > 0 ? cost / input * 100.0 : 0);

    /// <summary>Build the Mid ??Sub1 ??Sub2 hierarchy from <c>_report.SubGroups</c>.
    /// The flat leaf rows are bucketed by (GroupName, MidGroupName) for the Mid level
    /// and by the first path segment of <c>SubGroupKey</c> for Sub1. Leaves whose
    /// path is two segments or deeper emit Sub2 rows; one-segment leaves stop at Sub1
    /// (the leaf <em>is</em> the Sub1, no redundant duplicate).</summary>
    private List<FCostHierarchyRow> BuildFCostHierarchy()
    {
        var rows = new List<FCostHierarchyRow>();
        if (_report is null || _report.SubGroups.Count == 0) return rows;

        int colCount = _report.ColumnHeaders.Count;

        var byMid = _report.SubGroups
            .GroupBy(sg => new { sg.GroupName, sg.MidGroupName })
            .OrderBy(g => g.Key.GroupName,    StringComparer.Ordinal)
            .ThenBy (g => g.Key.MidGroupName, StringComparer.Ordinal);

        foreach (var midGroup in byMid)
        {
            string midRowId = $"M::{midGroup.Key.GroupName}::{midGroup.Key.MidGroupName}";
            var midInput   = new double[colCount];
            var midCost    = new double[colCount];
            var midSourceRateNumerator = new double[colCount];
            var midSourceRateInput     = new double[colCount];
            int midMatCnt  = 0;
            foreach (var sg in midGroup)
            {
                for (int i = 0; i < colCount; i++)
                {
                    midInput[i] += ValueAt(sg.InputByCol, i);
                    midCost[i]  += ValueAt(sg.CostByCol, i);
                    midSourceRateNumerator[i] += ValueAt(sg.SourceRateByCol, i) * ValueAt(sg.InputByCol, i);
                    midSourceRateInput[i]     += ValueAt(sg.InputByCol, i);
                }
                midMatCnt += sg.MatchedMaterialCount;
            }

            var midSourceRate = BuildWeightedRateFromInputs(midSourceRateNumerator, midSourceRateInput);
            rows.Add(new FCostHierarchyRow(
                RowId: midRowId, ParentId: null,
                Display: midGroup.Key.MidGroupName,
                NgGroupKey: $"{midGroup.Key.GroupName}::{midGroup.Key.MidGroupName}",
                Depth: 0,
                MatchedMaterialCount: midMatCnt,
                InputByCol: midInput, CostByCol: midCost, SourceRateByCol: midSourceRate));

            // Group leaves under this Mid by first path segment to derive Sub1.
            var bySub1 = midGroup
                .Select(sg => new { Sg = sg, Segments = ParseSubPathSegments(sg.SubGroupKey) })
                .GroupBy(x => x.Segments.Length > 0 ? x.Segments[0] : x.Sg.Display, StringComparer.Ordinal);

            foreach (var sub1Group in bySub1)
            {
                string sub1Display = sub1Group.Key;
                string sub1RowId   = $"S1::{midRowId}::{sub1Display}";

                var s1Input  = new double[colCount];
                var s1Cost   = new double[colCount];
                var s1SourceRateNumerator = new double[colCount];
                var s1SourceRateInput = new double[colCount];
                int s1MatCnt = 0;
                foreach (var x in sub1Group)
                {
                    for (int i = 0; i < colCount; i++)
                    {
                        s1Input[i] += ValueAt(x.Sg.InputByCol, i);
                        s1Cost[i]  += ValueAt(x.Sg.CostByCol, i);
                        s1SourceRateNumerator[i] += ValueAt(x.Sg.SourceRateByCol, i) * ValueAt(x.Sg.InputByCol, i);
                        s1SourceRateInput[i]     += ValueAt(x.Sg.InputByCol, i);
                    }
                    s1MatCnt += x.Sg.MatchedMaterialCount;
                }

                var s1SourceRate = BuildWeightedRateFromInputs(s1SourceRateNumerator, s1SourceRateInput);
                rows.Add(new FCostHierarchyRow(
                    RowId: sub1RowId, ParentId: midRowId,
                    Display: sub1Display,
                    NgGroupKey: $"{midGroup.Key.GroupName}::{midGroup.Key.MidGroupName}::{sub1Display}",
                    Depth: 1,
                    MatchedMaterialCount: s1MatCnt,
                    InputByCol: s1Input, CostByCol: s1Cost, SourceRateByCol: s1SourceRate));

                // Sub2+ leaves only when the path has more than one segment ??otherwise
                // the Sub1 row IS the leaf and a Sub2 row would just duplicate it.
                foreach (var x in sub1Group)
                {
                    if (x.Segments.Length <= 1) continue;
                    string leafDisplay = x.Segments[^1];
                    string leafRowId   = $"S2::{x.Sg.SubGroupKey}";
                    rows.Add(new FCostHierarchyRow(
                        RowId: leafRowId, ParentId: sub1RowId,
                        Display: leafDisplay,
                        NgGroupKey: x.Sg.SubGroupKey.Replace(" / ", "::", StringComparison.Ordinal),
                        Depth: 2,
                        MatchedMaterialCount: x.Sg.MatchedMaterialCount,
                        InputByCol: x.Sg.InputByCol, CostByCol: x.Sg.CostByCol, SourceRateByCol: x.Sg.SourceRateByCol));
                }
            }
        }
        return rows;
    }

    private static double[] BuildWeightedRateFromInputs(double[] numerator, double[] input)
    {
        int count = Math.Min(numerator.Length, input.Length);
        var rates = new double[count];
        for (int i = 0; i < count; i++)
            rates[i] = input[i] > 0 ? numerator[i] / input[i] : 0;
        return rates;
    }

    /// <summary>Extract the path portion of a SubGroupKey ("Group::Material::path")
    /// and split it on the " / " separator FCostReportService uses internally.</summary>
    private static string[] ParseSubPathSegments(string subGroupKey)
    {
        int firstSep = subGroupKey.IndexOf("::", StringComparison.Ordinal);
        if (firstSep < 0) return Array.Empty<string>();
        int secondSep = subGroupKey.IndexOf("::", firstSep + 2, StringComparison.Ordinal);
        if (secondSep < 0) return Array.Empty<string>();
        string path = subGroupKey[(secondSep + 2)..];
        if (string.IsNullOrEmpty(path)) return Array.Empty<string>();
        return path.Split(" / ", StringSplitOptions.None);
    }

    private static string FCostLevelLabel(FCostHierarchyRow row, IReadOnlySet<string> rowsWithChildren)
    {
        if (row.Depth == 0) return "Model";
        return "Sub Group";
    }

    /// <summary>
    /// Whether a hierarchy row counts as opened. The static export has no toggle to
    /// click, so every level is opened there — otherwise the exported F-COST tabs would
    /// show only the top (Mid) rows with no way to reach Sub1/Sub2.
    /// </summary>
    private bool IsHierarchyRowExpanded(HashSet<string> expandedRowIds, string rowId)
        => ExportMode || expandedRowIds.Contains(rowId);

    private bool IsFCostRowVisible(
        FCostHierarchyRow row,
        IReadOnlyDictionary<string, FCostHierarchyRow> byId)
    {
        if (ExportMode) return true;

        string? pid = row.ParentId;
        while (pid is not null)
        {
            if (!_expandedFCostRows.Contains(pid)) return false;
            pid = byId.TryGetValue(pid, out var p) ? p.ParentId : null;
        }
        return true;
    }

    /// <summary>CSS class for cells at the start of a Day / Week / Month period
    /// block so the table draws a heavier divider where the period kind changes.
    /// <paramref name="oneBased"/>=true when the caller iterates with 1..N indexing
    /// (matches FCostRow.GetCol). Returns empty for the very first column (no
    /// preceding kind to compare against) or when the period kind matches the
    /// previous column.</summary>
    private string ColBoundaryClass(int idx, bool oneBased = false)
    {
        if (_report is null) return string.Empty;
        var cols = _report.Columns;
        int zeroIdx = oneBased ? idx - 1 : idx;
        if (zeroIdx <= 0 || zeroIdx >= cols.Count) return string.Empty;
        var cur  = cols[zeroIdx].Kind;
        var prev = cols[zeroIdx - 1].Kind;
        if (cur == prev) return string.Empty;
        return cur switch
        {
            FCostPeriodKind.Day   => "col-day-start",
            FCostPeriodKind.Week  => "col-week-start",
            FCostPeriodKind.Month => "col-month-start",
            _                     => string.Empty,
        };
    }

    public async Task GenerateReportAsync(
        DateTime startDate,
        DateTime endDate,
        IProgress<string>? progress = null,
        IReadOnlyList<ModelGroupRecord>? selectedGroups = null,
        NgRateReportService.NgRateReport? sharedNgRateTrendReport = null,
        Task<NgRateReportService.NgRateReport?>? sharedNgRateTrendReportTask = null)
    {
        _reportStartDate = startDate.Date;
        _reportEndDate = endDate.Date;

        _externalProgress = progress;
        _groupOverride = selectedGroups?.ToList();
        _sharedNgRateTrendReport = sharedNgRateTrendReport;
        _sharedNgRateTrendReportTask = sharedNgRateTrendReportTask;
        try
        {
            await GetReportAsync();
            if (_report is null)
                throw new InvalidOperationException(string.IsNullOrWhiteSpace(_reportError)
                    ? "F-COST trend report did not produce results."
                    : _reportError);
        }
        finally
        {
            _externalProgress = null;
            _groupOverride = null;
            _sharedNgRateTrendReport = null;
            _sharedNgRateTrendReportTask = null;
        }
    }

    private async Task ExportCsvAsync()
    {
        if (_isExportingCsv) return;

        _isExportingCsv = true;
        _reportError = string.Empty;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        try
        {
            if (_report is null)
            {
                _reportError = "No CSV rows to export.";
                return;
            }

            byte[] bytes = BuildCurrentFCostCsv();
            if (bytes.Length == 0)
            {
                _reportError = "CSV export produced an empty file.";
                return;
            }

            string kind = IsTrendReportRoute ? "Trend" : "FCost";
            Activity.Log("F-COST", $"Export {kind} CSV");
            string name = $"BMES_{kind}_{DateTime.Now:yyyyMMdd_HHmmss}.csv";
            await BrowserDownload.DownloadBytesAsync(JS, name, bytes, CsvExportUtility.ContentType);
        }
        catch (Exception ex)
        {
            _reportError = $"Export failed: {ex.Message}";
        }
        finally
        {
            _isExportingCsv = false;
            StateHasChanged();
        }
    }

    private async Task ExportRawBreakdownExcelAsync()
    {
        if (_isExportingRawBreakdownExcel) return;

        _isExportingRawBreakdownExcel = true;
        _rawBreakdownError = string.Empty;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        try
        {
            if (_rawMaterialBreakdown is null || _rawMaterialBreakdown.Rows.Count == 0)
            {
                _rawBreakdownError = "No raw material breakdown rows to export.";
                return;
            }

            byte[] bytes = FCostRawBreakdownExcelExporter.Export(
                _rawMaterialBreakdown,
                _fcostCurrencyMode,
                _reportStartDate,
                _reportEndDate);

            if (bytes.Length == 0)
            {
                _rawBreakdownError = "Raw material breakdown Excel export produced an empty file.";
                return;
            }

            Activity.Log("F-COST", "Export raw material breakdown Excel");
            string name = $"BMES_FCost_RawMaterialBreakdown_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";
            await BrowserDownload.DownloadBytesAsync(JS, name, bytes, BrowserDownload.XlsxContentType);
        }
        catch (Exception ex)
        {
            _rawBreakdownError = $"Raw material breakdown export failed: {ex.Message}";
        }
        finally
        {
            _isExportingRawBreakdownExcel = false;
            StateHasChanged();
        }
    }

    private byte[] BuildCurrentFCostCsv()
    {
        if (_report is null)
            return Array.Empty<byte>();

        var columnIndexes = IsTrendReportRoute
            ? ReportColumnIndexes()
            : AllFCostColumnIndexes();
        if (columnIndexes.Count == 0)
            return Array.Empty<byte>();

        return CsvExportUtility.Build(IsTrendReportRoute
            ? BuildTrendCsvRows(columnIndexes)
            : BuildRegularFCostCsvRows(columnIndexes));
    }

    private IEnumerable<IEnumerable<string?>> BuildTrendCsvRows(IReadOnlyList<int> columnIndexes)
    {
        var trendRows = BuildMajorTrendRows(columnIndexes);
        var totalCostByColumn = ComputeTotalCostByColumn(columnIndexes);

        yield return new string?[] { "Major Model Defect Rate Trend", $"{_reportStartDate:yyyy-MM-dd} - {_reportEndDate:yyyy-MM-dd}" };
        yield return new[] { "Level", "Model", "Metric" }.Concat(columnIndexes.Select(WeeklySummaryColumnHeader));

        foreach (var row in trendRows)
        {
            string level = row.Depth > 0 ? "Sub Group" : "Model";
            yield return BuildCsvRow(level, TrendModelDisplayName(row.ModelName), "NG PPM",
                columnIndexes.Select(ci =>
                {
                    double v = row.NgPpmByColumn.TryGetValue(ci, out double ppm) ? ppm : 0;
                    return FormatTrendPpm(v);
                }));
            yield return BuildCsvRow(level, TrendModelDisplayName(row.ModelName), "F-COST",
                columnIndexes.Select(ci => FormatTrendCurrency(ValueAt(row.CostByCol, ci))));
            yield return BuildCsvRow(level, TrendModelDisplayName(row.ModelName), "F-COST Share",
                columnIndexes.Select(ci =>
                {
                    double totalCost = totalCostByColumn.TryGetValue(ci, out double tc) ? tc : 0;
                    double share = totalCost > 0 ? ValueAt(row.CostByCol, ci) / totalCost * 100.0 : 0;
                    return FormatTrendPercent(share);
                }));
        }

        if (_report?.Total is not null)
        {
            yield return Array.Empty<string?>();
            yield return BuildCsvRow("Total", "Total (BMES)", "Total Input",
                columnIndexes.Select(ci => FormatTrendNumber(GetBmesTotalInput(ci))));
            yield return BuildCsvRow("Total", "Total (BMES)", "Total F-COST",
                columnIndexes.Select(ci => FormatTrendCurrency(GetBmesTotalCost(ci))));
            yield return BuildCsvRow("Total", "Total (BMES)", "TOTAL RATE",
                columnIndexes.Select(ci => FormatTrendRate(GetBmesTotalRate(ci))));
        }
    }

    private IEnumerable<IEnumerable<string?>> BuildRegularFCostCsvRows(IReadOnlyList<int> columnIndexes)
    {
        bool weeklyOnly = ShowFCostWeeklyReport && !ShowRegularFCostDetails;
        if (!weeklyOnly)
            yield return new string?[] { "F-Cost Report", $"{_reportStartDate:yyyy-MM-dd} - {_reportEndDate:yyyy-MM-dd}" };

        if (ShowFCostWeeklyReport)
        {
            foreach (var row in BuildWeeklyFCostCsvRows())
                yield return row;
            if (ShowRegularFCostDetails)
                yield return Array.Empty<string?>();
        }

        if (!ShowRegularFCostDetails)
            yield break;

        yield return new string?[] { "Model / Sub Group Summary" };
        yield return FCostMetricHeader(columnIndexes);

        var totalInputByColumn = ComputeTotalInputByColumn(columnIndexes);
        var totalCostByColumn = ComputeTotalCostByColumn(columnIndexes);
        foreach (var row in FCostMetricRows(
                     "Model / Sub Group Summary",
                     "Total",
                     "Total",
                     columnIndexes,
                     ci => totalInputByColumn.GetValueOrDefault(ci),
                     ci => totalCostByColumn.GetValueOrDefault(ci)))
        {
            yield return row;
        }

        var hierarchyRows = BuildFCostHierarchy();
        var rowsWithChildren = hierarchyRows
            .Where(r => r.ParentId is not null)
            .Select(r => r.ParentId!)
            .ToHashSet(StringComparer.Ordinal);

        foreach (var row in hierarchyRows)
        {
            foreach (var metricRow in FCostMetricRows(
                         "Model / Sub Group Summary",
                         FCostLevelLabel(row, rowsWithChildren),
                         row.Display,
                         columnIndexes,
                         ci => ValueAt(row.InputByCol, ci),
                         ci => ValueAt(row.CostByCol, ci)))
            {
                yield return metricRow;
            }
        }

        yield return Array.Empty<string?>();
        yield return new string?[] { "Material Detail" };
        yield return FCostMetricHeader(columnIndexes);

        if (_report?.SubGroups.Count > 0)
        {
            foreach (var row in FCostMetricRows(
                         "Material Detail",
                         "Total",
                         _report.Total?.DisplayName is { Length: > 0 } totalName ? totalName : "Total",
                         columnIndexes,
                         ci => totalInputByColumn.GetValueOrDefault(ci),
                         ci => totalCostByColumn.GetValueOrDefault(ci)))
            {
                yield return row;
            }
        }

        foreach (var material in _report?.Materials ?? new List<FCostMaterialBlock>())
        {
            foreach (var row in FCostMetricRows(
                         "Material Detail",
                         material.ProductGroup,
                         material.DisplayName,
                         columnIndexes,
                         ci => material.Input?.GetCol(ci + 1) ?? 0,
                         ci => material.Cost?.GetCol(ci + 1) ?? 0))
            {
                yield return row;
            }
        }
    }

    private IEnumerable<IEnumerable<string?>> BuildWeeklyFCostCsvRows()
    {
        var weeklyColumnIndexes = ReportColumnIndexes();
        if (weeklyColumnIndexes.Count == 0)
            yield break;

        var weeklyRows = BuildWeeklyModelRows();
        var totalRates = ComputeWeeklyTotalRates(weeklyColumnIndexes, weeklyRows);

        yield return new[] { "구분", "모델", "목표 불량률", "달성률" }
            .Concat(weeklyColumnIndexes.Select(WeeklySummaryColumnHeader));

        foreach (var model in weeklyRows)
        {
            yield return BuildCsvRow(
                "GN",
                model.ModelName,
                FormatWeeklyTargetPpm(GetWeeklyModelTargetRate(model.ModelName)),
                FormatWeeklyAchievement(model, weeklyColumnIndexes),
                weeklyColumnIndexes.Select(ci => FormatWeeklyPpmFromRate(WeeklyCellRate(model, ci))));
        }

        yield return BuildCsvRow("Total", "TOTAL 불량률", string.Empty, string.Empty,
            totalRates.Select(FormatWeeklyPpmFromRate));
    }

    private static double WeeklyCellRate(FCostWeeklyModelRow modelRow, int columnIndex)
    {
        double rate = ValueAt(modelRow.SourceRateByCol, columnIndex);
        if (rate > 0)
            return rate;

        double input = ValueAt(modelRow.InputByCol, columnIndex);
        return input > 0 ? ValueAt(modelRow.CostByCol, columnIndex) / input * 100.0 : 0;
    }

    private List<int> AllFCostColumnIndexes()
    {
        if (_report is null) return new List<int>();
        int count = _report.Columns.Count > 0 ? _report.Columns.Count : _report.ColumnHeaders.Count;
        return Enumerable.Range(0, count).ToList();
    }

    private IEnumerable<string?> FCostMetricHeader(IReadOnlyList<int> columnIndexes)
        => new[] { "Section", "Level", "Name", "Type" }.Concat(columnIndexes.Select(FCostColumnHeader));

    private IEnumerable<IEnumerable<string?>> FCostMetricRows(
        string section,
        string level,
        string name,
        IReadOnlyList<int> columnIndexes,
        Func<int, double> inputOf,
        Func<int, double> costOf)
    {
        if (_showInput)
            yield return BuildCsvRow(section, level, name, "INPUT", columnIndexes.Select(ci => FormatNum(inputOf(ci))));

        if (_showCost)
            yield return BuildCsvRow(section, level, name, "F-COST", columnIndexes.Select(ci => FormatNum(costOf(ci))));

        if (_showRate)
        {
            yield return BuildCsvRow(section, level, name, "RATE %",
                columnIndexes.Select(ci =>
                {
                    double input = inputOf(ci);
                    double cost = costOf(ci);
                    return FormatRate(input > 0 ? cost / input * 100.0 : 0);
                }));
        }
    }

    private IEnumerable<string?> BuildCsvRow(
        string first,
        string second,
        string third,
        IEnumerable<string?> values)
        => new[] { first, second, third }.Concat(values);

    private IEnumerable<string?> BuildCsvRow(
        string first,
        string second,
        string third,
        string fourth,
        IEnumerable<string?> values)
        => new[] { first, second, third, fourth }.Concat(values);

    private string FCostColumnHeader(int columnIndex)
        => _report is not null &&
           columnIndex >= 0 &&
           columnIndex < _report.ColumnHeaders.Count
            ? _report.ColumnHeaders[columnIndex]
            : string.Empty;

    private async Task GetReportAsync()
    {
        if (_isReportBusy) return;
        _isReportBusy = true;
        _reportError = string.Empty;
        _reportStatusMessage = string.Empty;
        _report = null;
        _ngRateTrendByMid = null;
        _reportModelGroups = new();
        _rawMaterialBreakdown = null;
        _rawBreakdownError = string.Empty;
        _expandedTrendRows.Clear();
        _expandedRawBreakdownRows.Clear();
        StateHasChanged();

        try
        {
            DateTime start = _reportStartDate.Date;
            DateTime end = _reportEndDate.Date;
            DateTime today = DateTime.Today;
            if (end > today) end = today;
            if (start > end)
            {
                _reportError = "Report start date must be before or equal to end date.";
                return;
            }

            DateTime forceFrom = end.AddDays(-2);
            _reportStatusMessage =
                $"Preparing RAW cache. Cached through {forceFrom.AddDays(-1):yyyy-MM-dd}; refreshing {forceFrom:yyyy-MM-dd} - {end:yyyy-MM-dd}.";

            IProgress<string> progress = new Progress<string>(msg =>
            {
                _reportStatusMessage = msg;
                _externalProgress?.Report(msg);
                _ = InvokeAsync(StateHasChanged);
            });

            var backfill = await FCost.BackfillRawAsync(
                start,
                end,
                force: false,
                forceFromDate: forceFrom,
                progress: progress);
            _rawStatus = FCost.GetRawStatus();

            var groups = _groupOverride?.ToList() ?? Repo.GetModelGroups();
            _reportModelGroups = groups;
            LogFCostReportStage("before report build", groups.Count);
            _reportStatusMessage = backfill.FailedDays > 0
                ? $"RAW cache completed with {backfill.FailedDays:N0} failed day(s). Building report from available data..."
                : "RAW cache ready. Building report...";
            _report = await FCostReportSvc.GenerateRawRangeReportAsync(
                FCost.GetRawDbPath(),
                start,
                end,
                groupsForSubGroupRollup: groups,
                progress: progress);
            LogFCostReportStage("after F-COST report build", groups.Count);
            await BuildRawMaterialBreakdownAsync(groups, progress);
            LogFCostReportStage("after raw material breakdown", groups.Count);
            if (_sharedNgRateTrendReport is not null)
            {
                _ngRateTrendByMid = _sharedNgRateTrendReport;
                progress.Report("Reusing Daily NG Rate trend summary.");
                LogFCostReportStage("after shared NG trend reuse", groups.Count);
            }
            else if (_sharedNgRateTrendReportTask is not null)
            {
                progress.Report("Waiting for Daily NG Rate trend summary.");
                try
                {
                    var sharedTrend = await _sharedNgRateTrendReportTask;
                    if (sharedTrend is not null)
                    {
                        _ngRateTrendByMid = sharedTrend;
                        progress.Report("Reusing Daily NG Rate trend summary.");
                        LogFCostReportStage("after shared NG trend wait", groups.Count);
                    }
                    else
                    {
                        progress.Report("Daily NG Rate trend summary unavailable; skipping NG Rate trend.");
                    }
                }
                catch (Exception ex)
                {
                    progress.Report("[WARN] Daily NG Rate trend summary unavailable: " + ex.Message);
                }
            }
            else
            {
                await BuildNgRateTrendAsync(groups, start, end, progress);
                LogFCostReportStage("after NG trend build", groups.Count);
            }
            _showAllDayColumns = false;
            _showAllWeekColumns = false;
            _showAllMonthColumns = false;
            _reportStatusMessage = $"Report ready: {start:yyyy-MM-dd} - {end:yyyy-MM-dd}.";
            LogFCostReportStage("report ready", groups.Count);
        }
        catch (Exception ex)
        {
            _externalProgress?.Report("[F-COST ERROR] " + ex);
            _reportError = $"Error: {ex.Message}";
        }
        finally
        {
            _isReportBusy = false;
            StateHasChanged();
        }
    }

    private void LogFCostReportStage(string stage, int selectedGroupCount)
    {
        try
        {
            using var process = Process.GetCurrentProcess();
            double workingSetMb = process.WorkingSet64 / 1024d / 1024d;
            double managedMb = GC.GetTotalMemory(forceFullCollection: false) / 1024d / 1024d;
            Activity.Log(
                "F-COST Memory",
                string.Format(
                    CultureInfo.InvariantCulture,
                    "{0}: workingSet={1:N1} MB, managed={2:N1} MB, selectedGroups={3:N0}, sourceRows={4:N0}, materials={5:N0}, subGroups={6:N0}, unmapped={7:N0}, rawRows={8:N0}, rawPeriods={9:N0}",
                    stage,
                    workingSetMb,
                    managedMb,
                    selectedGroupCount,
                    _report?.TotalRows ?? 0,
                    _report?.Materials.Count ?? 0,
                    _report?.SubGroups.Count ?? 0,
                    _report?.UnmappedMaterials.Count ?? 0,
                    _rawMaterialBreakdown?.Rows.Count ?? 0,
                    _rawMaterialBreakdown?.Periods.Count ?? 0));
        }
        catch
        {
            // Diagnostics must not interfere with report generation.
        }
    }

    private async Task BuildRawMaterialBreakdownAsync(
        IReadOnlyList<ModelGroupRecord> groups,
        IProgress<string>? progress)
    {
        _rawMaterialBreakdown = null;
        _rawBreakdownError = string.Empty;
        _expandedRawBreakdownRows.Clear();

        if (_report is null)
            return;

        List<BmesFcostRawBreakdownPeriod> periods = BuildRawBreakdownPeriods(WeeklyReportColumnIndexes());
        if (periods.Count == 0)
            return;

        List<BmesFcostRawBreakdownLineShift> lineShifts = BuildRawBreakdownLineShifts(groups);
        if (lineShifts.Count == 0)
            return;

        var connection = BuildNetworkDbConnection();
        if (string.IsNullOrWhiteSpace(connection.Server) || string.IsNullOrWhiteSpace(connection.UserId))
        {
            _rawBreakdownError = "Network DB connection is not configured for FCOST raw material breakdown.";
            progress?.Report("[WARN] " + _rawBreakdownError);
            return;
        }

        try
        {
            progress?.Report($"Loading network DB FCOST raw material breakdown ({periods.Count:N0} period(s), {lineShifts.Count:N0} line shift(s))...");
            _rawMaterialBreakdown = await FCostActual.FetchRawBreakdownAsync(new BmesFcostRawBreakdownQuery
            {
                Connection = connection,
                Fact = "GN",
                Plant = "3200",
                Periods = periods,
                LineShifts = lineShifts,
            });
            progress?.Report($"Network DB FCOST raw material breakdown ready: {_rawMaterialBreakdown.Rows.Count:N0} row(s).");
        }
        catch (Exception ex)
        {
            _rawBreakdownError = "Network DB FCOST raw material breakdown failed: " + ex.Message;
            progress?.Report("[WARN] " + _rawBreakdownError);
            _rawMaterialBreakdown = new BmesFcostRawBreakdownResult
            {
                Periods = periods,
                Rows = [],
            };
        }
    }

    private BmesFcostDbConnection BuildNetworkDbConnection()
    {
        var c = AppPaths.Current;
        return new BmesFcostDbConnection
        {
            Server = c.AdminDbQueryServer,
            Port = c.AdminDbQueryPort > 0 ? c.AdminDbQueryPort : 1430,
            Database = string.IsNullOrWhiteSpace(c.AdminDbQueryDatabase) ||
                       string.Equals(c.AdminDbQueryDatabase, "master", StringComparison.OrdinalIgnoreCase)
                ? "BMES_LIV"
                : c.AdminDbQueryDatabase,
            UserId = c.AdminDbQueryUserId,
            Password = c.AdminDbQueryPassword,
            TimeoutSeconds = Math.Clamp(Math.Max(c.AdminDbQueryTimeoutSeconds, 300), 1, 600),
            Encrypt = c.AdminDbQueryEncrypt,
            TrustServerCertificate = c.AdminDbQueryTrustServerCertificate,
        };
    }

    private List<BmesFcostRawBreakdownPeriod> BuildRawBreakdownPeriods(IReadOnlyList<int> columnIndexes)
    {
        var periods = new List<BmesFcostRawBreakdownPeriod>();
        if (_report?.Columns is not { Count: > 0 } columns)
            return periods;

        int ordinal = 0;
        foreach (int ci in columnIndexes)
        {
            if (ci < 0 || ci >= columns.Count)
                continue;

            var col = columns[ci];
            if (col.Kind is not (FCostPeriodKind.Week or FCostPeriodKind.Month))
                continue;

            if (TryBuildRawBreakdownPeriod(col, ordinal, WeeklySummaryColumnHeader(ci), out var period))
            {
                periods.Add(period);
                ordinal++;
            }
        }

        return periods;
    }

    private static bool TryBuildRawBreakdownPeriod(
        FCostColumnMeta col,
        int ordinal,
        string header,
        out BmesFcostRawBreakdownPeriod period)
    {
        period = new BmesFcostRawBreakdownPeriod(ordinal, string.Empty, string.Empty, string.Empty, DateTime.MinValue, DateTime.MinValue);

        if (col.Kind == FCostPeriodKind.Week &&
            TryParseFcostWeek(col.Code, col.PDate, out int year, out int week))
        {
            DateTime start = ISOWeek.ToDateTime(year, week, DayOfWeek.Monday).Date;
            string key = $"{year:0000}-{week:00}";
            period = new BmesFcostRawBreakdownPeriod(
                ordinal,
                key,
                string.IsNullOrWhiteSpace(header) ? $"W{week:00}" : header,
                "Week",
                start,
                start.AddDays(7));
            return true;
        }

        if (col.Kind == FCostPeriodKind.Month &&
            TryParseFcostMonth(col.Code, col.PDate, out year, out int month))
        {
            DateTime start = new(year, month, 1);
            string key = $"{year:0000}{month:00}";
            period = new BmesFcostRawBreakdownPeriod(
                ordinal,
                key,
                string.IsNullOrWhiteSpace(header) ? start.ToString("MMM", CultureInfo.InvariantCulture) : header,
                "Month",
                start,
                start.AddMonths(1));
            return true;
        }

        return false;
    }

    private static bool TryParseFcostWeek(string code, string pdate, out int year, out int week)
    {
        foreach (string raw in new[] { code, pdate })
        {
            string value = (raw ?? string.Empty).Trim();
            if (string.IsNullOrWhiteSpace(value))
                continue;

            string compact = value.Replace("-", string.Empty, StringComparison.Ordinal);
            if (compact.Length >= 6 &&
                int.TryParse(compact[..4], NumberStyles.Integer, CultureInfo.InvariantCulture, out year) &&
                int.TryParse(compact[4..6], NumberStyles.Integer, CultureInfo.InvariantCulture, out week) &&
                week >= 1 &&
                week <= ISOWeek.GetWeeksInYear(year))
            {
                return true;
            }
        }

        year = 0;
        week = 0;
        return false;
    }

    private static bool TryParseFcostMonth(string code, string pdate, out int year, out int month)
    {
        foreach (string raw in new[] { pdate, code })
        {
            string value = (raw ?? string.Empty).Trim().Replace("-", string.Empty, StringComparison.Ordinal);
            if (value.Length >= 6 &&
                int.TryParse(value[..4], NumberStyles.Integer, CultureInfo.InvariantCulture, out year) &&
                int.TryParse(value[4..6], NumberStyles.Integer, CultureInfo.InvariantCulture, out month) &&
                month is >= 1 and <= 12)
            {
                return true;
            }
        }

        year = 0;
        month = 0;
        return false;
    }

    private static List<BmesFcostRawBreakdownLineShift> BuildRawBreakdownLineShifts(
        IReadOnlyList<ModelGroupRecord> groups)
    {
        var result = new List<BmesFcostRawBreakdownLineShift>();
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        foreach (var group in groups)
        {
            string groupName = string.IsNullOrWhiteSpace(group.Name) ? "-" : group.Name.Trim();
            foreach (var mid in group.MidGroups)
            {
                string modelName = string.IsNullOrWhiteSpace(mid.Material) ? groupName : mid.Material.Trim();
                foreach (string rawLineShift in mid.LineShifts)
                {
                    string lineShift = rawLineShift.Trim();
                    if (string.IsNullOrWhiteSpace(lineShift) || !seen.Add(lineShift))
                        continue;

                    result.Add(new BmesFcostRawBreakdownLineShift(groupName, modelName, lineShift));
                }
            }
        }

        return result;
    }

    private async Task BuildNgRateTrendAsync(
        IReadOnlyList<ModelGroupRecord> groups,
        DateTime start,
        DateTime end,
        IProgress<string>? progress)
    {
        if (!NgRateSettings.IsCredentialsConfigured || !NgRateSettings.IsNgRateStorageConfigured)
            return;

        var (mapping, groupNames) = BuildNgMidMapping(groups);
        if (mapping.Count == 0 || groupNames.Count == 0)
            return;

        try
        {
            _reportStatusMessage = "Building NG Rate trend for registered models...";
            progress?.Report(_reportStatusMessage);

            string? ngDbPath = await NgRate.GetOrFetchAsync(start, end, progress);
            if (string.IsNullOrWhiteSpace(ngDbPath))
                return;

            _ngRateTrendByMid = await NgRateReportSvc.GenerateSummaryReportAsync(
                ngDbPath,
                mapping,
                groupNames,
                progress,
                start,
                end,
                weightedGroupSummary: true);
        }
        catch (Exception ex)
        {
            progress?.Report("[WARN] NG Rate trend skipped: " + ex.Message);
            _ngRateTrendByMid = null;
        }
    }

    private static (Dictionary<string, IReadOnlyList<string>> Mapping, List<string> GroupNames) BuildNgMidMapping(
        IReadOnlyList<ModelGroupRecord> groups)
    {
        var mapping = new Dictionary<string, List<string>>(StringComparer.Ordinal);
        var groupNames = new List<string>();
        var seenGroups = new HashSet<string>(StringComparer.Ordinal);

        void AddGroupName(string groupName)
        {
            if (seenGroups.Add(groupName))
                groupNames.Add(groupName);
        }

        void AddMembership(string lineShift, string groupName)
        {
            if (string.IsNullOrWhiteSpace(lineShift) || string.IsNullOrWhiteSpace(groupName)) return;
            if (!mapping.TryGetValue(lineShift, out var list))
            {
                list = new List<string>();
                mapping[lineShift] = list;
            }

            if (!list.Contains(groupName, StringComparer.Ordinal))
                list.Add(groupName);

            AddGroupName(groupName);
        }

        foreach (var group in groups)
        {
            foreach (var mid in group.MidGroups)
            {
                if (string.IsNullOrWhiteSpace(mid.Material)) continue;
                string midKey = $"{group.Name}::{mid.Material}";

                foreach (string lineShift in mid.LineShifts)
                {
                    AddMembership(lineShift, group.Name);
                    AddMembership(lineShift, midKey);
                }

                foreach (var sub in mid.SubGroups)
                {
                    string subKey = ModelGroupPickerHelpers.SubGroupKeyOf(group.Name, mid.Material, sub);
                    foreach (string lineShift in sub.AllLineShifts)
                        AddMembership(lineShift, subKey);

                    // Use a temporary mapping local to this sub node to add full leaf keys.
                    var leafMapping = new Dictionary<string, string>(StringComparer.Ordinal);
                    var leafGroupNames = new List<string>();
                    ModelGroupPickerHelpers.BuildSubLeafMapping(group.Name, mid.Material, sub, string.Empty, leafMapping, leafGroupNames);

                    foreach (var kv in leafMapping)
                        AddMembership(kv.Key, kv.Value);
                    foreach (var leafName in leafGroupNames)
                        AddGroupName(leafName);
                }
            }
        }

        return (
            mapping.ToDictionary(kv => kv.Key, kv => (IReadOnlyList<string>)kv.Value, StringComparer.Ordinal),
            groupNames);
    }

    private static string BuildUnmappedModelGroupUrl(IEnumerable<FCostMaterialBlock> unmapped)
    {
        var materials = unmapped
            .Select(m => m.Material)
            .Where(m => !string.IsNullOrWhiteSpace(m))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(m => m, StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (materials.Count == 0)
            return "/bmes/make-model-group";

        string query = string.Join("&", materials.Select(m => "m=" + Uri.EscapeDataString(m)));
        return "/bmes/make-model-group?source=fcost&" + query;
    }
