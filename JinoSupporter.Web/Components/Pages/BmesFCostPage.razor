    private static string NormalizeCurrencyMode(string? value)
    {
        string normalized = (value ?? string.Empty).Trim().ToUpperInvariant();
        return normalized switch
        {
            CurrencyUsd => CurrencyUsd,
            CurrencyKrw => CurrencyKrw,
            _ => CurrencyVnd,
        };
