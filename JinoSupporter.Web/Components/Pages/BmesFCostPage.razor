    private static string FormatLimitedSummary(IEnumerable<string> values, int limit)
    {
        var list = values
            .Where(v => !string.IsNullOrWhiteSpace(v))
            .ToList();
        if (list.Count == 0)
            return "-";

        string summary = string.Join(", ", list.Take(limit));
        int remaining = list.Count - limit;
        return remaining > 0
            ? $"{summary} (+{remaining.ToString(CultureInfo.InvariantCulture)})"
            : summary;
    }

    private static BmesFcostRawMaterialPeriodPrice? PickBreakdownUnitPrice(
        IReadOnlyDictionary<string, BmesFcostRawMaterialPeriodPrice> priceByPeriod,
        IReadOnlyList<BmesFcostRawBreakdownPeriod> periods)
    {
        foreach (var period in periods)
        {
            if (priceByPeriod.TryGetValue(period.Key, out var price) &&
                IsUsableBreakdownPrice(price))
                return price;
        }

        return priceByPeriod.Values.FirstOrDefault(IsUsableBreakdownPrice);
    }

    private static bool IsUsableBreakdownPrice(BmesFcostRawMaterialPeriodPrice price)
        => !price.IsMixed &&
           price.UnitPrice is > 0 &&
           !string.IsNullOrWhiteSpace(price.Currency);

    private static string FormatEquivalentQty(decimal value)
        => value >= 1000
            ? value.ToString("N0", CultureInfo.InvariantCulture)
            : value.ToString("0.##", CultureInfo.InvariantCulture);

    private static string FormatBreakdownQty(decimal value, BmesFcostRawMaterialPeriodPrice? price)
    {
        if (value <= 0)
            return "-";

        return FormatEquivalentQty(value) + FormatQtyUnitSuffix(price);
    }

    private static string FormatQtyUnitSuffix(BmesFcostRawMaterialPeriodPrice? price)
    {
        if (price is null || price.IsMixed || string.IsNullOrWhiteSpace(price.PriceUnit))
            return string.Empty;

        return " " + price.PriceUnit.Trim();
    }

    private static string FormatUnitPrice(BmesFcostRawMaterialPeriodPrice? price)
    {
        if (price is null)
            return "-";
        if (price.IsMixed)
            return "Price mixed";
        if (price.UnitPrice is null || string.IsNullOrWhiteSpace(price.Currency))
            return "-";

        string unit = string.IsNullOrWhiteSpace(price.PriceUnit)
            ? string.Empty
            : "/" + price.PriceUnit.Trim();
        return FormatPriceAmount(price.Currency, price.UnitPrice.Value) + unit;
    }

    private static string FormatPriceAmount(string currency, decimal value)
    {
        string format = Math.Abs(value) < 1m && value != 0m
            ? "0.######"
            : "N2";
        return currency.Trim().ToUpperInvariant() + " " + value.ToString(format, CultureInfo.InvariantCulture);
    }

