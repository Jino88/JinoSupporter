    private static bool TryLaunchAiStructureExtractionTerminal(
        string workDir,
        string rendererPath,
        string workbookPath,
        string structureDir,
        string imageDir,
        string renderedRequestPath,
        string prompt,
        string title,
        string outputJsonPath,
        string progressPath,
        string donePath)
    {
        string launchId = Guid.NewGuid().ToString("N")[..12];
        string promptPath = Path.Combine(workDir, $"_input_data_test_extract_prompt_{launchId}.txt");
        string scriptPath = Path.Combine(workDir, $"_input_data_test_extract_launch_{launchId}.ps1");

        try
        {
            File.WriteAllText(promptPath, prompt, new UTF8Encoding(encoderShouldEmitUTF8Identifier: false));
            File.WriteAllText(
                scriptPath,
                BuildAiStructureExtractionLauncherScript(
                    workDir,
                    rendererPath,
                    workbookPath,
                    structureDir,
                    imageDir,
                    renderedRequestPath,
                    promptPath,
                    scriptPath,
                    title,
                    outputJsonPath,
                    progressPath,
                    donePath),
                new UTF8Encoding(encoderShouldEmitUTF8Identifier: false));
        }
        catch
        {
            return false;
        }

        try
        {
            var wt = new ProcessStartInfo
            {
                FileName = "wt.exe",
                UseShellExecute = false,
                CreateNoWindow = false,
            };
            wt.ArgumentList.Add("-d");
            wt.ArgumentList.Add(workDir);
            wt.ArgumentList.Add("powershell.exe");
            wt.ArgumentList.Add("-NoExit");
            wt.ArgumentList.Add("-NoProfile");
            wt.ArgumentList.Add("-ExecutionPolicy");
            wt.ArgumentList.Add("Bypass");
            wt.ArgumentList.Add("-File");
            wt.ArgumentList.Add(scriptPath);
            var proc = Process.Start(wt);
            if (proc is not null) ChildProcessJob.Assign(proc);
            return proc is not null;
        }
        catch { }

        try
        {
            var psi = new ProcessStartInfo
            {
                FileName = "cmd.exe",
                WorkingDirectory = workDir,
                UseShellExecute = false,
                CreateNoWindow = false,
            };
            psi.ArgumentList.Add("/k");
            psi.ArgumentList.Add("powershell.exe");
            psi.ArgumentList.Add("-NoExit");
            psi.ArgumentList.Add("-NoProfile");
            psi.ArgumentList.Add("-ExecutionPolicy");
            psi.ArgumentList.Add("Bypass");
            psi.ArgumentList.Add("-File");
            psi.ArgumentList.Add(scriptPath);
            var proc = Process.Start(psi);
            if (proc is not null) ChildProcessJob.Assign(proc);
            return proc is not null;
        }
        catch
        {
            return false;
        }
    }

    private static string BuildAiStructureExtractionLauncherScript(
        string workDir,
        string rendererPath,
        string workbookPath,
        string structureDir,
        string imageDir,
        string renderedRequestPath,
        string promptPath,
        string scriptPath,
        string title,
        string outputJsonPath,
        string progressPath,
        string donePath)
    {
        static string Q(string value) => "'" + (value ?? "").Replace("'", "''") + "'";
        return string.Join(Environment.NewLine, new[]
        {
            "$ErrorActionPreference = 'Continue'",
            "$utf8NoBom = New-Object System.Text.UTF8Encoding -ArgumentList $false",
            "[Console]::InputEncoding = $utf8NoBom",
            "[Console]::OutputEncoding = $utf8NoBom",
            "$OutputEncoding = $utf8NoBom",
            "try { chcp 65001 | Out-Null } catch {}",
            $"try {{ $Host.UI.RawUI.WindowTitle = {Q(title)} }} catch {{}}",
            $"Set-Location -LiteralPath {Q(workDir)}",
            "",
            $"$rendererPath = {Q(rendererPath)}",
            $"$workbookPath = {Q(workbookPath)}",
            $"$structureDir = {Q(structureDir)}",
            $"$imageDir = {Q(imageDir)}",
            $"$renderedRequestPath = {Q(renderedRequestPath)}",
            $"$promptPath = {Q(promptPath)}",
            $"$scriptPath = {Q(scriptPath)}",
            $"$outputJsonPath = {Q(outputJsonPath)}",
            $"$progressPath = {Q(progressPath)}",
            $"$donePath = {Q(donePath)}",
            "New-Item -ItemType Directory -Force -Path $structureDir | Out-Null",
            "New-Item -ItemType Directory -Force -Path $imageDir | Out-Null",
            "Remove-Item -LiteralPath $outputJsonPath -Force -ErrorAction SilentlyContinue",
            "Remove-Item -LiteralPath $progressPath -Force -ErrorAction SilentlyContinue",
            "Remove-Item -LiteralPath $donePath -Force -ErrorAction SilentlyContinue",
            "",
            "$script:ExtractionStopwatch = [System.Diagnostics.Stopwatch]::StartNew()",
            "",
            "function Get-ElapsedText() {",
            "    try {",
            "        return $script:ExtractionStopwatch.Elapsed.ToString('hh\\:mm\\:ss')",
            "    } catch {",
            "        return '00:00:00'",
            "    }",
            "}",
            "",
            "function Write-ProgressJson([string]$stage, [int]$percent, [string]$message) {",
            "    try {",
            "        @{ stage = $stage; percent = $percent; message = $message; elapsed = (Get-ElapsedText) } | ConvertTo-Json -Compress | Set-Content -LiteralPath $progressPath -Encoding UTF8",
            "    } catch {}",
            "}",
            "",
            "$exitCode = 0",
            "try {",
            "    Write-ProgressJson 'render' 10 'Rendering workbook images and extracting Excel cells.'",
            "    & python $rendererPath $workbookPath $imageDir $renderedRequestPath 36 3",
            "    $renderExit = if ($null -eq $LASTEXITCODE) { 0 } else { $LASTEXITCODE }",
            "    if ($renderExit -ne 0) {",
            "        $exitCode = $renderExit",
            "        Write-ProgressJson 'render_failed' 100 ('Workbook render failed. Exit code ' + $renderExit + '.')",
            "        if (Test-Path -LiteralPath $renderedRequestPath) { Get-Content -LiteralPath $renderedRequestPath -Raw -Encoding UTF8 | Set-Content -LiteralPath $outputJsonPath -Encoding UTF8 }",
            "    } else {",
            "        $rendered = Get-Content -LiteralPath $renderedRequestPath -Raw -Encoding UTF8 | ConvertFrom-Json",
            "        $summary = $rendered.deterministicSummary",
            "        $fastStructure = $rendered.deterministicStructure",
            "        $fastConfidence = 0",
            "        if ($null -ne $summary -and $null -ne $summary.confidence) { $fastConfidence = [int]$summary.confidence }",
            "        $needsAiRefine = $true",
            "        if ($null -ne $summary -and $null -ne $summary.needsAiRefine) { $needsAiRefine = [System.Convert]::ToBoolean($summary.needsAiRefine) }",
            "        if ($null -ne $fastStructure) {",
            "            Write-ProgressJson 'fast_complete' 100 ('Fast deterministic structure complete. Confidence ' + $fastConfidence + '%, needs AI refine=' + $needsAiRefine + '. Codex skipped by default.')",
            "            $fastStructure | ConvertTo-Json -Depth 100 | Set-Content -LiteralPath $outputJsonPath -Encoding UTF8",
            "            $exitCode = 0",
            "        } else {",
            "            Write-ProgressJson 'ai' 45 'Codex structure extraction running because fast deterministic structure was not produced.'",
            "            $imageArgs = New-Object System.Collections.Generic.List[string]",
            "            foreach ($sheet in $rendered.sheets) {",
            "                foreach ($chunk in $sheet.chunks) {",
            "                    $imageArgs.Add('-i')",
            "                    $imageArgs.Add([string]$chunk.imagePath)",
            "                }",
            "            }",
            "            $prompt = Get-Content -LiteralPath $promptPath -Raw -Encoding UTF8",
            $"            $prompt | & codex exec @imageArgs -c 'model_reasoning_effort=\"xhigh\"' --cd {Q(workDir)} --dangerously-bypass-approvals-and-sandbox --skip-git-repo-check --color never --output-last-message $outputJsonPath -",
            "            $exitCode = if ($null -eq $LASTEXITCODE) { 0 } else { $LASTEXITCODE }",
            "            if ($exitCode -eq 0) { Write-ProgressJson 'complete' 100 'Codex structure extraction complete.' } else { Write-ProgressJson 'fallback' 90 ('Codex failed. The web app will try Excel fallback. Exit code ' + $exitCode + '.') }",
            "        }",
            "    }",
            "} catch {",
            "    $exitCode = 1",
            "    Write-ProgressJson 'failed' 100 $_.Exception.Message",
            "    $_ | Out-String | Tee-Object -FilePath $outputJsonPath -Append",
            "}",
            "$done = @{ exitCode = $exitCode; completedAt = [DateTime]::UtcNow.ToString('o') } | ConvertTo-Json -Compress",
            "Set-Content -LiteralPath $donePath -Value $done -Encoding UTF8",
            "Remove-Item -LiteralPath $promptPath -Force -ErrorAction SilentlyContinue",
            "Remove-Item -LiteralPath $scriptPath -Force -ErrorAction SilentlyContinue",
        });
    }

    public async ValueTask DisposeAsync()
    {
        try { _cliWaitCts?.Cancel(); } catch { }
        _cliWaitCts?.Dispose();
        try { await JS.InvokeVoidAsync("diFullPage.leave"); } catch { }
    }

