    private static void AppendVisibleText(StringBuilder sb, JsonElement sheet)
    {
        if (!sheet.TryGetProperty("visibleText", out JsonElement items)
            || items.ValueKind != JsonValueKind.Array)
        {
            return;
        }

        sb.AppendLine();
        sb.AppendLine("### Visible Text");
        foreach (JsonElement item in items.EnumerateArray())
        {
            string text = FlattenStructureText(JsonString(item, "text"));
            if (string.IsNullOrWhiteSpace(text)) continue;

            int order = JsonInt(item, "order");
            string role = FlattenStructureText(JsonString(item, "role"));
            string prefix = order > 0 ? $"{order}. " : "";
            string roleText = string.IsNullOrWhiteSpace(role) ? "" : $"[{role}] ";
            sb.AppendLine($"- {prefix}{roleText}{text}");
        }
    }

    private static void AppendSections(StringBuilder sb, JsonElement sheet)
    {
        if (!sheet.TryGetProperty("sections", out JsonElement sections)
            || sections.ValueKind != JsonValueKind.Array)
        {
            return;
        }

        sb.AppendLine();
        sb.AppendLine("### Sections");
        foreach (JsonElement section in sections.EnumerateArray())
        {
            string title = FlattenStructureText(JsonString(section, "title"));
            string role = FlattenStructureText(JsonString(section, "role"));
            string label = string.IsNullOrWhiteSpace(title) ? "Untitled" : title;
            if (!string.IsNullOrWhiteSpace(role)) label += $" ({role})";
            sb.AppendLine($"#### {label}");

            foreach (string line in JsonStringArray(section, "body"))
                sb.AppendLine($"- {line}");
        }
    }

    private static void AppendTables(StringBuilder sb, JsonElement sheet)
    {
        if (!sheet.TryGetProperty("tables", out JsonElement tables)
            || tables.ValueKind != JsonValueKind.Array)
        {
            return;
        }

        sb.AppendLine();
        sb.AppendLine("### Tables");
        foreach (JsonElement table in tables.EnumerateArray())
        {
            string title = FlattenStructureText(JsonString(table, "title"));
            sb.AppendLine($"#### {(string.IsNullOrWhiteSpace(title) ? "Table" : title)}");

            AppendTableLayoutText(sb, table);
            AppendMergedCellsText(sb, table);
            AppendNormalizedRowsText(sb, table);

            var headers = JsonStringArray(table, "headers");
            if (headers.Count > 0)
                sb.AppendLine("Headers\t" + string.Join('\t', headers));

            if (table.TryGetProperty("rows", out JsonElement rows) && rows.ValueKind == JsonValueKind.Array)
            {
                int rowNo = 1;
                foreach (JsonElement row in rows.EnumerateArray())
                {
                    var cells = row.ValueKind == JsonValueKind.Array
                        ? row.EnumerateArray().Select(JsonValueText).ToList()
                        : new List<string> { JsonValueText(row) };
                    sb.AppendLine($"R{rowNo}\t{string.Join('\t', cells)}");
                    rowNo++;
                }
            }

            var notes = JsonStringArray(table, "notes");
            foreach (string note in notes)
                sb.AppendLine($"Note\t{note}");
        }
    }

