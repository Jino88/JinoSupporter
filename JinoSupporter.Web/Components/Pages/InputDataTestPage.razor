    private static List<AutoPromptOption> LoadAutoPromptLibrary(string path)
    {
        try
        {
            string json = File.ReadAllText(path);
            var records = JsonSerializer.Deserialize<List<AutoPromptStorage>>(
                json,
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? [];

            var options = records
                .Where(r => !string.IsNullOrWhiteSpace(r.Key))
                .Select(r => new AutoPromptOption(
                    r.Key,
                    string.IsNullOrWhiteSpace(r.Title) ? r.Key : r.Title,
                    string.IsNullOrWhiteSpace(r.Description) ? ShortPromptSummary(r.Content) : r.Description,
                    string.IsNullOrWhiteSpace(r.SourceLabel) ? "Preset" : r.SourceLabel,
                    "",
                    r.Content ?? "",
                    r.Enabled,
                    r.IsCustom))
                .ToList();

            return options;
        }
        catch
        {
            return [];
        }
    }

