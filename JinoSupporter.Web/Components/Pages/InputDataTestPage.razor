    private static string CleanJsonText(string raw)
    {
        string text = (raw ?? "").Trim();
        if (!text.StartsWith("```", StringComparison.Ordinal)) return text;

        int firstNewline = text.IndexOf('\n');
        if (firstNewline >= 0) text = text[(firstNewline + 1)..];
        int fence = text.LastIndexOf("```", StringComparison.Ordinal);
        if (fence >= 0) text = text[..fence];
        return text.Trim();
    }

    private static string EnrichAiStructureJsonWithRenderedMetadata(string aiJson, string renderedRequestPath)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(aiJson)
                || string.IsNullOrWhiteSpace(renderedRequestPath)
                || !File.Exists(renderedRequestPath))
            {
                return aiJson;
            }

            JsonNode? aiNode = JsonNode.Parse(aiJson);
            JsonNode? renderedNode = JsonNode.Parse(File.ReadAllText(renderedRequestPath));
            if (aiNode is not JsonObject aiRoot
                || renderedNode is not JsonObject renderedRoot
                || aiRoot["sheets"] is not JsonArray aiSheets
                || renderedRoot["sheets"] is not JsonArray renderedSheets)
            {
                return aiJson;
            }

            var renderedByIndex = new Dictionary<int, JsonObject>();
            var renderedByName = new Dictionary<string, JsonObject>(StringComparer.OrdinalIgnoreCase);
            foreach (JsonNode? renderedSheetNode in renderedSheets)
            {
                if (renderedSheetNode is not JsonObject renderedSheet) continue;
                int sheetIndex = NodeInt(renderedSheet["sheetIndex"]);
                string sheetName = NodeString(renderedSheet["sheetName"]);
                if (sheetIndex > 0) renderedByIndex[sheetIndex] = renderedSheet;
                if (!string.IsNullOrWhiteSpace(sheetName)) renderedByName[sheetName] = renderedSheet;
            }

            foreach (JsonNode? aiSheetNode in aiSheets)
            {
                if (aiSheetNode is not JsonObject aiSheet) continue;
                int sheetIndex = NodeInt(aiSheet["sheetIndex"]);
                string sheetName = NodeString(aiSheet["sheetName"]);
                JsonObject? renderedSheet = null;
                if (sheetIndex > 0) renderedByIndex.TryGetValue(sheetIndex, out renderedSheet);
                if (renderedSheet is null && !string.IsNullOrWhiteSpace(sheetName))
                    renderedByName.TryGetValue(sheetName, out renderedSheet);
                if (renderedSheet is null) continue;

                aiSheet["sourceUsedRange"] = CloneJsonNode(renderedSheet["usedRange"]);
                aiSheet["sourceEffectiveRange"] = CloneJsonNode(renderedSheet["effectiveRange"]);
                aiSheet["sheetMergedCells"] = BuildSheetMergedCells(renderedSheet);
                aiSheet["excelMergeSemantics"] = CloneJsonNode(renderedSheet["mergeSemantics"]);
                aiSheet["renderPolicy"] = CloneJsonNode(renderedSheet["renderPolicy"]);
                aiSheet["renderedChunks"] = BuildRenderedChunkSummaries(renderedSheet);
                aiSheet["textOnlyRanges"] = CloneJsonNode(renderedSheet["textOnlyRanges"]);
                aiSheet["shapes"] = CloneJsonNode(renderedSheet["shapes"]);
            }

            JsonArray notes = aiRoot["extractionNotes"] as JsonArray ?? new JsonArray();
            if (aiRoot["extractionNotes"] is not JsonArray)
                aiRoot["extractionNotes"] = notes;
            notes.Add("Excel source metadata was preserved after AI extraction: sourceUsedRange, sourceEffectiveRange, sheetMergedCells, excelMergeSemantics, renderedChunks, textOnlyRanges, and shapes.");

            return aiRoot.ToJsonString(new JsonSerializerOptions { WriteIndented = true });
        }
        catch
        {
            return aiJson;
        }
    }

    private static JsonNode? CloneJsonNode(JsonNode? node)
        => node is null ? null : JsonNode.Parse(node.ToJsonString());

    private static JsonArray BuildSheetMergedCells(JsonObject renderedSheet)
    {
        var result = new JsonArray();
        if (renderedSheet["mergedCells"] is not JsonArray mergedCells)
            return result;

        var semanticsByRange = new Dictionary<string, JsonObject>(StringComparer.OrdinalIgnoreCase);
        if (renderedSheet["mergeSemantics"] is JsonArray mergeSemantics)
        {
            foreach (JsonNode? semanticNode in mergeSemantics)
            {
                if (semanticNode is not JsonObject semantic) continue;
                string range = NodeString(semantic["range"]);
                if (!string.IsNullOrWhiteSpace(range))
                    semanticsByRange[range] = semantic;
            }
        }

        foreach (JsonNode? itemNode in mergedCells)
        {
            if (itemNode is not JsonObject item) continue;
            string range = NodeString(item["address"]);
            var merged = new JsonObject
            {
                ["range"] = range,
                ["address"] = range,
                ["text"] = NodeString(item["text"]),
                ["source"] = "excel",
                ["originalSource"] = NodeString(item["source"]),
                ["rowStart"] = NodeInt(item["rowStart"]),
                ["rowEnd"] = NodeInt(item["rowEnd"]),
                ["columnStart"] = NodeInt(item["columnStart"]),
                ["columnEnd"] = NodeInt(item["columnEnd"])
            };
            if (semanticsByRange.TryGetValue(range, out JsonObject? semantic))
            {
                merged["roleHint"] = NodeString(semantic["roleHint"]);
                merged["meaningHint"] = NodeString(semantic["meaningHint"]);
                merged["appliesTo"] = CloneJsonNode(semantic["appliesTo"]);
            }
            string fallbackSource = NodeString(item["fallbackSource"]);
            if (!string.IsNullOrWhiteSpace(fallbackSource))
                merged["fallbackSource"] = fallbackSource;
            result.Add(merged);
        }

        return result;
    }

    private static JsonArray BuildRenderedChunkSummaries(JsonObject renderedSheet)
    {
        var result = new JsonArray();
        if (renderedSheet["chunks"] is not JsonArray chunks)
            return result;

        foreach (JsonNode? chunkNode in chunks)
        {
            if (chunkNode is not JsonObject chunk) continue;
            result.Add(new JsonObject
            {
                ["chunkIndex"] = NodeInt(chunk["chunkIndex"]),
                ["kind"] = NodeString(chunk["kind"]),
                ["rangeAddress"] = NodeString(chunk["rangeAddress"]),
                ["rowStart"] = NodeInt(chunk["rowStart"]),
                ["rowEnd"] = NodeInt(chunk["rowEnd"]),
                ["columnStart"] = NodeInt(chunk["columnStart"]),
                ["columnEnd"] = NodeInt(chunk["columnEnd"]),
                ["reason"] = NodeString(chunk["reason"]),
                ["sourceRows"] = NodeString(chunk["sourceRows"]),
                ["sourceShape"] = NodeString(chunk["sourceShape"]),
                ["imageWidth"] = NodeInt(chunk["imageWidth"]),
                ["imageHeight"] = NodeInt(chunk["imageHeight"])
            });
        }

        return result;
    }

    private static string NodeString(JsonNode? node)
        => node is null ? "" : node.GetValueKind() == JsonValueKind.String ? node.GetValue<string>() ?? "" : node.ToString();

    private static int NodeInt(JsonNode? node)
    {
        if (node is null) return 0;
        try
        {
            if (node.GetValueKind() == JsonValueKind.Number)
                return node.GetValue<int>();
        }
        catch { }
        return int.TryParse(NodeString(node), out int value) ? value : 0;
    }

    private static string JsonString(JsonElement root, params string[] names)
    {
        foreach (string name in names)
        {
            if (!root.TryGetProperty(name, out JsonElement value)) continue;
            string text = value.ValueKind == JsonValueKind.String ? value.GetString() ?? "" : value.ToString();
            if (!string.IsNullOrWhiteSpace(text)) return text;
        }
        return "";
    }

    private static int JsonInt(JsonElement root, string name, int fallback = 0)
    {
        if (!root.TryGetProperty(name, out JsonElement value)) return fallback;
        if (value.ValueKind == JsonValueKind.Number && value.TryGetInt32(out int n)) return n;
        return int.TryParse(value.ToString(), out n) ? n : fallback;
    }

    private static bool JsonBool(JsonElement root, string name, bool fallback = false)
    {
        if (!root.TryGetProperty(name, out JsonElement value)) return fallback;
        if (value.ValueKind is JsonValueKind.True or JsonValueKind.False) return value.GetBoolean();
        return bool.TryParse(value.ToString(), out bool b) ? b : fallback;
    }

    private static bool TryLaunchCodexTerminal(string workDir, string prompt, string title, string outputPath, string donePath)
    {
        string launchId = Guid.NewGuid().ToString("N")[..12];
        string promptPath = Path.Combine(workDir, $"_input_data_test_prompt_codex_{launchId}.txt");
        string scriptPath = Path.Combine(workDir, $"_input_data_test_launch_codex_{launchId}.ps1");

        try
        {
            File.WriteAllText(promptPath, prompt, new UTF8Encoding(encoderShouldEmitUTF8Identifier: false));
            File.WriteAllText(
                scriptPath,
                BuildCodexLauncherScript(workDir, promptPath, scriptPath, title, outputPath, donePath),
                new UTF8Encoding(encoderShouldEmitUTF8Identifier: false));
        }
        catch
        {
            return false;
        }

        try
        {
            var wt = new ProcessStartInfo
            {
                FileName = "wt.exe",
                UseShellExecute = false,
                CreateNoWindow = false,
            };
            wt.ArgumentList.Add("-d");
            wt.ArgumentList.Add(workDir);
            wt.ArgumentList.Add("powershell.exe");
            wt.ArgumentList.Add("-NoExit");
            wt.ArgumentList.Add("-NoProfile");
            wt.ArgumentList.Add("-ExecutionPolicy");
            wt.ArgumentList.Add("Bypass");
            wt.ArgumentList.Add("-File");
            wt.ArgumentList.Add(scriptPath);
            var proc = Process.Start(wt);
            if (proc is not null) ChildProcessJob.Assign(proc);
            return proc is not null;
        }
        catch { }

        try
        {
            var psi = new ProcessStartInfo
            {
                FileName = "cmd.exe",
                WorkingDirectory = workDir,
                UseShellExecute = false,
                CreateNoWindow = false,
            };
            psi.ArgumentList.Add("/k");
            psi.ArgumentList.Add("powershell.exe");
            psi.ArgumentList.Add("-NoExit");
            psi.ArgumentList.Add("-NoProfile");
            psi.ArgumentList.Add("-ExecutionPolicy");
            psi.ArgumentList.Add("Bypass");
            psi.ArgumentList.Add("-File");
            psi.ArgumentList.Add(scriptPath);
            var proc = Process.Start(psi);
            if (proc is not null) ChildProcessJob.Assign(proc);
            return proc is not null;
        }
        catch
        {
            return false;
        }
    }

    private static string BuildCodexLauncherScript(string workDir, string promptPath, string scriptPath, string title, string outputPath, string donePath)
    {
        static string Q(string value) => "'" + (value ?? "").Replace("'", "''") + "'";
        return string.Join(Environment.NewLine, new[]
        {
            "$ErrorActionPreference = 'Continue'",
            "$utf8NoBom = New-Object System.Text.UTF8Encoding -ArgumentList $false",
            "[Console]::InputEncoding = $utf8NoBom",
            "[Console]::OutputEncoding = $utf8NoBom",
            "$OutputEncoding = $utf8NoBom",
            "try { chcp 65001 | Out-Null } catch {}",
            $"try {{ $Host.UI.RawUI.WindowTitle = {Q(title)} }} catch {{}}",
            $"Set-Location -LiteralPath {Q(workDir)}",
            "",
            $"$promptPath = {Q(promptPath)}",
            $"$scriptPath = {Q(scriptPath)}",
            $"$outputPath = {Q(outputPath)}",
            $"$donePath = {Q(donePath)}",
            "Remove-Item -LiteralPath $outputPath -Force -ErrorAction SilentlyContinue",
            "Remove-Item -LiteralPath $donePath -Force -ErrorAction SilentlyContinue",
            "$prompt = Get-Content -LiteralPath $promptPath -Raw -Encoding UTF8",
            "$exitCode = 0",
            "try {",
            $"    $prompt | & codex exec -c 'model_reasoning_effort=\"xhigh\"' --cd {Q(workDir)} --dangerously-bypass-approvals-and-sandbox --skip-git-repo-check --color never --output-last-message $outputPath -",
            "    $exitCode = if ($null -eq $LASTEXITCODE) { 0 } else { $LASTEXITCODE }",
            "} catch {",
            "    $exitCode = 1",
            "    $_ | Out-String | Tee-Object -FilePath $outputPath -Append",
            "}",
            "if ($exitCode -ne 0) {",
            "    Write-Host ('Codex exited with code ' + $exitCode + '.') -ForegroundColor Yellow",
            "}",
            "$done = @{ exitCode = $exitCode; completedAt = [DateTime]::UtcNow.ToString('o') } | ConvertTo-Json -Compress",
            "Set-Content -LiteralPath $donePath -Value $done -Encoding UTF8",
            "Remove-Item -LiteralPath $promptPath -Force -ErrorAction SilentlyContinue",
            "Remove-Item -LiteralPath $scriptPath -Force -ErrorAction SilentlyContinue",
        });
    }

    private static int ReadExitCode(string doneJson)
    {
        try
        {
            using JsonDocument doc = JsonDocument.Parse(doneJson);
            if (doc.RootElement.TryGetProperty("exitCode", out JsonElement exit)
                && exit.ValueKind == JsonValueKind.Number
                && exit.TryGetInt32(out int value))
            {
                return value;
            }
        }
        catch { }
        return 0;
    }

    private static string ReadAiStructureProgress(string progressPath, string elapsedText = "")
    {
        try
        {
            if (string.IsNullOrWhiteSpace(progressPath) || !File.Exists(progressPath))
                return "";

            using JsonDocument doc = JsonDocument.Parse(File.ReadAllText(progressPath));
            JsonElement root = doc.RootElement;
            string stage = JsonString(root, "stage");
            string message = JsonString(root, "message");
            string elapsed = string.IsNullOrWhiteSpace(elapsedText)
                ? JsonString(root, "elapsed")
                : elapsedText;
            int percent = JsonInt(root, "percent");

            var parts = new List<string>();
            if (!string.IsNullOrWhiteSpace(stage)) parts.Add(stage);
            if (percent > 0) parts.Add($"{percent}%");
            if (!string.IsNullOrWhiteSpace(message)) parts.Add(message);
            if (!string.IsNullOrWhiteSpace(elapsed)) parts.Add(elapsed);
            return parts.Count == 0 ? "" : $"AI structure extraction: {string.Join(" - ", parts)}";
        }
        catch
        {
            return "";
        }
    }

    private static string FormatElapsedSince(DateTimeOffset? startedAt)
        => startedAt is null ? "00:00:00" : FormatElapsed(DateTimeOffset.Now - startedAt.Value);

    private static string FormatElapsed(TimeSpan elapsed)
    {
        if (elapsed < TimeSpan.Zero)
            elapsed = TimeSpan.Zero;

        int totalHours = (int)Math.Floor(elapsed.TotalHours);
        return $"{totalHours:00}:{elapsed.Minutes:00}:{elapsed.Seconds:00}";
    }

    private static int CountRenderedImages(string renderedRequestPath)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(renderedRequestPath) || !File.Exists(renderedRequestPath))
                return 0;

            using JsonDocument doc = JsonDocument.Parse(File.ReadAllText(renderedRequestPath));
            if (!doc.RootElement.TryGetProperty("sheets", out JsonElement sheets)
                || sheets.ValueKind != JsonValueKind.Array)
            {
                return 0;
            }

            int count = 0;
            foreach (JsonElement sheet in sheets.EnumerateArray())
            {
                if (!sheet.TryGetProperty("chunks", out JsonElement chunks)
                    || chunks.ValueKind != JsonValueKind.Array)
                {
                    continue;
                }

                foreach (JsonElement chunk in chunks.EnumerateArray())
                {
                    if (string.IsNullOrWhiteSpace(JsonString(chunk, "imagePath"))) continue;
                    count++;
                }
            }

            return count;
        }
        catch
        {
            return 0;
        }
    }

    private static bool TryBuildAiStructureFallbackJson(string renderedRequestPath, string failureText, out string json)
    {
        json = "";
        try
        {
            if (string.IsNullOrWhiteSpace(renderedRequestPath) || !File.Exists(renderedRequestPath))
                return false;

            using JsonDocument renderedDoc = JsonDocument.Parse(File.ReadAllText(renderedRequestPath));
            JsonElement root = renderedDoc.RootElement;
            if (!root.TryGetProperty("sheets", out JsonElement sheets)
                || sheets.ValueKind != JsonValueKind.Array)
            {
                return false;
            }

            var sheetPayloads = new List<object>();
            foreach (JsonElement sheet in sheets.EnumerateArray())
            {
                int sheetIndex = JsonInt(sheet, "sheetIndex");
                string sheetName = JsonString(sheet, "sheetName");
                var chunksRead = new List<int>();
                if (sheet.TryGetProperty("chunks", out JsonElement chunks)
                    && chunks.ValueKind == JsonValueKind.Array)
                {
                    foreach (JsonElement chunk in chunks.EnumerateArray())
                    {
                        int chunkIndex = JsonInt(chunk, "chunkIndex");
                        if (chunkIndex > 0) chunksRead.Add(chunkIndex);
                    }
                }

                string sourceRange = BuildFallbackSourceRange(sheet);
                var visibleText = new List<object>();
                var cellRows = new List<string[]>();
                if (sheet.TryGetProperty("programExtract", out JsonElement programExtract)
                    && programExtract.TryGetProperty("cells", out JsonElement cells)
                    && cells.ValueKind == JsonValueKind.Array)
                {
                    int order = 1;
                    foreach (JsonElement cell in cells.EnumerateArray())
                    {
                        string text = JsonString(cell, "text");
                        if (string.IsNullOrWhiteSpace(text)) continue;

                        string address = JsonString(cell, "address");
                        int row = JsonInt(cell, "row");
                        int column = JsonInt(cell, "column");
                        cellRows.Add([address, row.ToString(), column.ToString(), text]);

                        if (visibleText.Count < 250)
                        {
                            visibleText.Add(new
                            {
                                order = order,
                                role = InferFallbackTextRole(text),
                                text
                            });
                        }
                        order++;
                    }
                }

                var mergedCells = new List<object>();
                if (sheet.TryGetProperty("mergedCells", out JsonElement merged)
                    && merged.ValueKind == JsonValueKind.Array)
                {
                    foreach (JsonElement item in merged.EnumerateArray())
                    {
                        string range = JsonString(item, "address", "range");
                        int rowStart = JsonInt(item, "rowStart");
                        int rowEnd = JsonInt(item, "rowEnd");
                        int colStart = JsonInt(item, "columnStart");
                        int colEnd = JsonInt(item, "columnEnd");
                        mergedCells.Add(new
                        {
                            text = JsonString(item, "text"),
                            range,
                            source = "excel",
                            meaning = "Excel merged range from rendered request",
                            appliesTo = new[] { $"rows {rowStart}-{rowEnd}, columns {colStart}-{colEnd}" }
                        });
                    }
                }

                sheetPayloads.Add(new
                {
                    sheetIndex,
                    sheetName,
                    chunksRead,
                    visibleText,
                    sections = Array.Empty<object>(),
                    tables = new[]
                    {
                        new
                        {
                            title = "ProgramExtract visible cells",
                            sourceRange,
                            layout = new
                            {
                                headerRows = Array.Empty<string[]>(),
                                bodyRows = Array.Empty<string[]>()
                            },
                            mergedCells,
                            normalizedRows = Array.Empty<object>(),
                            headers = new[] { "Address", "Row", "Column", "Text" },
                            rows = cellRows,
                            notes = new[]
                            {
                                "Fallback structure generated because Codex CLI did not return valid Step 1 JSON.",
                                "Exact programExtract cell text and Excel merged ranges are preserved; image-assisted grouping and normalizedRows were not generated."
                            }
                        }
                    },
                    unreadableAreas = Array.Empty<string>()
                });
            }

            var notes = new List<string>
            {
                "Codex CLI returned a non-zero exit during image-assisted extraction; fallback uses rendered-request programExtract cells and mergedCells."
            };
            string shortFailure = ShortFailureText(failureText);
            if (!string.IsNullOrWhiteSpace(shortFailure))
                notes.Add(shortFailure);

            var payload = new
            {
                fileName = JsonString(root, "fileName"),
                sheets = sheetPayloads,
                extractionNotes = notes
            };

            json = JsonSerializer.Serialize(payload, new JsonSerializerOptions { WriteIndented = true });
            return true;
        }
        catch
        {
            json = "";
            return false;
        }
    }

    private static string BuildFallbackSourceRange(JsonElement sheet)
    {
        if (!sheet.TryGetProperty("usedRange", out JsonElement usedRange)
            || usedRange.ValueKind != JsonValueKind.Object)
        {
            return "programExtract visible cells";
        }

        int rowStart = JsonInt(usedRange, "rowStart");
        int rowEnd = JsonInt(usedRange, "rowEnd");
        int columnStart = JsonInt(usedRange, "columnStart");
        int columnEnd = JsonInt(usedRange, "columnEnd");
        return $"usedRange R{rowStart}C{columnStart}:R{rowEnd}C{columnEnd}";
    }

    private static string InferFallbackTextRole(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return "other";
        string trimmed = text.Trim();
        if (trimmed.StartsWith("I.", StringComparison.OrdinalIgnoreCase)
            || trimmed.StartsWith("II.", StringComparison.OrdinalIgnoreCase)
            || trimmed.StartsWith("III.", StringComparison.OrdinalIgnoreCase)
            || trimmed.Contains("Purpose", StringComparison.OrdinalIgnoreCase)
            || trimmed.Contains("Result", StringComparison.OrdinalIgnoreCase))
        {
            return "section_header";
        }
        if (trimmed.Length >= 20) return "paragraph";
        return "table_text";
    }

    private static string ShortFailureText(string failureText)
    {
        string text = (failureText ?? "").Trim();
        if (string.IsNullOrWhiteSpace(text)) return "";
        text = text.Replace("\r", " ").Replace("\n", " ");
        while (text.Contains("  ", StringComparison.Ordinal))
            text = text.Replace("  ", " ");
        const int maxLength = 500;
        return text.Length <= maxLength ? $"Codex failure excerpt: {text}" : $"Codex failure excerpt: {text[..maxLength]}...";
    }

    private static string AiStructureJsonToText(JsonElement root)
    {
        var sb = new StringBuilder();
        sb.AppendLine("# AI Excel Structure Extraction");

        string fileName = JsonString(root, "fileName");
        if (!string.IsNullOrWhiteSpace(fileName))
            sb.AppendLine($"File: {FlattenStructureText(fileName)}");

        if (!root.TryGetProperty("sheets", out JsonElement sheets)
            || sheets.ValueKind != JsonValueKind.Array)
        {
            sb.AppendLine();
            sb.AppendLine("## Raw JSON");
            sb.AppendLine(root.ToString());
            return sb.ToString().TrimEnd() + Environment.NewLine;
        }

        foreach (JsonElement sheet in sheets.EnumerateArray())
        {
            int sheetIndex = JsonInt(sheet, "sheetIndex");
            string sheetName = JsonString(sheet, "sheetName");
            string heading = sheetIndex > 0
                ? $"## Sheet {sheetIndex}: {FlattenStructureText(sheetName)}"
                : $"## Sheet: {FlattenStructureText(sheetName)}";
            sb.AppendLine();
            sb.AppendLine(heading.TrimEnd());

            var chunksRead = JsonStringArray(sheet, "chunksRead");
            if (chunksRead.Count > 0)
                sb.AppendLine($"Chunks read: {string.Join(", ", chunksRead)}");

            AppendSheetSourceMetadataText(sb, sheet);
            AppendVisibleText(sb, sheet);
            AppendSections(sb, sheet);
            AppendTables(sb, sheet);
            AppendNamedStringArray(sb, sheet, "unreadableAreas", "Unreadable Areas");
        }

        AppendNamedStringArray(sb, root, "extractionNotes", "Extraction Notes");

        return sb.ToString().TrimEnd() + Environment.NewLine;
    }

    private static string LoadAiStructureHtml(string jsonPath)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(jsonPath) || !File.Exists(jsonPath)) return "";
            using JsonDocument doc = JsonDocument.Parse(File.ReadAllText(jsonPath));
            return AiStructureJsonToHtml(doc.RootElement);
        }
        catch
        {
            return "";
        }
    }

    private static string AiStructureJsonToHtml(JsonElement root)
    {
        static string H(string value) => System.Net.WebUtility.HtmlEncode(value ?? "");

        var sb = new StringBuilder();
        string fileName = JsonString(root, "fileName");
        sb.Append("<h2>Step 1 Extracted Excel Data</h2>");
        if (!string.IsNullOrWhiteSpace(fileName))
            sb.Append("<p><strong>File:</strong> ").Append(H(fileName)).Append("</p>");

        if (!root.TryGetProperty("sheets", out JsonElement sheets)
            || sheets.ValueKind != JsonValueKind.Array)
        {
            sb.Append("<p>No sheet structure was returned.</p>");
            return sb.ToString();
        }

        foreach (JsonElement sheet in sheets.EnumerateArray())
        {
            int sheetIndex = JsonInt(sheet, "sheetIndex");
            string sheetName = JsonString(sheet, "sheetName");
            sb.Append("<div class=\"sheet-block\">");
            sb.Append("<h3>Sheet ");
            if (sheetIndex > 0) sb.Append(sheetIndex).Append(" - ");
            sb.Append(H(sheetName)).Append("</h3>");

            AppendSheetSourceMetadataHtml(sb, sheet);

            if (sheet.TryGetProperty("visibleText", out JsonElement texts)
                && texts.ValueKind == JsonValueKind.Array)
            {
                sb.Append("<ul class=\"text-list\">");
                foreach (JsonElement item in texts.EnumerateArray())
                {
                    string text = JsonString(item, "text");
                    if (string.IsNullOrWhiteSpace(text)) continue;
                    string role = JsonString(item, "role");
                    sb.Append("<li>");
                    if (!string.IsNullOrWhiteSpace(role))
                        sb.Append("<strong>").Append(H(role)).Append(":</strong> ");
                    sb.Append(H(text)).Append("</li>");
                }
                sb.Append("</ul>");
            }

            if (sheet.TryGetProperty("sections", out JsonElement sections)
                && sections.ValueKind == JsonValueKind.Array)
            {
                foreach (JsonElement section in sections.EnumerateArray())
                {
                    string title = JsonString(section, "title");
                    if (!string.IsNullOrWhiteSpace(title))
                        sb.Append("<p><strong>").Append(H(title)).Append("</strong></p>");

                    var body = JsonStringArray(section, "body");
                    if (body.Count == 0) continue;
                    sb.Append("<ul class=\"text-list\">");
                    foreach (string line in body)
                        sb.Append("<li>").Append(H(line)).Append("</li>");
                    sb.Append("</ul>");
                }
            }

            if (sheet.TryGetProperty("tables", out JsonElement tables)
                && tables.ValueKind == JsonValueKind.Array)
            {
                foreach (JsonElement table in tables.EnumerateArray())
                {
                    AppendAiTableHtml(sb, table);
                }
            }

            var unreadable = JsonStringArray(sheet, "unreadableAreas");
            if (unreadable.Count > 0)
            {
                sb.Append("<p><strong>Unreadable areas</strong></p><ul class=\"text-list\">");
                foreach (string item in unreadable)
                    sb.Append("<li>").Append(H(item)).Append("</li>");
                sb.Append("</ul>");
            }

            sb.Append("</div>");
        }

        var notesRoot = JsonStringArray(root, "extractionNotes");
        if (notesRoot.Count > 0)
        {
            sb.Append("<h3>Extraction Notes</h3><ul class=\"text-list\">");
            foreach (string note in notesRoot)
                sb.Append("<li>").Append(H(note)).Append("</li>");
            sb.Append("</ul>");
        }

        return sb.ToString();
    }

    private static void AppendSheetSourceMetadataHtml(StringBuilder sb, JsonElement sheet)
    {
        static string H(string value) => System.Net.WebUtility.HtmlEncode(value ?? "");

        if (sheet.TryGetProperty("sheetMergedCells", out JsonElement mergedCells)
            && mergedCells.ValueKind == JsonValueKind.Array
            && mergedCells.GetArrayLength() > 0)
        {
            sb.Append("<p><strong>Excel merged cells preserved:</strong> ")
                .Append(mergedCells.GetArrayLength())
                .Append("</p><ul class=\"text-list\">");
            foreach (JsonElement item in mergedCells.EnumerateArray())
                sb.Append("<li>").Append(H(JsonObjectOneLine(item))).Append("</li>");
            sb.Append("</ul>");
        }

        if (sheet.TryGetProperty("renderedChunks", out JsonElement chunks)
            && chunks.ValueKind == JsonValueKind.Array
            && chunks.GetArrayLength() > 0)
        {
            sb.Append("<p><strong>Rendered PNG regions</strong></p><ul class=\"text-list\">");
            foreach (JsonElement item in chunks.EnumerateArray())
                sb.Append("<li>").Append(H(JsonObjectOneLine(item))).Append("</li>");
            sb.Append("</ul>");
        }
    }

    private static void AppendAiTableHtml(StringBuilder sb, JsonElement table)
    {
        static string H(string value) => System.Net.WebUtility.HtmlEncode(value ?? "");

        string title = JsonString(table, "title");
        if (!string.IsNullOrWhiteSpace(title))
            sb.Append("<h3>").Append(H(title)).Append("</h3>");

        bool renderedLayout = false;
        if (table.TryGetProperty("layout", out JsonElement layout) && layout.ValueKind == JsonValueKind.Object)
        {
            var headerRows = JsonStringMatrix(layout, "headerRows");
            var bodyRows = JsonStringMatrix(layout, "bodyRows");
            if (headerRows.Count > 0 || bodyRows.Count > 0)
            {
                renderedLayout = true;
                sb.Append("<p><strong>Original layout</strong></p><table>");
                if (headerRows.Count > 0)
                {
                    sb.Append("<thead>");
                    foreach (var row in headerRows)
                    {
                        sb.Append("<tr>");
                        foreach (string cell in row)
                            sb.Append("<th>").Append(H(cell)).Append("</th>");
                        sb.Append("</tr>");
                    }
                    sb.Append("</thead>");
                }

                sb.Append("<tbody>");
                foreach (var row in bodyRows)
                {
                    sb.Append("<tr>");
                    foreach (string cell in row)
                        sb.Append("<td>").Append(H(cell)).Append("</td>");
                    sb.Append("</tr>");
                }
                sb.Append("</tbody></table>");
            }
        }

        if (table.TryGetProperty("mergedCells", out JsonElement mergedCells)
            && mergedCells.ValueKind == JsonValueKind.Array
            && mergedCells.GetArrayLength() > 0)
        {
            sb.Append("<p><strong>Merged cell meaning</strong></p><ul class=\"text-list\">");
            foreach (JsonElement item in mergedCells.EnumerateArray())
                sb.Append("<li>").Append(H(JsonObjectOneLine(item))).Append("</li>");
            sb.Append("</ul>");
        }

        if (table.TryGetProperty("normalizedRows", out JsonElement normalizedRows)
            && normalizedRows.ValueKind == JsonValueKind.Array
            && normalizedRows.GetArrayLength() > 0)
        {
            sb.Append("<p><strong>AI-readable normalized rows</strong></p>");
            AppendJsonObjectArrayHtml(sb, normalizedRows);
        }

        if (!renderedLayout)
            AppendFallbackFlatTableHtml(sb, table);

        var notes = JsonStringArray(table, "notes");
        if (notes.Count > 0)
        {
            sb.Append("<ul class=\"text-list\">");
            foreach (string note in notes)
                sb.Append("<li>").Append(H(note)).Append("</li>");
            sb.Append("</ul>");
        }
    }

    private static void AppendFallbackFlatTableHtml(StringBuilder sb, JsonElement table)
    {
        static string H(string value) => System.Net.WebUtility.HtmlEncode(value ?? "");

        var headers = JsonStringArray(table, "headers");
        sb.Append("<table>");
        if (headers.Count > 0)
        {
            sb.Append("<thead><tr>");
            foreach (string header in headers)
                sb.Append("<th>").Append(H(header)).Append("</th>");
            sb.Append("</tr></thead>");
        }

        sb.Append("<tbody>");
        if (table.TryGetProperty("rows", out JsonElement rows) && rows.ValueKind == JsonValueKind.Array)
        {
            foreach (JsonElement row in rows.EnumerateArray())
            {
                sb.Append("<tr>");
                var cells = row.ValueKind == JsonValueKind.Array
                    ? row.EnumerateArray().Select(JsonValueText).ToList()
                    : new List<string> { JsonValueText(row) };

                int minCells = Math.Max(headers.Count, cells.Count);
                for (int i = 0; i < minCells; i++)
                {
                    string cell = i < cells.Count ? cells[i] : "";
                    sb.Append("<td>").Append(H(cell)).Append("</td>");
                }
                sb.Append("</tr>");
            }
        }
        sb.Append("</tbody></table>");
    }

    private static void AppendJsonObjectArrayHtml(StringBuilder sb, JsonElement rows)
    {
        static string H(string value) => System.Net.WebUtility.HtmlEncode(value ?? "");

        var columns = new List<string>();
        foreach (JsonElement row in rows.EnumerateArray())
        {
            if (row.ValueKind != JsonValueKind.Object) continue;
            foreach (JsonProperty property in row.EnumerateObject())
            {
                if (!columns.Contains(property.Name, StringComparer.OrdinalIgnoreCase))
                    columns.Add(property.Name);
            }
        }

        if (columns.Count == 0)
        {
            sb.Append("<ul class=\"text-list\">");
            foreach (JsonElement row in rows.EnumerateArray())
                sb.Append("<li>").Append(H(JsonValueText(row))).Append("</li>");
            sb.Append("</ul>");
            return;
        }

        sb.Append("<table><thead><tr>");
        foreach (string column in columns)
            sb.Append("<th>").Append(H(column)).Append("</th>");
        sb.Append("</tr></thead><tbody>");

        foreach (JsonElement row in rows.EnumerateArray())
        {
            sb.Append("<tr>");
            foreach (string column in columns)
            {
                string text = "";
                if (row.ValueKind == JsonValueKind.Object
                    && row.TryGetProperty(column, out JsonElement value))
                {
                    text = JsonInlineText(value);
                }
                sb.Append("<td>").Append(H(text)).Append("</td>");
            }
            sb.Append("</tr>");
        }
        sb.Append("</tbody></table>");
    }

    private static void WriteAiStructureSheetFiles(JsonElement root, string structureDir)
    {
        try
        {
            if (!root.TryGetProperty("sheets", out JsonElement sheets)
                || sheets.ValueKind != JsonValueKind.Array)
            {
                return;
            }

            string sheetDir = Path.Combine(structureDir, "sheets");
            string tableDir = Path.Combine(structureDir, "tables");
            Directory.CreateDirectory(sheetDir);
            Directory.CreateDirectory(tableDir);
            foreach (JsonElement sheet in sheets.EnumerateArray())
            {
                int sheetIndex = JsonInt(sheet, "sheetIndex");
                string sheetName = JsonString(sheet, "sheetName");
                string stem = SafeFileName($"sheet_{sheetIndex:00}_{sheetName}");
                if (string.IsNullOrWhiteSpace(stem)) stem = $"sheet_{sheetIndex:00}";

                File.WriteAllText(
                    Path.Combine(sheetDir, $"{stem}.json"),
                    JsonSerializer.Serialize(sheet, new JsonSerializerOptions { WriteIndented = true }),
                    new UTF8Encoding(encoderShouldEmitUTF8Identifier: false));
                File.WriteAllText(
                    Path.Combine(sheetDir, $"{stem}.txt"),
                    AiStructureSheetToText(sheet),
                    new UTF8Encoding(encoderShouldEmitUTF8Identifier: false));

                if (!sheet.TryGetProperty("tables", out JsonElement tables)
                    || tables.ValueKind != JsonValueKind.Array)
                {
                    continue;
                }

                int tableIndex = 1;
                foreach (JsonElement table in tables.EnumerateArray())
                {
                    string tableTitle = JsonString(table, "title");
                    string tableStem = SafeFileName($"sheet_{sheetIndex:00}_table_{tableIndex:00}_{tableTitle}");
                    if (string.IsNullOrWhiteSpace(tableStem))
                        tableStem = $"sheet_{sheetIndex:00}_table_{tableIndex:00}";

                    File.WriteAllText(
                        Path.Combine(tableDir, $"{tableStem}.json"),
                        JsonSerializer.Serialize(table, new JsonSerializerOptions { WriteIndented = true }),
                        new UTF8Encoding(encoderShouldEmitUTF8Identifier: false));
                    File.WriteAllText(
                        Path.Combine(tableDir, $"{tableStem}.txt"),
                        AiStructureTableToText(table),
                        new UTF8Encoding(encoderShouldEmitUTF8Identifier: false));
                    tableIndex++;
                }
            }
        }
        catch
        {
            // Sheet-level files are helpful for inspection, but the main JSON/TXT is the source of truth.
        }
    }

    private static string AiStructureSheetToText(JsonElement sheet)
    {
        var sb = new StringBuilder();
        int sheetIndex = JsonInt(sheet, "sheetIndex");
        string sheetName = JsonString(sheet, "sheetName");
        sb.AppendLine(sheetIndex > 0
            ? $"# Sheet {sheetIndex}: {FlattenStructureText(sheetName)}"
            : $"# Sheet: {FlattenStructureText(sheetName)}");
        AppendVisibleText(sb, sheet);
        AppendSections(sb, sheet);
        AppendTables(sb, sheet);
        AppendNamedStringArray(sb, sheet, "unreadableAreas", "Unreadable Areas");
        return sb.ToString().TrimEnd() + Environment.NewLine;
    }

    private static string AiStructureTableToText(JsonElement table)
    {
        var sb = new StringBuilder();
        string title = JsonString(table, "title");
        sb.AppendLine(string.IsNullOrWhiteSpace(title)
            ? "# Table"
            : $"# {FlattenStructureText(title)}");

        AppendTableLayoutText(sb, table);
        AppendMergedCellsText(sb, table);
        AppendNormalizedRowsText(sb, table);

        var headers = JsonStringArray(table, "headers");
        if (headers.Count > 0)
            sb.AppendLine("Headers\t" + string.Join('\t', headers));

        if (table.TryGetProperty("rows", out JsonElement rows) && rows.ValueKind == JsonValueKind.Array)
        {
            int rowNo = 1;
            foreach (JsonElement row in rows.EnumerateArray())
            {
                var cells = row.ValueKind == JsonValueKind.Array
                    ? row.EnumerateArray().Select(JsonValueText).ToList()
                    : new List<string> { JsonValueText(row) };
                sb.AppendLine($"R{rowNo}\t{string.Join('\t', cells)}");
                rowNo++;
            }
        }

        var notes = JsonStringArray(table, "notes");
        foreach (string note in notes)
            sb.AppendLine($"Note\t{note}");

        return sb.ToString().TrimEnd() + Environment.NewLine;
    }

