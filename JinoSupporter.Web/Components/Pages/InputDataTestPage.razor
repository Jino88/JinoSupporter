        string Text,
        int SheetCount,
        int RowCount,
        int CellCount,
        bool Truncated);

    private sealed record StepResult(string AnalysisText, string AnalysisHtml, string Error);

    private sealed record MarkdownSection(string Title, string Content);

    private sealed record AutoPromptPayload(
        string Key,
        string Title,
        string Description,
        string SourceLabel,
        string Content);

    private sealed record SavedSessionInfo(string Path, string Label);

    private sealed record AutoPromptStorage(
        string Key,
        string Title,
        string Description,
        string SourceLabel,
        string Content,
        bool Enabled,
        bool IsCustom);

    private sealed class AutoPromptOption(
        string key,
        string title,
        string description,
        string sourceLabel,
        string sourcePath,
        string content,
        bool enabled,
        bool isCustom = false)
    {
        public string Key { get; } = key;
        public string Title { get; } = title;
        public string Description { get; } = description;
        public string SourceLabel { get; } = sourceLabel;
        public string SourcePath { get; } = sourcePath;
        public string Content { get; } = content;
        public bool Enabled { get; set; } = enabled;
        public bool IsCustom { get; } = isCustom;
    }

