    private static List<AutoPromptOption> LoadAutoPromptOptions()
    {
        string libraryPath = AutoPromptLibraryPath();
        MigrateLegacyAutoPromptLibraryIfNeeded(libraryPath);
        if (File.Exists(libraryPath))
        {
            return LoadAutoPromptLibrary(libraryPath);
        }

        _ = SaveAutoPromptLibrary([]);
        return [];
    }

    private static List<AutoPromptOption> BuildDefaultAutoPromptOptions()
    {
        var options = new List<AutoPromptOption>();
        EnsureBuiltInAutoPrompts(options);

        string path = AiPromptRegistry.ResolvePath("data-inference/ai-excel-proc.md");
        if (!File.Exists(path))
        {
            options.Add(new AutoPromptOption(
                "md_missing",
                "ai-excel-proc.md not found",
                "Missing MD file.",
                "Preset",
                "",
                $"Missing file: {path}",
                false));
            return options;
        }

        string markdown = File.ReadAllText(path);
        foreach (MarkdownSection section in SplitMarkdownSections(markdown))
        {
            string title = string.IsNullOrWhiteSpace(section.Title)
                ? "ai-excel-proc.md"
                : section.Title.Trim();
            options.Add(new AutoPromptOption(
                $"md_{Slug(title)}",
                title,
                ShortAutoPromptDescription(title, section.Content),
                "Preset",
                "",
                section.Content,
                IsDefaultAutoPromptSection(title)));
        }

        return options;
    }

