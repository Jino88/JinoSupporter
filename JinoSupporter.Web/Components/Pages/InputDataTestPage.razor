    private string _excelTextPath = "";
    private string _excelText = "";
    private string _aiStructureDir = "";
    private string _aiStructureJsonPath = "";
    private string _aiStructureTextPath = "";
    private string _aiStructureRenderedRequestPath = "";
    private string _aiStructureCompletedAt = "";
    private string _aiStructureHtml = "";
    private string _lastSavedPath = "";
