@rendermode InteractiveServer
@implements IAsyncDisposable
@using ClosedXML.Excel
@using System.Diagnostics
@using System.Text
@using System.Text.Json
@using System.Text.Json.Nodes
@inject AiProviderSettingsService AiProviders
@inject AppActivityLogger ActivityLog
@inject IJSRuntime JS

<PageTitle>INPUT DATA (TEST)</PageTitle>

<div class="idt-root">
    <aside class="idt-left">
        <div class="idt-head">
            <div>
                <div class="idt-kicker">TEST DATA ANALYSIS</div>
                <h1>INPUT DATA (TEST)</h1>
            </div>
            <button class="idt-icon-btn" title="Reset" @onclick="ResetAll" disabled="@_isBusy">R</button>
        </div>

        <label class="idt-drop @(HasWorkbook ? "has-file" : "")">
            <InputFile OnChange="OnExcelSelected"
                       accept=".xlsx,.xlsm"
                       disabled="@_isBusy"
                       class="idt-file-input" />
            <span class="idt-drop-icon">XLSX</span>
            <span class="idt-drop-title">Excel</span>
            <span class="idt-drop-name">@WorkbookLabel</span>
        </label>

        @if (HasWorkbook)
        {
            <div class="idt-file-meta">
                <span>@_sheetCount sheet</span>
                <span>@_rowCount row</span>
                <span>@_cellCount cell</span>
                @if (_excelTextTruncated)
                {
                    <span class="idt-warn">truncated</span>
                }
            </div>

            <div class="idt-extract-card @(HasAiStructure ? "ready" : "")">
                <button class="btn btn-outline-primary btn-sm"
                        type="button"
                        @onclick="RunFileExtractionAsync"
                        disabled="@(_isBusy || !AiProviders.CodexCliEnabled || !HasWorkbook)">
                    @if (_isStructureExtracting)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    Step 1 Extract
                </button>
                <div class="idt-extract-info">
                    <strong>@AiStructureStatusLabel</strong>
                    @if (!string.IsNullOrWhiteSpace(_aiStructureTextPath))
                    {
                        <span title="@_aiStructureTextPath">@Path.GetFileName(_aiStructureTextPath)</span>
                    }
                </div>
            </div>
        }

        <section class="idt-left-section">
            <label class="idt-label" for="idt-purpose">검토 목적</label>
            <textarea id="idt-purpose"
                      class="idt-textarea purpose"
                      @bind="_reviewPurpose"
                      @bind:event="oninput"
                      disabled="@_isBusy"
                      placeholder="예: 변경 조건 영향, NG 증가 원인, 공정별 위험도, 다음 액션"></textarea>
        </section>

        <section class="idt-left-section">
            <label class="idt-label" for="idt-context">기준 / 메모</label>
            <textarea id="idt-context"
                      class="idt-textarea context"
                      @bind="_reviewContext"
                      @bind:event="oninput"
                      disabled="@_isBusy"
                      placeholder="제품, 기간, 비교 기준, 반드시 봐야 할 항목"></textarea>
        </section>

        @if (!AiProviders.CodexCliEnabled)
        {
            <div class="idt-status error">
                Codex CLI is disabled.
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(_status))
        {
            <div class="idt-status @(_statusError ? "error" : "ok")">@_status</div>
        }
    </aside>

    <main class="idt-main">
        <div class="idt-mainbar">
            <div>
                <div class="idt-title">Sequential AI Analysis</div>
                <div class="idt-subtitle">@StepSummary</div>
            </div>
            <div class="idt-main-actions">
                <select class="form-select form-select-sm idt-session-select"
                        value="@_selectedSavedSession"
                        @onchange="OnSavedSessionChanged"
                        disabled="@_isBusy">
                    <option value="">Load saved...</option>
                    @foreach (var session in _savedSessions)
                    {
                        <option value="@session.Path">@session.Label</option>
                    }
                </select>
                <button class="btn btn-outline-secondary btn-sm"
                        @onclick="SaveSessionAsync"
                        disabled="@(_isBusy || !HasWorkbook)">
                    Save
                </button>
                <button class="btn btn-outline-primary btn-sm"
                        @onclick="ToggleAutoPromptPanel"
                        disabled="@_isBusy">
                    Auto Prompt (@SelectedAutoPromptCount/@_autoPrompts.Count)
                </button>
                <button class="btn btn-primary btn-sm"
                        @onclick="AddStep"
                        disabled="@_isBusy">
                    + Prompt
                </button>
            </div>
        </div>

        @if (_autoPromptOpen)
        {
            <section class="idt-auto-panel">
                <div class="idt-auto-head">
                    <div>
                        <div class="idt-auto-title">Auto Prompt</div>
                        <div class="idt-auto-subtitle">Analysis defaults and user-added Auto Prompt items.</div>
                    </div>
                    <button class="idt-auto-close" @onclick="ToggleAutoPromptPanel" title="Close">X</button>
                </div>
                <div class="idt-auto-preview-wrap">
                    <div class="idt-auto-preview-label">
                        <strong>Analysis Runner Prompt</strong>
                        <span>Fixed wrapper sent with each analysis step. Checked Auto Prompt items are added through RequestJson.autoPrompts.</span>
                    </div>
                    <textarea class="idt-auto-preview compact" readonly value="@AnalysisRunnerPromptPreview"></textarea>
                </div>
                <div class="idt-auto-defaults">
                        <div class="idt-auto-preview-wrap">
                            <div class="idt-auto-preview-label">
                                <strong>Default Analysis Prompt</strong>
                                <span>Used when Step prompt and checked Auto Prompt items are empty.</span>
                            </div>
                            <textarea class="idt-auto-preview compact" readonly value="@DefaultAnalysisPromptPreview"></textarea>
                        </div>
                        <div class="idt-auto-preview-wrap">
                            <div class="idt-auto-preview-label">
                                <strong>Review Index Reference Prompt</strong>
                                <span>@DetailedReviewIndexPath</span>
                            </div>
                            <textarea class="idt-auto-preview compact" readonly value="@ReviewIndexPromptPreview"></textarea>
                        </div>
                        <div class="idt-auto-preview-wrap">
                            <div class="idt-auto-preview-label">
                                <strong>Workbook Evidence Prompt</strong>
                                <span>Step 1 structure, merged cells, normalized rows, and previous analysis context.</span>
                            </div>
                            <textarea class="idt-auto-preview compact" readonly value="@WorkbookEvidencePromptPreview"></textarea>
                        </div>
                        <div class="idt-auto-preview-wrap">
                            <div class="idt-auto-preview-label">
                                <strong>Output Rules Prompt</strong>
                                <span>Visible answer shape, table layout, read-only rule, and JSON output contract.</span>
                            </div>
                            <textarea class="idt-auto-preview compact" readonly value="@AnalysisOutputPromptPreview"></textarea>
                        </div>
                    </div>
                    @if (_autoPrompts.Count == 0)
                    {
                        <div class="idt-auto-empty">No Analysis Auto Prompt. Add only the prompts you need.</div>
                    }
                    else
                    {
                        <div class="idt-auto-list">
                            @foreach (var prompt in _autoPrompts)
                            {
                                <label class="idt-auto-item" title="@prompt.Description">
                                    <input type="checkbox"
                                           checked="@prompt.Enabled"
                                           @onchange="@(e => SetAutoPromptEnabled(prompt, e))"
                                           disabled="@_isBusy" />
                                    <span>
                                        <strong>@prompt.Title</strong>
                                        <em>@prompt.Description</em>
                                    </span>
                                    @if (prompt.IsCustom)
                                    {
                                        <button type="button"
                                                class="idt-auto-remove"
                                                title="Remove"
                                                @onclick="() => RemoveCustomAutoPrompt(prompt)"
                                                @onclick:stopPropagation="true"
                                                disabled="@_isBusy">X</button>
                                    }
                                </label>
                            }
                        </div>
                    }
                    <div class="idt-auto-add">
                        <input class="form-control form-control-sm"
                               placeholder="Analysis Auto Prompt title"
                               value="@_newAutoPromptTitle"
                               @oninput="@(e => _newAutoPromptTitle = e.Value?.ToString() ?? string.Empty)"
                               disabled="@_isBusy" />
                        <textarea class="idt-auto-add-text"
                                  placeholder="Analysis Auto Prompt content"
                                  value="@_newAutoPromptContent"
                                  @oninput="@(e => _newAutoPromptContent = e.Value?.ToString() ?? string.Empty)"
                                  disabled="@_isBusy"></textarea>
                        <button class="btn btn-primary btn-sm"
                                type="button"
                                @onclick="AddCustomAutoPrompt"
                                disabled="@(_isBusy || string.IsNullOrWhiteSpace(_newAutoPromptContent))">
                            Add Analysis Prompt
                        </button>
                    </div>
            </section>
        }

        <div class="idt-steps">
            <section class="idt-step @(_isStructureExtracting ? "running" : "")">
                <div class="idt-step-head">
                    <div>
                        <div class="idt-step-title">Step 1 - Extract Excel Data</div>
                        <div class="idt-step-meta">@ExtractionStepMeta</div>
                    </div>
                    <div class="idt-step-actions">
                        @if (_isStructureExtracting)
                        {
                            <button class="btn btn-outline-danger btn-sm"
                                    @onclick="CancelCliWait">
                                Stop wait
                            </button>
                        }
                        <button class="btn btn-primary btn-sm"
                                type="button"
                                @onclick="RunFileExtractionAsync"
                                disabled="@(_isBusy || !AiProviders.CodexCliEnabled || !HasWorkbook)">
                            @if (_isStructureExtracting)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            Extract File
                        </button>
                    </div>
                </div>

                <div class="idt-result-pane">
                    <div class="idt-label-row">
                        <span class="idt-label">Extracted Data</span>
                        @if (!string.IsNullOrWhiteSpace(_aiStructureCompletedAt))
                        {
                            <span class="idt-result-time">@_aiStructureCompletedAt</span>
                        }
                    </div>
                    @if (_isStructureExtracting)
                    {
                        <div class="idt-result loading">
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            @_status
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(_aiStructureHtml))
                    {
                        <div class="idt-result html-report idt-extracted-data">@((Microsoft.AspNetCore.Components.MarkupString)_aiStructureHtml)</div>
                    }
                    else
                    {
                        <div class="idt-result empty">No extracted data. Run Step 1 first.</div>
                    }
                </div>
            </section>

            @foreach (var step in _steps)
            {
                <section class="idt-step @(step.IsRunning ? "running" : "")">
                    <div class="idt-step-head">
                        <div>
                            <div class="idt-step-title">Step @DisplayStepNumber(step)</div>
                            <div class="idt-step-meta">@StepMeta(step)</div>
                        </div>
                        <div class="idt-step-actions">
                            @if (step.IsRunning)
                            {
                                <button class="btn btn-outline-danger btn-sm"
                                        @onclick="CancelCliWait">
                                    Stop wait
                                </button>
                            }
                            <button class="btn btn-dark btn-sm"
                                    @onclick="() => RunStepAsync(step)"
                                    disabled="@(!CanRun(step))"
                                    title="@RunDisabledReason(step)">
                                @if (step.IsRunning)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                Run Codex
                            </button>
                        </div>
                    </div>

                    <div class="idt-step-grid">
                        <div class="idt-prompt-pane">
                            <label class="idt-label" for="@PromptId(step)">Prompt</label>
                            <textarea id="@PromptId(step)"
                                      class="idt-textarea prompt"
                                      @bind="step.Prompt"
                                      @bind:event="oninput"
                                      disabled="@_isBusy"
                                      placeholder="@PromptPlaceholderText(step)"></textarea>
                        </div>

                        <div class="idt-result-pane">
                            <div class="idt-label-row">
                                <span class="idt-label">AI Result</span>
                                @if (!string.IsNullOrWhiteSpace(step.CompletedAt))
                                {
                                    <span class="idt-result-time">@step.CompletedAt</span>
                                }
                            </div>
                            @if (step.IsRunning)
                            {
                                <div class="idt-result loading">
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    @_status
                                </div>
                            }
                            else if (!string.IsNullOrWhiteSpace(step.Error))
                            {
                                <pre class="idt-result error-text">@step.Error</pre>
                            }
                            else if (!string.IsNullOrWhiteSpace(step.ResultHtml))
                            {
                                <div class="idt-result idt-ai-html-host">
                                    <iframe class="idt-ai-html-frame"
                                            sandbox=""
                                            title="AI generated analysis HTML"
                                            srcdoc="@step.ResultHtml"></iframe>
                                </div>
                            }
                            else
                            {
                                <div class="idt-result empty">No result.</div>
                            }
                        </div>
                    </div>
                </section>
            }
        </div>
    </main>
</div>

<style>
    .idt-root {
        height: calc(100vh - 24px);
        display: grid;
        grid-template-columns: 220px minmax(0, 1fr);
        gap: 10px;
        padding: 10px;
        overflow: hidden;
        background: #f6f8fb;
    }

    .idt-left, .idt-step {
        border: 1px solid #d9e2ee;
        background: #fff;
        border-radius: 6px;
    }

    .idt-left {
        min-height: 0;
        display: flex;
        flex-direction: column;
        gap: 9px;
        padding: 10px;
        overflow-y: auto;
    }

    .idt-head, .idt-mainbar, .idt-step-head, .idt-label-row, .idt-main-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

    .idt-session-select {
        width: 210px;
        font-size: 12px;
    }

    .idt-kicker {
        font-size: 11px;
        font-weight: 800;
        color: #0f766e;
        letter-spacing: .02em;
    }

    .idt-head h1 {
        margin: 1px 0 0;
        font-size: 16px;
        font-weight: 850;
        color: #0f172a;
    }

    .idt-icon-btn {
        width: 32px;
        height: 32px;
        border: 1px solid #cbd5e1;
        background: #fff;
        border-radius: 6px;
        color: #334155;
        font-size: 12px;
        font-weight: 800;
    }

    .idt-drop {
        position: relative;
        display: grid;
        place-items: center;
        gap: 7px;
        min-height: 108px;
        border: 2px dashed #94a3b8;
        border-radius: 6px;
        background: #f8fafc;
        cursor: pointer;
        text-align: center;
        padding: 12px;
    }

    .idt-drop:hover {
        border-color: #0f766e;
        background: #f0fdfa;
    }

    .idt-drop.has-file {
        border-color: #14b8a6;
        background: #f0fdfa;
    }

    .idt-file-input {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        cursor: pointer;
    }

    .idt-drop-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 52px;
        height: 34px;
        border-radius: 4px;
        background: #134e4a;
        color: #ccfbf1;
        font-size: 12px;
        font-weight: 850;
    }

    .idt-drop-title {
        font-size: 14px;
        font-weight: 800;
        color: #0f172a;
    }

    .idt-drop-name {
        max-width: 100%;
        font-size: 12px;
        color: #475569;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .idt-file-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        font-size: 11px;
        color: #475569;
    }

    .idt-file-meta span {
        border: 1px solid #e2e8f0;
        background: #fff;
        border-radius: 4px;
        padding: 3px 7px;
    }

    .idt-file-meta .idt-warn {
        border-color: #fed7aa;
        background: #fff7ed;
        color: #9a3412;
    }

    .idt-extract-card {
        display: grid;
        gap: 7px;
        padding: 8px;
        border: 1px solid #dbe3ef;
        border-radius: 6px;
        background: #f8fafc;
    }

    .idt-extract-card.ready {
        border-color: #bbf7d0;
        background: #f0fdf4;
    }

    .idt-extract-card .btn {
        width: 100%;
    }

    .idt-extract-info {
        min-width: 0;
        display: grid;
        gap: 2px;
        font-size: 11px;
        color: #475569;
    }

    .idt-extract-info strong {
        color: #0f172a;
        font-size: 12px;
    }

    .idt-extract-info span {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .idt-left-section {
        display: grid;
        gap: 6px;
    }

    .idt-label {
        margin: 0;
        font-size: 12px;
        font-weight: 800;
        color: #334155;
    }

    .idt-textarea {
        resize: vertical;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        padding: 9px 10px;
        font-size: 13px;
        line-height: 1.45;
        color: #0f172a;
        background: #fff;
        outline: none;
    }

    .idt-textarea:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, .12);
    }

    .idt-textarea.purpose { min-height: 86px; }
    .idt-textarea.context { min-height: 70px; }
    .idt-textarea.prompt  { min-height: 128px; height: 128px; }

    .idt-status {
        border-radius: 6px;
        padding: 9px 10px;
        font-size: 12px;
        line-height: 1.4;
    }

    .idt-status.ok {
        border: 1px solid #bbf7d0;
        background: #f0fdf4;
        color: #166534;
    }

    .idt-status.error {
        border: 1px solid #fecaca;
        background: #fef2f2;
        color: #991b1b;
    }

    .idt-main {
        min-width: 0;
        min-height: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .idt-mainbar {
        flex-shrink: 0;
        padding: 4px 2px 10px;
    }

    .idt-title {
        font-size: 17px;
        font-weight: 850;
        color: #111827;
    }

    .idt-subtitle {
        margin-top: 2px;
        font-size: 12px;
        color: #64748b;
    }

    .idt-steps {
        min-height: 0;
        overflow-y: auto;
        display: grid;
        gap: 10px;
        padding-right: 3px;
    }

    .idt-auto-panel {
        flex-shrink: 0;
        display: grid;
        gap: 8px;
        margin: 0 2px 10px;
        padding: 10px;
        border: 1px solid #bfdbfe;
        border-radius: 6px;
        background: #eff6ff;
    }

    .idt-auto-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
    }

    .idt-auto-title {
        font-size: 13px;
        font-weight: 850;
        color: #1e3a8a;
    }

    .idt-auto-subtitle {
        margin-top: 2px;
        font-size: 11px;
        color: #475569;
    }

    .idt-auto-close {
        width: 26px;
        height: 26px;
        border: 1px solid #93c5fd;
        border-radius: 5px;
        background: #fff;
        color: #1d4ed8;
        font-size: 11px;
        font-weight: 850;
    }

    .idt-auto-preview-wrap {
        display: grid;
        gap: 6px;
    }

    .idt-auto-defaults {
        display: grid;
        gap: 10px;
    }

    .idt-auto-preview-label {
        display: flex;
        align-items: baseline;
        gap: 8px;
        flex-wrap: wrap;
        font-size: 11px;
        color: #64748b;
    }

    .idt-auto-preview-label strong {
        font-size: 12px;
        color: #0f172a;
    }

    .idt-auto-preview {
        width: 100%;
        min-height: 260px;
        max-height: 360px;
        resize: vertical;
        border: 1px solid #bfdbfe;
        border-radius: 6px;
        padding: 8px;
        background: #fff;
        color: #0f172a;
        font-family: Consolas, "Courier New", monospace;
        font-size: 11px;
        line-height: 1.4;
        white-space: pre;
    }

    .idt-auto-preview.compact {
        min-height: 150px;
        max-height: 220px;
    }

    .idt-auto-empty {
        padding: 10px;
        border: 1px dashed #93c5fd;
        border-radius: 6px;
        background: #fff;
        color: #475569;
        font-size: 12px;
    }

    .idt-auto-list {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 7px;
    }

    .idt-auto-item {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        min-width: 0;
        margin: 0;
        padding: 8px;
        border: 1px solid #dbeafe;
        border-radius: 6px;
        background: #fff;
        cursor: pointer;
    }

    .idt-auto-item input {
        margin-top: 3px;
        flex-shrink: 0;
    }

    .idt-auto-item span {
        min-width: 0;
        display: grid;
        gap: 2px;
        flex: 1;
    }

    .idt-auto-item strong {
        font-size: 12px;
        color: #0f172a;
    }

    .idt-auto-item em {
        font-style: normal;
        font-size: 11px;
        line-height: 1.35;
        color: #64748b;
    }

    .idt-auto-remove {
        width: 22px;
        height: 22px;
        flex-shrink: 0;
        border: 1px solid #fecaca;
        border-radius: 4px;
        background: #fff;
        color: #b91c1c;
        font-size: 10px;
        font-weight: 850;
    }

    .idt-auto-add {
        display: grid;
        grid-template-columns: minmax(180px, 260px) minmax(260px, 1fr) auto;
        gap: 7px;
        align-items: stretch;
    }

    .idt-auto-add-text {
        min-height: 32px;
        max-height: 86px;
        resize: vertical;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        padding: 6px 8px;
        font-size: 12px;
        line-height: 1.35;
        color: #0f172a;
    }

    .idt-auto-add .btn {
        white-space: nowrap;
    }

    @@media (max-width: 1280px) {
        .idt-mainbar {
            align-items: flex-start;
        }

        .idt-main-actions {
            flex-wrap: wrap;
            justify-content: flex-end;
        }
    }

    .idt-step {
        padding: 12px;
        display: grid;
        gap: 10px;
    }

    .idt-step.running {
        border-color: #60a5fa;
        box-shadow: 0 0 0 3px rgba(96, 165, 250, .12);
    }

    .idt-step-title {
        font-size: 14px;
        font-weight: 850;
        color: #0f172a;
    }

    .idt-step-meta, .idt-result-time {
        font-size: 11px;
        color: #64748b;
    }

    .idt-step-actions {
        display: flex;
        gap: 6px;
