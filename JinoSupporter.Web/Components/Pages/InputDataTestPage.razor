    private const string DetailedReviewIndexPath = InputDataTestAnalysisSupport.DetailedReviewIndexPath;

    private readonly List<AnalysisStep> _steps = [new(1)];
    private readonly List<AutoPromptOption> _autoPrompts = LoadAutoPromptOptions();
    private List<SavedSessionInfo> _savedSessions = [];
    private CancellationTokenSource? _cliWaitCts;

    private bool _isBusy;
    private bool _autoPromptOpen;
    private bool _statusError;
    private string _status = "";
    private string _reviewPurpose = "";
    private string _reviewContext = "";
