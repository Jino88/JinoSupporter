    private static List<MarkdownSection> SplitMarkdownSections(string markdown)
    {
        var sections = new List<MarkdownSection>();
        var sb = new StringBuilder();
        string title = "ai-excel-proc.md";

        foreach (string rawLine in (markdown ?? "").Replace("\r\n", "\n").Split('\n'))
        {
            string line = rawLine.TrimEnd('\r');
            if (IsMajorMarkdownHeading(line))
            {
                if (sb.Length > 0)
                {
                    sections.Add(new MarkdownSection(title, sb.ToString().Trim()));
                    sb.Clear();
                }

                title = HeadingTitle(line);
            }

            sb.AppendLine(line);
        }

        if (sb.Length > 0)
            sections.Add(new MarkdownSection(title, sb.ToString().Trim()));

        return sections;
    }

    private static bool IsMajorMarkdownHeading(string line)
    {
        string trimmed = (line ?? "").TrimStart();
        return trimmed.StartsWith("# ", StringComparison.Ordinal)
            || trimmed.StartsWith("## ", StringComparison.Ordinal);
    }

    private static string HeadingTitle(string line)
        => (line ?? "").Trim().TrimStart('#').Trim();

    private static bool IsDefaultAutoPromptSection(string title)
        => false;

    private static string ShortAutoPromptDescription(string title, string content)
        => title switch
        {
            "AI Excel Process Report Contract" => "Main contract.",
            "Purpose" => "Analysis goal.",
            "Target Report Style" => "Report style.",
            "Non-Negotiable Output Contract" => "Required outputs.",
            "Required Report Shape" => "Report sections.",
            "Visual Block Formats" => "Visual format.",
            "Report Quality Gate" => "Quality checks.",
            "Batch Execution Workflow" => "Batch workflow.",
            "Workbook Analysis Rules" => "Excel reading rules.",
            "Report Type Classification" => "Report type rules.",
            "Baseline Pairing Rules" => "Baseline rules.",
            "Structured JSON Shape" => "DB JSON shape.",
            "Final Commit Rule" => "Commit rule.",
            _ => ShortPromptSummary(content)
        };

    private static string ShortPromptSummary(string content)
    {
        foreach (string rawLine in (content ?? "").Replace("\r\n", "\n").Split('\n'))
        {
            string line = rawLine.Trim();
            if (line.Length == 0 || line.StartsWith("#", StringComparison.Ordinal) || line.StartsWith("```", StringComparison.Ordinal))
                continue;
            line = line.TrimStart('-', '*').Trim();
            if (line.Length == 0) continue;
            return line.Length <= 56 ? line : line[..56] + "...";
        }

        return "Custom instruction.";
    }

    private static string Slug(string value)
    {
        var sb = new StringBuilder();
        foreach (char ch in (value ?? "").ToLowerInvariant())
        {
            if (char.IsLetterOrDigit(ch)) sb.Append(ch);
            else if (sb.Length > 0 && sb[^1] != '_') sb.Append('_');
        }
        return sb.ToString().Trim('_');
    }

