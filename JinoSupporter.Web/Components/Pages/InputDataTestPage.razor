    private int _sheetCount;
    private int _rowCount;
    private int _cellCount;
    private int _aiStructureImageCount;

    private bool HasWorkbook => !string.IsNullOrWhiteSpace(_excelTextPath) && File.Exists(_excelTextPath);

    private bool HasAiStructure
        => !string.IsNullOrWhiteSpace(_aiStructureJsonPath)
           && File.Exists(_aiStructureJsonPath)
           && !string.IsNullOrWhiteSpace(_aiStructureTextPath)
           && File.Exists(_aiStructureTextPath);

    private string WorkbookLabel => HasWorkbook
        ? _workbookFileName
        : _isBusy
            ? "Loading..."
            : "Drop or select .xlsx / .xlsm";

    private string AiStructureStatusLabel => HasAiStructure
        ? $"AI structure ready (Excel cells + {_aiStructureImageCount:N0} image(s), PNG deleted)"
        : _isStructureExtracting
            ? $"AI structure extraction running... {FormatElapsedSince(_aiStructureExtractionStartedAt)}"
            : "Run Step 1 first.";

    private string StepSummary
        => $"Step 1 extraction {(HasAiStructure ? "done" : "needed")}, {_steps.Count} analysis step(s), {_steps.Count(s => !string.IsNullOrWhiteSpace(s.ResultHtml))} completed";

    private string ExtractionStepMeta
        => _isStructureExtracting
            ? "running"
        : HasAiStructure
                ? "done, program cells saved, images deleted after extraction"
                : "ready";

    private int SelectedAutoPromptCount => _autoPrompts.Count(p => p.Enabled);

    private string AnalysisRunnerPromptPreview
        => BuildCodexPrompt("{analysis request json}");

    private string DefaultAnalysisPromptPreview
        => BuildDefaultAnalysisPrompt();

    private string ReviewIndexPromptPreview
        => BuildReviewIndexPrompt("{analysis request json}");

    private string WorkbookEvidencePromptPreview
        => BuildWorkbookEvidencePrompt();

    private string AnalysisOutputPromptPreview
        => BuildAnalysisOutputPrompt();

    protected override void OnInitialized()
    {
        RefreshSavedSessions();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { await JS.InvokeVoidAsync("diFullPage.enter"); } catch { }
    }

    private async Task OnExcelSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;

        string ext = Path.GetExtension(file.Name).ToLowerInvariant();
        if (ext is not ".xlsx" and not ".xlsm")
        {
            SetStatus("Only .xlsx and .xlsm files are supported.", true);
            return;
        }

        _isBusy = true;
        SetStatus("Reading workbook...", false);
        await InvokeAsync(StateHasChanged);

        try
        {
            await using Stream input = file.OpenReadStream(MaxUploadBytes);
            using var ms = new MemoryStream();
            await input.CopyToAsync(ms);
            byte[] bytes = ms.ToArray();

            WorkbookExtractResult extracted = await Task.Run(() => ExtractWorkbookText(bytes));
            string runDir = PrepareUploadDirectory(file.Name);
            string safeName = SafeFileName(file.Name);

            _workbookPath = Path.Combine(runDir, safeName);
            _excelTextPath = Path.Combine(runDir, Path.GetFileNameWithoutExtension(safeName) + ".extracted.txt");
            await File.WriteAllBytesAsync(_workbookPath, bytes);
            await File.WriteAllTextAsync(_excelTextPath, extracted.Text, new UTF8Encoding(encoderShouldEmitUTF8Identifier: false));

            _workbookFileName = file.Name;
            _excelText = extracted.Text;
            _excelTextTruncated = extracted.Truncated;
            _sheetCount = extracted.SheetCount;
            _rowCount = extracted.RowCount;
            _cellCount = extracted.CellCount;
            ClearAiStructure();

            if (_steps.Count == 0)
                _steps.Add(new AnalysisStep(1));

            SetStatus($"Workbook loaded: {_sheetCount} sheet(s), {_rowCount:N0} row(s).", false);
        }
        catch (Exception ex)
        {
            ClearWorkbook();
            SetStatus($"Excel load failed: {ex.Message}", true);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task OnSavedSessionChanged(ChangeEventArgs e)
    {
        string path = e.Value?.ToString() ?? "";
        _selectedSavedSession = path;
        if (string.IsNullOrWhiteSpace(path)) return;

        await LoadSavedSessionAsync(path);
        _selectedSavedSession = "";
    }

    private async Task LoadSavedSessionAsync(string path)
    {
        if (_isBusy) return;

        _isBusy = true;
        SetStatus("Loading saved INPUT DATA (TEST) session...", false);
        await InvokeAsync(StateHasChanged);

        try
        {
            string json = await File.ReadAllTextAsync(path);
            using JsonDocument doc = JsonDocument.Parse(json);
            JsonElement root = doc.RootElement;

            if (root.TryGetProperty("workbook", out JsonElement workbook))
            {
                _workbookFileName = JsonString(workbook, "fileName");
                _workbookPath = ResolveSessionPath(JsonString(workbook, "workbookPath"), path);
                _excelTextPath = ResolveSessionPath(JsonString(workbook, "extractedTextPath"), path);
                _sheetCount = JsonInt(workbook, "sheetCount");
                _rowCount = JsonInt(workbook, "rowCount");
                _cellCount = JsonInt(workbook, "cellCount");
                _excelTextTruncated = JsonBool(workbook, "extractedTextTruncated");
                _excelText = File.Exists(_excelTextPath)
                    ? await File.ReadAllTextAsync(_excelTextPath)
                    : "";

                if (workbook.TryGetProperty("aiStructure", out JsonElement aiStructure))
                {
                    _aiStructureDir = ResolveSessionPath(JsonString(aiStructure, "dir"), path);
                    _aiStructureJsonPath = ResolveSessionPath(JsonString(aiStructure, "jsonPath"), path);
                    _aiStructureTextPath = ResolveSessionPath(JsonString(aiStructure, "textPath"), path);
                    _aiStructureRenderedRequestPath = ResolveSessionPath(JsonString(aiStructure, "renderedRequestPath"), path);
                    _aiStructureCompletedAt = JsonString(aiStructure, "completedAt");
                    _aiStructureImageCount = JsonInt(aiStructure, "imageCount");
                    _aiStructureHtml = LoadAiStructureHtml(_aiStructureJsonPath);
                }
                else
                {
                    ClearAiStructure();
                }
            }

            _reviewPurpose = JsonString(root, "reviewPurpose");
            _reviewContext = JsonString(root, "reviewContext");
            LoadAutoPromptState(root);
            LoadSavedSteps(root);

            _lastSavedPath = path;
            SetStatus($"Loaded: {path}", false);
        }
        catch (Exception ex)
        {
            SetStatus($"Load failed: {ex.Message}", true);
        }
        finally
        {
            _isBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void AddStep()
    {
        _steps.Add(new AnalysisStep(_steps.Count + 1));
    }

    private void ToggleAutoPromptPanel()
    {
        if (_isBusy) return;
        _autoPromptOpen = !_autoPromptOpen;
    }

    private void AddCustomAutoPrompt()
    {
        if (_isBusy) return;

        string content = _newAutoPromptContent.Trim();
        if (string.IsNullOrWhiteSpace(content)) return;

        string title = string.IsNullOrWhiteSpace(_newAutoPromptTitle)
            ? $"Custom Prompt {_autoPrompts.Count(p => p.IsCustom) + 1}"
            : _newAutoPromptTitle.Trim();

        _autoPrompts.Add(new AutoPromptOption(
            $"custom_{Guid.NewGuid():N}",
            title,
            ShortPromptSummary(content),
            "Custom",
            "",
            content,
            true,
            isCustom: true));

        _newAutoPromptTitle = "";
        _newAutoPromptContent = "";
        PersistAutoPromptLibrary();
    }

    private void RemoveCustomAutoPrompt(AutoPromptOption prompt)
    {
        if (_isBusy || !prompt.IsCustom) return;
        _autoPrompts.Remove(prompt);
        PersistAutoPromptLibrary();
    }

    private void SetAutoPromptEnabled(AutoPromptOption prompt, ChangeEventArgs e)
    {
        if (_isBusy) return;
        prompt.Enabled = e.Value is bool b && b;
        PersistAutoPromptLibrary();
    }

    private void PersistAutoPromptLibrary()
    {
        if (SaveAutoPromptLibrary(_autoPrompts))
            SetStatus("Auto Prompt saved.", false);
        else
            SetStatus("Auto Prompt save failed. Check file permission.", true);
    }

    private bool CanRun(AnalysisStep step)
        => !_isBusy
           && AiProviders.CodexCliEnabled
           && HasWorkbook
           && HasAiStructure;

    private string RunDisabledReason(AnalysisStep step)
    {
        if (_isBusy) return "Busy.";
        if (!AiProviders.CodexCliEnabled) return "Codex CLI is disabled.";
        if (!HasWorkbook) return "Load an Excel workbook first.";
        if (!HasAiStructure) return "Run Step 1 Extract File first.";
        return "Run Codex";
    }

    private async Task RunStepAsync(AnalysisStep step)
    {
        if (!CanRun(step)) return;

        _isBusy = true;
        step.IsRunning = true;
        step.Error = "";
        step.Result = "";
        step.ResultHtml = "";
        step.CompletedAt = "";
        int displayStep = DisplayStepNumber(step);
        SetStatus($"Step {displayStep}: Codex CLI running...", false);
        await InvokeAsync(StateHasChanged);

        string workDir = FindRepoRoot();
        string tmpDir = Path.Combine(workDir, "tmp");
        Directory.CreateDirectory(tmpDir);

        string runId = Guid.NewGuid().ToString("N")[..12];
        string requestPath = Path.Combine(tmpDir, $"input_data_test_request_{runId}.json");
        string outputPath = Path.Combine(tmpDir, $"input_data_test_output_{runId}.txt");
        string donePath = Path.Combine(tmpDir, $"input_data_test_done_{runId}.json");

        try
        {
            WriteStepRequest(requestPath, runId, step);
            string prompt = BuildCodexPrompt(requestPath);
            ActivityLog.Log("InputDataTest", $"launch Codex CLI step={displayStep} request={requestPath}");

            if (!TryLaunchCodexTerminal(workDir, prompt, $"INPUT DATA (TEST) - Step {displayStep}", outputPath, donePath))
            {
                step.Error = "Failed to launch Codex CLI.";
                SetStatus(step.Error, true);
                return;
            }

            _cliWaitCts?.Cancel();
            _cliWaitCts?.Dispose();
            _cliWaitCts = new CancellationTokenSource(TimeSpan.FromMinutes(30));
            CancellationToken token = _cliWaitCts.Token;

            while (!token.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(2), token);

                if (!File.Exists(donePath))
                {
                    SetStatus($"Step {displayStep}: waiting for Codex result... {DateTime.Now:HH:mm:ss}", false);
                    await InvokeAsync(StateHasChanged);
                    continue;
                }

                string result = File.Exists(outputPath)
                    ? await File.ReadAllTextAsync(outputPath, token)
                    : "";

                string doneJson = await File.ReadAllTextAsync(donePath, token);
                int exitCode = ReadExitCode(doneJson);
                if (exitCode != 0)
                {
                    step.Error = string.IsNullOrWhiteSpace(result)
                        ? $"Codex CLI exited with code {exitCode}."
                        : $"Codex CLI exited with code {exitCode}.\n\n{result.Trim()}";
                    SetStatus($"Step {displayStep}: Codex CLI failed.", true);
                    return;
                }

                var parsed = ParseStepResult(result);
                step.Result = parsed.AnalysisText;
                step.ResultHtml = parsed.AnalysisHtml;
                if (!string.IsNullOrWhiteSpace(parsed.Error))
                {
                    step.Error = parsed.Error;
                    SetStatus($"Step {displayStep}: Codex output did not include display HTML.", true);
                    return;
                }
                step.CompletedAt = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");
                SetStatus($"Step {displayStep}: analysis complete.", false);
                TryDeleteFile(requestPath);
                TryDeleteFile(outputPath);
                TryDeleteFile(donePath);
                return;
            }
        }
        catch (OperationCanceledException)
        {
            step.Error = "Waiting was stopped. The Codex CLI terminal may still finish.";
            SetStatus(step.Error, true);
        }
        catch (Exception ex)
        {
            step.Error = ex.Message;
            SetStatus($"Step {displayStep}: {ex.Message}", true);
        }
        finally
        {
            step.IsRunning = false;
            _isBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CancelCliWait()
    {
        try { _cliWaitCts?.Cancel(); } catch { }
    }

    private async Task RunFileExtractionAsync()
    {
        if (!HasWorkbook)
        {
            SetStatus("Excel file is required before extraction.", true);
            return;
        }
        if (!AiProviders.CodexCliEnabled)
        {
            SetStatus("Codex CLI is disabled.", true);
            return;
        }

        _isBusy = true;
        ClearAiStructure();
        _isStructureExtracting = true;
        DateTimeOffset extractionStartedAt = DateTimeOffset.Now;
        _aiStructureExtractionStartedAt = extractionStartedAt;
        SetStatus($"AI structure extraction running... {FormatElapsedSince(extractionStartedAt)}", false);
        await InvokeAsync(StateHasChanged);

        string workDir = FindRepoRoot();
        string rendererPath = Path.Combine(workDir, "JinoSupporter.Web", "tools", "input_data_test_render_excel.py");
        string baseDir = Path.GetDirectoryName(_workbookPath) ?? Path.Combine(workDir, "tmp", "input-data-test");
        string runId = Guid.NewGuid().ToString("N")[..12];
        string structureDir = Path.Combine(baseDir, "ai-structure", $"{DateTime.Now:yyyyMMdd_HHmmss}_{runId}");
        string imageDir = Path.Combine(structureDir, "images");
        string renderedRequestPath = Path.Combine(structureDir, "rendered-request.json");
        string requestPath = Path.Combine(structureDir, "extract-request.json");
        string outputJsonPath = Path.Combine(structureDir, "ai-structure.json");
        string outputTextPath = Path.Combine(structureDir, "ai-structure.txt");
        string progressPath = Path.Combine(structureDir, "extract-progress.json");
        string donePath = Path.Combine(structureDir, "extract-done.json");

        try
        {
            Directory.CreateDirectory(structureDir);
            WriteAiStructureRequest(requestPath, runId, structureDir, imageDir, renderedRequestPath, outputJsonPath, outputTextPath);
            string prompt = BuildAiStructurePrompt(requestPath, renderedRequestPath);
            ActivityLog.Log("InputDataTest", $"launch AI structure extraction request={requestPath}");

            if (!TryLaunchAiStructureExtractionTerminal(
                    workDir,
                    rendererPath,
                    _workbookPath,
                    structureDir,
                    imageDir,
                    renderedRequestPath,
                    prompt,
                    "INPUT DATA (TEST) - Extract File",
                    outputJsonPath,
                    progressPath,
                    donePath))
            {
                SetStatus("Failed to launch AI structure extraction.", true);
                return;
            }

            _cliWaitCts?.Cancel();
            _cliWaitCts?.Dispose();
            _cliWaitCts = new CancellationTokenSource(TimeSpan.FromMinutes(60));
            CancellationToken token = _cliWaitCts.Token;

            while (!token.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(2), token);
                if (!File.Exists(donePath))
                {
                    string elapsedText = FormatElapsedSince(extractionStartedAt);
                    string progress = ReadAiStructureProgress(progressPath, elapsedText);
                    SetStatus(string.IsNullOrWhiteSpace(progress)
                        ? $"AI structure extraction running... {elapsedText}"
                        : progress,
                        false);
                    await InvokeAsync(StateHasChanged);
                    continue;
                }

                string doneJson = await File.ReadAllTextAsync(donePath, token);
                int exitCode = ReadExitCode(doneJson);
                bool usedFallbackStructure = false;
                string rawJson;
                if (exitCode != 0)
                {
                    string errorText = File.Exists(outputJsonPath)
                        ? await File.ReadAllTextAsync(outputJsonPath, token)
                        : "";
                    if (!TryBuildAiStructureFallbackJson(renderedRequestPath, errorText, out rawJson))
                    {
                        string elapsedText = FormatElapsedSince(extractionStartedAt);
                        SetStatus(string.IsNullOrWhiteSpace(errorText)
                            ? $"AI structure extraction failed after {elapsedText}. Exit code: {exitCode}."
                            : $"AI structure extraction failed after {elapsedText}. Exit code: {exitCode}. {errorText.Trim()}",
                            true);
                        return;
                    }

                    usedFallbackStructure = true;
                }
                else if (!File.Exists(outputJsonPath))
                {
                    SetStatus($"AI structure extraction finished without JSON output after {FormatElapsedSince(extractionStartedAt)}.", true);
                    return;
                }
                else
                {
                    rawJson = await File.ReadAllTextAsync(outputJsonPath, token);
                }

                string cleanJson = EnrichAiStructureJsonWithRenderedMetadata(CleanJsonText(rawJson), renderedRequestPath);
                using JsonDocument doc = JsonDocument.Parse(cleanJson);
                string formattedJson = JsonSerializer.Serialize(doc.RootElement, new JsonSerializerOptions { WriteIndented = true });
                string structureText = AiStructureJsonToText(doc.RootElement);
                string structureHtml = AiStructureJsonToHtml(doc.RootElement);
                int imageCount = CountRenderedImages(renderedRequestPath);
                await File.WriteAllTextAsync(outputJsonPath, formattedJson, new UTF8Encoding(encoderShouldEmitUTF8Identifier: false), token);
                await File.WriteAllTextAsync(outputTextPath, structureText, new UTF8Encoding(encoderShouldEmitUTF8Identifier: false), token);
                WriteAiStructureSheetFiles(doc.RootElement, structureDir);
                DeleteDirectorySafe(imageDir);

                _aiStructureDir = structureDir;
                _aiStructureJsonPath = outputJsonPath;
                _aiStructureTextPath = outputTextPath;
                _aiStructureRenderedRequestPath = renderedRequestPath;
                _aiStructureImageCount = imageCount;
                _aiStructureCompletedAt = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");
                _aiStructureHtml = structureHtml;
                string completedElapsedText = FormatElapsedSince(extractionStartedAt);
                SetStatus(usedFallbackStructure
                    ? $"Step 1 complete with Excel fallback: Codex CLI failed, exact Excel cells saved, {_aiStructureImageCount:N0} rendered image(s) deleted. Elapsed {completedElapsedText}."
                    : $"Step 1 complete: Excel cells saved, {_aiStructureImageCount:N0} image(s) verified, PNG files deleted. Elapsed {completedElapsedText}.",
                    false);
                return;
            }
        }
        catch (OperationCanceledException)
        {
            SetStatus($"AI structure wait was stopped after {FormatElapsedSince(extractionStartedAt)}. The terminal may still finish.", true);
        }
        catch (Exception ex)
        {
            SetStatus($"AI structure extraction failed after {FormatElapsedSince(extractionStartedAt)}: {ex.Message}", true);
        }
        finally
        {
            _isStructureExtracting = false;
            _aiStructureExtractionStartedAt = null;
            _isBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SaveSessionAsync()
    {
        if (!HasWorkbook)
        {
            SetStatus("Excel file is required before save.", true);
            return;
        }

        _isBusy = true;
        SetStatus("Saving INPUT DATA (TEST) session...", false);
        await InvokeAsync(StateHasChanged);

        try
        {
            string savedDir = Path.Combine(FindRepoRoot(), "tmp", "input-data-test", "saved");
            Directory.CreateDirectory(savedDir);

            string safeBase = Path.GetFileNameWithoutExtension(SafeFileName(_workbookFileName));
            if (string.IsNullOrWhiteSpace(safeBase)) safeBase = "input-data-test";
            string saveStem = $"{DateTime.Now:yyyyMMdd_HHmmss}_{safeBase}";
            string savePath = Path.Combine(savedDir, $"{saveStem}.json");
            string assetDir = Path.Combine(savedDir, saveStem);
            Directory.CreateDirectory(assetDir);

            string savedWorkbookPath = CopySessionFile(_workbookPath, assetDir, SafeFileName(_workbookFileName));
            string extractedName = $"{Path.GetFileNameWithoutExtension(SafeFileName(_workbookFileName))}.extracted.txt";
            string savedExtractedTextPath = CopySessionFile(_excelTextPath, assetDir, extractedName);
            if (string.IsNullOrWhiteSpace(savedExtractedTextPath) && !string.IsNullOrWhiteSpace(_excelText))
            {
                savedExtractedTextPath = Path.Combine(assetDir, extractedName);
                await File.WriteAllTextAsync(savedExtractedTextPath, _excelText, new UTF8Encoding(encoderShouldEmitUTF8Identifier: false));
            }
            string savedAiJsonPath = CopySessionFile(_aiStructureJsonPath, assetDir, "ai-structure.json");
            string savedAiTextPath = CopySessionFile(_aiStructureTextPath, assetDir, "ai-structure.txt");
            string savedRenderedRequestPath = CopySessionFile(_aiStructureRenderedRequestPath, assetDir, "ai-structure-rendered-request.json");

            var payload = new
            {
                savedAtUtc = DateTime.UtcNow.ToString("o"),
                workflow = "INPUT DATA (TEST)",
                workbook = new
                {
                    fileName = _workbookFileName,
                    workbookPath = string.IsNullOrWhiteSpace(savedWorkbookPath) ? _workbookPath : savedWorkbookPath,
                    extractedTextPath = string.IsNullOrWhiteSpace(savedExtractedTextPath) ? _excelTextPath : savedExtractedTextPath,
                    sheetCount = _sheetCount,
                    rowCount = _rowCount,
                    cellCount = _cellCount,
                    extractedTextTruncated = _excelTextTruncated,
                    aiStructure = new
                    {
                        dir = _aiStructureDir,
                        jsonPath = string.IsNullOrWhiteSpace(savedAiJsonPath) ? _aiStructureJsonPath : savedAiJsonPath,
                        textPath = string.IsNullOrWhiteSpace(savedAiTextPath) ? _aiStructureTextPath : savedAiTextPath,
                        renderedRequestPath = string.IsNullOrWhiteSpace(savedRenderedRequestPath) ? _aiStructureRenderedRequestPath : savedRenderedRequestPath,
                        imageCount = _aiStructureImageCount,
                        completedAt = _aiStructureCompletedAt
                    }
                },
                reviewPurpose = _reviewPurpose,
                reviewContext = _reviewContext,
                autoPrompts = _autoPrompts.Select(p => new
                {
                    key = p.Key,
                    title = p.Title,
                    description = p.Description,
                    sourceLabel = p.SourceLabel,
                    sourcePath = p.SourcePath,
                    sectionTitle = "",
                    content = p.Content,
                    isCustom = p.IsCustom,
                    enabled = p.Enabled
                }).ToArray(),
                steps = _steps.Select(s => new
                {
                    step = s.Number,
                    prompt = s.Prompt,
                    analysisText = s.Result,
                    analysisHtml = s.ResultHtml,
                    error = s.Error,
                    completedAt = s.CompletedAt
                }).ToArray()
            };

            await File.WriteAllTextAsync(
                savePath,
                JsonSerializer.Serialize(payload, new JsonSerializerOptions { WriteIndented = true }),
                new UTF8Encoding(encoderShouldEmitUTF8Identifier: false));

            _lastSavedPath = savePath;
            RefreshSavedSessions();
            SetStatus($"Saved: {savePath}", false);
        }
        catch (Exception ex)
        {
            SetStatus($"Save failed: {ex.Message}", true);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void RefreshSavedSessions()
    {
        try
        {
            string savedDir = Path.Combine(FindRepoRoot(), "tmp", "input-data-test", "saved");
            if (!Directory.Exists(savedDir))
            {
                _savedSessions = [];
                return;
            }

            _savedSessions = Directory.EnumerateFiles(savedDir, "*.json")
                .Select(p => new FileInfo(p))
                .OrderByDescending(f => f.LastWriteTime)
                .Take(80)
                .Select(f => new SavedSessionInfo(f.FullName, $"{f.LastWriteTime:yyyy-MM-dd HH:mm} - {Path.GetFileNameWithoutExtension(f.Name)}"))
                .ToList();
        }
        catch
        {
            _savedSessions = [];
        }
    }

    private static string CopySessionFile(string sourcePath, string assetDir, string fileName)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(sourcePath) || !File.Exists(sourcePath)) return "";
            string targetPath = Path.Combine(assetDir, SafeFileName(fileName));
            File.Copy(sourcePath, targetPath, overwrite: true);
            return targetPath;
        }
        catch
        {
            return "";
        }
    }

    private static string ResolveSessionPath(string value, string sessionJsonPath)
    {
        if (string.IsNullOrWhiteSpace(value)) return "";
        if (Path.IsPathRooted(value)) return value;
        string? dir = Path.GetDirectoryName(sessionJsonPath);
        return string.IsNullOrWhiteSpace(dir) ? value : Path.GetFullPath(Path.Combine(dir, value));
    }

    private void LoadSavedSteps(JsonElement root)
    {
        _steps.Clear();
        if (root.TryGetProperty("steps", out JsonElement steps) && steps.ValueKind == JsonValueKind.Array)
        {
            foreach (JsonElement item in steps.EnumerateArray())
            {
                int number = JsonInt(item, "step", _steps.Count + 1);
                _steps.Add(new AnalysisStep(number)
                {
                    Prompt = JsonString(item, "prompt"),
                    Result = JsonString(item, "analysisText", "resultText", "result"),
                    ResultHtml = JsonString(item, "analysisHtml", "resultHtml", "html"),
                    Error = JsonString(item, "error"),
                    CompletedAt = JsonString(item, "completedAt")
                });
            }
        }

        if (_steps.Count == 0)
            _steps.Add(new AnalysisStep(1));
    }

    private void LoadAutoPromptState(JsonElement root)
    {
        if (!root.TryGetProperty("autoPrompts", out JsonElement prompts) || prompts.ValueKind != JsonValueKind.Array)
            return;

        _autoPrompts.Clear();

        foreach (JsonElement item in prompts.EnumerateArray())
        {
            string key = JsonString(item, "key");
            string title = JsonString(item, "title");
            string description = JsonString(item, "description");
            string sourceLabel = JsonString(item, "sourceLabel");
            string sourcePath = JsonString(item, "sourcePath");
            string content = JsonString(item, "content");
            bool enabled = JsonBool(item, "enabled");
            bool isCustom = JsonBool(item, "isCustom")
                || sourceLabel.Equals("Custom", StringComparison.OrdinalIgnoreCase)
                || key.StartsWith("custom_", StringComparison.OrdinalIgnoreCase);

            AutoPromptOption? existing = _autoPrompts.FirstOrDefault(p => p.Key == key);
            if (existing is not null)
            {
                existing.Enabled = enabled;
                continue;
            }

            if (string.IsNullOrWhiteSpace(title)) title = "Custom Prompt";
            if (string.IsNullOrWhiteSpace(description)) description = ShortPromptSummary(content);
            _autoPrompts.Add(new AutoPromptOption(
                string.IsNullOrWhiteSpace(key) ? $"custom_{Guid.NewGuid():N}" : key,
                title,
                description,
                string.IsNullOrWhiteSpace(sourceLabel) ? "Custom" : sourceLabel,
                sourcePath,
                content,
                enabled,
                isCustom));
        }
    }

