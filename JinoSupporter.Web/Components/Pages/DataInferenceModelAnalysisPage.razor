@page "/data-inference/model-analysis"
@rendermode InteractiveServer
@implements IDisposable
@inject WebRepository Repo
@inject AiProviderSettingsService AiProviders

<PageTitle>Data Inference - Each Model Analysis</PageTitle>

<div class="dima-root">
    <div class="dima-header">
        <div>
            <div class="dima-title">Each Model Analysis</div>
            <div class="dima-subtitle">Product Type -> Improvement Purpose -> Reports -> Model Analysis</div>
        </div>
        <div class="dima-spacer"></div>
        <input class="form-control form-control-sm dima-search"
               placeholder="Search Product Type"
               value="@_search"
               @oninput="OnSearchChanged" />
        <button class="btn btn-outline-secondary btn-sm" @onclick="Reload" disabled="@_isBusy">Refresh</button>
    </div>

    <div class="dima-body">
        <aside class="dima-groups">
            <section class="dima-sidebar-section dima-product-section">
                <div class="dima-pane-head">
                    <strong>Product Types</strong>
                    <span>@VisibleGroups.Count</span>
                </div>
                <div class="dima-group-list">
                    @if (VisibleGroups.Count == 0)
                    {
                        <div class="dima-empty-small">No Product Type groups.</div>
                    }
                    else
                    {
                        @foreach (var g in VisibleGroups)
                        {
                            <button class="dima-group-btn @(IsSelected(g.ProductType) ? "active" : "")"
                                    @onclick="() => SelectGroup(g.ProductType)">
                                <span class="dima-group-name">@g.ProductType</span>
                                <span class="dima-group-meta">@g.AiReportCount / @g.ReportCount analyzed</span>
                                @if (!string.IsNullOrWhiteSpace(g.LatestAnalysisAt))
                                {
                                    <span class="dima-group-date">Last: @FormatDate(g.LatestAnalysisAt)</span>
                                }
                            </button>
                        }
                    }
                </div>
            </section>

            <section class="dima-sidebar-section dima-purpose-section">
                <div class="dima-pane-head">
                    <strong>Improvement Purposes</strong>
                    <span>@(SelectedGroup is null ? 0 : PurposeGroups.Count + 1)</span>
                </div>
                <div class="dima-purpose-list">
                    @if (SelectedGroup is null)
                    {
                        <div class="dima-empty-small">Select a Product Type first.</div>
                    }
                    else
                    {
                        <button class="dima-purpose-btn @(IsPurposeSelected(AllPurposeKey) ? "active" : "")"
                                @onclick="() => SelectPurpose(AllPurposeKey)">
                            <span class="dima-purpose-name">All Improvement Purposes</span>
                            <span class="dima-purpose-meta">@AiReportsForAllPurposes.Count / @_reports.Count AI reports</span>
                        </button>

                        @if (PurposeGroups.Count == 0)
                        {
                            <div class="dima-empty-small">No improvement purpose data.</div>
                        }
                        else
                        {
                            @foreach (var p in PurposeGroups)
                            {
                                <button class="dima-purpose-btn @(IsPurposeSelected(p.Key) ? "active" : "")"
                                        title="@p.Label"
                                        @onclick="() => SelectPurpose(p.Key)">
                                    <span class="dima-purpose-name">@ShortText(p.Label, 86)</span>
                                    <span class="dima-purpose-meta">@p.AiReportCount / @p.ReportCount AI reports</span>
                                </button>
                            }
                        }
                    }
                </div>
            </section>
        </aside>

        <main class="dima-main">
            @if (SelectedGroup is null)
            {
                <div class="dima-empty">
                    Select a Product Type to review its reports.
                </div>
            }
            else
            {
                <div class="dima-toolbar">
                    <div>
                        <div class="dima-selected">@SelectedGroup.ProductType</div>
                        <div class="dima-selected-sub">
                            @AnalysisScopeLabel - @AiReports.Count AI report(s), @ScopedReports.Count scoped report(s), @_reports.Count total report(s), @NewReports.Count new or changed since latest analysis
                        </div>
                    </div>
                    <div class="dima-toolbar-actions">
                        <label class="dima-label">View</label>
                        <select class="form-select form-select-sm dima-lang"
                                value="@_language"
                                @onchange="OnLanguageChanged"
                                disabled="@_isBusy">
                            @foreach (string language in ModelAnalysisLanguages)
                            {
                                <option value="@language">@LanguageLabel(language)</option>
                            }
                        </select>
                        <label class="dima-label">Engine</label>
                        <select class="form-select form-select-sm dima-engine" @bind="_executor" disabled="@_isBusy">
                            <option value="@ModelAnalysisExecutor.ClaudeCli" disabled="@(!AiProviders.ClaudeCliEnabled)">Claude CLI</option>
                            <option value="@ModelAnalysisExecutor.CodexCli" disabled="@(!AiProviders.CodexCliEnabled)">Codex CLI</option>
                        </select>
                        <button class="btn btn-outline-primary btn-sm"
                                @onclick="() => AnalyzeAsync(incremental: true)"
                                disabled="@(!_canAnalyze || _latest is null || NewReports.Count == 0)">
                            @IncrementalButtonLabel
                        </button>
                        <button class="btn btn-primary btn-sm"
                                @onclick="() => AnalyzeAsync(incremental: false)"
                                disabled="@(!_canAnalyze || AiReports.Count == 0)">
                            @FullRebuildButtonLabel
                        </button>
                        @if (IsPurposeScoped)
                        {
                            <button class="btn btn-outline-primary btn-sm"
                                    @onclick="AnalyzeAllPurposesAsync"
                                    disabled="@(!_canAnalyze || AiReportsForAllPurposes.Count == 0)">
                                Analyze All Purposes
                            </button>
                        }
                        @if (_isWaitingCli)
                        {
                            <button class="btn btn-outline-danger btn-sm" @onclick="CancelCliWait">
                                Cancel Wait
                            </button>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_status))
                {
                    <div class="dima-status @(_statusError ? "error" : "ok")">@_status</div>
                }

                <div class="dima-stats">
                    <div><strong>@SelectedGroup.ReportCount</strong><span>Total reports</span></div>
                    <div><strong>@SelectedGroup.AiReportCount</strong><span>AI reports</span></div>
                    <div><strong>@FormatDate(SelectedGroup.LatestAiUpdatedAt)</strong><span>Latest AI report</span></div>
                    <div><strong>@(_latest is null ? "-" : FormatDate(_latest.CreatedAt))</strong><span>Latest model analysis</span></div>
                    <div><strong>@($"{CurrentContextChars:N0}")</strong><span>Source chars</span></div>
                </div>

                <div class="dima-workspace">
                    <section class="dima-reports">
                        <div class="dima-pane-head">
                            <strong>@ReportsPaneTitle</strong>
                            <span>@ScopedReports.Count</span>
                        </div>
                        <div class="dima-report-list">
                            @if (ScopedReports.Count == 0)
                            {
                                <div class="dima-empty-small">No reports in this improvement purpose.</div>
                            }
                            else
                            {
                                @foreach (var r in ScopedReports)
                                {
                                    bool isNew = IsNewOrChanged(r);
                                    <div class="dima-report @(r.HasAiReport ? "" : "missing") @(isNew ? "new" : "")">
                                        <div class="dima-report-head">
                                            <div class="dima-report-name">@r.DatasetName</div>
                                            <button class="btn btn-outline-secondary btn-sm dima-view-btn"
                                                    @onclick="() => ViewReport(r)"
                                                    disabled="@(!r.HasAiReport)">
                                                View
                                            </button>
                                        </div>
                                        <div class="dima-report-title">@ShortText(DisplayTitle(r), 150)</div>
                                        @if (!string.IsNullOrWhiteSpace(r.Purpose))
                                        {
                                            <div class="dima-report-purpose">@ShortText(r.Purpose, 170)</div>
                                        }
                                        <div class="dima-report-meta">
                                            @if (!string.IsNullOrWhiteSpace(r.ReportDate))
                                            {
                                                <span>@r.ReportDate</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(r.ReportType))
                                            {
                                                <span>@r.ReportType</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(r.PrimaryDefect))
                                            {
                                                <span>@r.PrimaryDefect</span>
                                            }
                                            @if (r.HasAiReport)
                                            {
                                                <span>@($"{r.GeneratedReportMarkdown.Length:N0}") chars</span>
                                                <span>@r.ResultCount result(s)</span>
                                            }
                                            else
                                            {
                                                <span>No AI report</span>
                                            }
                                            @if (isNew)
                                            {
                                                <span class="dima-pill-new">New</span>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </section>

                    <section class="dima-analysis">
                        <div class="dima-pane-head">
                            <strong>Model Analysis</strong>
                            <div class="dima-history-select">
                                @if (ScopedHistory.Count > 1)
                                {
                                    <select class="form-select form-select-sm"
                                            value="@(_activeAnalysisId?.ToString() ?? "")"
                                            @onchange="OnHistoryChanged">
                                        @foreach (var h in ScopedHistory)
                                        {
                                            <option value="@h.Id">@FormatDate(h.CreatedAt) - @LanguageLabel(h.Language) - @h.AnalysisMode - @h.ReportCount</option>
                                        }
                                    </select>
                                }
                            </div>
                        </div>

                        @if (_isBusy)
                        {
                            <div class="dima-empty dima-fill">
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                Analyzing selected report scope...
                            </div>
                        }
                        else if (string.IsNullOrWhiteSpace(_activeMarkdown))
                        {
                            <div class="dima-empty dima-fill">
                                No saved model analysis for this scope.
                            </div>
                        }
                        else
                        {
                            <article class="dima-md">
                                @if (!string.IsNullOrWhiteSpace(_activeTableMarkdown))
                                {
                                    <div class="dima-table-only">
                                        @RenderMarkdown(_activeTableMarkdown)
                                    </div>
                                }
                                @RenderMarkdown(_activeMarkdown)
                            </article>
                        }
                    </section>
                </div>
            }
        </main>
    </div>

    @if (_viewReport is not null)
    {
        <div class="dima-modal-backdrop" @onclick="CloseReport">
            <div class="dima-modal" @onclick:stopPropagation="true">
                <div class="dima-modal-head">
                    <div>
                        <div class="dima-modal-title">@_viewReport.DatasetName</div>
                        <div class="dima-modal-sub">@DisplayTitle(_viewReport)</div>
                    </div>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="CloseReport">Close</button>
                </div>
                <div class="dima-modal-meta">
                    @if (!string.IsNullOrWhiteSpace(_viewReport.ReportDate)) { <span>@_viewReport.ReportDate</span> }
                    @if (!string.IsNullOrWhiteSpace(_viewReport.Purpose)) { <span>@ShortText(_viewReport.Purpose, 90)</span> }
                    @if (!string.IsNullOrWhiteSpace(_viewReport.ReportType)) { <span>@_viewReport.ReportType</span> }
                    @if (!string.IsNullOrWhiteSpace(_viewReport.PrimaryDefect)) { <span>@_viewReport.PrimaryDefect</span> }
                    <span>@($"{_viewReport.GeneratedReportMarkdown.Length:N0}") chars</span>
                </div>
                <article class="dima-md dima-modal-body">
                    @RenderMarkdown(_viewReport.GeneratedReportMarkdown)
                </article>
            </div>
        </div>
    }
</div>

@code {
    private enum ModelAnalysisExecutor
    {
        ClaudeCli,
        CodexCli
    }

    private const string AllPurposeKey = "__all__";
    private const string UnclassifiedPurpose = "Unclassified improvement purpose";

    private sealed record PurposeGroup(
        string Key,
        string Label,
        int ReportCount,
        int AiReportCount,
        List<ModelAnalysisReportRecord> Reports);

    private static readonly string[] ModelAnalysisLanguages = ["Korean", "English", "Vietnamese"];

    private List<ModelAnalysisGroupRecord> _groups = [];
    private List<ModelAnalysisReportRecord> _reports = [];
    private List<AiModelAnalysisRecord> _history = [];
    private AiModelAnalysisRecord? _latest;
    private ModelAnalysisReportRecord? _viewReport;
    private ModelAnalysisExecutor _executor = ModelAnalysisExecutor.ClaudeCli;
    private long? _activeAnalysisId;
    private string _selectedProductType = "";
    private string _selectedPurposeKey = AllPurposeKey;
    private string _search = "";
    private string _language = "Korean";
    private string _status = "";
    private string _activeMarkdown = "";
    private string _activeTableMarkdown = "";
    private bool _statusError;
    private bool _isBusy;
    private bool _isWaitingCli;
    private CancellationTokenSource? _cliWaitCts;

    private bool _canAnalyze => !_isBusy && SelectedExecutorEnabled;
    private bool SelectedExecutorEnabled => _executor == ModelAnalysisExecutor.CodexCli
        ? AiProviders.CodexCliEnabled
        : AiProviders.ClaudeCliEnabled;
    private string ExecutorLabel => _executor == ModelAnalysisExecutor.CodexCli ? "Codex CLI" : "Claude CLI";

    private List<ModelAnalysisGroupRecord> VisibleGroups => _groups
        .Where(g => string.IsNullOrWhiteSpace(_search)
                    || g.ProductType.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase))
        .ToList();

    private ModelAnalysisGroupRecord? SelectedGroup =>
        _groups.FirstOrDefault(g => string.Equals(g.ProductType, _selectedProductType, StringComparison.OrdinalIgnoreCase));

    private List<PurposeGroup> PurposeGroups => BuildPurposeGroups(_reports);

    private bool IsPurposeScoped => !string.Equals(_selectedPurposeKey, AllPurposeKey, StringComparison.OrdinalIgnoreCase);

    private PurposeGroup? SelectedPurposeGroup =>
        PurposeGroups.FirstOrDefault(g => string.Equals(g.Key, _selectedPurposeKey, StringComparison.OrdinalIgnoreCase));

    private List<ModelAnalysisReportRecord> ScopedReports => IsPurposeScoped
        ? SelectedPurposeGroup?.Reports ?? new List<ModelAnalysisReportRecord>()
        : _reports;

    private List<ModelAnalysisReportRecord> AiReportsForAllPurposes => _reports
        .Where(r => r.HasAiReport)
        .ToList();

    private List<ModelAnalysisReportRecord> AiReports => ScopedReports
        .Where(r => r.HasAiReport)
        .ToList();

    private int CurrentContextChars => AiReports.Sum(r => r.GeneratedReportMarkdown.Length);

    private string AnalysisScopeLabel => IsPurposeScoped
        ? $"Purpose: {SelectedPurposeGroup?.Label ?? UnclassifiedPurpose}"
        : "All improvement purposes";

    private string IncrementalButtonLabel => IsPurposeScoped
        ? "Update Purpose"
        : "Update New Reports";

    private string FullRebuildButtonLabel => IsPurposeScoped
        ? "Analyze Purpose"
        : "Analyze All Purposes";

    private string ReportsPaneTitle => IsPurposeScoped
        ? "Reports in Selected Purpose"
        : "Reports in Product Type";

    private List<AiModelAnalysisRecord> ScopedHistory => _history
        .Where(IsAnalysisForCurrentScope)
        .ToList();

    private HashSet<string> LatestIncludedDatasets => ParseIncludedDatasets(_latest?.IncludedDatasetsJson);

    private List<ModelAnalysisReportRecord> NewReports => _latest is null
        ? AiReports
        : AiReports.Where(IsNewOrChanged).ToList();

    protected override void OnInitialized()
    {
        if (!AiProviders.ClaudeCliEnabled && AiProviders.CodexCliEnabled)
            _executor = ModelAnalysisExecutor.CodexCli;
        Reload();
    }

    private void Reload()
    {
        string previousProductType = _selectedProductType;
        _groups = Repo.GetModelAnalysisGroups();
        if (string.IsNullOrWhiteSpace(_selectedProductType)
            || !_groups.Any(g => string.Equals(g.ProductType, _selectedProductType, StringComparison.OrdinalIgnoreCase)))
        {
            _selectedProductType = _groups.FirstOrDefault()?.ProductType ?? "";
        }
        if (!string.Equals(previousProductType, _selectedProductType, StringComparison.OrdinalIgnoreCase))
            _selectedPurposeKey = AllPurposeKey;
        LoadSelectedGroup();
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
    }

    private void SelectGroup(string productType)
    {
        if (_isBusy) return;
        _selectedProductType = productType;
        _selectedPurposeKey = AllPurposeKey;
        LoadSelectedGroup();
    }

    private void SelectPurpose(string purposeKey)
    {
        if (_isBusy) return;
        _selectedPurposeKey = string.IsNullOrWhiteSpace(purposeKey) ? AllPurposeKey : purposeKey;
        EnsureSelectedPurpose();
        _latest = LatestAnalysisForCurrentScope();
        SetActiveAnalysis(PreferredAnalysis());
        _status = "";
        _statusError = false;
    }

    private void LoadSelectedGroup()
    {
        if (string.IsNullOrWhiteSpace(_selectedProductType))
        {
            _reports = [];
            _history = [];
            _latest = null;
            _activeAnalysisId = null;
            _activeMarkdown = "";
            _activeTableMarkdown = "";
            return;
        }

        _reports = Repo.GetModelAnalysisReports(_selectedProductType);
        _history = Repo.GetModelAnalysisHistory(_selectedProductType, 300);
        EnsureSelectedPurpose();
        _latest = LatestAnalysisForCurrentScope();
        SetActiveAnalysis(PreferredAnalysis());
        _status = "";
        _statusError = false;
    }

    private void EnsureSelectedPurpose()
    {
        if (string.Equals(_selectedPurposeKey, AllPurposeKey, StringComparison.OrdinalIgnoreCase)) return;
        if (PurposeGroups.Any(g => string.Equals(g.Key, _selectedPurposeKey, StringComparison.OrdinalIgnoreCase))) return;
        _selectedPurposeKey = AllPurposeKey;
    }

    private AiModelAnalysisRecord? LatestAnalysisForCurrentScope()
        => ScopedHistory.FirstOrDefault();

    private AiModelAnalysisRecord? PreferredAnalysis()
        => ScopedHistory.FirstOrDefault(h => string.Equals(h.Language, _language, StringComparison.OrdinalIgnoreCase))
           ?? ScopedHistory.FirstOrDefault();

    private void SetActiveAnalysis(AiModelAnalysisRecord? analysis)
    {
        _activeAnalysisId = analysis?.Id;
        _activeMarkdown = analysis?.AnalysisMarkdown ?? "";
        _activeTableMarkdown = analysis?.AnalysisTableMarkdown ?? "";
    }

    private async Task AnalyzeAsync(bool incremental)
    {
        if (SelectedGroup is null)
        {
            SetStatus("Select a Product Type first.", true);
            return;
        }
        if (!SelectedExecutorEnabled)
        {
            SetStatus(AiProviders.ProviderDisabledMessage(ExecutorLabel), true);
            return;
        }

        List<ModelAnalysisReportRecord> sourceReports =
            incremental && _latest is not null ? NewReports : AiReports;

        if (sourceReports.Count == 0)
        {
            SetStatus(incremental
                ? "No new or changed AI reports to update."
                : "No AI report markdown exists for this selected scope.",
                true);
            return;
        }

        try
        {
            bool incrementalRun = incremental && _latest is not null;
            string context = BuildModelContext(incremental, sourceReports);
            HashSet<string> included = incremental && _latest is not null
                ? LatestIncludedDatasets
                : [];
            foreach (var r in sourceReports) included.Add(r.DatasetName);
            if (!incremental || _latest is null)
            {
                included = AiReports.Select(r => r.DatasetName).ToHashSet(StringComparer.OrdinalIgnoreCase);
            }

            string includedJson = System.Text.Json.JsonSerializer.Serialize(included.Order(StringComparer.OrdinalIgnoreCase).ToList());
            string hash = Sha256Hex(context);
            string workDir = FindRepoRoot();
            string tmpDir = Path.Combine(workDir, "tmp");
            Directory.CreateDirectory(tmpDir);
            string runId = Guid.NewGuid().ToString("N")[..12];
            DateTime startedUtc = DateTime.UtcNow;

            List<string> includedDatasets = included.Order(StringComparer.OrdinalIgnoreCase).ToList();
            bool launched = _executor == ModelAnalysisExecutor.CodexCli
                ? LaunchCodexByLanguage(workDir, tmpDir, runId, startedUtc, SelectedGroup.ProductType,
                    incrementalRun, IsPurposeScoped, AnalysisScopeLabel, included.Count, includedDatasets, hash, context)
                : LaunchClaudeForAllLanguages(workDir, tmpDir, runId, startedUtc, SelectedGroup.ProductType,
                    incrementalRun, IsPurposeScoped, AnalysisScopeLabel, included.Count, includedDatasets, hash, context);

            if (!launched)
            {
                SetStatus($"Failed to launch {ExecutorLabel}.", true);
                return;
            }

            _isBusy = true;
            _isWaitingCli = true;
            string launchedText = _executor == ModelAnalysisExecutor.CodexCli
                ? "Codex CLI launched in 3 parallel language terminals"
                : $"{ExecutorLabel} launched";
            SetStatus(
                incrementalRun
                    ? $"{launchedText}. Waiting for Korean, English, and Vietnam model analysis updates from {sourceReports.Count} new or changed report(s) in {AnalysisScopeLabel}."
                    : $"{launchedText}. Waiting for Korean, English, and Vietnam full model analyses from {sourceReports.Count} AI report(s) in {AnalysisScopeLabel}.",
                false);

            await WaitForCliResultAsync(SelectedGroup.ProductType, hash, startedUtc);
        }
        catch (Exception ex)
        {
            SetStatus($"Analysis failed: {ex.Message}", true);
        }
        finally
        {
            _isBusy = false;
            _isWaitingCli = false;
        }
    }

    private async Task AnalyzeAllPurposesAsync()
    {
        if (_isBusy) return;
        _selectedPurposeKey = AllPurposeKey;
        _latest = LatestAnalysisForCurrentScope();
        SetActiveAnalysis(PreferredAnalysis());
        await AnalyzeAsync(incremental: false);
    }

    private bool LaunchClaudeForAllLanguages(string workDir, string tmpDir, string runId, DateTime startedUtc,
        string productType, bool incrementalRun, bool purposeScoped, string improvementPurposeScope,
        int reportCount, IReadOnlyList<string> includedDatasets, string sourceContextHash, string context)
    {
        if (!AiProviders.ClaudeCliEnabled) return false;
        string requestPath = Path.Combine(tmpDir, $"model_analysis_request_{runId}.json");
        WriteModelAnalysisRequest(requestPath, productType, incrementalRun, ModelAnalysisLanguages,
            purposeScoped, improvementPurposeScope, reportCount, includedDatasets, sourceContextHash, startedUtc, context);
        string prompt = BuildModelAnalysisCliPrompt(requestPath, Repo.GetDbPath());
        return TryLaunchClaudeTerminal(workDir, prompt, $"Each Model Analysis ({productType})", requestPath);
    }

    private bool LaunchCodexByLanguage(string workDir, string tmpDir, string runId, DateTime startedUtc,
        string productType, bool incrementalRun, bool purposeScoped, string improvementPurposeScope,
        int reportCount, IReadOnlyList<string> includedDatasets, string sourceContextHash, string context)
    {
        if (!AiProviders.CodexCliEnabled) return false;
        var launched = new List<string>();
        foreach (string language in ModelAnalysisLanguages)
        {
            string requestPath = Path.Combine(tmpDir, $"model_analysis_request_{runId}_{LanguageSlug(language)}.json");
            WriteModelAnalysisRequest(requestPath, productType, incrementalRun, new[] { language },
                purposeScoped, improvementPurposeScope, reportCount, includedDatasets, sourceContextHash, startedUtc, context);
            string prompt = BuildModelAnalysisCliPrompt(requestPath, Repo.GetDbPath());
            if (!TryLaunchCodexTerminal(workDir, prompt, $"Each Model Analysis ({productType}) - {LanguageLabel(language)}", requestPath))
            {
                SetStatus($"Failed to launch Codex CLI for {LanguageLabel(language)}. Already launched: {string.Join(", ", launched.Select(LanguageLabel))}.", true);
                return false;
            }
            launched.Add(language);
        }
        return true;
    }

    private static void WriteModelAnalysisRequest(string requestPath, string productType, bool incrementalRun,
        IReadOnlyList<string> languages, bool purposeScoped, string improvementPurposeScope,
        int reportCount, IReadOnlyList<string> includedDatasets, string sourceContextHash, DateTime startedUtc, string context)
    {
        string[] requestedLanguages = languages.ToArray();
        string analysisMode = purposeScoped
            ? (incrementalRun ? "purpose_incremental" : "purpose_full")
            : (incrementalRun ? "incremental" : "full");
        var request = new
        {
            productType,
            analysisMode,
            purposeScoped,
            improvementPurposeScope,
            language = requestedLanguages.Length == 1 ? requestedLanguages[0] : "All",
            languages = requestedLanguages,
            reportCount,
            includedDatasets,
            sourceContextHash,
            createdAt = startedUtc.ToString("o"),
            context
        };

        File.WriteAllText(
            requestPath,
            System.Text.Json.JsonSerializer.Serialize(
                request,
                new System.Text.Json.JsonSerializerOptions { WriteIndented = true }),
            new System.Text.UTF8Encoding(encoderShouldEmitUTF8Identifier: false));
    }

    private string BuildModelContext(bool incremental, IReadOnlyList<ModelAnalysisReportRecord> sourceReports)
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"ProductType: {_selectedProductType}");
        sb.AppendLine($"AnalysisMode: {(incremental && _latest is not null ? "incremental_update" : "full_rebuild")}");
        sb.AppendLine($"ImprovementPurposeScope: {AnalysisScopeLabel}");
        sb.AppendLine($"PurposeScoped: {IsPurposeScoped}");
        sb.AppendLine($"TotalReportsInProductType: {_reports.Count}");
        sb.AppendLine($"ReportsInSelectedScope: {ScopedReports.Count}");
        sb.AppendLine($"AiReportsInProductType: {AiReportsForAllPurposes.Count}");
        sb.AppendLine($"AiReportsInSelectedScope: {AiReports.Count}");
        sb.AppendLine($"SourceReportsInThisPrompt: {sourceReports.Count}");
        sb.AppendLine();

        if (incremental && _latest is not null)
        {
            List<AiModelAnalysisRecord> baselines = ModelAnalysisLanguages
                .Select(language => ScopedHistory.FirstOrDefault(h => string.Equals(h.Language, language, StringComparison.OrdinalIgnoreCase)))
                .Where(h => h is not null)
                .Cast<AiModelAnalysisRecord>()
                .GroupBy(h => h.Id)
                .Select(g => g.First())
                .ToList();
            if (baselines.Count == 0 && !string.IsNullOrWhiteSpace(_latest.AnalysisMarkdown))
            {
                baselines.Add(_latest);
            }

            sb.AppendLine("===== PREVIOUS MODEL ANALYSES BY LANGUAGE =====");
            foreach (var baseline in baselines)
            {
                sb.AppendLine($"----- Previous Language: {baseline.Language}");
                if (!string.IsNullOrWhiteSpace(baseline.AnalysisTableMarkdown))
                {
                    sb.AppendLine("PREVIOUS_MAIN_COMPARISON_TABLE:");
                    sb.AppendLine(baseline.AnalysisTableMarkdown.Trim());
                    sb.AppendLine();
                }
                sb.AppendLine("PREVIOUS_FULL_ANALYSIS:");
                sb.AppendLine(baseline.AnalysisMarkdown.Trim());
                sb.AppendLine();
            }
            sb.AppendLine("===== NEW OR CHANGED AI REPORTS =====");
        }
        else
        {
            sb.AppendLine("===== AI REPORTS =====");
        }

        int idx = 1;
        foreach (var r in sourceReports)
        {
            sb.AppendLine($"----- [{idx++}] Dataset: {r.DatasetName}");
            sb.AppendLine($"ProductType: {r.ProductType}");
            if (!string.IsNullOrWhiteSpace(r.ReportDate)) sb.AppendLine($"ReportDate: {r.ReportDate}");
            if (!string.IsNullOrWhiteSpace(r.Title)) sb.AppendLine($"Title: {r.Title}");
            if (!string.IsNullOrWhiteSpace(r.Purpose)) sb.AppendLine($"Purpose: {r.Purpose}");
            if (!string.IsNullOrWhiteSpace(r.ReportType)) sb.AppendLine($"ReportType: {r.ReportType}");
            if (!string.IsNullOrWhiteSpace(r.PrimaryDefect)) sb.AppendLine($"PrimaryDefect: {r.PrimaryDefect}");
            sb.AppendLine($"ResultRows: {r.ResultCount}");
            sb.AppendLine($"ConclusionRows: {r.ConclusionCount}");
            sb.AppendLine("AI_REPORT_MARKDOWN:");
            sb.AppendLine(r.GeneratedReportMarkdown.Trim());
            sb.AppendLine();
        }
        return sb.ToString();
    }

