    private static string ShortText(string text, int max)
    {
        text = (text ?? "").Trim();
        return text.Length <= max ? text : text[..Math.Max(0, max - 1)] + "...";
    }

    private static string FormatDate(string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "-";
        if (DateTime.TryParse(value, null, System.Globalization.DateTimeStyles.RoundtripKind, out var dt))
            return dt.ToLocalTime().ToString("yyyy-MM-dd HH:mm");
        return value;
    }

    private static HashSet<string> ParseIncludedDatasets(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return new(StringComparer.OrdinalIgnoreCase);
        try
        {
            return System.Text.Json.JsonSerializer.Deserialize<List<string>>(json)
                ?.ToHashSet(StringComparer.OrdinalIgnoreCase)
                ?? new(StringComparer.OrdinalIgnoreCase);
        }
        catch
        {
            return new(StringComparer.OrdinalIgnoreCase);
        }
    }

    private static string CleanModelMarkdown(string raw)
    {
        string text = (raw ?? "").Trim();
        if (!text.StartsWith("```", StringComparison.Ordinal)) return text;

        int firstLine = text.IndexOf('\n');
        if (firstLine >= 0) text = text[(firstLine + 1)..];
        int lastFence = text.LastIndexOf("```", StringComparison.Ordinal);
        if (lastFence >= 0) text = text[..lastFence];
        return text.Trim();
    }

    private static string Sha256Hex(string text)
    {
        byte[] bytes = System.Text.Encoding.UTF8.GetBytes(text ?? "");
        return Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(bytes)).ToLowerInvariant();
    }

    private static Microsoft.AspNetCore.Components.MarkupString RenderMarkdown(string? markdown)
    {
        string text = (markdown ?? "").Replace("\r\n", "\n").Replace('\r', '\n');
        var lines = text.Split('\n');
        var sb = new System.Text.StringBuilder();
        bool inList = false;

        static string Enc(string value) => System.Net.WebUtility.HtmlEncode(value ?? "");
        static string Inline(string value)
        {
            string html = Enc(value);
            html = System.Text.RegularExpressions.Regex.Replace(html, @"\*\*(.+?)\*\*", "<strong>$1</strong>");
            html = System.Text.RegularExpressions.Regex.Replace(html, @"`([^`]+)`", "<code>$1</code>");
            return html;
        }

        void CloseList()
        {
            if (!inList) return;
            sb.AppendLine("</ul>");
            inList = false;
        }

        for (int i = 0; i < lines.Length; i++)
        {
            string line = lines[i];
            string trim = line.Trim();

            if (string.IsNullOrWhiteSpace(trim))
            {
                CloseList();
                continue;
            }

            if (trim.StartsWith('|') && trim.EndsWith('|')
                && i + 1 < lines.Length
                && lines[i + 1].Trim().StartsWith('|')
                && lines[i + 1].Contains("---", StringComparison.Ordinal))
            {
                CloseList();
                var headers = SplitMarkdownTableRow(trim);
                sb.AppendLine("<table><thead><tr>");
                foreach (string h in headers) sb.Append("<th>").Append(Inline(h)).AppendLine("</th>");
                sb.AppendLine("</tr></thead><tbody>");
                i += 2;
                for (; i < lines.Length; i++)
                {
                    string row = lines[i].Trim();
                    if (!row.StartsWith('|') || !row.EndsWith('|')) { i--; break; }
                    sb.AppendLine("<tr>");
                    foreach (string cell in SplitMarkdownTableRow(row)) sb.Append("<td>").Append(Inline(cell)).AppendLine("</td>");
                    sb.AppendLine("</tr>");
                }
                sb.AppendLine("</tbody></table>");
                continue;
            }

            if (trim.StartsWith("### ", StringComparison.Ordinal))
            {
                CloseList();
                sb.Append("<h3>").Append(Inline(trim[4..].Trim())).AppendLine("</h3>");
                continue;
            }
            if (trim.StartsWith("## ", StringComparison.Ordinal))
            {
                CloseList();
                sb.Append("<h2>").Append(Inline(trim[3..].Trim())).AppendLine("</h2>");
                continue;
            }
            if (trim.StartsWith("- ", StringComparison.Ordinal))
            {
                if (!inList)
                {
                    sb.AppendLine("<ul>");
                    inList = true;
                }
                sb.Append("<li>").Append(Inline(trim[2..].Trim())).AppendLine("</li>");
                continue;
            }

            CloseList();
            sb.Append("<p>").Append(Inline(trim)).AppendLine("</p>");
        }
        CloseList();
        return new Microsoft.AspNetCore.Components.MarkupString(sb.ToString());
    }

    private static List<string> SplitMarkdownTableRow(string row)
        => row.Trim().Trim('|').Split('|').Select(x => x.Trim()).ToList();

    public void Dispose()
    {
        try { _cliWaitCts?.Cancel(); } catch { }
        _cliWaitCts?.Dispose();
    }
