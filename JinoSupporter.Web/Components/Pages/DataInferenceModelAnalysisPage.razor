    private static bool TryLaunchClaudeTerminal(string workDir, string prompt, string title, string requestPath)
        => TryLaunchTerminal(workDir, prompt, title, requestPath, useCodex: false);

    private static bool TryLaunchCodexTerminal(string workDir, string prompt, string title, string requestPath)
        => TryLaunchTerminal(workDir, prompt, title, requestPath, useCodex: true);

    private static bool TryLaunchTerminal(string workDir, string prompt, string title, string requestPath, bool useCodex)
    {
        string launchId = Guid.NewGuid().ToString("N")[..12];
        string promptPath = Path.Combine(workDir, useCodex
            ? $"_model_analysis_prompt_codex_{launchId}.txt"
            : $"_model_analysis_prompt_claude_{launchId}.txt");
        string scriptPath = Path.Combine(workDir, useCodex
            ? $"_model_analysis_launch_codex_{launchId}.ps1"
            : $"_model_analysis_launch_claude_{launchId}.ps1");

        try
        {
            File.WriteAllText(promptPath, prompt, new System.Text.UTF8Encoding(encoderShouldEmitUTF8Identifier: false));
            File.WriteAllText(
                scriptPath,
                useCodex
                    ? BuildCodexLauncherScript(workDir, promptPath, scriptPath, title, requestPath)
                    : BuildClaudeLauncherScript(workDir, promptPath, scriptPath, title, requestPath),
                new System.Text.UTF8Encoding(encoderShouldEmitUTF8Identifier: false));
        }
        catch
        {
            return false;
        }

        try
        {
            var wt = new System.Diagnostics.ProcessStartInfo
            {
                FileName = "wt.exe",
                UseShellExecute = false,
                CreateNoWindow = false,
            };
            wt.ArgumentList.Add("-d");
            wt.ArgumentList.Add(workDir);
            wt.ArgumentList.Add("powershell.exe");
            wt.ArgumentList.Add("-NoExit");
            wt.ArgumentList.Add("-NoProfile");
            wt.ArgumentList.Add("-ExecutionPolicy");
            wt.ArgumentList.Add("Bypass");
            wt.ArgumentList.Add("-File");
            wt.ArgumentList.Add(scriptPath);
            var proc = System.Diagnostics.Process.Start(wt);
            if (proc is not null) ChildProcessJob.Assign(proc);
            return true;
        }
        catch { }

        try
        {
            var psi = new System.Diagnostics.ProcessStartInfo
            {
                FileName = "cmd.exe",
                WorkingDirectory = workDir,
                UseShellExecute = false,
                CreateNoWindow = false,
            };
            psi.ArgumentList.Add("/k");
            psi.ArgumentList.Add("powershell.exe");
            psi.ArgumentList.Add("-NoExit");
            psi.ArgumentList.Add("-NoProfile");
            psi.ArgumentList.Add("-ExecutionPolicy");
            psi.ArgumentList.Add("Bypass");
            psi.ArgumentList.Add("-File");
            psi.ArgumentList.Add(scriptPath);
            var proc = System.Diagnostics.Process.Start(psi);
            if (proc is not null) ChildProcessJob.Assign(proc);
            return true;
        }
        catch
        {
            return false;
        }
    }

    private static string BuildClaudeLauncherScript(string workDir, string promptPath, string scriptPath, string title, string requestPath)
    {
        static string Q(string value) => "'" + (value ?? "").Replace("'", "''") + "'";
        return string.Join(Environment.NewLine, new[]
        {
            "$ErrorActionPreference = 'Continue'",
            "[Console]::OutputEncoding = [System.Text.Encoding]::UTF8",
            "try { chcp 65001 | Out-Null } catch {}",
            $"try {{ $Host.UI.RawUI.WindowTitle = {Q(title)} }} catch {{}}",
            $"Set-Location -LiteralPath {Q(workDir)}",
            $"$promptPath = {Q(promptPath)}",
            $"$scriptPath = {Q(scriptPath)}",
            $"$requestPath = {Q(requestPath)}",
            "$prompt = Get-Content -LiteralPath $promptPath -Raw -Encoding UTF8",
            "& claude --permission-mode bypassPermissions -p $prompt",
            "$exitCode = if ($null -eq $LASTEXITCODE) { 0 } else { $LASTEXITCODE }",
            "if ($exitCode -ne 0) { Write-Host ('Claude exited with code ' + $exitCode + '.') -ForegroundColor Yellow }",
            "if ($exitCode -eq 0) { Remove-Item -LiteralPath $requestPath -Force -ErrorAction SilentlyContinue }",
            "Remove-Item -LiteralPath $promptPath -Force -ErrorAction SilentlyContinue",
            "Remove-Item -LiteralPath $scriptPath -Force -ErrorAction SilentlyContinue",
        });
    }

    private static string BuildCodexLauncherScript(string workDir, string promptPath, string scriptPath, string title, string requestPath)
    {
        static string Q(string value) => "'" + (value ?? "").Replace("'", "''") + "'";
        return string.Join(Environment.NewLine, new[]
        {
            "$ErrorActionPreference = 'Continue'",
            "[Console]::OutputEncoding = [System.Text.Encoding]::UTF8",
            "try { chcp 65001 | Out-Null } catch {}",
            $"try {{ $Host.UI.RawUI.WindowTitle = {Q(title)} }} catch {{}}",
            $"Set-Location -LiteralPath {Q(workDir)}",
            $"$promptPath = {Q(promptPath)}",
            $"$scriptPath = {Q(scriptPath)}",
            $"$requestPath = {Q(requestPath)}",
            "$prompt = Get-Content -LiteralPath $promptPath -Raw -Encoding UTF8",
            $"$prompt | & codex exec -c 'model_reasoning_effort=\"xhigh\"' --cd {Q(workDir)} --dangerously-bypass-approvals-and-sandbox --skip-git-repo-check -",
            "$exitCode = if ($null -eq $LASTEXITCODE) { 0 } else { $LASTEXITCODE }",
            "if ($exitCode -ne 0) { Write-Host ('Codex exited with code ' + $exitCode + '.') -ForegroundColor Yellow }",
            "if ($exitCode -eq 0) { Remove-Item -LiteralPath $requestPath -Force -ErrorAction SilentlyContinue }",
            "Remove-Item -LiteralPath $promptPath -Force -ErrorAction SilentlyContinue",
            "Remove-Item -LiteralPath $scriptPath -Force -ErrorAction SilentlyContinue",
        });
    }

    private static string FindRepoRoot()
    {
        string dir = AppContext.BaseDirectory;
        for (int i = 0; i < 8; i++)
        {
            if (File.Exists(Path.Combine(dir, "JinoSupporter.sln"))) return dir;
            if (File.Exists(Path.Combine(dir, "AI_EXCEL_PROC.md"))) return dir;
            string? parent = Path.GetDirectoryName(dir.TrimEnd('\\', '/'));
            if (string.IsNullOrEmpty(parent) || parent == dir) break;
            dir = parent;
        }
        return AppContext.BaseDirectory;
    }

