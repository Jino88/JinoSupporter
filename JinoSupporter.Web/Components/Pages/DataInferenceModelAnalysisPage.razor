    private static List<PurposeGroup> BuildPurposeGroups(IEnumerable<ModelAnalysisReportRecord> reports)
        => reports
            .Select(r => (Report: r, Label: ImprovementPurposeLabel(r)))
            .GroupBy(x => PurposeKey(x.Label), StringComparer.OrdinalIgnoreCase)
            .Select(g =>
            {
                List<ModelAnalysisReportRecord> groupedReports = g.Select(x => x.Report)
                    .OrderByDescending(r => r.ReportDate)
                    .ThenBy(r => r.DatasetName, StringComparer.OrdinalIgnoreCase)
                    .ToList();
                string label = g.GroupBy(x => x.Label, StringComparer.OrdinalIgnoreCase)
                    .OrderByDescending(x => x.Count())
                    .ThenBy(x => x.Key, StringComparer.OrdinalIgnoreCase)
                    .First().Key;
                return new PurposeGroup(
                    g.Key,
                    label,
                    groupedReports.Count,
                    groupedReports.Count(r => r.HasAiReport),
                    groupedReports);
            })
            .OrderByDescending(g => g.AiReportCount)
            .ThenByDescending(g => g.ReportCount)
            .ThenBy(g => g.Label, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private static string ImprovementPurposeLabel(ModelAnalysisReportRecord report)
    {
        string text = string.Join(" ", new[]
            {
                report.Purpose,
                report.Title,
                report.ReportType,
                report.PrimaryDefect
            })
            .ToLowerInvariant();

        if (HasAny(text, "function", "func", "ng function")) return "Function NG";
        if (HasAny(text, "bending", "bend")) return "VP bending / deformation";
        if (HasAny(text, "separate", "separation", "dome", "vp+cd", "vp + cd")) return "VP+CD / DOME separation";
        if (HasAny(text, "height", "dimension", "diameter", "gauss", "magnet", "size", "thickness", "low gauss")) return "Dimension / height / magnetic spec";
        if (HasAny(text, "bond", "bonding", "solder", "weld", "welding", "hearing", "coil", "suspension")) return "Bonding / solder / welding";
        if (HasAny(text, "material", "frame", "yk", "pt ", " sus", "resin", "change dimension")) return "Material / part change";
        if (HasAny(text, "oven", "dry", "drying", "laser", "cutting", "punch", "machine", "jig", "tray", "condition", "process", "temperature", "time")) return "Process / equipment condition";
        if (HasAny(text, "mold", "mould", "supplier", "vendor", "lot", "normal", "old ", "new mold", "comparison", "compare")) return "Mold / lot / supplier comparison";
        if (HasAny(text, "root cause", "reason", "cause", "why", "analyze", "analysis")) return "Root cause analysis";

        string reportType = HumanizeToken(report.ReportType);
        if (!string.IsNullOrWhiteSpace(reportType)) return reportType;

        string primary = FirstNonBlank(report.PrimaryDefect, report.Purpose, report.Title, UnclassifiedPurpose);
        return ShortPurposeLabel(primary);
    }

    private static string PurposeKey(string label)
    {
        string compact = System.Text.RegularExpressions.Regex.Replace(label ?? "", @"\s+", " ").Trim();
        compact = compact.Trim(' ', '.', ',', ';', ':', '-', '_', '/', '\\', '|', '"', '\'');
        return string.IsNullOrWhiteSpace(compact)
            ? UnclassifiedPurpose
            : compact.ToUpperInvariant();
    }

    private static string FirstNonBlank(params string?[] values)
        => values.FirstOrDefault(v => !string.IsNullOrWhiteSpace(v))?.Trim() ?? "";

    private static bool HasAny(string text, params string[] needles)
        => needles.Any(n => text.Contains(n, StringComparison.OrdinalIgnoreCase));

    private static string HumanizeToken(string value)
    {
        string text = (value ?? "").Trim();
        if (string.IsNullOrWhiteSpace(text) || string.Equals(text, "mixed", StringComparison.OrdinalIgnoreCase)) return "";
        text = text.Replace('_', ' ').Replace('-', ' ');
        text = System.Text.RegularExpressions.Regex.Replace(text, @"\s+", " ").Trim();
        return System.Globalization.CultureInfo.InvariantCulture.TextInfo.ToTitleCase(text.ToLowerInvariant());
    }

    private static string ShortPurposeLabel(string value)
    {
        string text = System.Text.RegularExpressions.Regex.Replace(value ?? "", @"\s+", " ").Trim();
        if (string.IsNullOrWhiteSpace(text)) return UnclassifiedPurpose;
        text = System.Text.RegularExpressions.Regex.Replace(
            text,
            @"^(to\s+)?(check|find|analyze|analyse|compare|verify|test|improve|reduce)\s+",
            "",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        return ShortText(string.IsNullOrWhiteSpace(text) ? (value ?? UnclassifiedPurpose) : text, 52);
    }

    private bool IsNewOrChanged(ModelAnalysisReportRecord r)
    {
        if (_latest is null || !r.HasAiReport) return r.HasAiReport;
        if (!LatestIncludedDatasets.Contains(r.DatasetName)) return true;
        if (DateTime.TryParse(r.AiUpdatedAt, null, System.Globalization.DateTimeStyles.RoundtripKind, out var aiUpdated)
            && DateTime.TryParse(_latest.CreatedAt, null, System.Globalization.DateTimeStyles.RoundtripKind, out var latestCreated))
        {
            return aiUpdated > latestCreated;
        }
        return false;
    }

    private void OnHistoryChanged(ChangeEventArgs e)
    {
        if (!long.TryParse(e.Value?.ToString(), out long id)) return;
        var hit = _history.FirstOrDefault(h => h.Id == id);
        if (hit is null) return;
        if (ModelAnalysisLanguages.Contains(hit.Language, StringComparer.OrdinalIgnoreCase)) _language = hit.Language;
        SetActiveAnalysis(hit);
    }

    private void OnLanguageChanged(ChangeEventArgs e)
    {
        string next = e.Value?.ToString() ?? "Korean";
        if (!ModelAnalysisLanguages.Contains(next, StringComparer.OrdinalIgnoreCase)) next = "Korean";
        _language = next;
        SetActiveAnalysis(PreferredAnalysis());
    }

    private async Task WaitForCliResultAsync(string productType, string sourceContextHash, DateTime startedUtc)
    {
        _cliWaitCts?.Cancel();
        _cliWaitCts?.Dispose();
        _cliWaitCts = new CancellationTokenSource(TimeSpan.FromMinutes(20));
        CancellationToken token = _cliWaitCts.Token;

        try
        {
            while (!token.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(2), token);

                _history = Repo.GetModelAnalysisHistory(productType, 300);
                List<AiModelAnalysisRecord> hits = _history.Where(h =>
                    string.Equals(h.SourceContextHash, sourceContextHash, StringComparison.OrdinalIgnoreCase)
                    && DateTime.TryParse(h.CreatedAt, null, System.Globalization.DateTimeStyles.RoundtripKind, out var created)
                    && created.ToUniversalTime() >= startedUtc.AddSeconds(-2))
                    .ToList();

                List<string> completedLanguages = ModelAnalysisLanguages
                    .Where(language => hits.Any(h => string.Equals(h.Language, language, StringComparison.OrdinalIgnoreCase)))
                    .ToList();

                if (completedLanguages.Count == ModelAnalysisLanguages.Length)
                {
                    AiModelAnalysisRecord hit = hits.FirstOrDefault(h => string.Equals(h.Language, _language, StringComparison.OrdinalIgnoreCase))
                                                ?? hits.First();
                    _groups = Repo.GetModelAnalysisGroups();
                    LoadSelectedGroup();
                    SetActiveAnalysis(_history.FirstOrDefault(h => h.Id == hit.Id) ?? hit);
                    SetStatus($"{ExecutorLabel} results received for Korean, English, and Vietnam. Scope: {AnalysisScopeLabel}. Included reports: {hit.ReportCount}.", false);
                    return;
                }

                string languageStatus = completedLanguages.Count == 0
                    ? "none saved yet"
                    : string.Join(", ", completedLanguages.Select(LanguageLabel));
                SetStatus($"{ExecutorLabel} running. Waiting for all language results... saved: {languageStatus}. {DateTime.Now:HH:mm:ss}", false);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            if (string.IsNullOrWhiteSpace(_activeMarkdown))
                SetStatus("Wait cancelled or timed out. Refresh later to load the CLI result if it finishes.", true);
        }
    }

    private void CancelCliWait()
    {
        try { _cliWaitCts?.Cancel(); } catch { }
        _isWaitingCli = false;
        _isBusy = false;
        SetStatus("Stopped waiting. The CLI terminal may still be running.", true);
    }

