    private static string AiBrief(string? text, int maxChars)
    {
        string value = CleanExcelSerialDateText(
            System.Text.RegularExpressions.Regex.Replace(text ?? "", @"\s+", " ").Trim());
        if (value.Length <= maxChars) return value;
        int cut = Math.Max(0, maxChars - 3);
        return value[..cut].TrimEnd() + "...";
    }

    private static string DisplayExcelDate(string? value)
    {
        string text = CleanExcelSerialDateText(value);
        return TryExcelSerialDate(text, out DateTime date) ? date.ToString("yyyy-MM-dd") : text;
    }

    private static string CleanExcelSerialDateText(string? value)
    {
        string text = value ?? "";
        if (string.IsNullOrWhiteSpace(text)) return "";
        if (TryExcelSerialDate(text, out DateTime exactDate)) return exactDate.ToString("yyyy-MM-dd");

        text = System.Text.RegularExpressions.Regex.Replace(
            text,
            @"\b(?:Excel\s+serial(?:\s+date)?|serial\s+date)\s+([0-9]{5}(?:\.\d+)?)\s*(?:=|:|->)?\s*(\d{4}-\d{2}-\d{2})\b",
            "$2",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        text = System.Text.RegularExpressions.Regex.Replace(
            text,
            @"\b([0-9]{5}(?:\.\d+)?)\s*\(=\s*(\d{4}-\d{2}-\d{2})\)",
            "$2");

        text = System.Text.RegularExpressions.Regex.Replace(
            text,
            @"\(([0-9]{5}(?:\.0+)?)\)",
            m => TryExcelSerialDate(m.Groups[1].Value, out DateTime date)
                ? "(" + date.ToString("yyyy-MM-dd") + ")"
                : m.Value);

        text = System.Text.RegularExpressions.Regex.Replace(
            text,
            @"\b(date|report\s+date|result\s+date|일자|날짜)\s*[:=]?\s*([0-9]{5}(?:\.0+)?)\b",
            m => TryExcelSerialDate(m.Groups[2].Value, out DateTime date)
                ? m.Groups[1].Value + " " + date.ToString("yyyy-MM-dd")
                : m.Value,
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        text = System.Text.RegularExpressions.Regex.Replace(
            text,
            @"\b(?:Excel\s+serial(?:\s+date)?|serial\s+date)\s+([0-9]{5}(?:\.\d+)?)\b",
            m => TryExcelSerialDate(m.Groups[1].Value, out DateTime date)
                ? date.ToString("yyyy-MM-dd")
                : m.Value,
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        return text.Trim();
    }

    private static bool TryExcelSerialDate(string? value, out DateTime date)
    {
        date = default;
        string text = (value ?? "").Trim();
        if (!System.Text.RegularExpressions.Regex.IsMatch(text, @"^\d{5}(?:\.0+)?$")) return false;
        if (!double.TryParse(text, System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture, out double serial)) return false;
        if (serial < 20000 || serial > 80000) return false;
        try
        {
            date = DateTime.FromOADate(serial).Date;
            return date.Year is >= 1954 and <= 2119;
        }
        catch
        {
            return false;
        }
    }

