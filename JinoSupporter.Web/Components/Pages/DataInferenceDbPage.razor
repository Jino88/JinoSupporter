        if (cls == "didb-ai-status-fail") return "didb-ai-heat-worse";
        if (cls == "didb-ai-status-pass") return "didb-ai-heat-improved";
        if (cls == "didb-ai-status-warn") return "didb-ai-heat-flat";
        return "didb-ai-heat-flat";
    }

