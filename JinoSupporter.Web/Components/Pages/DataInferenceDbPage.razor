    private static string AiMetricReviewResultText(AiMetricComparison c)
    {
        string judgement = c.Variant.Judgement ?? "";
        string change = AiMetricDirectionText(c.RelativeChangePct);
        if (!string.IsNullOrWhiteSpace(judgement) && !string.IsNullOrWhiteSpace(change))
            return $"{judgement} ({change})";
        if (!string.IsNullOrWhiteSpace(judgement)) return judgement;
        return string.IsNullOrWhiteSpace(change) ? "-" : change;
    }

    private static string AiMetricDirectionText(double? relativeChangePct)
    {
        if (!relativeChangePct.HasValue) return "";
        double v = relativeChangePct.Value;
        if (Math.Abs(v) < 0.5) return "변화 없음";
        return (v > 0 ? "+" : "") + v.ToString("F1") + "% " + (v > 0 ? "상승" : "하락");
    }

