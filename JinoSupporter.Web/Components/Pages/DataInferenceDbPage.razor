    private static string AiReviewSourceLabel(AiResultRow r)
    {
        string source = AiSourceLabel(r);
        string date = r.ResultDate ?? "";
        string line = r.Line ?? "";
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(source)) parts.Add(source);
        if (!string.IsNullOrWhiteSpace(date)) parts.Add(DisplayExcelDate(date));
