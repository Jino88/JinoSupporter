                                                                <thead>
                                                                    <tr>
                                                                        <th>Condition</th>
                                                                        <th class="n">Input</th>
                                                                        <th class="n">NG</th>
                                                                        <th class="n">NG Rate</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var row in aiAbsoluteRows)
                                                                    {
                                                                        <tr>
                                                                            <td><strong>@row.Label</strong></td>
                                                                            <td class="n">@AiCount(row.InputCount)</td>
                                                                            <td class="n">@AiCount(row.NgCount)</td>
                                                                            <td class="n"><span class="didb-ai-chip @AiAbsoluteHeatClass(row)">@AiPct(row.RatePercent)</span></td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        }
                                                    }
                                                    else if (aiAbsoluteRows.Count > 0)
