                                                                    <th class="n">Test</th>
                                                                    <th class="n">Ratio</th>
                                                                    <th>Change</th>
                                                                    <th>Scale</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var cmp in aiComparisonRows)
                                                                {
                                                                    double width = AiBarWidth(AiComparisonMagnitude(cmp), aiMaxChange);
                                                                    <tr>
