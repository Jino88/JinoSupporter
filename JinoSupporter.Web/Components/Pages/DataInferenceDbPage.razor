        display: flex; gap: 6px; padding: 3px 0; align-items: baseline;
    }
    .didb-actions li + li { border-top: 1px dashed #e2e8f0; }
    .didb-action-kind     { flex-shrink: 0; width: 16px; font-weight: 700; color: #2563eb; }
