    private static string AiDocKeywordText(AiDocBundle doc)
        => NormalizeAiText(string.Join(' ',
            doc.ReportType, doc.Title, doc.Purpose, doc.PrimaryDefect, doc.DecisionRationale,
            string.Join(' ', doc.Content), string.Join(' ', doc.RelatedDefects),
            string.Join(' ', doc.Parts), string.Join(' ', doc.Processes),
