            try
            {
                await JS.InvokeVoidAsync("didbLazy.init", _lazyLoadRef);
            }
            catch (JSException ex)
            {
                Activity.Log("Data Inference DB", $"Lazy-load script unavailable: {ex.Message}");
            }
        }
