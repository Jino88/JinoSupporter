        font-size: 12px; font-weight: 700; color: #1e293b;
        font-variant-numeric: tabular-nums;
    }
    .didb-dash-headline {
        font-size: 11px; color: #0f172a; line-height: 1.5; font-weight: 500;
        padding-top: 6px; border-top: 1px dashed #cbd5e1;
    }
    .didb-tags-side { padding-top: 6px; border-top: 1px dashed #cbd5e1; }
    .didb-tags-side .didb-tag { font-size: 9px; padding: 1px 6px; }

    .didb-dash-main {
        display: flex; flex-direction: column; gap: 8px; min-width: 0;
    }
    .didb-dash-section-title {
        font-size: 10px; font-weight: 700; color: #64748b;
        text-transform: uppercase; letter-spacing: .04em;
        margin-bottom: 2px;
    }
    .didb-v-good     { background: #d1fae5; color: #065f46; border: 1px solid #6ee7b7; }
    .didb-v-bad      { background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }
    .didb-v-partial  { background: #fef3c7; color: #92400e; border: 1px solid #fcd34d; }
