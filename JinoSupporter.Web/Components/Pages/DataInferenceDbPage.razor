            "normal_comparison"      => ("Normal",       "didb-rt-default"),
            "ng_without_baseline"    => ("NG Rank",      "didb-rt-log"),
            "before_after_dimension" => ("Dimension",    "didb-rt-multi"),
            "measurement_spec"       => ("Measurement",   "didb-rt-reli"),
            "defect_root_cause"      => ("Cause",         "didb-rt-log"),
            "lot_supplier_mold_comparison" => ("Lot/Supplier", "didb-rt-multi"),
            "process_condition_change" => ("Process",     "didb-rt-default"),
            "multi_arm"              => ("Multi-arm",    "didb-rt-multi"),
            "doe_factorial"          => ("DOE",          "didb-rt-doe"),
            "doe_matrix"             => ("DOE",          "didb-rt-doe"),
            "reliability_validation" => ("Reliability",  "didb-rt-reli"),
            "reliability_spec"       => ("Reliability",  "didb-rt-reli"),
            "trend_analysis"         => ("Trend",        "didb-rt-trend"),
            "quality_log"            => ("Log",          "didb-rt-log"),
            "image_dependent"        => ("Image",        "didb-rt-log"),
            "intervention_test"      => ("Intervention", "didb-rt-default"),
            ""                       => ("", ""),
            _                        => (head, "didb-rt-default"),
        };
    }

    private static string DeltaClass(string sign) => (sign ?? "").ToLowerInvariant() switch
    {
        "down"      => "didb-ev-down",
        "up"        => "didb-ev-up",
        "no_change" => "didb-ev-flat",
