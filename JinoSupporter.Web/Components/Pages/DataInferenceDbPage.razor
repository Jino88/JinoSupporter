@page "/data-inference/db"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject WebRepository Repo
@inject IJSRuntime JS

<PageTitle>Data Inference — DB Data</PageTitle>

<div class="didb-root">

<!-- ── Header ──────────────────────────────────────────────────────────────── -->
<div class="didb-header">
    <span class="didb-title">Saved Datasets</span>
    <span class="didb-count">
        @FilteredReports.Count dataset(s)@DatasetFilterSuffix
    </span>
    <div style="flex:1;"></div>
    <label class="didb-filter-label">AI Batch</label>
    <select class="form-select form-select-sm didb-filter-select" @bind="_aiBatchFilter">
        <option value="all">All</option>
        <option value="batched">AI Batched</option>
        <option value="pending">Not Batched</option>
    </select>
    <label class="didb-filter-label">Product Type</label>
    <select class="form-select form-select-sm didb-filter-select" @bind="_productTypeFilter">
        <option value="">All</option>
        @foreach (var pt in _productTypeOptions)
        {
            <option value="@pt">@pt</option>
        }
    </select>
    <button class="btn btn-outline-secondary btn-sm" @onclick="Refresh">↻ Refresh</button>
    <button class="btn btn-outline-danger btn-sm" @onclick="ConfirmDeleteAll"
            disabled="@(_reports.Count == 0)">🗑 Delete All</button>
</div>

<!-- ── Table ────────────────────────────────────────────────────────────────── -->
@if (_reports.Count == 0)
{
    <div class="didb-empty">
        No saved datasets yet.<br />
        Go to Input Data, analyze an image, then save.
    </div>
}
else if (FilteredReports.Count == 0)
{
    <div class="didb-empty">
        No datasets match the selected filters.
    </div>
}
else
{
    <datalist id="didb-pt-options">
        @foreach (var opt in GetProductTypeSuggestions())
        {
            <option value="@opt"></option>
        }
    </datalist>
    <div class="didb-table-wrap">
        <table class="didb-table">
            <thead>
                <tr>
                    <th style="width:28px;"></th>
                    <th>Dataset Name</th>
                    <th>Product Type</th>
                    <th>Date</th>
                    <th>Images</th>
                    <th>Measurements</th>
                    <th>Saved</th>
                    <th>AI Batched</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in FilteredReports)
                {
                    bool expanded = _expanded == r.DatasetName;
                    <tr class="didb-row @(expanded ? "didb-row-open" : "")"
                        @onclick="() => ToggleExpand(r.DatasetName)">
                        <td class="didb-caret">@(expanded ? "▾" : "▸")</td>
                        <td><strong>@r.DatasetName</strong></td>
                        <td @onclick:stopPropagation="true">
                            @if (_editingPt == r.DatasetName)
                            {
                                <input class="form-control form-control-sm didb-pt-input"
                                       list="didb-pt-options"
                                       placeholder="Type or pick existing…"
                                       value="@_editingPtDraft"
                                       @oninput="@(e => _editingPtDraft = e.Value?.ToString() ?? "")"
                                       @onkeydown="@(e => OnPtKey(e, r.DatasetName))"
                                       @onblur="@(() => SavePt(r.DatasetName))"
                                       autofocus />
                            }
                            else if (string.IsNullOrWhiteSpace(r.ProductType))
                            {
                                <a class="didb-set-pt" role="button" tabindex="0"
                                   @onclick="() => StartEditPt(r.DatasetName, r.ProductType)"
                                   title="Set Product Type for this dataset">
                                    ✎ Set…
                                </a>
                            }
                            else
                            {
                                <span class="didb-pt-text"
                                      @onclick="() => StartEditPt(r.DatasetName, r.ProductType)"
                                      title="Click to edit">@r.ProductType</span>
                            }
                        </td>
                        <td>@r.ReportDate</td>
                        <td class="n">@r.ImageCount</td>
                        <td class="n">@r.MeasurementCount</td>
                        <td class="didb-date">@FormatDate(r.CreatedAt)</td>
                        <td class="didb-date">
                            @if (!string.IsNullOrEmpty(r.BatchedAt))
                            {
                                <span title="@r.BatchedAt">@FormatDate(r.BatchedAt)</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td @onclick:stopPropagation="true" style="white-space:nowrap;">
                            <button class="btn btn-sm py-0 px-2 me-1 @(expanded ? "btn-primary" : "btn-outline-primary")"
                                    style="font-size:12px;"
                                    title="@(expanded ? "Close dataset detail" : "View dataset detail")"
                                    @onclick="() => ToggleExpand(r.DatasetName)">
                                @(expanded ? "Close" : "View")
                            </button>
                            @* OCR button removed — v4 policy ignores OCR cache;
                               only excel_paste TSV is sent to AI. *@
                            <button class="btn btn-outline-danger btn-sm py-0 px-1"
                                    style="font-size:12px;"
                                    @onclick="() => ConfirmDelete(r.DatasetName)">🗑</button>
                        </td>
                    </tr>

                    @if (expanded)
                    {
                        <!-- New AI bundle (AI_EXCEL_PROC.md schema) — shown when
                             the row was processed via the new CLI flow. -->
                        @if (_expandedAiDoc is not null)
                        {
                            var doc = _expandedAiDoc;
                            string aiLang = _aiCardLang;
                            string docTitle       = AiDocTitle(doc, aiLang);
                            string docPurpose     = AiDocPurpose(doc, aiLang);
                            string aiGeneratedReport = AiGeneratedReportMarkdown(doc, aiLang);
                            bool aiHasGeneratedReport = !string.IsNullOrWhiteSpace(aiGeneratedReport);
                            bool aiShowParameterReport = !aiHasGeneratedReport || _aiCardShowAll;
                            string logRationale   = AiLogRationale(doc, aiLang);
                            var aiContent         = AiDocContent(doc, aiLang)
                                .Take(_aiCardShowAll ? int.MaxValue : 10)
                                .ToList();
                            var aiAssumptions     = AiLogAssumptions(doc, aiLang);
                            var aiWarnings        = AiLogWarnings(doc, aiLang);
                            var aiAllComparisons  = BuildAiControlComparisons(doc);
                            var aiComparisons     = aiAllComparisons
                                .Where(x => (x.Variant.InputCount ?? 0) >= 50 || (x.Baseline.InputCount ?? 0) >= 50)
                                .ToList();
                            string aiReportKind   = DetectAiReportKind(doc, aiComparisons, _expandedImages.Count);
                            string aiReportLabel  = AiReportKindLabel(aiReportKind);
                            var aiHeatmap         = aiComparisons.Take(_aiCardShowAll ? aiComparisons.Count : 9).ToList();
                            var aiComparisonRows  = aiComparisons.Take(_aiCardShowAll ? aiComparisons.Count : 8).ToList();
                            var aiProcessSections = BuildAiProcessReviewSections(doc, aiAllComparisons)
                                .Take(_aiCardShowAll ? int.MaxValue : 8)
                                .ToList();
                            var aiBriefSummary   = BuildAiFourLineSummary(doc, aiReportKind, aiAllComparisons, aiProcessSections)
                                .ToList();
                            var aiDetailedBlocks = BuildAiDetailedReportBlocks(
                                doc, aiLang, aiReportKind, aiAllComparisons, aiProcessSections, logRationale, aiWarnings, true)
                                .ToList();
                            bool aiShowPrimaryDefect = AiShowsPrimaryDefect(aiReportKind);
                            string aiReportFocus = AiReportFocusText(doc, aiReportKind, aiProcessSections);
                            double aiMaxChange    = Math.Max(1.0, aiComparisons.Select(AiComparisonMagnitude).DefaultIfEmpty(0).Max());
                            var aiAbsoluteRowsAll = BuildAiAbsoluteNgRows(doc);
                            var aiAbsoluteRows    = aiAbsoluteRowsAll
                                .Take(_aiCardShowAll ? aiAbsoluteRowsAll.Count : 10)
                                .ToList();
                            var aiAbsoluteGroupsAll = BuildAiAbsoluteNgGroups(aiAbsoluteRowsAll);
                            var aiAbsoluteGroups  = aiAbsoluteGroupsAll
                                .Take(_aiCardShowAll ? aiAbsoluteGroupsAll.Count : 6)
                                .ToList();
                            var aiTopAbsoluteRate = aiAbsoluteRows.FirstOrDefault();
                            double aiMaxAbsRate   = Math.Max(1.0, aiAbsoluteRows.Select(x => x.RatePercent).DefaultIfEmpty(0).Max());
                            var aiDimensionCompsAll = BuildAiMetricComparisons(doc, IsAiDimensionMetric);
                            var aiDimensionComps  = aiDimensionCompsAll
                                .Take(_aiCardShowAll ? aiDimensionCompsAll.Count : 8)
                                .ToList();
                            var aiDimensionRowsAll = BuildAiMetricRows(doc, IsAiDimensionMetric);
                            var aiDimensionRows   = aiDimensionRowsAll
                                .Take(_aiCardShowAll ? aiDimensionRowsAll.Count : 10)
                                .ToList();
                            var aiReliabilityRowsAll = BuildAiMetricRows(doc, IsAiReliabilityMetric)
                                .OrderByDescending(AiIsFailLike)
                                .ThenByDescending(AiIsWarnLike)
                                .ThenBy(AiResultLabel)
                                .ToList();
                            var aiReliabilityRows = aiReliabilityRowsAll
                                .Take(_aiCardShowAll ? aiReliabilityRowsAll.Count : 10)
                                .ToList();
                            var aiDoeRowsAll      = BuildAiDoeRows(doc);
                            var aiDoeRows         = aiDoeRowsAll
                                .Take(_aiCardShowAll ? aiDoeRowsAll.Count : 10)
                                .ToList();
                            var aiTopMetric       = aiDimensionRows.FirstOrDefault()
                                                    ?? aiReliabilityRows.FirstOrDefault()
                                                    ?? aiDoeRows.FirstOrDefault();
                            var aiTopDefect       = doc.NgBreakdowns.FirstOrDefault();
                            double aiDefectTotal  = doc.NgBreakdowns.Sum(x => x.TotalCount);
                            double aiMaxBreakdown = Math.Max(1.0, doc.NgBreakdowns.Select(x => x.TotalCount).DefaultIfEmpty(0).Max());
                            var aiConclusions     = doc.Conclusions.Take(_aiCardShowAll ? doc.Conclusions.Count : 3).ToList();
                            var aiHints           = doc.Hints
                                .OrderBy(AiEvidenceStrengthRank)
                                .ThenBy(x => AiHintCheck(doc, x, aiLang))
                                .Take(_aiCardShowAll ? doc.Hints.Count : 5)
                                .ToList();
                            var aiReportFocusItems = AiDisplayListItems(aiReportFocus);

                            <tr class="didb-detail-row">
                                <td colspan="9" style="padding:0;">
                                    <div class="didb-ai-dashboard">
                                        <div class="didb-ai-hero">
                                            <div>
                                                <div class="didb-lang-row">
                                                    <button class="didb-lang @(aiLang == "ko" ? "active" : "")" @onclick="SetAiCardKo" @onclick:stopPropagation="true">한국어</button>
                                                    <button class="didb-lang @(aiLang == "en" ? "active" : "")" @onclick="SetAiCardEn" @onclick:stopPropagation="true">English</button>
                                                    <button class="didb-lang @(aiLang == "vi" ? "active" : "")" @onclick="SetAiCardVi" @onclick:stopPropagation="true">Tiếng Việt</button>
                                                </div>
                                                <div class="didb-ai-title-line">
                                                    @if (aiShowPrimaryDefect && !string.IsNullOrEmpty(doc.PrimaryDefect))
                                                    {
                                                        <span class="didb-ai-primary">@doc.PrimaryDefect</span>
                                                    }
                                                    <span class="didb-ai-title">@(string.IsNullOrEmpty(docTitle) ? doc.SourceDataset : docTitle)</span>
                                                </div>
                                                @if (!string.IsNullOrEmpty(docPurpose))
                                                {
                                                    <div class="didb-ai-purpose" title="@docPurpose">@AiBrief(docPurpose, _aiCardShowAll ? 500 : 180)</div>
                                                }
                                                <div class="didb-ai-meta">
                                                    <span>Dataset @doc.SourceDataset</span>
                                                    <span>Report @DisplayExcelDate(doc.ReportDate)</span>
                                                    <span>@aiReportLabel</span>
                                                    <span>conf @doc.Confidence.ToString("0.00")</span>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="didb-ai-kpis">
                                            <div class="didb-ai-kpi">
                                                <span>Results</span>
                                                <strong>@doc.Results.Count.ToString("N0")</strong>
                                                <em>@doc.ConditionsCount.ToString("N0") conditions / @doc.Conclusions.Count.ToString("N0") conclusions</em>
                                            </div>
                                            <div class="didb-ai-kpi didb-ai-kpi-warn">
                                                @if (aiShowPrimaryDefect)
                                                {
                                                    <span>Primary Defect</span>
                                                    <strong>@(string.IsNullOrEmpty(doc.PrimaryDefect) ? "-" : doc.PrimaryDefect)</strong>
                                                    <em>@doc.Hints.Count.ToString("N0") suggested checks</em>
                                                }
                                                else
                                                {
                                                    <span>Report Focus</span>
                                                    @if (aiReportFocusItems.Count > 1)
                                                    {
                                                        <ul class="didb-ai-kpi-list" title="@aiReportFocus">
                                                            @foreach (var focusItem in aiReportFocusItems)
                                                            {
                                                                <li>@AiBrief(focusItem, 120)</li>
                                                            }
                                                        </ul>
                                                    }
                                                    else
                                                    {
                                                        <strong title="@aiReportFocus">@AiBrief(aiReportFocus, 160)</strong>
                                                    }
                                                    <em>@aiReportLabel</em>
                                                }
                                            </div>
                                            @if (!AiUsesProcessReview(aiReportKind) && aiTopAbsoluteRate is not null)
                                            {
                                                <div class="didb-ai-kpi didb-ai-kpi-bad">
                                                    <span>Worst NG Rate</span>
                                                    <strong>@AiPct(aiTopAbsoluteRate.RatePercent)</strong>
                                                    <em>@aiTopAbsoluteRate.Label</em>
                                                </div>
                                            }
                                            else if (!AiUsesProcessReview(aiReportKind) && aiTopMetric is not null)
                                            {
                                                <div class="didb-ai-kpi @AiJudgementPanelClass(aiTopMetric)">
                                                    <span>Key Metric</span>
                                                    <strong>@AiResultMainValue(aiTopMetric)</strong>
                                                    <em>@AiMetricLabel(aiTopMetric)</em>
                                                </div>
                                            }
                                            @if (!AiUsesProcessReview(aiReportKind) && aiTopDefect is not null)
                                            {
                                                <div class="didb-ai-kpi didb-ai-kpi-bad">
                                                    <span>Top Breakdown</span>
                                                    <strong>@aiTopDefect.DefectName</strong>
                                                    <em>@AiCount(aiTopDefect.TotalCount) count</em>
                                                </div>
                                            }
                                        </div>

                                        @if (aiHasGeneratedReport)
                                        {
                                            <section class="didb-ai-panel didb-ai-full didb-ai-generated-panel">
                                                <div class="didb-ai-report-head">
                                                    <h3>AI Generated Report</h3>
                                                    <span>AI-authored report</span>
                                                </div>
                                                <div class="didb-ai-generated-report">
                                                    @AiMarkdown(aiGeneratedReport)
                                                </div>
                                            </section>
                                        }

                                        @if (aiShowParameterReport)
                                        {
                                            <section class="didb-ai-panel didb-ai-full didb-ai-brief-panel">
                                                <h3>Stored Parameter Summary</h3>
                                                <div class="didb-ai-brief-grid">
                                                    @foreach (var item in aiBriefSummary)
                                                    {
                                                        var summaryItems = AiDisplayListItems(item.Value);
                                                        <div class="didb-ai-brief-item">
                                                            <span>@item.Label</span>
                                                            @if (summaryItems.Count > 1)
                                                            {
                                                                <ul class="didb-ai-brief-list" title="@item.Value">
                                                                    @foreach (var summaryItem in summaryItems)
                                                                    {
                                                                        <li>@AiBrief(summaryItem, 140)</li>
                                                                    }
                                                                </ul>
                                                            }
                                                            else
                                                            {
                                                                <strong title="@item.Value">@AiBrief(item.Value, 220)</strong>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </section>
                                        }

                                        @if (aiShowParameterReport)
                                        {
                                            <section class="didb-ai-panel didb-ai-full didb-ai-report-panel">
                                                <div class="didb-ai-report-head">
                                                    <h3>Stored Parameter Report</h3>
                                                    <span>@aiReportLabel</span>
                                                </div>
                                                <div class="didb-ai-report-grid">
                                                @foreach (var block in aiDetailedBlocks)
                                                {
                                                    <article class="didb-ai-report-block @block.Kind">
                                                        <h4>@block.Title</h4>
                                                        @if (block.TableRows.Count > 0)
                                                        {
                                                            var visibleHeaders = AiReportVisibleHeaders(block);
                                                            <table class="didb-ai-report-table">
                                                                <thead>
                                                                    <tr>
                                                                        @foreach (var header in visibleHeaders)
                                                                        {
                                                                            <th>@header</th>
                                                                        }
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @if (AiIsGroupedResultTable(block))
                                                                    {
                                                                        @foreach (var group in AiReportResultGroups(block.TableRows))
                                                                        {
                                                                            <tr class="didb-ai-report-process-row">
                                                                                <td colspan="@visibleHeaders.Count">@group.Process</td>
                                                                            </tr>
                                                                            @foreach (var row in group.Rows)
                                                                            {
                                                                                var visibleCells = AiReportVisibleCells(block, row);
                                                                                <tr class="@row.HeatClass">
                                                                                    @for (int i = 0; i < visibleCells.Count; i++)
                                                                                    {
                                                                                        string cellText = CleanExcelSerialDateText(visibleCells[i]);
                                                                                        <td class="@AiReportCellClass(visibleCells.Count, i)" title="@cellText">@cellText</td>
                                                                                    }
                                                                                </tr>
                                                                            }
                                                                        }
                                                                    }
                                                                    else
                                                                    {
                                                                        @foreach (var row in block.TableRows)
                                                                        {
                                                                            var visibleCells = AiReportVisibleCells(block, row);
                                                                            <tr class="@row.HeatClass">
                                                                                @for (int i = 0; i < visibleCells.Count; i++)
                                                                                {
                                                                                    string cellText = CleanExcelSerialDateText(visibleCells[i]);
                                                                                    <td class="@AiReportCellClass(visibleCells.Count, i)" title="@cellText">@cellText</td>
                                                                                }
                                                                            </tr>
                                                                        }
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        }
                                                        else
                                                        {
                                                            <ul class="didb-ai-report-lines">
                                                                @foreach (var line in block.Lines)
                                                                {
                                                                    var lineParts = AiReportLineParts(line);
                                                                    <li title="@CleanExcelSerialDateText(line)">
                                                                        @if (lineParts.Count == 0)
                                                                        {
                                                                            <span class="didb-ai-report-main">@AiBrief(line, _aiCardShowAll ? 420 : 180)</span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="didb-ai-report-main">@AiBrief(lineParts[0], _aiCardShowAll ? 420 : 180)</span>
                                                                            @if (lineParts.Count > 1)
                                                                            {
                                                                                <ul class="didb-ai-report-sublist">
                                                                                    @foreach (var subLine in lineParts.Skip(1))
                                                                                    {
                                                                                        <li>@AiBrief(subLine, _aiCardShowAll ? 420 : 180)</li>
                                                                                    }
                                                                                </ul>
                                                                            }
                                                                        }
                                                                    </li>
                                                                }
                                                            </ul>
                                                        }
                                                    </article>
                                                }
                                                </div>
                                            </section>
                                        }

                                        @if (aiShowParameterReport)
                                        {
                                            <div class="didb-ai-grid">
                                                <section class="didb-ai-panel didb-ai-panel-wide">
                                                <h3>@AiPrimaryPanelTitle(aiReportKind)</h3>
                                                @if (aiComparisons.Count == 0)
                                                {
                                                    @if (aiReportKind == "before_after_dimension")
                                                    {
                                                        @if (aiDimensionComps.Count > 0)
                                                        {
                                                            <div class="didb-ai-heatmap">
                                                                @foreach (var cmp in aiDimensionComps.Take(9))
                                                                {
                                                                    <div class="didb-ai-heat @AiMetricHeatClass(cmp)" title="@($"{AiResultLabel(cmp.Variant)} vs {AiResultLabel(cmp.Baseline)}")">
                                                                        <strong>@AiMetricDeltaText(cmp)</strong>
                                                                        <span>@AiMetricLabel(cmp.Variant)</span>
                                                                        <em>@AiMetricValue(cmp.Baseline) -> @AiMetricValue(cmp.Variant)</em>
                                                                    </div>
                                                                }
                                                            </div>
                                                            <table class="didb-ai-comp-table didb-ai-metric-table">
                                                                <thead>
                                                                    <tr>
                                                                        <th>Metric</th>
                                                                        <th class="n">Before/Base</th>
                                                                        <th class="n">After/Test</th>
                                                                        <th class="n">Delta</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var cmp in aiDimensionComps)
                                                                    {
                                                                        <tr>
                                                                            <td>
                                                                                <strong>@AiMetricLabel(cmp.Variant)</strong>
                                                                                <span>@AiResultLabel(cmp.Variant)</span>
                                                                            </td>
                                                                            <td class="n">@AiMetricValue(cmp.Baseline)</td>
                                                                            <td class="n">@AiMetricValue(cmp.Variant)</td>
                                                                            <td class="n"><span class="didb-ai-chip @AiMetricHeatClass(cmp)">@AiMetricDeltaText(cmp)</span></td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        }
                                                        else
                                                        {
                                                            <table class="didb-ai-comp-table didb-ai-metric-table">
                                                                <thead>
                                                                    <tr>
                                                                        <th>Metric</th>
                                                                        <th>Condition</th>
                                                                        <th class="n">Value</th>
                                                                        <th>Judgement</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var row in aiDimensionRows)
                                                                    {
                                                                        <tr>
                                                                            <td><strong>@AiMetricLabel(row)</strong></td>
                                                                            <td>@AiResultLabel(row)</td>
                                                                            <td class="n">@AiResultMainValue(row)</td>
                                                                            <td><span class="didb-ai-status @AiJudgementClass(row)">@AiJudgementLabel(row)</span></td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        }
                                                    }
                                                    else if (aiReportKind == "reliability_spec")
                                                    {
                                                        @if (aiReliabilityRows.Count == 0)
                                                        {
                                                            <div class="didb-ai-empty">No reliability/spec metric rows were normalized.</div>
                                                        }
                                                        else
                                                        {
                                                            <table class="didb-ai-comp-table didb-ai-metric-table">
                                                                <thead>
                                                                    <tr>
                                                                        <th>Test Item</th>
                                                                        <th>Condition</th>
                                                                        <th class="n">Value</th>
                                                                        <th>Judgement</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var row in aiReliabilityRows)
                                                                    {
                                                                        <tr>
                                                                            <td><strong>@AiMetricLabel(row)</strong></td>
                                                                            <td>@AiResultLabel(row)</td>
                                                                            <td class="n">@AiResultMainValue(row)</td>
                                                                            <td><span class="didb-ai-status @AiJudgementClass(row)">@AiJudgementLabel(row)</span></td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        }
                                                    }
                                                    else if (aiReportKind == "doe_matrix")
                                                    {
                                                        @if (aiDoeRows.Count == 0)
                                                        {
                                                            <div class="didb-ai-empty">No DOE condition rows were normalized.</div>
                                                        }
                                                        else
                                                        {
                                                            <div class="didb-ai-doe-grid">
                                                                @foreach (var row in aiDoeRows.Take(12))
                                                                {
                                                                    <div class="didb-ai-doe-cell @AiJudgementClass(row)">
                                                                        <strong>@AiResultMainValue(row)</strong>
                                                                        <span>@AiResultLabel(row)</span>
                                                                        <em>@AiMetricLabel(row)</em>
                                                                    </div>
                                                                }
                                                            </div>
                                                            <table class="didb-ai-comp-table didb-ai-metric-table">
                                                                <thead>
                                                                    <tr>
                                                                        <th>Condition</th>
                                                                        <th>Factor</th>
                                                                        <th>Metric</th>
                                                                        <th class="n">Value</th>
                                                                        <th>Judgement</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var row in aiDoeRows)
                                                                    {
                                                                        <tr>
                                                                            <td><strong>@AiResultLabel(row)</strong></td>
                                                                            <td>@AiFactorLabel(row)</td>
                                                                            <td>@AiMetricLabel(row)</td>
                                                                            <td class="n">@AiResultMainValue(row)</td>
                                                                            <td><span class="didb-ai-status @AiJudgementClass(row)">@AiJudgementLabel(row)</span></td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        }
                                                    }
                                                    else if (aiReportKind == "image_dependent")
                                                    {
                                                        <div class="didb-ai-image-note">
                                                            Embedded image count: <strong>@_expandedImages.Count</strong>. If key values exist only inside images, this text-only AI result may be partial.
                                                        </div>
                                                        @if (_expandedImages.Count > 0)
                                                        {
                                                            <div class="didb-ai-thumbs">
                                                                @foreach (var img in _expandedImages.Take(6))
                                                                {
                                                                    <figure title="@img.FileName">
                                                                        <img src="@img.DataUrl" alt="@img.FileName" />
                                                                        <figcaption>@img.FileName</figcaption>
                                                                    </figure>
                                                                }
                                                            </div>
                                                        }
                                                        @if (aiAbsoluteRows.Count > 0)
                                                        {
                                                            <div class="didb-ai-subtitle">Text-extracted NG rows</div>
                                                            <table class="didb-ai-comp-table didb-ai-metric-table">
                                                                <thead>
                                                                    <tr>
                                                                        <th>Condition</th>
                                                                        <th class="n">Input</th>
                                                                        <th class="n">NG</th>
                                                                        <th class="n">NG Rate</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var row in aiAbsoluteRows)
                                                                    {
                                                                        <tr>
                                                                            <td><strong>@row.Label</strong></td>
                                                                            <td class="n">@AiCount(row.InputCount)</td>
                                                                            <td class="n">@AiCount(row.NgCount)</td>
                                                                            <td class="n"><span class="didb-ai-chip @AiAbsoluteHeatClass(row)">@AiPct(row.RatePercent)</span></td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        }
                                                    }
                                                    else if (aiAbsoluteRows.Count > 0)
                                                    {
                                                        <div class="didb-ai-empty">No same-event Normal/Baseline row was found, so this panel compares actual NG rate rows within each process instead of making an improvement/worsening verdict.</div>
                                                        <div class="didb-ai-process-ng-grid">
                                                            @foreach (var group in aiAbsoluteGroups)
                                                            {
                                                                <article class="didb-ai-process-ng-card">
                                                                    <div class="didb-ai-process-ng-head">
                                                                        <strong>@group.Process</strong>
                                                                        <span>@group.Rows.Count row(s)</span>
                                                                    </div>
                                                                    <div class="didb-ai-process-ng-kpis">
                                                                        <div class="@AiAbsoluteHeatClass(group.Worst)">
                                                                            <span>Worst</span>
                                                                            <strong>@AiPct(group.Worst.RatePercent)</strong>
                                                                            <em title="@group.Worst.Label">@AiBrief(group.Worst.Label, 64)</em>
                                                                        </div>
                                                                        <div class="@AiAbsoluteHeatClass(group.Best)">
                                                                            <span>Best</span>
                                                                            <strong>@AiPct(group.Best.RatePercent)</strong>
                                                                            <em title="@group.Best.Label">@AiBrief(group.Best.Label, 64)</em>
                                                                        </div>
                                                                    </div>
                                                                    <table class="didb-ai-mini-table">
                                                                        <tbody>
                                                                            @foreach (var row in group.Rows.Take(_aiCardShowAll ? 8 : 4))
                                                                            {
                                                                                <tr>
                                                                                    <td title="@row.Label">@AiBrief(row.Label, 72)</td>
                                                                                    <td class="n">@AiCount(row.InputCount)</td>
                                                                                    <td class="n">@AiCount(row.NgCount)</td>
                                                                                    <td class="n"><span class="didb-ai-chip @AiAbsoluteHeatClass(row)">@AiPct(row.RatePercent)</span></td>
                                                                                </tr>
                                                                            }
                                                                        </tbody>
                                                                    </table>
                                                                </article>
                                                            }
                                                        </div>
                                                        <table class="didb-ai-comp-table">
                                                            <thead>
                                                                <tr>
                                                                    <th>Condition</th>
                                                                    <th class="n">Input</th>
                                                                    <th class="n">NG</th>
                                                                    <th class="n">NG Rate</th>
                                                                    <th>Scale</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var row in aiAbsoluteRows)
                                                                {
                                                                    double width = AiBarWidth(row.RatePercent, aiMaxAbsRate);
                                                                    <tr>
                                                                        <td><strong>@row.Label</strong></td>
                                                                        <td class="n">@AiCount(row.InputCount)</td>
                                                                        <td class="n">@AiCount(row.NgCount)</td>
                                                                        <td class="n"><span class="didb-ai-chip @AiAbsoluteHeatClass(row)">@AiPct(row.RatePercent)</span></td>
                                                                        <td>
                                                                            <div class="didb-ai-tablebar">
                                                                                <div class="didb-ai-bar @AiRateBarClass(row.RatePercent)" style="@($"width:{width:F1}%")"></div>
                                                                            </div>
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    }
                                                    else
                                                    {
                                                        <div class="didb-ai-empty">No same-sheet Normal/Baseline row and no type-specific metric rows were normalized.</div>
                                                    }
                                                }
                                                else
                                                {
                                                    @if (AiUsesProcessReview(aiReportKind) && aiProcessSections.Count > 0)
                                                    {
                                                        <div class="didb-ai-process-stack">
                                                            @foreach (var procSection in aiProcessSections)
                                                            {
                                                                <div class="didb-ai-process-section">
                                                                    <div class="didb-ai-process-head">
                                                                        <div>
                                                                            <h4>@procSection.Process</h4>
                                                                            <span>@procSection.EventLabel</span>
                                                                        </div>
                                                                        <em>@procSection.Rows.Count item(s)</em>
                                                                    </div>
                                                                    <table class="didb-ai-comp-table didb-ai-review-table">
                                                                        <thead>
                                                                            <tr>
                                                                                <th>Measurement</th>
                                                                                <th class="n">Normal</th>
                                                                                <th class="n">Test</th>
                                                                                <th class="n">Change</th>
                                                                                <th>Result</th>
                                                                            </tr>
                                                                        </thead>
                                                                        <tbody>
                                                                            @foreach (var row in procSection.Rows)
                                                                            {
                                                                                <tr>
                                                                                    <td>
                                                                                        <strong>@row.Metric</strong>
                                                                                        <span>@row.Kind</span>
                                                                                    </td>
                                                                                    <td class="n">
                                                                                        <strong>@row.BaselineValue</strong>
                                                                                        <span>@row.BaselineDetail</span>
                                                                                    </td>
                                                                                    <td class="n">
                                                                                        <strong>@row.VariantValue</strong>
                                                                                        <span>@row.VariantDetail</span>
                                                                                    </td>
                                                                                    <td class="n">@row.ChangeText</td>
                                                                                    <td><span class="didb-ai-chip @row.HeatClass">@row.ResultText</span></td>
                                                                                </tr>
                                                                            }
                                                                        </tbody>
                                                                    </table>
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="didb-ai-heatmap">
                                                            @foreach (var cmp in aiHeatmap)
                                                            {
                                                                <div class="didb-ai-heat @AiHeatClass(cmp)" title="@AiComparisonSubtitle(cmp)">
                                                                    <strong>@AiRelativeChangeText(cmp)</strong>
                                                                    <span>@AiComparisonTitle(cmp)</span>
                                                                    <em>@AiPct(AiNgRatePercent(cmp.Baseline)) -> @AiPct(AiNgRatePercent(cmp.Variant)) @AiRateRatioValue(cmp)</em>
                                                                </div>
                                                            }
                                                        </div>

                                                        <table class="didb-ai-comp-table didb-ai-compare-table">
                                                            <thead>
                                                                <tr>
                                                                    <th>Process</th>
                                                                    <th>Event</th>
                                                                    <th class="n">Normal</th>
                                                                    <th class="n">Test</th>
                                                                    <th class="n">Ratio</th>
                                                                    <th>Change</th>
                                                                    <th>Scale</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var cmp in aiComparisonRows)
                                                                {
                                                                    double width = AiBarWidth(AiComparisonMagnitude(cmp), aiMaxChange);
                                                                    <tr>
                                                                        <td>
                                                                            <strong>@AiComparisonProcessLabel(cmp)</strong>
                                                                        </td>
                                                                        <td>
                                                                            <strong>@AiComparisonPairLabel(cmp)</strong>
                                                                            <span>@AiComparisonSubtitle(cmp)</span>
                                                                        </td>
                                                                        <td class="n">@AiPct(AiNgRatePercent(cmp.Baseline))</td>
                                                                        <td class="n">@AiPct(AiNgRatePercent(cmp.Variant))</td>
                                                                        <td class="n">@AiRateRatioValue(cmp)</td>
                                                                        <td><span class="didb-ai-chip @AiHeatClass(cmp)">@AiRelativeChangeText(cmp)</span></td>
                                                                        <td>
                                                                            <div class="didb-ai-tablebar">
                                                                                <div class="didb-ai-bar @AiRelativeBarClass(cmp)" style="@($"width:{width:F1}%")"></div>
                                                                            </div>
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    }
                                                }
                                            </section>

                                            <section class="didb-ai-panel">
                                                @if (AiUsesProcessReview(aiReportKind))
                                                {
                                                    <h3>Pair Summary</h3>
                                                    @if (aiComparisons.Count == 0)
                                                    {
                                                        <div class="didb-ai-empty">No paired Normal/Test rows.</div>
                                                    }
                                                    else
                                                    {
                                                        @foreach (var cmp in aiComparisons.Take(_aiCardShowAll ? 10 : 6))
                                                        {
                                                            <div class="didb-ai-pair-row @AiHeatClass(cmp)" title="@AiComparisonFullContext(cmp)">
                                                                <div>
                                                                    <strong>@AiBrief(AiComparisonTitle(cmp), 52)</strong>
                                                                    <span>@AiComparisonShortContext(cmp)</span>
                                                                </div>
                                                                <em>@AiPct(AiNgRatePercent(cmp.Baseline)) -> @AiPct(AiNgRatePercent(cmp.Variant))</em>
                                                                <b>@AiRelativeChangeText(cmp)</b>
                                                            </div>
                                                        }
                                                    }
                                                }
                                                else if (aiReportKind == "before_after_dimension" && (aiDimensionComps.Count > 0 || aiDimensionRows.Count > 0))
                                                {
                                                    <h3>Measurement Focus</h3>
                                                    @foreach (var cmp in aiDimensionComps.Take(_aiCardShowAll ? 8 : 5))
                                                    {
                                                        <div class="didb-ai-mini-row">
                                                            <strong>@AiBrief(AiMetricLabel(cmp.Variant), 52)</strong>
                                                            <span>@AiMetricValue(cmp.Baseline) -> @AiMetricValue(cmp.Variant)</span>
                                                        </div>
                                                    }
                                                    @foreach (var row in aiDimensionRows.Take(_aiCardShowAll ? 8 : 5))
                                                    {
                                                        <div class="didb-ai-mini-row">
                                                            <strong>@AiBrief(AiMetricLabel(row), 52)</strong>
                                                            <span>@AiResultMainValue(row) / @AiJudgementLabel(row)</span>
                                                        </div>
                                                    }
                                                }
                                                else if (aiReportKind == "reliability_spec" && aiReliabilityRows.Count > 0)
                                                {
                                                    <h3>Spec Summary</h3>
                                                    @foreach (var row in aiReliabilityRows.Take(_aiCardShowAll ? 8 : 6))
                                                    {
                                                        <div class="didb-ai-mini-row">
                                                            <strong>@AiBrief(AiMetricLabel(row), 52)</strong>
                                                            <span>@AiResultMainValue(row) / @AiJudgementLabel(row)</span>
                                                        </div>
                                                    }
                                                }
                                                else if (aiReportKind == "doe_matrix" && aiDoeRows.Count > 0)
                                                {
                                                    <h3>DOE Focus</h3>
                                                    @foreach (var row in aiDoeRows.Take(_aiCardShowAll ? 8 : 6))
                                                    {
                                                        <div class="didb-ai-mini-row">
                                                            <strong>@AiBrief(AiResultLabel(row), 52)</strong>
                                                            <span>@AiMetricLabel(row): @AiResultMainValue(row)</span>
                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    <h3>Breakdown Mix</h3>
                                                    @if (doc.NgBreakdowns.Count == 0)
                                                    {
                                                        <div class="didb-ai-empty">No NG breakdown rows.</div>
                                                    }
                                                    else
                                                    {
                                                        @foreach (var b in doc.NgBreakdowns.Take(_aiCardShowAll ? 8 : 5))
                                                        {
                                                            double width = AiBarWidth(b.TotalCount, aiMaxBreakdown);
                                                            double share = aiDefectTotal > 0 ? b.TotalCount / aiDefectTotal * 100.0 : 0.0;
                                                            <div class="didb-ai-bar-row didb-ai-bar-compact">
                                                                <div class="didb-ai-bar-label">
                                                                    <strong>@AiBrief(b.DefectName, 42)</strong>
                                                                    <span>@b.RowCount.ToString("N0") rows</span>
                                                                </div>
                                                                <div class="didb-ai-bar-track">
                                                                    <div class="didb-ai-bar didb-ai-bar-teal" style="@($"width:{width:F1}%")"></div>
                                                                </div>
                                                                <div class="didb-ai-bar-value">@AiCount(b.TotalCount) <small>@share.ToString("F1")%</small></div>
                                                            </div>
                                                        }
                                                    }
                                                }
                                            </section>
                                        </div>

                                            <div class="didb-ai-grid">
                                                <section class="didb-ai-panel didb-ai-panel-wide">
                                                <h3>AI Conclusions</h3>
                                                <div class="didb-ai-findings">
                                                    @foreach (var c in aiConclusions)
                                                    {
                                                        <article>
                                                            <div class="didb-ai-finding-topic" title="@AiConclusionTopic(doc, c, aiLang)">@AiBrief(AiConclusionTopic(doc, c, aiLang), 54)</div>
                                                            <p title="@AiConclusionInterp(doc, c, aiLang)">@AiBrief(AiConclusionInterp(doc, c, aiLang), _aiCardShowAll ? 420 : 150)</p>
                                                            @if (_aiCardShowAll && !string.IsNullOrEmpty(AiConclusionStatement(doc, c, aiLang)))
                                                            {
                                                                <blockquote>@AiConclusionStatement(doc, c, aiLang)</blockquote>
                                                            }
                                                        </article>
                                                    }
                                                </div>
                                            </section>

                                            <section class="didb-ai-panel">
                                                <h3>Suggested Checks</h3>
                                                <table class="didb-ai-checks">
                                                    <tbody>
                                                        @foreach (var h in aiHints)
                                                        {
                                                            <tr>
                                                                <td><span class="didb-ai-strength @AiEvidenceStrengthClass(h.EvidenceStrength)">@AiEvidenceStrengthLabel(h.EvidenceStrength)</span></td>
                                                                <td>
                                                                    <strong title="@AiHintCheck(doc, h, aiLang)">@AiBrief(AiHintCheck(doc, h, aiLang), 70)</strong>
                                                                    <div title="@AiHintReason(doc, h, aiLang)">@AiBrief(AiHintReason(doc, h, aiLang), _aiCardShowAll ? 360 : 120)</div>
                                                                    <span>@h.RelatedProcess @(!string.IsNullOrEmpty(h.RelatedPart) ? $"· {h.RelatedPart}" : "")</span>
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </section>
                                            </div>
                                        }

                                        @if (_aiCardShowAll)
                                        {
                                            <div class="didb-ai-grid">
                                                <section class="didb-ai-panel">
                                                    <h3>Campaign Scope</h3>
                                                    <ul class="didb-ai-list">
                                                        @foreach (var item in aiContent)
                                                        {
                                                            <li>@item</li>
                                                        }
                                                    </ul>
                                                    <div class="didb-ai-tags">
                                                        @foreach (var x in doc.RelatedDefects.Take(12))
                                                        {
                                                            <span>@x</span>
                                                        }
                                                    </div>
                                                </section>
                                                <section class="didb-ai-panel">
                                                    <h3>Parts / Processes</h3>
                                                    <div class="didb-ai-tags">
                                                        @foreach (var x in doc.Parts.Take(12))
                                                        {
                                                            <span>@x</span>
                                                        }
                                                    </div>
                                                    <div class="didb-ai-tags didb-ai-tags-spaced">
                                                        @foreach (var x in doc.Processes.Take(12))
                                                        {
                                                            <span>@x</span>
                                                        }
                                                    </div>
                                                </section>
                                            </div>

                                            @if (!string.IsNullOrEmpty(logRationale) || aiAssumptions.Count > 0 || aiWarnings.Count > 0)
                                            {
                                                <section class="didb-ai-panel didb-ai-full">
                                                    <h3>Decision Rationale</h3>
                                                    @if (!string.IsNullOrEmpty(logRationale))
                                                    {
                                                        <p>@CleanExcelSerialDateText(logRationale)</p>
                                                    }
                                                    <div class="didb-ai-grid didb-ai-log-grid">
                                                        <div>
                                                            <h3>Assumptions</h3>
                                                            <ul class="didb-ai-list">
                                                                @foreach (var x in aiAssumptions)
                                                                {
                                                                    <li>@CleanExcelSerialDateText(x)</li>
                                                                }
                                                            </ul>
                                                        </div>
                                                        <div>
                                                            <h3>Warnings</h3>
                                                            <ul class="didb-ai-list">
                                                                @foreach (var x in aiWarnings)
                                                                {
                                                                    <li>@CleanExcelSerialDateText(x)</li>
                                                                }
                                                            </ul>
                                                        </div>
                                                    </div>
                                                </section>
                                            }
                                        }

                                        <button class="didb-show-details didb-ai-more" @onclick="() => _aiCardShowAll = !_aiCardShowAll" @onclick:stopPropagation="true">
                                            @(_aiCardShowAll
                                                ? (aiHasGeneratedReport ? "Hide stored DB parameters" : "Hide dashboard detail")
                                                : (aiHasGeneratedReport
                                                    ? $"Show stored DB parameters ({doc.Results.Count} results, {doc.Results.Select(x => x.SheetName).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).Count()} sheets)"
                                                    : $"Show full dashboard ({doc.Results.Count} results, {doc.Results.Select(x => x.SheetName).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).Count()} sheets)"))
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }

                        <!-- Summary row (legacy DatasetSummary card) -->
                        @if (_expandedSummary is not null)
                        {
                            <tr class="didb-detail-row">
                                <td colspan="9" style="padding:0;">
                                    <div class="didb-summary">
                                        @* Language pills — only render once per row.
                                           "en" is always offered (the original AI output).
                                           ko/vi only appear if the translations table has them. *@
                                        <div class="didb-lang-row">
                                            @foreach (var (code, label) in LangsFor(_expandedSummary))
                                            {
                                                <button class="didb-lang @(code == _dbLang ? "active" : "")"
                                                        @onclick="() => _dbLang = code"
                                                        @onclick:stopPropagation="true">@label</button>
                                            }
                                        </div>
                                        @{
                                            bool hasV2db = !string.IsNullOrWhiteSpace(_expandedSummary.Verdict)
                                                         || !string.IsNullOrWhiteSpace(_expandedSummary.Headline)
                                                         || _expandedSummary.Evidence.Count > 0
                                                         || _expandedSummary.Actions.Count  > 0;

                                            // Pre-resolve everything here so the if-bodies below contain
                                            // only markup (Razor disallows `@{ ... }` as the first non-markup
                                            // token inside an `@if { … }` body).
                                            string vHeadlineDb = hasV2db ? LangHeadlineDb() : "";
                                            var    vActionsDb  = hasV2db ? LangActionsDb()  : new List<ActionItem>();
                                            AnalysisContext? vCtxDb = hasV2db ? LangContextDb() : null;
                                            (string dbV2Verdict, string dbV2VerdictClass) =
                                                hasV2db ? VerdictLabel(_expandedSummary.Verdict) : ("", "");

                                            string dbLgSummary           = !hasV2db ? LangText(s => s.Summary,           _expandedSummary.Summary)           : "";
                                            string dbLgPurpose           = !hasV2db ? LangText(s => s.Purpose,           _expandedSummary.Purpose)           : "";
                                            string dbLgTestConditions    = !hasV2db ? LangText(s => s.TestConditions,    _expandedSummary.TestConditions)    : "";
                                            string dbLgKeyFindings       = !hasV2db ? LangText(s => s.KeyFindings,       _expandedSummary.KeyFindings)       : "";
                                            string dbLgDecision          = !hasV2db ? LangText(s => s.Decision,          _expandedSummary.Decision)          : "";
                                            string dbLgRootCause         = !hasV2db ? LangText(s => s.RootCause,         _expandedSummary.RootCause)         : "";
                                            string dbLgRecommendedAction = !hasV2db ? LangText(s => s.RecommendedAction, _expandedSummary.RecommendedAction) : "";
                                            (string dbLgVerdict, string dbLgVerdictClass) =
                                                !hasV2db ? ParseVerdict(dbLgDecision) : ("", "");

                                            var dbTopNumbers = !hasV2db ? TakeBullets(dbLgKeyFindings, 3).ToList() : new List<string>();
                                            var dbTopActions = !hasV2db ? TakeBullets(dbLgRecommendedAction, 2).ToList() : new List<string>();

                                            EvidenceRow? heroDb = hasV2db && _expandedSummary.Evidence.Count > 0 ? _expandedSummary.Evidence[0] : null;
                                            bool anyNoteDb      = hasV2db && _expandedSummary.Evidence.Take(4).Any(e => !string.IsNullOrEmpty(e.Note));

                                            string  rtDb        = hasV2db ? (_expandedSummary.ReportType ?? "").Trim().ToLowerInvariant() : "";
                                            bool    isDoeDb     = rtDb == "doe_factorial";
                                            bool    isTrendDb   = rtDb == "trend_analysis";
                                            bool    isLogDb     = rtDb == "quality_log";
                                            (string rtLabelDb, string rtClassDb) = ReportTypeBadge(_expandedSummary.ReportType);
                                        }
                                        @if (hasV2db)
                                        {
                                            <div class="didb-dash">
                                                <aside class="didb-dash-side">
                                                    @if (!isLogDb && !string.IsNullOrEmpty(dbV2Verdict))
                                                    {
                                                        <span class="didb-verdict didb-verdict-lg @dbV2VerdictClass">@dbV2Verdict</span>
                                                    }
                                                    @if (!string.IsNullOrEmpty(rtLabelDb))
                                                    {
                                                        <span class="didb-rt-badge @rtClassDb" title="Report type">@rtLabelDb</span>
                                                    }
                                                    @if (heroDb is not null && !isLogDb)
                                                    {
                                                        <div class="didb-kpi-hero">
                                                            <div class="didb-kpi-value @DeltaClass(heroDb.DeltaSign)">@heroDb.DeltaText</div>
                                                            <div class="didb-kpi-label">@heroDb.Metric</div>
                                                        </div>
                                                    }
                                                    <div class="didb-kpi-meta">
                                                        <div><span class="didb-kpi-meta-n">@_expandedSummary.Evidence.Count</span> metrics</div>
                                                        <div><span class="didb-kpi-meta-n">@_expandedSummary.Actions.Count</span> actions</div>
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(vHeadlineDb))
                                                    {
                                                        <div class="didb-dash-headline">@vHeadlineDb</div>
                                                    }
                                                    @if (_expandedSummary.Tags.Count > 0)
                                                    {
                                                        <div class="didb-tags-row didb-tags-side">
                                                            @foreach (var t in _expandedSummary.Tags)
                                                            {
                                                                <span class="didb-tag didb-tag-keyword">
                                                                    🏷 @t
                                                                    <button class="didb-tag-del" title="Remove tag"
                                                                            @onclick="() => RemoveTag(r.DatasetName, t)"
                                                                            @onclick:stopPropagation="true">✕</button>
                                                                </span>
                                                            }
                                                        </div>
                                                    }
                                                </aside>
                                                <main class="didb-dash-main">
                                                    @if (_expandedSummary.Evidence.Count > 0)
                                                    {
                                                        <div class="didb-dash-section-title">📊 Evidence</div>
                                                        <div class="didb-evidence-wrap">
                                                            <table class="didb-evidence">
                                                                <thead>
                                                                    <tr>
                                                                        <th>Metric</th>
                                                                        <th>Baseline</th>
                                                                        <th>Variant</th>
                                                                        <th class="n">Δ</th>
                                                                        @if (anyNoteDb) { <th>Note</th> }
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var ev in _expandedSummary.Evidence.Take(4))
                                                                    {
                                                                        @if (ev.Comparisons is { Count: > 0 })
                                                                        {
                                                                            <tr>
                                                                                <td class="didb-ev-metric">
                                                                                    @ev.Metric
                                                                                    @if (!string.IsNullOrEmpty(ev.DeltaText))
                                                                                    {
                                                                                        <div class="didb-ev-range">@ev.DeltaText</div>
                                                                                    }
                                                                                </td>
                                                                                <td colspan="@(anyNoteDb ? 4 : 3)">
                                                                                    <div class="didb-ev-comparisons">
                                                                                        @foreach (var c in ev.Comparisons)
                                                                                        {
                                                                                            <div class="didb-ev-comp @(c.IsBest?"didb-comp-best":"") @(c.IsWorst?"didb-comp-worst":"") @(c.IsBaseline?"didb-comp-baseline":"")">
                                                                                                <span class="didb-ev-comp-label">@c.Label</span>
                                                                                                <span class="didb-ev-comp-val">@c.Value</span>
                                                                                                @if (c.N > 0) { <span class="didb-ev-comp-n">n=@c.N</span> }
                                                                                                @if (c.IsBaseline) { <span class="didb-ev-comp-flag baseline">base</span> }
                                                                                                @if (c.IsBest)     { <span class="didb-ev-comp-flag best">best</span> }
                                                                                                @if (c.IsWorst)    { <span class="didb-ev-comp-flag worst">worst</span> }
                                                                                            </div>
                                                                                        }
                                                                                    </div>
                                                                                </td>
                                                                            </tr>
                                                                        }
                                                                        else
                                                                        {
                                                                            <tr>
                                                                                <td class="didb-ev-metric">@ev.Metric</td>
                                                                                <td>
                                                                                    @if (!string.IsNullOrEmpty(ev.BaselineLabel))
                                                                                    {
                                                                                        <div class="didb-ev-label">@ev.BaselineLabel</div>
                                                                                    }
                                                                                    <div class="didb-ev-val">@ev.BaselineValue</div>
                                                                                </td>
                                                                                <td>
                                                                                    @if (!string.IsNullOrEmpty(ev.VariantLabel))
                                                                                    {
                                                                                        <div class="didb-ev-label">@ev.VariantLabel</div>
                                                                                    }
                                                                                    <div class="didb-ev-val">@ev.VariantValue</div>
                                                                                </td>
                                                                                <td class="n didb-ev-delta @DeltaClass(ev.DeltaSign)">@ev.DeltaText</td>
                                                                                @if (anyNoteDb)
                                                                                {
                                                                                    <td class="didb-ev-note-cell">@ev.Note</td>
                                                                                }
                                                                            </tr>
                                                                        }
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    }

                                                    @if (isDoeDb && _expandedSummary.DoeGrid is not null && _expandedSummary.DoeGrid.Factor1Levels.Count > 0 && _expandedSummary.DoeGrid.Factor2Levels.Count > 0)
                                                    {
                                                        <div class="didb-dash-section-title">🔬 DOE — @_expandedSummary.DoeGrid.Factor1Name × @_expandedSummary.DoeGrid.Factor2Name</div>
                                                        <div class="didb-doe-wrap">
                                                            <table class="didb-doe">
                                                                <thead>
                                                                    <tr>
                                                                        <th></th>
                                                                        @foreach (var f2 in _expandedSummary.DoeGrid.Factor2Levels)
                                                                        {
                                                                            <th>@(_expandedSummary.DoeGrid.Factor2Name)=@f2</th>
                                                                        }
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var f1 in _expandedSummary.DoeGrid.Factor1Levels)
                                                                    {
                                                                        <tr>
                                                                            <th>@(_expandedSummary.DoeGrid.Factor1Name)=@f1</th>
                                                                            @foreach (var f2 in _expandedSummary.DoeGrid.Factor2Levels)
                                                                            {
                                                                                var cell = _expandedSummary.DoeGrid.Cells.FirstOrDefault(c => c.F1 == f1 && c.F2 == f2);
                                                                                var status = (cell?.Status ?? "empty").ToLowerInvariant();
                                                                                <td class="didb-doe-cell didb-doe-@status" title="@cell?.Value">
                                                                                    @(cell?.Value ?? "—")
                                                                                </td>
                                                                            }
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    }

                                                    @if (isTrendDb && _expandedSummary.TrendPoints is { Count: > 0 })
                                                    {
                                                        <div class="didb-dash-section-title">📈 Trend</div>
                                                        <ol class="didb-trend">
                                                            @foreach (var p in _expandedSummary.TrendPoints.Take(12))
                                                            {
                                                                <li>
                                                                    <span class="didb-trend-label">@p.Label</span>
                                                                    <span class="didb-trend-value">@p.Value</span>
                                                                    @if (!string.IsNullOrEmpty(p.Note))
                                                                    {
                                                                        <span class="didb-trend-note">@p.Note</span>
                                                                    }
                                                                </li>
                                                            }
                                                        </ol>
                                                    }

                                                    @if (vActionsDb.Count > 0)
                                                    {
                                                        <div class="didb-dash-section-title">✅ Actions</div>
                                                        <ol class="didb-actions">
                                                            @foreach (var a in vActionsDb.OrderBy(x => x.Priority).Take(3))
                                                            {
                                                                <li class="didb-action-@(a.Kind?.ToLowerInvariant() ?? "action")">
                                                                    <span class="didb-action-kind">@KindGlyph(a.Kind)</span>
                                                                    <span class="didb-action-text">@a.Text</span>
                                                                </li>
                                                            }
                                                        </ol>
                                                    }

                                                    @if (vCtxDb is not null &&
                                                         (!string.IsNullOrEmpty(vCtxDb.Process) ||
                                                          !string.IsNullOrEmpty(vCtxDb.Stage)   ||
                                                          !string.IsNullOrEmpty(vCtxDb.BaselineReason)))
                                                    {
                                                        <button class="didb-show-details"
                                                                @onclick="ToggleContext"
                                                                @onclick:stopPropagation="true">
                                                            @(_showContextDb ? "▴ Hide context" : "▾ Context")
                                                        </button>
                                                        @if (_showContextDb)
                                                        {
                                                            <dl class="didb-context">
                                                                @if (!string.IsNullOrEmpty(vCtxDb.Process))
                                                                {
                                                                    <dt>Process</dt><dd>@vCtxDb.Process</dd>
                                                                }
                                                                @if (!string.IsNullOrEmpty(vCtxDb.Stage))
                                                                {
                                                                    <dt>Stage</dt><dd>@vCtxDb.Stage</dd>
                                                                }
                                                                @if (!string.IsNullOrEmpty(vCtxDb.BaselineReason))
                                                                {
                                                                    <dt>Baseline</dt><dd>@vCtxDb.BaselineReason</dd>
                                                                }
                                                            </dl>
                                                        }
                                                    }
                                                </main>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="didb-verdict-row">
                                                @if (!string.IsNullOrEmpty(dbLgVerdict))
                                                {
                                                    <span class="didb-verdict @dbLgVerdictClass">@dbLgVerdict</span>
                                                }
                                                @if (!string.IsNullOrEmpty(dbLgSummary))
                                                {
                                                    <span class="didb-card-conclusion">@dbLgSummary</span>
                                                }
                                            </div>
                                            @if (dbTopNumbers.Count > 0)
                                            {
                                                <ul class="didb-card-list">
                                                    @foreach (var b in dbTopNumbers) { <li>@b</li> }
                                                </ul>
                                            }
                                            @if (dbTopActions.Count > 0)
                                            {
                                                <ul class="didb-card-list didb-card-actions">
                                                    @foreach (var b in dbTopActions) { <li>@b</li> }
                                                </ul>
                                            }
                                            <button class="didb-show-details"
                                                    @onclick="ToggleFullSummary"
                                                    @onclick:stopPropagation="true">
                                                @(_showFullSummary ? "▴ Hide details" : "▾ Show details (legacy view)")
                                            </button>
                                            @if (_showFullSummary)
                                            {
                                                @if (!string.IsNullOrEmpty(dbLgPurpose))
                                                {
                                                    <div class="didb-section">
                                                        <div class="didb-sec-label">① Test Goal</div>
                                                        <pre class="didb-sec-body">@dbLgPurpose</pre>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrEmpty(dbLgTestConditions))
                                                {
                                                    <div class="didb-section didb-section-setup">
                                                        <div class="didb-sec-label">② Comparison Setup</div>
                                                        <pre class="didb-sec-body">@dbLgTestConditions</pre>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrEmpty(dbLgKeyFindings))
                                                {
                                                    <div class="didb-section">
                                                        <div class="didb-sec-label">③ Key Numbers (full)</div>
                                                        <pre class="didb-sec-body">@dbLgKeyFindings</pre>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrEmpty(dbLgDecision))
                                                {
                                                    <div class="didb-section didb-section-effect">
                                                        <div class="didb-sec-label">④ Effect</div>
                                                        <pre class="didb-sec-body">@dbLgDecision</pre>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrEmpty(dbLgRootCause))
                                                {
                                                    <div class="didb-section">
                                                        <div class="didb-sec-label">⑤ Motivation / Cause</div>
                                                        <pre class="didb-sec-body">@dbLgRootCause</pre>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrEmpty(dbLgRecommendedAction))
                                                {
                                                    <div class="didb-section">
                                                        <div class="didb-sec-label">⑥ Actions / Risks (full)</div>
                                                        <pre class="didb-sec-body">@dbLgRecommendedAction</pre>
                                                    </div>
                                                }
                                            }
                                        }
                                        @if (!hasV2db && _expandedSummary.Tags.Count > 0)
                                        {
                                            @* v2 dashboard renders tags in the side aside. *@
                                            <div class="didb-tags-row">
                                                @foreach (var t in _expandedSummary.Tags)
                                                {
                                                    <span class="didb-tag didb-tag-keyword">
                                                        🏷 @t
                                                        <button class="didb-tag-del" title="Remove tag"
                                                                @onclick="() => RemoveTag(r.DatasetName, t)"
                                                                @onclick:stopPropagation="true">✕</button>
                                                    </span>
                                                }
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        @* Heatmap row — Line × CheckType → avg NG%. Computed
                           locally from _expandedMeasurements; not AI-generated.
                           Skip 1×N / N×1 matrices (a "heatmap" of a single
                           column is just a list). Collapsed by default. *@
                        @if (_corrCells.Count > 0 && _corrLines.Count >= 2 && _corrCheckTypes.Count >= 2)
                        {
                            <tr class="didb-detail-row">
                                <td colspan="9" style="padding:0;">
                                    <div class="didb-summary">
                                        <button class="didb-section-toggle"
                                                @onclick="() => _showHeatmap = !_showHeatmap"
                                                @onclick:stopPropagation="true">
                                            <span>🌡 @_corrRowLabel × @_corrColLabel — avg NG%</span>
                                            <span class="didb-section-arrow">@(_showHeatmap ? "▴" : "▾")</span>
                                        </button>
                                        @if (_showHeatmap)
                                        {
                                        <div class="didb-section">
                                            <div style="overflow-x:auto;">
                                                <table class="didb-heatmap">
                                                    <thead>
                                                        <tr>
                                                            <th></th>
                                                            @foreach (var c in _corrCheckTypes)
                                                            {
                                                                <th>@c</th>
                                                            }
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var line in _corrLines)
                                                        {
                                                            <tr>
                                                                <th>@line</th>
                                                                @foreach (var c in _corrCheckTypes)
                                                                {
                                                                    var key = (line, c);
                                                                    if (_corrCells.TryGetValue(key, out var v))
                                                                    {
                                                                        <td title="@v.RowCount measurement row(s)" style="background:@HeatColor(v.AvgNg);">
                                                                            <div class="didb-heat-pct">@v.AvgNg.ToString("F1")%</div>
                                                                            <div class="didb-heat-ratio">(@v.NgSum.ToString("N0")/@v.InputSum.ToString("N0"))</div>
                                                                            @if (v.Defects.Count > 1)
                                                                            {
                                                                                <div class="didb-heat-defects">
                                                                                    @foreach (var d in v.Defects.Take(5))
                                                                                    {
                                                                                        <div>@d.Type: @d.Count.ToString("N0")</div>
                                                                                    }
                                                                                    @if (v.Defects.Count > 5)
                                                                                    {
                                                                                        <div>+@(v.Defects.Count - 5) more</div>
                                                                                    }
                                                                                </div>
                                                                            }
                                                                        </td>
                                                                    }
                                                                    else
                                                                    {
                                                                        <td class="didb-heat-empty">—</td>
                                                                    }
                                                                }
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                            <div class="didb-heat-legend">
                                                <span style="background:@HeatColor(0.0);">0%</span>
                                                <span style="background:@HeatColor(2.5);">2.5%</span>
                                                <span style="background:@HeatColor(5.0);">5%</span>
                                                <span style="background:@HeatColor(10.0);">10%+</span>
                                            </div>
                                        </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        <!-- Measurements sub-table -->
                        @if (_expandedMeasurements.Count > 0)
                        {
                            <tr class="didb-detail-row">
                                <td colspan="9" style="padding:0;">
                                    <div class="didb-sub-wrap">
                                        <button class="didb-section-toggle"
                                                @onclick="() => _showMeasurements = !_showMeasurements"
                                                @onclick:stopPropagation="true">
                                            <span>📐 Extracted Measurements — @_expandedMeasurements.Count row(s)</span>
                                            <span class="didb-section-arrow">@(_showMeasurements ? "▴" : "▾")</span>
                                        </button>
                                        @if (_showMeasurements)
                                        {
                                        <table class="didb-sub">
                                            <thead>
                                                <tr>
                                                    <th>Variable</th>
                                                    <th>Group</th>
                                                    <th>Line</th>
                                                    <th>CheckType</th>
                                                    <th>Input</th>
                                                    <th>NG</th>
                                                    <th>NG%</th>
                                                    <th>Defect Type</th>
                                                    <th>Category</th>
                                                    <th>Count</th>
                                                    <th>Intervention</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var m in _expandedMeasurements)
                                                {
                                                    <tr>
                                                        @RenderEditable(m, "Variable",       m.Variable)
                                                        @RenderEditable(m, "VariableGroup",  m.VariableGroup)
                                                        @RenderEditable(m, "Line",           m.Line)
                                                        @RenderEditable(m, "CheckType",      m.CheckType)
                                                        @RenderEditable(m, "InputQty",       m.InputQty.ToString(), numeric:true)
                                                        @RenderEditable(m, "NgTotal",        m.NgTotal.ToString(),  numeric:true)
                                                        @RenderEditable(m, "NgRate",         m.NgRate.ToString("F1") + "%", numeric:true)
                                                        @RenderEditable(m, "DefectType",     m.DefectType)
                                                        @RenderEditable(m, "DefectCategory", m.DefectCategory)
                                                        @RenderEditable(m, "DefectCount",    m.DefectCount.ToString(), numeric:true)
                                                        @RenderEditable(m, "Intervention",   m.Intervention)
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        else if (_expandedMeasurements.Count == 0 && _expanded == r.DatasetName)
                        {
                            <tr class="didb-detail-row">
                                <td colspan="9">
                                    <div style="padding:8px 16px; font-size:12px; color:#94a3b8; font-style:italic;">
                                        No normalized measurements — run Analyze on Input Data, then Save.
                                    </div>
                                </td>
                            </tr>
                        }

                        @* Source text comparison — OCR markdown vs Excel paste ground truth.
                           Collapsed by default: it's debug context, not decision data. *@
                        @if (_expanded == r.DatasetName
                             && (!string.IsNullOrWhiteSpace(_expandedOcrText)
                                 || !string.IsNullOrWhiteSpace(_expandedExcelPaste)))
                        {
                            <tr class="didb-detail-row">
                                <td colspan="9" style="padding:0;">
                                    <button class="didb-section-toggle"
                                            @onclick="() => _showSource = !_showSource"
                                            @onclick:stopPropagation="true">
                                        <span>📝 Source Text</span>
                                        <span class="didb-section-arrow">@(_showSource ? "▴" : "▾")</span>
                                    </button>
                                    @if (_showSource)
                                    {
                                    <div class="didb-src-wrap">
                                        <div class="didb-src-head">
                                            <span class="didb-src-title">📝 Source Text</span>
                                            <div class="didb-src-tabs">
                                                <button class="didb-src-tab @(_sourceView == "ocr" ? "active" : "")"
                                                        @onclick='() => SetSourceView("ocr")'
                                                        disabled="@string.IsNullOrWhiteSpace(_expandedOcrText)">
                                                    OCR markdown
                                                    @if (!string.IsNullOrWhiteSpace(_expandedOcrText))
                                                    { <span class="didb-src-len">@_expandedOcrText.Length</span> }
                                                    else { <span class="didb-src-missing">—</span> }
                                                </button>
                                                <button class="didb-src-tab @(_sourceView == "excel" ? "active" : "")"
                                                        @onclick='() => SetSourceView("excel")'
                                                        disabled="@string.IsNullOrWhiteSpace(_expandedExcelPaste)">
                                                    Excel paste
                                                    @if (!string.IsNullOrWhiteSpace(_expandedExcelPaste))
                                                    { <span class="didb-src-len">@_expandedExcelPaste.Length</span> }
                                                    else { <span class="didb-src-missing">—</span> }
                                                </button>
                                                <button class="didb-src-tab @(_sourceView == "split" ? "active" : "")"
                                                        @onclick='() => SetSourceView("split")'
                                                        disabled="@(string.IsNullOrWhiteSpace(_expandedOcrText) || string.IsNullOrWhiteSpace(_expandedExcelPaste))">
                                                    Split compare
                                                </button>
                                            </div>
                                        </div>
                                        @* Show the Excel paste TSV with a Table/Text view toggle (same
                                           UX as Data Input). For OCR markdown / split comparison the
                                           plain <pre> stays — markdown isn't TSV. *@
                                        @{
                                            bool showExcelTable =
                                                (_sourceView == "excel" || (_sourceView != "split" && _sourceView != "ocr"))
                                                && !string.IsNullOrWhiteSpace(_expandedExcelPaste);
                                        }
                                        @if (showExcelTable)
                                        {
                                            <div class="didb-view-toggle">
                                                <button class="didb-view-btn @(_excelView == "table" ? "active" : "")"
                                                        @onclick='() => _excelView = "table"'>📊 Table</button>
                                                <button class="didb-view-btn @(_excelView == "text" ? "active" : "")"
                                                        @onclick='() => _excelView = "text"'>📝 Text</button>
                                            </div>
                                        }
                                        @if (_sourceView == "split"
                                             && !string.IsNullOrWhiteSpace(_expandedOcrText)
                                             && !string.IsNullOrWhiteSpace(_expandedExcelPaste))
                                        {
                                            <div class="didb-src-split">
                                                <div class="didb-src-pane">
                                                    <div class="didb-src-pane-label">OCR markdown</div>
                                                    <pre class="didb-src-pre">@_expandedOcrText</pre>
                                                </div>
                                                <div class="didb-src-pane">
                                                    <div class="didb-src-pane-label">Excel paste (ground truth)</div>
                                                    <pre class="didb-src-pre">@_expandedExcelPaste</pre>
                                                </div>
                                            </div>
                                        }
                                        else if (showExcelTable && _excelView == "table")
                                        {
                                            <div class="didb-table-preview">
                                                @foreach (var (name, rows) in ParsePastedTsv(_expandedExcelPaste))
                                                {
                                                    <div class="didb-sheet-name">📑 @name</div>
                                                    <div style="overflow-x:auto;">
                                                        <table class="didb-preview-table">
                                                            <tbody>
                                                                @foreach (var row in rows)
                                                                {
                                                                    <tr>
                                                                        @foreach (var cell in row)
                                                                        {
                                                                            <td style="@CellStyle(cell)">@CleanExcelSerialDateText(cell.Value)</td>
                                                                        }
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else if (_sourceView == "excel" && !string.IsNullOrWhiteSpace(_expandedExcelPaste))
                                        {
                                            <pre class="didb-src-pre didb-src-single">@_expandedExcelPaste</pre>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(_expandedOcrText))
                                        {
                                            <pre class="didb-src-pre didb-src-single">@_expandedOcrText</pre>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(_expandedExcelPaste))
                                        {
                                            <pre class="didb-src-pre didb-src-single">@_expandedExcelPaste</pre>
                                        }
                                    </div>
                                    }
                                </td>
                            </tr>
                        }

                        @* Images row — collapsed by default. Pass-style reports
                           sometimes attach hundreds of evidence shots; pre-
                           rendering them all blows up the page. lazy + toggle. *@
                        @if (_expandedImages.Count > 0)
                        {
                            <tr class="didb-detail-row">
                                <td colspan="9" style="padding:0;">
                                    <button class="didb-section-toggle"
                                            @onclick="() => _showAttachedImages = !_showAttachedImages"
                                            @onclick:stopPropagation="true">
                                        <span>🖼 AI Analysis Images (@_expandedImages.Count)</span>
                                        <span class="didb-section-arrow">@(_showAttachedImages ? "▴" : "▾")</span>
                                    </button>
                                    @if (_showAttachedImages)
                                    {
                                    <div class="didb-imgs-wrap">
                                        <div class="didb-imgs-grid">
                                            @foreach (var (img, idx) in _expandedImages.Select((x, i) => (x, i)))
                                            {
                                                <div class="didb-img-thumb" @onclick="() => OpenViewer(img.DataUrl)">
                                                    <img src="@img.DataUrl" alt="@img.FileName" loading="lazy" />
                                                    <div class="didb-img-num">@(idx + 1)</div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    }
                                </td>
                            </tr>
                        }

                        @* Backup files row *@
                        @if (_expandedFiles.Count > 0)
                        {
                            <tr class="didb-detail-row">
                                <td colspan="9" style="padding:0;">
                                    <div class="didb-imgs-wrap">
                                        <div class="didb-imgs-title">📎 Backup Files (@_expandedFiles.Count)</div>
                                        <div class="didb-files-list">
                                            @foreach (var f in _expandedFiles)
                                            {
                                                <a class="didb-file-chip" href="/data-inference/file/@f.Id" download="@f.FileName" target="_blank">
                                                    <span class="didb-file-icon">📄</span>
                                                    <span class="didb-file-name" title="@f.FileName">@f.FileName</span>
                                                    <span class="didb-file-size">@FormatSize(f.FileSize)</span>
                                                </a>
                                            }
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
    </div>
}

<!-- ── Delete confirm ───────────────────────────────────────────────────────── -->
@if (_deleteTarget is not null)
{
    <div class="didb-overlay" @onclick="CancelDelete">
        <div class="didb-confirm" @onclick:stopPropagation="true">
            <div class="didb-confirm-title">Delete Dataset</div>
            <p style="font-size:13px;">
                Dataset <strong>@_deleteTarget</strong> and all its images/measurements will be deleted.<br />
                This action cannot be undone.
            </p>
            <div style="display:flex; gap:8px; justify-content:flex-end;">
                <button class="btn btn-outline-secondary btn-sm" @onclick="CancelDelete">Cancel</button>
                <button class="btn btn-danger btn-sm" @onclick="ExecuteDelete">Delete</button>
            </div>
        </div>
    </div>
}

@if (_viewerDataUrl is not null)
{
    <div class="didb-viewer-overlay" @onclick="CloseViewer">
        <img src="@_viewerDataUrl" class="didb-viewer-img" @onclick:stopPropagation="true" />
        <button class="didb-viewer-close" @onclick="CloseViewer">✕</button>
    </div>
}

<OcrTextEditor DatasetName="@_ocrDataset"
               ProductType="@_ocrProductType"
               ReportDate="@_ocrReportDate"
               OnClose="CloseOcrEditor"
               OnReanalyzed="OnOcrReanalyzed" />

@if (_showDeleteAll)
{
    <div class="didb-overlay" @onclick="CancelDeleteAll">
        <div class="didb-confirm" @onclick:stopPropagation="true">
            <div class="didb-confirm-title" style="color:#dc2626;">⚠ Delete ALL Datasets</div>
            <p style="font-size:13px;">
                <strong>All saved DataInference data</strong> (images, measurements, summaries, tags) will be deleted.<br />
                A total of <strong>@_reports.Count</strong> datasets will be permanently removed.<br />
                <span style="color:#dc2626; font-weight:600;">This action cannot be undone.</span>
            </p>
            <div style="display:flex; gap:8px; justify-content:flex-end;">
                <button class="btn btn-outline-secondary btn-sm" @onclick="CancelDeleteAll">Cancel</button>
                <button class="btn btn-danger btn-sm" @onclick="ExecuteDeleteAll">Delete All</button>
            </div>
        </div>
    </div>
}

</div>

<style>
