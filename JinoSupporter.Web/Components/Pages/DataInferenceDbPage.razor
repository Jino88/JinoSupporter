                                                                {
                                                                    <div class="didb-ai-doe-cell @AiJudgementClass(row)">
                                                                        <strong>@AiResultMainValue(row)</strong>
                                                                        <span>@AiResultLabel(row)</span>
                                                                        <em>@AiMetricLabel(row)</em>
                                                                    </div>
                                                                }
                                                            </div>
                                                            <table class="didb-ai-comp-table didb-ai-metric-table">
                                                                <thead>
                                                                    <tr>
                                                                        <th>@AiUi(aiLang, "condition")</th>
                                                                        <th>@AiUi(aiLang, "factor")</th>
                                                                        <th>@AiUi(aiLang, "metric")</th>
                                                                        <th class="n">@AiUi(aiLang, "value")</th>
                                                                        <th>@AiUi(aiLang, "judgement")</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var row in aiDoeRows)
                                                                    {
                                                                        <tr>
                                                                            <td><strong>@AiResultLabel(row)</strong></td>
                                                                            <td>@AiFactorLabel(row)</td>
                                                                            <td>@AiMetricLabel(row)</td>
                                                                            <td class="n">@AiResultMainValue(row)</td>
                                                                            <td><span class="didb-ai-status @AiJudgementClass(row)">@AiJudgementLabel(row, aiLang)</span></td>
