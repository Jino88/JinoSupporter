                                                    {
                                                        <div class="didb-ai-mini-row">
                                                            <strong>@AiBrief(AiMetricLabel(row), 52)</strong>
                                                            <span>@AiResultMainValue(row) / @AiJudgementLabel(row, aiLang)</span>
                                                        </div>
                                                    }
                                                }
                                                else if (aiReportKind == "reliability_spec" && aiReliabilityRows.Count > 0)
                                                {
                                                    <h3>@AiUi(aiLang, "specSummary")</h3>
                                                    @foreach (var row in aiReliabilityRows.Take(_aiCardShowAll ? 8 : 6))
                                                    {
                                                        <div class="didb-ai-mini-row">
                                                            <strong>@AiBrief(AiMetricLabel(row), 52)</strong>
                                                            <span>@AiResultMainValue(row) / @AiJudgementLabel(row, aiLang)</span>
                                                        </div>
                                                    }
                                                }
                                                else if (aiReportKind == "doe_matrix" && aiDoeRows.Count > 0)
                                                {
                                                    <h3>@AiUi(aiLang, "doeFocus")</h3>
                                                    @foreach (var row in aiDoeRows.Take(_aiCardShowAll ? 8 : 6))
                                                    {
                                                        <div class="didb-ai-mini-row">
                                                            <strong>@AiBrief(AiResultLabel(row), 52)</strong>
