    .didb-aicard-reason   { font-size: 11px; color: #64748b; margin-top: 2px; }
    .didb-aicard-rationale {
        font-size: 11px; color: #334155; background: #fff;
        border-left: 3px solid #6366f1; padding: 6px 10px; margin-top: 2px;
    }

    /* AI_EXCEL_PROC dashboard — expanded Dataset Results row */
    .didb-ai-dashboard {
        padding: 14px 18px 16px 40px;
        background: #f4f6f8;
        border-top: 1px solid #d9e0e7;
        border-bottom: 1px solid #d9e0e7;
        color: #17202a;
    }
    .didb-ai-hero {
        display: grid; grid-template-columns: minmax(0, 1fr) 260px; gap: 16px;
        background: #fff; border: 1px solid #d9e0e7; border-radius: 8px;
        padding: 14px 16px;
    }
    @@media (max-width: 980px) {
        .didb-ai-hero { grid-template-columns: 1fr; }
    }
    .didb-ai-title-line {
        display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
        margin-top: 4px;
    }
    .didb-ai-primary {
        display: inline-flex; align-items: center;
        padding: 2px 9px; border-radius: 999px;
        background: #fef3c7; color: #92400e; border: 1px solid #fcd34d;
        font-size: 10px; font-weight: 800; text-transform: uppercase;
    }
    .didb-ai-title {
        font-size: 17px; line-height: 1.3; font-weight: 800; color: #17202a;
        overflow-wrap: anywhere;
    }
    .didb-ai-purpose {
        margin-top: 7px; color: #526173; font-size: 12px; line-height: 1.55;
