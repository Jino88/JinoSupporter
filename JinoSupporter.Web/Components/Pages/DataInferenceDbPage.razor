    private static bool SameText(string? a, string? b)
        => string.Equals((a ?? "").Trim(), (b ?? "").Trim(), StringComparison.OrdinalIgnoreCase);

    private static bool ContainsAny(string text, params string[] needles)
    {
        string haystack = NormalizeAiText(text);
        string padded = " " + haystack + " ";
        var tokens = AiTokens(text);
        foreach (string needle in needles)
        {
            string normalized = NormalizeAiText(needle);
            if (string.IsNullOrWhiteSpace(normalized)) continue;
            if (normalized.Contains(' '))
            {
                if (haystack.Contains(normalized, StringComparison.OrdinalIgnoreCase)) return true;
            }
            else if (padded.Contains(" " + normalized + " ", StringComparison.OrdinalIgnoreCase)
                     || tokens.Contains(normalized))
            {
                return true;
            }
        }
        return false;
    }

    private static bool ContainsOkBaselineToken(string label)
    {
        string normalized = " " + NormalizeAiText(label) + " ";
        return normalized.Contains(" ok ", StringComparison.OrdinalIgnoreCase)
               && !normalized.Contains(" ng ", StringComparison.OrdinalIgnoreCase)
               && !normalized.Contains(" test ", StringComparison.OrdinalIgnoreCase);
    }

    private static bool AiTextContainsLabel(string candidateLabel, string targetLabel)
    {
        string candidate = NormalizeAiText(candidateLabel);
        string target = NormalizeAiText(targetLabel);
        if (string.IsNullOrWhiteSpace(candidate) || string.IsNullOrWhiteSpace(target)) return false;
        if (candidate.Contains(target, StringComparison.OrdinalIgnoreCase)) return true;

        var targetTokens = AiTokens(target);
        if (targetTokens.Count == 0) return false;
        var candidateTokens = AiTokens(candidate);
        return targetTokens.All(candidateTokens.Contains);
    }

    private static int AiSharedTokenScore(string? left, string? right)
    {
        var a = AiTokens(NormalizeAiText(left ?? ""));
        var b = AiTokens(NormalizeAiText(right ?? ""));
        if (a.Count == 0 || b.Count == 0) return 0;
        return Math.Min(24, a.Count(b.Contains) * 4);
    }

    private static HashSet<string> AiTokens(string text)
    {
        string[] stop = ["total", "rate", "function", "test", "normal", "baseline", "ng", "ok", "the", "and", "vs"];
        return text
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(x => x.Length >= 2)
            .Where(x => !stop.Contains(x, StringComparer.OrdinalIgnoreCase))
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
    }

    private static string NormalizeAiText(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return "";
        Span<char> buffer = stackalloc char[text.Length];
        int j = 0;
        foreach (char ch in text)
        {
            buffer[j++] = char.IsLetterOrDigit(ch) ? char.ToLowerInvariant(ch) : ' ';
        }
        return new string(buffer[..j]).Trim();
    }

