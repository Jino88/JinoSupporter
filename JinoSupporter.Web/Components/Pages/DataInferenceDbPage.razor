                                                    <h3>@AiUi(aiLang, "measurementFocus")</h3>
                                                    @foreach (var cmp in aiDimensionComps.Take(_aiCardShowAll ? 8 : 5))
                                                    {
                                                        <div class="didb-ai-mini-row">
                                                            <strong>@AiBrief(AiMetricLabel(cmp.Variant), 52)</strong>
                                                            <span>@AiMetricValue(cmp.Baseline) -> @AiMetricValue(cmp.Variant)</span>
                                                        </div>
                                                    }
