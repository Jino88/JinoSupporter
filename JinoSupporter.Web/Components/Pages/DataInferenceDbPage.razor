    private static bool AiUsesProcessReview(string kind)
        => kind is "normal_comparison" or "process_condition_change" or "lot_supplier_mold_comparison";

    private static bool AiShowsPrimaryDefect(string kind)
        => kind is "defect_root_cause" or "ng_without_baseline" or "image_dependent";

    private static string AiReportFocusText(
        AiDocBundle doc,
        string reportKind,
        List<AiProcessReviewSection> sections)
    {
        if (AiUsesProcessReview(reportKind))
        {
            string processes = string.Join(", ", sections.Select(s => s.Process)
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Take(3));
            if (!string.IsNullOrWhiteSpace(processes)) return processes;

            string changed = AiConditionChangeSummary(doc);
            if (!string.IsNullOrWhiteSpace(changed) && changed != "-") return changed;
        }

        if (reportKind is "measurement_spec" or "before_after_dimension" or "reliability_spec")
        {
            string metrics = string.Join(", ", doc.Results.Select(AiProcessFamilyLabel)
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Take(3));
            if (!string.IsNullOrWhiteSpace(metrics)) return metrics;
        }

        if (AiShowsPrimaryDefect(reportKind) && !string.IsNullOrWhiteSpace(doc.PrimaryDefect))
            return doc.PrimaryDefect;
        if (doc.Processes.Count > 0) return string.Join(", ", doc.Processes.Take(3));
        if (doc.Parts.Count > 0) return string.Join(", ", doc.Parts.Take(3));
        return AiReportKindLabel(reportKind);
    }

    private static List<AiControlComparison> BuildAiControlComparisons(AiDocBundle doc)
    {
        var rateRows = doc.Results
            .Where(IsAiActualNgRateResult)
            .Where(x => AiNgRatePercent(x).HasValue)
            .ToList();
        var baselines = rateRows.Where(IsAiBaselineResult).ToList();
        if (baselines.Count == 0) return [];

        var comparisons = new List<AiControlComparison>();
        foreach (var variant in rateRows.Where(x => !IsAiBaselineResult(x)))
        {
            AiResultRow? baseline = FindAiBaseline(variant, baselines);
            if (baseline is null || !AiNgRatePercent(baseline).HasValue) continue;

            comparisons.Add(new AiControlComparison
            {
                Baseline          = baseline,
                Variant           = variant,
                RelativeChangePct = AiRelativeChangePct(baseline, variant),
            });
        }

        return comparisons
            .OrderByDescending(AiIsWorse)
            .ThenByDescending(x => AiComparisonMagnitude(x))
            .ToList();
    }

    private static List<AiProcessReviewSection> BuildAiProcessReviewSections(
        AiDocBundle doc,
        List<AiControlComparison> ngComparisons)
    {
        var rows = new List<AiProcessReviewRow>();

        foreach (var cmp in ngComparisons)
            rows.Add(BuildAiNgReviewRow(cmp));

        foreach (var cmp in BuildAiMetricComparisons(doc, IsAiComparableNumericMetric))
            rows.Add(BuildAiMetricReviewRow(cmp));

        return rows
            .GroupBy(r => r.Process)
            .Select(g => new AiProcessReviewSection
            {
                Process = g.Key,
                EventLabel = g.Select(r => r.EventLabel).FirstOrDefault(x => !string.IsNullOrWhiteSpace(x)) ?? "",
                Rows = g
                    .OrderBy(r => r.SortRank)
                    .ThenBy(r => r.Metric)
                    .ToList(),
            })
            .OrderBy(s => s.Rows.Min(r => r.SortRank))
            .ThenBy(s => s.Process)
            .ToList();
    }

    private static List<(string Label, string Value)> BuildAiFourLineSummary(
        AiDocBundle doc,
        string reportKind,
        List<AiControlComparison> comparisons,
        List<AiProcessReviewSection> sections)
    {
        bool showPrimaryDefect = AiShowsPrimaryDefect(reportKind);
        string target = showPrimaryDefect && !string.IsNullOrWhiteSpace(doc.PrimaryDefect)
            ? doc.PrimaryDefect
            : AiReportFocusText(doc, reportKind, sections);

        string changed = AiConditionChangeSummary(doc);
        string result = AiResultNumberSummary(comparisons, sections, doc);
        string effect = AiEffectSummary(reportKind, comparisons, doc);

        return
        [
            (showPrimaryDefect ? "Problem" : "Review Target", target),
            ("Changed / Tested", changed),
            ("Key Result", result),
            ("Effect", effect),
        ];
    }

    private static List<AiReportBlock> BuildAiDetailedReportBlocks(
        AiDocBundle doc,
        string lang,
        string reportKind,
        List<AiControlComparison> comparisons,
        List<AiProcessReviewSection> sections,
        string logRationale,
        List<string> warnings,
        bool showAll)
    {
        var blocks = new List<AiReportBlock>();

        void AddBlock(string title, string kind, IEnumerable<string> lines)
        {
            IEnumerable<string> query = lines
                .Select(x => System.Text.RegularExpressions.Regex.Replace(x ?? "", @"\s+", " ").Trim())
                .Where(x => !string.IsNullOrWhiteSpace(x) && x != "-")
                .Distinct(StringComparer.OrdinalIgnoreCase);
            if (!showAll) query = query.Take(8);
            var clean = query.ToList();
            if (clean.Count == 0) return;
            blocks.Add(new AiReportBlock { Title = title, Kind = kind, Lines = clean });
        }

        void AddTableBlock(string title, string kind, IEnumerable<string> headers, List<AiReportTableRow> rows)
        {
            if (rows.Count == 0) return;
            blocks.Add(new AiReportBlock
            {
                Title = title,
                Kind = kind,
                Headers = headers.ToList(),
                TableRows = showAll ? rows : rows.Take(10).ToList(),
            });
        }

        string JoinTop(IEnumerable<string> values, int take = 5)
        {
            IEnumerable<string> query = values
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct(StringComparer.OrdinalIgnoreCase);
            if (!showAll) query = query.Take(take);
            return string.Join(", ", query);
        }

        bool showPrimaryDefect = AiShowsPrimaryDefect(reportKind);
        string subjectTitle = showPrimaryDefect ? "2. Problem" : "2. Review Target";
        IEnumerable<string> subjectLines = showPrimaryDefect
            ? [
                "Primary: " + doc.PrimaryDefect,
                "Defects: " + JoinTop(doc.RelatedDefects),
                "Parts: " + JoinTop(doc.Parts),
                "Processes: " + JoinTop(doc.Processes),
            ]
            : [
                "Target: " + AiReportFocusText(doc, reportKind, sections),
                "Report type: " + AiReportKindLabel(reportKind),
                "Processes: " + JoinTop(doc.Processes),
                "Parts: " + JoinTop(doc.Parts),
            ];

        AddBlock("1. Basic Info", "basic",
        [
            "Dataset: " + doc.SourceDataset,
            "Title: " + AiDocTitle(doc, lang),
            "Date: " + DisplayExcelDate(doc.ReportDate),
            "Type: " + AiReportKindLabel(reportKind),
            "Confidence: " + doc.Confidence.ToString("0.00"),
        ]);

        AddBlock(subjectTitle, showPrimaryDefect ? "problem" : "condition", subjectLines);

        AddBlock("3. Purpose", "purpose",
            new[] { AiDocPurpose(doc, lang) }
                .Concat(showAll ? AiDocContent(doc, lang) : AiDocContent(doc, lang).Take(3)));

        AddBlock("4. Changed Conditions", "condition",
            BuildAiConditionReportLines(doc, showAll));

        var resultTableRows = BuildAiResultReportTableRows(doc, sections);
        if (resultTableRows.Count > 0)
            AddTableBlock("5. Result Data", "result",
                ["Source", "Process", "Metric", "Normal/Base", "Test/Value", "Result"],
                resultTableRows);
        else
            AddBlock("5. Result Data", "result", BuildAiResultReportLines(doc, sections, showAll));

        var comparisonTableRows = BuildAiComparisonReportTableRows(reportKind, comparisons, showAll);
        if (comparisonTableRows.Count > 0)
            AddTableBlock("6. Normal/Test Comparison", "compare",
                ["Source", "Process", "Comparison", "Normal", "Test", "Change"],
                comparisonTableRows);
        else
            AddBlock("6. Normal/Test Comparison", "compare", BuildAiComparisonReportLines(reportKind, comparisons, showAll));

        AddBlock("7. Decision / Note", "decision",
            (showAll ? doc.Conclusions : doc.Conclusions.Take(5))
                .Select(c =>
                {
                    string topic = AiConclusionTopic(doc, c, lang);
                    string interp = AiConclusionInterp(doc, c, lang);
                    string statement = AiConclusionStatement(doc, c, lang);
                    string detail = !string.IsNullOrWhiteSpace(interp) ? interp : statement;
                    return string.IsNullOrWhiteSpace(topic) ? detail : topic + ": " + detail;
                }));

        AddBlock("8. AI Judgement", "judgement",
            new[] { logRationale }
                .Concat(warnings.Select(w => "Warning: " + w))
                .Concat((showAll ? AiLogAssumptions(doc, lang) : AiLogAssumptions(doc, lang).Take(3)).Select(a => "Assumption: " + a)));

        AddBlock("9. Sheet Coverage", "source",
            BuildAiSheetCoverageReportLines(doc, showAll));

        return blocks;
    }

    private static IEnumerable<string> BuildAiConditionReportLines(AiDocBundle doc, bool showAll)
    {
        IEnumerable<string> query = doc.Results
            .Select(r =>
            {
                var parts = new List<string>();
                if (!string.IsNullOrWhiteSpace(r.ConditionGroup)) parts.Add(r.ConditionGroup);
                if (!string.IsNullOrWhiteSpace(r.ConditionProcess)) parts.Add(r.ConditionProcess);
                if (!string.IsNullOrWhiteSpace(r.ChangedFactor)) parts.Add(r.ChangedFactor);
                if (!string.IsNullOrWhiteSpace(r.BeforeValue) || !string.IsNullOrWhiteSpace(r.AfterValue))
                    parts.Add($"{r.BeforeValue} -> {r.AfterValue}".Trim(' ', '-', '>'));
                if (!string.IsNullOrWhiteSpace(r.ResultDate)) parts.Add(DisplayExcelDate(r.ResultDate));
                if (!string.IsNullOrWhiteSpace(r.Line)) parts.Add(r.Line);
                return string.Join(" | ", parts.Where(x => !string.IsNullOrWhiteSpace(x)));
            })
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase);
        if (!showAll) query = query.Take(8);

        var rows = query.ToList();

        if (rows.Count > 0) return rows;
        if (doc.Processes.Count > 0) return showAll ? doc.Processes : doc.Processes.Take(5);
        if (doc.Parts.Count > 0) return showAll ? doc.Parts : doc.Parts.Take(5);
        return [];
    }

    private static IEnumerable<string> BuildAiResultReportLines(AiDocBundle doc, List<AiProcessReviewSection> sections, bool showAll)
    {
        IEnumerable<string> processQuery = sections
            .SelectMany(s => s.Rows.Select(r =>
                $"{s.Process} / {r.Metric}: Normal {r.BaselineValue}, Test {r.VariantValue}, {r.ResultText}"))
            .Distinct(StringComparer.OrdinalIgnoreCase);
        if (!showAll) processQuery = processQuery.Take(8);
        var processRows = processQuery.ToList();
        if (processRows.Count > 0) return processRows;

        IEnumerable<string> rowQuery = doc.Results
            .Where(r => AiNgRatePercent(r).HasValue || r.MetricValue.HasValue || !string.IsNullOrWhiteSpace(r.Judgement))
            .Select(r =>
            {
                var parts = new List<string>
                {
                    AiProcessFamilyLabel(r) + " / " + AiResultLabel(r),
                    AiMetricLabel(r) + " " + AiResultMainValue(r),
                };
                if (!string.IsNullOrWhiteSpace(r.Judgement)) parts.Add(r.Judgement);
                return string.Join(" | ", parts.Where(x => !string.IsNullOrWhiteSpace(x)));
            })
            .Distinct(StringComparer.OrdinalIgnoreCase);
        if (!showAll) rowQuery = rowQuery.Take(8);
        var rows = rowQuery.ToList();
        if (rows.Count > 0) return rows;

        IEnumerable<AiNgBreakdownSummaryRow> breakdowns = doc.NgBreakdowns;
        if (!showAll) breakdowns = breakdowns.Take(6);
        return breakdowns.Select(b => $"{b.DefectName}: {AiCount(b.TotalCount)} count");
    }

    private static List<AiReportTableRow> BuildAiResultReportTableRows(
        AiDocBundle doc,
        List<AiProcessReviewSection> sections)
    {
        var processRows = sections
            .SelectMany(s => s.Rows.Select(r => new AiReportTableRow
            {
                Cells =
                [
                    r.Source,
                    s.Process,
                    r.Metric,
                    r.BaselineValue,
                    r.VariantValue,
                    r.ResultText,
                ],
                HeatClass = r.HeatClass,
            }))
            .ToList();
        if (processRows.Count > 0) return processRows;

        return doc.Results
            .Where(r => AiNgRatePercent(r).HasValue || r.MetricValue.HasValue || !string.IsNullOrWhiteSpace(r.Judgement))
            .Select(r => new AiReportTableRow
            {
                Cells =
                [
                    AiSourceLabel(r),
                    AiProcessFamilyLabel(r),
                    AiMetricLabel(r),
                    AiResultLabel(r),
                    AiResultMainValue(r),
                    AiJudgementLabel(r),
                ],
                HeatClass = AiJudgementHeatClass(r),
            })
            .ToList();
    }

    private static string AiReportCellClass(int columnCount, int index)
    {
        if (index == columnCount - 1) return "result";
        return index >= 2 ? "n" : "text";
    }

    private static IEnumerable<string> BuildAiComparisonReportLines(string reportKind, List<AiControlComparison> comparisons, bool showAll)
    {
        if (comparisons.Count == 0)
        {
            if (reportKind == "ng_without_baseline")
                return ["No same-event Normal/Baseline was found. Show NG ranking only."];
            return ["No paired Normal/Test comparison was extracted."];
        }

        IEnumerable<AiControlComparison> query = comparisons;
        if (!showAll) query = query.Take(8);
        return query.Select(c =>
            $"{AiComparisonTitle(c)}: {AiPct(AiNgRatePercent(c.Baseline))} -> {AiPct(AiNgRatePercent(c.Variant))}, {AiRateRatioValue(c)}, {AiRelativeChangeText(c)}");
    }

    private static IEnumerable<string> BuildAiSheetCoverageReportLines(AiDocBundle doc, bool showAll)
    {
        var resultSheets = doc.Results
            .GroupBy(r => string.IsNullOrWhiteSpace(r.SheetName) ? "(no sheet)" : r.SheetName.Trim(), StringComparer.OrdinalIgnoreCase)
            .Select(g => new
            {
                Sheet = g.Key,
                ResultCount = g.Count(),
                NgRows = g.Count(r => AiNgRatePercent(r).HasValue),
                MetricRows = g.Count(r => r.MetricValue.HasValue),
            })
            .OrderByDescending(x => x.ResultCount)
            .ThenBy(x => x.Sheet, StringComparer.OrdinalIgnoreCase)
            .ToList();

        IEnumerable<string> lines = resultSheets.Select(x =>
            $"{x.Sheet}: {x.ResultCount:N0} result row(s), {x.NgRows:N0} NG-rate row(s), {x.MetricRows:N0} metric row(s)");

        if (!showAll) lines = lines.Take(8);

        var list = lines.ToList();
        if (list.Count > 0) return list;

        var sourceFiles = doc.Results
            .Select(r => r.SourceFile)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase);
        if (!showAll) sourceFiles = sourceFiles.Take(8);
        return sourceFiles.Select(x => $"Source file: {x}");
    }

    private static List<AiReportTableRow> BuildAiComparisonReportTableRows(
        string reportKind,
        List<AiControlComparison> comparisons,
        bool showAll)
    {
        if (comparisons.Count == 0) return [];
        IEnumerable<AiControlComparison> query = comparisons;
        if (!showAll) query = query.Take(10);
        return query
            .Select(c => new AiReportTableRow
            {
                Cells =
                [
                    AiReviewSourceLabel(c.Variant),
                    AiComparisonProcessLabel(c),
                    AiComparisonPairLabel(c),
                    AiPct(AiNgRatePercent(c.Baseline)),
                    AiPct(AiNgRatePercent(c.Variant)),
                    $"{AiRelativeChangeText(c)} / {AiRateRatioValue(c)}",
                ],
                HeatClass = AiHeatClass(c),
            })
            .ToList();
    }

    private static IEnumerable<string> BuildAiEvidenceReportLines(AiDocBundle doc)
    {
        var lines = new List<string>();
        if (!string.IsNullOrWhiteSpace(doc.SourceFile)) lines.Add("Source file: " + doc.SourceFile);

        string sheets = string.Join(", ", doc.Results
            .Select(r => r.SheetName)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(6));
        if (!string.IsNullOrWhiteSpace(sheets)) lines.Add("Sheets: " + sheets);

        string cells = AiSourceCellsLabel(doc.Results.Take(8).ToArray());
        if (!string.IsNullOrWhiteSpace(cells)) lines.Add("Cells: " + cells);

        lines.AddRange(doc.Conclusions
            .Select(c => string.Join(" | ", new[] { c.SheetName, c.SourceFile }.Where(x => !string.IsNullOrWhiteSpace(x))))
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(4));
        return lines;
    }

    private static string AiConditionChangeSummary(AiDocBundle doc)
    {
        var beforeAfter = doc.Results
            .Select(r => new { r.BeforeValue, r.AfterValue, r.ChangedFactor, r.ConditionProcess })
            .FirstOrDefault(x => !string.IsNullOrWhiteSpace(x.BeforeValue)
                                 || !string.IsNullOrWhiteSpace(x.AfterValue)
                                 || !string.IsNullOrWhiteSpace(x.ChangedFactor));
        if (beforeAfter is not null)
        {
            var parts = new List<string>();
            if (!string.IsNullOrWhiteSpace(beforeAfter.ChangedFactor)) parts.Add(beforeAfter.ChangedFactor);
            if (!string.IsNullOrWhiteSpace(beforeAfter.BeforeValue) || !string.IsNullOrWhiteSpace(beforeAfter.AfterValue))
                parts.Add($"{beforeAfter.BeforeValue} -> {beforeAfter.AfterValue}".Trim(' ', '-', '>'));
            if (!string.IsNullOrWhiteSpace(beforeAfter.ConditionProcess)) parts.Add(beforeAfter.ConditionProcess);
            return string.Join(" | ", parts.Where(x => !string.IsNullOrWhiteSpace(x)));
        }

        if (doc.Processes.Count > 0) return string.Join(", ", doc.Processes.Take(3));
        if (doc.Parts.Count > 0) return string.Join(", ", doc.Parts.Take(3));
        return "-";
    }

    private static string AiResultNumberSummary(
        List<AiControlComparison> comparisons,
        List<AiProcessReviewSection> sections,
        AiDocBundle doc)
    {
        var worst = comparisons.FirstOrDefault(AiIsWorse);
        if (worst is not null)
            return $"{AiComparisonProcessLabel(worst)} {AiPct(AiNgRatePercent(worst.Baseline))} -> {AiPct(AiNgRatePercent(worst.Variant))}";

        var best = comparisons.FirstOrDefault(AiIsImproved);
        if (best is not null)
            return $"{AiComparisonProcessLabel(best)} {AiPct(AiNgRatePercent(best.Baseline))} -> {AiPct(AiNgRatePercent(best.Variant))}";

        var measured = sections.SelectMany(s => s.Rows).FirstOrDefault(r => r.Kind == "measurement");
        if (measured is not null)
            return $"{measured.Process} {measured.Metric}: {measured.BaselineValue} -> {measured.VariantValue}";

        var metric = doc.Results.FirstOrDefault(r => r.MetricValue.HasValue || AiNgRatePercent(r).HasValue);
        if (metric is not null)
            return $"{AiProcessFamilyLabel(metric)} {AiResultMainValue(metric)}";
        return "-";
    }

    private static string AiEffectSummary(string reportKind, List<AiControlComparison> comparisons, AiDocBundle doc)
    {
        if (AiUsesProcessReview(reportKind) && comparisons.Count > 0)
        {
            int worse = comparisons.Count(AiIsWorse);
            int improved = comparisons.Count(AiIsImproved);
            int same = comparisons.Count - worse - improved;
            return $"{improved} improved / {worse} worse / {same} same";
        }

        string conclusion = doc.Conclusions
            .Select(c => c.NormalizedInterpretation)
            .FirstOrDefault(x => !string.IsNullOrWhiteSpace(x)) ?? "";
        if (!string.IsNullOrWhiteSpace(conclusion)) return AiBrief(conclusion, 140);
        return AiReportKindLabel(reportKind);
    }

