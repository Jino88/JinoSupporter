    private static List<string> AiDisplayListItems(string? text)
    {
        string value = CleanExcelSerialDateText(text);
        if (string.IsNullOrWhiteSpace(value) || value == "-") return [];

        string[] rawItems = System.Text.RegularExpressions.Regex.Split(value, @"\s*(?:\||,)\s*");
        return rawItems
            .Select(x => CleanExcelSerialDateText(x).Trim())
            .Where(x => !string.IsNullOrWhiteSpace(x) && x != "-")
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

