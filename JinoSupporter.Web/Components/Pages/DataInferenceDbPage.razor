                                                                    <strong>@AiBrief(AiComparisonTitle(cmp), 52)</strong>
                                                                    <span>@AiComparisonShortContext(cmp)</span>
                                                                </div>
                                                                <em>@AiPct(AiNgRatePercent(cmp.Baseline)) -> @AiPct(AiNgRatePercent(cmp.Variant))</em>
