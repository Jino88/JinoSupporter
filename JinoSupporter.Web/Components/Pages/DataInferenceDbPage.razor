    .didb-ev-down           { color: #065f46; background: #ecfdf5 !important; }
    .didb-ev-up             { color: #991b1b; background: #fef2f2 !important; }
    .didb-ev-flat           { color: #64748b; }
    .didb-ev-range          { font-size: 9px; color: #64748b; font-weight: 500; margin-top: 1px; }

    /* v7 multi-arm */
    .didb-ev-comparisons    { display: flex; flex-direction: column; gap: 3px; }
    .didb-ev-comp           {
        display: flex; align-items: baseline; gap: 6px;
        padding: 2px 5px; border-radius: 3px;
        background: #fff; border: 1px solid #e2e8f0; font-size: 10px;
    }
    .didb-ev-comp.didb-comp-best     { background: #ecfdf5; border-color: #6ee7b7; }
    .didb-ev-comp.didb-comp-worst    { background: #fef2f2; border-color: #fca5a5; }
    .didb-ev-comp.didb-comp-baseline { border-left: 3px solid #4338ca; }
    .didb-ev-comp-label     { font-weight: 600; color: #0f172a; min-width: 90px; }
    .didb-ev-comp-val       { color: #0f172a; }
    .didb-ev-comp-n         { font-size: 9px; color: #94a3b8; }
    .didb-ev-comp-flag {
