                                                                        <td><span class="didb-ai-status @MicroPairEffectClass(pair.Effect)">@pair.Effect</span></td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                    @if (!_aiCardShowAll && aiMicroPairRowsAll.Count > aiMicroPairRows.Count)
                                                    {
                                                        <div class="didb-ai-empty">@((aiMicroPairRowsAll.Count - aiMicroPairRows.Count).ToString("N0")) more pair row(s). Use Show full dashboard.</div>
                                                    }
                                                }
