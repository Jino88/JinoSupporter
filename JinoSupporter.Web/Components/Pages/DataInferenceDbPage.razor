    private static string DetectAiReportKind(AiDocBundle doc, List<AiControlComparison> comparisons, int imageCount)
    {
        string rt = (doc.ReportType ?? "").Trim().ToLowerInvariant();
        if (rt is "normal_comparison" or "ng_without_baseline" or "before_after_dimension"
            or "measurement_spec" or "defect_root_cause" or "lot_supplier_mold_comparison"
            or "process_condition_change" or "reliability_spec" or "doe_matrix" or "image_dependent")
            return rt;

        if ((rt is "comparison_study" or "multi_arm" or "intervention_test") && comparisons.Count > 0)
            return "normal_comparison";
        if (rt is "reliability_validation") return "reliability_spec";
        if (rt is "doe_factorial") return "doe_matrix";

        string text = AiDocKeywordText(doc);
        if (comparisons.Count > 0 && ContainsAny(text, "lot", "supplier", "vender", "vendor", "mold", "lab", "line"))
            return "lot_supplier_mold_comparison";
        if (comparisons.Count > 0 && ContainsAny(text, "jig", "machine", "uv", "dry", "plasma", "bond", "bonding", "press", "laser", "material", "condition"))
            return "process_condition_change";
        if (comparisons.Count > 0) return "normal_comparison";
        if (ContainsAny(text, "root cause", "cause", "reason", "phenomenon", "defect", "troubleshooting", "analysis")
            && (doc.Hints.Count > 0 || doc.Conclusions.Count > 0))
            return "defect_root_cause";
        if (ContainsAny(text, "reliability", "aging", "humidity", "humid", "thermal", "spl", "thd", "impedance", "imp"))
            return "reliability_spec";
        if ((text.Contains("before after", StringComparison.OrdinalIgnoreCase)
             || (ContainsAny(text, "before") && ContainsAny(text, "after"))
             || ContainsAny(text, "dimension", "gap", "inner", "outer", "offset"))
            && (BuildAiMetricRows(doc, IsAiDimensionMetric).Count > 0 || BuildAiMetricComparisons(doc, IsAiDimensionMetric).Count > 0))
            return "before_after_dimension";
        if (ContainsAny(text, "doe", "factorial", "matrix", "condition") && BuildAiDoeRows(doc).Count >= 3)
            return "doe_matrix";
        if (imageCount > 0 && (ContainsAny(text, "image", "photo", "picture", "xray", "x-ray") || doc.Results.Count == 0))
            return "image_dependent";
        if (BuildAiAbsoluteNgRows(doc).Count > 0) return "ng_without_baseline";
        if (imageCount > 0) return "image_dependent";
        return "general_summary";
    }

