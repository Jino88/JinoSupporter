    /* v2 — Evidence table: Excel-grid styling */
    .didb-evidence-wrap { margin: 6px 0 10px; overflow-x: auto; }
    .didb-evidence {
        border-collapse: collapse;
        font-size: 11px; width: 100%;
        font-variant-numeric: tabular-nums;
        background: #fff;
    }
    .didb-evidence th, .didb-evidence td {
        border: 1px solid #cbd5e1;
        padding: 5px 9px;
        text-align: left;
        vertical-align: top;
    }
    .didb-evidence thead th {
        background: #e2e8f0;
        color: #1e293b;
        font-size: 9px; font-weight: 700;
        text-transform: uppercase; letter-spacing: .04em;
        border-color: #94a3b8;
    }
    .didb-evidence tbody tr:nth-child(even) td { background: #f8fafc; }
    .didb-evidence td.n     { text-align: right; }
    .didb-ev-metric         { font-weight: 600; color: #0f172a; min-width: 130px; }
    .didb-ev-label          { display: block; font-size: 9px; color: #64748b; margin-bottom: 1px; }
    .didb-ev-val            { display: block; color: #0f172a; font-weight: 500; }
