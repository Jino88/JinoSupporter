        border-bottom: 1px solid #e2e8f0; padding: 7px 10px; text-align: left;
    }
    .didb-table thead th {
        background: #f1f5f9; font-weight: 600; color: #475569;
        position: sticky; top: 0; z-index: 1;
    }
    .didb-row        { cursor: pointer; transition: background .1s; }
    .didb-row:hover  { background: #f1f5f9; }
    .didb-row-open   { background: #f0f9ff; }
    .didb-caret      { color: #94a3b8; font-size: 11px; width: 28px; text-align: center; }
    .didb-date       { font-size: 11px; color: #94a3b8; }
    td.n             { text-align: right; font-variant-numeric: tabular-nums; }
    .didb-set-pt     { color: #2563eb; cursor: pointer; font-size: 12px;
                       text-decoration: underline dashed; text-underline-offset: 3px; }
    .didb-set-pt:hover { color: #1d4ed8; text-decoration: underline solid; }
    .didb-pt-text    { cursor: pointer; }
    .didb-pt-text:hover { text-decoration: underline dotted; color: #1d4ed8; }
    .didb-pt-input   { height: 26px; font-size: 12px; min-width: 180px; max-width: 260px; }

    .didb-detail-row td { padding: 0 !important; background: #f8fafc; border-top: none; }
    .didb-summary    {
        padding: 8px 16px 8px 40px; font-size: 12px; color: #334155;
        background: #f0f9ff; border-bottom: 1px solid #bae6fd;
    }
    .didb-lang-row   { display: inline-flex; gap: 4px; margin-bottom: 6px; }
    .didb-lang       {
        border: 1px solid #cbd5e1; background: #fff; color: #475569;
        padding: 1px 9px; border-radius: 11px; font-size: 10px; font-weight: 600;
        cursor: pointer; transition: all .12s; line-height: 1.5;
    }
    .didb-lang:hover  { background: #e0f2fe; border-color: #38bdf8; }
    .didb-lang.active { background: #4338ca; border-color: #4338ca; color: #fff; }

    /* Compact AI card — default view in the expanded row */
    .didb-verdict-row {
        display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
        margin-bottom: 8px;
    }
    .didb-verdict {
        font-size: 10px; font-weight: 800; letter-spacing: .05em;
        padding: 2px 10px; border-radius: 11px; white-space: nowrap;
        text-transform: uppercase;
    }

    /* ───────────────── v2 Dashboard (side panel) ───────────────── */
    .didb-dash {
        display: grid; grid-template-columns: 220px 1fr; gap: 14px;
        align-items: start;
    }
    @@media (max-width: 900px) {
        .didb-dash { grid-template-columns: 1fr; }
    }
    .didb-dash-side {
        padding: 12px 14px; background: linear-gradient(180deg,#f8fafc 0%,#eef2ff 100%);
