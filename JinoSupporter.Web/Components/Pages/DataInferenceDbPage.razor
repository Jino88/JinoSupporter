                                                                <div class="didb-ai-bar-label">
                                                                    <strong>@AiBrief(b.DefectName, 42)</strong>
                                                                    <span>@b.RowCount.ToString("N0") rows</span>
                                                                </div>
                                                                <div class="didb-ai-bar-track">
                                                                    <div class="didb-ai-bar didb-ai-bar-teal" style="@($"width:{width:F1}%")"></div>
                                                                </div>
                                                                <div class="didb-ai-bar-value">@AiCount(b.TotalCount) <small>@share.ToString("F1")%</small></div>
                                                            </div>
                                                        }
                                                    }
                                                }
                                            </section>
                                        </div>

                                            <div class="didb-ai-grid">
                                                <section class="didb-ai-panel didb-ai-panel-wide">
                                                <h3>AI Conclusions</h3>
                                                <div class="didb-ai-findings">
                                                    @foreach (var c in aiConclusions)
                                                    {
                                                        <article>
                                                            <div class="didb-ai-finding-topic" title="@AiConclusionTopic(doc, c, aiLang)">@AiBrief(AiConclusionTopic(doc, c, aiLang), 54)</div>
                                                            <p title="@AiConclusionInterp(doc, c, aiLang)">@AiBrief(AiConclusionInterp(doc, c, aiLang), _aiCardShowAll ? 420 : 150)</p>
                                                            @if (_aiCardShowAll && !string.IsNullOrEmpty(AiConclusionStatement(doc, c, aiLang)))
                                                            {
                                                                <blockquote>@AiConclusionStatement(doc, c, aiLang)</blockquote>
                                                            }
                                                        </article>
                                                    }
                                                </div>
                                            </section>

                                            <section class="didb-ai-panel">
                                                <h3>Suggested Checks</h3>
                                                <table class="didb-ai-checks">
                                                    <tbody>
                                                        @foreach (var h in aiHints)
                                                        {
                                                            <tr>
                                                                <td><span class="didb-ai-strength @AiEvidenceStrengthClass(h.EvidenceStrength)">@AiEvidenceStrengthLabel(h.EvidenceStrength)</span></td>
                                                                <td>
                                                                    <strong title="@AiHintCheck(doc, h, aiLang)">@AiBrief(AiHintCheck(doc, h, aiLang), 70)</strong>
                                                                    <div title="@AiHintReason(doc, h, aiLang)">@AiBrief(AiHintReason(doc, h, aiLang), _aiCardShowAll ? 360 : 120)</div>
                                                                    <span>@h.RelatedProcess @(!string.IsNullOrEmpty(h.RelatedPart) ? $"· {h.RelatedPart}" : "")</span>
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </section>
                                            </div>
                                        }

                                        @if (_aiCardShowAll)
                                        {
                                            <div class="didb-ai-grid">
                                                <section class="didb-ai-panel">
                                                    <h3>Campaign Scope</h3>
                                                    <ul class="didb-ai-list">
                                                        @foreach (var item in aiContent)
                                                        {
                                                            <li>@item</li>
                                                        }
                                                    </ul>
                                                    <div class="didb-ai-tags">
                                                        @foreach (var x in doc.RelatedDefects.Take(12))
                                                        {
                                                            <span>@x</span>
                                                        }
                                                    </div>
                                                </section>
                                                <section class="didb-ai-panel">
                                                    <h3>Parts / Processes</h3>
                                                    <div class="didb-ai-tags">
                                                        @foreach (var x in doc.Parts.Take(12))
                                                        {
                                                            <span>@x</span>
                                                        }
                                                    </div>
                                                    <div class="didb-ai-tags didb-ai-tags-spaced">
                                                        @foreach (var x in doc.Processes.Take(12))
                                                        {
                                                            <span>@x</span>
                                                        }
                                                    </div>
                                                </section>
                                            </div>

                                            @if (!string.IsNullOrEmpty(logRationale) || aiAssumptions.Count > 0 || aiWarnings.Count > 0)
                                            {
                                                <section class="didb-ai-panel didb-ai-full">
                                                    <h3>Decision Rationale</h3>
                                                    @if (!string.IsNullOrEmpty(logRationale))
                                                    {
                                                        <p>@CleanExcelSerialDateText(logRationale)</p>
                                                    }
                                                    <div class="didb-ai-grid didb-ai-log-grid">
                                                        <div>
                                                            <h3>Assumptions</h3>
                                                            <ul class="didb-ai-list">
                                                                @foreach (var x in aiAssumptions)
                                                                {
                                                                    <li>@CleanExcelSerialDateText(x)</li>
                                                                }
                                                            </ul>
                                                        </div>
                                                        <div>
                                                            <h3>Warnings</h3>
                                                            <ul class="didb-ai-list">
                                                                @foreach (var x in aiWarnings)
                                                                {
                                                                    <li>@CleanExcelSerialDateText(x)</li>
                                                                }
                                                            </ul>
                                                        </div>
                                                    </div>
                                                </section>
                                            }
                                        }

                                        <button class="didb-show-details didb-ai-more" @onclick="() => _aiCardShowAll = !_aiCardShowAll" @onclick:stopPropagation="true">
                                            @(_aiCardShowAll
                                                ? (aiHasGeneratedReport ? "Hide original report and DB parameters" : "Hide dashboard detail")
                                                : (aiHasGeneratedReport
                                                    ? $"Show original AI report + DB parameters ({doc.Results.Count} results, {doc.Results.Select(x => x.SheetName).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).Count()} sheets)"
                                                    : $"Show full dashboard ({doc.Results.Count} results, {doc.Results.Select(x => x.SheetName).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).Count()} sheets)"))
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            }
                        }

                        <!-- Summary row (legacy DatasetSummary card) -->
                        @if (_expandedSummary is not null)
                        {
                            <tr class="didb-detail-row">
                                <td colspan="10" style="padding:0;">
                                    <div class="didb-summary">
                                        @* Language pills — only render once per row.
                                           "en" is always offered (the original AI output).
                                           ko/vi only appear if the translations table has them. *@
                                        <div class="didb-lang-row">
                                            @foreach (var (code, label) in LangsFor(_expandedSummary))
                                            {
                                                <button class="didb-lang @(code == _dbLang ? "active" : "")"
                                                        @onclick="() => _dbLang = code"
                                                        @onclick:stopPropagation="true">@label</button>
                                            }
                                        </div>
                                        @{
                                            bool hasV2db = !string.IsNullOrWhiteSpace(_expandedSummary.Verdict)
                                                         || !string.IsNullOrWhiteSpace(_expandedSummary.Headline)
                                                         || _expandedSummary.Evidence.Count > 0
                                                         || _expandedSummary.Actions.Count  > 0;

                                            // Pre-resolve everything here so the if-bodies below contain
                                            // only markup (Razor disallows `@{ ... }` as the first non-markup
                                            // token inside an `@if { … }` body).
                                            string vHeadlineDb = hasV2db ? LangHeadlineDb() : "";
                                            var    vActionsDb  = hasV2db ? LangActionsDb()  : new List<ActionItem>();
                                            AnalysisContext? vCtxDb = hasV2db ? LangContextDb() : null;
                                            (string dbV2Verdict, string dbV2VerdictClass) =
                                                hasV2db ? VerdictLabel(_expandedSummary.Verdict) : ("", "");

                                            string dbLgSummary           = !hasV2db ? LangText(s => s.Summary,           _expandedSummary.Summary)           : "";
                                            string dbLgPurpose           = !hasV2db ? LangText(s => s.Purpose,           _expandedSummary.Purpose)           : "";
                                            string dbLgTestConditions    = !hasV2db ? LangText(s => s.TestConditions,    _expandedSummary.TestConditions)    : "";
                                            string dbLgKeyFindings       = !hasV2db ? LangText(s => s.KeyFindings,       _expandedSummary.KeyFindings)       : "";
                                            string dbLgDecision          = !hasV2db ? LangText(s => s.Decision,          _expandedSummary.Decision)          : "";
                                            string dbLgRootCause         = !hasV2db ? LangText(s => s.RootCause,         _expandedSummary.RootCause)         : "";
                                            string dbLgRecommendedAction = !hasV2db ? LangText(s => s.RecommendedAction, _expandedSummary.RecommendedAction) : "";
                                            (string dbLgVerdict, string dbLgVerdictClass) =
                                                !hasV2db ? ParseVerdict(dbLgDecision) : ("", "");

                                            var dbTopNumbers = !hasV2db ? TakeBullets(dbLgKeyFindings, 3).ToList() : new List<string>();
                                            var dbTopActions = !hasV2db ? TakeBullets(dbLgRecommendedAction, 2).ToList() : new List<string>();

                                            EvidenceRow? heroDb = hasV2db && _expandedSummary.Evidence.Count > 0 ? _expandedSummary.Evidence[0] : null;
                                            bool anyNoteDb      = hasV2db && _expandedSummary.Evidence.Take(4).Any(e => !string.IsNullOrEmpty(e.Note));

                                            string  rtDb        = hasV2db ? (_expandedSummary.ReportType ?? "").Trim().ToLowerInvariant() : "";
                                            bool    isDoeDb     = rtDb == "doe_factorial";
                                            bool    isTrendDb   = rtDb == "trend_analysis";
                                            bool    isLogDb     = rtDb == "quality_log";
                                            (string rtLabelDb, string rtClassDb) = ReportTypeBadge(_expandedSummary.ReportType);
                                        }
                                        @if (hasV2db)
                                        {
                                            <div class="didb-dash">
                                                <aside class="didb-dash-side">
                                                    @if (!isLogDb && !string.IsNullOrEmpty(dbV2Verdict))
                                                    {
                                                        <span class="didb-verdict didb-verdict-lg @dbV2VerdictClass">@dbV2Verdict</span>
                                                    }
                                                    @if (!string.IsNullOrEmpty(rtLabelDb))
                                                    {
                                                        <span class="didb-rt-badge @rtClassDb" title="Report type">@rtLabelDb</span>
                                                    }
                                                    @if (heroDb is not null && !isLogDb)
                                                    {
                                                        <div class="didb-kpi-hero">
                                                            <div class="didb-kpi-value @DeltaClass(heroDb.DeltaSign)">@heroDb.DeltaText</div>
                                                            <div class="didb-kpi-label">@heroDb.Metric</div>
                                                        </div>
                                                    }
                                                    <div class="didb-kpi-meta">
                                                        <div><span class="didb-kpi-meta-n">@_expandedSummary.Evidence.Count</span> metrics</div>
                                                        <div><span class="didb-kpi-meta-n">@_expandedSummary.Actions.Count</span> actions</div>
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(vHeadlineDb))
                                                    {
                                                        <div class="didb-dash-headline">@vHeadlineDb</div>
                                                    }
                                                    @if (_expandedSummary.Tags.Count > 0)
                                                    {
                                                        <div class="didb-tags-row didb-tags-side">
                                                            @foreach (var t in _expandedSummary.Tags)
                                                            {
                                                                <span class="didb-tag didb-tag-keyword">
                                                                    🏷 @t
                                                                    <button class="didb-tag-del" title="Remove tag"
                                                                            @onclick="() => RemoveTag(r.DatasetName, t)"
                                                                            @onclick:stopPropagation="true">✕</button>
                                                                </span>
                                                            }
                                                        </div>
                                                    }
                                                </aside>
                                                <main class="didb-dash-main">
                                                    @if (_expandedSummary.Evidence.Count > 0)
                                                    {
                                                        <div class="didb-dash-section-title">📊 Evidence</div>
                                                        <div class="didb-evidence-wrap">
                                                            <table class="didb-evidence">
                                                                <thead>
                                                                    <tr>
                                                                        <th>Metric</th>
                                                                        <th>Baseline</th>
                                                                        <th>Variant</th>
                                                                        <th class="n">Δ</th>
                                                                        @if (anyNoteDb) { <th>Note</th> }
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var ev in _expandedSummary.Evidence.Take(4))
                                                                    {
                                                                        @if (ev.Comparisons is { Count: > 0 })
                                                                        {
                                                                            <tr>
                                                                                <td class="didb-ev-metric">
                                                                                    @ev.Metric
                                                                                    @if (!string.IsNullOrEmpty(ev.DeltaText))
                                                                                    {
                                                                                        <div class="didb-ev-range">@ev.DeltaText</div>
                                                                                    }
                                                                                </td>
                                                                                <td colspan="@(anyNoteDb ? 4 : 3)">
                                                                                    <div class="didb-ev-comparisons">
                                                                                        @foreach (var c in ev.Comparisons)
                                                                                        {
                                                                                            <div class="didb-ev-comp @(c.IsBest?"didb-comp-best":"") @(c.IsWorst?"didb-comp-worst":"") @(c.IsBaseline?"didb-comp-baseline":"")">
                                                                                                <span class="didb-ev-comp-label">@c.Label</span>
                                                                                                <span class="didb-ev-comp-val">@c.Value</span>
                                                                                                @if (c.N > 0) { <span class="didb-ev-comp-n">n=@c.N</span> }
                                                                                                @if (c.IsBaseline) { <span class="didb-ev-comp-flag baseline">base</span> }
                                                                                                @if (c.IsBest)     { <span class="didb-ev-comp-flag best">best</span> }
                                                                                                @if (c.IsWorst)    { <span class="didb-ev-comp-flag worst">worst</span> }
                                                                                            </div>
                                                                                        }
                                                                                    </div>
                                                                                </td>
                                                                            </tr>
                                                                        }
                                                                        else
                                                                        {
                                                                            <tr>
                                                                                <td class="didb-ev-metric">@ev.Metric</td>
                                                                                <td>
                                                                                    @if (!string.IsNullOrEmpty(ev.BaselineLabel))
                                                                                    {
                                                                                        <div class="didb-ev-label">@ev.BaselineLabel</div>
                                                                                    }
                                                                                    <div class="didb-ev-val">@ev.BaselineValue</div>
                                                                                </td>
                                                                                <td>
                                                                                    @if (!string.IsNullOrEmpty(ev.VariantLabel))
                                                                                    {
                                                                                        <div class="didb-ev-label">@ev.VariantLabel</div>
                                                                                    }
                                                                                    <div class="didb-ev-val">@ev.VariantValue</div>
                                                                                </td>
                                                                                <td class="n didb-ev-delta @DeltaClass(ev.DeltaSign)">@ev.DeltaText</td>
                                                                                @if (anyNoteDb)
                                                                                {
                                                                                    <td class="didb-ev-note-cell">@ev.Note</td>
                                                                                }
                                                                            </tr>
                                                                        }
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    }

                                                    @if (isDoeDb && _expandedSummary.DoeGrid is not null && _expandedSummary.DoeGrid.Factor1Levels.Count > 0 && _expandedSummary.DoeGrid.Factor2Levels.Count > 0)
                                                    {
                                                        <div class="didb-dash-section-title">🔬 DOE — @_expandedSummary.DoeGrid.Factor1Name × @_expandedSummary.DoeGrid.Factor2Name</div>
                                                        <div class="didb-doe-wrap">
                                                            <table class="didb-doe">
                                                                <thead>
                                                                    <tr>
                                                                        <th></th>
                                                                        @foreach (var f2 in _expandedSummary.DoeGrid.Factor2Levels)
                                                                        {
                                                                            <th>@(_expandedSummary.DoeGrid.Factor2Name)=@f2</th>
                                                                        }
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var f1 in _expandedSummary.DoeGrid.Factor1Levels)
                                                                    {
                                                                        <tr>
                                                                            <th>@(_expandedSummary.DoeGrid.Factor1Name)=@f1</th>
                                                                            @foreach (var f2 in _expandedSummary.DoeGrid.Factor2Levels)
                                                                            {
                                                                                var cell = _expandedSummary.DoeGrid.Cells.FirstOrDefault(c => c.F1 == f1 && c.F2 == f2);
                                                                                var status = (cell?.Status ?? "empty").ToLowerInvariant();
                                                                                <td class="didb-doe-cell didb-doe-@status" title="@cell?.Value">
                                                                                    @(cell?.Value ?? "—")
                                                                                </td>
                                                                            }
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    }

                                                    @if (isTrendDb && _expandedSummary.TrendPoints is { Count: > 0 })
                                                    {
                                                        <div class="didb-dash-section-title">📈 Trend</div>
                                                        <ol class="didb-trend">
                                                            @foreach (var p in _expandedSummary.TrendPoints.Take(12))
                                                            {
                                                                <li>
                                                                    <span class="didb-trend-label">@p.Label</span>
                                                                    <span class="didb-trend-value">@p.Value</span>
                                                                    @if (!string.IsNullOrEmpty(p.Note))
                                                                    {
                                                                        <span class="didb-trend-note">@p.Note</span>
                                                                    }
                                                                </li>
                                                            }
                                                        </ol>
                                                    }

                                                    @if (vActionsDb.Count > 0)
                                                    {
                                                        <div class="didb-dash-section-title">✅ Actions</div>
                                                        <ol class="didb-actions">
                                                            @foreach (var a in vActionsDb.OrderBy(x => x.Priority).Take(3))
                                                            {
                                                                <li class="didb-action-@(a.Kind?.ToLowerInvariant() ?? "action")">
                                                                    <span class="didb-action-kind">@KindGlyph(a.Kind)</span>
                                                                    <span class="didb-action-text">@a.Text</span>
                                                                </li>
                                                            }
                                                        </ol>
                                                    }

                                                    @if (vCtxDb is not null &&
                                                         (!string.IsNullOrEmpty(vCtxDb.Process) ||
                                                          !string.IsNullOrEmpty(vCtxDb.Stage)   ||
                                                          !string.IsNullOrEmpty(vCtxDb.BaselineReason)))
                                                    {
                                                        <button class="didb-show-details"
                                                                @onclick="ToggleContext"
                                                                @onclick:stopPropagation="true">
                                                            @(_showContextDb ? "▴ Hide context" : "▾ Context")
                                                        </button>
                                                        @if (_showContextDb)
                                                        {
                                                            <dl class="didb-context">
                                                                @if (!string.IsNullOrEmpty(vCtxDb.Process))
                                                                {
                                                                    <dt>Process</dt><dd>@vCtxDb.Process</dd>
                                                                }
                                                                @if (!string.IsNullOrEmpty(vCtxDb.Stage))
                                                                {
                                                                    <dt>Stage</dt><dd>@vCtxDb.Stage</dd>
                                                                }
                                                                @if (!string.IsNullOrEmpty(vCtxDb.BaselineReason))
                                                                {
                                                                    <dt>Baseline</dt><dd>@vCtxDb.BaselineReason</dd>
                                                                }
                                                            </dl>
                                                        }
                                                    }
                                                </main>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="didb-verdict-row">
                                                @if (!string.IsNullOrEmpty(dbLgVerdict))
                                                {
                                                    <span class="didb-verdict @dbLgVerdictClass">@dbLgVerdict</span>
                                                }
                                                @if (!string.IsNullOrEmpty(dbLgSummary))
                                                {
                                                    <span class="didb-card-conclusion">@dbLgSummary</span>
                                                }
                                            </div>
                                            @if (dbTopNumbers.Count > 0)
                                            {
                                                <ul class="didb-card-list">
                                                    @foreach (var b in dbTopNumbers) { <li>@b</li> }
                                                </ul>
                                            }
                                            @if (dbTopActions.Count > 0)
                                            {
                                                <ul class="didb-card-list didb-card-actions">
                                                    @foreach (var b in dbTopActions) { <li>@b</li> }
                                                </ul>
                                            }
                                            <button class="didb-show-details"
                                                    @onclick="ToggleFullSummary"
                                                    @onclick:stopPropagation="true">
                                                @(_showFullSummary ? "▴ Hide details" : "▾ Show details (legacy view)")
                                            </button>
                                            @if (_showFullSummary)
                                            {
                                                @if (!string.IsNullOrEmpty(dbLgPurpose))
                                                {
                                                    <div class="didb-section">
                                                        <div class="didb-sec-label">① Test Goal</div>
                                                        <pre class="didb-sec-body">@dbLgPurpose</pre>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrEmpty(dbLgTestConditions))
                                                {
                                                    <div class="didb-section didb-section-setup">
                                                        <div class="didb-sec-label">② Comparison Setup</div>
                                                        <pre class="didb-sec-body">@dbLgTestConditions</pre>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrEmpty(dbLgKeyFindings))
                                                {
                                                    <div class="didb-section">
                                                        <div class="didb-sec-label">③ Key Numbers (full)</div>
                                                        <pre class="didb-sec-body">@dbLgKeyFindings</pre>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrEmpty(dbLgDecision))
                                                {
                                                    <div class="didb-section didb-section-effect">
                                                        <div class="didb-sec-label">④ Effect</div>
                                                        <pre class="didb-sec-body">@dbLgDecision</pre>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrEmpty(dbLgRootCause))
                                                {
                                                    <div class="didb-section">
                                                        <div class="didb-sec-label">⑤ Motivation / Cause</div>
                                                        <pre class="didb-sec-body">@dbLgRootCause</pre>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrEmpty(dbLgRecommendedAction))
                                                {
                                                    <div class="didb-section">
                                                        <div class="didb-sec-label">⑥ Actions / Risks (full)</div>
                                                        <pre class="didb-sec-body">@dbLgRecommendedAction</pre>
                                                    </div>
                                                }
                                            }
                                        }
                                        @if (!hasV2db && _expandedSummary.Tags.Count > 0)
                                        {
                                            @* v2 dashboard renders tags in the side aside. *@
                                            <div class="didb-tags-row">
                                                @foreach (var t in _expandedSummary.Tags)
                                                {
                                                    <span class="didb-tag didb-tag-keyword">
                                                        🏷 @t
                                                        <button class="didb-tag-del" title="Remove tag"
                                                                @onclick="() => RemoveTag(r.DatasetName, t)"
                                                                @onclick:stopPropagation="true">✕</button>
                                                    </span>
                                                }
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        @* Heatmap row — Line × CheckType → avg NG%. Computed
                           locally from _expandedMeasurements; not AI-generated.
                           Skip 1×N / N×1 matrices (a "heatmap" of a single
                           column is just a list). Collapsed by default. *@
                        @if (_corrCells.Count > 0 && _corrLines.Count >= 2 && _corrCheckTypes.Count >= 2)
                        {
                            <tr class="didb-detail-row">
                                <td colspan="10" style="padding:0;">
                                    <div class="didb-summary">
                                        <button class="didb-section-toggle"
                                                @onclick="() => _showHeatmap = !_showHeatmap"
                                                @onclick:stopPropagation="true">
                                            <span>🌡 @_corrRowLabel × @_corrColLabel — avg NG%</span>
                                            <span class="didb-section-arrow">@(_showHeatmap ? "▴" : "▾")</span>
                                        </button>
                                        @if (_showHeatmap)
                                        {
                                        <div class="didb-section">
                                            <div style="overflow-x:auto;">
                                                <table class="didb-heatmap">
                                                    <thead>
                                                        <tr>
                                                            <th></th>
                                                            @foreach (var c in _corrCheckTypes)
                                                            {
                                                                <th>@c</th>
                                                            }
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var line in _corrLines)
                                                        {
                                                            <tr>
                                                                <th>@line</th>
                                                                @foreach (var c in _corrCheckTypes)
                                                                {
                                                                    var key = (line, c);
                                                                    if (_corrCells.TryGetValue(key, out var v))
                                                                    {
                                                                        <td title="@v.RowCount measurement row(s)" style="background:@HeatColor(v.AvgNg);">
                                                                            <div class="didb-heat-pct">@v.AvgNg.ToString("F1")%</div>
                                                                            <div class="didb-heat-ratio">(@v.NgSum.ToString("N0")/@v.InputSum.ToString("N0"))</div>
                                                                            @if (v.Defects.Count > 1)
                                                                            {
                                                                                <div class="didb-heat-defects">
                                                                                    @foreach (var d in v.Defects.Take(5))
                                                                                    {
                                                                                        <div>@d.Type: @d.Count.ToString("N0")</div>
                                                                                    }
                                                                                    @if (v.Defects.Count > 5)
                                                                                    {
                                                                                        <div>+@(v.Defects.Count - 5) more</div>
                                                                                    }
                                                                                </div>
                                                                            }
                                                                        </td>
                                                                    }
                                                                    else
                                                                    {
                                                                        <td class="didb-heat-empty">—</td>
                                                                    }
                                                                }
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                            <div class="didb-heat-legend">
                                                <span style="background:@HeatColor(0.0);">0%</span>
                                                <span style="background:@HeatColor(2.5);">2.5%</span>
                                                <span style="background:@HeatColor(5.0);">5%</span>
                                                <span style="background:@HeatColor(10.0);">10%+</span>
                                            </div>
                                        </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        <!-- Measurements sub-table -->
                        @if (_expandedMeasurements.Count > 0)
                        {
                            <tr class="didb-detail-row">
                                <td colspan="10" style="padding:0;">
                                    <div class="didb-sub-wrap">
                                        <button class="didb-section-toggle"
                                                @onclick="() => _showMeasurements = !_showMeasurements"
                                                @onclick:stopPropagation="true">
                                            <span>📐 Extracted Measurements — @_expandedMeasurements.Count row(s)</span>
                                            <span class="didb-section-arrow">@(_showMeasurements ? "▴" : "▾")</span>
                                        </button>
                                        @if (_showMeasurements)
                                        {
                                        <table class="didb-sub">
                                            <thead>
                                                <tr>
                                                    <th>Variable</th>
                                                    <th>Group</th>
                                                    <th>Line</th>
                                                    <th>CheckType</th>
                                                    <th>Input</th>
                                                    <th>NG</th>
                                                    <th>NG%</th>
                                                    <th>Defect Type</th>
                                                    <th>Category</th>
                                                    <th>Count</th>
                                                    <th>Intervention</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var m in _expandedMeasurements)
                                                {
                                                    <tr>
                                                        @RenderEditable(m, "Variable",       m.Variable)
                                                        @RenderEditable(m, "VariableGroup",  m.VariableGroup)
                                                        @RenderEditable(m, "Line",           m.Line)
                                                        @RenderEditable(m, "CheckType",      m.CheckType)
                                                        @RenderEditable(m, "InputQty",       m.InputQty.ToString(), numeric:true)
                                                        @RenderEditable(m, "NgTotal",        m.NgTotal.ToString(),  numeric:true)
                                                        @RenderEditable(m, "NgRate",         m.NgRate.ToString("F1") + "%", numeric:true)
                                                        @RenderEditable(m, "DefectType",     m.DefectType)
                                                        @RenderEditable(m, "DefectCategory", m.DefectCategory)
                                                        @RenderEditable(m, "DefectCount",    m.DefectCount.ToString(), numeric:true)
                                                        @RenderEditable(m, "Intervention",   m.Intervention)
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        else if (_expandedMeasurements.Count == 0 && _expanded == r.DatasetName)
                        {
                            <tr class="didb-detail-row">
                                <td colspan="10">
                                    <div style="padding:8px 16px; font-size:12px; color:#94a3b8; font-style:italic;">
                                        No normalized measurements — run Analyze on Input Data, then Save.
                                    </div>
                                </td>
                            </tr>
                        }

                        @* Source text comparison — OCR markdown vs Excel paste ground truth.
                           Collapsed by default: it's debug context, not decision data. *@
                        @if (_expanded == r.DatasetName
                             && (!string.IsNullOrWhiteSpace(_expandedOcrText)
                                 || !string.IsNullOrWhiteSpace(_expandedExcelPaste)))
                        {
                            <tr class="didb-detail-row">
                                <td colspan="10" style="padding:0;">
                                    <button class="didb-section-toggle"
                                            @onclick="() => _showSource = !_showSource"
                                            @onclick:stopPropagation="true">
                                        <span>📝 Source Text</span>
                                        <span class="didb-section-arrow">@(_showSource ? "▴" : "▾")</span>
                                    </button>
                                    @if (_showSource)
                                    {
                                    <div class="didb-src-wrap">
                                        <div class="didb-src-head">
                                            <span class="didb-src-title">📝 Source Text</span>
                                            <div class="didb-src-tabs">
                                                <button class="didb-src-tab @(_sourceView == "ocr" ? "active" : "")"
                                                        @onclick='() => SetSourceView("ocr")'
                                                        disabled="@string.IsNullOrWhiteSpace(_expandedOcrText)">
                                                    OCR markdown
                                                    @if (!string.IsNullOrWhiteSpace(_expandedOcrText))
                                                    { <span class="didb-src-len">@_expandedOcrText.Length</span> }
                                                    else { <span class="didb-src-missing">—</span> }
                                                </button>
                                                <button class="didb-src-tab @(_sourceView == "excel" ? "active" : "")"
                                                        @onclick='() => SetSourceView("excel")'
                                                        disabled="@string.IsNullOrWhiteSpace(_expandedExcelPaste)">
                                                    Excel paste
                                                    @if (!string.IsNullOrWhiteSpace(_expandedExcelPaste))
                                                    { <span class="didb-src-len">@_expandedExcelPaste.Length</span> }
                                                    else { <span class="didb-src-missing">—</span> }
                                                </button>
                                                <button class="didb-src-tab @(_sourceView == "split" ? "active" : "")"
                                                        @onclick='() => SetSourceView("split")'
                                                        disabled="@(string.IsNullOrWhiteSpace(_expandedOcrText) || string.IsNullOrWhiteSpace(_expandedExcelPaste))">
                                                    Split compare
                                                </button>
                                            </div>
                                        </div>
                                        @* Show the Excel paste TSV with a Table/Text view toggle (same
                                           UX as Data Input). For OCR markdown / split comparison the
                                           plain <pre> stays — markdown isn't TSV. *@
                                        @{
                                            bool showExcelTable =
                                                (_sourceView == "excel" || (_sourceView != "split" && _sourceView != "ocr"))
                                                && !string.IsNullOrWhiteSpace(_expandedExcelPaste);
                                        }
                                        @if (showExcelTable)
                                        {
                                            <div class="didb-view-toggle">
                                                <button class="didb-view-btn @(_excelView == "table" ? "active" : "")"
                                                        @onclick='() => _excelView = "table"'>📊 Table</button>
                                                <button class="didb-view-btn @(_excelView == "text" ? "active" : "")"
                                                        @onclick='() => _excelView = "text"'>📝 Text</button>
                                            </div>
                                        }
                                        @if (_sourceView == "split"
                                             && !string.IsNullOrWhiteSpace(_expandedOcrText)
                                             && !string.IsNullOrWhiteSpace(_expandedExcelPaste))
                                        {
                                            <div class="didb-src-split">
                                                <div class="didb-src-pane">
                                                    <div class="didb-src-pane-label">OCR markdown</div>
                                                    <pre class="didb-src-pre">@_expandedOcrText</pre>
                                                </div>
                                                <div class="didb-src-pane">
                                                    <div class="didb-src-pane-label">Excel paste (ground truth)</div>
                                                    <pre class="didb-src-pre">@_expandedExcelPaste</pre>
                                                </div>
                                            </div>
                                        }
                                        else if (showExcelTable && _excelView == "table")
                                        {
                                            <div class="didb-table-preview">
                                                @foreach (var (name, rows) in ParsePastedTsv(_expandedExcelPaste))
                                                {
                                                    <div class="didb-sheet-name">📑 @name</div>
                                                    <div style="overflow-x:auto;">
                                                        <table class="didb-preview-table">
                                                            <tbody>
                                                                @foreach (var row in rows)
                                                                {
                                                                    <tr>
                                                                        @foreach (var cell in row)
                                                                        {
                                                                            <td style="@CellStyle(cell)">@CleanExcelSerialDateText(cell.Value)</td>
                                                                        }
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else if (_sourceView == "excel" && !string.IsNullOrWhiteSpace(_expandedExcelPaste))
                                        {
                                            <pre class="didb-src-pre didb-src-single">@_expandedExcelPaste</pre>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(_expandedOcrText))
                                        {
                                            <pre class="didb-src-pre didb-src-single">@_expandedOcrText</pre>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(_expandedExcelPaste))
                                        {
                                            <pre class="didb-src-pre didb-src-single">@_expandedExcelPaste</pre>
                                        }
                                    </div>
                                    }
                                </td>
                            </tr>
                        }

                        @* Images row — collapsed by default. Pass-style reports
                           sometimes attach hundreds of evidence shots; pre-
                           rendering them all blows up the page. lazy + toggle. *@
                        @if (_expandedImages.Count > 0)
                        {
                            <tr class="didb-detail-row">
                                <td colspan="10" style="padding:0;">
                                    <button class="didb-section-toggle"
                                            @onclick="() => _showAttachedImages = !_showAttachedImages"
                                            @onclick:stopPropagation="true">
                                        <span>🖼 AI Analysis Images (@_expandedImages.Count)</span>
                                        <span class="didb-section-arrow">@(_showAttachedImages ? "▴" : "▾")</span>
                                    </button>
                                    @if (_showAttachedImages)
                                    {
                                    <div class="didb-imgs-wrap">
                                        <div class="didb-imgs-grid">
                                            @foreach (var (img, idx) in _expandedImages.Select((x, i) => (x, i)))
                                            {
                                                <div class="didb-img-thumb" @onclick="() => OpenViewer(img.DataUrl)">
                                                    <img src="@img.DataUrl" alt="@img.FileName" loading="lazy" />
                                                    <div class="didb-img-num">@(idx + 1)</div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    }
                                </td>
                            </tr>
                        }

                        @* Backup files row *@
                        @if (_expandedFiles.Count > 0)
                        {
                            <tr class="didb-detail-row">
                                <td colspan="10" style="padding:0;">
                                    <div class="didb-imgs-wrap">
                                        <div class="didb-imgs-title">📎 Backup Files (@_expandedFiles.Count)</div>
                                        <div class="didb-files-list">
                                            @foreach (var f in _expandedFiles)
                                            {
                                                <a class="didb-file-chip" href="/data-inference/file/@f.Id" download="@f.FileName" target="_blank">
                                                    <span class="didb-file-icon">📄</span>
                                                    <span class="didb-file-name" title="@f.FileName">@f.FileName</span>
                                                    <span class="didb-file-size">@FormatSize(f.FileSize)</span>
                                                </a>
                                            }
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                }
                @if (HasMoreReports)
                {
                    <tr class="didb-load-row" @onclick="LoadMoreDatasets">
                        <td colspan="10">
                            Loading on scroll... click to load more @VisibleReports.Count.ToString("N0") / @FilteredReports.Count.ToString("N0")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

</details>

<!-- ── Delete confirm ───────────────────────────────────────────────────────── -->
@if (_deleteTarget is not null)
{
    <div class="didb-overlay" @onclick="CancelDelete">
        <div class="didb-confirm" @onclick:stopPropagation="true">
            <div class="didb-confirm-title">Delete Dataset</div>
            <p style="font-size:13px;">
                Dataset <strong>@_deleteTarget</strong> and all its images/measurements will be deleted.<br />
                This action cannot be undone.
            </p>
            <div style="display:flex; gap:8px; justify-content:flex-end;">
                <button class="btn btn-outline-secondary btn-sm" @onclick="CancelDelete">Cancel</button>
                <button class="btn btn-danger btn-sm" @onclick="ExecuteDelete">Delete</button>
            </div>
        </div>
    </div>
}

@if (_viewerDataUrl is not null)
{
    <div class="didb-viewer-overlay" @onclick="CloseViewer">
        <img src="@_viewerDataUrl" class="didb-viewer-img" @onclick:stopPropagation="true" />
        <button class="didb-viewer-close" @onclick="CloseViewer">✕</button>
    </div>
}

<OcrTextEditor DatasetName="@_ocrDataset"
               ProductType="@_ocrProductType"
               ReportDate="@_ocrReportDate"
               OnClose="CloseOcrEditor"
               OnReanalyzed="OnOcrReanalyzed" />

@if (_showDeleteAll)
{
    <div class="didb-overlay" @onclick="CancelDeleteAll">
        <div class="didb-confirm" @onclick:stopPropagation="true">
            <div class="didb-confirm-title" style="color:#dc2626;">⚠ Delete ALL Datasets</div>
            <p style="font-size:13px;">
                <strong>All saved DataInference data</strong> (images, measurements, summaries, tags) will be deleted.<br />
                A total of <strong>@_reports.Count</strong> datasets will be permanently removed.<br />
                <span style="color:#dc2626; font-weight:600;">This action cannot be undone.</span>
            </p>
            <div style="display:flex; gap:8px; justify-content:flex-end;">
                <button class="btn btn-outline-secondary btn-sm" @onclick="CancelDeleteAll">Cancel</button>
                <button class="btn btn-danger btn-sm" @onclick="ExecuteDeleteAll">Delete All</button>
            </div>
        </div>
    </div>
}

</div>

<style>
    .didb-root {
        flex: 1; min-height: 0; display: flex; flex-direction: column;
        overflow: hidden; background: var(--panel-2, #f5f6f9);
    }
    .didb-header {
        display: flex; align-items: center; gap: 10px; padding: 10px 14px;
        background: var(--panel, #fff); border-bottom: 1px solid var(--line, var(--line, #dde1e7)); flex-shrink: 0;
    }
    .didb-title  { font-size: 15px; font-weight: 700; color: var(--ink, #0f1319); }
    .didb-count  { font-size: 12px; color: var(--ink-3, #7f8a98); }
    .didb-filter-label  { font-size: 12px; font-weight: 600; color: var(--ink-2, #4a5461); white-space: nowrap; }
    .didb-filter-select { width: 160px; }
    .didb-filter-select-sm { width: 104px; }
    .didb-empty  {
        padding: 60px; text-align: center; color: var(--ink-3, #7f8a98); font-size: 14px; line-height: 1.7;
    }
    .didb-ask-result {
        flex-shrink: 0;
        margin: 0 14px 10px;
        border: 1px solid #d7e1ee;
        border-radius: 2px;
        background: var(--panel, #fff);
        overflow: hidden;
    }
    .didb-ask-result-head {
        display: flex; align-items: center; justify-content: space-between;
        gap: 10px; padding: 9px 11px;
        border-bottom: 1px solid var(--line, var(--line, #dde1e7)); background: var(--panel-2, #f5f6f9);
    }
    .didb-ask-result-title {
        font-size: 13px; font-weight: 850; color: var(--ink, #0f1319);
    }
    .didb-ask-result-sub {
        margin-top: 2px; font-size: 11px; color: var(--ink-2, #4a5461);
    }
    .didb-ask-select {
        width: min(520px, 46vw);
        font-size: 12px;
    }
    .didb-ask-empty {
        padding: 18px 12px; color: var(--ink-3, #7f8a98); font-size: 13px; text-align: center;
    }
    .didb-ask-meta {
        display: flex; flex-wrap: wrap; gap: 6px;
        padding: 9px 11px 0;
    }
    .didb-ask-meta span {
        display: inline-flex; align-items: center;
        border: 1px solid var(--line, var(--line, #dde1e7)); border-radius: 2px;
        background: var(--panel-2, #f5f6f9); padding: 2px 8px;
        color: var(--ink-2, #4a5461); font-size: 11px; font-weight: 700;
    }
    .didb-ask-question {
        padding: 8px 11px 10px;
        color: var(--ink, #0f1319); font-size: 13px; font-weight: 750;
        overflow-wrap: anywhere;
    }
    .didb-ask-html-frame {
        display: block; width: 100%;
        /* proportional to the pane the shell gives this page, not to the window —
           58vh of the viewport is taller than the area that holds it */
        height: min(900px, calc(var(--view-h, 100vh) * .58)); min-height: 520px;
        border: 0; border-top: 1px solid var(--line, var(--line, #dde1e7)); background: var(--panel, #fff);
    }
    .didb-ask-markdown {
        padding: 10px 12px;
        border-top: 1px solid var(--line, var(--line, #dde1e7));
        color: var(--ink, #0f1319); font-size: 13px; line-height: 1.6;
    }
    .didb-ask-evidence {
        border-top: 1px solid var(--line, var(--line, #dde1e7));
        background: var(--panel-2, #f5f6f9);
    }
    .didb-ask-evidence summary {
        cursor: pointer;
        padding: 9px 11px;
        color: var(--ink-2, #4a5461); font-size: 12px; font-weight: 800;
    }
    .didb-ask-dataset {
        margin: 0 11px 10px;
        border: 1px solid #d7e1ee; border-radius: 2px;
        background: var(--panel, #fff); overflow: hidden;
    }
    .didb-ask-dataset-name {
        padding: 7px 10px;
        background: var(--panel-3, #eceef2); border-bottom: 1px solid var(--line, var(--line, #dde1e7));
        color: #1d4ed8; font-size: 12px; font-weight: 850;
        overflow-wrap: anywhere;
    }
    .didb-ask-dataset-frame {
        display: block; width: 100%; height: 420px; min-height: 320px;
        border: 0; background: var(--panel, #fff);
    }
    .didb-source-datasets {
        flex-shrink: 0;
        margin: 0 14px 12px;
        border: 1px solid #d7e1ee;
        border-radius: 2px;
        background: var(--panel, #fff);
        overflow: hidden;
    }
    .didb-source-datasets summary {
        cursor: pointer;
        padding: 9px 11px;
        background: var(--panel-2, #f5f6f9);
        border-top: 1px solid var(--line, var(--line, #dde1e7));
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .didb-source-datasets summary span {
        font-weight: 850;
        color: var(--ink, #0f1319);
        font-size: 12px;
    }
    .didb-source-datasets summary small {
        color: var(--ink-2, #4a5461);
        font-size: 11px;
        font-weight: 700;
    }
    .didb-source-toolbar {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        padding: 9px 11px;
        border-top: 1px solid var(--line, var(--line, #dde1e7));
        background: var(--panel, #fff);
    }
    .didb-source-datasets .didb-table-wrap {
        max-height: 62vh;
    }
    .didb-table-wrap { flex: 1; overflow: auto; }
    .didb-table      { border-collapse: collapse; width: 100%; font-size: 13px; }
    .didb-table th, .didb-table td {
        border-bottom: 1px solid var(--line, var(--line, #dde1e7)); padding: 7px 10px; text-align: left;
    }
    .didb-table thead th {
        background: var(--panel-3, #eceef2); font-weight: 600; color: var(--ink-2, #4a5461);
        position: sticky; top: 0; z-index: 1;
    }
    .didb-row        { cursor: pointer; transition: background .1s; }
    .didb-row:hover  { background: var(--panel-3, #eceef2); }
    .didb-row-open   { background: #f0f9ff; }
    .didb-load-row td {
        text-align: center; color: var(--ink-2, #4a5461); background: var(--panel-2, #f5f6f9);
        font-size: 12px; padding: 12px;
    }
    .didb-caret      { color: var(--ink-3, #7f8a98); font-size: 11px; width: 28px; text-align: center; }
    .didb-date       { font-size: 11px; color: var(--ink-3, #7f8a98); }
    .didb-ai-result {
        display: inline-flex; align-items: center; justify-content: center;
        min-width: 44px; padding: 2px 8px; border-radius: 2px;
        font-size: 10px; font-weight: 800; text-transform: uppercase;
        border: 1px solid var(--line-2, #c6ccd5); background: var(--panel-2, #f5f6f9); color: var(--ink-2, #4a5461);
    }
    .didb-ai-result-new  { background: #dcfce7; color: #166534; border-color: #86efac; }
    .didb-ai-result-index { background: #e0f2fe; color: #075985; border-color: #7dd3fc; }
    .didb-ai-result-old  { background: #ffedd5; color: #9a3412; border-color: #fdba74; }
    .didb-ai-result-none { background: var(--panel-3, #eceef2); color: var(--ink-3, #7f8a98); border-color: var(--line, var(--line, #dde1e7)); }
    .didb-input-test-result {
        padding: 14px 16px 18px; background: var(--panel-2, #f5f6f9);
        border-left: 4px solid #2563eb;
    }
    .didb-input-test-head {
        display: flex; align-items: flex-start; justify-content: space-between;
        gap: 12px; padding: 12px 14px; background: var(--panel, #fff);
        border: 1px solid var(--line, #dde1e7); border-radius: 2px 2px 0 0;
    }
    .didb-input-test-title {
        display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
    }
    .didb-input-test-title span {
        display: inline-flex; align-items: center; padding: 2px 8px;
        border-radius: 2px; background: #dbeafe; color: #1d4ed8;
        border: 1px solid #93c5fd; font-size: 10px; font-weight: 800;
    }
    .didb-input-test-title strong {
        color: var(--ink, #0f1319); font-size: 15px; overflow-wrap: anywhere;
    }
    .didb-input-test-meta {
        display: flex; flex-wrap: wrap; gap: 6px; margin-top: 7px;
        color: var(--ink-2, #4a5461); font-size: 11px;
    }
    .didb-input-test-meta span {
        display: inline-flex; max-width: 520px; overflow: hidden; text-overflow: ellipsis;
        white-space: nowrap; border: 1px solid var(--line, var(--line, #dde1e7)); background: var(--panel-2, #f5f6f9);
        border-radius: 2px; padding: 2px 8px;
    }
    .didb-input-test-html {
        padding: 14px; background: var(--panel, #fff); border: 1px solid var(--line, #dde1e7);
        border-top: none; border-radius: 0 0 2px 2px;
        color: var(--ink, #0f1319); font-size: 13px; line-height: 1.55;
        overflow-x: auto;
    }
    .didb-input-test-html-frame {
        display: block;
        width: 100%;
        height: min(1300px, calc(var(--view-h, 100vh) * .72));
        min-height: 720px;
        border: 0;
        background: var(--panel, #fff);
    }
    .didb-input-test-html table {
        width: 100%; border-collapse: collapse; margin: 10px 0; font-size: 12px;
    }
    .didb-input-test-html th,
    .didb-input-test-html td {
        border: 1px solid var(--line, #dde1e7); padding: 6px 8px; vertical-align: top;
    }
    .didb-input-test-html th {
        background: #eef3f8; color: #354253; font-weight: 800;
    }
    .didb-input-test-html h1,
    .didb-input-test-html h2,
    .didb-input-test-html h3 {
        margin: 12px 0 8px; color: var(--ink, #0f1319);
    }
    .didb-input-test-html .idt-report {
        display: grid; gap: 10px;
    }
    .didb-input-test-html .idt-ai-preanalysis,
    .didb-input-test-html .idt-judgement,
    .didb-input-test-html .idt-evidence,
    .didb-input-test-html .idt-actions {
        border: 1px solid var(--line, #dde1e7); border-radius: 2px;
        background: var(--panel, #fff); padding: 10px 12px;
    }
    .didb-input-test-html .idt-ai-preanalysis {
        border-left: 4px solid #2563eb;
    }
    .didb-input-test-html .idt-judgement {
        border-left: 4px solid #0f766e;
    }
    .didb-input-test-html .idt-actions {
        border-left: 4px solid #7c3aed;
    }
    .didb-input-test-html .idt-ai-preanalysis h3,
    .didb-input-test-html .idt-judgement h3,
    .didb-input-test-html .idt-evidence h3,
    .didb-input-test-html .idt-actions h3 {
        margin: 0 0 8px; font-size: 13px; font-weight: 850; color: var(--ink, #0f1319);
    }
    .didb-input-test-html .idt-ai-preanalysis dl {
        display: grid; grid-template-columns: max-content minmax(0, 1fr);
        gap: 5px 10px; margin: 0;
    }
    .didb-input-test-html .idt-ai-preanalysis dt {
        color: var(--ink-2, #4a5461); font-weight: 800;
    }
    .didb-input-test-html .idt-ai-preanalysis dd {
        margin: 0; color: var(--ink, #0f1319); overflow-wrap: anywhere;
    }
    .didb-input-test-html .idt-chip-row {
        display: flex; flex-wrap: wrap; gap: 6px;
    }
    .didb-input-test-html .idt-chip {
        display: inline-flex; align-items: center; max-width: 280px;
        padding: 3px 9px; border-radius: 2px;
        border: 1px solid var(--line-2, #c6ccd5); background: var(--panel-2, #f5f6f9); color: var(--ink-2, #4a5461);
        font-size: 11px; font-weight: 750; line-height: 1.35;
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .didb-input-test-html .idt-purpose-tags .idt-chip {
        background: #dbeafe; border-color: #93c5fd; color: #1d4ed8;
    }
    .didb-input-test-html .idt-check-tags .idt-chip {
        background: #ecfdf5; border-color: #86efac; color: #166534;
    }
    .didb-input-test-html .idt-brief,
    .didb-input-test-html .idt-process {
        border: 1px solid var(--line, #dde1e7); border-radius: 2px;
        background: var(--panel, #fff); padding: 10px 12px;
    }
    .didb-input-test-html .idt-brief h3,
    .didb-input-test-html .idt-process h3 {
        margin: 0 0 8px; font-size: 13px; font-weight: 850; color: var(--ink, #0f1319);
    }
    .didb-input-test-html .idt-brief ul {
        margin: 0; padding-left: 18px;
    }
    .didb-input-test-html .idt-brief li {
        margin: 3px 0;
    }
    .didb-input-test-html .idt-process {
        border-left: 4px solid #2563eb;
    }
    .didb-input-test-html .idt-compare {
        border: 1px solid var(--line-2, #c6ccd5); border-radius: 2px;
        background: var(--panel-2, #f5f6f9); padding: 10px 12px; display: grid; gap: 10px;
    }
    .didb-input-test-html .idt-compare h3 {
        margin: 0; font-size: 13px; font-weight: 850; color: var(--ink, #0f1319);
    }
    .didb-input-test-html .idt-compare-row {
        border: 1px solid var(--line, var(--line, #dde1e7)); border-radius: 2px;
        background: var(--panel, #fff); padding: 10px; display: grid; gap: 8px;
    }
    .didb-input-test-html .idt-compare-title {
        font-size: 12px; font-weight: 850; color: var(--ink, #0f1319);
    }
    .didb-input-test-html .idt-compare-bars {
        display: grid; gap: 7px;
    }
    .didb-input-test-html .idt-compare-bar {
        display: grid; grid-template-columns: minmax(84px, 150px) minmax(86px, 120px) 1fr;
        align-items: center; gap: 8px; min-height: 24px; font-size: 12px;
    }
    .didb-input-test-html .idt-compare-bar span {
        min-width: 0; color: var(--ink-2, #4a5461); font-weight: 750;
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .didb-input-test-html .idt-compare-bar b {
        color: var(--ink, #0f1319); text-align: right; font-variant-numeric: tabular-nums;
    }
    .didb-input-test-html .idt-compare-bar i {
        display: block; height: 10px; min-width: 3px; max-width: 100%;
        border-radius: 2px; background: var(--ink-2, #4a5461);
    }
    .didb-input-test-html .idt-compare-bar.idt-baseline i {
        background: var(--ink-2, #4a5461);
    }
    .didb-input-test-html .idt-compare-bar.idt-test i {
        background: #2563eb;
    }
    .didb-input-test-html .idt-delta {
        justify-self: start; display: inline-flex; align-items: center;
        padding: 2px 8px; border-radius: 2px; border: 1px solid var(--line-2, #c6ccd5);
        background: var(--panel-2, #f5f6f9); color: var(--ink-2, #4a5461); font-size: 11px; font-weight: 850;
        font-variant-numeric: tabular-nums;
    }
    .didb-input-test-html .idt-delta-bad {
        border-color: #fecaca; background: #fef2f2; color: #b91c1c;
    }
    .didb-input-test-html .idt-delta-good {
        border-color: #bbf7d0; background: #f0fdf4; color: #15803d;
    }
    .didb-input-test-html .idt-delta-neutral {
        border-color: #fde68a; background: #fffbeb; color: #92400e;
    }
    .didb-input-test-html .idt-compare-note {
        margin: 0; color: var(--ink-2, #4a5461); font-size: 11px;
    }
    @@media (max-width: 640px) {
        .didb-input-test-html .idt-compare-bar {
            grid-template-columns: 1fr minmax(72px, 110px);
        }
        .didb-input-test-html .idt-compare-bar i {
            grid-column: 1 / -1;
        }
    }
    /* scoped: this style block lands in the shared document, so a bare `td.n`
       would right-align that column on every other screen's tables too */
    .didb-root td.n  { text-align: right; font-variant-numeric: tabular-nums; }
    .didb-set-pt     { color: #2563eb; cursor: pointer; font-size: 12px;
                       text-decoration: underline dashed; text-underline-offset: 3px; }
    .didb-set-pt:hover { color: #1d4ed8; text-decoration: underline solid; }
    .didb-pt-text    { cursor: pointer; }
    .didb-pt-text:hover { text-decoration: underline dotted; color: #1d4ed8; }
    .didb-pt-input   { height: 26px; font-size: 12px; min-width: 180px; max-width: 260px; }

    .didb-detail-row td { padding: 0 !important; background: var(--panel-2, #f5f6f9); border-top: none; }
    .didb-summary    {
        padding: 8px 16px 8px 40px; font-size: 12px; color: var(--ink-2, #4a5461);
        background: #f0f9ff; border-bottom: 1px solid #bae6fd;
    }
    .didb-lang-row   { display: inline-flex; gap: 4px; margin-bottom: 6px; }
    .didb-lang       {
        border: 1px solid var(--line-2, #c6ccd5); background: var(--panel, #fff); color: var(--ink-2, #4a5461);
        padding: 1px 9px; border-radius: 2px; font-size: 10px; font-weight: 600;
        cursor: pointer; transition: all .12s; line-height: 1.5;
    }
    .didb-lang:hover  { background: #e0f2fe; border-color: #38bdf8; }
    .didb-lang.active { background: #4338ca; border-color: #4338ca; color: var(--panel, #fff); }

    /* Compact AI card — default view in the expanded row */
    .didb-verdict-row {
        display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
        margin-bottom: 8px;
    }
    .didb-verdict {
        font-size: 10px; font-weight: 800; letter-spacing: .05em;
        padding: 2px 10px; border-radius: 2px; white-space: nowrap;
        text-transform: uppercase;
    }

    /* ───────────────── v2 Dashboard (side panel) ───────────────── */
    .didb-dash {
        display: grid; grid-template-columns: 220px 1fr; gap: 14px;
        align-items: start;
    }
    @@media (max-width: 900px) {
        .didb-dash { grid-template-columns: 1fr; }
    }
    .didb-dash-side {
        padding: 12px 14px; background: linear-gradient(180deg,var(--panel-2, #f5f6f9) 0%,#eef2ff 100%);
        border: 1px solid var(--line, var(--line, #dde1e7)); border-radius: 2px;
        display: flex; flex-direction: column; gap: 10px;
    }
    .didb-verdict-lg     { font-size: 12px; padding: 4px 12px; align-self: flex-start; }
    .didb-kpi-hero {
        display: flex; flex-direction: column; gap: 2px;
        padding-top: 8px; border-top: 1px dashed var(--line-2, #c6ccd5);
    }
    .didb-kpi-value {
        font-size: 24px; font-weight: 800; line-height: 1.1;
        font-variant-numeric: tabular-nums;
    }
    .didb-kpi-value.didb-ev-down { color: #065f46; background: transparent !important; }
    .didb-kpi-value.didb-ev-up   { color: #991b1b; background: transparent !important; }
    .didb-kpi-value.didb-ev-flat { color: var(--ink-2, #4a5461); background: transparent !important; }
    .didb-kpi-label {
        font-size: 10px; color: var(--ink-2, #4a5461); font-weight: 600;
        text-transform: uppercase; letter-spacing: .03em;
    }
    .didb-kpi-meta {
        display: flex; gap: 12px; font-size: 10px; color: var(--ink-2, #4a5461);
        padding-top: 6px; border-top: 1px dashed var(--line-2, #c6ccd5);
    }
    .didb-kpi-meta-n {
        font-size: 12px; font-weight: 700; color: var(--ink, #0f1319);
        font-variant-numeric: tabular-nums;
    }
    .didb-dash-headline {
        font-size: 11px; color: var(--ink, #0f1319); line-height: 1.5; font-weight: 500;
        padding-top: 6px; border-top: 1px dashed var(--line-2, #c6ccd5);
    }
    .didb-tags-side { padding-top: 6px; border-top: 1px dashed var(--line-2, #c6ccd5); }
    .didb-tags-side .didb-tag { font-size: 9px; padding: 1px 6px; }

    .didb-dash-main {
        display: flex; flex-direction: column; gap: 8px; min-width: 0;
    }
    .didb-dash-section-title {
        font-size: 10px; font-weight: 700; color: var(--ink-2, #4a5461);
        text-transform: uppercase; letter-spacing: .04em;
        margin-bottom: 2px;
    }
    .didb-v-good     { background: #d1fae5; color: #065f46; border: 1px solid #6ee7b7; }
    .didb-v-bad      { background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }
    .didb-v-partial  { background: #fef3c7; color: #92400e; border: 1px solid #fcd34d; }
    .didb-v-neutral  { background: var(--panel-3, #eceef2); color: var(--ink-2, #4a5461); border: 1px solid var(--line-2, #c6ccd5); }

    /* v2 — Evidence table: Excel-grid styling */
    .didb-evidence-wrap { margin: 6px 0 10px; overflow-x: auto; }
    .didb-evidence {
        border-collapse: collapse;
        font-size: 11px; width: 100%;
        font-variant-numeric: tabular-nums;
        background: var(--panel, #fff);
    }
    .didb-evidence th, .didb-evidence td {
        border: 1px solid var(--line-2, #c6ccd5);
        padding: 5px 9px;
        text-align: left;
        vertical-align: top;
    }
    .didb-evidence thead th {
        background: var(--line, var(--line, #dde1e7));
        color: var(--ink, #0f1319);
        font-size: 9px; font-weight: 700;
        text-transform: uppercase; letter-spacing: .04em;
        border-color: var(--ink-3, #7f8a98);
    }
    .didb-evidence tbody tr:nth-child(even) td { background: var(--panel-2, #f5f6f9); }
    .didb-evidence td.n     { text-align: right; }
    .didb-ev-metric         { font-weight: 600; color: var(--ink, #0f1319); min-width: 130px; }
    .didb-ev-label          { display: block; font-size: 9px; color: var(--ink-2, #4a5461); margin-bottom: 1px; }
    .didb-ev-val            { display: block; color: var(--ink, #0f1319); font-weight: 500; }
    .didb-ev-note-cell      { font-size: 10px; color: var(--ink-2, #4a5461); font-style: italic; }
    .didb-ev-delta          { font-weight: 700; white-space: nowrap; min-width: 56px; }
    .didb-ev-down           { color: #065f46; background: #ecfdf5 !important; }
    .didb-ev-up             { color: #991b1b; background: #fef2f2 !important; }
    .didb-ev-flat           { color: var(--ink-2, #4a5461); }
    .didb-ev-range          { font-size: 9px; color: var(--ink-2, #4a5461); font-weight: 500; margin-top: 1px; }

    /* v7 multi-arm */
    .didb-ev-comparisons    { display: flex; flex-direction: column; gap: 3px; }
    .didb-ev-comp           {
        display: flex; align-items: baseline; gap: 6px;
        padding: 2px 5px; border-radius: 2px;
        background: var(--panel, #fff); border: 1px solid var(--line, var(--line, #dde1e7)); font-size: 10px;
    }
    .didb-ev-comp.didb-comp-best     { background: #ecfdf5; border-color: #6ee7b7; }
    .didb-ev-comp.didb-comp-worst    { background: #fef2f2; border-color: #fca5a5; }
    .didb-ev-comp.didb-comp-baseline { border-left: 3px solid #4338ca; }
    .didb-ev-comp-label     { font-weight: 600; color: var(--ink, #0f1319); min-width: 90px; }
    .didb-ev-comp-val       { color: var(--ink, #0f1319); }
    .didb-ev-comp-n         { font-size: 9px; color: var(--ink-3, #7f8a98); }
    .didb-ev-comp-flag {
        font-size: 8px; font-weight: 700; padding: 1px 5px; border-radius: 2px;
        text-transform: uppercase; letter-spacing: .03em; margin-left: auto;
    }
    .didb-ev-comp-flag.baseline { background: #e0e7ff; color: #4338ca; }
    .didb-ev-comp-flag.best     { background: #d1fae5; color: #065f46; }
    .didb-ev-comp-flag.worst    { background: #fee2e2; color: #991b1b; }

    /* v7 DOE grid */
    .didb-doe-wrap { overflow-x: auto; margin: 3px 0 6px; }
    .didb-doe { border-collapse: collapse; font-size: 10px; font-variant-numeric: tabular-nums; }
    .didb-doe th, .didb-doe td {
        border: 1px solid var(--line-2, #c6ccd5); padding: 3px 6px; min-width: 56px;
        text-align: center; white-space: nowrap;
    }
    .didb-doe th             { background: var(--line, var(--line, #dde1e7)); font-weight: 700; color: var(--ink, #0f1319); font-size: 9px; }
    .didb-doe-ok             { background: #d1fae5; color: #065f46; font-weight: 600; }
    .didb-doe-ng             { background: #fee2e2; color: #991b1b; font-weight: 600; }
    .didb-doe-borderline     { background: #fef3c7; color: #92400e; font-weight: 600; }
    .didb-doe-empty          { background: var(--panel-2, #f5f6f9); color: var(--line-2, #c6ccd5); }

    /* v7 Trend list */
    .didb-trend {
        list-style: none; margin: 3px 0 6px 0; padding: 0;
        font-size: 11px; color: var(--ink, #0f1319);
    }
    .didb-trend li {
        display: flex; gap: 10px; padding: 3px 0; align-items: baseline;
        border-bottom: 1px dashed var(--line, var(--line, #dde1e7));
    }
    .didb-trend-label { font-weight: 600; min-width: 72px; color: var(--ink-2, #4a5461); }
    .didb-trend-value { font-weight: 700; color: var(--ink, #0f1319); min-width: 56px; }
    .didb-trend-note  { font-size: 10px; color: var(--ink-2, #4a5461); font-style: italic; }

    /* v7 reportType badge */
    .didb-rt-badge {
        align-self: flex-start;
        font-size: 8px; font-weight: 700; padding: 1px 7px; border-radius: 2px;
        text-transform: uppercase; letter-spacing: .04em;
        background: var(--panel-3, #eceef2); color: var(--ink-2, #4a5461); border: 1px solid var(--line-2, #c6ccd5);
    }
    .didb-rt-multi   { background: #e0f2fe; color: #0369a1; border-color: #7dd3fc; }
    .didb-rt-doe     { background: #fae8ff; color: #86198f; border-color: #f0abfc; }
    .didb-rt-reli    { background: #ecfdf5; color: #065f46; border-color: #6ee7b7; }
    .didb-rt-trend   { background: #fef3c7; color: #92400e; border-color: #fcd34d; }
    .didb-rt-log     { background: var(--panel-3, #eceef2); color: #4b5563; border-color: var(--line-2, #c6ccd5); }

    /* v2 — Actions list */
    .didb-actions {
        list-style: none; margin: 2px 0 6px 0; padding: 0;
        font-size: 12px; color: var(--ink, #0f1319); line-height: 1.5;
    }
    .didb-actions li {
        display: flex; gap: 6px; padding: 3px 0; align-items: baseline;
    }
    .didb-actions li + li { border-top: 1px dashed var(--line, var(--line, #dde1e7)); }
    .didb-action-kind     { flex-shrink: 0; width: 16px; font-weight: 700; color: #2563eb; }
    .didb-action-text     { flex: 1; }
    .didb-action-investigate .didb-action-kind { color: #7c3aed; }
    .didb-action-risk        .didb-action-kind { color: #dc2626; }
    .didb-action-risk        .didb-action-text { color: #991b1b; }

    /* v2 — Context */
    .didb-context {
        margin: 4px 0 0 0; padding: 6px 10px;
        background: var(--panel, #fff); border-left: 3px solid var(--line-2, #c6ccd5); border-radius: 2px;
        font-size: 11px; line-height: 1.5;
        display: grid; grid-template-columns: auto 1fr; gap: 2px 10px;
    }
    .didb-context dt {
        font-size: 9px; font-weight: 700; color: var(--ink-2, #4a5461);
        text-transform: uppercase; letter-spacing: .04em; padding-top: 2px;
    }
    .didb-context dd { margin: 0; color: var(--ink, #0f1319); }
    .didb-card-conclusion {
        font-size: 12px; font-weight: 600; color: var(--ink, #0f1319); line-height: 1.4;
    }
    .didb-card-list {
        list-style: none; margin: 0 0 6px 0; padding: 0;
        font-size: 11px; color: var(--ink-2, #4a5461); line-height: 1.5;
    }
    .didb-card-list li {
        position: relative; padding-left: 14px; margin-top: 2px;
    }
    .didb-card-list li::before {
        content: "•"; position: absolute; left: 4px; color: var(--ink-3, #7f8a98);
    }
    .didb-card-actions { color: #1d4ed8; }
    .didb-card-actions li::before { content: "→"; color: #2563eb; }
    .didb-show-details {
        background: transparent; border: none; color: #6366f1;
        font-size: 10px; font-weight: 600; cursor: pointer; padding: 2px 0;
        margin-top: 2px;
    }
    .didb-show-details:hover { color: var(--ink, #0f1319); text-decoration: underline; }

    /* AI_EXCEL_PROC schema bundle card */
    .didb-aicard {
        padding: 12px 16px; background: var(--panel-2, #f5f6f9);
        border-top: 1px solid var(--line, var(--line, #dde1e7)); border-bottom: 1px solid var(--line, var(--line, #dde1e7));
    }
    .didb-aicard-meta {
        margin-left: auto; font-size: 10px; color: var(--ink-3, #7f8a98);
        font-variant-numeric: tabular-nums;
    }
    .didb-aicard-head {
        display: flex; gap: 8px; align-items: center; flex-wrap: wrap;
        margin: 6px 0 4px 0;
    }
    .didb-aicard-title    { font-size: 14px; font-weight: 700; color: var(--ink, #0f1319); }
    .didb-aicard-purpose  { font-size: 12px; color: var(--ink-2, #4a5461); margin-bottom: 6px; }
    .didb-aicard-section-h {
        font-size: 11px; font-weight: 700; color: var(--ink-2, #4a5461); text-transform: uppercase;
        margin: 8px 0 2px 0; letter-spacing: 0.05em;
    }
    .didb-aicard-list { margin: 0; padding-left: 18px; font-size: 12px; color: var(--ink, #0f1319); }
    .didb-aicard-list li { margin: 2px 0; line-height: 1.5; }
    .didb-aicard-checks li { margin: 4px 0; }
    .didb-aicard-reason   { font-size: 11px; color: var(--ink-2, #4a5461); margin-top: 2px; }
    .didb-aicard-rationale {
        font-size: 11px; color: var(--ink-2, #4a5461); background: var(--panel, #fff);
        border-left: 3px solid #6366f1; padding: 6px 10px; margin-top: 2px;
    }

    /* AI_EXCEL_PROC dashboard — expanded Dataset Results row */
    .didb-ai-dashboard {
        padding: 14px 18px 16px 40px;
        background: #f4f6f8;
        border-top: 1px solid var(--line, #dde1e7);
        border-bottom: 1px solid var(--line, #dde1e7);
        color: var(--ink, #0f1319);
    }
    .didb-ai-hero {
        display: grid; grid-template-columns: minmax(0, 1fr) 260px; gap: 16px;
        background: var(--panel, #fff); border: 1px solid var(--line, #dde1e7); border-radius: 2px;
        padding: 14px 16px;
    }
    @@media (max-width: 980px) {
        .didb-ai-hero { grid-template-columns: 1fr; }
    }
    .didb-ai-title-line {
        display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
        margin-top: 4px;
    }
    .didb-ai-primary {
        display: inline-flex; align-items: center;
        padding: 2px 9px; border-radius: 2px;
