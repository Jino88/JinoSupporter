    }

    private static string AiJudgementClass(AiResultRow r)
    {
        string text = NormalizeAiText(r.Judgement + " " + r.MetricName);
        if (ContainsAny(text, "fail", "failed", "ng", "out", "reject")) return "didb-ai-status-fail";
        if (ContainsAny(text, "warn", "risk", "borderline", "partial")) return "didb-ai-status-warn";
        if (ContainsAny(text, "pass", "passed", "ok", "good")) return "didb-ai-status-pass";
        double? rate = AiNgRatePercent(r);
        if (rate.HasValue)
        {
            if (rate.Value >= 12) return "didb-ai-status-fail";
            if (rate.Value >= 7) return "didb-ai-status-warn";
            return "didb-ai-status-pass";
        }
        return "didb-ai-status-neutral";
    }

