    private static readonly System.Text.RegularExpressions.Regex AiReportVisualBlockRegex = new(
        @"```[ \t]*(report-heatmap|report-bars|report-heatmap-matrix)\b[^\r\n]*\r?\n.*?```",
        System.Text.RegularExpressions.RegexOptions.IgnoreCase
        | System.Text.RegularExpressions.RegexOptions.Singleline
        | System.Text.RegularExpressions.RegexOptions.CultureInvariant);

    private static string AiGeneratedReportMarkdown(AiDocBundle doc, string lang)
    {
        string report = doc.DocTranslations.TryGetValue(lang, out var tr)
            && !string.IsNullOrWhiteSpace(tr.GeneratedReportMarkdown)
                ? tr.GeneratedReportMarkdown
                : doc.GeneratedReportMarkdown;

        if (!AiMarkdownHasVisualBlock(report) && AiMarkdownHasVisualBlock(doc.GeneratedReportMarkdown))
        {
            report = AppendMissingAiVisualBlocks(report, doc.GeneratedReportMarkdown);
        }

        return HideAiEvidenceLocationSections(CleanExcelSerialDateText(report));
    }

    private static string HideAiEvidenceLocationSections(string markdown)
    {
        if (string.IsNullOrWhiteSpace(markdown)) return "";

        var output = new List<string>();
        bool skipping = false;
        int skipLevel = 0;

        foreach (string line in markdown.Replace("\r\n", "\n").Replace('\r', '\n').Split('\n'))
        {
            string trim = line.Trim();
            int heading = trim.TakeWhile(ch => ch == '#').Count();
            bool isHeading = heading is >= 1 and <= 6
                             && trim.Length > heading
                             && trim[heading] == ' ';

            if (isHeading)
            {
                string title = trim[(heading + 1)..].Trim();
                if (IsAiEvidenceLocationHeading(title))
                {
                    skipping = true;
                    skipLevel = heading;
                    continue;
                }
                if (skipping && heading <= skipLevel)
                {
                    skipping = false;
                }
            }

            if (!skipping) output.Add(line);
        }

        return string.Join("\n", output).Trim();
    }

    private static bool IsAiEvidenceLocationHeading(string title)
    {
        string text = (title ?? "").Trim();
        string lower = text.ToLowerInvariant();
        return (lower.Contains("evidence") && lower.Contains("location"))
               || (lower.Contains("source") && (lower.Contains("cell") || lower.Contains("worksheet")))
               || (text.Contains("증빙") && text.Contains("위치"))
               || (text.Contains("근거") && text.Contains("위치"))
               || (lower.Contains("vị trí") && (lower.Contains("bằng chứng") || lower.Contains("chứng cứ")));
    }

    private static bool AiMarkdownHasVisualBlock(string? markdown)
        => !string.IsNullOrWhiteSpace(markdown) && AiReportVisualBlockRegex.IsMatch(markdown);

    private static string AppendMissingAiVisualBlocks(string markdown, string sourceMarkdown)
    {
        var matches = AiReportVisualBlockRegex.Matches(sourceMarkdown);
        if (matches.Count == 0) return markdown;

        var sb = new System.Text.StringBuilder((markdown ?? "").TrimEnd());
        foreach (System.Text.RegularExpressions.Match match in matches)
        {
            string block = match.Value.Trim();
            if (block.Length == 0) continue;
            sb.AppendLine();
            sb.AppendLine();
            sb.Append(block);
        }

        return sb.ToString();
    }

    private static string AiMarkdownVisualHtml(string kind, string json)
    {
        static string Enc(string? value)
            => System.Net.WebUtility.HtmlEncode(CleanExcelSerialDateText(value ?? ""));

        static string HeatClass(string? status)
        {
            string s = (status ?? "").Trim().ToLowerInvariant();
            if (s is "bad" or "worse" or "fail" or "failed" or "ng" or "high") return "didb-ai-heat-worse";
            if (s is "good" or "improved" or "pass" or "passed" or "ok" or "low") return "didb-ai-heat-improved";
            return "didb-ai-heat-flat";
        }

        static string BarClass(string? status)
        {
            string s = (status ?? "").Trim().ToLowerInvariant();
            if (s is "bad" or "worse" or "fail" or "failed" or "ng" or "high") return "didb-ai-bar-danger";
            if (s is "good" or "improved" or "pass" or "passed" or "ok" or "low") return "didb-ai-bar-good";
            return "didb-ai-bar-warn";
        }

        static double NumberValue(AiMarkdownVisualItem item)
        {
            if (item.Amount.HasValue) return Math.Abs(item.Amount.Value);
            var m = System.Text.RegularExpressions.Regex.Match(item.Value ?? "", @"-?\d+(?:\.\d+)?");
            return m.Success && double.TryParse(m.Value, System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture, out double v)
                ? Math.Abs(v)
                : 1.0;
        }

        string normalizedKind = (kind ?? "").Trim().ToLowerInvariant();
        if (normalizedKind is not ("report-heatmap" or "report-bars" or "report-heatmap-matrix"))
            return "";

        if (normalizedKind == "report-heatmap-matrix"
            || (normalizedKind == "report-heatmap" && LooksLikeMatrixJson(json)))
        {
            string matrix = RenderHeatMatrix(json);
            if (!string.IsNullOrEmpty(matrix)) return matrix;
        }

        try
        {
            var items = System.Text.Json.JsonSerializer.Deserialize<List<AiMarkdownVisualItem>>(
                json,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? [];
            items = items
                .Where(x => !string.IsNullOrWhiteSpace(x.Label) || !string.IsNullOrWhiteSpace(x.Value))
                .Take(12)
                .ToList();
            if (items.Count == 0) return "";

            var sb = new System.Text.StringBuilder();
            if (normalizedKind == "report-heatmap")
            {
                sb.Append("<div class=\"didb-ai-md-visual\"><div class=\"didb-ai-heatmap didb-ai-visual-heatmap\">");
                foreach (var item in items)
                {
                    sb.Append("<div class=\"didb-ai-heat ").Append(HeatClass(item.Status)).Append("\" title=\"")
                      .Append(Enc(item.Detail)).Append("\"><strong>")
                      .Append(Enc(item.Value)).Append("</strong><span>")
                      .Append(Enc(item.Label)).Append("</span><em>")
                      .Append(Enc(item.Detail)).Append("</em></div>");
                }
                sb.Append("</div></div>");
                return sb.ToString();
            }

            double max = Math.Max(1.0, items.Select(NumberValue).DefaultIfEmpty(0).Max());
            sb.Append("<div class=\"didb-ai-md-visual didb-ai-md-bars didb-ai-vbar-chart\">");
            foreach (var item in items)
            {
                double value = NumberValue(item);
                double height = value <= 0
                    ? 0
                    : Math.Clamp(value / max * 100.0, 5.0, 100.0);
                sb.Append("<div class=\"didb-ai-vbar-item\" title=\"")
                  .Append(Enc(item.Detail)).Append("\"><div class=\"didb-ai-vbar-value\">")
                  .Append(Enc(item.Value)).Append("</div><div class=\"didb-ai-vbar-plot\"><div class=\"didb-ai-vbar ")
                  .Append(BarClass(item.Status)).Append("\" style=\"height:")
                  .Append(height.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))
                  .Append("%\"></div></div><div class=\"didb-ai-vbar-label\">")
                  .Append(Enc(item.Label)).Append("</div><div class=\"didb-ai-vbar-detail\">")
                  .Append(Enc(item.Detail)).Append("</div></div>");
            }
            sb.Append("</div>");
            return sb.ToString();
        }
        catch
        {
            return "";
        }
    }

    private static bool LooksLikeMatrixJson(string json)
    {
        if (string.IsNullOrWhiteSpace(json)) return false;
        string head = json.TrimStart();
        if (head.Length == 0 || head[0] != '{') return false;
        return head.Contains("\"rows\"", StringComparison.OrdinalIgnoreCase)
            && head.Contains("\"columns\"", StringComparison.OrdinalIgnoreCase);
    }

    private static string RenderHeatMatrix(string json)
    {
        static string Enc(string? value)
            => System.Net.WebUtility.HtmlEncode(CleanExcelSerialDateText(value ?? ""));

        static string HeatClass(string? status)
        {
            string s = (status ?? "").Trim().ToLowerInvariant();
            if (s is "bad" or "worse" or "fail" or "failed" or "ng" or "high") return "didb-ai-heat-worse";
            if (s is "good" or "improved" or "pass" or "passed" or "ok" or "low") return "didb-ai-heat-improved";
            return "didb-ai-heat-flat";
        }

        try
        {
            var matrix = System.Text.Json.JsonSerializer.Deserialize<AiMarkdownHeatMatrix>(
                json,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (matrix is null || matrix.Rows.Count == 0 || matrix.Columns.Count == 0)
                return "";

            int colCount = matrix.Columns.Count;
            var sb = new System.Text.StringBuilder();
            sb.Append("<div class=\"didb-ai-md-visual\"><table class=\"didb-ai-heat-matrix\"><thead><tr><th class=\"didb-ai-heat-rowhead\"></th>");
            foreach (string col in matrix.Columns)
                sb.Append("<th>").Append(Enc(col)).Append("</th>");
            sb.Append("</tr></thead><tbody>");
            foreach (var row in matrix.Rows)
            {
                sb.Append("<tr><th class=\"didb-ai-heat-rowhead\">").Append(Enc(row.Label)).Append("</th>");
                for (int c = 0; c < colCount; c++)
                {
                    var cell = c < row.Cells.Count ? row.Cells[c] : null;
                    string cls = HeatClass(cell?.Status);
                    string title = Enc(cell?.Detail ?? "");
                    sb.Append("<td class=\"didb-ai-heat-cell ").Append(cls)
                      .Append("\" title=\"").Append(title).Append("\">");
                    sb.Append("<strong>").Append(Enc(cell?.Value ?? "")).Append("</strong>");
                    if (!string.IsNullOrWhiteSpace(cell?.Count))
                        sb.Append("<em>").Append(Enc(cell!.Count)).Append("</em>");
                    sb.Append("</td>");
                }
                sb.Append("</tr>");
            }
            sb.Append("</tbody></table></div>");
            return sb.ToString();
        }
        catch
        {
            return "";
        }
    }

    private static Microsoft.AspNetCore.Components.MarkupString AiMarkdown(string? markdown)
    {
        static string Enc(string? value)
            => System.Net.WebUtility.HtmlEncode(CleanExcelSerialDateText(value ?? ""));

        static string Inline(string? value)
        {
            string text = Enc(value);
            text = System.Text.RegularExpressions.Regex.Replace(text, @"\*\*(.+?)\*\*", "<strong>$1</strong>");
            text = System.Text.RegularExpressions.Regex.Replace(text, @"`(.+?)`", "<code>$1</code>");
            return text;
        }

        static bool IsTableLine(string line) => line.Trim().StartsWith("|", StringComparison.Ordinal)
                                             && line.Trim().EndsWith("|", StringComparison.Ordinal);
        static bool IsSeparator(string line)
        {
            string t = line.Trim().Trim('|').Replace(" ", "");
            return t.Length > 0 && t.All(ch => ch == '-' || ch == ':' || ch == '|');
        }
        static List<string> Cells(string line)
            => line.Trim().Trim('|').Split('|').Select(x => x.Trim()).ToList();
        static bool IsLocationColumn(string header)
        {
            string text = (header ?? "").Trim();
            string lower = text.ToLowerInvariant();
            return lower is "cell" or "cells" or "source cell" or "source cells"
                   || lower.Contains("evidence location")
                   || lower.Contains("worksheet/cell")
                   || lower.Contains("sheet/cell")
                   || (lower.Contains("source") && lower.Contains("cell"))
                   || text.Contains("셀")
                   || text.Contains("위치")
                   || text == "Ô";
        }

        var lines = (markdown ?? "").Replace("\r\n", "\n").Replace('\r', '\n').Split('\n');
        var sb = new System.Text.StringBuilder();
        bool inList = false;

        void CloseList()
        {
            if (!inList) return;
            sb.Append("</ul>");
            inList = false;
        }

        for (int i = 0; i < lines.Length; i++)
        {
            string line = lines[i].TrimEnd();
            string trim = line.Trim();
            if (string.IsNullOrWhiteSpace(trim))
            {
                CloseList();
                continue;
            }

            if (trim.StartsWith("```", StringComparison.Ordinal))
            {
                CloseList();
                string kind = trim.Length > 3 ? trim[3..].Trim() : "";
                var block = new System.Text.StringBuilder();
                i++;
                while (i < lines.Length && !lines[i].Trim().StartsWith("```", StringComparison.Ordinal))
                {
                    block.AppendLine(lines[i]);
                    i++;
                }

                string visual = AiMarkdownVisualHtml(kind, block.ToString());
                if (!string.IsNullOrWhiteSpace(visual))
                {
                    sb.Append(visual);
                }
                else
                {
                    sb.Append("<pre><code>").Append(Enc(block.ToString())).Append("</code></pre>");
                }
                continue;
            }

            if (IsTableLine(trim) && i + 1 < lines.Length && IsSeparator(lines[i + 1]))
            {
                CloseList();
                var headers = Cells(trim);
                var visibleIndexes = headers
                    .Select((header, index) => new { header, index })
                    .Where(x => !IsLocationColumn(x.header))
                    .Select(x => x.index)
                    .ToList();
                if (visibleIndexes.Count == 0) visibleIndexes = Enumerable.Range(0, headers.Count).ToList();
                i += 2;
                sb.Append("<table><thead><tr>");
                foreach (int idx in visibleIndexes) sb.Append("<th>").Append(Inline(headers[idx])).Append("</th>");
                sb.Append("</tr></thead><tbody>");
                while (i < lines.Length && IsTableLine(lines[i]))
                {
                    var rowCells = Cells(lines[i]);
                    sb.Append("<tr>");
                    foreach (int idx in visibleIndexes)
                    {
                        string c = idx < rowCells.Count ? rowCells[idx] : "";
                        sb.Append("<td>").Append(Inline(c)).Append("</td>");
                    }
                    sb.Append("</tr>");
                    i++;
                }
                i--;
                sb.Append("</tbody></table>");
                continue;
            }

            int heading = trim.TakeWhile(ch => ch == '#').Count();
            if (heading is >= 1 and <= 4 && trim.Length > heading && trim[heading] == ' ')
            {
                CloseList();
                int level = Math.Min(heading + 2, 5);
                sb.Append("<h").Append(level).Append(">")
                  .Append(Inline(trim[(heading + 1)..]))
                  .Append("</h").Append(level).Append(">");
                continue;
            }

            if (trim.StartsWith("- ", StringComparison.Ordinal) || trim.StartsWith("* ", StringComparison.Ordinal))
            {
                if (!inList)
                {
                    sb.Append("<ul>");
                    inList = true;
                }
                sb.Append("<li>").Append(Inline(trim[2..])).Append("</li>");
                continue;
            }

            CloseList();
            sb.Append("<p>").Append(Inline(trim)).Append("</p>");
        }

        CloseList();
        return new Microsoft.AspNetCore.Components.MarkupString(sb.ToString());
    }

