    .didb-ai-heatmap {
        display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 8px; margin-bottom: 10px;
    }
    @@media (max-width: 900px) {
        .didb-ai-heatmap { grid-template-columns: 1fr; }
    }
    .didb-ai-heat {
        min-height: 86px; border-radius: 2px; border: 1px solid var(--line, #dde1e7);
        padding: 10px; display: flex; flex-direction: column; justify-content: space-between;
        overflow: hidden;
    }
    .didb-ai-heat strong {
        font-size: 18px; line-height: 1.1; font-variant-numeric: tabular-nums;
    }
    .didb-ai-heat span {
        color: var(--ink, #0f1319); font-size: 12px; font-weight: 800;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .didb-ai-heat em {
        color: #526171; font-size: 11px; font-style: normal;
        font-variant-numeric: tabular-nums;
    }
    .didb-ai-heat-worse {
        background: #fff1ef; border-color: #efb2aa; color: #9b2419;
    }
    .didb-ai-heat-improved {
        background: #edf8f0; border-color: #a9d9b8; color: #21673c;
    }
    .didb-ai-heat-flat {
        background: #fff8eb; border-color: #edcf94; color: #8a570f;
    }
    .didb-ai-heat-matrix {
        margin: 10px 0 12px;
        border-collapse: separate;
        border-spacing: 4px;
        font-size: 11px;
    }
    .didb-ai-heat-matrix th {
        background: #eef3f8; color: #28405c;
        font-size: 10px; font-weight: 900;
        padding: 6px 10px;
        border: 1px solid #d4dee8;
        text-align: center;
        white-space: nowrap;
    }
    .didb-ai-heat-matrix th.didb-ai-heat-rowhead {
        background: #f4f8fb; color: #17324a;
    }
    .didb-ai-heat-matrix td.didb-ai-heat-cell {
        min-width: 86px;
        padding: 8px 10px;
        border: 1px solid #d4dee8;
        border-radius: 2px;
        text-align: center;
        vertical-align: middle;
        line-height: 1.2;
        white-space: nowrap;
    }
    .didb-ai-heat-cell strong {
        display: block;
        font-size: 14px;
        font-variant-numeric: tabular-nums;
        line-height: 1.1;
    }
    .didb-ai-heat-cell em {
        display: block;
        margin-top: 3px;
        font-size: 10px;
        font-style: normal;
        color: #526171;
        font-variant-numeric: tabular-nums;
    }
    .didb-ai-heat-cell.didb-ai-heat-worse em { color: #9b2419; }
    .didb-ai-heat-cell.didb-ai-heat-improved em { color: #21673c; }
    .didb-ai-heat-cell.didb-ai-heat-flat em { color: #8a570f; }
    .didb-ai-comp-table {
        width: 100%; border-collapse: collapse; table-layout: fixed;
        font-size: 11px;
        border: 1px solid var(--line, #dde1e7);
    }
    .didb-ai-comp-table th {
        color: #617084; font-size: 10px; text-transform: uppercase;
        border: 1px solid var(--line, #dde1e7); padding: 7px 7px;
        background: #eef3f8;
        vertical-align: middle; text-align: center;
    }
    .didb-ai-comp-table td {
        border: 1px solid var(--line, #dde1e7); padding: 7px 7px; vertical-align: middle;
        background: var(--panel, #fff);
        text-align: center;
    }
    .didb-ai-comp-table th.n,
    .didb-ai-comp-table td.n {
        text-align: center;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }
    .didb-ai-comp-table th:first-child,
    .didb-ai-comp-table td:first-child { width: 34%; }
    .didb-ai-comp-table th:nth-child(5),
    .didb-ai-comp-table td:nth-child(5) { width: 112px; }
    .didb-ai-comp-table th:nth-child(6),
    .didb-ai-comp-table td:nth-child(6) { width: 96px; }
    .didb-ai-comp-table td strong {
        display: block; color: var(--ink, #0f1319); white-space: nowrap;
        overflow: hidden; text-overflow: ellipsis;
    }
    .didb-ai-comp-table td span:not(.didb-ai-chip) {
        display: block; color: #617084; white-space: nowrap;
        overflow: hidden; text-overflow: ellipsis;
    }
    .didb-ai-compare-table th:first-child,
    .didb-ai-compare-table td:first-child { width: 18%; }
    .didb-ai-compare-table th:nth-child(2),
    .didb-ai-compare-table td:nth-child(2) { width: 24%; }
    .didb-ai-compare-table th:nth-child(3),
    .didb-ai-compare-table td:nth-child(3),
    .didb-ai-compare-table th:nth-child(4),
    .didb-ai-compare-table td:nth-child(4),
    .didb-ai-compare-table th:nth-child(5),
    .didb-ai-compare-table td:nth-child(5) { width: 72px; }
    .didb-ai-compare-table th:nth-child(6),
    .didb-ai-compare-table td:nth-child(6) { width: 104px; text-align: center; }
    .didb-ai-compare-table th:nth-child(7),
    .didb-ai-compare-table td:nth-child(7) { width: 94px; }
    .didb-ai-compare-table td:nth-child(7) { padding-left: 9px; padding-right: 9px; }
    .didb-ai-compare-table tr:hover td { background: #f8fbfe; }
    .didb-ai-review-table {
        border-width: 0;
    }
    .didb-ai-review-table th:first-child,
    .didb-ai-review-table td:first-child { width: 20%; }
    .didb-ai-review-table th:nth-child(2),
    .didb-ai-review-table td:nth-child(2),
    .didb-ai-review-table th:nth-child(3),
    .didb-ai-review-table td:nth-child(3) { width: 120px; }
    .didb-ai-review-table th:nth-child(4),
    .didb-ai-review-table td:nth-child(4) { width: 128px; }
    .didb-ai-review-table th:nth-child(5),
    .didb-ai-review-table td:nth-child(5) { width: 108px; text-align: center; }
    .didb-ai-review-table th:nth-child(6),
    .didb-ai-review-table td:nth-child(6) { width: 24%; }
    .didb-ai-review-table tr:hover td { background: #f8fbfe; }
    .didb-ai-chip {
        display: inline-flex; min-width: 84px; justify-content: center;
        border-radius: 2px; padding: 3px 7px; font-weight: 800;
        font-variant-numeric: tabular-nums;
    }
    .didb-ai-tablebar {
        height: 9px; background: #edf1f5; border-radius: 2px; overflow: hidden;
    }
    .didb-ai-findings {
        display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 9px;
    }
    @@media (max-width: 980px) {
        .didb-ai-findings { grid-template-columns: 1fr; }
    }
    .didb-ai-findings article {
        border: 1px solid var(--line, #dde1e7); background: #fbfcfd; border-radius: 2px;
        padding: 10px;
    }
    .didb-ai-finding-topic {
        color: #3866a3; font-weight: 800; font-size: 12px; margin-bottom: 5px;
    }
    .didb-ai-findings p,
    .didb-ai-panel p {
        margin: 0; font-size: 12px; line-height: 1.55; color: var(--ink, #0f1319);
    }
    .didb-ai-findings p {
        display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .didb-ai-findings blockquote {
        margin: 8px 0 0; padding-left: 9px; border-left: 3px solid #c8d1db;
        color: #526173; font-size: 11px; line-height: 1.45;
    }
    .didb-ai-checks {
        width: 100%; border-collapse: collapse; font-size: 12px;
    }
    .didb-ai-checks td {
        border-top: 1px solid #edf1f5; padding: 7px 6px; vertical-align: top;
    }
    .didb-ai-checks tr:first-child td { border-top: 0; }
    .didb-ai-checks td:first-child { width: 62px; }
    .didb-ai-checks strong {
        display: block; color: var(--ink, #0f1319); font-size: 12px; line-height: 1.35;
    }
    .didb-ai-checks div {
        margin-top: 3px; color: #526173; font-size: 11px; line-height: 1.4;
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .didb-ai-checks span:not(.didb-ai-strength) {
        display: block; margin-top: 3px; color: #8b98a8; font-size: 10px;
    }
    .didb-ai-strength {
        display: inline-flex; border-radius: 2px; padding: 2px 7px;
        color: var(--panel, #fff); font-size: 10px; font-weight: 800; white-space: nowrap;
    }
    .didb-ai-strength-strong { background: #c24135; }
    .didb-ai-strength-medium { background: #c47a1b; }
    .didb-ai-strength-weak   { background: #758195; }
    .didb-ai-list {
        margin: 0; padding-left: 18px; color: #354253; font-size: 12px; line-height: 1.5;
    }
    .didb-ai-list li { margin: 4px 0; }
    .didb-ai-tags {
        display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px;
    }
    .didb-ai-tags-spaced { margin-top: 12px; padding-top: 10px; border-top: 1px dashed var(--line, #dde1e7); }
    .didb-ai-log-grid { margin-top: 10px; }
    .didb-ai-more { margin-top: 10px; }
    .didb-ai-subtitle {
        margin: 10px 0 6px; color: #526173; font-size: 11px; font-weight: 800;
        text-transform: uppercase;
    }
    .didb-ai-metric-table th:first-child,
    .didb-ai-metric-table td:first-child { width: auto; }
    .didb-ai-status {
        display: inline-flex; align-items: center; justify-content: center;
        min-width: 54px; border-radius: 2px; padding: 3px 8px;
        font-size: 10px; font-weight: 800; background: #eef2f7; color: #526173;
    }
    .didb-ai-status.didb-ai-status-pass,
    .didb-ai-doe-cell.didb-ai-status-pass {
        background: #edf8f0; color: #21673c; border-color: #a9d9b8;
    }
    .didb-ai-status.didb-ai-status-fail,
    .didb-ai-doe-cell.didb-ai-status-fail {
        background: #fff1ef; color: #9b2419; border-color: #efb2aa;
    }
    .didb-ai-status.didb-ai-status-warn,
    .didb-ai-doe-cell.didb-ai-status-warn {
        background: #fff8eb; color: #8a570f; border-color: #edcf94;
    }
    .didb-ai-doe-grid {
        display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 8px; margin-bottom: 10px;
    }
    @@media (max-width: 980px) {
        .didb-ai-doe-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    .didb-ai-doe-cell {
        min-height: 78px; border-radius: 2px; border: 1px solid var(--line, #dde1e7);
        background: #fbfcfd; padding: 9px; display: flex; flex-direction: column;
        justify-content: space-between; overflow: hidden;
    }
    .didb-ai-doe-cell strong {
        color: var(--ink, #0f1319); font-size: 15px; font-variant-numeric: tabular-nums;
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .didb-ai-doe-cell span {
        color: #354253; font-size: 11px; font-weight: 800;
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .didb-ai-doe-cell em {
        color: #617084; font-style: normal; font-size: 10px;
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .didb-ai-image-note {
        border: 1px solid #edcf94; background: #fff8eb; color: #6e470d;
        border-radius: 2px; padding: 10px 12px; font-size: 12px; line-height: 1.45;
        margin-bottom: 10px;
    }
    .didb-ai-thumbs {
        display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 8px; margin-bottom: 10px;
    }
    @@media (max-width: 900px) {
        .didb-ai-thumbs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    .didb-ai-thumbs figure {
        margin: 0; border: 1px solid var(--line, #dde1e7); border-radius: 2px;
        background: #fbfcfd; overflow: hidden; min-width: 0;
    }
    .didb-ai-thumbs img {
        width: 100%; height: 96px; object-fit: contain; background: var(--panel, #fff);
        border-bottom: 1px solid #edf1f5;
    }
    .didb-ai-thumbs figcaption {
        padding: 5px 7px; font-size: 10px; color: #617084;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }

    /* Collapsible heavy section header inside the expanded row */
    .didb-section-toggle {
        display: flex; align-items: center; justify-content: space-between;
        width: 100%; padding: 8px 16px; background: #fafbfc; border: none;
        border-top: 1px solid var(--line, var(--line, #dde1e7));
        font-size: 12px; font-weight: 700; color: var(--ink, #0f1319); text-align: left;
        cursor: pointer;
    }
    .didb-section-toggle:hover { background: var(--panel-3, #eceef2); }
    .didb-section-arrow        { color: var(--ink-2, #4a5461); font-weight: 600; font-size: 10px; }

    /* Comparison-study sections in the expanded row (DbPage) */
    .didb-section       { margin-top: 8px; }
    .didb-section:first-of-type { margin-top: 0; }
    .didb-sec-label     {
        font-size: 10px; font-weight: 700; color: var(--ink-2, #4a5461);
        text-transform: uppercase; letter-spacing: .03em; margin-bottom: 2px;
    }
    .didb-sec-body      {
        margin: 0; padding: 4px 8px;
        font-family: inherit; font-size: 11px; color: var(--ink, #0f1319);
        line-height: 1.5; white-space: pre-wrap; word-wrap: break-word;
        background: var(--panel, #fff); border-left: 3px solid var(--line-2, #c6ccd5); border-radius: 2px;
    }
    .didb-section-conclusion .didb-sec-label { color: #1e3a8a; }
    .didb-conclusion-body {
        font-size: 12px !important; font-weight: 600;
        background: #eef2ff !important; border-left: 4px solid #4338ca;
        padding: 6px 10px;
    }
    .didb-section-setup .didb-sec-body {
        background: #fff7ed; border-left-color: #fb923c;
    }
    .didb-section-effect .didb-sec-body {
        background: #ecfdf5; border-left-color: #10b981; font-weight: 600;
    }

    /* Heatmap (Line × CheckType → avg NG%) */
    .didb-heatmap        { border-collapse: collapse; font-size: 11px; margin-top: 4px; }
    .didb-heatmap th, .didb-heatmap td {
        border: 1px solid var(--line, var(--line, #dde1e7)); padding: 3px 8px; min-width: 56px;
        text-align: center; white-space: nowrap;
    }
    .didb-heatmap th     { background: var(--panel-3, #eceef2); font-weight: 600; color: var(--ink-2, #4a5461); }
    .didb-heatmap td     { color: var(--ink, #0f1319); font-weight: 600; font-variant-numeric: tabular-nums; padding: 3px 6px; }
    .didb-heat-pct       { font-size: 11px; line-height: 1.1; }
    .didb-heat-ratio     { font-size: 9px;  font-weight: 500; opacity: .85; line-height: 1.2; }
    .didb-heat-defects   {
        font-size: 9px; font-weight: 500; opacity: .9;
        line-height: 1.3; margin-top: 3px;
        padding-top: 3px; border-top: 1px dashed rgba(0,0,0,.18);
        text-align: left;
    }
    .didb-heat-empty     { background: var(--panel-2, #f5f6f9); color: var(--line-2, #c6ccd5) !important; font-weight: 400; }

    /* Source-text view toggle (Table / Text) */
    .didb-view-toggle { display: inline-flex; gap: 2px; margin: 6px 0; }
    .didb-view-btn {
        border: 1px solid var(--line-2, #c6ccd5); background: var(--panel, #fff); color: var(--ink-2, #4a5461);
        padding: 1px 9px; border-radius: 2px; font-size: 10px; font-weight: 600;
        cursor: pointer; transition: all .12s; line-height: 1.5;
    }
    .didb-view-btn:hover  { background: var(--panel-3, #eceef2); }
    .didb-view-btn.active { background: #4338ca; border-color: #4338ca; color: var(--panel, #fff); }

    .didb-table-preview {
        max-height: 420px; overflow: auto;
        background: var(--panel, #fff); border: 1px solid var(--line-2, #c6ccd5); border-radius: 2px;
        padding: 8px;
    }
    .didb-sheet-name {
        font-size: 11px; font-weight: 700; color: var(--ink, #0f1319);
        background: var(--panel-3, #eceef2); padding: 3px 8px; border-radius: 2px;
        margin: 6px 0 4px;
    }
    .didb-sheet-name:first-child { margin-top: 0; }
    .didb-preview-table {
        border-collapse: collapse; font-size: 11px; width: max-content;
        font-family: ui-monospace, Consolas, monospace;
    }
    .didb-preview-table td {
        border: 1px solid var(--line, var(--line, #dde1e7)); padding: 2px 6px;
        white-space: nowrap; max-width: 240px; overflow: hidden;
        text-overflow: ellipsis; color: var(--ink, #0f1319);
    }
    .didb-heat-legend    {
        display: flex; gap: 6px; margin-top: 6px; font-size: 10px; color: var(--panel, #fff);
    }
    .didb-heat-legend span {
        padding: 2px 8px; border-radius: 2px; font-weight: 700;
    }
    .didb-findings   { font-size: 11px; color: var(--ink-2, #4a5461); white-space: pre-wrap; margin-top: 4px; }
    .didb-ctx-row    { font-size: 11px; color: var(--ink, #0f1319); margin-bottom: 3px; }
    .didb-ctx-key    {
        display: inline-block; min-width: 125px; font-weight: 600; color: #0369a1;
        margin-right: 4px;
    }
    .didb-tags-row   { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 6px; }
    .didb-tag        {
        display: inline-flex; align-items: center; padding: 2px 8px; border-radius: 2px;
        font-size: 10px; font-weight: 600; line-height: 1.4;
    }
    .didb-tag-keyword { background: #e0e7ff; color: #4338ca; }
    .didb-tag-del     {
        margin-left: 4px; border: none; background: transparent; padding: 0;
        color: inherit; opacity: .5; cursor: pointer; font-size: 9px; line-height: 1;
        font-weight: 700;
    }
    .didb-tag-del:hover { opacity: 1; color: #dc2626; }

    /* Images */
    .didb-imgs-wrap  {
        padding: 10px 16px 12px 40px; background: var(--panel-2, #f5f6f9);
        border-top: 1px solid var(--line, var(--line, #dde1e7));
    }
    .didb-imgs-title { font-size: 12px; font-weight: 600; color: var(--ink-2, #4a5461); margin-bottom: 6px; }
    .didb-imgs-grid  { display: flex; flex-wrap: wrap; gap: 8px; }
    .didb-img-thumb  {
        position: relative; width: 120px; height: 120px; border-radius: 2px;
        overflow: hidden; border: 1px solid var(--line, var(--line, #dde1e7)); background: var(--panel, #fff);
        cursor: pointer; transition: transform .12s, box-shadow .12s;
    }
    .didb-img-thumb:hover { transform: scale(1.03);}
    .didb-img-thumb img   { width: 100%; height: 100%; object-fit: cover; }
    .didb-img-num    {
        position: absolute; bottom: 3px; left: 5px; font-size: 10px;
        color: rgba(255,255,255,.95); text-shadow: 0 1px 3px rgba(0,0,0,.7); font-weight: 700;
    }

    /* Viewer */
    .didb-viewer-overlay {
        position: fixed; inset: 0; background: rgba(0,0,0,.85); z-index: 9500;
        display: flex; align-items: center; justify-content: center; cursor: zoom-out;
    }
    .didb-viewer-img     { max-width: 94vw; max-height: 92vh; object-fit: contain; cursor: auto; }
    .didb-viewer-close   {
        position: absolute; top: 16px; right: 20px; width: 36px; height: 36px;
        border-radius: 50%; border: none; background: rgba(255,255,255,.2);
        color: var(--panel, #fff); font-size: 18px; cursor: pointer;
    }
    .didb-viewer-close:hover { background: rgba(255,255,255,.35); }

    /* Backup files */
    .didb-files-list  { display: flex; flex-wrap: wrap; gap: 6px; }
    .didb-file-chip   {
        display: inline-flex; align-items: center; gap: 6px;
        background: var(--panel-3, #eceef2); border: 1px solid var(--line, var(--line, #dde1e7)); border-radius: 2px;
        padding: 4px 10px; font-size: 12px; color: var(--ink-2, #4a5461); text-decoration: none;
        transition: all .12s;
    }
    .didb-file-chip:hover { background: #e0e7ff; border-color: #4338ca; color: var(--ink, #0f1319); }
    .didb-file-icon   { font-size: 13px; }
    .didb-file-name   { max-width: 260px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; }
    .didb-file-size   { color: var(--ink-3, #7f8a98); font-size: 10px; }
    .didb-sub-wrap   { max-height: 280px; overflow: auto; padding-left: 40px; }
    .didb-sub        { border-collapse: collapse; font-size: 11px; width: 100%; }
    .didb-sub th, .didb-sub td {
        border: 1px solid var(--line, var(--line, #dde1e7)); padding: 3px 7px; white-space: nowrap;
    }
    .didb-sub th     { background: var(--panel-2, #f5f6f9); font-weight: 600; color: var(--ink-2, #4a5461); }
    .didb-edit-cell  { cursor: text; }
    .didb-edit-cell:hover { background: #f0f9ff; outline: 1px dashed #93c5fd; }
    .didb-edit-input {
        width: 100%; border: 1px solid #3b82f6; border-radius: 2px;
        padding: 1px 4px; font: inherit; box-sizing: border-box;
        background: var(--panel, #fff);
    }

    /* Delete confirm */
    .didb-overlay    {
        position: fixed; inset: 0; background: rgba(0,0,0,.35); z-index: 9000;
        display: flex; align-items: center; justify-content: center;
    }
    .didb-confirm    {
        background: var(--panel, #fff); border-radius: 2px; padding: 20px 24px;
min-width: 340px; max-width: 480px;
    }
