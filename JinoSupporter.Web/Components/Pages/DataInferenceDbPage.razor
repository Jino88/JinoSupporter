    .didb-ai-brief-list li::before {
        content: "- "; color: #617084; font-weight: 900;
    }
    .didb-ai-kpi em {
        display: block; margin-top: 5px; color: #617084; font-size: 11px;
        font-style: normal; line-height: 1.35; overflow-wrap: anywhere;
    }
    .didb-ai-grid {
        display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(320px, .9fr);
        gap: 10px; margin-top: 10px;
