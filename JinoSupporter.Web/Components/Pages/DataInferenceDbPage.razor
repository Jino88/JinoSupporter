    @@media (max-width: 1100px) {
        .didb-ai-grid { grid-template-columns: 1fr; }
    }
    .didb-ai-panel {
        background: #fff; border: 1px solid #d9e0e7; border-radius: 8px;
        padding: 13px; min-width: 0;
    }
    .didb-ai-panel-wide { min-width: 0; }
    .didb-ai-full { margin-top: 10px; }
    .didb-ai-panel h3 {
        margin: 0 0 9px 0; font-size: 13px; color: #17202a; font-weight: 800;
