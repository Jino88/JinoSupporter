        foreach (string label in new[] { "목적", "시험 의도", "Purpose", "Test intent", "Goal" })
        {
            AddTagCandidates(tags, ExtractLabeledInputDataTags(text, label));
        }
        AddTagCandidates(tags, ExtractMalformedInputDataFrontItems(text, 3));
        AddTagCandidates(tags, SplitTagText(doc.Purpose));
        if (tags.Count == 0)
            AddTagCandidates(tags, ExtractMalformedInputDataFrontValues(text).Take(1));
        if (tags.Count > 0) return tags;

        foreach (string label in new[] { "검토 목적", "Review purpose" })
        {
            AddTagCandidates(tags, ExtractLabeledInputDataTags(text, label));
        }
        return tags.Count == 0 ? ["분석 목적 확인"] : tags;
    }

    private static List<string> BuildInputDataCheckTags(AiDocBundle doc, string text)
    {
        string haystack = (doc.Title + " " + doc.Purpose + " " + doc.GeneratedReportMarkdown + " " + text).ToLowerInvariant();
        var tags = new List<string>();
        foreach (string label in new[]
                 {
                     "검토 태그", "검토 항목", "검토사항", "검토 사항", "확인 항목",
                     "대상불량", "대상 불량",
                     "Review tags", "Review item", "Review items", "Check tags", "Check item", "Check items",
                     "Target defect", "Target defects"
                 })
        {
            AddTagCandidates(tags, ExtractLabeledInputDataTags(text, label));
        }
        AddTagCandidates(tags, ExtractMalformedInputDataFrontItems(text, 4));
        AddTagCandidates(tags, ExtractMalformedInputDataFrontItems(text, 5));
        AddTagCandidates(tags, ExtractMalformedInputDataFrontItems(text, 2));
        AddTagCandidates(tags, [doc.PrimaryDefect]);
        AddTagCandidates(tags, doc.RelatedDefects);
        AddTagCandidates(tags, doc.Parts);
        AddTagCandidates(tags, doc.Processes);
        foreach (var result in doc.Results)
        {
            AddTagCandidates(tags,
            [
                result.ConditionProcess,
                result.ChangedFactor,
                result.MeasurementType,
                result.MetricName
            ]);
        }
        foreach (var hint in doc.Hints)
        {
            AddTagCandidates(tags,
            [
                hint.CheckItem,
                hint.DefectName,
                hint.RelatedProcess,
                hint.RelatedPart
            ]);
        }

        var candidates = new[]
        {
            "Laser cutting", "VP bending", "Vision", "Function", "Hearing",
            "Noise", "Touch", "SPL", "THD", "F0", "VP/CD", "Line",
            "Mold", "Supplier", "Block test",
            "Old lot", "New lot"
        };

        AddTagCandidates(tags, candidates.Where(k => haystack.Contains(k.ToLowerInvariant())));
        return tags.Count == 0 ? ["결과 확인"] : tags;
    }

    private static void AddTagCandidates(List<string> tags, IEnumerable<string?> values)
    {
        foreach (string? value in values)
        {
            string tag = CleanInputDataTag(value);
            if (!string.IsNullOrWhiteSpace(tag)
                && !tags.Contains(tag, StringComparer.OrdinalIgnoreCase))
            {
                tags.Add(tag);
            }
        }
    }

    private static IEnumerable<string> ExtractLabeledInputDataTags(string? text, string label)
    {
        if (string.IsNullOrWhiteSpace(text)) yield break;
        string[] lines = text.Replace("\r\n", "\n").Split('\n');
        for (int i = 0; i < lines.Length; i++)
        {
            string line = System.Text.RegularExpressions.Regex.Replace(lines[i], @"\s+", " ").Trim();
            if (line.Length == 0) continue;

            System.Text.RegularExpressions.Match match = System.Text.RegularExpressions.Regex.Match(
                line,
                @"^\s*" + System.Text.RegularExpressions.Regex.Escape(label) + @"\s*[:：]\s*(.{2,180})$",
                System.Text.RegularExpressions.RegexOptions.IgnoreCase);
            if (!match.Success) continue;

            foreach (string tag in SplitTagText(match.Groups[1].Value))
                yield return tag;
            continue;
        }

        for (int i = 0; i < lines.Length - 1; i++)
        {
            string line = System.Text.RegularExpressions.Regex.Replace(lines[i], @"\s+", " ").Trim(' ', '#', '-', '*', '·', ':', '：');
            if (!line.Equals(label, StringComparison.OrdinalIgnoreCase)) continue;

            for (int j = i + 1; j < lines.Length && j <= i + 3; j++)
            {
                string next = System.Text.RegularExpressions.Regex.Replace(lines[j], @"\s+", " ").Trim(' ', '-', '*', '·', ':', '：');
                if (next.Length < 2) continue;
                foreach (string tag in SplitTagText(next))
                    yield return tag;
                break;
            }
        }
    }

    private static IEnumerable<string> SplitTagText(string value)
        => System.Text.RegularExpressions.Regex.Split(value ?? "", @"[,\n;|，、]+")
            .Select(x => x.Trim(' ', '-', '*', '·', ':', '：'))
            .Where(x => x.Length >= 2);

    private static string CleanInputDataTag(string? value)
    {
        string tag = System.Text.RegularExpressions.Regex.Replace(value ?? "", "<[^>]+>", " ");
        tag = System.Text.RegularExpressions.Regex.Replace(tag, @"\s+", " ").Trim(' ', '-', '*', '·', ':', '：');
        tag = StripMalformedInputDataLabelPrefix(tag);
        tag = System.Text.RegularExpressions.Regex.Replace(
            tag,
            @"^(검토\s*목적|목적|시험\s*의도|검토\s*태그|검토\s*항목|검토\s*사항|검토사항|확인\s*항목|대상\s*불량|대상불량|review\s*purpose|purpose|test\s*intent|goal|review\s*tags?|review\s*items?|check\s*tags?|check\s*items?|target\s*defects?)\s*[:：]\s*",
            "",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase).Trim();

        if (tag.Length < 2) return "";
        if (LooksLikeMalformedInputDataValue(tag)) return "";
        if (LooksLikeSourceFileTag(tag)) return "";
        if (IsGenericInputDataTag(tag)) return "";
        return tag;
    }

    private static bool LooksLikeSourceFileTag(string tag)
    {
        string s = tag.Trim();
        if (s.Contains(".xlsx", StringComparison.OrdinalIgnoreCase)
            || s.Contains(".xlsm", StringComparison.OrdinalIgnoreCase)
            || s.Contains("_clean_textonly", StringComparison.OrdinalIgnoreCase)
            || s.Contains("_textonly", StringComparison.OrdinalIgnoreCase))
            return true;

        if (System.Text.RegularExpressions.Regex.IsMatch(s, @"^[0-9a-f]{12,16}[_-]", System.Text.RegularExpressions.RegexOptions.IgnoreCase))
            return true;

        return s.Length > 45
               && System.Text.RegularExpressions.Regex.IsMatch(s, @"\b(report|result|test|summary)\b", System.Text.RegularExpressions.RegexOptions.IgnoreCase)
               && System.Text.RegularExpressions.Regex.IsMatch(s, @"\b(clean|textonly|copy|date|\d{4}[.-]\d{1,2}[.-]\d{1,2})\b", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
    }

    private static bool IsGenericInputDataTag(string tag)
    {
        string s = tag.Trim().ToLowerInvariant();
        string[] generic =
        [
            "input data", "input data test", "workbook analysis", "analysis",
            "report", "result", "test", "normal", "ok", "ng", "date", "line",
            "source file", "dataset", "file", "sheet", "input_data_test_analysis",
            "lot", "material", "ng rate", "rate"
        ];
        return generic.Contains(s, StringComparer.OrdinalIgnoreCase);
    }

    private static string ShortTag(string value)
    {
        string tag = System.Text.RegularExpressions.Regex.Replace(value ?? "", @"\s+", " ").Trim();
        return tag.Length <= 34 ? tag : tag[..34].Trim() + "...";
    }

    private static void AppendInputDataBrief(System.Text.StringBuilder sb, string text, string? markdown)
    {
        var bullets = ExtractBriefLines(text)
            .Concat(ExtractBriefLines(markdown))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(4)
            .ToList();
        if (bullets.Count == 0) bullets.Add("AI 분석 원문을 표시용 요약 형태로 정리했습니다.");

        sb.Append("<section class=\"idt-brief\"><h3>해석</h3><ul>");
        foreach (string bullet in bullets)
        {
            sb.Append("<li>").Append(HtmlEnc(ShortSentence(bullet))).Append("</li>");
        }
        sb.Append("</ul></section>");
    }

    private static IEnumerable<string> ExtractBriefLines(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) yield break;
        foreach (string raw in System.Text.RegularExpressions.Regex.Split(text, @"\r?\n+"))
        {
            string line = System.Text.RegularExpressions.Regex.Replace(raw, @"\s+", " ").Trim(' ', '-', '*', '·');
            if (line.Length < 12) continue;
            if (line.Contains('|')) continue;
            if (line.StartsWith("Date ", StringComparison.OrdinalIgnoreCase)) continue;
            if (IsInputDataFrontMetadataLine(line)) continue;
            line = StripMalformedInputDataLabelPrefix(line);
            if (line.Length < 12) continue;
            yield return line;
        }
    }

    private static bool IsInputDataFrontMetadataLine(string line)
    {
        string text = System.Text.RegularExpressions.Regex.Replace(line ?? "", @"\s+", " ").Trim();
        if (text.Length == 0) return false;
        if (System.Text.RegularExpressions.Regex.IsMatch(text, @"^[?\s]{2,}[:：]")) return true;
        if (LooksLikeMalformedInputDataMetadataLine(text)) return true;
        if (TrySplitMalformedInputDataLabelRow(text, out _, out _)) return true;

        string lower = text.ToLowerInvariant();
        string[] prefixes =
        [
            "검토 목적:", "검토 태그:", "목적:", "대상불량:", "대상 불량:", "검토사항:", "검토 사항:",
            "model:", "date:", "confidence:", "review purpose:", "review tags:",
            "purpose:", "target defect:", "review item:", "review items:"
        ];
        return prefixes.Any(p => lower.StartsWith(p.ToLowerInvariant(), StringComparison.Ordinal));
    }

    private static string ShortSentence(string value)
    {
        string text = System.Text.RegularExpressions.Regex.Replace(value ?? "", @"\s+", " ").Trim();
        text = StripMalformedInputDataLabelPrefix(text);
        return text.Length <= 120 ? text : text[..120].Trim() + "...";
    }

    private static IEnumerable<string> ExtractMalformedInputDataFrontValues(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) yield break;
        foreach (string raw in System.Text.RegularExpressions.Regex.Split(text, @"\r?\n+").Take(10))
        {
            string line = System.Text.RegularExpressions.Regex.Replace(raw, @"\s+", " ").Trim(' ', '-', '*', '·');
            if (!TryGetMalformedInputDataMetadataValue(line, out string value)) continue;

            if (value.Length >= 2) yield return value;
        }
    }

    private static IEnumerable<string> ExtractMalformedInputDataFrontItems(string? text, int ordinal)
    {
        int index = 0;
        foreach (string value in ExtractMalformedInputDataFrontValues(text))
        {
            index++;
            if (index != ordinal) continue;
            foreach (string item in SplitTagText(value))
                yield return item;
            yield break;
        }
    }

    private static bool LooksLikeMalformedInputDataMetadataLine(string line)
    {
        string text = System.Text.RegularExpressions.Regex.Replace(line ?? "", @"\s+", " ").Trim();
        int colon = FirstInputDataColonIndex(text);
        if (colon <= 0 || colon > 40) return false;

        string value = text[(colon + 1)..].Trim(' ', '-', '*', '·', ':', '：');
        return value.Length >= 2
               && value.Length <= 240
               && LooksLikeMalformedInputDataLabel(text[..colon]);
    }

    private static string StripMalformedInputDataLabelPrefix(string value)
    {
        string text = System.Text.RegularExpressions.Regex.Replace(value ?? "", @"\s+", " ").Trim(' ', '-', '*', '·', ':', '：');
        if (TrySplitMalformedInputDataLabelRow(text, out _, out string rowValue))
            return rowValue;

        int colon = FirstInputDataColonIndex(text);
        if (colon <= 0 || colon > 40) return text;

        string prefix = text[..colon].Trim();
        string remainder = text[(colon + 1)..].Trim(' ', '-', '*', '·', ':', '：');
        if (remainder.Length < 2) return text;
        return LooksLikeMalformedInputDataLabel(prefix) ? remainder : text;
    }

    private static bool TryGetMalformedInputDataMetadataValue(string line, out string value)
    {
        value = "";
        string text = System.Text.RegularExpressions.Regex.Replace(line ?? "", @"\s+", " ").Trim(' ', '-', '*', '·');
        if (TrySplitMalformedInputDataLabelRow(text, out _, out value))
            return true;

        int colon = FirstInputDataColonIndex(text);
        if (colon <= 0 || colon > 40) return false;
        if (!LooksLikeMalformedInputDataLabel(text[..colon])) return false;

        value = text[(colon + 1)..].Trim(' ', '-', '*', '·', ':', '：');
        return value.Length >= 2;
    }

    private static bool TrySplitMalformedInputDataLabelRow(string line, out string label, out string value)
    {
        label = "";
        value = "";
        string text = System.Text.RegularExpressions.Regex.Replace(line ?? "", @"\s+", " ").Trim(' ', '-', '*', '·');
        if (text.Length == 0) return false;

        System.Text.RegularExpressions.Match m = System.Text.RegularExpressions.Regex.Match(text, @"^(\S{2,40})\s+(.{2,240})$");
        if (!m.Success) return false;
        string first = m.Groups[1].Value.Trim();
        if (!LooksLikeMalformedInputDataLabel(first)) return false;

        label = first;
        value = m.Groups[2].Value.Trim(' ', '-', '*', '·', ':', '：');
        return value.Length >= 2;
    }

    private static int FirstInputDataColonIndex(string text)
    {
        int ascii = (text ?? "").IndexOf(':');
        int wide = (text ?? "").IndexOf('：');
        if (ascii < 0) return wide;
        if (wide < 0) return ascii;
        return Math.Min(ascii, wide);
    }

    private static bool LooksLikeMalformedInputDataLabel(string value)
    {
        string text = System.Text.RegularExpressions.Regex.Replace(value ?? "", @"\s+", "");
        if (text.Length == 0 || text.Length > 40) return false;
        if (text.Contains('?') || text.Contains('\uFFFD')) return true;

        foreach (char ch in text)
        {
            if (char.IsControl(ch)) return true;
            if (ch is >= '\u0080' and <= '\u009F') return true;
            if (ch is >= '\u4E00' and <= '\u9FFF') return true;
            if (ch is >= '\uF900' and <= '\uFAFF') return true;
        }
        return false;
    }

    private static bool LooksLikeMalformedInputDataValue(string value)
    {
        string text = System.Text.RegularExpressions.Regex.Replace(value ?? "", @"\s+", " ").Trim();
        if (text.Length == 0) return false;
        if (text.Contains('\uFFFD')) return true;
        if (text.Contains('?') && text.Any(ch => ch is >= '\u0080')) return true;
        return text.Any(ch => ch is >= '\u0080' and <= '\u009F');
    }

    private static List<InputDataDisplayTable> ExtractInputDataTables(string html)
    {
        var result = new List<InputDataDisplayTable>();
        if (string.IsNullOrWhiteSpace(html)) return result;

        var matches = System.Text.RegularExpressions.Regex.Matches(
            html,
            @"<table\b[^>]*>(.*?)</table>",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.Singleline);

        foreach (System.Text.RegularExpressions.Match match in matches)
        {
            var rowMatches = System.Text.RegularExpressions.Regex.Matches(
                match.Groups[1].Value,
                @"<tr\b[^>]*>(.*?)</tr>",
                System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.Singleline);
            if (rowMatches.Count == 0) continue;

            var parsedRows = rowMatches
                .Select(r => ExtractHtmlCells(r.Groups[1].Value))
                .Where(cells => cells.Count > 0)
                .ToList();
            if (parsedRows.Count < 2) continue;
            if (LooksLikeInputDataMetadataTable(parsedRows)) continue;

            List<string> headers = parsedRows[0];
            List<List<string>> rows = parsedRows.Skip(1).ToList();
            int maxCols = Math.Max(headers.Count, rows.Select(r => r.Count).DefaultIfEmpty(0).Max());
            if (maxCols == 0) continue;
            while (headers.Count < maxCols) headers.Add($"C{headers.Count + 1}");
            foreach (var row in rows)
                while (row.Count < maxCols) row.Add("");

            result.Add(new InputDataDisplayTable(headers, rows));
        }
        return result;
    }

    private static bool LooksLikeInputDataMetadataTable(List<List<string>> rows)
    {
        if (rows.Count < 4) return false;

        int maxCols = rows.Select(r => r.Count).DefaultIfEmpty(0).Max();
        if (maxCols > 2) return false;

        int labelHits = rows
            .Select(r => CellAt(r, 0))
            .Count(IsInputDataMetadataLabel);
        return labelHits >= 3;
    }

    private static bool IsInputDataMetadataLabel(string value)
    {
        string s = System.Text.RegularExpressions.Regex.Replace(value ?? "", @"\s+", " ").Trim();
        if (s.Length == 0) return false;

        string lower = s.ToLowerInvariant();
        string[] labels =
        [
            "검토 목적", "검토 태그", "목적", "대상불량", "대상 불량", "검토사항", "검토 사항",
            "model", "date", "confidence", "review purpose", "review tags", "purpose",
            "target defect", "review item", "review items"
        ];
        if (labels.Contains(lower, StringComparer.OrdinalIgnoreCase)) return true;

        if (LooksLikeMalformedInputDataLabel(s)) return true;
        return s is "??" or "?? ??" or "????";
    }

    private static List<string> ExtractHtmlCells(string rowHtml)
    {
        var cells = new List<string>();
        var matches = System.Text.RegularExpressions.Regex.Matches(
            rowHtml,
            @"<t[hd]\b[^>]*>(.*?)</t[hd]>",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.Singleline);
        foreach (System.Text.RegularExpressions.Match match in matches)
            cells.Add(PlainTextFromHtml(match.Groups[1].Value));
        return cells;
    }

    private static void AppendProcessSeparatedTable(System.Text.StringBuilder sb, InputDataDisplayTable table)
    {
        int processIdx = FindColumn(table.Headers, "process", "process block", "공정", "프로세스");
        var displayRows = ExpandBundledReviewRows(table.Headers, table.Rows);
        var groups = processIdx >= 0
            ? displayRows.GroupBy(r => FirstDisplayValue(CellAt(r, processIdx), "Unknown Process"), StringComparer.OrdinalIgnoreCase)
            : displayRows.GroupBy(_ => "Result", StringComparer.OrdinalIgnoreCase);

        foreach (var group in groups)
        {
            var rows = group.ToList();
            sb.Append("<section class=\"idt-process\"><h3>Process: ")
              .Append(HtmlEnc(ShortSentence(group.Key)))
              .Append("</h3>");
            AppendHtmlTable(sb, table.Headers, rows, processIdx);
            sb.Append("</section>");
        }
    }

    private static List<List<string>> ExpandBundledReviewRows(List<string> headers, List<List<string>> rows)
    {
        var expanded = new List<List<string>>();
        foreach (var row in rows)
        {
            var partsByColumn = new Dictionary<int, List<string>>();
            for (int i = 0; i < headers.Count; i++)
            {
                List<string> parts = SplitParallelCell(headers[i], CellAt(row, i));
                if (parts.Count > 1) partsByColumn[i] = parts;
            }

            int maxParts = partsByColumn.Values.Select(x => x.Count).DefaultIfEmpty(1).Max();
            int alignedColumns = partsByColumn.Values.Count(x => x.Count == maxParts);
            if (maxParts <= 1 || alignedColumns < 2)
            {
                expanded.Add(row);
                continue;
            }

            for (int partIndex = 0; partIndex < maxParts; partIndex++)
            {
                var next = new List<string>(row);
                for (int col = 0; col < headers.Count; col++)
                {
                    if (!partsByColumn.TryGetValue(col, out List<string>? parts)) continue;
                    next[col] = parts.Count == maxParts
                        ? parts[partIndex]
                        : FirstDisplayValue(parts.FirstOrDefault(), CellAt(row, col));
                }
                expanded.Add(next);
            }
        }
        return expanded;
    }

    private static List<string> SplitParallelCell(string header, string value)
    {
        string text = System.Text.RegularExpressions.Regex.Replace(value ?? "", @"\s+", " ").Trim();
        if (text.Length == 0) return [""];

        string h = (header ?? "").ToLowerInvariant();
        bool canSplit = h.Contains("test") || h.Contains("condition") || h.Contains("factor")
                        || h.Contains("type") || h.Contains("input") || h.Contains("ok")
                        || h.Contains("ng") || h.Contains("rate") || h.Contains("result")
                        || h.Contains("judge");
        if (!canSplit) return [text];

        string[] parts;
        if (System.Text.RegularExpressions.Regex.IsMatch(text, @"\s+vs\.?\s+", System.Text.RegularExpressions.RegexOptions.IgnoreCase))
        {
            parts = System.Text.RegularExpressions.Regex.Split(text, @"\s+vs\.?\s+", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        }
        else if (text.Contains(',') && (h.Contains("factor") || h.Contains("input") || h.Contains("ok") || h.Contains("ng") || h.Contains("rate") || h.Contains("result") || h.Contains("test") || h.Contains("condition")))
        {
            parts = text.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
        }
        else if ((h.Contains("factor") || h.Contains("test") || h.Contains("condition") || h.Contains("type"))
                 && System.Text.RegularExpressions.Regex.IsMatch(text, @"\s+/\s+"))
        {
            parts = System.Text.RegularExpressions.Regex.Split(text, @"\s+/\s+");
        }
        else
        {
            return [text];
        }

        var cleaned = parts
            .Select(p => System.Text.RegularExpressions.Regex.Replace(p, @"\s+", " ").Trim())
            .Where(p => p.Length > 0)
            .ToList();
        if (cleaned.Count <= 1) return [text];

        if (cleaned[0].StartsWith("VP ", StringComparison.OrdinalIgnoreCase))
        {
            for (int i = 1; i < cleaned.Count; i++)
                if (cleaned[i].StartsWith("#", StringComparison.Ordinal))
                    cleaned[i] = "VP " + cleaned[i];
        }

        return cleaned;
    }

    private static void AppendHtmlTable(System.Text.StringBuilder sb, List<string> headers, List<List<string>> rows, int hiddenIndex)
    {
        var indexes = Enumerable.Range(0, headers.Count)
            .Where(i => i != hiddenIndex)
            .Take(14)
            .ToList();
        sb.Append("<table><thead><tr>");
        foreach (int i in indexes) sb.Append("<th>").Append(HtmlEnc(headers[i])).Append("</th>");
        sb.Append("</tr></thead><tbody>");
        foreach (var row in rows)
        {
            sb.Append("<tr>");
            foreach (int i in indexes) sb.Append("<td>").Append(HtmlEnc(CellAt(row, i))).Append("</td>");
            sb.Append("</tr>");
        }
        sb.Append("</tbody></table>");
    }

    private static int FindColumn(List<string> headers, params string[] keywords)
    {
        for (int i = 0; i < headers.Count; i++)
        {
            string header = (headers[i] ?? "").Trim().ToLowerInvariant();
            if (keywords.Any(k => header.Contains(k.ToLowerInvariant()))) return i;
        }
        return -1;
    }

    private static string CellAt(List<string> row, int index)
        => index >= 0 && index < row.Count ? row[index] : "";

    private static string FirstDisplayValue(params string?[] values)
        => values.FirstOrDefault(v => !string.IsNullOrWhiteSpace(v))?.Trim() ?? "";

    private static double? FirstNumber(string text)
    {
        System.Text.RegularExpressions.Match m = System.Text.RegularExpressions.Regex.Match(text ?? "", @"-?\d+(?:\.\d+)?");
        if (!m.Success) return null;
        return double.TryParse(m.Value, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out double value)
            ? value
            : null;
    }

    private static string PlainTextFromHtml(string html)
    {
        if (string.IsNullOrWhiteSpace(html)) return "";
        string text = System.Text.RegularExpressions.Regex.Replace(html, @"<br\s*/?>", "\n", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        text = System.Text.RegularExpressions.Regex.Replace(text, @"</(p|div|li|tr|h[1-6])>", "\n", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        text = System.Text.RegularExpressions.Regex.Replace(text, @"<[^>]+>", " ");
        text = System.Net.WebUtility.HtmlDecode(text);
        return System.Text.RegularExpressions.Regex.Replace(text, @"[ \t]+", " ").Trim();
    }

    private static string HtmlEnc(string? value)
        => System.Net.WebUtility.HtmlEncode(value ?? "");

