    private static bool IsAiComparableNumericMetric(AiResultRow r)
        => r.MetricValue.HasValue && !IsAiNgRateResult(r);

    private static string AiProcessFamilyLabel(AiResultRow r)
    {
        string text = AiMetricLabel(r);
        string measurement = r.MeasurementType ?? "";
        string search = NormalizeAiText(string.Join(' ', measurement, text));
        if (search.Contains("vision sm", StringComparison.OrdinalIgnoreCase)
            || search.Contains("sm vision", StringComparison.OrdinalIgnoreCase)) return "Vision SM";
        if (search.Contains("vision yoke", StringComparison.OrdinalIgnoreCase)
            || search.Contains("yoke vision", StringComparison.OrdinalIgnoreCase)) return "Vision Yoke";
        if (search.Contains("tension", StringComparison.OrdinalIgnoreCase)) return "Tension";
        if (search.Contains("function", StringComparison.OrdinalIgnoreCase)) return "Function";
        if (search.Contains("drop", StringComparison.OrdinalIgnoreCase)) return "Drop Test";
        if (search.Contains("decap", StringComparison.OrdinalIgnoreCase)
            || search.Contains("separate glue", StringComparison.OrdinalIgnoreCase)) return "Decap Separate Glue";
        if (!string.IsNullOrWhiteSpace(measurement)) return measurement;
        return text;
    }

    private static int AiProcessSortRank(string process)
    {
        string p = NormalizeAiText(process);
        if (p.Contains("vision")) return 10;
        if (p.Contains("decap") || p.Contains("glue")) return 20;
        if (p.Contains("tension")) return 30;
        if (p.Contains("drop")) return 40;
        if (p.Contains("function")) return 50;
        return 90;
    }

    private static string AiReviewMetricLabel(AiResultRow r, string process)
    {
        string metric = AiMetricLabel(r);
        string normalized = NormalizeAiText(metric);
        if (normalized.Contains("total ng rate")) return "Total NG Rate";
        if (metric.StartsWith(process, StringComparison.OrdinalIgnoreCase))
            metric = metric[process.Length..].Trim();
        if (metric.StartsWith("Tension ", StringComparison.OrdinalIgnoreCase))
            metric = metric["Tension ".Length..].Trim();
        return string.IsNullOrWhiteSpace(metric) ? AiResultLabel(r) : metric;
    }

    private static string AiInputNgDetail(AiResultRow r)
    {
        var parts = new List<string>();
        if (r.InputCount.HasValue) parts.Add("Input " + AiCount(r.InputCount));
        if (r.NgCount.HasValue) parts.Add("NG " + AiCount(r.NgCount));
        return string.Join(", ", parts);
    }

    private static string AiSampleJudgementDetail(AiResultRow r)
    {
        var parts = new List<string>();
        if (r.InputCount.HasValue) parts.Add("n=" + AiCount(r.InputCount));
        if (!string.IsNullOrWhiteSpace(r.Judgement)) parts.Add(r.Judgement);
        return string.Join(", ", parts);
    }

    private static string AiMetricReviewResultText(AiMetricComparison c)
    {
        string judgement = c.Variant.Judgement ?? "";
        string change = AiMetricDirectionText(c.RelativeChangePct);
        if (!string.IsNullOrWhiteSpace(judgement) && !string.IsNullOrWhiteSpace(change))
            return $"{judgement} ({change})";
        if (!string.IsNullOrWhiteSpace(judgement)) return judgement;
        return string.IsNullOrWhiteSpace(change) ? "-" : change;
    }

    private static string AiMetricDirectionText(double? relativeChangePct)
    {
        if (!relativeChangePct.HasValue) return "";
        double v = relativeChangePct.Value;
        if (Math.Abs(v) < 0.5) return "변화 없음";
        return (v > 0 ? "+" : "") + v.ToString("F1") + "% " + (v > 0 ? "상승" : "하락");
    }

    private static string AiMetricReviewHeatClass(AiMetricComparison c)
    {
        string cls = AiJudgementClass(c.Variant);
        if (cls == "didb-ai-status-fail") return "didb-ai-heat-worse";
        if (cls == "didb-ai-status-pass") return "didb-ai-heat-improved";
        if (cls == "didb-ai-status-warn") return "didb-ai-heat-flat";
        return "didb-ai-heat-flat";
    }

    private static string AiMetricEventLabel(AiMetricComparison c)
    {
        var parts = new List<string>();
        string date = !string.IsNullOrWhiteSpace(c.Variant.ResultDate) ? c.Variant.ResultDate : c.Baseline.ResultDate;
        string line = !string.IsNullOrWhiteSpace(c.Variant.Line) ? c.Variant.Line : c.Baseline.Line;
        if (!string.IsNullOrWhiteSpace(date)) parts.Add(DisplayExcelDate(date));
        if (!string.IsNullOrWhiteSpace(line)) parts.Add(line);
        return string.Join(" | ", parts);
    }

    private static string AiReviewSourceLabel(AiResultRow r)
    {
        string source = AiSourceLabel(r);
        string date = r.ResultDate ?? "";
        string line = r.Line ?? "";
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(source)) parts.Add(source);
        if (!string.IsNullOrWhiteSpace(date)) parts.Add(DisplayExcelDate(date));
        if (!string.IsNullOrWhiteSpace(line)) parts.Add(line);
        return string.Join(" | ", parts);
    }

    private static string AiSourceCellsLabel(params AiResultRow[] rows)
    {
        var cells = new List<string>();
        foreach (var row in rows)
        {
            string raw = row.SourceCellsJson ?? "";
            if (string.IsNullOrWhiteSpace(raw)) continue;
            try
            {
                var parsed = System.Text.Json.JsonSerializer.Deserialize<List<string>>(raw);
                if (parsed is not null) cells.AddRange(parsed.Where(x => !string.IsNullOrWhiteSpace(x)));
            }
            catch
            {
                cells.Add(raw);
            }
        }
        return string.Join(" / ", cells.Distinct(StringComparer.OrdinalIgnoreCase).Take(3));
    }

    private static List<AiAbsoluteNgRow> BuildAiAbsoluteNgRows(AiDocBundle doc)
        => doc.Results
            .Select(r => new { Row = r, Rate = AiNgRatePercent(r) })
            .Where(x => x.Rate.HasValue)
            .Select(x => new AiAbsoluteNgRow(
                x.Row,
                AiAbsoluteConditionLabel(x.Row),
                x.Rate!.Value,
                x.Row.InputCount,
                x.Row.NgCount))
            .OrderByDescending(x => x.RatePercent)
            .ThenByDescending(x => x.InputCount ?? 0)
            .ToList();

    private static List<AiAbsoluteNgGroup> BuildAiAbsoluteNgGroups(List<AiAbsoluteNgRow> rows)
        => rows
            .GroupBy(AiAbsoluteProcessLabel, StringComparer.OrdinalIgnoreCase)
            .Select(g =>
            {
                var ordered = g.OrderByDescending(x => x.RatePercent)
                    .ThenByDescending(x => x.InputCount ?? 0)
                    .ToList();
                return new AiAbsoluteNgGroup(
                    g.Key,
                    ordered,
                    ordered.First(),
                    ordered.Last());
            })
            .OrderByDescending(g => g.Worst.RatePercent)
            .ThenBy(g => g.Process, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private static string AiAbsoluteProcessLabel(AiAbsoluteNgRow row)
    {
        AiResultRow r = row.Row;
        return !string.IsNullOrWhiteSpace(r.MeasurementType) ? r.MeasurementType
             : !string.IsNullOrWhiteSpace(r.ConditionProcess) ? r.ConditionProcess
             : !string.IsNullOrWhiteSpace(r.MetricName) ? r.MetricName
             : !string.IsNullOrWhiteSpace(r.ChangedFactor) ? r.ChangedFactor
             : "NG Rate";
    }

    private static string AiAbsoluteConditionLabel(AiResultRow r)
    {
        string label = AiResultLabel(r);
        label = StripAiLeadingPrefix(label, r.MeasurementType);
        label = StripAiLeadingPrefix(label, r.ConditionProcess);
        label = StripAiLeadingPrefix(label, r.MetricName);
        return CleanExcelSerialDateText(label);
    }

    private static string StripAiLeadingPrefix(string label, string? prefix)
    {
        if (string.IsNullOrWhiteSpace(label) || string.IsNullOrWhiteSpace(prefix)) return label;

        string trimmed = label.Trim();
        string head = prefix.Trim();
        string[] separators = [":", " - ", " / "];

        foreach (string separator in separators)
        {
            string candidate = head + separator;
            if (trimmed.StartsWith(candidate, StringComparison.OrdinalIgnoreCase))
                return trimmed.Substring(candidate.Length).Trim();
        }

        return trimmed;
    }

    private static double? AiNgRatePercent(AiResultRow r)
    {
        if (r.NgRatePercent.HasValue) return r.NgRatePercent.Value;
        if (r.NgRateDecimal.HasValue) return r.NgRateDecimal.Value * 100.0;
        return null;
    }

    private static List<AiResultRow> BuildAiMetricRows(AiDocBundle doc, Func<AiResultRow, bool> predicate)
        => doc.Results
            .Where(predicate)
            .Where(r => r.MetricValue.HasValue || !string.IsNullOrWhiteSpace(r.Judgement) || AiNgRatePercent(r).HasValue)
            .OrderByDescending(AiIsFailLike)
            .ThenByDescending(AiIsWarnLike)
            .ThenBy(AiSourceLabel)
            .ThenBy(AiMetricLabel)
            .ToList();

    private static List<AiResultRow> BuildAiDoeRows(AiDocBundle doc)
        => doc.Results
            .Where(r => !string.IsNullOrWhiteSpace(r.ConditionGroup)
                        || !string.IsNullOrWhiteSpace(r.ChangedFactor)
                        || !string.IsNullOrWhiteSpace(r.ConditionProcess))
            .Where(r => r.MetricValue.HasValue || AiNgRatePercent(r).HasValue || !string.IsNullOrWhiteSpace(r.Judgement))
            .OrderByDescending(AiIsFailLike)
            .ThenByDescending(r => AiNgRatePercent(r) ?? double.MinValue)
            .ThenBy(AiResultLabel)
            .ToList();

    private static List<AiMetricComparison> BuildAiMetricComparisons(AiDocBundle doc, Func<AiResultRow, bool> predicate)
    {
        var rows = doc.Results
            .Where(predicate)
            .Where(r => r.MetricValue.HasValue)
            .ToList();
        var baselines = rows.Where(IsAiBaselineResult).ToList();
        if (baselines.Count == 0) return [];

        var comparisons = new List<AiMetricComparison>();
        foreach (var variant in rows.Where(r => !IsAiBaselineResult(r)))
        {
            AiResultRow? baseline = FindAiMetricBaseline(variant, baselines);
            if (baseline is null || !baseline.MetricValue.HasValue || !variant.MetricValue.HasValue) continue;
            double delta = variant.MetricValue.Value - baseline.MetricValue.Value;
            double? relative = Math.Abs(baseline.MetricValue.Value) < 0.000001
                ? null
                : delta / baseline.MetricValue.Value * 100.0;
            comparisons.Add(new AiMetricComparison
            {
                Baseline = baseline,
                Variant = variant,
                DeltaValue = delta,
                RelativeChangePct = relative,
            });
        }

        return comparisons
            .OrderByDescending(c => Math.Abs(c.RelativeChangePct ?? c.DeltaValue ?? 0))
            .ToList();
    }

    private static AiResultRow? FindAiMetricBaseline(AiResultRow variant, List<AiResultRow> baselines)
        => baselines
            .Select(b => new { Row = b, Score = AiMetricBaselineScore(variant, b) })
            .Where(x => x.Score >= 28)
            .OrderByDescending(x => x.Score)
            .ThenByDescending(x => SameText(x.Row.SheetName, variant.SheetName))
            .FirstOrDefault()
            ?.Row;

    private static int AiMetricBaselineScore(AiResultRow variant, AiResultRow baseline)
    {
        if (AiEventConflict(variant, baseline)) return -1;

        int score = 0;
        if (SameText(baseline.SheetName, variant.SheetName)) score += 48;
        if (SameText(baseline.MetricName, variant.MetricName)) score += 36;
        if (SameText(baseline.MeasurementType, variant.MeasurementType)) score += 18;
        if (SameText(baseline.Unit, variant.Unit)) score += 10;
        if (!string.IsNullOrWhiteSpace(variant.ResultDate) && SameEventDate(baseline.ResultDate, variant.ResultDate)) score += 8;
        score += AiSharedTokenScore(AiResultLabel(variant), AiResultLabel(baseline));
        score += AiSharedTokenScore(variant.ConditionProcess, baseline.ConditionProcess);
        return score;
    }

    private static AiResultRow? FindAiBaseline(AiResultRow variant, List<AiResultRow> baselines)
    {
        var candidates = baselines
            .Where(b => AiMeasurementCompatible(variant, b))
            .Select(b => new { Row = b, Score = AiBaselineScore(variant, b) })
            .Where(x => x.Score >= 60)
            .OrderByDescending(x => x.Score)
            .ThenByDescending(x => SameText(x.Row.SheetName, variant.SheetName))
            .ThenByDescending(x => x.Row.InputCount ?? 0)
            .FirstOrDefault();

        return candidates?.Row;
    }

    private static int AiBaselineScore(AiResultRow variant, AiResultRow baseline)
    {
        if (AiEventConflict(variant, baseline)) return -1;

        int score = 0;
        string baselineLabel = AiResultLabel(baseline);
        string variantLabel = AiResultLabel(variant);
        string baselineText = AiSearchText(baseline);

        if (SameText(baseline.SheetName, variant.SheetName)) score += 45;
        if (SameText(baseline.MeasurementType, variant.MeasurementType)) score += 24;
        else if (AiMeasurementLooksLikeCondition(variant) || AiMeasurementLooksLikeCondition(baseline)) score += 8;
        if (!string.IsNullOrWhiteSpace(variant.ResultDate) && SameEventDate(baseline.ResultDate, variant.ResultDate)) score += 40;
        if (!string.IsNullOrWhiteSpace(variant.Line) && SameText(baseline.Line, variant.Line)) score += 12;
        if (!string.IsNullOrWhiteSpace(variant.BeforeValue) && AiTextContainsLabel(baselineLabel, variant.BeforeValue)) score += 80;
        if (ContainsAny(baselineText, "normal", "baseline", "control", "reference", "대조")) score += 24;
        if (ContainsAny(baselineText, "before", "old", "standard", "기존")) score += 14;
        if (ContainsOkBaselineToken(baselineLabel)) score += 10;

        score += AiSharedTokenScore(variantLabel, baselineLabel);
        score += AiSharedTokenScore(variant.ChangedFactor, baselineLabel);
        score += AiSharedTokenScore(variant.ConditionProcess, baseline.ConditionProcess);
        return score;
    }

    private static bool AiEventConflict(AiResultRow variant, AiResultRow baseline)
    {
        if (!SameOrBlank(variant.SourceFile, baseline.SourceFile)) return true;
        if (!SameOrBlank(variant.SheetName, baseline.SheetName)) return true;
        if (!SameDateOrBlank(variant.ResultDate, baseline.ResultDate)) return true;
        if (!SameOrBlank(variant.Line, baseline.Line)) return true;
        return false;
    }

    private static bool SameOrBlank(string? a, string? b)
        => string.IsNullOrWhiteSpace(a) || string.IsNullOrWhiteSpace(b) || SameText(a, b);

    private static bool SameDateOrBlank(string? a, string? b)
        => string.IsNullOrWhiteSpace(a) || string.IsNullOrWhiteSpace(b) || SameEventDate(a, b);

    private static bool SameEventDate(string? a, string? b)
    {
        if (SameText(a, b)) return true;
        if (!TryEventDate(a, out int? ay, out int am, out int ad)) return false;
        if (!TryEventDate(b, out int? by, out int bm, out int bd)) return false;
        if (am != bm || ad != bd) return false;
        return !ay.HasValue || !by.HasValue || ay.Value == by.Value;
    }

    private static bool TryEventDate(string? value, out int? year, out int month, out int day)
    {
        year = null;
        month = 0;
        day = 0;
        string raw = (value ?? "").Trim();
        if (string.IsNullOrWhiteSpace(raw)) return false;

        if (TryExcelSerialDate(raw, out DateTime serialDate))
        {
            year = serialDate.Year;
            month = serialDate.Month;
            day = serialDate.Day;
            return true;
        }

        string[] parts = raw.Split(['/', '-', '.', ' '], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length >= 2)
        {
            if (int.TryParse(parts[0], out int first) && TryMonthToken(parts[1], out int namedMonth))
            {
                day = first;
                month = namedMonth;
                if (parts.Length >= 3 && int.TryParse(parts[2], out int y) && y >= 1000) year = y;
                return day is >= 1 and <= 31;
            }
            if (TryMonthToken(parts[0], out namedMonth) && int.TryParse(parts[1], out int second))
            {
                day = second;
                month = namedMonth;
                if (parts.Length >= 3 && int.TryParse(parts[2], out int y) && y >= 1000) year = y;
                return day is >= 1 and <= 31;
            }
        }

        string[] candidates = [raw, raw.Replace('-', '/'), raw.Replace('.', '/')];
        foreach (string candidate in candidates)
        {
            if (DateTime.TryParse(candidate, System.Globalization.CultureInfo.InvariantCulture,
                    System.Globalization.DateTimeStyles.AllowWhiteSpaces, out DateTime dt))
            {
                year = HasExplicitYear(raw) ? dt.Year : null;
                month = dt.Month;
                day = dt.Day;
                return true;
            }
        }
        return false;
    }

    private static bool TryMonthToken(string token, out int month)
    {
        month = token.Trim().ToLowerInvariant()[..Math.Min(3, token.Trim().Length)] switch
        {
            "jan" => 1,
            "feb" => 2,
            "mar" => 3,
            "apr" => 4,
            "may" => 5,
            "jun" => 6,
            "jul" => 7,
            "aug" => 8,
            "sep" => 9,
            "oct" => 10,
            "nov" => 11,
            "dec" => 12,
            _ => 0,
        };
        return month > 0;
    }

    private static bool HasExplicitYear(string value)
    {
        int run = 0;
        foreach (char ch in value)
        {
            run = char.IsDigit(ch) ? run + 1 : 0;
            if (run >= 4) return true;
        }
        return false;
    }

    private static bool IsAiBaselineResult(AiResultRow r)
    {
        string text = AiBaselineIdentityText(r);
        if (ContainsAny(text, "normal", "baseline", "control", "reference", "before", "old", "standard", "기존", "대조"))
            return true;
        return ContainsOkBaselineToken(AiResultLabel(r));
    }

    private static bool IsAiNgRateResult(AiResultRow r)
        => string.Equals(r.MetricName, "Total NG Rate", StringComparison.OrdinalIgnoreCase)
           || r.NgRatePercent.HasValue
           || r.NgRateDecimal.HasValue;

    private static bool IsAiActualNgRateResult(AiResultRow r)
    {
        double? rate = AiNgRatePercent(r);
        if (!rate.HasValue || rate.Value < 0 || rate.Value > 100) return false;
        if (!r.InputCount.HasValue || r.InputCount.Value <= 0) return false;
        if (!r.NgCount.HasValue || r.NgCount.Value < 0) return false;
        if (r.NgCount.Value - r.InputCount.Value > 0.0001) return false;
        if (r.OkCount.HasValue && r.OkCount.Value - r.InputCount.Value > 0.0001) return false;
        return IsAiNgRateResult(r);
    }

    private static bool AiMeasurementCompatible(AiResultRow variant, AiResultRow baseline)
        => string.IsNullOrWhiteSpace(variant.MeasurementType)
           || string.IsNullOrWhiteSpace(baseline.MeasurementType)
           || SameText(baseline.MeasurementType, variant.MeasurementType)
           || AiMeasurementLooksLikeCondition(variant)
           || AiMeasurementLooksLikeCondition(baseline);

    private static bool AiMeasurementLooksLikeCondition(AiResultRow r)
        => !string.IsNullOrWhiteSpace(r.MeasurementType)
           && !string.IsNullOrWhiteSpace(r.ConditionGroup)
           && SameText(r.MeasurementType, r.ConditionGroup);

    private static bool IsAiDimensionMetric(AiResultRow r)
    {
        if (IsAiNgRateResult(r)) return false;
        string text = AiResultText(r);
        return ContainsAny(text, "dimension", "gap", "inner", "outer", "height", "width", "length",
            "offset", "coil", "pad", "clearance", "distance", "mm", "before", "after");
    }

    private static bool IsAiReliabilityMetric(AiResultRow r)
    {
        string text = AiResultText(r);
        return ContainsAny(text, "reliability", "spec", "spl", "thd", "imp", "impedance", "ohm",
            "temperature", "temp", "humidity", "humid", "aging", "thermal", "pass", "fail");
    }

    private static string AiResultText(AiResultRow r)
        => NormalizeAiText(string.Join(' ', r.MeasurementType, r.ConditionGroup, r.ConditionProcess,
            r.ChangedFactor, r.BeforeValue, r.AfterValue, r.MetricName, r.Unit, r.Judgement,
            r.SourceFile, r.SheetName));

    private static string AiPct(double? value)
        => value.HasValue ? value.Value.ToString("F1") + "%" : "-";

    private static string AiMetricLabel(AiResultRow r)
        => !string.IsNullOrWhiteSpace(r.MetricName) ? r.MetricName
         : !string.IsNullOrWhiteSpace(r.MeasurementType) ? r.MeasurementType
         : !string.IsNullOrWhiteSpace(r.ChangedFactor) ? r.ChangedFactor
         : "Metric";

    private static string AiMetricValue(AiResultRow r)
    {
        if (!r.MetricValue.HasValue) return AiResultMainValue(r);
        string unit = string.IsNullOrWhiteSpace(r.Unit) ? "" : " " + AiDisplayUnit(r.Unit);
        return AiNumber(r.MetricValue.Value) + unit;
    }

    private static string AiResultMainValue(AiResultRow r)
    {
        double? rate = AiNgRatePercent(r);
        if (rate.HasValue) return AiPct(rate);
        if (r.MetricValue.HasValue) return AiMetricValue(r);
        if (!string.IsNullOrWhiteSpace(r.Judgement)) return r.Judgement;
        if (r.NgCount.HasValue) return AiCount(r.NgCount);
        return "-";
    }

    private static string AiMetricDeltaText(AiMetricComparison c)
    {
        if (!c.DeltaValue.HasValue) return "-";
        string unit = string.IsNullOrWhiteSpace(c.Variant.Unit) ? "" : " " + AiDisplayUnit(c.Variant.Unit);
        string delta = AiSignedNumber(c.DeltaValue.Value) + unit;
        if (c.RelativeChangePct.HasValue)
            delta += " / " + AiSignedNumber(c.RelativeChangePct.Value) + "%";
        return delta;
    }

    private static string AiDisplayUnit(string unit)
    {
        string u = (unit ?? "").Trim();
        return u.Equals("Newton", StringComparison.OrdinalIgnoreCase) ? "N" : u;
    }

    private static string AiMetricHeatClass(AiMetricComparison c)
    {
