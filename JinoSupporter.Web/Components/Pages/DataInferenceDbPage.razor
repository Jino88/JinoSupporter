    private static string AiComparisonShortContext(AiControlComparison c)
    {
        var parts = new List<string>();
        string date = !string.IsNullOrWhiteSpace(c.Variant.ResultDate) ? c.Variant.ResultDate : c.Baseline.ResultDate;
        string line = !string.IsNullOrWhiteSpace(c.Variant.Line) ? c.Variant.Line : c.Baseline.Line;
        if (!string.IsNullOrWhiteSpace(date)) parts.Add(DisplayExcelDate(date));
        if (!string.IsNullOrWhiteSpace(line)) parts.Add(line);
        return parts.Count == 0 ? "same event" : string.Join(" | ", parts);
    }

    private static string AiComparisonFullContext(AiControlComparison c)
    {
        var parts = new List<string>();
        string process = !string.IsNullOrWhiteSpace(c.Variant.ConditionProcess) ? c.Variant.ConditionProcess : c.Baseline.ConditionProcess;
        string factor = !string.IsNullOrWhiteSpace(c.Variant.ChangedFactor) ? c.Variant.ChangedFactor : c.Baseline.ChangedFactor;
        string before = !string.IsNullOrWhiteSpace(c.Variant.BeforeValue) ? c.Variant.BeforeValue : c.Baseline.BeforeValue;
        string after = !string.IsNullOrWhiteSpace(c.Variant.AfterValue) ? c.Variant.AfterValue : c.Baseline.AfterValue;
        parts.Add(AiComparisonShortContext(c));
        if (!string.IsNullOrWhiteSpace(process)) parts.Add(process);
        if (!string.IsNullOrWhiteSpace(factor)) parts.Add(factor);
        if (!string.IsNullOrWhiteSpace(before) || !string.IsNullOrWhiteSpace(after))
            parts.Add($"{before} -> {after}".Trim(' ', '-', '>'));
        return string.Join(" | ", parts.Where(x => !string.IsNullOrWhiteSpace(x)));
    }

