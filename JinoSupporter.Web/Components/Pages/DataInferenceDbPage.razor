                                                                        <td class="n">@AiPct(AiNgRatePercent(cmp.Baseline))</td>
                                                                        <td class="n">@AiPct(AiNgRatePercent(cmp.Variant))</td>
                                                                        <td class="n">@AiRateRatioValue(cmp)</td>
                                                                        <td><span class="didb-ai-chip @AiHeatClass(cmp)">@AiRelativeChangeText(cmp)</span></td>
                                                                        <td>
                                                                            <div class="didb-ai-tablebar">
                                                                                <div class="didb-ai-bar @AiRelativeBarClass(cmp)" style="@($"width:{width:F1}%")"></div>
                                                                            </div>
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    }
                                                }
                                            </section>

                                            <section class="didb-ai-panel">
                                                <h3>MicroSpeaker Pair Result</h3>
                                                @if (aiMicroPairRows.Count == 0)
                                                {
                                                    <div class="didb-ai-empty">No MicroSpeaker comparison_pairs rows.</div>
                                                }
                                                else
                                                {
                                                    <div class="didb-ai-pair-table-wrap">
