                                                                                    }
                                                                                </tr>
                                                                            }
                                                                        }
                                                                    }
                                                                    else
                                                                    {
                                                                        @foreach (var row in block.TableRows)
                                                                        {
                                                                            var visibleCells = AiReportVisibleCells(block, row);
                                                                            <tr class="@row.HeatClass">
                                                                                @for (int i = 0; i < visibleCells.Count; i++)
                                                                                {
                                                                                    string cellText = CleanExcelSerialDateText(visibleCells[i]);
                                                                                    <td class="@AiReportCellClass(visibleCells.Count, i)" title="@cellText">@cellText</td>
