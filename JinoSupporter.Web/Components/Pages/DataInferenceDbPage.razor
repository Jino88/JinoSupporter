    /// <summary>Pick the first <paramref name="n"/> non-empty bullets from a
    /// '\n'-separated narrative field. Used to compress the verbose AI
    /// output into a glanceable card.</summary>
    private static IEnumerable<string> TakeBullets(string field, int n)
    {
        if (string.IsNullOrWhiteSpace(field)) yield break;
        int count = 0;
        foreach (var raw in field.Split('\n'))
        {
            string s = raw.Trim();
            if (s.Length == 0) continue;
            yield return s;
            if (++count >= n) yield break;
        }
    }

    /// <summary>Pull the verdict word (first non-empty token) out of the
    /// `decision` field. Maps it to a CSS class for color-coding so the
    /// pill in the card glows green / red / gray without extra fields.</summary>
    private static (string Label, string CssClass) ParseVerdict(string decision)
    {
        if (string.IsNullOrWhiteSpace(decision)) return ("", "");
        string first = decision.Split('\n', 2)[0].Trim();
        // Verdict word is the leading word, lowercased.
        string head = new string(first.TakeWhile(c => char.IsLetter(c) || c == '_').ToArray())
            .ToLowerInvariant();
        return VerdictLabel(head);
    }

    /// <summary>Map the v7 verdict enum to a UI label + CSS class.</summary>
    private static (string Label, string CssClass) VerdictLabel(string verdict)
    {
        string head = (verdict ?? "").Trim().ToLowerInvariant();
        return head switch
        {
            "improved"        => ("IMPROVED",        "didb-v-good"),
            "worsened"        => ("WORSENED",        "didb-v-bad"),
            "partial"         => ("PARTIAL",         "didb-v-partial"),
            "no_clear_effect" => ("NO CLEAR EFFECT", "didb-v-neutral"),
            "inconclusive"    => ("INCONCLUSIVE",    "didb-v-neutral"),
            "unclear"         => ("UNCLEAR",         "didb-v-neutral"),
            "passed"          => ("PASSED",          "didb-v-good"),
            "failed"          => ("FAILED",          "didb-v-bad"),
            ""                => ("", ""),
            _                 => (head.ToUpperInvariant(), "didb-v-neutral"),
        };
    }

    private static (string Label, string CssClass) ReportTypeBadge(string rt)
    {
