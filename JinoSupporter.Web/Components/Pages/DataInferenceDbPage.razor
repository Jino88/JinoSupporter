                                                                        <strong>@AiMetricDeltaText(cmp)</strong>
                                                                        <span>@AiMetricLabel(cmp.Variant)</span>
                                                                        <em>@AiMetricValue(cmp.Baseline) -> @AiMetricValue(cmp.Variant)</em>
                                                                    </div>
                                                                }
                                                            </div>
                                                            <table class="didb-ai-comp-table didb-ai-metric-table">
                                                                <thead>
                                                                    <tr>
                                                                        <th>@AiUi(aiLang, "metric")</th>
                                                                        <th class="n">@AiUi(aiLang, "beforeBase")</th>
                                                                        <th class="n">@AiUi(aiLang, "afterTest")</th>
                                                                        <th class="n">@AiUi(aiLang, "delta")</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var cmp in aiDimensionComps)
                                                                    {
                                                                        <tr>
                                                                            <td>
                                                                                <strong>@AiMetricLabel(cmp.Variant)</strong>
                                                                                <span>@AiResultLabel(cmp.Variant)</span>
                                                                            </td>
                                                                            <td class="n">@AiMetricValue(cmp.Baseline)</td>
                                                                            <td class="n">@AiMetricValue(cmp.Variant)</td>
                                                                            <td class="n"><span class="didb-ai-chip @AiMetricHeatClass(cmp)">@AiMetricDeltaText(cmp)</span></td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        }
                                                        else
                                                        {
                                                            <table class="didb-ai-comp-table didb-ai-metric-table">
                                                                <thead>
                                                                    <tr>
                                                                        <th>@AiUi(aiLang, "metric")</th>
                                                                        <th>@AiUi(aiLang, "condition")</th>
                                                                        <th class="n">@AiUi(aiLang, "value")</th>
                                                                        <th>@AiUi(aiLang, "judgement")</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var row in aiDimensionRows)
                                                                    {
                                                                        <tr>
                                                                            <td><strong>@AiMetricLabel(row)</strong></td>
                                                                            <td>@AiResultLabel(row)</td>
                                                                            <td class="n">@AiResultMainValue(row)</td>
                                                                            <td><span class="didb-ai-status @AiJudgementClass(row)">@AiJudgementLabel(row, aiLang)</span></td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        }
                                                    }
                                                    else if (aiReportKind == "reliability_spec")
                                                    {
                                                        @if (aiReliabilityRows.Count == 0)
                                                        {
                                                            <div class="didb-ai-empty">No reliability/spec metric rows were normalized.</div>
                                                        }
                                                        else
                                                        {
                                                            <table class="didb-ai-comp-table didb-ai-metric-table">
                                                                <thead>
                                                                    <tr>
                                                                        <th>@AiUi(aiLang, "testItem")</th>
                                                                        <th>@AiUi(aiLang, "condition")</th>
                                                                        <th class="n">@AiUi(aiLang, "value")</th>
                                                                        <th>@AiUi(aiLang, "judgement")</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var row in aiReliabilityRows)
                                                                    {
                                                                        <tr>
                                                                            <td><strong>@AiMetricLabel(row)</strong></td>
                                                                            <td>@AiResultLabel(row)</td>
                                                                            <td class="n">@AiResultMainValue(row)</td>
                                                                            <td><span class="didb-ai-status @AiJudgementClass(row)">@AiJudgementLabel(row, aiLang)</span></td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        }
                                                    }
                                                    else if (aiReportKind == "doe_matrix")
                                                    {
                                                        @if (aiDoeRows.Count == 0)
                                                        {
                                                            <div class="didb-ai-empty">No DOE condition rows were normalized.</div>
                                                        }
                                                        else
                                                        {
                                                            <div class="didb-ai-doe-grid">
