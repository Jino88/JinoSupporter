                                                                        <td title="@pair.Item"><strong>@AiBrief(pair.Item, 52)</strong><span>@pair.Evidence</span></td>
                                                                        <td title="@pair.ControlCondition">@AiBrief(pair.ControlCondition, 34)</td>
                                                                        <td title="@pair.TestCondition">@AiBrief(pair.TestCondition, 34)</td>
                                                                        <td class="n">@PairCountRate(pair.ControlInput, pair.ControlNg, pair.ControlRate)</td>
                                                                        <td class="n">@PairCountRate(pair.TestInput, pair.TestNg, pair.TestRate)</td>
