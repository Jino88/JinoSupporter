    [JSInvokable]
    public Task LoadMoreDatasets()
        => InvokeAsync(() =>
        {
            int count = FilteredReports.Count;
            int next = Math.Min(count, _visibleReportCount + DatasetRenderBatchSize);
            if (next == _visibleReportCount) return;

            _visibleReportCount = next;
            Activity.Log("Data Inference DB", $"Lazy load datasets {_visibleReportCount:N0}/{count:N0}");
            StateHasChanged();
        });

    // Inline Product Type editor. Click "✎ Set…" (or an existing value) to
    // edit a single dataset's Product Type — datalist offers existing values
    // + Mid-group Materials so the user can pick or freely type.
    private string? _editingPt;
    private string  _editingPtDraft = "";
    private bool    _ptSaving;

    private void StartEditPt(string datasetName, string? current)
    {
        _editingPt = datasetName;
        _editingPtDraft = current ?? "";
    }

    private void CancelEditPt()
    {
        _editingPt = null;
        _editingPtDraft = "";
    }

    private void OnPtKey(KeyboardEventArgs e, string datasetName)
    {
        if (e.Key == "Enter")       SavePt(datasetName);
        else if (e.Key == "Escape") CancelEditPt();
    }

    private void SavePt(string datasetName)
    {
        if (_editingPt != datasetName || _ptSaving) return;
        _ptSaving = true;
        try
        {
            string pt = (_editingPtDraft ?? "").Trim();
            Repo.UpdateRawReportProductType(datasetName, pt);
            Activity.Log("Data Inference DB", $"Update Product Type dataset='{datasetName}' productType='{pt}'");
            ReloadReports();
        }
        finally
        {
            _editingPt = null;
            _editingPtDraft = "";
            _ptSaving = false;
        }
    }

    /// <summary>Datalist source: union of distinct existing ProductTypes in
    /// the DB and all Mid-group Materials defined in ModelGroups.</summary>
    private IEnumerable<string> GetProductTypeSuggestions()
    {
        var existing = _reports
            .Select(r => r.ProductType)
            .Where(p => !string.IsNullOrWhiteSpace(p));
        var mids = Repo.GetModelGroups()
            .SelectMany(g => g.MidGroups)
            .Select(m => m.Material)
            .Where(s => !string.IsNullOrWhiteSpace(s));
        return existing.Concat(mids)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(s => s, StringComparer.OrdinalIgnoreCase);
    }

    private async Task LoadReportsAsync(bool applyQueryTarget)
    {
        if (_isLoadingReports) return;

        _isLoadingReports = true;
        _loadReportsError = "";
        await Task.Yield();

        try
        {
            string? expanded = _expanded;
            ReportLoadState state = await Task.Run(() => LoadReportData(expanded));
            ApplyReportLoadState(state);
            if (applyQueryTarget)
                ApplyQueryTarget();
        }
        catch (Exception ex)
        {
            _loadReportsError = $"Load saved datasets failed: {ex.Message}";
            Activity.Log("Data Inference DB", _loadReportsError);
        }
        finally
        {
            _isLoadingReports = false;
        }
    }

    private ReportLoadState LoadReportData(string? expanded)
    {
        List<NormalizedMeasurement> expandedMeasurements = [];
        DatasetSummaryRecord? expandedSummary = null;
        AiDocBundle? expandedAiDoc = null;

        if (!string.IsNullOrEmpty(expanded))
        {
            expandedMeasurements = Repo.GetNormalizedMeasurements(expanded);
            expandedSummary      = Repo.GetDatasetSummaryRecord(expanded);
            expandedAiDoc        = Repo.GetAiDocBundle(expanded);
        }

        return new ReportLoadState(
            expanded,
            Repo.GetAllRawReports(),
            Repo.GetDatasetsWithExtractedText(),
            expandedMeasurements,
            expandedSummary,
            expandedAiDoc,
            Repo.GetAskAiHistory(50));
    }

    private void ApplyReportLoadState(ReportLoadState state)
    {
        _reports   = state.Reports;
        _ocrCached = state.OcrCached;
        _askAiHistory = state.AskAiHistory;
        EnsureSelectedAskAiHistory();
        if (_visibleReportCount < DatasetRenderBatchSize)
            _visibleReportCount = DatasetRenderBatchSize;

        if (!string.IsNullOrEmpty(state.Expanded)
            && string.Equals(state.Expanded, _expanded, StringComparison.Ordinal))
        {
            _expandedMeasurements = state.ExpandedMeasurements;
            _expandedSummary      = state.ExpandedSummary;
            _expandedAiDoc        = state.ExpandedAiDoc;
        }
    }

    private void ReloadReports()
    {
        _reports    = Repo.GetAllRawReports();
        _ocrCached  = Repo.GetDatasetsWithExtractedText();
        _askAiHistory = Repo.GetAskAiHistory(50);
        EnsureSelectedAskAiHistory();
        if (_visibleReportCount < DatasetRenderBatchSize)
            _visibleReportCount = DatasetRenderBatchSize;

        // If a row is currently expanded, re-pull its detail bundles too.
        // Without this, hitting Refresh after a CLI run leaves the open card
        // stale — _expandedAiDoc / _expandedSummary were loaded once on
        // ToggleExpand and never re-fetched.
        if (!string.IsNullOrEmpty(_expanded))
        {
            _expandedMeasurements = Repo.GetNormalizedMeasurements(_expanded);
            _expandedSummary      = Repo.GetDatasetSummaryRecord(_expanded);
            _expandedAiDoc        = Repo.GetAiDocBundle(_expanded);
        }
    }

    private void ApplyQueryTarget()
    {
        string requestedAiResult = NormalizeAiResultQuery(QueryAiResult ?? "");
        if (!string.IsNullOrWhiteSpace(requestedAiResult))
            _aiResultFilter = requestedAiResult;

        string target = (QueryDataset ?? "").Trim();
        if (string.IsNullOrWhiteSpace(target) || _reports.Count == 0) return;

        RawReportInfo? report = _reports.FirstOrDefault(r =>
            string.Equals(r.DatasetName, target, StringComparison.OrdinalIgnoreCase));
        if (report is null) return;

        List<RawReportInfo> filtered = FilteredReports;
        int index = filtered.FindIndex(r =>
            string.Equals(r.DatasetName, report.DatasetName, StringComparison.OrdinalIgnoreCase));

        if (index < 0)
        {
            _aiResultFilter = "all";
            filtered = FilteredReports;
            index = filtered.FindIndex(r =>
                string.Equals(r.DatasetName, report.DatasetName, StringComparison.OrdinalIgnoreCase));
        }

        if (index >= 0)
            _visibleReportCount = Math.Max(_visibleReportCount, Math.Max(DatasetRenderBatchSize, index + 1));

        if (_expanded != report.DatasetName || !string.Equals(_appliedQueryDataset, target, StringComparison.OrdinalIgnoreCase))
        {
            ExpandDataset(report.DatasetName);
            _appliedQueryDataset = target;
        }
    }

    private void SetSourceView(string view) => _sourceView = view;

    // Heatmap state for the currently-expanded row. Recomputed each toggle.
    // Per cell: NgSum / InputSum aggregated across rows; AvgNg is the
    // weighted ratio (so the % shown == NG/Input shown).
    // Defects: per-DefectType count, sorted desc, surfaced when >1 in cell.
    private List<string> _corrLines      = [];
    private List<string> _corrCheckTypes = [];
    private Dictionary<(string, string),
                       (double AvgNg, long NgSum, long InputSum, int RowCount,
                        List<(string Type, long Count)> Defects)> _corrCells = new();
    private string _corrRowLabel = "Variable";
    private string _corrColLabel = "Group";

    private void BuildCorrelationPivot()
    {
        _corrLines.Clear(); _corrCheckTypes.Clear(); _corrCells.Clear();
        if (_expandedMeasurements.Count == 0) return;

        var candidates = new (Func<NormalizedMeasurement, string> Row,
                              Func<NormalizedMeasurement, string> Col,
                              string RowLabel, string ColLabel)[]
        {
            (m => m.Variable,      m => m.VariableGroup, "Variable",  "Group"),
            (m => m.Line,          m => m.CheckType,     "Line",      "CheckType"),
            (m => m.VariableGroup, m => m.CheckType,     "Group",     "CheckType"),
        };

        foreach (var (getRow, getCol, rowLbl, colLbl) in candidates)
        {
            var byCell = new Dictionary<(string, string), (long NgSum, long InputSum, int N)>();
            var byDefect = new Dictionary<(string, string), Dictionary<string, long>>();
            var rowSet = new HashSet<string>();
            var colSet = new HashSet<string>();
            foreach (var m in _expandedMeasurements)
            {
                if (m.InputQty <= 0) continue;
                string r = string.IsNullOrWhiteSpace(getRow(m)) ? "(none)" : getRow(m).Trim();
                string c = string.IsNullOrWhiteSpace(getCol(m)) ? "(none)" : getCol(m).Trim();
                rowSet.Add(r); colSet.Add(c);
                byCell.TryGetValue((r, c), out var acc);
                byCell[(r, c)] = (acc.NgSum + m.NgTotal, acc.InputSum + m.InputQty, acc.N + 1);

                if (!string.IsNullOrWhiteSpace(m.DefectType) && m.DefectCount > 0)
                {
                    if (!byDefect.TryGetValue((r, c), out var d))
                        byDefect[(r, c)] = d = new(StringComparer.OrdinalIgnoreCase);
                    string dt = m.DefectType.Trim();
                    d.TryGetValue(dt, out long prev);
                    d[dt] = prev + m.DefectCount;
                }
            }
            int rowsWithValue = rowSet.Count(s => s != "(none)");
            int colsWithValue = colSet.Count(s => s != "(none)");
            if (rowsWithValue < 2 && colsWithValue < 2) continue;

            _corrLines      = rowSet.OrderBy(s => s).ToList();
            _corrCheckTypes = colSet.OrderBy(s => s).ToList();
            foreach (var (key, val) in byCell)
            {
                double pct = val.InputSum > 0 ? (100.0 * val.NgSum / val.InputSum) : 0;
                var defects = byDefect.TryGetValue(key, out var d)
                    ? d.Select(kv => (kv.Key, kv.Value)).OrderByDescending(x => x.Value).ToList()
                    : new List<(string, long)>();
                _corrCells[key] = (pct, val.NgSum, val.InputSum, val.N, defects);
            }
            _corrRowLabel = rowLbl;
            _corrColLabel = colLbl;
            return;
        }
    }

    private static string HeatColor(double ngPercent)
    {
        double t = Math.Clamp(ngPercent / 10.0, 0.0, 1.0);
        (int r, int g, int b) = t < 0.5
            ? Lerp((22,163,74),  (250,204,21),  t * 2.0)
            : Lerp((250,204,21), (220,38,38),   (t - 0.5) * 2.0);
        return $"rgb({r},{g},{b})";

        static (int r, int g, int b) Lerp((int r,int g,int b) a, (int r,int g,int b) b2, double t)
            => (
                (int)Math.Round(a.r + (b2.r - a.r) * t),
                (int)Math.Round(a.g + (b2.g - a.g) * t),
                (int)Math.Round(a.b + (b2.b - a.b) * t)
            );
    }

    private void ToggleExpand(string name)
    {
        if (_expanded == name)
        {
            ClearExpandedDataset();
        }
        else
        {
            ExpandDataset(name);
        }
    }

    private void ClearExpandedDataset()
    {
        _expanded = null; _expandedMeasurements = []; _expandedSummary = null;
        _expandedAiDoc = null; _aiCardShowAll = false;
        _expandedImages = []; _expandedFiles = [];
        _expandedOcrText = ""; _expandedExcelPaste = "";
        _corrCells.Clear(); _corrLines.Clear(); _corrCheckTypes.Clear();
    }

    private void ExpandDataset(string name)
    {
        _expanded             = name;
        Activity.Log("Data Inference DB", $"View dataset '{name}'");
        _expandedMeasurements = Repo.GetNormalizedMeasurements(name);
        _expandedSummary      = Repo.GetDatasetSummaryRecord(name);
        _expandedAiDoc        = Repo.GetAiDocBundle(name);
        _aiCardShowAll        = false;
        _expandedImages       = Repo.GetRawReportImages(name).Select((img, i) =>
        {
            string b64     = Convert.ToBase64String(img.Data);
            string dataUrl = $"data:{img.MediaType};base64,{b64}";
            string fname   = img.FileName.Length > 0 ? img.FileName : $"img-{i + 1}";
            return new ImgThumb(img.MediaType, dataUrl, fname);
        }).ToList();
        _expandedFiles        = Repo.GetRawReportFileInfos(name);
        _expandedOcrText      = Repo.GetExtractedText(name, WebRepository.TextKindOcr) ?? "";
        _expandedExcelPaste   = Repo.GetExtractedText(name, WebRepository.TextKindExcelPaste) ?? "";
        BuildCorrelationPivot();
    }

