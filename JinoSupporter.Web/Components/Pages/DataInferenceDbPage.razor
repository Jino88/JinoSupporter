@page "/data-inference/db-legacy"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject WebRepository Repo
@inject IJSRuntime JS
@inject AppActivityLogger Activity
<PageTitle>Data Inference — DB Data</PageTitle>

<div class="didb-root">

<!-- ── Header ──────────────────────────────────────────────────────────────── -->
<div class="didb-header">
    <span class="didb-title">Ask AI Result</span>
    <span class="didb-count">
        @_askAiHistory.Count saved Ask AI result(s)
    </span>
    <div style="flex:1;"></div>
    <button class="btn btn-outline-secondary btn-sm" @onclick="Refresh">↻ Refresh</button>
</div>

<!-- ── Table ────────────────────────────────────────────────────────────────── -->
<CurrentProblemWorkflowStrip ContextLabel="Result" />

@{
    AskAiHistoryRecord? selectedAskAi = SelectedAskAiHistory;
    List<AskAiPerDatasetResult> selectedAskAiRows = selectedAskAi is null
        ? []
        : AskAiPerDatasetRows(selectedAskAi.PerDatasetJson);
}
<section class="didb-ask-result">
    <div class="didb-ask-result-head">
        <div>
            <div class="didb-ask-result-title">Ask AI Analysis Result</div>
            <div class="didb-ask-result-sub">Latest saved analysis from Ask AI</div>
        </div>
        @if (_askAiHistory.Count > 0)
        {
            <select class="form-select form-select-sm didb-ask-select"
                    value="@_selectedAskAiHistoryId"
                    @onchange="OnAskAiHistoryChanged">
                @foreach (var h in _askAiHistory)
                {
                    <option value="@h.Id">@AskAiHistoryOptionLabel(h)</option>
                }
            </select>
        }
    </div>
    @if (selectedAskAi is null)
    {
        <div class="didb-ask-empty">No saved Ask AI analysis result.</div>
    }
    else
    {
        <div class="didb-ask-meta">
            <span>@FormatDate(selectedAskAi.CreatedAt)</span>
            <span>Product Type @(string.IsNullOrWhiteSpace(selectedAskAi.ProductTypeFilter) ? "All" : selectedAskAi.ProductTypeFilter)</span>
            <span>@selectedAskAiRows.Count.ToString("N0") dataset(s)</span>
        </div>
        <div class="didb-ask-question">@selectedAskAi.Question</div>
        @if (IsAskAiHtmlReport(selectedAskAi.Overall))
        {
            <iframe class="didb-ask-html-frame"
                    title="Ask AI analysis result"
                    sandbox="allow-scripts allow-popups allow-forms allow-downloads"
                    srcdoc="@selectedAskAi.Overall"></iframe>
        }
        else
        {
            <div class="didb-ask-markdown">@AiMarkdown(selectedAskAi.Overall)</div>
        }
        @if (selectedAskAiRows.Count > 0)
        {
            <details class="didb-ask-evidence">
                <summary>Evidence datasets used by Ask AI (@selectedAskAiRows.Count)</summary>
                @foreach (var row in selectedAskAiRows)
                {
                    <div class="didb-ask-dataset">
                        <div class="didb-ask-dataset-name">@row.DatasetName</div>
                        @if (IsAskAiHtmlReport(row.Answer))
                        {
                            <iframe class="didb-ask-dataset-frame"
                                    title="@($"Ask AI dataset evidence - {row.DatasetName}")"
                                    sandbox="allow-scripts allow-popups allow-forms allow-downloads"
                                    srcdoc="@row.Answer"></iframe>
                        }
                        else
                        {
                            <div class="didb-ask-markdown">@AiMarkdown(row.Answer)</div>
                        }
                    </div>
                }
            </details>
        }
    }
</section>

<details class="didb-source-datasets">
    <summary>
        <span>Source datasets</span>
        <small>@FilteredReports.Count.ToString("N0") dataset(s)@DatasetFilterSuffix</small>
    </summary>
    <div class="didb-source-toolbar">
        <span class="didb-filter-label">AI Batch</span>
        <select class="form-select form-select-sm didb-filter-select-sm" @bind="AiBatchFilter">
            <option value="all">All</option>
            <option value="batched">Batched</option>
            <option value="pending">Pending</option>
        </select>
        <span class="didb-filter-label">AI Result</span>
        <select class="form-select form-select-sm didb-filter-select-sm" @bind="AiResultFilter">
            <option value="all">All</option>
            <option value="has">Has result</option>
            <option value="new">New</option>
            <option value="index">Index</option>
            <option value="old">Old</option>
            <option value="none">None</option>
        </select>
        <span class="didb-filter-label">Product Type</span>
        <select class="form-select form-select-sm didb-filter-select" @bind="ProductTypeFilter">
            <option value="">All</option>
            @foreach (var pt in _productTypeOptions)
            {
                <option value="@pt">@pt</option>
            }
        </select>
        <div style="flex:1;"></div>
        <button class="btn btn-outline-danger btn-sm" @onclick="ConfirmDeleteAll"
                disabled="@(_reports.Count == 0)">Delete All</button>
    </div>

@if (_isLoadingReports && _reports.Count == 0)
{
    <div class="didb-empty">
        Loading saved datasets...
    </div>
}
else if (!string.IsNullOrWhiteSpace(_loadReportsError) && _reports.Count == 0)
{
    <div class="didb-empty">
        @_loadReportsError
    </div>
}
else if (_reports.Count == 0)
{
    <div class="didb-empty">
        No saved datasets yet.<br />
        Go to Input Data, analyze an image, then save.
    </div>
}
else if (FilteredReports.Count == 0)
{
    <div class="didb-empty">
        No datasets match the selected filters.
    </div>
}
else
{
    <datalist id="didb-pt-options">
        @foreach (var opt in GetProductTypeSuggestions())
        {
            <option value="@opt"></option>
        }
    </datalist>
    <div class="didb-table-wrap">
        <table class="didb-table">
            <thead>
                <tr>
                    <th style="width:28px;"></th>
                    <th>Dataset Name</th>
                    <th>Product Type</th>
                    <th>Date</th>
                    <th>Images</th>
                    <th>Measurements</th>
                    <th>Saved</th>
                    <th>AI Batched</th>
                    <th>AI Result</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in VisibleReports)
                {
                    bool expanded = _expanded == r.DatasetName;
                    <tr class="didb-row @(expanded ? "didb-row-open" : "")"
                        @onclick="() => ToggleExpand(r.DatasetName)">
                        <td class="didb-caret">@(expanded ? "▾" : "▸")</td>
                        <td><strong>@r.DatasetName</strong></td>
                        <td @onclick:stopPropagation="true">
                            @if (_editingPt == r.DatasetName)
                            {
                                <input class="form-control form-control-sm didb-pt-input"
                                       list="didb-pt-options"
                                       placeholder="Type or pick existing…"
                                       value="@_editingPtDraft"
                                       @oninput="@(e => _editingPtDraft = e.Value?.ToString() ?? "")"
                                       @onkeydown="@(e => OnPtKey(e, r.DatasetName))"
                                       @onblur="@(() => SavePt(r.DatasetName))"
                                       autofocus />
                            }
                            else if (string.IsNullOrWhiteSpace(r.ProductType))
                            {
                                <a class="didb-set-pt" role="button" tabindex="0"
                                   @onclick="() => StartEditPt(r.DatasetName, r.ProductType)"
                                   title="Set Product Type for this dataset">
                                    ✎ Set…
                                </a>
                            }
                            else
                            {
                                <span class="didb-pt-text"
                                      @onclick="() => StartEditPt(r.DatasetName, r.ProductType)"
                                      title="Click to edit">@r.ProductType</span>
                            }
                        </td>
                        <td>@r.ReportDate</td>
                        <td class="n">@r.ImageCount</td>
                        <td class="n">@r.MeasurementCount</td>
                        <td class="didb-date">@FormatDate(r.CreatedAt)</td>
                        <td class="didb-date">
                            @if (!string.IsNullOrEmpty(r.BatchedAt))
                            {
                                <span title="@r.BatchedAt">@FormatDate(r.BatchedAt)</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            <span class="@AiResultBadgeClass(r.AiResultKind)"
                                  title="@AiResultTitle(r)">
                                @AiResultLabel(r.AiResultKind)
                            </span>
                        </td>
                        <td @onclick:stopPropagation="true" style="white-space:nowrap;">
                            <button class="btn btn-sm py-0 px-2 me-1 @(expanded ? "btn-primary" : "btn-outline-primary")"
                                    style="font-size:12px;"
                                    title="@(expanded ? "Close dataset detail" : "View dataset detail")"
                                    @onclick="() => ToggleExpand(r.DatasetName)">
                                @(expanded ? "Close" : "View")
                            </button>
                            @* OCR button removed — v4 policy ignores OCR cache;
                               only excel_paste TSV is sent to AI. *@
                            <button class="btn btn-outline-danger btn-sm py-0 px-1"
                                    style="font-size:12px;"
                                    @onclick="() => ConfirmDelete(r.DatasetName)">🗑</button>
                        </td>
                    </tr>

                    @if (expanded)
                    {
                        <!-- New AI bundle (AI_EXCEL_PROC schema) — shown when
                             the row was processed via the new CLI flow. -->
                        @if (_expandedAiDoc is not null)
                        {
                            var doc = _expandedAiDoc;
                            if (IsInputDataTestBatchDoc(doc))
                            {
                                string inputDataTestHtml = InputDataTestBatchDisplayHtml(doc);

                                <tr class="didb-detail-row">
                                    <td colspan="10" style="padding:0;">
                                        <div class="didb-input-test-result">
                                            <div class="didb-input-test-head">
                                                <div>
                                                    <div class="didb-input-test-title">
                                                        <span>INPUT DATA(TEST)</span>
                                                        <strong>@(string.IsNullOrWhiteSpace(doc.Title) ? doc.SourceDataset : doc.Title)</strong>
                                                    </div>
                                                    <div class="didb-input-test-meta">
                                                        <span>@doc.SourceDataset</span>
                                                        @if (!string.IsNullOrWhiteSpace(doc.SourceFile))
                                                        {
                                                            <span>@doc.SourceFile</span>
                                                        }
                                                        <span>@doc.SchemaVersion</span>
                                                    </div>
                                                </div>
                                                <span class="didb-ai-result didb-ai-result-new">new</span>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(inputDataTestHtml))
                                            {
                                                <div class="didb-input-test-html">
                                                    <iframe class="didb-input-test-html-frame"
                                                            sandbox=""
                                                            title="INPUT DATA(TEST) AI generated HTML"
                                                            srcdoc="@inputDataTestHtml"></iframe>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="didb-ai-generated-report">
                                                    @AiMarkdown(doc.GeneratedReportMarkdown)
                                                </div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                            string aiLang = _aiCardLang;
                            string docTitle       = AiDocTitle(doc, aiLang);
                            string docPurpose     = AiDocPurpose(doc, aiLang);
                            string aiGeneratedReport = AiGeneratedReportMarkdown(doc, aiLang);
                            bool aiHasGeneratedReport = !string.IsNullOrWhiteSpace(aiGeneratedReport);
                            bool aiShowParameterReport = !aiHasGeneratedReport || _aiCardShowAll;
                            string logRationale   = AiLogRationale(doc, aiLang);
                            var aiContent         = AiDocContent(doc, aiLang)
                                .Take(_aiCardShowAll ? int.MaxValue : 10)
                                .ToList();
                            var aiAssumptions     = AiLogAssumptions(doc, aiLang);
                            var aiWarnings        = AiLogWarnings(doc, aiLang);
                            var aiAllComparisons  = BuildAiControlComparisons(doc);
                            var aiMicroPairRowsAll = BuildMicroSpeakerPairRows(doc);
                            var aiMicroPairRows = aiMicroPairRowsAll
                                .Take(_aiCardShowAll ? aiMicroPairRowsAll.Count : 12)
                                .ToList();
                            var aiComparisons     = aiAllComparisons
                                .Where(x => (x.Variant.InputCount ?? 0) >= 50 || (x.Baseline.InputCount ?? 0) >= 50)
                                .ToList();
                            string aiReportKind   = DetectAiReportKind(doc, aiComparisons, _expandedImages.Count);
                            string aiReportLabel  = AiReportKindLabel(aiReportKind, aiLang);
                            var aiHeatmap         = aiComparisons.Take(_aiCardShowAll ? aiComparisons.Count : 9).ToList();
                            var aiComparisonRows  = aiComparisons.Take(_aiCardShowAll ? aiComparisons.Count : 8).ToList();
                            var aiProcessSections = BuildAiProcessReviewSections(doc, aiAllComparisons)
                                .Take(_aiCardShowAll ? int.MaxValue : 8)
                                .ToList();
                            var aiBriefSummary   = BuildAiFourLineSummary(doc, aiReportKind, aiAllComparisons, aiProcessSections)
                                .ToList();
                            var aiDetailedBlocks = BuildAiDetailedReportBlocks(
                                doc, aiLang, aiReportKind, aiAllComparisons, aiProcessSections, logRationale, aiWarnings, true)
                                .ToList();
                            bool aiShowPrimaryDefect = AiShowsPrimaryDefect(aiReportKind);
                            string aiReportFocus = AiReportFocusText(doc, aiReportKind, aiProcessSections);
                            double aiMaxChange    = Math.Max(1.0, aiComparisons.Select(AiComparisonMagnitude).DefaultIfEmpty(0).Max());
                            var aiAbsoluteRowsAll = BuildAiAbsoluteNgRows(doc);
                            var aiAbsoluteRows    = aiAbsoluteRowsAll
                                .Take(_aiCardShowAll ? aiAbsoluteRowsAll.Count : 10)
                                .ToList();
                            var aiAbsoluteGroupsAll = BuildAiAbsoluteNgGroups(aiAbsoluteRowsAll);
                            var aiAbsoluteGroups  = aiAbsoluteGroupsAll
                                .Take(_aiCardShowAll ? aiAbsoluteGroupsAll.Count : 6)
                                .ToList();
                            var aiTopAbsoluteRate = aiAbsoluteRows.FirstOrDefault();
                            double aiMaxAbsRate   = Math.Max(1.0, aiAbsoluteRows.Select(x => x.RatePercent).DefaultIfEmpty(0).Max());
                            var aiDimensionCompsAll = BuildAiMetricComparisons(doc, IsAiDimensionMetric);
                            var aiDimensionComps  = aiDimensionCompsAll
                                .Take(_aiCardShowAll ? aiDimensionCompsAll.Count : 8)
                                .ToList();
                            var aiDimensionRowsAll = BuildAiMetricRows(doc, IsAiDimensionMetric);
                            var aiDimensionRows   = aiDimensionRowsAll
                                .Take(_aiCardShowAll ? aiDimensionRowsAll.Count : 10)
                                .ToList();
                            var aiReliabilityRowsAll = BuildAiMetricRows(doc, IsAiReliabilityMetric)
                                .OrderByDescending(AiIsFailLike)
                                .ThenByDescending(AiIsWarnLike)
                                .ThenBy(AiResultLabel)
                                .ToList();
                            var aiReliabilityRows = aiReliabilityRowsAll
                                .Take(_aiCardShowAll ? aiReliabilityRowsAll.Count : 10)
                                .ToList();
                            var aiDoeRowsAll      = BuildAiDoeRows(doc);
                            var aiDoeRows         = aiDoeRowsAll
                                .Take(_aiCardShowAll ? aiDoeRowsAll.Count : 10)
                                .ToList();
                            var aiTopMetric       = aiDimensionRows.FirstOrDefault()
                                                    ?? aiReliabilityRows.FirstOrDefault()
                                                    ?? aiDoeRows.FirstOrDefault();
                            var aiTopDefect       = doc.NgBreakdowns.FirstOrDefault();
                            double aiDefectTotal  = doc.NgBreakdowns.Sum(x => x.TotalCount);
                            double aiMaxBreakdown = Math.Max(1.0, doc.NgBreakdowns.Select(x => x.TotalCount).DefaultIfEmpty(0).Max());
                            var aiConclusions     = doc.Conclusions.Take(_aiCardShowAll ? doc.Conclusions.Count : 3).ToList();
                            var aiHints           = doc.Hints
                                .OrderBy(AiEvidenceStrengthRank)
                                .ThenBy(x => AiHintCheck(doc, x, aiLang))
                                .Take(_aiCardShowAll ? doc.Hints.Count : 5)
                                .ToList();
                            var aiReportFocusItems = AiDisplayListItems(aiReportFocus);
                            var aiActionRows = BuildAiDisplayActionRows(doc, aiLang, aiReportKind)
                                .Take(_aiCardShowAll ? 12 : 6)
                                .ToList();

                            <tr class="didb-detail-row">
                                <td colspan="10" style="padding:0;">
                                    <div class="didb-ai-dashboard">
                                        <div class="didb-ai-hero">
                                            <div>
                                                <div class="didb-lang-row">
                                                    <button class="didb-lang @(aiLang == "ko" ? "active" : "")" @onclick="SetAiCardKo" @onclick:stopPropagation="true">한국어</button>
                                                    <button class="didb-lang @(aiLang == "en" ? "active" : "")" @onclick="SetAiCardEn" @onclick:stopPropagation="true">English</button>
                                                    <button class="didb-lang @(aiLang == "vi" ? "active" : "")" @onclick="SetAiCardVi" @onclick:stopPropagation="true">Tiếng Việt</button>
                                                </div>
                                                <div class="didb-ai-title-line">
                                                    @if (aiShowPrimaryDefect && !string.IsNullOrEmpty(doc.PrimaryDefect))
                                                    {
                                                        <span class="didb-ai-primary">@doc.PrimaryDefect</span>
                                                    }
                                                    <span class="didb-ai-title">@(string.IsNullOrEmpty(docTitle) ? doc.SourceDataset : docTitle)</span>
                                                </div>
                                                @if (!string.IsNullOrEmpty(docPurpose))
                                                {
                                                    <div class="didb-ai-purpose" title="@docPurpose">@AiBrief(docPurpose, _aiCardShowAll ? 500 : 180)</div>
                                                }
                                                <div class="didb-ai-meta">
                                                    <span>@AiUi(aiLang, "dataset") @doc.SourceDataset</span>
                                                    <span>@AiUi(aiLang, "report") @DisplayExcelDate(doc.ReportDate)</span>
                                                    <span>@aiReportLabel</span>
                                                    <span>@AiUi(aiLang, "confidence") @doc.Confidence.ToString("0.00")</span>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="didb-ai-kpis">
                                            <div class="didb-ai-kpi">
                                                <span>@AiUi(aiLang, "results")</span>
                                                <strong>@doc.Results.Count.ToString("N0")</strong>
                                                <em>@doc.ConditionsCount.ToString("N0") @AiUi(aiLang, "conditions") / @doc.Conclusions.Count.ToString("N0") @AiUi(aiLang, "conclusions")</em>
                                            </div>
                                            <div class="didb-ai-kpi didb-ai-kpi-warn">
                                                @if (aiShowPrimaryDefect)
                                                {
                                                    <span>@AiUi(aiLang, "primaryDefect")</span>
                                                    <strong>@(string.IsNullOrEmpty(doc.PrimaryDefect) ? "-" : doc.PrimaryDefect)</strong>
                                                    <em>@doc.Hints.Count.ToString("N0") @AiUi(aiLang, "suggestedChecks")</em>
                                                }
                                                else
                                                {
                                                        <span>@AiUi(aiLang, "reportFocus")</span>
                                                    @if (aiReportFocusItems.Count > 1)
                                                    {
                                                        <ul class="didb-ai-kpi-list" title="@aiReportFocus">
                                                            @foreach (var focusItem in aiReportFocusItems)
                                                            {
                                                                <li>@AiBrief(focusItem, 120)</li>
                                                            }
                                                        </ul>
                                                    }
                                                    else
                                                    {
                                                        <strong title="@aiReportFocus">@AiBrief(aiReportFocus, 160)</strong>
                                                    }
                                                    <em>@aiReportLabel</em>
                                                }
                                            </div>
                                            @if (!AiUsesProcessReview(aiReportKind) && aiTopAbsoluteRate is not null)
                                            {
                                                <div class="didb-ai-kpi didb-ai-kpi-bad">
                                                    <span>@AiUi(aiLang, "worstNgRate")</span>
                                                    <strong>@AiPct(aiTopAbsoluteRate.RatePercent)</strong>
                                                    <em>@aiTopAbsoluteRate.Label</em>
                                                </div>
                                            }
                                            else if (!AiUsesProcessReview(aiReportKind) && aiTopMetric is not null)
                                            {
                                                <div class="didb-ai-kpi @AiJudgementPanelClass(aiTopMetric)">
                                                    <span>@AiUi(aiLang, "keyMetric")</span>
                                                    <strong>@AiResultMainValue(aiTopMetric)</strong>
                                                    <em>@AiMetricLabel(aiTopMetric)</em>
                                                </div>
                                            }
                                            @if (!AiUsesProcessReview(aiReportKind) && aiTopDefect is not null)
                                            {
                                                <div class="didb-ai-kpi didb-ai-kpi-bad">
                                                    <span>@AiUi(aiLang, "topBreakdown")</span>
                                                    <strong>@aiTopDefect.DefectName</strong>
                                                    <em>@AiCount(aiTopDefect.TotalCount) count</em>
                                                </div>
                                            }
                                        </div>

                                        @if (aiActionRows.Count > 0)
                                        {
                                            <section class="didb-ai-panel didb-ai-full didb-ai-action-panel">
                                                <div class="didb-ai-report-head">
                                                    <h3>@AiUi(aiLang, "actionBoard")</h3>
                                                    <span>@AiUi(aiLang, "savedAiOnly")</span>
                                                </div>
                                                <table class="didb-ai-action-table">
                                                    <thead>
                                                        <tr>
                                                            <th>@AiUi(aiLang, "priority")</th>
                                                            <th>@AiUi(aiLang, "checkItem")</th>
                                                            <th>@AiUi(aiLang, "evidence")</th>
                                                            <th>@AiUi(aiLang, "judgement")</th>
                                                            <th>@AiUi(aiLang, "nextAction")</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var row in aiActionRows)
                                                        {
                                                            <tr class="@row.HeatClass">
                                                                <td class="n">@row.Priority</td>
                                                                <td><strong>@row.CheckItem</strong></td>
                                                                <td>@row.EvidenceResult</td>
                                                                <td>@row.Judgement</td>
                                                                <td>@row.NextAction</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </section>
                                        }

                                        @if (aiHasGeneratedReport && (_aiCardShowAll || aiActionRows.Count == 0))
                                        {
                                            <section class="didb-ai-panel didb-ai-full didb-ai-generated-panel">
                                                <div class="didb-ai-report-head">
                                                    <h3>@AiUi(aiLang, "aiGeneratedReport")</h3>
                                                    <span>@(_aiCardShowAll ? AiUi(aiLang, "originalSavedReport") : AiUi(aiLang, "fallbackView"))</span>
                                                </div>
                                                <div class="didb-ai-generated-report">
                                                    @AiMarkdown(aiGeneratedReport)
                                                </div>
                                            </section>
                                        }

                                        @if (aiShowParameterReport)
                                        {
                                            <section class="didb-ai-panel didb-ai-full didb-ai-brief-panel">
                                                <h3>Stored Parameter Summary</h3>
                                                <div class="didb-ai-brief-grid">
                                                    @foreach (var item in aiBriefSummary)
                                                    {
                                                        var summaryItems = AiDisplayListItems(item.Value);
                                                        <div class="didb-ai-brief-item">
                                                            <span>@item.Label</span>
                                                            @if (summaryItems.Count > 1)
                                                            {
                                                                <ul class="didb-ai-brief-list" title="@item.Value">
                                                                    @foreach (var summaryItem in summaryItems)
                                                                    {
                                                                        <li>@AiBrief(summaryItem, 140)</li>
                                                                    }
                                                                </ul>
                                                            }
                                                            else
                                                            {
                                                                <strong title="@item.Value">@AiBrief(item.Value, 220)</strong>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </section>
                                        }

                                        @if (aiShowParameterReport)
                                        {
                                            <section class="didb-ai-panel didb-ai-full didb-ai-report-panel">
                                                <div class="didb-ai-report-head">
                                                    <h3>Stored Parameter Report</h3>
                                                    <span>@aiReportLabel</span>
                                                </div>
                                                <div class="didb-ai-report-grid">
                                                @foreach (var block in aiDetailedBlocks)
                                                {
                                                    <article class="didb-ai-report-block @block.Kind">
                                                        <h4>@block.Title</h4>
                                                        @if (block.TableRows.Count > 0)
                                                        {
                                                            var visibleHeaders = AiReportVisibleHeaders(block);
                                                            <table class="didb-ai-report-table">
                                                                <thead>
                                                                    <tr>
                                                                        @foreach (var header in visibleHeaders)
                                                                        {
                                                                            <th>@header</th>
                                                                        }
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @if (AiIsGroupedResultTable(block))
                                                                    {
                                                                        @foreach (var group in AiReportResultGroups(block.TableRows))
                                                                        {
                                                                            <tr class="didb-ai-report-process-row">
                                                                                <td colspan="@visibleHeaders.Count">@group.Process</td>
                                                                            </tr>
