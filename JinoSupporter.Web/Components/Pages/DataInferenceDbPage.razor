                                                        <div class="didb-ai-empty">No same-event Normal/Baseline row was found, so this panel compares actual NG rate rows within each process instead of making an improvement/worsening verdict.</div>
                                                        <div class="didb-ai-process-ng-grid">
                                                            @foreach (var group in aiAbsoluteGroups)
                                                            {
                                                                <article class="didb-ai-process-ng-card">
                                                                    <div class="didb-ai-process-ng-head">
                                                                        <strong>@group.Process</strong>
                                                                        <span>@group.Rows.Count row(s)</span>
                                                                    </div>
                                                                    <div class="didb-ai-process-ng-kpis">
                                                                        <div class="@AiAbsoluteHeatClass(group.Worst)">
                                                                            <span>Worst</span>
                                                                            <strong>@AiPct(group.Worst.RatePercent)</strong>
                                                                            <em title="@group.Worst.Label">@AiBrief(group.Worst.Label, 64)</em>
                                                                        </div>
                                                                        <div class="@AiAbsoluteHeatClass(group.Best)">
                                                                            <span>Best</span>
                                                                            <strong>@AiPct(group.Best.RatePercent)</strong>
                                                                            <em title="@group.Best.Label">@AiBrief(group.Best.Label, 64)</em>
                                                                        </div>
                                                                    </div>
                                                                    <table class="didb-ai-mini-table">
                                                                        <tbody>
                                                                            @foreach (var row in group.Rows.Take(_aiCardShowAll ? 8 : 4))
                                                                            {
                                                                                <tr>
                                                                                    <td title="@row.Label">@AiBrief(row.Label, 72)</td>
                                                                                    <td class="n">@AiCount(row.InputCount)</td>
                                                                                    <td class="n">@AiCount(row.NgCount)</td>
                                                                                    <td class="n"><span class="didb-ai-chip @AiAbsoluteHeatClass(row)">@AiPct(row.RatePercent)</span></td>
                                                                                </tr>
                                                                            }
                                                                        </tbody>
                                                                    </table>
                                                                </article>
                                                            }
                                                        </div>
                                                        <table class="didb-ai-comp-table">
                                                            <thead>
                                                                <tr>
                                                                    <th>Condition</th>
                                                                    <th class="n">Input</th>
                                                                    <th class="n">NG</th>
                                                                    <th class="n">NG Rate</th>
                                                                    <th>Scale</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var row in aiAbsoluteRows)
                                                                {
                                                                    double width = AiBarWidth(row.RatePercent, aiMaxAbsRate);
                                                                    <tr>
                                                                        <td><strong>@row.Label</strong></td>
                                                                        <td class="n">@AiCount(row.InputCount)</td>
                                                                        <td class="n">@AiCount(row.NgCount)</td>
                                                                        <td class="n"><span class="didb-ai-chip @AiAbsoluteHeatClass(row)">@AiPct(row.RatePercent)</span></td>
                                                                        <td>
                                                                            <div class="didb-ai-tablebar">
                                                                                <div class="didb-ai-bar @AiRateBarClass(row.RatePercent)" style="@($"width:{width:F1}%")"></div>
                                                                            </div>
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    }
                                                    else
                                                    {
                                                        <div class="didb-ai-empty">No same-sheet Normal/Baseline row and no type-specific metric rows were normalized.</div>
                                                    }
                                                }
                                                else
                                                {
                                                    @if (AiUsesProcessReview(aiReportKind) && aiProcessSections.Count > 0)
                                                    {
                                                        <div class="didb-ai-process-stack">
                                                            @foreach (var procSection in aiProcessSections)
                                                            {
                                                                <div class="didb-ai-process-section">
                                                                    <div class="didb-ai-process-head">
                                                                        <div>
                                                                            <h4>@procSection.Process</h4>
                                                                            <span>@procSection.EventLabel</span>
                                                                        </div>
                                                                        <em>@procSection.Rows.Count item(s)</em>
                                                                    </div>
                                                                    <table class="didb-ai-comp-table didb-ai-review-table">
                                                                        <thead>
                                                                            <tr>
                                                                                <th>Measurement</th>
                                                                                <th class="n">Normal</th>
                                                                                <th class="n">Test</th>
                                                                                <th class="n">Change</th>
                                                                                <th>Result</th>
                                                                            </tr>
                                                                        </thead>
                                                                        <tbody>
                                                                            @foreach (var row in procSection.Rows)
                                                                            {
                                                                                <tr>
                                                                                    <td>
                                                                                        <strong>@row.Metric</strong>
                                                                                        <span>@row.Kind</span>
                                                                                    </td>
                                                                                    <td class="n">
                                                                                        <strong>@row.BaselineValue</strong>
                                                                                        <span>@row.BaselineDetail</span>
                                                                                    </td>
                                                                                    <td class="n">
                                                                                        <strong>@row.VariantValue</strong>
                                                                                        <span>@row.VariantDetail</span>
                                                                                    </td>
                                                                                    <td class="n">@row.ChangeText</td>
                                                                                    <td><span class="didb-ai-chip @row.HeatClass">@row.ResultText</span></td>
                                                                                </tr>
                                                                            }
                                                                        </tbody>
                                                                    </table>
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="didb-ai-heatmap">
                                                            @foreach (var cmp in aiHeatmap)
                                                            {
                                                                <div class="didb-ai-heat @AiHeatClass(cmp)" title="@AiComparisonSubtitle(cmp)">
                                                                    <strong>@AiRelativeChangeText(cmp)</strong>
                                                                    <span>@AiComparisonTitle(cmp)</span>
                                                                    <em>@AiPct(AiNgRatePercent(cmp.Baseline)) -> @AiPct(AiNgRatePercent(cmp.Variant)) @AiRateRatioValue(cmp)</em>
                                                                </div>
                                                            }
                                                        </div>

