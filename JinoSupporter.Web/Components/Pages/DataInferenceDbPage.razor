@code {
    private sealed record ImgThumb(string MediaType, string DataUrl, string FileName);

    private List<RawReportInfo>          _reports              = [];
    private string                       _productTypeFilter    = "";
    private string                       _aiBatchFilter        = "all";
    private string?                      _expanded             = null;

    private List<string> _productTypeOptions => _reports
        .Select(r => r.ProductType)
        .Where(p => !string.IsNullOrWhiteSpace(p))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(p => p, StringComparer.OrdinalIgnoreCase)
        .ToList();

    private string DatasetFilterSuffix
    {
        get
        {
            bool hasProduct = !string.IsNullOrEmpty(_productTypeFilter);
            bool hasBatch = _aiBatchFilter != "all";
            return hasProduct || hasBatch ? $" / {_reports.Count} total" : "";
        }
    }

    private List<RawReportInfo> FilteredReports => _reports
        .Where(r => string.IsNullOrEmpty(_productTypeFilter)
            || string.Equals(r.ProductType, _productTypeFilter, StringComparison.OrdinalIgnoreCase))
        .Where(r => _aiBatchFilter switch
        {
            "batched" => !string.IsNullOrWhiteSpace(r.BatchedAt),
            "pending" => string.IsNullOrWhiteSpace(r.BatchedAt),
            _ => true,
        })
        .ToList();

    private List<NormalizedMeasurement>  _expandedMeasurements = [];
    private DatasetSummaryRecord?        _expandedSummary      = null;
    private AiDocBundle?                 _expandedAiDoc        = null;
    private bool                         _aiCardShowAll        = false;
    private string                       _aiCardLang           = "en";  // 'ko'|'en'|'vi'
    private void SetAiCardKo() => _aiCardLang = "ko";
    private void SetAiCardEn() => _aiCardLang = "en";
    private void SetAiCardVi() => _aiCardLang = "vi";
    private List<ImgThumb>               _expandedImages       = [];
    private List<RawFileInfo>            _expandedFiles        = [];
    private string                       _expandedOcrText      = "";
    private string                       _expandedExcelPaste   = "";
    private string                       _sourceView           = "ocr";  // "ocr" | "excel" | "split"
    private string?                      _deleteTarget         = null;
    private bool                         _showDeleteAll        = false;
    private string?                      _viewerDataUrl        = null;

    // Language pills for the expanded summary. Default "en" = original AI output.
    // Falls back to en when the active translation is missing/empty per field.
    private string _dbLang = "en";

    // Source-text view mode for the Excel paste TSV (matches Data Input UX):
    //   "table" — parse TSV + render as HTML table with cell colors
    //   "text"  — raw TSV in a <pre> block
    // OCR markdown / split view stays as <pre> regardless.
    private string _excelView = "table";

    // The compact AI card is the default view. Full 7-field detail (still
    // saved in the DB as the AI Ask back-data context) shows only when the
