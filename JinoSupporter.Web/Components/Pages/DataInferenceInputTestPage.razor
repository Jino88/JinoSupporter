    [JSInvokable]
    public void OnBackupFileDropped(string fileName, string mediaType, string dataUrl)
    {
        int comma = dataUrl.IndexOf(',');
        if (comma < 0) return;
        string b64 = dataUrl[(comma + 1)..];
        byte[] bytes;
        try { bytes = Convert.FromBase64String(b64); }
        catch { return; }
        string mt = string.IsNullOrEmpty(mediaType) ? "application/octet-stream" : mediaType;
        _files.Add(new FileEntry(fileName, mt, bytes, null));
        InvokeAsync(StateHasChanged);
    }

    /// <summary>Convert an uploaded Excel filename into a usable dataset name:
    /// drop the .xlsx/.xlsm extension, then strip one trailing "_clean" suffix
    /// that the DRM unlock helper appends. "foo_clean_clean.xlsx" → "foo_clean"
    /// (only one suffix is stripped, by design). Returns empty if the file
    /// name was just "_clean.xlsx".</summary>
    private static string DeriveDatasetName(string fileName)
    {
        string name = Path.GetFileNameWithoutExtension(fileName ?? "");
        if (name.EndsWith("_clean", StringComparison.OrdinalIgnoreCase))
            name = name.Substring(0, name.Length - "_clean".Length);
        return name.Trim();
    }

    /// <summary>Look up a Mid-group Material name that fuzzy-matches the
    /// dataset name (3-tier rule, see inline). Normalizes by uppercasing and
    /// stripping non-alphanumerics on both sides. Returns the best-scoring
    /// Material, or "" when nothing scores. Picks the longest match when
    /// several candidates fit, so a more specific Material wins over a
    /// generic shorter one.
    ///
    /// Real-world cases this catches (verified against current DB names):
    ///   "BRS-161016 Report ..."        → "BRS-161016S08ZZ"   (core hit)
    ///   "MSU-L20S15-07 Hearing ..."    → "MSU-L20S15-07"     (full hit)
    /// Cases intentionally NOT matched (avoid false positives):
    ///   "MSU - 20S15-07 ..."           → "" (user dropped the L prefix)
    ///   "...11.18.2024" + TIU-C11-18   → "" (date stamp, not a model ID)
    /// </summary>
    private static string FindMatchingMidGroup(string fileName, IEnumerable<string> materials)
    {
        string nFile = Normalize(fileName);
        if (nFile.Length == 0) return "";

        string best = "";
        int    bestScore = 0;
        foreach (var mat in materials)
        {
            if (string.IsNullOrWhiteSpace(mat)) continue;
            string nMat = Normalize(mat);
            if (nMat.Length < 3) continue;

            int score = 0;
            // Tier 1 — full normalized material appears in normalized filename.
            // Score = 2× length so a complete hit always beats a partial one.
            if (nFile.Contains(nMat, StringComparison.Ordinal))
            {
                score = nMat.Length * 2;
            }
            else
            {
                // Tier 2 — "core" of the material (alpha prefix + first digit
                // run) appears in filename. Catches the common case where the
                // Mid-group is registered as a long SKU like "BRS-161016S08ZZ"
                // but filenames use the short form "BRS-161016".
                string core = ExtractCore(nMat);
                if (core.Length >= 4 && nFile.Contains(core, StringComparison.Ordinal))
                {
                    score = core.Length;
                }
                else
                {
                    // Tier 3 — digit-only fallback. Useful when the filename
                    // dropped the alpha prefix ("Report_201506_v2.xlsx" still
                    // resolves to BRS-201506). To stop dates ("11.18.2024" →
                    // "1118") from impersonating model IDs of *other* families
                    // (TIU-C11-18), we additionally require the material's
                    // alpha prefix to also be present in the filename.
                    string matDigits = new string(nMat.Where(char.IsDigit).ToArray());
                    string matAlpha  = new string(nMat.Where(char.IsLetter).ToArray());
                    if (matDigits.Length >= 4
                        && nFile.Contains(matDigits, StringComparison.Ordinal)
                        && (matAlpha.Length == 0 || nFile.Contains(matAlpha, StringComparison.Ordinal)))
                    {
                        score = matDigits.Length;
                    }
                }
            }

            if (score > bestScore) { bestScore = score; best = mat; }
        }
        return best;

        static string Normalize(string s)
        {
            if (string.IsNullOrEmpty(s)) return "";
            var sb = new System.Text.StringBuilder(s.Length);
            foreach (var c in s)
                if (char.IsLetterOrDigit(c)) sb.Append(char.ToUpperInvariant(c));
            return sb.ToString();
        }

        // Pulls out "BRS161016" from "BRS161016S08ZZ" — the leading
        // alpha-then-digit block. Empty string if pattern doesn't start
        // with letters.
        static string ExtractCore(string normalized)
        {
            int i = 0;
            while (i < normalized.Length && char.IsLetter(normalized[i])) i++;
            int alphaEnd = i;
            while (i < normalized.Length && char.IsDigit(normalized[i])) i++;
            if (alphaEnd == 0 || i == alphaEnd) return "";
            return normalized.Substring(0, i);
        }
    }

    /// <summary>Cached list of all Mid-group Material names from ModelGroups.
    /// Loaded lazily on first queue / drop, refreshed only if explicitly
    /// invalidated.</summary>
    private List<string>? _midGroupMaterials;
    private List<string> GetMidGroupMaterials()
    {
        if (_midGroupMaterials is not null) return _midGroupMaterials;
        _midGroupMaterials = Repo.GetModelGroups()
            .SelectMany(g => g.MidGroups)
            .Select(m => m.Material)
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        return _midGroupMaterials;
    }

    private Dictionary<string, string>? _aliasMap;
    private Dictionary<string, string> GetAliasMap()
        => _aliasMap ??= Repo.GetDataInputAliases();
    private void InvalidateMatchingCaches()
    {
        _midGroupMaterials = null;
        _aliasMap = null;
    }

    /// <summary>Pull the dominant "model token" out of a filename — usually
    /// a 2-4 letter prefix followed by digits, optionally suffixed with an
    /// SKU code. Returns "" if no recognizable pattern found. Used by both
    /// the Review Tokens panel and the alias-aware matcher.</summary>
    private static readonly System.Text.RegularExpressions.Regex TokenRx =
        new(@"(?:^|[^A-Za-z0-9])([A-Za-z]{2,4}(?:\s*[-_]\s*)?[A-Za-z]?\d{3,}(?:S\d{2}[A-Za-z]{0,2})?)",
            System.Text.RegularExpressions.RegexOptions.Compiled | System.Text.RegularExpressions.RegexOptions.IgnoreCase);

    private static string ExtractToken(string fileName)
    {
        if (string.IsNullOrEmpty(fileName)) return "";
        var m = TokenRx.Match(fileName);
        if (!m.Success) return "";
        string t = System.Text.RegularExpressions.Regex.Replace(m.Groups[1].Value, @"\s+", "");
        return t.Replace('_', '-').ToUpperInvariant();
    }

    /// <summary>Same as FindMatchingMidGroup but consults the user-curated
    /// alias table first. If the filename's token is mapped explicitly, that
    /// wins regardless of what the fuzzy rules would say.</summary>
    private string FindProductTypeFor(string fileName)
    {
        string token = ExtractToken(fileName);
        if (!string.IsNullOrEmpty(token)
            && TryGetAliasForToken(token, GetAliasMap(), out string aliased))
        {
            return aliased;
        }
        return FindMatchingMidGroup(fileName, GetMidGroupMaterials());
    }

    private static bool TryGetAliasForToken(
        string token,
        Dictionary<string, string> aliases,
        out string aliased)
    {
        aliased = "";
        if (aliases.TryGetValue(token, out string? exact) && !string.IsNullOrWhiteSpace(exact))
        {
            aliased = exact;
            return true;
        }

        string key = AliasLookupKey(token);
        foreach (var kv in aliases)
        {
            if (!string.IsNullOrWhiteSpace(kv.Value) && AliasLookupKey(kv.Key) == key)
            {
                aliased = kv.Value;
                return true;
            }
        }
        return false;
    }

    private static string AliasLookupKey(string token)
    {
        if (string.IsNullOrWhiteSpace(token)) return "";
        return new string(token
            .Where(char.IsLetterOrDigit)
            .Select(char.ToUpperInvariant)
            .ToArray());
    }

    /// <summary>Try to extract a date from an arbitrary filename. Supports:
    ///   - "YYYY.MM.DD" / "YYYY MM DD" / "YYYY_MM_DD" / "YYYY-MM-DD"
    ///   - "DD.MM.YYYY" / "DD MM YYYY" / etc. (Korean factory convention —
    ///     prefers DD-first over MM-first when both fit ≤12)
    ///   - "YYYYMMDD" compact (8 digits)
    /// Returns "yyyy-MM-dd" or null when no plausible date found.</summary>
    private static string? DeriveDateFromFileName(string fileName)
    {
        string name = Path.GetFileNameWithoutExtension(fileName ?? "");
        if (string.IsNullOrEmpty(name)) return null;

        // 1) YYYY-MM-DD style — year first (4 digits)
        var rx1 = new System.Text.RegularExpressions.Regex(
            @"(?<!\d)(\d{4})[.\s_\-/](\d{1,2})[.\s_\-/](\d{1,2})(?!\d)");
        foreach (System.Text.RegularExpressions.Match m in rx1.Matches(name))
        {
            if (TryMakeDate(int.Parse(m.Groups[1].Value),
                            int.Parse(m.Groups[2].Value),
                            int.Parse(m.Groups[3].Value), out var iso))
                return iso;
        }

        // 2) DD-MM-YYYY (year last). Disambiguate D/M when both ≤ 12:
        //    Korean reports overwhelmingly write day first.
        var rx2 = new System.Text.RegularExpressions.Regex(
            @"(?<!\d)(\d{1,2})[.\s_\-/](\d{1,2})[.\s_\-/](\d{4})(?!\d)");
        foreach (System.Text.RegularExpressions.Match m in rx2.Matches(name))
        {
            int a = int.Parse(m.Groups[1].Value);
            int b = int.Parse(m.Groups[2].Value);
            int y = int.Parse(m.Groups[3].Value);
            int d, mo;
            if (a > 12 && b <= 12)      { d = a; mo = b; }    // unambiguous DD-MM
            else if (b > 12 && a <= 12) { mo = a; d = b; }    // unambiguous MM-DD
            else                        { d = a; mo = b; }    // default DD-MM
            if (TryMakeDate(y, mo, d, out var iso)) return iso;
        }

        // 3) YYYYMMDD compact — 8 consecutive digits not preceded/followed by digit
        var rx3 = new System.Text.RegularExpressions.Regex(
            @"(?<!\d)(\d{4})(\d{2})(\d{2})(?!\d)");
        foreach (System.Text.RegularExpressions.Match m in rx3.Matches(name))
        {
            if (TryMakeDate(int.Parse(m.Groups[1].Value),
                            int.Parse(m.Groups[2].Value),
                            int.Parse(m.Groups[3].Value), out var iso))
                return iso;
        }

        return null;

        static bool TryMakeDate(int y, int m, int d, out string iso)
        {
            iso = "";
            if (y < 2000 || y > 2099) return false;   // sanity — only this century
            if (m < 1 || m > 12)     return false;
            if (d < 1 || d > 31)     return false;
            try { iso = new DateTime(y, m, d).ToString("yyyy-MM-dd"); return true; }
            catch { return false; }
        }
    }

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / 1024.0 / 1024.0:F1} MB";
    }

    private static List<ExcelPreviewSheet> BuildWorkbookPreview(string xlsxPath)
    {
        const int MaxPreviewRows = 2000;
        const int MaxPreviewColumns = 200;

        var sheets = new List<ExcelPreviewSheet>();
        using var wb = new XLWorkbook(xlsxPath);

        foreach (var ws in wb.Worksheets)
        {
            var used = ws.RangeUsed();
            if (used is null) continue;

            int firstRow = used.FirstRow().RowNumber();
            int lastRow = used.LastRow().RowNumber();
            int firstCol = used.FirstColumn().ColumnNumber();
            int lastCol = used.LastColumn().ColumnNumber();
            int rowEnd = Math.Min(lastRow, firstRow + MaxPreviewRows - 1);
            int colEnd = Math.Min(lastCol, firstCol + MaxPreviewColumns - 1);

            var covered = new HashSet<(int Row, int Column)>();
            var spans = new Dictionary<(int Row, int Column), (int RowSpan, int ColumnSpan)>();

            foreach (var range in ws.MergedRanges)
            {
                var address = range.RangeAddress;
                int anchorRow = address.FirstAddress.RowNumber;
                int anchorCol = address.FirstAddress.ColumnNumber;
                int endRow = address.LastAddress.RowNumber;
                int endCol = address.LastAddress.ColumnNumber;

                if (anchorRow < firstRow || anchorRow > rowEnd || anchorCol < firstCol || anchorCol > colEnd)
                    continue;
                if (endRow < firstRow || endCol < firstCol || anchorRow > rowEnd || anchorCol > colEnd)
                    continue;

                int visibleEndRow = Math.Min(endRow, rowEnd);
                int visibleEndCol = Math.Min(endCol, colEnd);
                int rowSpan = Math.Max(1, visibleEndRow - anchorRow + 1);
                int colSpan = Math.Max(1, visibleEndCol - anchorCol + 1);
                spans[(anchorRow, anchorCol)] = (rowSpan, colSpan);

                for (int r = anchorRow; r <= visibleEndRow; r++)
                {
                    for (int c = anchorCol; c <= visibleEndCol; c++)
                    {
                        if (r == anchorRow && c == anchorCol) continue;
                        covered.Add((r, c));
                    }
                }
            }

            var rows = new List<List<ExcelPreviewCell?>>();
            for (int r = firstRow; r <= rowEnd; r++)
            {
                var previewRow = new List<ExcelPreviewCell?>(colEnd - firstCol + 1);
                for (int c = firstCol; c <= colEnd; c++)
                {
                    if (covered.Contains((r, c)))
                    {
                        previewRow.Add(null);
                        continue;
                    }

                    var cell = ws.Cell(r, c);
                    string value = cell.IsEmpty() ? "" : cell.GetFormattedString();
                    value = value.Replace('\t', ' ').Replace('\r', ' ').Replace('\n', ' ');
                    if (value.Length > MaxCellChars)
                        value = value[..MaxCellChars] + "…";

                    spans.TryGetValue((r, c), out var span);
                    if (span.RowSpan <= 0) span = (1, 1);

                    previewRow.Add(new ExcelPreviewCell
                    {
                        Value = value,
                        Bg = PreviewBg(cell),
                        Fg = PreviewFg(cell),
                        Bold = IsBold(cell),
                        RowSpan = span.RowSpan,
                        ColumnSpan = span.ColumnSpan,
                    });
                }
                rows.Add(previewRow);
            }

            sheets.Add(new ExcelPreviewSheet
            {
                Name = ws.Name,
                FirstRow = firstRow,
                FirstColumn = firstCol,
                MaxColumns = colEnd - firstCol + 1,
                Rows = rows,
            });
        }

        return sheets;
    }

    private static string? PreviewBg(IXLCell cell)
    {
        try
        {
            var fill = cell.Style.Fill;
            if (fill.PatternType == XLFillPatternValues.None) return null;
            string? bg = ColorHex(fill.BackgroundColor);
            return bg is null || bg == "FFFFFF" ? null : $"#{bg}";
        }
        catch { return null; }
    }

    private static string? PreviewFg(IXLCell cell)
    {
        try
        {
            string? fg = ColorHex(cell.Style.Font.FontColor);
            return fg is null || fg == "000000" ? null : $"#{fg}";
        }
        catch { return null; }
    }

    private static bool IsBold(IXLCell cell)
    {
        try { return cell.Style.Font.Bold; }
        catch { return false; }
    }

    // ── DRM Excel: upload → helper unlock → ClosedXML read → TSV → _pastedText ──

    // ── Queue handlers ──────────────────────────────────────────────────────

    private async Task OnQueueFilesSelected(InputFileChangeEventArgs e)
    {
        // No helper dependency — queue accepts already-unlocked .xlsx files.

        // Snapshot existing datasets ONCE so the duplicate check stays cheap
        // when the user drops many files at once. Dataset names are matched
        // by the same derivation rule as the single-file flow (strip .xlsx
        // and a trailing _clean) so dropping "foo_clean.xlsx" detects an
        // existing "foo".
        var existing = Repo.GetAllRawReports()
            .ToDictionary(r => r.DatasetName, r => r.ReportDate,
                          StringComparer.OrdinalIgnoreCase);

        // Stage each upload to a temp file immediately (IBrowserFile streams
        // can't be replayed). We hold the temp path on the QueueItem and the
        // processor reads from there.
        string stageDir = Path.Combine(Path.GetTempPath(),
            "jinosupp-input-queue", Guid.NewGuid().ToString("N"));
        Directory.CreateDirectory(stageDir);

        // Cap is generous because users drop whole folders (200–500 files at a
        // time). Blazor throws InvalidOperationException — not a silent trim —
        // if the actual count exceeds this, so we wrap with a visible error.
        IReadOnlyList<IBrowserFile> files;
        try
        {
            files = e.GetMultipleFiles(maximumFileCount: 2000);
        }
        catch (Exception ex)
        {
            _queue.Add(new QueueItem
            {
                FileName = $"(drop rejected — {e.FileCount} files)",
                Status = "error",
                Detail = ex.Message,
            });
            await InvokeAsync(StateHasChanged);
            return;
        }

        int dupCountBefore = _skippedDups.Count;
        foreach (var file in files)
        {
            string lower = file.Name.ToLowerInvariant();
            if (!lower.EndsWith(".xlsx") && !lower.EndsWith(".xlsm")) continue;

            // Derive the eventual dataset name BEFORE staging so duplicates
            // get caught early — saves us reading the file off disk for
            // something we're going to skip.
            string dsName = DeriveDatasetName(file.Name);
            bool isDup = existing.ContainsKey(dsName);

            // Duplicate short-circuit: NOT queued, NOT staged. Record into
            // the "skipped" panel so the user sees which files were
            // rejected, then move on. Force-replace ON bypasses this.
            if (isDup && !_queueForceReplace)
            {
                string rdate = existing.TryGetValue(dsName, out var rd) ? (rd ?? "") : "";
                _skippedDups.Add(new SkippedDup
                {
                    FileName  = file.Name,
                    Dataset   = dsName,
                    ExistingDate = rdate,
                });
                continue;
            }

            string staged = Path.Combine(stageDir, $"{Guid.NewGuid():N}_{file.Name}");
            try
            {
                await using var src = file.OpenReadStream(200 * 1024 * 1024);
                await using var dst = File.Create(staged);
                await src.CopyToAsync(dst);
            }
            catch (Exception ex)
            {
                _queue.Add(new QueueItem
                {
                    FileName = file.Name, FileSize = file.Size,
                    Status = "error", Detail = $"upload: {ex.Message}"
                });
                continue;
            }

            // Look up matching Mid-group Material from ModelGroups to use
            // as the Product Type. Same fuzzy rule for queue + single-file
            // flow so behavior is consistent.
            string productType = FindProductTypeFor(file.Name);

            var item = new QueueItem
            {
                FileName = file.Name,
                FileSize = file.Size,
                StagedPath = staged,
                SavedDatasetName = dsName,
                ProductType = productType,
            };

            _queue.Add(item);
        }

        int addedDups = _skippedDups.Count - dupCountBefore;
        if (addedDups > 0)
        {
            var thisDrop = _skippedDups.Skip(dupCountBefore).ToList();
            string sample = string.Join(", ", thisDrop.Take(3).Select(s => s.FileName));
            SetStatus($"Skipped {addedDups} duplicate file(s) — already in DB: {sample}{(addedDups > 3 ? $" (+{addedDups - 3} more)" : "")}", false);
        }

        await InvokeAsync(StateHasChanged);
        _ = ProcessQueueAsync();
    }

    /// <summary>Per-item force button: switch a duplicate item back to
    /// "queued" so the processor picks it up and overwrites the DB row.</summary>
    private void ForceProcessDuplicate(QueueItem q)
    {
        if (q.Status != "duplicate") return;
        q.Status = "queued";
        q.Detail = "";
        _ = ProcessQueueAsync();
    }

    /// <summary>Open the Review Tokens modal: aggregate distinct filename
    /// tokens from the current queue + any datasets already in the DB,
    /// pair each with its auto-match (or empty), and pre-fill the user's
    /// existing alias overrides.</summary>
    private void OpenAliasReview()
    {
        var aliases = GetAliasMap();
        var mats    = GetMidGroupMaterials();

        // Sources: queue items + saved RawReports. We dedupe by token and
        // keep up to a handful of sample filenames per token for context.
        var byToken = new Dictionary<string, AliasReviewRow>(StringComparer.OrdinalIgnoreCase);
        void Push(string fileName)
        {
            string tok = ExtractToken(fileName);
            if (string.IsNullOrEmpty(tok)) return;
            if (!byToken.TryGetValue(tok, out var row))
            {
                aliases.TryGetValue(tok, out var existingAlias);
                row = new AliasReviewRow
                {
                    Token     = tok,
                    AutoMatch = FindMatchingMidGroup(fileName, mats),
                    Draft     = existingAlias ?? "",
                };
                byToken[tok] = row;
            }
            if (row.Samples.Count < 5 && !row.Samples.Contains(fileName))
                row.Samples.Add(fileName);
        }
        foreach (var q in _queue) Push(q.FileName);
        foreach (var r in Repo.GetAllRawReports()) Push(r.DatasetName);

        // Sort: unmatched (no auto-match AND no draft) first, then by token
        _aliasReviewRows = byToken.Values
            .OrderBy(r => !string.IsNullOrEmpty(r.AutoMatch) || !string.IsNullOrEmpty(r.Draft))
            .ThenBy(r => r.Token, StringComparer.Ordinal)
            .ToList();
        _aliasReviewOpen = true;
    }

    private void CloseAliasReview()
    {
        _aliasReviewOpen = false;
        _aliasReviewRows.Clear();
    }

    private void ClearAlias(AliasReviewRow row)
    {
        Repo.DeleteDataInputAlias(row.Token);
        row.Draft = "";
        InvalidateMatchingCaches();
        // Note: row only updates the in-memory draft display. The DB
        // re-stamp happens on the Save & re-match action so multiple
        // edits batch into one pass.
    }

    private void SaveAliasReview()
    {
        foreach (var row in _aliasReviewRows)
        {
            string draft = (row.Draft ?? "").Trim();
            if (string.IsNullOrEmpty(draft))
            {
                // Treat empty as "remove explicit mapping" so the row falls
                // back to auto-match (or "" if none).
                Repo.DeleteDataInputAlias(row.Token);
            }
            else
            {
                Repo.SaveDataInputAlias(row.Token, draft);
            }
        }
        InvalidateMatchingCaches();

        // 1) Re-apply matching to every queue item (UI chips refresh).
        foreach (var q in _queue)
        {
            string newPt = FindProductTypeFor(q.FileName);
            if (newPt != q.ProductType) q.ProductType = newPt;
        }

        // 2) Re-stamp the ProductType column on every already-saved
        //    RawReport. Without this, datasets persisted before the alias
        //    edit keep their old ProductType (often "") forever — that's
        //    the "doesn't change" the user was seeing.
        int dbUpdated = 0;
        foreach (var r in Repo.GetAllRawReports())
        {
            string newPt = FindProductTypeFor(r.DatasetName);
            if ((r.ProductType ?? "") == (newPt ?? "")) continue;
            if (Repo.UpdateRawReportProductType(r.DatasetName, newPt) > 0) dbUpdated++;
        }

        SetStatus($"Aliases saved — {dbUpdated} dataset(s) re-stamped in DB.", false);
        CloseAliasReview();
    }

    private async Task ProcessQueueAsync()
    {
        if (_queueRunning) return;
        _queueRunning = true;
        try
        {
            while (true)
            {
                QueueItem? next;
                lock (_queue) { next = _queue.FirstOrDefault(q => q.Status == "queued"); }
                if (next is null) break;

                try { await ProcessQueueItemAsync(next); }
                catch (Exception ex)
                {
                    next.Status = "error";
                    next.Detail = ex.Message;
                }
                _queueDone = _queue.Count(q => q.Status is "done" or "error");
                await InvokeAsync(StateHasChanged);
            }
        }
        finally
        {
            _queueRunning = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ProcessQueueItemAsync(QueueItem item)
    {
        // Files come in already-DRM-unlocked (user runs the unlock step
        // separately via Test Excel Converter). The queue is just the
        // extract + save half of the pipeline.
        if (!File.Exists(item.StagedPath))
        {
            item.Status = "error";
            item.Detail = "staged file missing";
            return;
        }

        try
        {
            item.Status = "saving"; await InvokeAsync(StateHasChanged);

            // Derive dataset name + date from file name (same rules as the
            // single-file flow). Auto-Save: each queued file is persisted
            // immediately so the user doesn't have to click anything.
            string dsName = DeriveDatasetName(item.FileName);
            string testDate = DeriveDateFromFileName(item.FileName)
                              ?? DateTime.Today.ToString("yyyy-MM-dd");
            if (string.IsNullOrWhiteSpace(dsName)) dsName = Path.GetFileNameWithoutExtension(item.FileName);

            // Store the workbook itself. Do not extract TSV or screenshots here:
            // AI Batch reads RawReportFiles directly so merged ranges remain
            // available to the model/tooling.
            var workbookFiles = new List<(string MediaType, byte[] Data, string FileName)>();
            try
            {
                byte[] bytes = await File.ReadAllBytesAsync(item.StagedPath);
                string mediaType = Path.GetExtension(item.FileName).Equals(".xlsm", StringComparison.OrdinalIgnoreCase)
                    ? "application/vnd.ms-excel.sheet.macroEnabled.12"
                    : "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
                workbookFiles.Add((
                    mediaType,
                    bytes,
                    item.FileName));
            }
            catch (Exception ex)
            {
                item.Status = "error";
                item.Detail = $"read workbook: {ex.Message}";
                return;
            }

            await Task.Run(() =>
            {
                Repo.SaveRawReport(dsName, item.ProductType, testDate, []);
                foreach (var fi in Repo.GetRawReportFileInfos(dsName))
                    Repo.DeleteRawReportFile(fi.Id);
                Repo.DeleteExtractedText(dsName, null);
                Repo.AppendRawReportFiles(dsName, workbookFiles);
            });

            item.SavedDatasetName = dsName;
            item.Status = "done";
            item.Detail = "";
        }
        finally
        {
            try { if (File.Exists(item.StagedPath)) File.Delete(item.StagedPath); } catch { }
        }
    }

    /// <summary>Clicking a queue item opens a workbook-only preview. It does not
    /// persist TSV; AI Batch still reads the saved XLSX from RawReportFiles.</summary>
    private async Task SelectQueueItemAsync(QueueItem q)
    {
        if (q.Status != "done" || string.IsNullOrWhiteSpace(q.SavedDatasetName)) return;
        var info = Repo.GetAllRawReports().FirstOrDefault(r => r.DatasetName == q.SavedDatasetName);
        if (info is null) return;

        _queuePreviewActive = true;
        _queuePreviewLoading = true;
        _queuePreviewDataset = info.DatasetName;
        _queuePreviewFileName = q.FileName;
        _queuePreviewSheets = [];
        await InvokeAsync(StateHasChanged);

        string? tempPath = null;
        try
        {
            var fileInfo = Repo.GetRawReportFileInfos(info.DatasetName)
                .LastOrDefault(f =>
                    f.FileName.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase) ||
                    f.FileName.EndsWith(".xlsm", StringComparison.OrdinalIgnoreCase));
            if (fileInfo is null)
            {
                _queuePreviewSheets = [];
                return;
            }

            var stored = Repo.GetRawReportFile(fileInfo.Id);
            if (stored is null)
            {
                _queuePreviewSheets = [];
                return;
            }

            string ext = Path.GetExtension(stored.Value.FileName);
            if (string.IsNullOrWhiteSpace(ext)) ext = ".xlsx";
            tempPath = Path.Combine(Path.GetTempPath(), $"jinosupp-preview-{Guid.NewGuid():N}{ext}");
            await File.WriteAllBytesAsync(tempPath, stored.Value.Data);

            _queuePreviewSheets = await Task.Run(() => BuildWorkbookPreview(tempPath));
            _queuePreviewFileName = stored.Value.FileName;
        }
        catch (Exception ex)
        {
            _queuePreviewSheets = [];
            _queuePreviewFileName = $"{q.FileName} ({ex.Message})";
        }
        finally
        {
            if (tempPath is not null)
            {
                try { if (File.Exists(tempPath)) File.Delete(tempPath); } catch { }
            }
            _queuePreviewLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CloseQueuePreview()
    {
        _queuePreviewActive = false;
        _queuePreviewLoading = false;
        _queuePreviewDataset = "";
        _queuePreviewFileName = "";
        _queuePreviewSheets = [];
    }

