@page "/data-inference-test"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using ClosedXML.Excel
@using System.IO.Compression
@using System.Text
@using JinoSupporter.Web.Services
@inject WebRepository      Repo
@inject ClaudeService      Claude
@inject ExcelHelperRunner  Helper
@inject IJSRuntime         JS

@* ──────────────────────────────────────────────────────────────────────────────
   Mirror of /data-inference (DI — Input Data) but the *primary* input is a
   DRM-locked .xlsx. The helper exe unlocks it (Excel COM ⓪ → ClosedXML ① →
   ZIP repack ②), then we read the cleaned book via ClosedXML and dump every
   non-empty cell as TSV into the existing "Raw Excel text" textarea — from
   there the rest of the page (Analyze/Save) reuses the parent flow as-is.
   ────────────────────────────────────────────────────────────────────────── *@

<PageTitle>Data Inference — Input Data (Test)</PageTitle>

<div class="di-root dit-split-layout">

@* ── Left: Queue panel (multi-file drag-and-drop, sequential auto-convert) ── *@
<aside class="dit-queue-pane">
    <div class="dit-queue-head">
        <span>📋 Queue</span>
        @if (_queue.Count > 0)
        {
            <span class="dit-queue-count">@_queueDone / @_queue.Count</span>
        }
        <button class="dit-review-btn" @onclick="OpenAliasReview"
                title="Map filename tokens to Mid-group Materials">✎ Review tokens</button>
    </div>
    @if (_queue.Count > 0)
    {
        int totalPct = _queue.Count == 0 ? 0 : (int)(100.0 * _queueDone / _queue.Count);
        <div class="dit-queue-progress">
            <div class="progress" style="height:6px;">
                <div class="progress-bar @(_queueRunning ? "progress-bar-striped progress-bar-animated" : "bg-success")"
                     role="progressbar" style="width:@(totalPct)%;"></div>
            </div>
        </div>
    }
    <div class="dit-queue-drop">
        <InputFile OnChange="OnQueueFilesSelected" multiple accept=".xlsx,.xlsm"
                   style="font-size:11px; color:var(--ink-3, #7f8a98); display:block;" />
        <small class="text-muted d-block mt-1" style="font-size:10px;">
            Drop already-unlocked .xlsx / .xlsm — each becomes its own dataset.
        </small>
        <label class="d-block mt-1" style="font-size:10px; cursor:pointer;">
            <input type="checkbox" @bind="_queueForceReplace" style="vertical-align:middle;" />
            Force replace existing datasets
        </label>
        @if (_queue.Any(q => q.Status is "done" or "error" or "duplicate"))
        {
            <button class="btn btn-link btn-sm p-0 mt-1" style="font-size:10px;"
                    @onclick="ClearFinishedFromQueue">Clear finished</button>
        }
    </div>
    @if (_skippedDups.Count > 0)
    {
        <div class="dit-dup-panel">
            <div class="dit-dup-head" @onclick="() => _skippedDupsExpanded = !_skippedDupsExpanded">
                <span>🚫 @_skippedDups.Count duplicate(s) skipped</span>
                <button class="btn btn-link btn-sm p-0 ms-auto" style="font-size:10px;"
                        @onclick="ClearSkippedDups"
                        @onclick:stopPropagation="true">Clear</button>
                <span class="ms-1">@(_skippedDupsExpanded ? "▴" : "▾")</span>
            </div>
            @if (_skippedDupsExpanded)
            {
                <ul class="dit-dup-list">
                    @foreach (var s in _skippedDups.AsEnumerable().Reverse().Take(100))
                    {
                        <li title="@($"already in DB as '{s.Dataset}'{(string.IsNullOrEmpty(s.ExistingDate) ? "" : $" (date={s.ExistingDate})")}")">
                            @s.FileName
                        </li>
                    }
                    @if (_skippedDups.Count > 100)
                    {
                        <li class="text-muted">+@(_skippedDups.Count - 100) more …</li>
                    }
                </ul>
            }
        </div>
    }
    <ul class="dit-queue-list">
        @foreach (var q in _queue)
        {
            <li class="dit-queue-item dit-q-@q.Status"
                @onclick="() => SelectQueueItemAsync(q)"
                title="@q.Detail">
                <span class="dit-q-icon">@QueueIcon(q.Status)</span>
                <div class="dit-q-body">
                    <div class="dit-q-name">
                        @q.FileName
                        @if (!string.IsNullOrEmpty(q.ProductType))
                        {
                            <span class="dit-q-pt" title="Matched Mid-group">@q.ProductType</span>
                        }
                    </div>
                    <div class="dit-q-detail">
                        @switch (q.Status)
                        {
                            case "queued":     <text>queued</text>; break;
                            case "staging":    <text>uploading…</text>; break;
                            case "extracting": <text>staging workbook…</text>; break;
                            case "saving":     <text>saving…</text>; break;
                            case "done":       <text>workbook saved · AI Batch will read XLSX</text>; break;
                            case "error":      <text>error: @q.Detail</text>; break;
                            case "duplicate":
                                <text>@q.Detail</text>
                                <button class="dit-q-force"
                                        @onclick="() => ForceProcessDuplicate(q)"
                                        @onclick:stopPropagation="true"
                                        title="Overwrite the existing DB row">force</button>
                                ; break;
                            default:           <text>@q.Status</text>; break;
                        }
                    </div>
                </div>
            </li>
        }
        @if (_queue.Count == 0)
        {
            <li class="dit-queue-empty">No files yet.</li>
        }
    </ul>
</aside>

@* ── Alias review modal ─────────────────────────────────────────────────── *@
@if (_aliasReviewOpen)
{
    <div class="dit-alias-overlay" @onclick="CloseAliasReview">
        <div class="dit-alias-modal" @onclick:stopPropagation="true">
            <div class="dit-alias-head">
                <span>✎ Token → Mid-group Material mapping</span>
                <button class="btn-close-x" @onclick="CloseAliasReview">✕</button>
            </div>
            <div class="dit-alias-body">
                <p class="text-muted small mb-2">
                    파일명에서 뽑은 토큰 별로 Mid-group Material 을 직접 매핑합니다.
                    빈 칸으로 두면 자동 매칭에 맡깁니다. 저장하면 이후 drop 되는 모든
                    같은 토큰 파일에 적용됩니다.
                </p>
                <datalist id="dit-alias-materials">
                    @foreach (var mat in GetMidGroupMaterials())
                    {
                        <option value="@mat"></option>
                    }
                </datalist>
                @if (_aliasReviewRows.Count == 0)
                {
                    <div class="text-muted small">No tokens detected yet — drop some files in the queue first.</div>
                }
                else
                {
                    <table class="dit-alias-table">
                        <thead>
                            <tr>
                                <th style="width:30%;">Token</th>
                                <th style="width:30%;">Material (직접 입력 또는 선택)</th>
                                <th>Sample filenames</th>
                                <th style="width:50px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _aliasReviewRows)
                            {
                                <tr class="@(string.IsNullOrEmpty(row.AutoMatch) ? "dit-alias-unmatched" : "")">
                                    <td><code>@row.Token</code></td>
                                    <td>
                                        <input class="form-control form-control-sm"
                                               list="dit-alias-materials"
                                               placeholder="@(string.IsNullOrEmpty(row.AutoMatch) ? "(unmatched)" : $"auto: {row.AutoMatch}")"
                                               value="@row.Draft"
                                               @oninput="@(e => row.Draft = e.Value?.ToString() ?? "")" />
                                    </td>
                                    <td class="dit-alias-samples">
                                        @foreach (var s in row.Samples.Take(3))
                                        {
                                            <div>@s</div>
                                        }
                                        @if (row.Samples.Count > 3)
                                        {
                                            <div class="text-muted">+@(row.Samples.Count - 3) more</div>
                                        }
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-link p-0 text-danger"
                                                @onclick="() => ClearAlias(row)"
                                                title="Remove alias for this token">✕</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
            <div class="dit-alias-foot">
                <button class="btn btn-secondary btn-sm" @onclick="CloseAliasReview">Cancel</button>
                <button class="btn btn-primary btn-sm" @onclick="SaveAliasReview">Save &amp; re-match</button>
            </div>
        </div>
    </div>
}

@* ── Right: existing single-file workspace ───────────────────────────────── *@
<div class="dit-main-pane">

@if (!_queuePreviewActive)
{
<!-- ── Top bar ──────────────────────────────────────────────────────────────── -->
<div class="di-topbar">
    <div class="di-topbar-left">
        <label class="di-label">Dataset</label>
        <input @bind="_datasetName" class="form-control form-control-sm di-input-name"
               placeholder="Dataset name…" />
        <label class="di-label">Product Type</label>
        <input @bind="_productType" class="form-control form-control-sm" style="width:160px;"
               list="productTypeOptions" placeholder="e.g. BRS-161016" autocomplete="off" />
        <datalist id="productTypeOptions">
            @foreach (var pt in _productTypeOptions)
            {
                <option value="@pt"></option>
            }
        </datalist>
        <label class="di-label">Date</label>
        <input type="date" value="@_testDate"
               @onchange="@(e => _testDate = e.Value?.ToString() ?? _testDate)"
               class="form-control form-control-sm" style="width:145px;" />
    </div>
    <div class="di-topbar-right">
        <select class="form-select form-select-sm" style="width:220px;" @onchange="OnLoadExisting">
            <option value="">Load existing…</option>
            @foreach (var r in _allReports)
            {
                <option value="@r.DatasetName">@r.DatasetName</option>
            }
        </select>
        @* Per design.md §1: Data Input ONLY captures + saves Raw Data.
           AI analysis lives in the Data Analysis page. *@
        <button class="btn btn-success btn-sm" @onclick="SaveAsync"
                disabled="@(_isBusy || string.IsNullOrWhiteSpace(_datasetName))">
            @if (_isBusy && _busyStep == "save") { <span class="spinner-border spinner-border-sm me-1"></span> }
            Save
        </button>
        <button class="btn btn-outline-secondary btn-sm" @onclick="Clear" disabled="@_isBusy">Clear</button>
    </div>
</div>

@if (!string.IsNullOrEmpty(_status))
{
    <div class="di-status-bar @(_statusError ? "di-error" : "di-ok")">@_status</div>
}
}

@if (_queuePreviewActive)
{
    <div class="dit-excel-only">
        <div class="dit-excel-only-head">
            <div>
                <div class="dit-excel-title">@_queuePreviewFileName</div>
                <div class="dit-excel-meta">@_queuePreviewDataset · @_queuePreviewSheets.Count sheet(s)</div>
            </div>
            <button class="btn btn-outline-secondary btn-sm" @onclick="CloseQueuePreview">Back</button>
        </div>
        @if (_queuePreviewLoading)
        {
            <div class="dit-excel-loading">
                <span class="spinner-border spinner-border-sm me-1"></span>Loading workbook preview...
            </div>
        }
        else if (_queuePreviewSheets.Count == 0)
        {
            <div class="dit-excel-empty">No workbook cells to preview.</div>
        }
        else
        {
            <div class="dit-excel-book">
                @foreach (var sheet in _queuePreviewSheets)
                {
                    <section class="dit-excel-sheet">
                        <div class="dit-sheet-tab">@sheet.Name</div>
                        <div class="dit-table-wrap dit-excel-wrap">
                            <table class="dit-preview-table dit-excel-grid">
                                <thead>
                                    <tr>
                                        <th class="dit-excel-corner"></th>
                                        @for (int c = 0; c < sheet.MaxColumns; c++)
                                        {
                                            <th class="dit-excel-col">@ExcelColumnName(sheet.FirstColumn + c - 1)</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int r = 0; r < sheet.Rows.Count; r++)
                                    {
                                        var row = sheet.Rows[r];
                                        <tr>
                                            <th class="dit-excel-row">@(sheet.FirstRow + r)</th>
                                            @for (int c = 0; c < sheet.MaxColumns; c++)
                                            {
                                                var cell = c < row.Count ? row[c] : null;
                                                if (cell is null) continue;
                                                <td colspan="@cell.ColumnSpan"
                                                    rowspan="@cell.RowSpan"
                                                    style="@CellStyle(cell)">@CleanExcelSerialDateText(cell.Value)</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </section>
                }
            </div>
        }
    </div>
}
else
{
    <div class="dit-excel-empty">
        Queue에서 엑셀 파일을 선택하면 여기에 엑셀 형태로 표시됩니다.
    </div>
}

</div>  @* /dit-main-pane *@
</div>  @* /dit-split-layout di-root *@

<style>
    .di-root {
        flex: 1; min-height: 0; display: flex; flex-direction: column; overflow: hidden;
        background: var(--panel-2, #f5f6f9);
    }

    /* Two-pane layout: left = Queue, right = current workspace */
    .dit-split-layout {
        flex-direction: row !important;
    }
    .dit-queue-pane {
        flex: 0 0 280px;
        display: flex; flex-direction: column;
        background: var(--panel, #fff); border-right: 1px solid var(--line, var(--line, #dde1e7));
        overflow: hidden;
    }
    .dit-main-pane {
        flex: 1; min-width: 0; display: flex; flex-direction: column; overflow: hidden;
    }

    /* Queue UI */
    .dit-queue-head {
        display: flex; align-items: center; justify-content: space-between;
        padding: 8px 12px; font-size: 12px; font-weight: 700; color: var(--ink, #0f1319);
        background: var(--panel-3, #eceef2); border-bottom: 1px solid var(--line, var(--line, #dde1e7));
        flex-shrink: 0;
    }
    .dit-queue-count {
        font-size: 10px; font-weight: 600; color: var(--signal, #16202b);
        background: var(--signal-wash, #edf0f4); padding: 1px 8px; border-radius: 2px;
    }
    .dit-queue-progress { padding: 4px 10px 0; flex-shrink: 0; }
    .dit-queue-drop {
        padding: 8px 10px; border-bottom: 1px dashed var(--line, var(--line, #dde1e7));
        flex-shrink: 0; background: var(--panel-2, #f5f6f9);
    }
    .dit-dup-panel {
        background: var(--warn-wash, #fdf4e0); border-bottom: 1px dashed var(--warn-line, #f0cf8a);
        font-size: 11px; flex-shrink: 0;
    }
    .dit-dup-head {
        display: flex; align-items: center; gap: 4px;
        padding: 5px 10px; cursor: pointer; color: var(--warn-ink, #92610a); font-weight: 600;
    }
    .dit-dup-head:hover { background: var(--warn-wash, #fdf4e0); }
    .dit-dup-list {
        list-style: none; margin: 0; padding: 2px 10px 6px 24px;
        max-height: 160px; overflow-y: auto;
        font-size: 10px; color: var(--warn-ink, #92610a);
    }
    .dit-dup-list li { padding: 1px 0; }
    .dit-queue-list {
        list-style: none; margin: 0; padding: 4px 0;
        flex: 1; min-height: 0; overflow-y: auto;
    }
    .dit-queue-empty {
        padding: 16px; text-align: center;
        color: var(--ink-3, #7f8a98); font-size: 11px;
    }
    .dit-queue-item {
        display: flex; gap: 8px; align-items: flex-start;
        padding: 6px 10px; border-bottom: 1px solid var(--panel-3, #eceef2);
        cursor: pointer; transition: background .12s;
    }
    .dit-queue-item:hover { background: var(--panel-2, #f5f6f9); }
    .dit-q-icon { font-size: 14px; line-height: 1.3; flex-shrink: 0; width: 16px; }
    .dit-q-body { flex: 1; min-width: 0; }
    .dit-q-name {
        font-size: 11px; font-weight: 600; color: var(--ink, #0f1319);
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .dit-q-detail { font-size: 10px; color: var(--ink-2, #4a5461); margin-top: 1px; }
    .dit-q-queued     { }
    .dit-q-staging,
    .dit-q-extracting,
    .dit-q-saving     { background: var(--ok-wash, #eaf1f9); }
    .dit-q-staging .dit-q-detail,
    .dit-q-extracting .dit-q-detail,
    .dit-q-saving .dit-q-detail { color: var(--ok, #1f5fa8); font-weight: 600; }
    .dit-q-done       { background: var(--ok-wash, #eaf1f9); }
    .dit-q-done .dit-q-detail { color: var(--ok, #1f5fa8); }
    .dit-q-error      { background: var(--crit-wash, #fbedec); }
    .dit-q-error .dit-q-detail { color: var(--crit, #c8342a); font-weight: 600; }
    .dit-q-duplicate  { background: var(--warn-wash, #fdf4e0); }
    .dit-q-duplicate .dit-q-detail { color: var(--warn-ink, #92610a); font-weight: 600; }
    .dit-q-force {
        margin-left: 6px;
        border: 1px solid var(--warn, #fab219); background: var(--warn-wash, #fdf4e0); color: var(--warn-ink, #92610a);
        padding: 0 6px; border-radius: 2px; font-size: 9px; font-weight: 700;
        cursor: pointer; line-height: 1.4;
    }
    .dit-q-force:hover { background: var(--warn-wash, #fdf4e0); }
    .dit-q-pt {
        display: inline-block; margin-left: 6px;
        background: var(--signal-wash, #edf0f4); color: var(--signal, #16202b);
        padding: 0 6px; border-radius: 2px; font-size: 9px; font-weight: 700;
        vertical-align: middle;
    }
    .dit-review-btn {
        margin-left: auto;
        background: transparent; border: 1px solid var(--line-2, #c6ccd5); color: var(--ink-2, #4a5461);
        font-size: 10px; font-weight: 600; padding: 1px 8px; border-radius: 2px;
        cursor: pointer;
    }
    .dit-review-btn:hover { background: var(--signal-wash, #edf0f4); border-color: var(--signal, #16202b); color: var(--signal, #16202b); }

    /* Alias review modal */
    .dit-alias-overlay {
        position: fixed; inset: 0; background: rgba(15,23,42,.55);
        z-index: 1500; display: flex; align-items: center; justify-content: center;
    }
    .dit-alias-modal {
        background: var(--panel, #fff); border-radius: 2px; width: 850px; max-width: 95vw;
        max-height: 85vh; display: flex; flex-direction: column;
    }
    .dit-alias-head {
        display: flex; align-items: center; justify-content: space-between;
        padding: 10px 14px; border-bottom: 1px solid var(--line, var(--line, #dde1e7));
        font-size: 13px; font-weight: 700; color: var(--ink, #0f1319);
    }
    .btn-close-x {
        border: none; background: transparent; font-size: 16px; color: var(--ink-2, #4a5461);
        cursor: pointer; padding: 0 4px;
    }
    .dit-alias-body { padding: 12px 14px; overflow-y: auto; flex: 1; }
    .dit-alias-foot {
        padding: 10px 14px; border-top: 1px solid var(--line, var(--line, #dde1e7));
        display: flex; gap: 8px; justify-content: flex-end;
    }
    .dit-alias-table { width: 100%; border-collapse: collapse; font-size: 12px; }
    .dit-alias-table th, .dit-alias-table td {
        border: 1px solid var(--line, #dde1e7); padding: 6px 8px; text-align: left;
        vertical-align: top;
    }
    .dit-alias-table th { background: var(--panel-3, #eceef2); font-weight: 700; color: var(--ink-2, #4a5461); }
    .dit-alias-table tr.dit-alias-unmatched { background: var(--warn-wash, #fdf4e0); }
    .dit-alias-table tr.dit-alias-unmatched td:first-child code { color: var(--warn-ink, #92610a); font-weight: 700; }
    .dit-alias-samples { font-size: 10px; color: var(--ink-2, #4a5461); }
    .dit-alias-samples > div { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 380px; }
    .di-topbar {
        display: flex; align-items: center; justify-content: space-between; gap: 8px;
        padding: 8px 14px; background: var(--panel, #fff); flex-shrink: 0;
        border-bottom: 1px solid var(--line, var(--line, #dde1e7)); flex-wrap: wrap;
    }
    .di-topbar-left  { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    .di-topbar-right { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    .di-label        { font-size: 12px; font-weight: 600; color: var(--ink-2, #4a5461); white-space: nowrap; }
    .di-input-name   { width: 200px; }
    .di-status-bar   { padding: 4px 14px; font-size: 12px; flex-shrink: 0; }
    .di-ok           { color: var(--ok, #1f5fa8); background: var(--ok-wash, #eaf1f9); border-bottom: 1px solid var(--ok-wash, #eaf1f9); }
    .di-error        { color: var(--crit, #c8342a); background: var(--crit-wash, #fbedec); border-bottom: 1px solid var(--crit-wash, #fbedec); }

    /* Collapsible section bar — used above the trio + above raw text */
    .dit-bar {
        display: flex; align-items: center; gap: 8px;
        padding: 4px 14px; background: var(--panel-3, #eceef2);
        border-top: 1px solid var(--line, var(--line, #dde1e7)); border-bottom: 1px solid var(--line, var(--line, #dde1e7));
        font-size: 11px; color: var(--ink-2, #4a5461); cursor: pointer; user-select: none;
        flex-shrink: 0;
    }
    .dit-bar:hover { background: var(--signal-wash, #edf0f4); color: var(--ink, #0f1319); }
    .dit-bar-caret { font-size: 10px; width: 10px; }
    .dit-bar-title { font-weight: 700; }
    .dit-bar-meta  { color: var(--ink-3, #7f8a98); margin-left: 4px; font-size: 10px; }

    /* 3-column input row (DRM | Images | Backup) */
    .dit-trio {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 10px;
        padding: 10px 14px 6px;
        flex-shrink: 0;
    }
    @@media (max-width: 1100px) { .dit-trio { grid-template-columns: 1fr; } }

    .dit-col {
        display: flex; flex-direction: column;
        background: var(--panel, #fff);
        border: 1px solid var(--line, var(--line, #dde1e7));
        border-radius: 2px;
        padding: 8px 10px;
        min-height: 180px;
    }
    .dit-col-drm    { background: var(--warn-wash, #fdf4e0); border-color: var(--warn-line, #f0cf8a); }
    .dit-col-images { /* default white */ }
    .dit-col-backup { /* default white */ }

    .dit-col-head {
        display: flex; align-items: center; gap: 6px;
        font-size: 12px; font-weight: 600; color: var(--ink-2, #4a5461);
        margin-bottom: 6px;
    }
    .dit-col-drm .dit-col-head { color: var(--warn-ink, #92610a); }
    .dit-col-body { flex: 1 1 auto; min-height: 0; overflow: hidden; }

    /* Full-width raw text section below trio */
    .dit-rawtext {
        display: flex; flex-direction: column;
        padding: 4px 14px 8px;
        flex-shrink: 0;
    }
    .dit-rawtext .di-text-area { min-height: 180px; }

