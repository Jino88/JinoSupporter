    private async Task OnDrmExcelSelected(InputFileChangeEventArgs e)
    {
        if (_isBusy) return;
        var file = e.File;
        if (file is null) return;
        string lower = file.Name.ToLowerInvariant();
        if (!lower.EndsWith(".xlsx") && !lower.EndsWith(".xlsm"))
        {
            SetStatus("DRM input must be .xlsx or .xlsm", true);
            return;
        }
        if (!Helper.HelperExists)
        {
            SetStatus("Helper exe not found — rebuild the web project.", true);
            return;
        }

        _isBusy = true; _busyStep = "drm";
        _drmFileName = file.Name;
        _drmFileSize = file.Size;
        _drmProgress = "Uploading…";
        _drmExtractedRows = 0;
        _drmSheets = 0;
        _drmLog.Clear();
        _status = "";

        // Auto-fill dataset name from the file: strip .xlsx/.xlsm, then drop
        // one trailing "_clean" suffix that the DRM unlock tool adds. User
        // can still edit it manually before Save.
        _datasetName = DeriveDatasetName(file.Name);

        // Auto-fill Product Type from a matching Mid-group Material in
        // ModelGroups. Same fuzzy rule as the queue flow. Leaves existing
        // value alone when no match found so the user's manual entry wins.
        string matchedPt = FindProductTypeFor(file.Name);
        if (!string.IsNullOrEmpty(matchedPt)) _productType = matchedPt;

        // Auto-fill Date if the file name contains a parseable date pattern
        // (YYYY.MM.DD, YYYY MM DD, DD.MM.YYYY, YYYYMMDD, …). Leave existing
        // value alone if no date detected.
        string? parsedDate = DeriveDateFromFileName(file.Name);
        if (parsedDate is not null) _testDate = parsedDate;

        StateHasChanged();

        // Stage 1: copy upload to a temp file for the helper.
        string stageDir = Path.Combine(Path.GetTempPath(),
            "jinosupp-input-test-stage", Guid.NewGuid().ToString("N"));
        Directory.CreateDirectory(stageDir);
        string stagedFile = Path.Combine(stageDir, file.Name);

        string? cleanedPath = null;
        string? cleanTempDir = null;
        try
        {
            await using (var src = file.OpenReadStream(200 * 1024 * 1024))
            await using (var dst = File.Create(stagedFile))
                await src.CopyToAsync(dst);

            _drmProgress = "Unlocking via helper…";
            StateHasChanged();
            (cleanedPath, cleanTempDir, _drmLog) = await Helper.CleanSingleAsync(stagedFile);

            if (cleanedPath is null || !File.Exists(cleanedPath))
            {
                SetStatus("DRM unlock failed — see helper log.", true);
                return;
            }

            // Adopt the unlocked file as a Backup File so it's archived alongside the dataset.
            try
            {
                byte[] cleanedBytes = await File.ReadAllBytesAsync(cleanedPath);
                _files.Add(new FileEntry(
                    Path.GetFileName(cleanedPath),
                    "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                    cleanedBytes,
                    null));
            }
            catch { /* archiving is best-effort */ }

            _drmProgress = "Reading cells…";
            StateHasChanged();
            var (tsv, sheets, rows) = await Task.Run(() => ExtractTsv(cleanedPath));
            _pastedText = tsv;
            _drmSheets = sheets;
            _drmExtractedRows = rows;

            _drmProgress = "Extracting embedded images…";
            StateHasChanged();
            // Helper renders each Excel shape to PNG and embeds it under
            // xl/media/* via ClosedXML. Pull those out so they end up in the
            // dataset's RawReport images, same as if the user had pasted them.
            var pulled = await Task.Run(() => ExtractImages(cleanedPath));
            int imagesAdded = 0;
            foreach (var (name, mt, bytes) in pulled)
            {
                string b64 = Convert.ToBase64String(bytes);
                (string finalB64, string finalMt) = ImageCompressor.CompressIfLarge(b64, mt);
                string dataUrl = $"data:{finalMt};base64,{finalB64}";
                _images.Add(new ImageEntry(name, finalMt, finalB64, dataUrl));
                imagesAdded++;
            }

            _drmLoaded = true;
            SetStatus(
                $"DRM unlocked — {sheets} sheet(s), {rows:N0} row(s), {imagesAdded} embedded image(s). " +
                "Analyze will send Excel text only (images saved to DB but skipped for AI to stay under payload limit).",
                false);
        }
        catch (Exception ex)
        {
            SetStatus($"DRM step failed: {ex.Message}", true);
        }
        finally
        {
            // Cleanup: helper temp dir + staging dir. Both contain only this run's files.
            try { if (!string.IsNullOrEmpty(cleanTempDir) && Directory.Exists(cleanTempDir)) Directory.Delete(cleanTempDir, recursive: true); } catch { }
            try { if (Directory.Exists(stageDir)) Directory.Delete(stageDir, recursive: true); } catch { }
            _isBusy = false; _busyStep = ""; _drmProgress = "";
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>Reads the unlocked .xlsx and returns a TSV dump (sheet header +
    /// rows × cols, only non-empty rows). Each sheet starts with a "## name"
    /// marker. Cells with non-default formatting (fill color / bold / red font)
    /// get inline annotations: <c>〔bg=#FFCCCC,b〕value</c>. The AI uses these
    /// hints to spot NG/OK status, callouts, etc. — formatting in
    /// manufacturing reports usually carries semantic meaning.</summary>
    // 한 셀당 너무 긴 텍스트(붙여넣기 잔재 등)는 잘라낸다 — Claude 가 수치
    // 외 의미를 잃지 않으면서 토큰 절약.
    private const int MaxCellChars = 200;
    // 셀이 지나치게 sparse 한 행(예: 200열 중 1개 셀만 채워진 헤더 패딩)은 제거.
    // value-bearing cell 비율이 이 미만이면 스킵. UsedRange 가 클수록 효과.
    private const double MinRowFillRatio = 0.05;
    // 한 시트가 이 정도도 안 차면 통째로 스킵 (e.g. 그림만 들어 있던 시트).
    private const int MinSheetCells = 3;

    private static (string Tsv, int Sheets, int Rows) ExtractTsv(string xlsxPath)
    {
        var sb = new StringBuilder();
        int sheetCount = 0;
        int totalRows  = 0;

        using var wb = new XLWorkbook(xlsxPath);
        foreach (var ws in wb.Worksheets)
        {
            var used = ws.RangeUsed();
            if (used is null) continue;

            int firstCol = used.FirstColumn().ColumnNumber();
            int lastCol  = used.LastColumn().ColumnNumber();
            int firstRow = used.FirstRow().RowNumber();
            int lastRow  = used.LastRow().RowNumber();

            // Cap at 10K rows × 200 cols — same reasoning as the helper's clamp:
            // sheets with row-wide formatting can balloon UsedRange to 1M+ rows.
            int rowEnd = Math.Min(lastRow, firstRow + 10000 - 1);
            int colEnd = Math.Min(lastCol, firstCol + 200 - 1);
            var mergedLookup = BuildMergedCellLookup(ws, firstRow, rowEnd, firstCol, colEnd);

            // Build the sheet body first; only append the "## name" header if
            // the sheet has any usable rows after trimming.
            var sheetSb = new StringBuilder();
            int sheetRows = 0;
            int sheetValueCells = 0;
            int colSpan = colEnd - firstCol + 1;

            for (int r = firstRow; r <= rowEnd; r++)
            {
                int actualValueCells = 0;
                int emittedValueCells = 0;
                int maxCellLen = 0;
                var line = new StringBuilder();

                for (int c = firstCol; c <= colEnd; c++)
                {
                    var cell = ws.Cell(r, c);
                    var emitCell = cell;
                    MergedCellAnchor? merged = null;
                    if (mergedLookup.TryGetValue((r, c), out var foundMerged))
                    {
                        merged = foundMerged;
                        emitCell = ws.Cell(foundMerged.AnchorRow, foundMerged.AnchorColumn);
                    }

                    string original = cell.IsEmpty() ? "" : cell.GetFormattedString();
                    string v = emitCell.IsEmpty() ? "" : emitCell.GetFormattedString();
                    v = v.Replace('\t', ' ').Replace('\n', ' ').Replace('\r', ' ');

                    if (v.Length > MaxCellChars)
                    {
                        v = v.Substring(0, MaxCellChars) + "…";
                    }

                    string tag = string.IsNullOrEmpty(v) ? "" : FormatTag(emitCell);
                    if (merged is not null && (merged.AnchorRow != r || merged.AnchorColumn != c))
                    {
                        tag = AppendTag(tag, $"merged={merged.RangeAddress}");
                    }
                    string emit = string.IsNullOrEmpty(tag)
                        ? v
                        : $"〔{tag}〕{v}";

                    if (c > firstCol) line.Append('\t');
                    line.Append(emit);
                    if (!string.IsNullOrEmpty(original))
                    {
                        actualValueCells++;
                    }
                    if (!string.IsNullOrEmpty(v))
                    {
                        emittedValueCells++;
                        if (v.Length > maxCellLen) maxCellLen = v.Length;
                    }
                }

                if (actualValueCells == 0 || emittedValueCells == 0) continue;
                int rowFillCells = Math.Max(actualValueCells, emittedValueCells);
                // Row-fill threshold drops near-empty header padding rows.
                // BUT keep rows with a long-text cell (≥10 chars) — those are
                // titles / dates / notes like "Sample Coil separate date 20/10"
                // that look sparse by ratio but carry real meaning.
                bool hasLongText = maxCellLen >= 10;
                if (!hasLongText
                    && colSpan > 4
                    && (double)rowFillCells / colSpan < MinRowFillRatio)
                    continue;

                sheetSb.AppendLine(line.ToString());
                sheetRows++;
                sheetValueCells += rowFillCells;
            }

            // Drop sheets with no real content (decorative tabs, image-only
            // sheets). Also keep sheets where any single cell holds long text
            // — a one-line title sheet still has information worth carrying.
            bool sheetHasLongText = sheetSb.Length > 0
                && sheetSb.ToString().Split('\n').Any(ln => ln.Replace("\t", "").Trim().Length >= 10);
            if (sheetValueCells < MinSheetCells && !sheetHasLongText) continue;

            if (sheetCount > 0) sb.AppendLine();
            sb.Append("## ").AppendLine(ws.Name);
            sb.Append(sheetSb);
            sheetCount++;
            totalRows += sheetRows;
        }

        return (sb.ToString(), sheetCount, totalRows);
    }

    private sealed record MergedCellAnchor(int AnchorRow, int AnchorColumn, string RangeAddress);

    private static Dictionary<(int Row, int Column), MergedCellAnchor> BuildMergedCellLookup(
        IXLWorksheet ws,
        int firstRow,
        int rowEnd,
        int firstCol,
        int colEnd)
    {
        var lookup = new Dictionary<(int Row, int Column), MergedCellAnchor>();
        foreach (var range in ws.MergedRanges)
        {
            var address = range.RangeAddress;
            int startRow = Math.Max(address.FirstAddress.RowNumber, firstRow);
            int endRow = Math.Min(address.LastAddress.RowNumber, rowEnd);
            int startCol = Math.Max(address.FirstAddress.ColumnNumber, firstCol);
            int endCol = Math.Min(address.LastAddress.ColumnNumber, colEnd);
            if (startRow > endRow || startCol > endCol) continue;

            var anchor = new MergedCellAnchor(
                address.FirstAddress.RowNumber,
                address.FirstAddress.ColumnNumber,
                address.ToString() ?? "");

            for (int r = startRow; r <= endRow; r++)
            {
                for (int c = startCol; c <= endCol; c++)
                {
                    lookup[(r, c)] = anchor;
                }
            }
        }

        return lookup;
    }

    private static string AppendTag(string current, string tag)
    {
        if (string.IsNullOrWhiteSpace(tag)) return current;
        return string.IsNullOrWhiteSpace(current) ? tag : $"{current},{tag}";
    }

    /// <summary>Build the comma-separated annotation for a cell: bg color hex,
    /// fg color hex (only when non-black), and <c>b</c> for bold. Returns ""
    /// when the cell uses default formatting so the TSV stays clean for the
    /// 99% of cells that have no semantic styling.</summary>
    private static string FormatTag(IXLCell cell)
    {
        var parts = new List<string>(3);
        try
        {
            var fill = cell.Style.Fill;
            if (fill.PatternType != XLFillPatternValues.None)
            {
                string? bg = ColorHex(fill.BackgroundColor);
                // Skip pure white / "no color" — those are the default and would
                // just clutter the output.
                if (bg is not null && bg != "FFFFFF") parts.Add($"bg=#{bg}");
            }
        }
        catch { }
        try
        {
            string? fg = ColorHex(cell.Style.Font.FontColor);
            if (fg is not null && fg != "000000") parts.Add($"fg=#{fg}");
        }
        catch { }
        try
        {
            if (cell.Style.Font.Bold) parts.Add("b");
        }
        catch { }
        return parts.Count == 0 ? "" : string.Join(",", parts);
    }

    private static string? ColorHex(XLColor color)
    {
        if (color is null || !color.HasValue) return null;
        try
        {
            var c = color.Color;
            return $"{c.R:X2}{c.G:X2}{c.B:X2}";
        }
        catch { return null; }
    }

    /// <summary>Extract every embedded image from a .xlsx by reading the OOXML
    /// zip directly. Images live under <c>xl/media/*</c> by spec — the helper's
    /// ⓪ strategy puts each rendered shape PNG there via ClosedXML's
    /// <c>AddPicture</c>. We bypass ClosedXML's picture API because it doesn't
    /// always round-trip the embedded bytes cleanly.</summary>
    private static List<(string Name, string MediaType, byte[] Bytes)> ExtractImages(string xlsxPath)
    {
        var result = new List<(string, string, byte[])>();
        using var zip = ZipFile.OpenRead(xlsxPath);
        foreach (var entry in zip.Entries)
        {
            if (!entry.FullName.StartsWith("xl/media/", StringComparison.OrdinalIgnoreCase)) continue;
            string ext = Path.GetExtension(entry.Name).ToLowerInvariant();
            string? mt = ext switch
            {
                ".png"  => "image/png",
                ".jpg"  => "image/jpeg",
                ".jpeg" => "image/jpeg",
                ".gif"  => "image/gif",
                ".bmp"  => "image/bmp",
                ".webp" => "image/webp",
                _       => null,
            };
            if (mt is null) continue;
            using var s  = entry.Open();
            using var ms = new MemoryStream();
            s.CopyTo(ms);
            result.Add((entry.Name, mt, ms.ToArray()));
        }
        return result;
    }

    private void RemoveMeasurement(NormalizedMeasurement m) => _measurements.Remove(m);

    private void RemoveTag(string t) => _tags.Remove(t);

    private async Task AnalyzeAsync()
    {
        if (string.IsNullOrWhiteSpace(_pastedText))
        {
            SetStatus("Drop a DRM Excel or paste Excel cells first — images are not analyzed.", true);
            return;
        }
        _isBusy = true; _busyStep = "analyze"; _status = "";
        StateHasChanged();
        try
        {
            string dsName = string.IsNullOrWhiteSpace(_datasetName) ? "dataset" : _datasetName.Trim();

            // Per user policy (2026-05-08): images are NEVER sent to AI on
            // this page — only Excel raw text. Images are still archived to
            // RawReport DB for reference but stay out of the analyze payload.
            // If there's no text, nothing to analyze.
            if (string.IsNullOrWhiteSpace(_pastedText))
            {
                SetStatus("No Excel text to analyze. Drop a DRM Excel first.", true);
                return;
            }
            NormalizeResult result = await Claude.NormalizeFromTextAsync(
                _pastedText, dsName, _productType.Trim(), _testDate);

            _measurements      = result.Measurements;
            _summary           = result.Summary;
            _keyFindings       = result.KeyFindings;
            _tags              = result.Tags ?? [];
            _purpose           = result.Purpose;
            _testConditions    = result.TestConditions;
            _rootCause         = result.RootCause;
            _decision          = result.Decision;
            _recommendedAction = result.RecommendedAction;

            // Translate the 7 narrative fields into ko + vi in parallel. The
            // English/original copy stays in `result`; ko/vi go to the
            // translations dictionary that's persisted on Save. Failures don't
            // sink the analyze (we just have the original-only result).
            _pendingTranslations.Clear();
            try
            {
                var koTask = Claude.TranslateAnalysisAsync(result, "Korean");
                var viTask = Claude.TranslateAnalysisAsync(result, "Vietnamese");
                await Task.WhenAll(koTask, viTask);
                _pendingTranslations["ko"] = koTask.Result;
                _pendingTranslations["vi"] = viTask.Result;
                SetStatus($"Analysis complete — {_measurements.Count} row(s); translated to ko + vi.", false);
            }
            catch (Exception tex)
            {
                SetStatus($"Analysis complete ({_measurements.Count} rows) — translation failed: {tex.Message}", false);
            }
        }
        catch (Exception ex) { SetStatus($"Analyze error: {ex.Message}", true); }
        finally { _isBusy = false; _busyStep = ""; }
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_datasetName)) { SetStatus("Dataset name required.", true); return; }
        _isBusy = true; _busyStep = "save"; _status = "";
        StateHasChanged();
        try
        {
            string name = _datasetName.Trim();
            var imgs = _images.Select(i => (i.MediaType, Convert.FromBase64String(i.Base64), i.FileName)).ToList();
            string tagsJson = _tags.Count > 0
                ? System.Text.Json.JsonSerializer.Serialize(_tags)
                : "";
            var newFiles = _files
                .Where(f => !f.ExistingId.HasValue)
                .Select(f => (f.MediaType, f.Data, f.FileName))
                .ToList();
            var keptIds = _files.Where(f => f.ExistingId.HasValue).Select(f => f.ExistingId!.Value).ToHashSet();
            await Task.Run(() =>
            {
                Repo.SaveRawReport(name, _productType, _testDate, imgs);

                foreach (var fi in Repo.GetRawReportFileInfos(name))
                    if (!keptIds.Contains(fi.Id)) Repo.DeleteRawReportFile(fi.Id);
                if (newFiles.Count > 0) Repo.AppendRawReportFiles(name, newFiles);

                // Data Input owns raw capture only. Current analysis is written
                // by AI Batch into AiDocuments/AiResults so legacy summary rows
                // are not mixed with the current schema.
                if (!string.IsNullOrWhiteSpace(_pastedText))
                    Repo.SaveExtractedText(name, _pastedText, WebRepository.TextKindExcelPaste);
            });
            SetStatus($"Saved — '{name}'", false);
            _allReports = Repo.GetAllRawReports();
            RefreshProductTypeOptions();
        }
        catch (Exception ex) { SetStatus($"Save error: {ex.Message}", true); }
        finally { _isBusy = false; _busyStep = ""; }
    }

    private async Task OnLoadExisting(ChangeEventArgs e)
    {
        string name = e.Value?.ToString() ?? "";
        if (string.IsNullOrEmpty(name)) return;
        var info = _allReports.FirstOrDefault(r => r.DatasetName == name);
        if (info is null) return;

        _datasetName  = info.DatasetName;
        _productType  = info.ProductType;
        _testDate     = info.ReportDate;
        _measurements = Repo.GetNormalizedMeasurements(name);
        var summ = Repo.GetDatasetSummaryRecord(name);
        _pastedText        = Repo.GetExtractedText(name, WebRepository.TextKindExcelPaste) ?? "";
        _summary           = summ?.Summary           ?? "";
        _keyFindings       = summ?.KeyFindings       ?? "";
        _tags              = summ?.Tags              ?? [];
        _purpose           = summ?.Purpose           ?? "";
        _testConditions    = summ?.TestConditions    ?? "";
        _rootCause         = summ?.RootCause         ?? "";
        _decision          = summ?.Decision          ?? "";
        _recommendedAction = summ?.RecommendedAction ?? "";

        // Replay any saved translations so re-saving doesn't drop them.
        _pendingTranslations.Clear();
        if (summ is not null)
            foreach (var (lang, tr) in summ.Translations)
                _pendingTranslations[lang] = tr;

        var storedImgs = Repo.GetRawReportImages(name);
        _images = storedImgs.Select((img, i) =>
        {
            string b64    = Convert.ToBase64String(img.Data);
            string dataUrl = $"data:{img.MediaType};base64,{b64}";
            string fname   = img.FileName.Length > 0 ? img.FileName : $"img-{i + 1}";
            return new ImageEntry(fname, img.MediaType, b64, dataUrl);
        }).ToList();

        _files = Repo.GetRawReportFileInfos(name)
            .Select(fi => new FileEntry(fi.FileName, fi.MediaType, [], fi.Id))
            .ToList();

        SetStatus($"Loaded '{name}' — {_measurements.Count} measurement(s)", false);
    }

    private void Clear()
    {
        _datasetName = ""; _productType = ""; _testDate = DateTime.Today.ToString("yyyy-MM-dd");
