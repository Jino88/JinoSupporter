    /// <summary>Parse the TSV-with-inline-tags blob produced by ExtractTsv into
    /// per-sheet rows × cells. Sheets are delimited by lines starting with
    /// "## ". Each cell may carry a 〔bg=#…,fg=#…,b〕 prefix that we strip and
    /// apply as styles in the preview.</summary>
    private static List<(string Name, List<List<TsvCell>> Rows)> ParsePastedTsv(string tsv)
    {
        var sheets = new List<(string, List<List<TsvCell>>)>();
        if (string.IsNullOrWhiteSpace(tsv)) return sheets;

        string currentName = "(sheet)";
        var currentRows = new List<List<TsvCell>>();
        bool seenAny = false;

        foreach (var rawLine in tsv.Split('\n'))
        {
            string line = rawLine.TrimEnd('\r');
            if (line.StartsWith("## ", StringComparison.Ordinal))
            {
                if (seenAny) sheets.Add((currentName, currentRows));
                currentName = line[3..].Trim();
                currentRows = new List<List<TsvCell>>();
                seenAny = true;
                continue;
            }
            if (string.IsNullOrEmpty(line)) continue;

            var cells = new List<TsvCell>();
            foreach (var raw in line.Split('\t'))
                cells.Add(ParseCell(raw));
            currentRows.Add(cells);
        }
        if (seenAny) sheets.Add((currentName, currentRows));
        else if (currentRows.Count > 0) sheets.Add(("(sheet)", currentRows));
        return sheets;
    }

    private static TsvCell ParseCell(string raw)
    {
        if (raw.Length == 0 || raw[0] != '〔')
            return new TsvCell(raw, null, null, false);

        int end = raw.IndexOf('〕');
        if (end < 0) return new TsvCell(raw, null, null, false);

        string tag = raw[1..end];
        string val = raw[(end + 1)..];
        string? bg = null, fg = null;
        bool bold = false;
        foreach (var part in tag.Split(','))
        {
            string p = part.Trim();
            if (p.StartsWith("bg=", StringComparison.Ordinal)) bg = p[3..];
            else if (p.StartsWith("fg=", StringComparison.Ordinal)) fg = p[3..];
            else if (p == "b") bold = true;
        }
        return new TsvCell(val, bg, fg, bold);
    }

    private static string CellStyle(TsvCell c)
    {
        var s = new System.Text.StringBuilder();
        if (!string.IsNullOrEmpty(c.Bg)) s.Append("background:").Append(c.Bg).Append(';');
        if (!string.IsNullOrEmpty(c.Fg)) s.Append("color:").Append(c.Fg).Append(';');
        if (c.Bold) s.Append("font-weight:700;");
        return s.ToString();
    }

    private static string CellStyle(ExcelPreviewCell c)
    {
        var s = new System.Text.StringBuilder();
        if (!string.IsNullOrEmpty(c.Bg)) s.Append("background:").Append(c.Bg).Append(';');
        if (!string.IsNullOrEmpty(c.Fg)) s.Append("color:").Append(c.Fg).Append(';');
        if (c.Bold) s.Append("font-weight:700;");
        return s.ToString();
