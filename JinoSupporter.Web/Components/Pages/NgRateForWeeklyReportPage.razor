@* NG Rate For Weekly Report - same data shape as By Group, but with all DATE
   columns hidden in tables and charts. Only Week + Month periods are shown. *@
@using JinoSupporter.Web.Services
@using JinoSupporter.Web.Services.BmesReports
@inject NgRateService         NgRate
@inject NgRateSettingsService NgRateSettings
@inject NgRateReportService   NgRateReportSvc
@inject WebRepository         Repo
@inject IJSRuntime            JS
@inject AppActivityLogger     Activity
@inject BmesDailyReportCalculationService DailyCalculation
@inject BmesWeeklyReportCalculationService WeeklyCalculation
@implements IAsyncDisposable

<NgRateReportStyles />
@ExportPeriodMeta()

@if (ShowTitle)
{
    <div class="d-flex align-items-center gap-2 mb-3">
        <h5 class="mb-0 fw-semibold">Report - NG Rate Weekly</h5>
    </div>
}

@if (ShowSetup)
{
    <NgRateSetupPanel LayoutClass="ngrate-flow"
                      DataCellClass="ngrate-flow-data"
                      ProgressCellClass="ngrate-flow-progress"
                      StartDate="@_startDate"
                      StartDateChanged="@((DateTime d) => _startDate = d)"
                      EndDate="@_endDate"
                      EndDateChanged="@((DateTime d) => _endDate = d)"
                      IsBusy="@_isBusy"
                      IsReportBusy="@_isReportBusy"
                      IsCredentialsConfigured="@NgRateSettings.IsCredentialsConfigured"
                      LoginId="@NgRateSettings.LoginId"
                      SavedDbPath="@_savedDbPath"
                      ErrorMessage="@_errorMessage"
                      ShowClearResult="false"
                      LogElementId="@LogElementId"
                      Logs="@_logs"
                      HasSuccessfulResult="@(_report is not null)"
                      OnSetToday="SetToday"
                      OnClearLogs="@(() => _logs.Clear())">
        <GroupPicker>
            <NgRateSimpleGroupPicker Groups="@_groups"
                                     SelectedGroupNames="@_selectedGroupNames"
                                     IsBusy="@_isBusy"
                                     IsReportBusy="@_isReportBusy"
                                     IsCredentialsConfigured="@NgRateSettings.IsCredentialsConfigured"
                                     OnReload="ReloadGroups"
                                     OnSelectAll="SelectAllGroups"
                                     OnClearSelection="ClearSelectedGroups"
                                     OnToggleGroup="ToggleGroup"
                                     OnGetReport="GetReportAsync" />
        </GroupPicker>
    </NgRateSetupPanel>
}

@if (_report is not null && _reportByModel is not null && _selectedGroupNames.Count > 0)
{
    var wrWeeks  = WeeklyReportWeekCols;
    var wrMonths = WeeklyReportMonthCols;
    var wrRows   = WeeklyReportRows;

    <div class="card mt-3 ngrate-report-card">
        <div class="card-header ngrate-card-header small fw-semibold d-flex align-items-center gap-2">
            <span class="text-muted" style="font-size:11px;">@wrRows.Count row(s)</span>
            <div class="d-flex align-items-center gap-2 ms-auto">
                @if (!string.IsNullOrWhiteSpace(_weeklyFormSettingsStatus))
                {
                    <span class="text-muted" style="font-size:11px;">@_weeklyFormSettingsStatus</span>
                }
                <button type="button"
                        class="btn btn-outline-secondary btn-sm"
                        @onclick="ToggleWeeklyFormSettings">
                    @(_showWeeklyFormSettings ? "Hide Settings" : "Row Settings")
                </button>
                <button type="button"
                        class="btn btn-primary btn-sm"
                        @onclick="SaveWeeklyFormSettings">
                    Save
                </button>
            </div>
        </div>
        @if (_showWeeklyFormSettings)
        {
            var settingRows = WeeklyDisplaySettingRows;
            <div class="weekly-form-settings">
                <div class="weekly-form-settings-wrap">
                    <table class="table table-sm mb-0 weekly-form-settings-table">
                        <thead>
                            <tr>
                                <th style="width:180px;">Group</th>
                                <th>Item</th>
                                <th style="width:90px;">Line</th>
                                <th style="width:90px;">Sub Groups</th>
                                <th style="width:140px;">Display</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var settingRow in settingRows)
                            {
                                <tr>
                                    <td>@settingRow.GroupName</td>
                                    <td class="wrf-setting-node">@settingRow.Material</td>
                                    <td class="text-end">@settingRow.LineShiftCount</td>
                                    <td class="text-end">@settingRow.BGroupCount</td>
                                    <td>
                                        <select class="form-select form-select-sm"
                                                value="@settingRow.DisplayMode"
                                                @onchange="e => SetWeeklyDisplayMode(settingRow.GroupName, settingRow.Material, e.Value?.ToString())">
                                            <option value="@WeeklyDisplayModeGroup">Group</option>
                                            <option value="@WeeklyDisplayModeBGroup">Sub Group</option>
                                        </select>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        <div class="card-body ngrate-card-body p-0">
            @if (wrRows.Count == 0)
            {
                <div class="text-muted small p-4 text-center">
                    No rows found in the selected groups.
                </div>
            }
            else
            {
                <div style="overflow-x:auto;">
                    <table class="pivot-table text-fit-table">
                        <thead>
                            <tr>
                                <th class="label-th" rowspan="2" style="width:200px;">Product</th>
                                @if (wrWeeks.Count > 0)
                                {
                                    <th class="blk-week"  colspan="@wrWeeks.Count">Week</th>
                                    <th class="sep-th" rowspan="2"></th>
                                }
                                @if (wrMonths.Count > 0)
                                {
                                    <th class="blk-month" colspan="@wrMonths.Count">Month</th>
                                }
                            </tr>
                            <tr>
                                @foreach (var col in wrWeeks)  { <th>@col.Header</th> }
                                @foreach (var col in wrMonths) { <th>@col.Header</th> }
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var byId = wrRows.ToDictionary(r => r.RowId, r => r);
                                var hasChildren = wrRows
                                    .Where(r => r.ParentId is not null)
                                    .Select(r => r.ParentId!)
                                    .ToHashSet(StringComparer.Ordinal);
                            }
                            @foreach (var row in wrRows.Where(r => IsWrRowVisible(r, byId)))
                            {
                                int padPx       = 10 + row.Depth * 18;
                                string rowCls   = row.IsLineShift ? "wr-ls-row"
                                                : row.Depth switch
                                                {
                                                    0 => "wr-mid-row",
                                                    1 => "wr-sub1-row",
                                                    _ => "wr-sub2-row"
                                                };
                                string levelLabel = row.IsLineShift ? "SHIFT"
                                                  : row.Depth == 0 ? "MODEL"
                                                  : "SUB";
                                bool   expanded = IsSectionExpanded(_expandedRowsWr, row.RowId);
                                bool   canExp   = hasChildren.Contains(row.RowId);
                                string capturedId = row.RowId;
                                <tr class="@rowCls @(canExp ? "wr-row-expandable" : "")"
                                    @onclick="@(() => { if (canExp) ToggleWrRow(capturedId); })">
                                    <td class="label-td" style="padding-left: @(padPx)px;">
                                        @if (canExp)
                                        {
                                            <span class="wr-tog">@(expanded ? "v" : ">")</span>
                                        }
                                        else
                                        {
                                            <span class="wr-tog wr-tog-blank"></span>
                                        }
                                        <span class="ngrate-hier-level">@levelLabel</span>
                                        <span class="ms-1">@row.Display</span>
                                    </td>
                                    @foreach (var col in wrWeeks)
                                    {
                                        double v = row.WeekPpm.GetValueOrDefault(col.Key);
                                        <td class="@(v == 0 ? "ppm-zero" : "ppm-val")">@FormatPpmOrBlank(v)</td>
                                    }
                                    @if (wrWeeks.Count > 0) { <td class="sep-td"></td> }
                                    @foreach (var col in wrMonths)
                                    {
                                        double v = row.MonthPpm.GetValueOrDefault(col.Key);
                                        <td class="@(v == 0 ? "ppm-zero" : "ppm-val")">@FormatPpmOrBlank(v)</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

<!-- ?먥븧 Summary (per group 횞 per date) ?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧 -->
<div class="card mt-3 ngrate-report-card">
    <div class="card-header ngrate-card-header small fw-semibold d-flex align-items-center gap-2">
        <span>Summary - group x Date / Week / Month (PPM)</span>
        @if (_report is not null)
        {
            <span class="text-muted" style="font-size:11px;">
                W @VisibleWeekCols.Count/@_report.WeekCols.Count - M @VisibleMonthCols.Count/@_report.MonthCols.Count - @_report.TotalRows rows
            </span>
            <div class="btn-group btn-group-sm ms-auto">
                @* Date toggle hidden ??For Weekly Report view never shows date columns. *@
                @if (HiddenWeekCount > 0 || _weekExpanded)
                {
                    <button class="btn btn-outline-success"
                            @onclick="() => _weekExpanded = !_weekExpanded">
                        @(_weekExpanded ? $"Week ({_report.WeekCols.Count - DefaultWeekCap} hide)" : $"Week (+{HiddenWeekCount})")
                    </button>
                }
                @if (HiddenMonthCount > 0 || _monthExpanded)
                {
                    <button class="btn btn-outline-warning"
                            @onclick="() => _monthExpanded = !_monthExpanded">
                        @(_monthExpanded ? $"Month ({_report.MonthCols.Count - DefaultMonthCap} hide)" : $"Month (+{HiddenMonthCount})")
                    </button>
                }
            </div>
            <button class="btn btn-outline-success btn-sm"
                    @onclick="ExportCsvAsync"
                    disabled="@_isExporting">
                @if (_isExporting)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    <span>Exporting...</span>
                }
                else
                {
                    <span>Export CSV</span>
                }
            </button>
        }
    </div>
    <div class="card-body ngrate-card-body p-0">
        @if (!string.IsNullOrEmpty(_reportError))
        {
            <div class="alert alert-danger m-3 py-2 small">@_reportError</div>
        }
        else if (_report is null)
        {
            <div class="text-muted small p-4 text-center">
                Select groups, then click <strong>Generate Report</strong>.
            </div>
        }
        else if (TotalColCount == 0)
        {
            <div class="text-muted small p-4 text-center">No data.</div>
        }
        else
        {
            <div style="overflow-x:auto;">
                <table class="pivot-table text-fit-table">
                    <thead>
                        <tr>
                            <th class="label-th" style="width:220px;" rowspan="2">Group</th>
                            @if (VisibleDateCols.Count > 0)
                            {
                                <th class="blk-date"  colspan="@VisibleDateCols.Count">Date</th>
                                <th class="sep-th" rowspan="2"></th>
                            }
                            @if (VisibleWeekCols.Count > 0)
                            {
                                <th class="blk-week"  colspan="@VisibleWeekCols.Count">Week</th>
                                <th class="sep-th" rowspan="2"></th>
                            }
                            @if (VisibleMonthCols.Count > 0)
                            {
                                <th class="blk-month" colspan="@VisibleMonthCols.Count">Month</th>
                            }
                        </tr>
                        <tr>
                            @foreach (var col in VisibleDateCols)  { <th>@col.Header</th> }
                            @foreach (var col in VisibleWeekCols)  { <th>@col.Header</th> }
                            @foreach (var col in VisibleMonthCols) { <th>@col.Header</th> }
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="grp-overall-row">
                            <td class="label-td"><strong>TOTAL</strong>
                                <span class="text-muted ms-1" style="font-size:10px;">@_selectedGroupNames.Count groups avg</span>
                            </td>
                            @foreach (var col in VisibleDateCols)
                            {
                                double v = MeanOfGroups(col.Key);
                                <td class="@(v == 0 ? "ppm-zero" : "ppm-val")">@FormatPpmOrBlank(v)</td>
                            }
                            @if (VisibleDateCols.Count > 0) { <td class="sep-td"></td> }
                            @foreach (var col in VisibleWeekCols)
                            {
                                double v = MeanOfGroups(col.Key);
                                <td class="@(v == 0 ? "ppm-zero" : "ppm-val")">@FormatPpmOrBlank(v)</td>
                            }
                            @if (VisibleWeekCols.Count > 0) { <td class="sep-td"></td> }
                            @foreach (var col in VisibleMonthCols)
                            {
                                double v = MeanOfGroups(col.Key);
                                <td class="@(v == 0 ? "ppm-zero" : "ppm-val")">@FormatPpmOrBlank(v)</td>
                            }
                        </tr>
                        @foreach (var gName in _selectedGroupNames)
                        {
                            var rows  = _report.GroupSummary.GetValueOrDefault(gName);
                            var total = rows?.FirstOrDefault(r => r.IsTotal);
                            bool expanded = IsSectionExpanded(_expandedGroups, gName);

                            <tr class="grp-total-row" @onclick="() => ToggleExpand(gName)">
                                <td class="label-td">
                                    <span class="tog-icon">@(expanded ? "v" : ">")</span>
                                    <span class="ngrate-hier-level">GROUP</span>
                                    <strong>@ReportGroupDisplayName(gName)</strong>
                                </td>
                                @foreach (var col in VisibleDateCols)
                                {
                                    double v = MeanOfMembers(gName, col.Key, null);
                                    <td class="@(v == 0 ? "ppm-zero" : "ppm-val")">@FormatPpmOrBlank(v)</td>
                                }
                                @if (VisibleDateCols.Count > 0) { <td class="sep-td"></td> }
                                @foreach (var col in VisibleWeekCols)
                                {
                                    double v = MeanOfMembers(gName, col.Key, null);
                                    <td class="@(v == 0 ? "ppm-zero" : "ppm-val")">@FormatPpmOrBlank(v)</td>
                                }
                                @if (VisibleWeekCols.Count > 0) { <td class="sep-td"></td> }
                                @foreach (var col in VisibleMonthCols)
                                {
                                    double v = MeanOfMembers(gName, col.Key, null);
                                    <td class="@(v == 0 ? "ppm-zero" : "ppm-val")">@FormatPpmOrBlank(v)</td>
                                }
                            </tr>

                            @if (expanded && rows is not null)
                            {
                                @foreach (var r in rows.Where(r => !r.IsTotal).OrderBy(r => ProcessTypeRank(r.ProcessType)))
                                {
                                    <tr class="grp-sub-row">
                                        <td class="label-td ps-4">
                                            <span class="pt-badge">@r.ProcessType</span>
                                        </td>
                                        @foreach (var col in VisibleDateCols)
                                        {
                                            double v = MeanOfMembers(gName, col.Key, r.ProcessType);
                                            <td class="@(v == 0 ? "ppm-zero" : "ppm-val")">@FormatPpmOrBlank(v)</td>
                                        }
                                        @if (VisibleDateCols.Count > 0) { <td class="sep-td"></td> }
                                        @foreach (var col in VisibleWeekCols)
                                        {
                                            double v = MeanOfMembers(gName, col.Key, r.ProcessType);
                                            <td class="@(v == 0 ? "ppm-zero" : "ppm-val")">@FormatPpmOrBlank(v)</td>
                                        }
                                        @if (VisibleWeekCols.Count > 0) { <td class="sep-td"></td> }
                                        @foreach (var col in VisibleMonthCols)
                                        {
                                            double v = MeanOfMembers(gName, col.Key, r.ProcessType);
                                            <td class="@(v == 0 ? "ppm-zero" : "ppm-val")">@FormatPpmOrBlank(v)</td>
                                        }
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- ?먥븧 Chart (per-group PPM trend over dates) ?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧 -->
@if (_report is not null && TotalColCount > 0 && _selectedGroupNames.Count > 0)
{
    <div class="card mt-3 ngrate-report-card">
        <div class="card-header ngrate-card-header small fw-semibold d-flex align-items-center gap-2">
            <span>Group trend - PPM (Date / Week / Month)</span>
        </div>
        <div class="card-body ngrate-card-body" style="height:320px;">
            <canvas id="ngrateByGroupCanvas"></canvas>
            @ExportChartPayload(CanvasId)
        </div>
    </div>
}

<!-- ?먥븧 Summary 2 (per group 횞 per model) ?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧??-->
<div class="card mt-3 ngrate-report-card">
    <div class="card-header ngrate-card-header small fw-semibold d-flex align-items-center gap-2">
        <span>Summary - Group - Model Name x Week / Month (PPM)</span>
        @if (_reportByMid is not null)
        {
            <span class="text-muted" style="font-size:11px;">Model Name PPM = same combo-merged as per-model</span>
            <div class="d-flex align-items-center gap-2 ms-auto">
                <label class="form-check form-check-inline d-flex align-items-center gap-1 m-0" style="font-size:11px;">
                    <input type="checkbox" class="form-check-input m-0" @bind="_showWeeklyModelSummaryDelta" />
                    <span>증감률</span>
                </label>
                <button class="btn btn-outline-success btn-sm"
                        @onclick="ExportWeeklyModelSummaryCsvAsync"
                        disabled="@_isExporting">
                    @if (_isExporting)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        <span>Exporting...</span>
                    }
                    else
                    {
                        <span>Export CSV</span>
                    }
                </button>
            </div>
        }
    </div>
    <div class="card-body ngrate-card-body p-0">
        @if (_report is null || _reportByMid is null)
        {
            <div class="text-muted small p-4 text-center">
                Displayed after Generate Report.
            </div>
        }
        else if (TotalColCount == 0)
        {
            <div class="text-muted small p-4 text-center">No data.</div>
        }
        else
        {
            <div style="overflow-x:auto;">
                <table class="pivot-table text-fit-table">
                    <thead>
                        <tr>
                            <th class="label-th" style="width:260px;" rowspan="2">Group / Model</th>
                            @if (VisibleDateCols.Count > 0)
                            {
                                <th class="blk-date"  colspan="@VisibleDateCols.Count">Date</th>
                                <th class="sep-th" rowspan="2"></th>
                            }
                            @if (VisibleWeekCols.Count > 0)
                            {
                                <th class="blk-week"  colspan="@VisibleWeekCols.Count">Week</th>
                                <th class="sep-th" rowspan="2"></th>
                            }
                            @if (VisibleMonthCols.Count > 0)
                            {
                                <th class="blk-month" colspan="@VisibleMonthCols.Count">Month</th>
                            }
                        </tr>
                        <tr>
                            @foreach (var col in VisibleDateCols)  { <th>@col.Header</th> }
                            @foreach (var col in VisibleWeekCols)  { <th>@col.Header</th> }
                            @foreach (var col in VisibleMonthCols) { <th>@col.Header</th> }
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="grp-overall-row">
                            <td class="label-td"><strong>TOTAL</strong>
                                <span class="text-muted ms-1" style="font-size:10px;">@_selectedGroupNames.Count groups avg</span>
                            </td>
                            @foreach (var col in VisibleDateCols)
                            {
                                double v = MeanOfGroups(col.Key);
                                <td class="@(v == 0 ? "ppm-zero" : "ppm-val")">@FormatPpmOrBlank(v)</td>
                            }
                            @if (VisibleDateCols.Count > 0) { <td class="sep-td"></td> }
                            @{ var totWeekCols2 = VisibleWeekCols; }
                            @for (int wi = 0; wi < totWeekCols2.Count; wi++)
                            {
                                var col   = totWeekCols2[wi];
                                double v  = MeanOfGroups(col.Key);
                                double? p = PreviousNonZeroPpm(totWeekCols2, wi, c => MeanOfGroups(c.Key));
                                <td class="@(v == 0 ? "ppm-zero" : "ppm-val")">@FormatModelSummaryPpm(v, p)</td>
                            }
                            @if (VisibleWeekCols.Count > 0) { <td class="sep-td"></td> }
                            @{ var totMonthCols2 = VisibleMonthCols; }
                            @for (int mi2 = 0; mi2 < totMonthCols2.Count; mi2++)
                            {
                                var col   = totMonthCols2[mi2];
                                double v  = MeanOfGroups(col.Key);
                                double? p = PreviousNonZeroPpm(totMonthCols2, mi2, c => MeanOfGroups(c.Key));
                                <td class="@(v == 0 ? "ppm-zero" : "ppm-val")">@FormatModelSummaryPpm(v, p)</td>
                            }
                        </tr>
                        @foreach (var gName in _selectedGroupNames)
                        {
                            bool exp     = IsSectionExpanded(_expandedGroupsModel, gName);
                            var  grpVm   = _groups.FirstOrDefault(g => g.Name == gName);
                            var  midList = (grpVm?.MidGroups ?? new List<MidGroupRecord>())
                                .Where(mid => MidHasVisibleData(gName, mid))
                                .ToList();

                            <tr class="grp-total-row" @onclick="() => ToggleExpandModel(gName)">
                                <td class="label-td">
                                    <span class="tog-icon">@(exp ? "v" : ">")</span>
                                    <span class="ngrate-hier-level">GROUP</span>
                                    <strong>@ReportGroupDisplayName(gName)</strong>
                                </td>
                                @foreach (var col in VisibleDateCols)
                                {
                                    double v = MeanOfMembers(gName, col.Key, null);
                                    <td class="@(v == 0 ? "ppm-zero" : "ppm-val")">@FormatPpmOrBlank(v)</td>
                                }
                                @if (VisibleDateCols.Count > 0) { <td class="sep-td"></td> }
                                @{ var grpWeekCols = VisibleWeekCols; }
                                @for (int wi3 = 0; wi3 < grpWeekCols.Count; wi3++)
                                {
                                    var col   = grpWeekCols[wi3];
                                    double v  = MeanOfMembers(gName, col.Key, null);
                                    double? p = PreviousNonZeroPpm(grpWeekCols, wi3, c => MeanOfMembers(gName, c.Key, null));
                                    <td class="@(v == 0 ? "ppm-zero" : "ppm-val")">@FormatModelSummaryPpm(v, p)</td>
                                }
                                @if (VisibleWeekCols.Count > 0) { <td class="sep-td"></td> }
                                @{ var grpMonthCols = VisibleMonthCols; }
                                @for (int mi3 = 0; mi3 < grpMonthCols.Count; mi3++)
                                {
                                    var col   = grpMonthCols[mi3];
                                    double v  = MeanOfMembers(gName, col.Key, null);
                                    double? p = PreviousNonZeroPpm(grpMonthCols, mi3, c => MeanOfMembers(gName, c.Key, null));
                                    <td class="@(v == 0 ? "ppm-zero" : "ppm-val")">@FormatModelSummaryPpm(v, p)</td>
                                }
                            </tr>

                            @if (exp)
                            {
                                @foreach (var mid in midList)
                                {
                                    string midKey = $"{gName}::{mid.Material}";
                                    bool midExp   = IsSectionExpanded(_expandedMids, midKey);
                                    <tr class="grp-sub-row grp-mid-row" @onclick="() => ToggleExpandMid(midKey)">
                                        <td class="label-td ps-4" style="font-size:11px;">
                                            <span class="tog-icon">@(midExp ? "v" : ">")</span>
                                            <span class="ngrate-hier-level">MODEL</span>
                                            <span class="ms-1">@mid.Material</span>
                                            <span class="text-muted ms-1" style="font-size:10px;">@mid.LineShifts.Count</span>
                                        </td>
                                        @foreach (var col in VisibleDateCols)
                                        {
                                            double v = MidPpmAvgOfSubs(gName, mid, col.Key);
                                            <td class="@(v == 0 ? "ppm-zero" : "ppm-val")">@FormatPpmOrBlank(v)</td>
                                        }
                                        @if (VisibleDateCols.Count > 0) { <td class="sep-td"></td> }
                                        @{ var weekCols = VisibleWeekCols; }
                                        @for (int wi = 0; wi < weekCols.Count; wi++)
                                        {
                                            var col   = weekCols[wi];
                                            double v  = MidPpmAvgOfSubs(gName, mid, col.Key);
                                            double? p = PreviousNonZeroPpm(weekCols, wi, c => MidPpmAvgOfSubs(gName, mid, c.Key));
                                            <td class="@(v == 0 ? "ppm-zero" : "ppm-val")">@FormatModelSummaryPpm(v, p)</td>
                                        }
                                        @if (VisibleWeekCols.Count > 0) { <td class="sep-td"></td> }
                                        @{ var monthCols = VisibleMonthCols; }
                                        @for (int mi2 = 0; mi2 < monthCols.Count; mi2++)
                                        {
                                            var col   = monthCols[mi2];
                                            double v  = MidPpmAvgOfSubs(gName, mid, col.Key);
                                            double? p = PreviousNonZeroPpm(monthCols, mi2, c => MidPpmAvgOfSubs(gName, mid, c.Key));
                                            <td class="@(v == 0 ? "ppm-zero" : "ppm-val")">@FormatModelSummaryPpm(v, p)</td>
                                        }
                                    </tr>

                                    @if (midExp)
                                    {
                                        @foreach (var ls in mid.LineShifts)
                                        {
                                            var mRows = _reportByModel?.GroupSummary.GetValueOrDefault(ls);
                                            var mTot  = mRows?.FirstOrDefault(r => r.IsTotal);
                                            <tr class="grp-ls-row">
                                                <td class="label-td ps-5 font-monospace" style="font-size:11px;">
                                                    <span class="ls-badge">Shift Group</span>
                                                    <span class="ms-1">@ls</span>
                                                </td>
                                                @foreach (var col in VisibleDateCols)
                                                {
                                                    double v = mTot?.Ppm.GetValueOrDefault(col.Key) ?? 0;
                                                    <td class="@(v == 0 ? "ppm-zero" : "ppm-val")">@FormatPpmOrBlank(v)</td>
                                                }
                                                @if (VisibleDateCols.Count > 0) { <td class="sep-td"></td> }
                                                @foreach (var col in VisibleWeekCols)
                                                {
                                                    double v = mTot?.Ppm.GetValueOrDefault(col.Key) ?? 0;
                                                    <td class="@(v == 0 ? "ppm-zero" : "ppm-val")">@FormatPpmOrBlank(v)</td>
                                                }
                                                @if (VisibleWeekCols.Count > 0) { <td class="sep-td"></td> }
                                                @foreach (var col in VisibleMonthCols)
                                                {
                                                    double v = mTot?.Ppm.GetValueOrDefault(col.Key) ?? 0;
                                                    <td class="@(v == 0 ? "ppm-zero" : "ppm-val")">@FormatPpmOrBlank(v)</td>
                                                }
                                            </tr>
                                        }
                                    }
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

