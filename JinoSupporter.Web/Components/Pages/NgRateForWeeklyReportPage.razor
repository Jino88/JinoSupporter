<!-- ?먥븧 Top-10 per group (Mid Group 횞 Process 횞 NG) ?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧 -->
@if (_midNgReport is not null && _selectedGroupNames.Count > 0)
{
    var (_refKey, _refBucket) = SortRefKey();
    <div class="card mt-3 ngrate-report-card">
        <div class="card-header ngrate-card-header small fw-semibold d-flex align-items-center gap-2">
            <span>Top 10 per group - Model Name x Process x NG</span>
            <span class="text-muted" style="font-size:11px;">
                @if (!string.IsNullOrEmpty(_refKey))
                { <text>Sorted: previous-week PPM, descending (ref = @_refBucket @ShiftedRefLabel(_refKey, _refBucket))</text> }
                else { <text>No sort reference available.</text> }
            </span>
        </div>
        <div class="card-body ngrate-card-body p-0">
            @foreach (var gName in _selectedGroupNames)
            {
                // 以묎렇猷??ㅻ뒗 "?洹몃９::Material" ?뺥깭. ?꾩옱 ?洹몃９???대떦?섎뒗 ?ㅻ쭔 ?꾪꽣.
                string prefix = gName + "::";
                var top = _midNgReport.Details
                    .Where(d => d.LineShift.StartsWith(prefix, StringComparison.Ordinal))
                    .Select(d => new
                    {
                        Detail   = d,
                        Material = d.LineShift.Substring(prefix.Length),
                        Ref      = DetailSortValue(d),
                    })
                    .Where(x => x.Ref > 0)
                    .OrderByDescending(x => x.Ref)
                    .Take(10)
                    .ToList();

                <div class="px-3 py-2 top10-group-head">
                    <span class="ngrate-hier-level">GROUP</span>
                    <strong class="me-2">@ReportGroupDisplayName(gName)</strong>
                    <span class="text-muted small">@top.Count rows</span>
                </div>
                @if (top.Count == 0)
                {
                    <div class="text-muted small px-3 pb-3">(no data)</div>
                }
                else
                {
                    <div style="overflow-x:auto;">
                        <table class="pivot-table top10-table">
                            <colgroup>
                                <col style="width:48px;" />
                                <col style="width:190px;" />
                                <col style="width:360px;" />
                                <col style="width:190px;" />
                                @foreach (var _ in Top10DateCols)  { <col style="width:70px;" /> }
                                @if (Top10DateCols.Count > 0)   { <col style="width:8px;" /> }
                                @foreach (var _ in Top10WeekCols)  { <col style="width:70px;" /> }
                                @if (Top10WeekCols.Count > 0)   { <col style="width:8px;" /> }
                                @foreach (var _ in Top10MonthCols) { <col style="width:70px;" /> }
                            </colgroup>
                            <thead>
                                <tr>
                                    <th class="label-th" rowspan="2">#</th>
                                    <th class="label-th" rowspan="2">Model Name</th>
                                    <th class="label-th process-name-col" rowspan="2">Process</th>
                                    <th class="label-th ng-name-col" rowspan="2">NG Name</th>
                                    @if (Top10DateCols.Count > 0)
                                    {
                                        <th class="blk-date"  colspan="@Top10DateCols.Count">Date</th>
                                        <th class="sep-th" rowspan="2"></th>
                                    }
                                    @if (Top10WeekCols.Count > 0)
                                    {
                                        <th class="blk-week"  colspan="@Top10WeekCols.Count">Week</th>
                                        <th class="sep-th" rowspan="2"></th>
                                    }
                                    @if (Top10MonthCols.Count > 0)
                                    {
                                        <th class="blk-month" colspan="@Top10MonthCols.Count">Month</th>
                                    }
                                </tr>
                                <tr>
                                    @foreach (var col in Top10DateCols)  { <th>@ShiftedDateHeader(col)</th> }
                                    @foreach (var col in Top10WeekCols)  { <th>@ShiftedWeekHeader(col)</th> }
                                    @foreach (var col in Top10MonthCols) { <th>@col.Header</th> }
                                </tr>
                            </thead>
                            <tbody>
                                @{ int rank = 0; }
                                @foreach (var x in top)
                                {
                                    rank++;
                                    var d = x.Detail;
                                    <tr>
                                        <td class="label-td n text-muted">@rank</td>
                                        <td class="label-td font-monospace" style="font-size:11px;">@x.Material</td>
                                        <td class="label-td process-name-col" style="font-size:11px;">
                                            <span class="process-cell">
                                                <span class="pt-badge">@d.ProcessType</span>
                                                <span class="process-label">@d.ProcessName</span>
                                            </span>
                                        </td>
                                        <td class="label-td ng-name-col" style="font-size:11px;">@d.NgName</td>
                                        @foreach (var col in Top10DateCols)
                                        {
                                            double v = d.DatePpm.GetValueOrDefault(col.Key);
                                            <td class="@(v == 0 ? "ppm-zero" : "ppm-val")">@FormatPpmOrBlank(v)</td>
                                        }
                                        @if (Top10DateCols.Count > 0) { <td class="sep-td"></td> }
                                        @{ var t10WeekCols = Top10WeekCols; }
                                        @for (int wi4 = 0; wi4 < t10WeekCols.Count; wi4++)
                                        {
                                            var col   = t10WeekCols[wi4];
                                            double v  = d.WeekPpm.GetValueOrDefault(col.Key);
                                            double? p = PreviousNonZeroPpm(t10WeekCols, wi4, c => d.WeekPpm.GetValueOrDefault(c.Key));
                                            <td class="@(v == 0 ? "ppm-zero" : "ppm-val")">@FormatPpmWithDelta(v, p)</td>
                                        }
                                        @if (Top10WeekCols.Count > 0) { <td class="sep-td"></td> }
                                        @{ var t10MonthCols = Top10MonthCols; }
                                        @for (int mi4 = 0; mi4 < t10MonthCols.Count; mi4++)
                                        {
                                            var col   = t10MonthCols[mi4];
                                            double v  = d.MonthPpm.GetValueOrDefault(col.Key);
                                            double? p = PreviousNonZeroPpm(t10MonthCols, mi4, c => d.MonthPpm.GetValueOrDefault(c.Key));
                                            <td class="@(v == 0 ? "ppm-zero" : "ppm-val")">@FormatPpmWithDelta(v, p)</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>
    </div>
}


@code {
    [Parameter] public bool ShowTitle { get; set; } = true;
    [Parameter] public bool ShowSetup { get; set; } = true;

    // ── Static-HTML export mode ────────────────────────────────────────────────
    // Rendered by BmesReportHtmlExportService through the standalone HtmlRenderer. The
    // Daily tab already scraped BMES, so this reuses that hierarchy instead of fetching
    // again, and emits every period column (a static snapshot cannot expand).
    [Parameter] public bool ExportMode { get; set; }
    [Parameter] public DateTime? ExportStart { get; set; }
    [Parameter] public DateTime? ExportEnd { get; set; }
    [Parameter] public IReadOnlyList<ModelGroupRecord>? ExportGroups { get; set; }
    [Parameter] public HierReports? ExportSharedHierarchy { get; set; }
    [Parameter] public IProgress<string>? ExportProgress { get; set; }
    [Parameter] public BmesWeeklyCalculationSnapshot? ExportCalculationSnapshot { get; set; }
    private bool _exportGenerated;

    protected override async Task OnParametersSetAsync()
    {
        if (ExportMode && !_exportGenerated && ExportCalculationSnapshot is { } snapshot)
        {
            _exportGenerated = true;
            ApplyCalculationSnapshot(snapshot, ExportGroups ?? snapshot.Hierarchy.Groups);
            return;
        }

        if (ExportMode && !_exportGenerated
            && ExportStart is { } start && ExportEnd is { } end
            && ExportGroups is { Count: > 0 } groups)
        {
            _exportGenerated = true;
            await GenerateReportAsync(start, end, groups, ExportProgress, ExportSharedHierarchy);
        }
    }

    private DateTime _startDate = DateTime.Today;
    private DateTime _endDate   = DateTime.Today;
    private bool     _isBusy;
    private string?  _savedDbPath;
    private string   _errorMessage = string.Empty;
    private List<string> _logs = new();
    private const string LogElementId = "ngRateLogWeekly";
    private IProgress<string>? _externalProgress;

    private List<ModelGroupRecord> _groups             = new();
    private IReadOnlyList<ModelGroupRecord>? _groupOverride;
    private HashSet<string>        _selectedGroupNames = new(StringComparer.Ordinal);

    private NgRateReportService.NgRateReport?       _report;
    private NgRateReportService.NgRateReport?       _reportByMid;
    private NgRateReportService.NgRateReport?       _reportByModel;
    private NgRateReportService.NgRateReport?       _reportBySubGroup;   // top-level Sub aggregation (Sub1)
    private NgRateReportService.NgRateReport?       _reportBySubLeaf;    // every named leaf Sub (Sub2+) with its own bucket
    private NgRateReportService.LineShiftNgReport?  _lsNgReport;
    private NgRateReportService.LineShiftNgReport?  _midNgReport;
    private HierPpmLookup                           _hierLookup = new();
    private HashSet<string>                         _expandedMids = new(StringComparer.Ordinal);
    private bool           _isReportBusy;
    private bool           _isExporting;
    private bool           _showWeeklyModelSummaryDelta = true;
    private string         _reportError = string.Empty;
    private HashSet<string> _expandedGroups      = new(StringComparer.Ordinal);
    private HashSet<string> _expandedGroupsModel = new(StringComparer.Ordinal);
    private Dictionary<string, WeeklyReportFormSettingRecord> _weeklyFormSettings = new(StringComparer.Ordinal);
    private bool           _showWeeklyFormSettings;
    private string         _weeklyFormSettingsStatus = string.Empty;
    private bool           _pendingChartRender;
    private const string   CanvasId      = "ngrateByGroupCanvas";
    private const string   CanvasIdModel = "ngrateByGroupModelCanvas";
    private const string   WeeklyDisplayModeGroup = "Group";
    private const string   WeeklyDisplayModeBGroup = "B-GROUP";
    private const string   WeeklyRowKindLineGroup = "Sub Group";
    private const string   WeeklyRowKindShiftGroup = "Shift Group";

    // Period collapse defaults / state
    private const int DefaultDateCap  = 10;
    private const int DefaultWeekCap  = 4;
    private const int DefaultMonthCap = 3;
    private bool _weekExpanded;
    private bool _monthExpanded;

    // For Weekly Report view: hide ALL Date columns from tables and charts.
    // Render code uses `VisibleDateCols.Count > 0` guards everywhere, so an empty
    // list cleanly skips every date-related cell, header, and chart slice.
    private IReadOnlyList<NgRateReportService.PeriodColumn> VisibleDateCols =>
        Array.Empty<NgRateReportService.PeriodColumn>();
    private IReadOnlyList<NgRateReportService.PeriodColumn> VisibleWeekCols =>
        _report is null ? Array.Empty<NgRateReportService.PeriodColumn>()
        : ExportMode || _weekExpanded ? _report.WeekCols
        : _report.WeekCols.Take(DefaultWeekCap).ToList();
    private IReadOnlyList<NgRateReportService.PeriodColumn> VisibleMonthCols =>
        _report is null ? Array.Empty<NgRateReportService.PeriodColumn>()
        : ExportMode || _monthExpanded ? _report.MonthCols
        : _report.MonthCols.Take(DefaultMonthCap).ToList();

    private int HiddenDateCount  => _report is null ? 0 : Math.Max(0, _report.DateCols.Count  - VisibleDateCols.Count);
    private int HiddenWeekCount  => _report is null ? 0 : Math.Max(0, _report.WeekCols.Count  - VisibleWeekCols.Count);
    private int HiddenMonthCount => _report is null ? 0 : Math.Max(0, _report.MonthCols.Count - VisibleMonthCols.Count);

    // Top-10 移대뱶 ?꾩슜 怨좎젙 cap (?곷떒 ?묎린? 臾닿?)
    private const int Top10DateCap  = 10;
    private const int Top10WeekCap  = 4;
    private const int Top10MonthCap = 3;
    private IReadOnlyList<NgRateReportService.PeriodColumn> Top10DateCols =>
        Array.Empty<NgRateReportService.PeriodColumn>();
    private IReadOnlyList<NgRateReportService.PeriodColumn> Top10WeekCols =>
        _report is null ? Array.Empty<NgRateReportService.PeriodColumn>()
        : _report.WeekCols.Take(Top10WeekCap).ToList();
    private IReadOnlyList<NgRateReportService.PeriodColumn> Top10MonthCols =>
        _report is null ? Array.Empty<NgRateReportService.PeriodColumn>()
        : _report.MonthCols.Take(Top10MonthCap).ToList();

    private int TotalColCount =>
        _report is null ? 0
        : VisibleDateCols.Count + VisibleWeekCols.Count + VisibleMonthCols.Count;

    // Independent of the user's expand/collapse state ??always shows the latest 4 weeks
    // and latest 3 months so the snapshot matches what the user copies into Excel.
    private const int WeeklyReportWeekCount  = 4;
    private const int WeeklyReportMonthCount = 3;
    private const string BaselineMonthKey    = "202512"; // 2025??12??湲곗? (matches GetMonthKey format)

    private IReadOnlyList<NgRateReportService.PeriodColumn> WeeklyReportWeekCols =>
        _report is null ? Array.Empty<NgRateReportService.PeriodColumn>()
        : _report.WeekCols.Take(WeeklyReportWeekCount).ToList();

    private IReadOnlyList<NgRateReportService.PeriodColumn> WeeklyReportMonthCols =>
        _report is null ? Array.Empty<NgRateReportService.PeriodColumn>()
        : _report.MonthCols.Take(WeeklyReportMonthCount).ToList();

    /// <summary>One row per node in the Mid ??Sub1 ??Sub2 hierarchy.
    ///   Depth 0 = Mid           ??read from _reportByMid (full subtree aggregate)
    ///   Depth 1 = top-level Sub ??read from _reportBySubGroup (subtree aggregate)
    ///   Depth 2+ = nested Sub   ??read from _reportBySubLeaf (this node's own
    ///                              direct LineShifts only).
    /// <see cref="ParentId"/> ties each row to its immediate parent so the render
    /// layer can hide subtrees whose ancestor isn't expanded. Default ("") sub-groups
    /// don't take a row; their named children inherit the parent's depth.</summary>
    private sealed record WeeklyReportRow(
        string                     RowId,
        string?                    ParentId,
        string                     Display,
        string                     RowKind,
        int                        Depth,
        bool                       IsLineShift,
        double?                    Baseline,
        double?                    Target,
        double?                    AchievementPct,
        Dictionary<string, double> WeekPpm,
        Dictionary<string, double> MonthPpm);

    private sealed record WeeklyDisplaySettingRow(
        string RowKey,
        string GroupName,
        string Material,
        int    LineShiftCount,
        int    BGroupCount,
        string DisplayMode);

    /// <summary>RowIds of Mid / Sub rows the user has clicked open. Children of
    /// non-expanded rows are filtered out at render time.</summary>
    private HashSet<string> _expandedRowsWr = new(StringComparer.Ordinal);

    private List<WeeklyReportRow> WeeklyReportRows
    {
        get
        {
            var rows = new List<WeeklyReportRow>();
            if (_report is null || _reportByMid is null) return rows;

            foreach (var grp in _groups.Where(g => _selectedGroupNames.Contains(g.Name)))
            {
                foreach (var mid in grp.MidGroups)
                {
                    int totalLs = mid.LineShifts.Count;
                    if (totalLs == 0 || string.IsNullOrEmpty(mid.Material)) continue;
                    if (!MidHasVisibleData(grp.Name, mid)) continue;

                    string displayMode = WeeklyDisplayModeOf(grp.Name, mid.Material);
                    bool useBGroup = displayMode == WeeklyDisplayModeBGroup && MidHasNamedBGroups(mid);
                    if (useBGroup)
                    {
                        foreach (var sub in mid.SubGroups)
                            EmitSubRows(grp.Name, mid.Material, sub,
                                        parentPath: string.Empty, depth: 0,
                                        parentRowId: null, rows);
                        continue;
                    }

                    string midKey   = $"{grp.Name}::{mid.Material}";
                    string midRowId = "M::" + midKey;

                    var midWeekPpm  = new Dictionary<string, double>();
                    var midMonthPpm = new Dictionary<string, double>();
                    foreach (var col in WeeklyReportWeekCols)
                        midWeekPpm[col.Key] = MidPpmAvgOfSubs(grp.Name, mid, col.Key);
                    foreach (var col in WeeklyReportMonthCols)
                        midMonthPpm[col.Key] = MidPpmAvgOfSubs(grp.Name, mid, col.Key);
                    double midBaselineVal = MidPpmAvgOfSubs(grp.Name, mid, BaselineMonthKey);

                    rows.Add(new WeeklyReportRow(
                        RowId: midRowId,
                        ParentId: null,
                        Display: mid.Material,
                        RowKind: WeeklyDisplayModeGroup,
                        Depth: 0,
                        IsLineShift: false,
                        Baseline: midBaselineVal > 0 ? midBaselineVal : (double?)null,
                        Target: null, AchievementPct: null,
                        WeekPpm: midWeekPpm, MonthPpm: midMonthPpm));
                }
            }
            return rows;
        }
    }

    private List<WeeklyDisplaySettingRow> WeeklyDisplaySettingRows =>
        _groups
            .Where(g => _selectedGroupNames.Contains(g.Name))
            .SelectMany(g => g.MidGroups
                .Where(mid => !string.IsNullOrEmpty(mid.Material) && mid.LineShifts.Count > 0)
                .Select(mid => new WeeklyDisplaySettingRow(
                    RowKey: WeeklyModelRowKey(g.Name, mid.Material),
                    GroupName: g.Name,
                    Material: mid.Material,
                    LineShiftCount: mid.LineShifts.Count,
                    BGroupCount: mid.SubGroups.Count(s => !string.IsNullOrWhiteSpace(s.Name) && s.AllLineShifts.Any()),
                    DisplayMode: WeeklyDisplayModeOf(g.Name, mid.Material))))
            .ToList();

    private static string WeeklyModelRowKey(string groupName, string material)
        => "weekly:model:" + NgRateModeSupport.ModelKey(groupName, material);

    private WeeklyReportFormSettingRecord WeeklyModelSetting(string groupName, string material)
    {
        string rowKey = WeeklyModelRowKey(groupName, material);
        if (_weeklyFormSettings.TryGetValue(rowKey, out var setting))
            return setting;

        setting = new WeeklyReportFormSettingRecord
        {
            RowKey = rowKey,
            DisplayMode = WeeklyDisplayModeBGroup,
        };
        _weeklyFormSettings[rowKey] = setting;
        return setting;
    }

    private static string NormalizeWeeklyDisplayMode(string? value)
    {
        string mode = (value ?? string.Empty).Trim();
        return mode.Equals(WeeklyDisplayModeGroup, StringComparison.OrdinalIgnoreCase)
            ? WeeklyDisplayModeGroup
            : WeeklyDisplayModeBGroup;
    }

    private string WeeklyDisplayModeOf(string groupName, string material)
        => NormalizeWeeklyDisplayMode(WeeklyModelSetting(groupName, material).DisplayMode);

    private void SetWeeklyDisplayMode(string groupName, string material, string? displayMode)
    {
        WeeklyModelSetting(groupName, material).DisplayMode = NormalizeWeeklyDisplayMode(displayMode);
        _weeklyFormSettingsStatus = string.Empty;
    }

    private void ToggleWeeklyFormSettings()
    {
        _showWeeklyFormSettings = !_showWeeklyFormSettings;
        _weeklyFormSettingsStatus = string.Empty;
    }

    private void LoadWeeklyFormSettings()
    {
        _weeklyFormSettings = Repo.GetWeeklyReportFormSettings();
        _weeklyFormSettingsStatus = string.Empty;
    }

    private void SaveWeeklyFormSettings()
    {
        var settings = WeeklyDisplaySettingRows
            .Select(row => WeeklyModelSetting(row.GroupName, row.Material))
            .ToList();

        if (settings.Count == 0)
        {
            _weeklyFormSettingsStatus = "No rows";
            return;
        }

        Repo.SaveWeeklyReportFormSettings(settings);
        LoadWeeklyFormSettings();
        _weeklyFormSettingsStatus = "Saved";
    }

    private static bool MidHasNamedBGroups(MidGroupRecord mid)
        => mid.SubGroups.Any(s => !string.IsNullOrWhiteSpace(s.Name) && s.AllLineShifts.Any());

    /// <summary>Recursive walker ??emits one row per named SubGroup with the immediate
    /// parent RowId so the renderer can fold the subtree. Top-level subs (depth=1)
    /// pull PPM from <c>_reportBySubGroup</c>; nested subs use <c>_reportBySubLeaf</c>.
    /// Empty-named subs don't emit a row but recurse at the parent's depth.</summary>
    private void EmitSubRows(string groupName, string material, SubGroupRecord sub,
                             string parentPath, int depth, string? parentRowId,
                             List<WeeklyReportRow> rows)
    {
        string nodeName = sub.Name ?? string.Empty;
        string path = string.IsNullOrEmpty(nodeName)
            ? parentPath
            : (string.IsNullOrEmpty(parentPath) ? nodeName : parentPath + "::" + nodeName);

        string? thisRowId = parentRowId;
        bool emit = !string.IsNullOrEmpty(nodeName) && sub.AllLineShifts.Count() > 0;
        if (emit)
        {
            var weekPpm  = new Dictionary<string, double>();
            var monthPpm = new Dictionary<string, double>();
            string ownRowId;
            double bv;
            string rowKind;

            if (depth <= 1)
            {
                string sub1Key = ModelGroupPickerHelpers.SubGroupKeyOf(groupName, material, sub);
                ownRowId = "S1::" + sub1Key;
                rowKind = WeeklyDisplayModeBGroup;
                foreach (var col in WeeklyReportWeekCols)
                    weekPpm[col.Key] = SubGroupTotalPpm(sub1Key, col.Key);
                foreach (var col in WeeklyReportMonthCols)
                    monthPpm[col.Key] = SubGroupTotalPpm(sub1Key, col.Key);
                bv = SubGroupTotalPpm(sub1Key, BaselineMonthKey);
            }
            else
            {
                string leafKey = ModelGroupPickerHelpers.SubLeafKeyOf(groupName, material, path);
                ownRowId = "S" + depth + "::" + leafKey;
                rowKind = WeeklyRowKindLineGroup;
                foreach (var col in WeeklyReportWeekCols)
                    weekPpm[col.Key] = SubLeafTotalPpm(leafKey, col.Key);
                foreach (var col in WeeklyReportMonthCols)
                    monthPpm[col.Key] = SubLeafTotalPpm(leafKey, col.Key);
                bv = SubLeafTotalPpm(leafKey, BaselineMonthKey);
            }

            rows.Add(new WeeklyReportRow(
                RowId: ownRowId,
                ParentId: parentRowId,
                Display: nodeName,
                RowKind: rowKind,
                Depth: depth,
                IsLineShift: false,
                Baseline: bv > 0 ? bv : (double?)null,
                Target: null, AchievementPct: null,
                WeekPpm: weekPpm, MonthPpm: monthPpm));

            thisRowId = ownRowId;

            // Virtual LineShift leaves under this sub.
            if (sub.LineShifts.Count > 0)
            {
                int lsDepth = depth + 1;
                foreach (var ls in sub.LineShifts)
                {
                    if (string.IsNullOrEmpty(ls)) continue;
                    var lsWeekPpm  = new Dictionary<string, double>();
                    var lsMonthPpm = new Dictionary<string, double>();
                    foreach (var col in WeeklyReportWeekCols)
                        lsWeekPpm[col.Key] = LsTotalPpm(ls, col.Key);
                    foreach (var col in WeeklyReportMonthCols)
                        lsMonthPpm[col.Key] = LsTotalPpm(ls, col.Key);
                    double lsBv = LsTotalPpm(ls, BaselineMonthKey);
                    rows.Add(new WeeklyReportRow(
                        RowId: "LS::" + ownRowId + "::" + ls,
                        ParentId: ownRowId,
                        Display: ls,
                        RowKind: WeeklyRowKindShiftGroup,
                        Depth: lsDepth,
                        IsLineShift: true,
                        Baseline: lsBv > 0 ? lsBv : (double?)null,
                        Target: null, AchievementPct: null,
                        WeekPpm: lsWeekPpm, MonthPpm: lsMonthPpm));
                }
            }
        }

        int childDepth = string.IsNullOrEmpty(nodeName) ? depth : depth + 1;
        foreach (var child in sub.SubGroups)
            EmitSubRows(groupName, material, child, path, childDepth, thisRowId, rows);
    }

    /// <summary>PPM for a single LineShift, read from <c>_reportByModel</c>.</summary>
    private double LsTotalPpm(string lineShift, string colKey)
        => _hierLookup.Ls(lineShift, colKey);

