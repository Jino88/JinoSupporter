    public async Task GenerateReportAsync(
        DateTime startDate,
        DateTime endDate,
        IReadOnlyCollection<string> selectedGroupNames,
        IProgress<string>? progress = null,
        HierReports? sharedHierarchy = null)
    {
        _startDate = startDate.Date;
        _endDate = endDate.Date;
        ReloadGroups();
        _selectedGroupNames = selectedGroupNames
            .Where(name => _groups.Any(g => string.Equals(g.Name, name, StringComparison.Ordinal)))
            .ToHashSet(StringComparer.Ordinal);

        _externalProgress = progress;
        try
        {
            await CalculateWithServiceAsync(sharedHierarchy, progress);
            if (_report is null)
                throw new InvalidOperationException(string.IsNullOrWhiteSpace(_reportError)
                    ? "Weekly report did not produce results."
                    : _reportError);
        }
        finally
        {
            _externalProgress = null;
        }
    }

    private async Task CalculateWithServiceAsync(HierReports? sharedHierarchy, IProgress<string>? progress)
    {
        List<ModelGroupRecord> selectedGroups = _groups
            .Where(group => _selectedGroupNames.Contains(group.Name))
            .ToList();
        var request = BmesReportRequest.Create(
            _startDate,
            _endDate,
            selectedGroups,
            _weeklyFormSettings);
        BmesDailyCalculationSnapshot daily;
        if (sharedHierarchy?.ByGroup is not null)
        {
            daily = new BmesDailyCalculationSnapshot
            {
                Hierarchy = sharedHierarchy,
                TrendByMid = sharedHierarchy.ByGroup,
                Tab = new(),
                SourceDbPath = sharedHierarchy.ByGroup.DbPath,
            };
        }
        else
        {
            daily = await DailyCalculation.CalculateAsync(request, progress, CancellationToken.None);
        }

        BmesWeeklyCalculationSnapshot weekly = await WeeklyCalculation.CalculateAsync(
            request,
            daily,
            _weeklyFormSettings,
            progress,
            CancellationToken.None);
        ApplyCalculationSnapshot(weekly, selectedGroups);
    }

    private void ApplyCalculationSnapshot(
        BmesWeeklyCalculationSnapshot snapshot,
        IReadOnlyList<ModelGroupRecord> selectedGroups)
    {
        _groupOverride = selectedGroups.ToList();
        _groups = selectedGroups.ToList();
        _selectedGroupNames = selectedGroups.Select(group => group.Name).ToHashSet(StringComparer.Ordinal);
        _savedDbPath = snapshot.Hierarchy.ByGroup?.DbPath;
        _report = snapshot.Hierarchy.ByGroup;
        _reportByMid = snapshot.Hierarchy.ByMid;
        _reportByModel = snapshot.Hierarchy.ByLs;
        _reportBySubGroup = snapshot.Hierarchy.BySub1;
        _reportBySubLeaf = snapshot.Hierarchy.BySub2;
        _hierLookup = HierPpmLookup.From(snapshot.Hierarchy);
        _lsNgReport = snapshot.LineShiftDetails;
        _midNgReport = snapshot.MidDetails;
        _pendingChartRender = true;
    }

    private async Task UseSharedHierarchyReportAsync(
        HierReports sharedHierarchy,
        IProgress<string>? progress)
    {
        if (_isReportBusy || _isBusy || _selectedGroupNames.Count == 0) return;

        _isReportBusy     = true;
        _isBusy           = true;
        _reportError      = string.Empty;
        _errorMessage     = string.Empty;
        _savedDbPath      = null;
        _report           = null;
        _reportByMid      = null;
        _reportByModel    = null;
        _reportBySubGroup = null;
        _reportBySubLeaf  = null;
        _lsNgReport       = null;
        _midNgReport      = null;
        _hierLookup       = new();
        _logs.Clear();
        StateHasChanged();

        try
        {
            string dbPath = sharedHierarchy.ByGroup?.DbPath ?? string.Empty;
            if (string.IsNullOrWhiteSpace(dbPath) || !File.Exists(dbPath))
            {
                _reportError = "Shared NG Rate DB was not found.";
                return;
            }

            progress?.Report($"Reusing Daily hierarchy report: {Path.GetFileName(dbPath)}");
            _savedDbPath      = dbPath;
            _report           = sharedHierarchy.ByGroup;
            _reportByMid      = sharedHierarchy.ByMid;
            _reportByModel    = sharedHierarchy.ByLs;
            _reportBySubGroup = sharedHierarchy.BySub1;
            _reportBySubLeaf  = sharedHierarchy.BySub2;
            _hierLookup       = HierPpmLookup.From(sharedHierarchy);

            var selectedGroups = NgRateModeSupport.SelectGroupsByName(_groups, _selectedGroupNames);
            var mappings = NgRateModeSupport.BuildGroupMappings(selectedGroups);
            if (!mappings.HasData)
            {
                _reportError = "No LineShift found in the selected groups.";
                return;
            }

            _lsNgReport = await NgRateReportSvc.ComputeLineShiftNgDetailsAsync(
                dbPath, mappings.LineShiftList, progress, _startDate, _endDate);
            _midNgReport = await NgRateReportSvc.ComputeGroupedNgDetailsAsync(
                dbPath, mappings.MidMapping, progress, _startDate, _endDate);
            _pendingChartRender = true;
        }
        catch (Exception ex)
        {
            _reportError = $"Error: {ex.Message}";
        }
        finally
        {
            _isBusy = false;
            _isReportBusy = false;
            StateHasChanged();
        }
    }

