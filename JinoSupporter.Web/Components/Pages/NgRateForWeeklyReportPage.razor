    private static string FormatPpm(double v)
        => NgRateModeSupport.FormatPpm(v);

    private static string FormatPpmOrBlank(double v)
        => v <= 0 ? string.Empty : FormatPpm(v);

    private static string ReportGroupDisplayName(string groupName)
    {
        if (string.IsNullOrWhiteSpace(groupName)) return string.Empty;

        int idx = groupName.IndexOf('_', StringComparison.Ordinal);
        return idx >= 0 && idx + 1 < groupName.Length
            ? groupName[(idx + 1)..]
            : groupName;
    }

    private MarkupString FormatModelSummaryPpm(double current, double? prev)
        => _showWeeklyModelSummaryDelta
            ? FormatPpmWithDelta(current, prev)
            : new MarkupString(System.Net.WebUtility.HtmlEncode(FormatPpmOrBlank(current)));

    private static double? PreviousNonZeroPpm(
        IReadOnlyList<NgRateReportService.PeriodColumn> columns,
        int currentIndex,
        Func<NgRateReportService.PeriodColumn, double> valueOf)
    {
        for (int i = currentIndex + 1; i < columns.Count; i++)
        {
            double value = valueOf(columns[i]);
            if (value > 0) return value;
        }
        return null;
    }

    private void AddLog(string message)
    {
        _logs.Add($"[{DateTime.Now:HH:mm:ss}] {message}");
        _externalProgress?.Report(message);
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Renders a PPM cell content with a "+/-delta" tail vs the previous period.
    /// Positive/negative signs and up/down markers carry direction; color is only
    /// a secondary cue. Skipped when prev is null (oldest period) or both values
    /// are zero. Used on Mid-Group rows in the For Weekly Report view.
    /// </summary>
    private static MarkupString FormatPpmWithDelta(double current, double? prev)
    {
        if (current <= 0)
            return new MarkupString(string.Empty);

        string main = FormatPpm(current);
        if (!prev.HasValue || prev.Value <= 0)
            return new MarkupString(System.Net.WebUtility.HtmlEncode(main));

        double delta = current - prev.Value;
        if (Math.Abs(delta) < 0.5)
            return new MarkupString(System.Net.WebUtility.HtmlEncode(main));

        long absRounded = (long)Math.Round(Math.Abs(delta));
        string sign       = delta > 0 ? "+" : "-";
        string deltaClass = delta > 0 ? "ppm-delta-up" : "ppm-delta-down";
        string deltaStr   = $"{sign}{absRounded:N0}";

        return new MarkupString(
            $"<span class=\"ppm-cell-value\">{System.Net.WebUtility.HtmlEncode(main)}</span>" +
            $"<span class=\"ppm-delta {deltaClass}\">" +
            System.Net.WebUtility.HtmlEncode(deltaStr) +
            "</span>");
    }

