    private async Task GetReportLegacyAsync()
    {
        if (_isReportBusy || _isBusy || _selectedGroupNames.Count == 0) return;
        if (_endDate < _startDate)
        {
            _reportError = "End date must be on or after start date.";
            return;
        }
        if (!NgRateSettings.IsCredentialsConfigured)
        {
            _reportError = "BMES credentials are not configured.";
            return;
        }

        _isReportBusy     = true;
        _isBusy           = true;
        _reportError      = string.Empty;
        _errorMessage     = string.Empty;
        _savedDbPath      = null;
        _report           = null;
        _reportByMid      = null;
        _reportByModel    = null;
        _reportBySubGroup = null;
        _reportBySubLeaf  = null;
        _lsNgReport       = null;
        _midNgReport      = null;
        _hierLookup       = new();
        _logs.Clear();
        Activity.Log("NG Rate Weekly", $"Get Data {_startDate:yyyy-MM-dd} ~ {_endDate:yyyy-MM-dd}");
        StateHasChanged();

        IProgress<string> progress = new Progress<string>(AddLog);

        try
        {
            progress.Report($"Fetching data: {_startDate:yyyy-MM-dd} ~ {_endDate:yyyy-MM-dd}");
            string? dbPath = await NgRate.GetOrFetchAsync(_startDate, _endDate, progress);
            _isBusy = false;

            if (string.IsNullOrEmpty(dbPath))
            {
                _errorMessage = "Data fetch or save failed - check the log.";
                _reportError  = _errorMessage;
                return;
            }

            _savedDbPath = dbPath;
            ReloadGroups();
            Activity.Log("NG Rate Weekly", $"Generate Report selectedGroups={_selectedGroupNames.Count:N0}");
            progress.Report($"Using DB: {Path.GetFileName(dbPath)}");

            var mapping        = new Dictionary<string, string>(StringComparer.Ordinal); // LS ???洹몃９
            var midMapping     = new Dictionary<string, string>(StringComparer.Ordinal); // LS ??以묎렇猷?(Material)
            var subMapping     = new Dictionary<string, string>(StringComparer.Ordinal); // LS ??top-level SubGroup (Sub1) ??subtree aggregate
            var subLeafMapping = new Dictionary<string, string>(StringComparer.Ordinal); // LS ??leaf SubGroup path  ??Sub2+ per-node bucket
            var modelMapping   = new Dictionary<string, string>(StringComparer.Ordinal); // LS ??LS (per-LS pseudo-group)
            var groupList    = new List<string>();
            var midList      = new List<string>();
            var subList      = new List<string>();
            var subLeafList  = new List<string>();
            var modelList    = new List<string>();
            var selectedGroups = NgRateModeSupport.SelectGroupsByName(_groups, _selectedGroupNames);
            var commonMappings = NgRateModeSupport.BuildGroupMappings(selectedGroups);
            mapping        = commonMappings.GroupMapping;
            midMapping     = commonMappings.MidMapping;
            subMapping     = commonMappings.Sub1Mapping;
            subLeafMapping = commonMappings.Sub2Mapping;
            modelMapping   = commonMappings.LineShiftMapping;
            groupList      = commonMappings.GroupList;
            midList        = commonMappings.MidList;
            subList        = commonMappings.Sub1List;
            subLeafList    = commonMappings.Sub2List;
            modelList      = commonMappings.LineShiftList;
            foreach (var g in selectedGroups)
            {
                groupList.Add(g.Name);
                foreach (var mid in g.MidGroups)
                {
                    string matKey = $"{g.Name}::{mid.Material}"; // namespace by ?洹몃９ to avoid clashes
                    if (!midList.Contains(matKey)) midList.Add(matKey);

                    // For each top-level SubGroup, collect every descendant LineShift under one
                    // sub-key (Sub1 row). Then walk the tree recursively to build per-leaf-path
                    foreach (var sub in mid.SubGroups)
                    {
                        string subKey = ModelGroupPickerHelpers.SubGroupKeyOf(g.Name, mid.Material, sub);
                        if (!subList.Contains(subKey)) subList.Add(subKey);
                        foreach (var ls in sub.AllLineShifts)
                        {
                            if (string.IsNullOrEmpty(ls)) continue;
                            subMapping[ls] = subKey;
                        }

                        ModelGroupPickerHelpers.BuildSubLeafMapping(
                            g.Name, mid.Material, sub, parentPath: string.Empty,
                            subLeafMapping, subLeafList);
                    }

                    foreach (var ls in mid.LineShifts)
                    {
                        if (string.IsNullOrEmpty(ls)) continue;
                        mapping[ls]      = g.Name;
                        midMapping[ls]   = matKey;
                        modelMapping[ls] = ls;
                        if (!modelList.Contains(ls)) modelList.Add(ls);
                    }
                }
            }
            mapping        = commonMappings.GroupMapping;
            midMapping     = commonMappings.MidMapping;
            subMapping     = commonMappings.Sub1Mapping;
            subLeafMapping = commonMappings.Sub2Mapping;
            modelMapping   = commonMappings.LineShiftMapping;
            groupList      = commonMappings.GroupList;
            midList        = commonMappings.MidList;
            subList        = commonMappings.Sub1List;
            subLeafList    = commonMappings.Sub2List;
            modelList      = commonMappings.LineShiftList;

            if (mapping.Count == 0)
            {
                _reportError = "No LineShift found in the selected groups.";
                return;
            }

            _report           = await NgRateReportSvc.GenerateReportAsync(dbPath, mapping,      groupList, progress, _startDate, _endDate);
            _reportByMid      = await NgRateReportSvc.GenerateSummaryReportAsync(dbPath, midMapping,   midList,   progress, _startDate, _endDate, weightedGroupSummary: true);
            _reportByModel    = await NgRateReportSvc.GenerateSummaryReportAsync(dbPath, modelMapping, modelList, progress, _startDate, _endDate, weightedGroupSummary: true);
            _reportBySubGroup = subList.Count > 0
                ? await NgRateReportSvc.GenerateSummaryReportAsync(dbPath, subMapping, subList, progress, _startDate, _endDate, weightedGroupSummary: true)
                : null;
            _reportBySubLeaf = subLeafList.Count > 0
                ? await NgRateReportSvc.GenerateSummaryReportAsync(dbPath, subLeafMapping, subLeafList, progress, _startDate, _endDate, weightedGroupSummary: true)
                : null;
            _lsNgReport    = await NgRateReportSvc.ComputeLineShiftNgDetailsAsync(dbPath, modelList, progress, _startDate, _endDate);
            _midNgReport   = await NgRateReportSvc.ComputeGroupedNgDetailsAsync(dbPath, midMapping, progress, _startDate, _endDate);
            _hierLookup = new HierPpmLookup
            {
                ByGroup = _report,
                ByMid = _reportByMid,
                BySub1 = _reportBySubGroup,
                BySub2 = _reportBySubLeaf,
                ByLs = _reportByModel,
            };
            _pendingChartRender = true;
        }
        catch (Exception ex)
        {
            _reportError = $"Error: {ex.Message}";
        }
        finally
        {
            _isBusy = false;
            _isReportBusy = false;
            StateHasChanged();
        }
    }

    private async Task ExportCsvAsync()
    {
        if (_isExporting) return;

        _isExporting = true;
        _reportError = string.Empty;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        try
        {
            var reports = BuildExcelReports();
            if (reports.Count == 0) return;

            Activity.Log("NG Rate Weekly", $"Export CSV reports={reports.Count:N0}");
            var details = BuildExcelDetailReports();
            byte[] bytes = await Task.Run(() => NgRateCsvExporter.ExportReports(reports, details, includeDateColumns: false));
            string name = $"NgRate_WeeklyReport_{DateTime.Now:yyyyMMdd_HHmmss}.csv";
            await BrowserDownload.DownloadBytesAsync(JS, name, bytes, CsvExportUtility.ContentType);
        }
        catch (Exception ex)
        {
            _reportError = $"Export failed: {ex.Message}";
        }
        finally
        {
            _isExporting = false;
            StateHasChanged();
        }
    }

    private async Task ExportWeeklyModelSummaryCsvAsync()
    {
        if (_isExporting) return;

        _isExporting = true;
        _reportError = string.Empty;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        try
        {
            var export = BuildWeeklyModelSummaryExport();
