    /// <summary>True iff every ancestor of <paramref name="row"/> is expanded.
    /// Mid rows (no parent) are always visible.</summary>
    private bool IsWrRowVisible(WeeklyReportRow row, IReadOnlyDictionary<string, WeeklyReportRow> byId)
    {
        if (ExportMode) return true;

        string? pid = row.ParentId;
        while (pid is not null)
