    private NgRateExcelExporter.WeeklyModelSummaryExport? BuildWeeklyModelSummaryExport()
    {
        if (_report is null || _reportByMid is null || _selectedGroupNames.Count == 0)
            return null;

        var weekCols = _report.WeekCols.ToList();
        var monthCols = _report.MonthCols.ToList();
        if (weekCols.Count == 0 && monthCols.Count == 0)
            return null;

        var rows = new List<NgRateExcelExporter.WeeklyModelSummaryRow>();

        Dictionary<string, double> Values(
            IReadOnlyList<NgRateReportService.PeriodColumn> cols,
            Func<string, double> getter)
            => cols.ToDictionary(c => c.Key, c => getter(c.Key), StringComparer.Ordinal);

        rows.Add(new NgRateExcelExporter.WeeklyModelSummaryRow(
            Label: "TOTAL",
            Level: "Total",
            Depth: 0,
            IsTotal: true,
            WeekPpm: Values(weekCols, MeanOfGroups),
            MonthPpm: Values(monthCols, MeanOfGroups)));

        foreach (var gName in _selectedGroupNames)
        {
            var grpVm = _groups.FirstOrDefault(g => g.Name == gName);
            if (grpVm is null) continue;

            rows.Add(new NgRateExcelExporter.WeeklyModelSummaryRow(
                Label: gName,
                Level: "Group",
                Depth: 0,
                IsTotal: false,
                WeekPpm: Values(weekCols, key => MeanOfMembers(gName, key, null)),
                MonthPpm: Values(monthCols, key => MeanOfMembers(gName, key, null))));

            foreach (var mid in grpVm.MidGroups.Where(mid =>
                         !string.IsNullOrEmpty(mid.Material) && mid.LineShifts.Count > 0))
            {
                string displayMode = WeeklyDisplayModeOf(gName, mid.Material);
                bool useBGroup = displayMode == WeeklyDisplayModeBGroup
                    && _reportBySubGroup is not null
                    && MidHasNamedBGroups(mid);

                if (!useBGroup)
                {
                    if (!MidHasWeeklyModelSummaryData(gName, mid, weekCols, monthCols))
                        continue;

                    rows.Add(new NgRateExcelExporter.WeeklyModelSummaryRow(
                        Label: mid.Material,
                        Level: "Group",
                        Depth: 1,
                        IsTotal: false,
                        WeekPpm: Values(weekCols, key => MidPpmAvgOfSubs(gName, mid, key)),
                        MonthPpm: Values(monthCols, key => MidPpmAvgOfSubs(gName, mid, key))));
                    continue;
                }

                foreach (var sub in mid.SubGroups)
                {
                    if (string.IsNullOrWhiteSpace(sub.Name) || !sub.AllLineShifts.Any())
                        continue;

                    string subKey = ModelGroupPickerHelpers.SubGroupKeyOf(gName, mid.Material, sub);
                    if (!BGrHasWeeklyModelSummaryData(subKey, weekCols, monthCols))
                        continue;

                    rows.Add(new NgRateExcelExporter.WeeklyModelSummaryRow(
                        Label: sub.Name,
                        Level: "Sub Group",
                        Depth: 1,
                        IsTotal: false,
                        WeekPpm: Values(weekCols, key => SubGroupTotalPpm(subKey, key)),
                        MonthPpm: Values(monthCols, key => SubGroupTotalPpm(subKey, key))));
                }
            }
        }

        return new NgRateExcelExporter.WeeklyModelSummaryExport(
            Title: "Summary - Group / Sub Group x Week / Month (PPM)",
            WeekColumns: weekCols,
            MonthColumns: monthCols,
            Rows: rows,
            IncludeDelta: _showWeeklyModelSummaryDelta);
    }

    private bool BGrHasWeeklyModelSummaryData(
        string bGrKey,
        IReadOnlyList<NgRateReportService.PeriodColumn> weekCols,
        IReadOnlyList<NgRateReportService.PeriodColumn> monthCols)
    {
        foreach (var col in weekCols) if (SubGroupTotalPpm(bGrKey, col.Key) > 0) return true;
        foreach (var col in monthCols) if (SubGroupTotalPpm(bGrKey, col.Key) > 0) return true;
        return false;
    }

    private bool MidHasWeeklyModelSummaryData(
        string groupName,
        MidGroupRecord mid,
        IReadOnlyList<NgRateReportService.PeriodColumn> weekCols,
        IReadOnlyList<NgRateReportService.PeriodColumn> monthCols)
    {
        if (mid.LineShifts.Count == 0 || string.IsNullOrEmpty(mid.Material)) return false;
        foreach (var col in weekCols) if (MidPpmAvgOfSubs(groupName, mid, col.Key) > 0) return true;
        foreach (var col in monthCols) if (MidPpmAvgOfSubs(groupName, mid, col.Key) > 0) return true;
        return false;
    }

    private List<(string Label, NgRateReportService.NgRateReport Report)> BuildExcelReports()
    {
        var reports = new List<(string Label, NgRateReportService.NgRateReport Report)>();
        if (_report is not null)           reports.Add(("Weekly - Group", _report));
        if (_reportByMid is not null)      reports.Add(("Weekly - Model", _reportByMid));
        if (_reportByModel is not null)    reports.Add(("Weekly - Shift", _reportByModel));
        if (_reportBySubGroup is not null) reports.Add(("Weekly - Sub Group", _reportBySubGroup));
        if (_reportBySubLeaf is not null)  reports.Add(("Weekly - Shift Group", _reportBySubLeaf));
        return reports;
    }

    private List<(string Label, NgRateReportService.LineShiftNgReport Report)> BuildExcelDetailReports()
    {
        var reports = new List<(string Label, NgRateReportService.LineShiftNgReport Report)>();
        if (_midNgReport is not null) reports.Add(("Weekly Detail - Model", _midNgReport));
        if (_lsNgReport is not null)  reports.Add(("Weekly Detail - Shift", _lsNgReport));
        return reports;
    }

    /// <summary>
    /// Labels and per-group series for the two group-trend charts, or null when there is
    /// nothing to plot. Shared by the interactive path (JS interop after render) and the
    /// static-export path (an inert JSON payload the exported page reads on tab open).
    /// </summary>
    private (string[] Labels, object[] Series)? BuildGroupTrendChartData()
    {
        if (_report is null || _reportByModel is null || _selectedGroupNames.Count == 0)
            return null;

        // Build combined period list — keep service's DESC order (newest → oldest) per block.
        // Each entry: (label, keyOrNull). Null key = separator position.
        var periodCells = new List<(string Label, string? Key)>();
        if (VisibleDateCols.Count > 0)
            periodCells.AddRange(VisibleDateCols.Select(c => (c.Header, (string?)c.Key)));
        if (VisibleWeekCols.Count > 0)
        {
            if (periodCells.Count > 0) periodCells.Add(("", null));
            periodCells.AddRange(VisibleWeekCols.Select(c => (c.Header, (string?)c.Key)));
        }
        if (VisibleMonthCols.Count > 0)
        {
            if (periodCells.Count > 0) periodCells.Add(("", null));
            periodCells.AddRange(VisibleMonthCols.Select(c => (c.Header, (string?)c.Key)));
        }

        if (periodCells.Count == 0) return null;

        var labels = periodCells.Select(p => p.Label).ToArray();
        var series = _selectedGroupNames.Select(object (g) => new
        {
            name   = ReportGroupDisplayName(g),
            values = periodCells.Select(p =>
            {
                if (p.Key is null) return (double?)null; // separator
                double v = MeanOfMembers(g, p.Key, null);
                return v > 0 ? (double?)v : null;
            }).ToArray(),
        }).ToArray();

        return (labels, series);
    }

    /// <summary>
    /// Period block sizes for the static export's viewer toolbar. Every table here lays its
    /// period columns out as date → week → month at the right edge of each row, so the
    /// viewer locates them by counting back from the end once it knows these counts.
    /// </summary>
    private MarkupString ExportPeriodMeta()
    {
        if (!ExportMode) return default;
        string json = System.Text.Json.JsonSerializer.Serialize(new
        {
            date  = VisibleDateCols.Count,
            week  = VisibleWeekCols.Count,
            month = VisibleMonthCols.Count,
        });
        return new MarkupString($"<script type=\"application/json\" data-periods>{json}</script>");
    }

    /// <summary>
    /// Inert chart payload for the static export: the exported page has no Blazor circuit,
    /// so its tab-switch script reads these on tab open and calls
    /// <c>ngRateGroupChart.render</c> itself. Nothing is emitted outside export mode, or
    /// when there is no chart to draw.
    ///
    /// Written as raw markup because a <c>&lt;script&gt;</c> body is raw text — HTML-encoded
    /// quotes would never be decoded and <c>JSON.parse</c> would fail. That is safe here:
    /// System.Text.Json's default encoder escapes <c>&lt;</c> and <c>&gt;</c>, so no group
    /// name can close the script tag early.
    /// </summary>
    private MarkupString ExportChartPayload(string canvasId)
    {
        if (!ExportMode || BuildGroupTrendChartData() is not { } data)
            return default;

        string json = System.Text.Json.JsonSerializer.Serialize(
            new { canvasId, labels = data.Labels, series = data.Series });
        return new MarkupString($"<script type=\"application/json\" data-chart>{json}</script>");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingChartRender && BuildGroupTrendChartData() is { } data)
        {
            _pendingChartRender = false;
            try
            {
                await JS.InvokeVoidAsync("ngRateGroupChart.render", CanvasId,      data.Labels, data.Series);
                await JS.InvokeVoidAsync("ngRateGroupChart.render", CanvasIdModel, data.Labels, data.Series);
            }
            catch { }
        }
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("ngRateGroupChart.destroy", CanvasId); }      catch { }
        try { await JS.InvokeVoidAsync("ngRateGroupChart.destroy", CanvasIdModel); } catch { }
    }

