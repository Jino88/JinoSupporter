@page "/login"
@layout EmptyLayout
@using JinoSupporter.Web.Components.Layout

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] public string? Error     { get; set; }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login — JinoSupporter</title>
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <style>
        /* This page uses EmptyLayout, so instrument.scoped.css never loads and the
           design tokens are undefined here. Loading the whole system would put
           .ins .btn up against Bootstrap's .btn-primary on the one control that
           has to work, so the few tokens this page needs are mirrored instead.
           Values must stay in step with ui-redesign/assets/instrument.css. */
        :root {
            --plane: #e8eaee;
            --panel: #ffffff;
            --line:  #dde1e7;
            --ink:   #0f1319;
            --ink-2: #4a5461;
        }

        /* 100vh is correct here: this screen owns the viewport, unlike the pages
           that open inside the shell and have to use var(--view-h). */
        html, body { height: 100%; background: var(--plane); }
        .login-wrap {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .login-card {
            background: var(--panel);
            border: 1px solid var(--line);
            border-radius: 2px;
            padding: 40px 44px;
            width: 360px;
        }
        .login-logo {
            font-size: 22px;
            font-weight: 800;
            color: var(--ink);
            letter-spacing: -0.5px;
            margin-bottom: 4px;
        }
        .login-sub { font-size: 13px; color: var(--ink-2); margin-bottom: 28px; }
    </style>
</head>
<body>
<div class="login-wrap">
    <div class="login-card">
        <div class="login-logo">GN LAB Supporter</div>
        <div class="login-sub">Sign in to continue</div>

        @if (Error == "1")
        {
            <div class="alert alert-danger py-2 mb-3 small">Incorrect username or password.</div>
        }

        <form method="post" action="/auth/login">
            <input type="hidden" name="returnUrl" value="@(ReturnUrl ?? "/")" />

            <div class="mb-3">
                <label class="form-label">Username</label>
                <input name="username" class="form-control" autocomplete="username" autofocus required />
            </div>
            <div class="mb-4">
                <label class="form-label">Password</label>
                <input name="password" type="password" class="form-control" autocomplete="current-password" required />
            </div>
            <button type="submit" class="btn btn-primary w-100">Sign in</button>
        </form>
    </div>
</div>
</body>
</html>
