    private static string PrepareAskHtmlReport(string? html)
    {
        string text = html ?? "";
        if (text.Contains("jino-ask-ai-report-css", StringComparison.OrdinalIgnoreCase))
            return text;

        string css = string.Join(Environment.NewLine, new[]
        {
            "<" + "style id=\"jino-ask-ai-report-css\">",
            "html, body { margin: 0; padding: 10px; color: #0f172a; background: #f8fafc; font-family: \"Malgun Gothic\", \"Segoe UI\", Arial, sans-serif; font-size: 12px; line-height: 1.45; }",
            "* { box-sizing: border-box; }",
            "h1 { margin: 0 0 10px; font-size: 18px; line-height: 1.25; }",
            "h2 { margin: 18px 0 8px; font-size: 15px; line-height: 1.3; }",
            "h3 { margin: 14px 0 6px; font-size: 13px; line-height: 1.3; }",
            "p { margin: 4px 0 8px; }",
            "table { width: 100%; min-width: 1120px; border-collapse: collapse; table-layout: auto; background: #fff; font-size: 11px; }",
            "th, td { border: 1px solid #cbd5e1; padding: 6px 7px; text-align: left !important; vertical-align: top !important; white-space: normal !important; word-break: keep-all; overflow-wrap: break-word; }",
            "th { background: #e2e8f0; color: #1e293b; font-weight: 700; }",
            "td { color: #0f172a; }",
            "a[href^=\"/microspeaker/source-file/\"] { display: inline-block; white-space: nowrap; font-weight: 700; color: #1d4ed8; text-decoration: none; }",
            "a[href^=\"/microspeaker/source-file/\"]:hover { text-decoration: underline; }",
            ".num, .rate, .pct, td[data-type=\"number\"] { text-align: right !important; font-variant-numeric: tabular-nums; white-space: nowrap !important; }",
            ".limit, .judgement { max-width: 180px; }",
            "svg { max-width: 100%; }",
            "</" + "style>",
        });

        int headClose = text.IndexOf("</head>", StringComparison.OrdinalIgnoreCase);
        if (headClose >= 0)
            return text.Insert(headClose, css);

        int bodyOpenEnd = text.IndexOf("<body", StringComparison.OrdinalIgnoreCase);
        if (bodyOpenEnd >= 0)
        {
            int bodyTagEnd = text.IndexOf('>', bodyOpenEnd);
            if (bodyTagEnd >= 0)
                return text.Insert(bodyTagEnd + 1, css);
        }

        return css + text;
    }

    private static bool IsMarkdownTableSeparator(string row)
        => SplitMarkdownTableRow(row).All(cell =>
            cell.Length > 0 && cell.All(ch => ch == '-' || ch == ':' || char.IsWhiteSpace(ch)));

    private static Microsoft.AspNetCore.Components.MarkupString RenderMarkdown(string? markdown)
    {
        static string Enc(string? value)
            => System.Net.WebUtility.HtmlEncode(AskAiCleanExcelSerialDateText(value ?? ""));

        static string Inline(string? value)
        {
            string text = Enc(value);
            text = System.Text.RegularExpressions.Regex.Replace(text, @"\*\*(.+?)\*\*", "<strong>$1</strong>");
            text = System.Text.RegularExpressions.Regex.Replace(text, @"`(.+?)`", "<code>$1</code>");
            return text;
        }

        static bool IsTableLine(string line) => line.Trim().StartsWith("|", StringComparison.Ordinal)
                                             && line.Trim().EndsWith("|", StringComparison.Ordinal);

        static bool IsSeparator(string line)
        {
            string t = line.Trim().Trim('|').Replace(" ", "");
            return t.Length > 0 && t.All(ch => ch == '-' || ch == ':' || ch == '|');
        }

        static List<string> Cells(string line)
            => line.Trim().Trim('|').Split('|').Select(x => x.Trim()).ToList();

        static bool IsLocationColumn(string header)
        {
            string text = (header ?? "").Trim();
            string lower = text.ToLowerInvariant();
            return lower is "cell" or "cells" or "source cell" or "source cells"
                   || lower.Contains("evidence location")
                   || lower.Contains("worksheet/cell")
                   || lower.Contains("sheet/cell")
                   || (lower.Contains("source") && lower.Contains("cell"))
                   || text.Contains("근거 위치")
                   || text.Contains("출처")
                   || text.Contains("셀");
        }

        var lines = (markdown ?? "").Replace("\r\n", "\n").Replace('\r', '\n').Split('\n');
        var sb = new System.Text.StringBuilder();
        bool inList = false;

        void CloseList()
        {
            if (!inList) return;
            sb.Append("</ul>");
            inList = false;
        }

        for (int i = 0; i < lines.Length; i++)
        {
            string line = lines[i].TrimEnd();
            string trim = line.Trim();
            if (string.IsNullOrWhiteSpace(trim))
            {
                CloseList();
                continue;
            }

            if (trim.StartsWith("```", StringComparison.Ordinal))
            {
                CloseList();
                string kind = trim.Length > 3 ? trim[3..].Trim() : "";
                var block = new System.Text.StringBuilder();
                i++;
                while (i < lines.Length && !lines[i].Trim().StartsWith("```", StringComparison.Ordinal))
                {
                    block.AppendLine(lines[i]);
                    i++;
                }

                string visual = AskMarkdownVisualHtml(kind, block.ToString());
                if (!string.IsNullOrWhiteSpace(visual))
                    sb.Append(visual);
                else
                    sb.Append("<pre><code>").Append(Enc(block.ToString())).Append("</code></pre>");
                continue;
            }

            if (IsTableLine(trim) && i + 1 < lines.Length && IsSeparator(lines[i + 1]))
            {
                CloseList();
                var headers = Cells(trim);
                var visibleIndexes = headers
                    .Select((header, index) => new { header, index })
                    .Where(x => !IsLocationColumn(x.header))
                    .Select(x => x.index)
                    .ToList();
                if (visibleIndexes.Count == 0) visibleIndexes = Enumerable.Range(0, headers.Count).ToList();

                i += 2;
                sb.Append("<table><thead><tr>");
                foreach (int idx in visibleIndexes) sb.Append("<th>").Append(Inline(headers[idx])).Append("</th>");
                sb.Append("</tr></thead><tbody>");
                while (i < lines.Length && IsTableLine(lines[i]))
                {
                    var rowCells = Cells(lines[i]);
                    sb.Append("<tr>");
                    foreach (int idx in visibleIndexes)
                    {
                        string cell = idx < rowCells.Count ? rowCells[idx] : "";
                        sb.Append("<td>").Append(Inline(cell)).Append("</td>");
                    }
                    sb.Append("</tr>");
                    i++;
                }
                i--;
                sb.Append("</tbody></table>");
                continue;
            }

            int heading = trim.TakeWhile(ch => ch == '#').Count();
            if (heading is >= 1 and <= 4 && trim.Length > heading && trim[heading] == ' ')
            {
                CloseList();
                string tag = heading <= 2 ? "h2" : "h3";
                sb.Append('<').Append(tag).Append('>')
                  .Append(Inline(trim[(heading + 1)..].Trim()))
                  .Append("</").Append(tag).Append('>');
                continue;
            }

            if (trim.StartsWith("- ", StringComparison.Ordinal))
            {
                if (!inList)
                {
                    sb.Append("<ul>");
                    inList = true;
                }
                sb.Append("<li>").Append(Inline(trim[2..].Trim())).Append("</li>");
                continue;
            }

            CloseList();
            sb.Append("<p>").Append(Inline(trim)).Append("</p>");
        }
        CloseList();
        return new Microsoft.AspNetCore.Components.MarkupString(sb.ToString());
    }

    private static string AskMarkdownVisualHtml(string kind, string json)
    {
        static string Enc(string? value)
            => System.Net.WebUtility.HtmlEncode(AskAiCleanExcelSerialDateText(value ?? ""));

        static string HeatClass(string? status)
        {
            string s = (status ?? "").Trim().ToLowerInvariant();
            if (s is "bad" or "worse" or "fail" or "failed" or "ng" or "high") return "diask-ai-heat-worse";
            if (s is "good" or "improved" or "pass" or "passed" or "ok" or "low") return "diask-ai-heat-improved";
            return "diask-ai-heat-flat";
        }

        static string BarClass(string? status)
        {
            string s = (status ?? "").Trim().ToLowerInvariant();
            if (s is "bad" or "worse" or "fail" or "failed" or "ng" or "high") return "diask-ai-bar-danger";
            if (s is "good" or "improved" or "pass" or "passed" or "ok" or "low") return "diask-ai-bar-good";
            return "diask-ai-bar-warn";
        }

        static double NumberValue(AskMarkdownVisualItem item)
        {
            if (item.Amount.HasValue) return Math.Abs(item.Amount.Value);
            var m = System.Text.RegularExpressions.Regex.Match(item.Value ?? "", @"-?\d+(?:\.\d+)?");
            return m.Success && double.TryParse(m.Value, System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture, out double v)
                ? Math.Abs(v)
                : 1.0;
        }

        string normalizedKind = (kind ?? "").Trim().ToLowerInvariant();
        if (normalizedKind is not ("report-heatmap" or "report-bars" or "report-heatmap-matrix"))
            return "";

        if (normalizedKind == "report-heatmap-matrix"
            || (normalizedKind == "report-heatmap" && LooksLikeMatrixJson(json)))
        {
            string matrix = RenderAskHeatMatrix(json);
            if (!string.IsNullOrEmpty(matrix)) return matrix;
        }

        try
        {
            var items = System.Text.Json.JsonSerializer.Deserialize<List<AskMarkdownVisualItem>>(
                json,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? [];
            items = items
                .Where(x => !string.IsNullOrWhiteSpace(x.Label) || !string.IsNullOrWhiteSpace(x.Value))
                .Take(12)
                .ToList();
            if (items.Count == 0) return "";

            var sb = new System.Text.StringBuilder();
            if (normalizedKind == "report-heatmap")
            {
                sb.Append("<div class=\"diask-ai-md-visual\"><div class=\"diask-ai-heatmap\">");
                foreach (var item in items)
                {
                    sb.Append("<div class=\"diask-ai-heat ").Append(HeatClass(item.Status)).Append("\" title=\"")
                      .Append(Enc(item.Detail)).Append("\"><strong>")
                      .Append(Enc(item.Value)).Append("</strong><span>")
                      .Append(Enc(item.Label)).Append("</span><em>")
                      .Append(Enc(item.Detail)).Append("</em></div>");
                }
                sb.Append("</div></div>");
                return sb.ToString();
            }

            double max = Math.Max(1.0, items.Select(NumberValue).DefaultIfEmpty(0).Max());
            sb.Append("<div class=\"diask-ai-md-visual diask-ai-md-bars diask-ai-vbar-chart\">");
            foreach (var item in items)
            {
                double value = NumberValue(item);
                double height = value <= 0
                    ? 0
                    : Math.Clamp(value / max * 100.0, 5.0, 100.0);
                sb.Append("<div class=\"diask-ai-vbar-item\" title=\"")
                  .Append(Enc(item.Detail)).Append("\"><div class=\"diask-ai-vbar-value\">")
                  .Append(Enc(item.Value)).Append("</div><div class=\"diask-ai-vbar-plot\"><div class=\"diask-ai-vbar ")
                  .Append(BarClass(item.Status)).Append("\" style=\"height:")
                  .Append(height.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))
                  .Append("%\"></div></div><div class=\"diask-ai-vbar-label\">")
                  .Append(Enc(item.Label)).Append("</div><div class=\"diask-ai-vbar-detail\">")
                  .Append(Enc(item.Detail)).Append("</div></div>");
            }
            sb.Append("</div>");
            return sb.ToString();
        }
        catch
        {
            return "";
        }
    }

    private static bool LooksLikeMatrixJson(string json)
    {
        if (string.IsNullOrWhiteSpace(json)) return false;
        string head = json.TrimStart();
        if (head.Length == 0 || head[0] != '{') return false;
        return head.Contains("\"rows\"", StringComparison.OrdinalIgnoreCase)
            && head.Contains("\"columns\"", StringComparison.OrdinalIgnoreCase);
    }

    private static string RenderAskHeatMatrix(string json)
    {
        static string Enc(string? value)
            => System.Net.WebUtility.HtmlEncode(AskAiCleanExcelSerialDateText(value ?? ""));

        static string HeatClass(string? status)
        {
            string s = (status ?? "").Trim().ToLowerInvariant();
            if (s is "bad" or "worse" or "fail" or "failed" or "ng" or "high") return "diask-ai-heat-worse";
            if (s is "good" or "improved" or "pass" or "passed" or "ok" or "low") return "diask-ai-heat-improved";
            return "diask-ai-heat-flat";
        }

        try
        {
            var matrix = System.Text.Json.JsonSerializer.Deserialize<AskMarkdownHeatMatrix>(
                json,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (matrix is null || matrix.Rows.Count == 0 || matrix.Columns.Count == 0)
                return "";

            int colCount = matrix.Columns.Count;
            var sb = new System.Text.StringBuilder();
            sb.Append("<div class=\"diask-ai-md-visual\"><table class=\"diask-ai-heat-matrix\"><thead><tr><th class=\"diask-ai-heat-rowhead\"></th>");
            foreach (string col in matrix.Columns)
                sb.Append("<th>").Append(Enc(col)).Append("</th>");
            sb.Append("</tr></thead><tbody>");
            foreach (var row in matrix.Rows)
            {
                sb.Append("<tr><th class=\"diask-ai-heat-rowhead\">").Append(Enc(row.Label)).Append("</th>");
                for (int c = 0; c < colCount; c++)
                {
                    var cell = c < row.Cells.Count ? row.Cells[c] : null;
                    string cls = HeatClass(cell?.Status);
                    string title = Enc(cell?.Detail ?? "");
                    sb.Append("<td class=\"diask-ai-heat-cell ").Append(cls)
                      .Append("\" title=\"").Append(title).Append("\">");
                    sb.Append("<strong>").Append(Enc(cell?.Value ?? "")).Append("</strong>");
                    if (!string.IsNullOrWhiteSpace(cell?.Count))
                        sb.Append("<em>").Append(Enc(cell!.Count)).Append("</em>");
                    sb.Append("</td>");
                }
                sb.Append("</tr>");
            }
            sb.Append("</tbody></table></div>");
            return sb.ToString();
        }
        catch
        {
            return "";
        }
    }

    private static List<string> SplitMarkdownTableRow(string row)
        => row.Trim().Trim('|').Split('|').Select(x => x.Trim()).ToList();

    public async ValueTask DisposeAsync()
    {
        try { _cliCts?.Cancel(); _cliCts?.Dispose(); } catch { }
        try { await JS.InvokeVoidAsync("diFullPage.leave"); } catch { }
    }
