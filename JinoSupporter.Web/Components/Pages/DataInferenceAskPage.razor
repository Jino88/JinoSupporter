@page "/data-inference/ask"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject WebRepository Repo
@inject ClaudeService  Claude
@inject AiProviderSettingsService AiProviders
@inject MicroSpeakerAskEvidenceService MicroSpeakerEvidence
@inject IJSRuntime     JS

<PageTitle>Data Inference — Ask AI</PageTitle>

<div class="diask-root">

@if (!AiProviders.CodexCliEnabled)
{
    <div class="alert alert-warning mb-0 py-2 small" style="flex-shrink:0; margin:8px 14px 0;">
        <strong>Codex CLI is disabled.</strong> Turn it on in Setting before using Ask AI.
    </div>
}

<!-- ── Header ──────────────────────────────────────────────────────────────── -->
<div class="diask-header">
    <span class="diask-title">💬 Ask AI</span>
    <span class="diask-count">@_reports.Count registered dataset(s)</span>
    <div style="flex:1;"></div>
    <label class="diask-filter-label">Product Type</label>
    <select class="form-select form-select-sm diask-filter-select"
            value="@_productTypeFilter"
            @onchange="OnProductTypeFilterChanged">
        <option value="">All</option>
        @foreach (var pt in _productTypeOptions)
        {
            <option value="@pt">@pt</option>
        }
    </select>
    <span class="diask-count-right">In scope: @FilteredReports.Count item(s)</span>
    <button class="btn btn-outline-secondary btn-sm" @onclick="ToggleHistory" disabled="@_isBusy">
        @(_showHistory ? "✕ History" : "🗂 History")
    </button>
</div>

<CurrentProblemWorkflowStrip ContextLabel="Ask AI" />

<div class="diask-main">

<!-- ── Main column ─────────────────────────────────────────────────────────── -->
<div class="diask-main-col">

<!-- Question area -->
<div class="diask-question-wrap">
    <label class="diask-label">Question</label>
    <textarea class="form-control diask-question" rows="4"
              @bind="_question"
              @bind:event="oninput"
              placeholder="e.g. BRS-161016 frequently has SPL NG — how should we improve this?"></textarea>
    <div class="diask-actions">
        @if (!string.IsNullOrEmpty(_status))
        {
            <span class="diask-status @(_statusError ? "diask-error" : "diask-ok")">@_status</span>
        }
        <div style="flex:1;"></div>
        <label class="diask-lang-label">Answer in</label>
        <select class="form-select form-select-sm diask-lang-select"
                @bind="_answerLanguage" disabled="@_isBusy">
            <option value="English">English</option>
            <option value="Korean">Korean</option>
            <option value="Vietnamese">Vietnamese</option>
        </select>
        <button class="btn btn-outline-secondary btn-sm" @onclick="Clear" disabled="@_isBusy">Clear</button>
        <button class="btn btn-primary btn-sm" @onclick="AskAsync"
                disabled="@(_isBusy || string.IsNullOrWhiteSpace(_question) || !AiProviders.CodexCliEnabled || FilteredReports.Count == 0)">
            @if (_isBusy && !_isWaitingCli) { <span class="spinner-border spinner-border-sm me-1"></span> }
            Ask AI
        </button>
        @if (_isWaitingCli)
        {
            <button class="btn btn-outline-danger btn-sm" @onclick="CancelCliWait"
                    title="Stop polling for CLI result. The CLI terminal keeps running; reopen History to load manually.">
                ✕ Cancel wait
            </button>
        }
    </div>
</div>

<!-- Answer area -->
<div class="diask-answer-wrap">
    @if (_isBusy)
    {
        <div class="diask-placeholder">
            <div class="spinner-border spinner-border-sm me-2"></div>
            Analyzing relevant content from registered reports…
        </div>
    }
    else if (_selectedReview is not null)
    {
        <div class="diask-review-view">
            <div class="diask-review-head">
                <div>
                    <div class="diask-review-title">@DisplayReviewTitle(_selectedReview)</div>
                    <div class="diask-review-sub">@_selectedReview.DatasetName</div>
                </div>
                <a class="btn btn-outline-secondary btn-sm"
                   href="@DetailUrl(_selectedReview.DatasetName)" target="_blank" rel="noopener">
                    Detail
                </a>
            </div>
            <div class="diask-review-meta">
                @if (!string.IsNullOrWhiteSpace(_selectedReview.ProductType)) { <span>@_selectedReview.ProductType</span> }
                @if (!string.IsNullOrWhiteSpace(_selectedReview.ReportDate)) { <span>@_selectedReview.ReportDate</span> }
                @if (!string.IsNullOrWhiteSpace(_selectedReview.ReportType)) { <span>@_selectedReview.ReportType</span> }
                @if (!string.IsNullOrWhiteSpace(_selectedReview.PrimaryDefect)) { <span>@_selectedReview.PrimaryDefect</span> }
                <span>@($"{_selectedReview.ResultCount:N0}") result(s)</span>
                <span>@FormatDate(_selectedReview.AiUpdatedAt)</span>
            </div>
            <article class="diask-md">
                @RenderMarkdown(_selectedReview.GeneratedReportMarkdown)
            </article>
        </div>
    }
    else if (_answer is null)
    {
        <div class="diask-placeholder">
            Enter a question and click <strong>Ask AI</strong> to get an answer based on all reports registered so far.
        </div>
    }
    else
    {
        var displayAnswer = DisplayAnswer;
        <div class="diask-answer-toolbar">
            <div class="btn-group btn-group-sm">
                <button class="btn @AnswerLangButtonClassKo" @onclick="SetAnswerViewKo">한국어</button>
                <button class="btn @AnswerLangButtonClassEn" @onclick="SetAnswerViewEn">English</button>
                <button class="btn @AnswerLangButtonClassVi" @onclick="SetAnswerViewVi">Tiếng Việt</button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(displayAnswer.Overall))
        {
            @if (IsAskHtmlReport(displayAnswer.Overall))
            {
                string overallHtml = PrepareAskHtmlReport(displayAnswer.Overall);
                <div class="diask-html-panel">
                    <div class="diask-html-tools">
                        @if (_activeHistoryId.HasValue)
                        {
                            <a class="btn btn-outline-primary btn-sm"
                               href="@AskHistoryHtmlUrl(_activeHistoryId.Value)"
                               target="_blank"
                               rel="noopener">
                                새 창으로 보기
                            </a>
                        }
                    </div>
                    <div class="diask-html-wrap">
                        <iframe class="diask-html-frame"
                                title="Ask AI HTML report"
                                sandbox="allow-scripts allow-popups allow-forms allow-downloads"
                                srcdoc="@overallHtml"></iframe>
                    </div>
                </div>
            }
            else
            {
                var actionRows = ParseOverallActionRows(displayAnswer.Overall);
                <div class="diask-answer-card diask-overall">
                    <div class="diask-answer-title">@AskUi("Review Checklist")</div>
                    @if (actionRows.Count > 0)
                    {
                        <div class="diask-action-note">
                            @AskUi("What to check first, based on saved AI review records and previous dataset answers.")
                        </div>
                        <table class="diask-action-table">
                            <thead>
                                <tr>
                                    <th>@AskUi("No")</th>
                                    <th>@AskUi("Check item / factor")</th>
                                    <th>@AskUi("Review count")</th>
                                    <th>@AskUi("Previous result")</th>
                                    <th>@AskUi("Overall judgement")</th>
                                    <th>@AskUi("Next action")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in actionRows)
                                {
                                    <tr>
                                        <td>@row.No</td>
                                        <td class="diask-action-main">@row.CheckItem</td>
                                        <td>@row.ReviewCount</td>
                                        <td>@row.PreviousResult</td>
                                        <td>@row.OverallJudgement</td>
                                        <td>@row.NextAction</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="diask-answer-body diask-markdown">@RenderMarkdown(displayAnswer.Overall)</div>
                    }
                </div>
            }
        }

        @if (displayAnswer.PerDataset.Count > 0)
        {
            <div class="diask-perds-headline">
                <span>@AskUi("Evidence datasets") (@displayAnswer.PerDataset.Count)</span>
                <button class="btn btn-outline-secondary btn-sm py-0 px-2"
                        @onclick="() => _showDatasetEvidence = !_showDatasetEvidence">
                    @(_showDatasetEvidence ? AskUi("Hide") : AskUi("Show"))
                </button>
            </div>
            @if (_showDatasetEvidence)
            {
            @foreach (var pd in displayAnswer.PerDataset)
            {
                string datasetName = ResolveDatasetName(pd.DatasetName);
                var info = _reports.FirstOrDefault(r =>
                    string.Equals(r.DatasetName, datasetName, StringComparison.OrdinalIgnoreCase));
                <div class="diask-ds-card">
                    <div class="diask-ds-head">
                        <a class="diask-ds-link"
                           href="@DetailUrl(datasetName)" target="_blank" rel="noopener">
                            @datasetName
                        </a>
                        @if (info is not null)
                        {
                            <span class="diask-ds-meta">
                                @(string.IsNullOrEmpty(info.ProductType) ? "—" : info.ProductType)
                                · @info.ReportDate
                                · @info.MeasurementCount row(s)
                            </span>
                        }
                        else
                        {
                            <span class="diask-ds-meta diask-ds-missing">(deleted or name mismatch)</span>
                        }
                    </div>
                    @if (IsAskHtmlReport(pd.Answer))
                    {
                        string datasetHtml = PrepareAskHtmlReport(pd.Answer);
                        <div class="diask-ds-html-wrap">
                            <iframe class="diask-html-frame diask-ds-html-frame"
                                    title="@($"Ask AI dataset report - {datasetName}")"
                                    sandbox="allow-scripts allow-popups allow-forms allow-downloads"
                                    srcdoc="@datasetHtml"></iframe>
                        </div>
                    }
                    else
                    {
                        <div class="diask-ds-body diask-markdown">@RenderMarkdown(pd.Answer)</div>
                    }
                </div>
            }
            }
        }
        else if (string.IsNullOrWhiteSpace(displayAnswer.Overall))
        {
            <div class="diask-empty-note">Could not generate an answer — no matching reports found.</div>
        }
    }
</div>

</div>

<!-- ── History panel (right side) ─────────────────────────────────────────── -->
@if (_showHistory)
{
    <div class="diask-history-col">
        <div class="diask-history-head">
            <span>🗂 Q/A History (@_history.Count)</span>
            <button class="btn btn-outline-danger btn-sm py-0 px-2"
                    @onclick="ConfirmClearHistory"
                    disabled="@(_history.Count == 0 || _isBusy)">Clear all</button>
        </div>
        @if (_history.Count == 0)
        {
            <div class="diask-history-empty">No saved history.</div>
        }
        else
        {
            <div class="diask-history-list">
                @foreach (var h in _history)
                {
                    bool isActive = _activeHistoryId == h.Id;
                    <div class="diask-history-item @(isActive ? "active" : "")"
                         @onclick="() => LoadHistory(h.Id)">
                        <div class="diask-history-q">@Truncate(h.Question, 80)</div>
                        <div class="diask-history-meta">
                            @FormatDate(h.CreatedAt)
                            @if (!string.IsNullOrEmpty(h.ProductTypeFilter))
                            {
                                <text> · @h.ProductTypeFilter</text>
                            }
                        </div>
                        <button class="diask-history-del"
                                title="Delete"
                                @onclick="() => DeleteHistory(h.Id)"
                                @onclick:stopPropagation="true">✕</button>
                    </div>
                }
            </div>
        }
        <div class="diask-review-section-head">
            <span>AI Review Records (@_reviewRecords.Count)</span>
            <button class="btn btn-outline-secondary btn-sm py-0 px-2"
                    @onclick="ReloadReviewRecords"
                    disabled="@_isBusy">Refresh</button>
        </div>
        @if (_reviewRecords.Count == 0)
        {
            <div class="diask-history-empty">No saved AI review records.</div>
        }
        else
        {
            <div class="diask-review-list">
                @foreach (var r in _reviewRecords)
                {
                    bool isActive = _selectedReview?.DocumentId == r.DocumentId;
                    <div class="diask-history-item @(isActive ? "active" : "")"
                         @onclick="() => LoadReviewRecord(r)">
                        <div class="diask-history-q">@Truncate(DisplayReviewTitle(r), 92)</div>
                        <div class="diask-history-meta">
                            @if (!string.IsNullOrWhiteSpace(r.ProductType))
                            {
                                <span>@r.ProductType</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(r.ReportDate))
                            {
                                <span> · @r.ReportDate</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(r.PrimaryDefect))
                            {
                                <span> · @r.PrimaryDefect</span>
                            }
                        </div>
                        <div class="diask-history-meta">@Truncate(r.DatasetName, 96)</div>
                    </div>
                }
            </div>
        }
    </div>
}

</div>

@if (_showClearConfirm)
{
    <div class="diask-overlay" @onclick="() => _showClearConfirm = false">
        <div class="diask-confirm" @onclick:stopPropagation="true">
            <div class="diask-confirm-title">Clear All History</div>
            <p style="font-size:13px;">All saved Q/A history will be deleted. Continue?</p>
            <div style="display:flex; gap:8px; justify-content:flex-end;">
                <button class="btn btn-outline-secondary btn-sm"
                        @onclick="() => _showClearConfirm = false">Cancel</button>
                <button class="btn btn-danger btn-sm" @onclick="ClearAllHistory">Clear all</button>
            </div>
        </div>
    </div>
}

</div>

<style>
    .diask-root {
        flex: 1; min-height: 0; display: flex; flex-direction: column;
        overflow: hidden; background: var(--panel-2, #f5f6f9);
    }
    .diask-header {
        display: flex; align-items: center; gap: 10px; padding: 10px 14px;
        background: var(--panel, #fff); border-bottom: 1px solid var(--line, var(--line, #dde1e7)); flex-shrink: 0;
    }
    .diask-title       { font-size: 15px; font-weight: 700; color: var(--ink, #0f1319); }
    .diask-count       { font-size: 12px; color: var(--ink-3, #7f8a98); }
    .diask-count-right { font-size: 12px; color: var(--ink-2, #4a5461); font-weight: 600; }
    .diask-filter-label  { font-size: 12px; font-weight: 600; color: var(--ink-2, #4a5461); white-space: nowrap; }
    .diask-filter-select { width: 160px; }
    .diask-lang-label    { font-size: 12px; font-weight: 600; color: var(--ink-2, #4a5461); white-space: nowrap; margin-bottom: 0; }
    .diask-lang-select   { width: 130px; }

    .diask-main {
        flex: 1; min-height: 0; display: flex; overflow: hidden;
    }
    .diask-main-col {
        flex: 1; min-width: 0; display: flex; flex-direction: column; overflow: hidden;
    }

    .diask-question-wrap {
        padding: 12px 14px; background: var(--panel, #fff); border-bottom: 1px solid var(--line, var(--line, #dde1e7));
        flex-shrink: 0;
    }
    .diask-label    { font-size: 12px; font-weight: 600; color: var(--ink-2, #4a5461); display: block; margin-bottom: 4px; }
    .diask-question { font-size: 13px; resize: vertical; }
    .diask-actions  { display: flex; align-items: center; gap: 8px; margin-top: 8px; }
    .diask-status   { font-size: 12px; }
    .diask-ok       { color: var(--ok, #1f5fa8); }
    .diask-error    { color: var(--crit, #c8342a); }

    .diask-answer-wrap {
        flex: 1; min-height: 0; overflow-y: auto; padding: 14px;
    }
    .diask-placeholder {
        display: flex; align-items: center; justify-content: center;
        padding: 60px 20px; color: var(--ink-3, #7f8a98); font-size: 13px; text-align: center;
    }
    .diask-answer-card {
        background: var(--panel, #fff); border: 1px solid var(--line, var(--line, #dde1e7)); border-radius: 2px;
        padding: 14px 16px; margin-bottom: 12px;
    }
    .diask-answer-toolbar {
        display: flex; align-items: center; gap: 8px; justify-content: flex-end;
        margin: 0 0 8px;
    }
    .diask-translating { font-size: 12px; color: var(--ink-2, #4a5461); display: inline-flex; align-items: center; }
    .diask-overall { border-left: 4px solid #3b82f6; background: var(--panel-2, #f5f6f9); }
    .diask-answer-title {
        font-size: 13px; font-weight: 700; color: var(--ink, #0f1319); margin-bottom: 8px;
    }
    .diask-html-panel {
        display: flex; flex-direction: column; gap: 6px; margin-bottom: 12px;
    }
    .diask-html-tools {
        display: flex; justify-content: flex-end; align-items: center; gap: 8px;
    }
    /* 201px is this page's own chrome above the frame (header 43 + question 92 +
       toolbars 66), measured in the shell. The old 235px also covered the classic
       shell's 34px tab strip, which --view-h now accounts for.
       min-height stays: below ~880px of viewport the report is deliberately
       taller than the pane and the answer column scrolls. */
    .diask-html-wrap {
        min-height: 680px; height: calc(var(--view-h, 100vh) - 201px);
        background: var(--panel, #fff); border: 1px solid var(--line-2, #c6ccd5); border-radius: 2px;
        overflow: hidden;
    }
    .diask-html-frame {
        display: block; width: 100%; height: 100%; min-height: 680px;
        border: 0; background: var(--panel, #fff);
    }
    .diask-ds-html-wrap {
        height: 620px; min-height: 420px;
        background: var(--panel, #fff);
    }
    .diask-ds-html-frame {
        min-height: 420px;
    }
    .diask-answer-body {
        font-size: 13px; color: var(--ink, #0f1319); line-height: 1.65;
    }
    .diask-action-note {
        color: var(--ink-2, #4a5461); font-size: 12px; margin-bottom: 8px;
    }
    .diask-action-table {
        width: 100%; border-collapse: collapse; table-layout: fixed;
        background: var(--panel, #fff); font-size: 12px;
    }
    .diask-action-table th, .diask-action-table td {
        border: 1px solid var(--line-2, #c6ccd5); padding: 7px 8px; vertical-align: top;
        overflow-wrap: anywhere;
    }
    .diask-action-table th {
        background: var(--line, var(--line, #dde1e7)); color: var(--ink, #0f1319); font-weight: 700;
    }
    .diask-action-table th:nth-child(1), .diask-action-table td:nth-child(1) { width: 44px; text-align: center; }
    .diask-action-table th:nth-child(2), .diask-action-table td:nth-child(2) { width: 20%; }
    .diask-action-table th:nth-child(3), .diask-action-table td:nth-child(3) { width: 12%; }
    .diask-action-main { font-weight: 700; color: var(--ink, #0f1319); }
    .diask-perds-title {
        font-size: 12px; font-weight: 700; color: var(--ink-2, #4a5461); margin: 6px 2px 8px; letter-spacing: .3px;
    }
    .diask-perds-headline {
        display: flex; align-items: center; justify-content: space-between; gap: 8px;
        margin: 6px 2px 8px; color: var(--ink-2, #4a5461); font-size: 12px; font-weight: 700;
    }
    .diask-ds-card {
        background: var(--panel, #fff); border: 1px solid var(--line, var(--line, #dde1e7)); border-radius: 2px;
        margin-bottom: 8px; overflow: hidden;
    }
    .diask-ds-head {
        display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap;
        padding: 8px 14px; background: #f0f9ff; border-bottom: 1px solid #bae6fd;
    }
    .diask-ds-link {
        font-size: 13px; font-weight: 700; color: #1d4ed8; text-decoration: none;
    }
    .diask-ds-link:hover { text-decoration: underline; color: #1e3a8a; }
    .diask-ds-meta    { font-size: 11px; color: var(--ink-2, #4a5461); }
    .diask-ds-missing { color: var(--warn-ink, #92610a); font-style: italic; }
    .diask-ds-body    { padding: 10px 14px; font-size: 13px; color: var(--ink, #0f1319); line-height: 1.6; }
    .diask-markdown p { margin: 0 0 8px; }
    .diask-markdown ul { margin: 0 0 10px 18px; padding: 0; }
    .diask-markdown table {
        width: 100%; border-collapse: collapse; margin: 8px 0 12px;
        font-size: 12px; background: var(--panel, #fff);
    }
    .diask-markdown th, .diask-markdown td {
        border: 1px solid var(--line-2, #c6ccd5); padding: 6px 8px; vertical-align: top;
    }
    .diask-markdown th { background: var(--line, var(--line, #dde1e7)); color: var(--ink, #0f1319); font-weight: 700; }
    .diask-markdown code {
        background: var(--panel-3, #eceef2); border: 1px solid var(--line, var(--line, #dde1e7)); border-radius: 2px;
        padding: 1px 4px; font-size: 12px;
    }
    .diask-empty-note {
        background: var(--warn-wash, #fdf4e0); border: 1px solid var(--warn-line, #f0cf8a); color: #78350f;
        padding: 10px 14px; border-radius: 2px; font-size: 12px;
    }
    .diask-review-view {
        background: var(--panel, #fff); border: 1px solid var(--line, var(--line, #dde1e7)); border-radius: 2px;
        overflow: hidden;
    }
    .diask-review-head {
        display: flex; align-items: center; justify-content: space-between; gap: 12px;
        padding: 12px 14px; background: var(--panel-2, #f5f6f9); border-bottom: 1px solid var(--line, var(--line, #dde1e7));
    }
    .diask-review-title { font-size: 15px; font-weight: 700; color: var(--ink, #0f1319); }
    .diask-review-sub { font-size: 11px; color: var(--ink-2, #4a5461); margin-top: 2px; }
    .diask-review-meta {
        display: flex; flex-wrap: wrap; gap: 6px; padding: 8px 14px;
        border-bottom: 1px solid var(--line, var(--line, #dde1e7)); background: var(--panel, #fff);
    }
    .diask-review-meta span {
        font-size: 11px; color: var(--ink-2, #4a5461); background: var(--panel-3, #eceef2);
        border: 1px solid var(--line, var(--line, #dde1e7)); border-radius: 2px; padding: 2px 7px;
    }
    .diask-md { padding: 14px 16px; font-size: 13px; color: var(--ink, #0f1319); line-height: 1.6; }
    .diask-md h2 { font-size: 16px; margin: 14px 0 8px; font-weight: 800; color: var(--ink, #0f1319); }
    .diask-md h3 { font-size: 14px; margin: 12px 0 6px; font-weight: 700; color: var(--ink, #0f1319); }
    .diask-md p { margin: 0 0 8px; }
    .diask-md ul { margin: 0 0 10px 18px; padding: 0; }
    .diask-md table {
        width: 100%; border-collapse: collapse; margin: 10px 0 14px;
        font-size: 12px; table-layout: auto;
    }
    .diask-md th, .diask-md td {
        border: 1px solid var(--line, var(--line, #dde1e7)); padding: 6px 8px; vertical-align: top;
    }
    .diask-md th { background: var(--panel-2, #f5f6f9); font-weight: 700; color: var(--ink-2, #4a5461); }
    .diask-md code {
        background: var(--panel-3, #eceef2); border: 1px solid var(--line, var(--line, #dde1e7)); border-radius: 2px;
        padding: 1px 4px; font-size: 12px;
    }
    .diask-md pre,
    .diask-markdown pre {
        margin: 8px 0 12px; padding: 9px 10px; overflow-x: auto;
        background: #f3f6f9; border: 1px solid var(--line, #dde1e7); border-radius: 2px;
        font-size: 12px;
    }
    .diask-ai-md-visual {
        margin: 10px 0 12px;
    }
    .diask-ai-md-bars {
