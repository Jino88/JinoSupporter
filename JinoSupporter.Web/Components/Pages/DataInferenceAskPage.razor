    private string ResolveDatasetName(string raw)
    {
        string text = (raw ?? "").Trim();
        int marker = text.IndexOf("Dataset:", StringComparison.OrdinalIgnoreCase);
        if (marker >= 0) text = text[(marker + "Dataset:".Length)..].Trim();

        if (text.StartsWith("[", StringComparison.Ordinal))
        {
            int close = text.IndexOf(']');
            if (close >= 0 && close + 1 < text.Length) text = text[(close + 1)..].Trim();
        }

        string? exact = _reports
            .Select(r => r.DatasetName)
            .FirstOrDefault(n => string.Equals(n, text, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(exact)) return exact;

        string? suffix = _reports
            .Select(r => r.DatasetName)
            .FirstOrDefault(n => text.EndsWith(n, StringComparison.OrdinalIgnoreCase));
        return string.IsNullOrWhiteSpace(suffix) ? text : suffix;
    }

    private static string DisplayReviewTitle(ModelAnalysisReportRecord r)
    {
        if (!string.IsNullOrWhiteSpace(r.Title)) return r.Title;
        if (!string.IsNullOrWhiteSpace(r.PrimaryDefect)) return r.PrimaryDefect;
        return r.DatasetName;
    }

    private static string Truncate(string s, int len)
        => (s?.Length ?? 0) <= len ? (s ?? "") : s![..len] + "…";

    private static string FormatDate(string iso)
    {
        if (DateTime.TryParse(iso, null, System.Globalization.DateTimeStyles.RoundtripKind, out DateTime dt))
            return dt.ToLocalTime().ToString("yyyy-MM-dd HH:mm");
        return iso;
    }

    private sealed record AskActionRow(
        string No,
        string CheckItem,
        string ReviewCount,
        string PreviousResult,
        string OverallJudgement,
        string NextAction);

    private static List<AskActionRow> ParseOverallActionRows(string? markdown)
    {
        string[] lines = (markdown ?? "").Replace("\r\n", "\n").Replace('\r', '\n').Split('\n');
        for (int i = 0; i < lines.Length - 1; i++)
        {
            string headerLine = lines[i].Trim();
            string separator = lines[i + 1].Trim();
            if (!headerLine.StartsWith('|') || !headerLine.EndsWith('|')) continue;
            if (!separator.StartsWith('|') || !separator.Contains("---", StringComparison.Ordinal)) continue;

            var parsed = new List<AskActionRow>();
            for (int j = i + 2; j < lines.Length; j++)
            {
                string row = lines[j].Trim();
                if (!row.StartsWith('|') || !row.EndsWith('|')) break;
                if (IsMarkdownTableSeparator(row)) continue;

                List<string> cells = SplitMarkdownTableRow(row);
                while (cells.Count < 6) cells.Add("");
                if (string.IsNullOrWhiteSpace(cells[1]) && string.IsNullOrWhiteSpace(cells[3])) continue;

                parsed.Add(new AskActionRow(
                    cells[0],
                    cells[1],
                    cells[2],
                    cells[3],
                    cells[4],
                    cells[5]));
            }

            if (parsed.Count > 0) return parsed;
        }

        return [];
    }

    private static bool IsMarkdownTableSeparator(string row)
        => SplitMarkdownTableRow(row).All(cell =>
            cell.Length > 0 && cell.All(ch => ch == '-' || ch == ':' || char.IsWhiteSpace(ch)));

    private static Microsoft.AspNetCore.Components.MarkupString RenderMarkdown(string? markdown)
    {
        string text = (markdown ?? "").Replace("\r\n", "\n").Replace('\r', '\n');
        var lines = text.Split('\n');
        var sb = new System.Text.StringBuilder();
        bool inList = false;

        static string Enc(string value) => System.Net.WebUtility.HtmlEncode(value ?? "");
        static string Inline(string value)
        {
            string html = Enc(value);
            html = System.Text.RegularExpressions.Regex.Replace(html, @"\*\*(.+?)\*\*", "<strong>$1</strong>");
            html = System.Text.RegularExpressions.Regex.Replace(html, @"`([^`]+)`", "<code>$1</code>");
            return html;
        }

        void CloseList()
        {
            if (!inList) return;
            sb.AppendLine("</ul>");
            inList = false;
        }

        for (int i = 0; i < lines.Length; i++)
        {
            string trim = lines[i].Trim();
            if (string.IsNullOrWhiteSpace(trim))
            {
                CloseList();
                continue;
            }

            if (trim.StartsWith('|') && trim.EndsWith('|')
                && i + 1 < lines.Length
                && lines[i + 1].Trim().StartsWith('|')
                && lines[i + 1].Contains("---", StringComparison.Ordinal))
            {
                CloseList();
                var headers = SplitMarkdownTableRow(trim);
                sb.AppendLine("<table><thead><tr>");
                foreach (string h in headers) sb.Append("<th>").Append(Inline(h)).AppendLine("</th>");
                sb.AppendLine("</tr></thead><tbody>");
                i += 2;
                for (; i < lines.Length; i++)
                {
                    string row = lines[i].Trim();
                    if (!row.StartsWith('|') || !row.EndsWith('|')) { i--; break; }
                    sb.AppendLine("<tr>");
                    foreach (string cell in SplitMarkdownTableRow(row)) sb.Append("<td>").Append(Inline(cell)).AppendLine("</td>");
                    sb.AppendLine("</tr>");
                }
                sb.AppendLine("</tbody></table>");
                continue;
            }

            if (trim.StartsWith("### ", StringComparison.Ordinal))
            {
                CloseList();
                sb.Append("<h3>").Append(Inline(trim[4..].Trim())).AppendLine("</h3>");
                continue;
            }
            if (trim.StartsWith("## ", StringComparison.Ordinal))
            {
                CloseList();
                sb.Append("<h2>").Append(Inline(trim[3..].Trim())).AppendLine("</h2>");
                continue;
            }
            if (trim.StartsWith("- ", StringComparison.Ordinal))
            {
                if (!inList)
                {
                    sb.AppendLine("<ul>");
                    inList = true;
                }
                sb.Append("<li>").Append(Inline(trim[2..].Trim())).AppendLine("</li>");
                continue;
            }

            CloseList();
            sb.Append("<p>").Append(Inline(trim)).AppendLine("</p>");
        }
        CloseList();
        return new Microsoft.AspNetCore.Components.MarkupString(sb.ToString());
    }

    private static List<string> SplitMarkdownTableRow(string row)
        => row.Trim().Trim('|').Split('|').Select(x => x.Trim()).ToList();

