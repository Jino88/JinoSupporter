    }
    .diask-review-title { font-size: 15px; font-weight: 700; color: #0f172a; }
    .diask-review-sub { font-size: 11px; color: #64748b; margin-top: 2px; }
    .diask-review-meta {
        display: flex; flex-wrap: wrap; gap: 6px; padding: 8px 14px;
        border-bottom: 1px solid #e2e8f0; background: #fff;
    }
    .diask-review-meta span {
        font-size: 11px; color: #475569; background: #f1f5f9;
        border: 1px solid #e2e8f0; border-radius: 999px; padding: 2px 7px;
    }
    .diask-md { padding: 14px 16px; font-size: 13px; color: #0f172a; line-height: 1.6; }
    .diask-md h2 { font-size: 16px; margin: 14px 0 8px; font-weight: 800; color: #0f172a; }
    .diask-md h3 { font-size: 14px; margin: 12px 0 6px; font-weight: 700; color: #1e293b; }
    .diask-md p { margin: 0 0 8px; }
    .diask-md ul { margin: 0 0 10px 18px; padding: 0; }
