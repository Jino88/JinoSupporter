        display: flex; align-items: center; justify-content: space-between;
        padding: 9px 12px; border-top: 1px solid #e2e8f0; border-bottom: 1px solid #e2e8f0;
        background: #f8fafc; font-size: 12px; font-weight: 700; color: #334155;
    }
    .diask-review-list { max-height: 45%; overflow-y: auto; padding: 6px; border-bottom: 1px solid #e2e8f0; }

    .diask-overlay {
        position: fixed; inset: 0; background: rgba(0,0,0,.35); z-index: 9000;
        display: flex; align-items: center; justify-content: center;
    }
    .diask-confirm {
        background: #fff; border-radius: 10px; padding: 20px 24px;
        box-shadow: 0 10px 40px rgba(0,0,0,.2); min-width: 340px;
    }
    .diask-confirm-title { font-size: 16px; font-weight: 700; color: #1e293b; margin-bottom: 10px; }
</style>

@code {
    private List<RawReportInfo>        _reports           = [];
    private string                     _productTypeFilter = "";
    private string                     _question          = "";
    private string                     _answerLanguage    = "English";
    private ClaudeService.AskAiResult? _answer            = null;
    private Dictionary<string, ClaudeService.AskAiResult> _answerTranslations = new(StringComparer.OrdinalIgnoreCase);
    private string                     _answerViewLang    = "en";
    private bool                       _isTranslatingAnswer;
    private bool                       _isBusy;
    private string                     _status            = "";
    private bool                       _statusError;

    private bool                       _showHistory       = false;
    private bool                       _showDatasetEvidence = false;
    private List<AskAiHistoryRecord>   _history           = [];
    private List<ModelAnalysisReportRecord> _reviewRecords = [];
    private long?                      _activeHistoryId   = null;
    private ModelAnalysisReportRecord? _selectedReview    = null;
    private bool                       _showClearConfirm  = false;

    // CLI flow
    private bool                       _isWaitingCli;
