</AuthorizeView>
    </nav>

    @* User info + logout at bottom *@
    <AuthorizeView>
        <Authorized>
            <div style="padding: 12px 14px; margin-top:auto; border-top:1px solid rgba(255,255,255,.08);">
                <div style="font-size:12px; color:#94a3b8; margin-bottom:2px;">Signed in as</div>
                <div style="font-size:13px; font-weight:600; color:#e2e8f0; margin-bottom:4px;">
                    @context.User.Identity?.Name
                </div>
                <span style="font-size:10px; font-weight:600; padding:2px 7px; border-radius:4px;
                             background:rgba(59,130,246,.25); color:#93c5fd; letter-spacing:.3px;">
                    @context.User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value
                </span>
                <form method="post" action="/auth/logout" style="margin-top:10px;">
                    <button type="submit"
                            style="width:100%; padding:5px 0; font-size:12px; font-weight:500;
                                   border:1px solid rgba(255,255,255,.15); border-radius:6px;
                                   background:transparent; color:#94a3b8; cursor:pointer;
                                   transition:all .15s;">
                        Sign out
                    </button>
                </form>
            </div>
        </Authorized>
    </AuthorizeView>
</div>

@code {
    private bool _bmesOpen;
    private bool _settingModelOpen;
    private bool _diOpen;
    private bool _dailyOpen;

    protected override void OnInitialized()
    {
        _bmesOpen     = IsBmesActive;
        _settingModelOpen = IsSettingModelActive;
        _diOpen       = IsTestDataAnalysisActive;
        _dailyOpen    = IsDailyTestDataActive;
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (IsBmesActive       && !_bmesOpen)     _bmesOpen     = true;
        if (IsSettingModelActive && !_settingModelOpen) _settingModelOpen = true;
        if (IsTestDataAnalysisActive && !_diOpen) _diOpen = true;
        if (IsDailyTestDataActive && !_dailyOpen) _dailyOpen = true;
        InvokeAsync(StateHasChanged);
    }

    private string CurrentRelativePath =>
        Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimEnd('/');

    private bool IsBmesActive =>
        IsBmesReportActive ||
        CurrentRelativePath.StartsWith("ng-rate", StringComparison.OrdinalIgnoreCase) ||
        CurrentRelativePath.StartsWith("bmes/", StringComparison.OrdinalIgnoreCase);

    private bool IsBmesReportActive =>
        CurrentRelativePath.StartsWith("report/bmes", StringComparison.OrdinalIgnoreCase);

    private bool IsSettingModelActive =>
        CurrentRelativePath.StartsWith("bmes/make-model-group", StringComparison.OrdinalIgnoreCase) ||
        CurrentRelativePath.StartsWith("bmes/routing-table", StringComparison.OrdinalIgnoreCase) ||
        CurrentRelativePath.StartsWith("bmes/reason-table", StringComparison.OrdinalIgnoreCase);

    private bool IsLegacyReportActive =>
        string.Equals(CurrentRelativePath, "report", StringComparison.OrdinalIgnoreCase);

    private bool IsTestDataAnalysisActive =>
        Nav.Uri.Contains("/input-data-batch", StringComparison.OrdinalIgnoreCase) ||
        Nav.Uri.Contains("/data-inference", StringComparison.OrdinalIgnoreCase) ||
        IsLegacyReportActive;

    private bool IsDailyTestDataActive =>
        Nav.Uri.Contains("/daily-test-data", StringComparison.OrdinalIgnoreCase);

    private void ToggleBmes()          => _bmesOpen = !_bmesOpen;
    private void ToggleSettingModel()  => _settingModelOpen = !_settingModelOpen;
    private void ToggleTestDataAnalysis() => _diOpen = !_diOpen;
    private void ToggleDailyTestData() => _dailyOpen = !_dailyOpen;

    private async Task OnNavScrollableClick()
    {
        await JS.InvokeVoidAsync("eval", "var t=document.querySelector('.navbar-toggler');if(t&&window.innerWidth<641)t.click();");
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
