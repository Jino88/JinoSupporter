@using JinoSupporter.Web.Services
@inject TeamMemoService Memos
@inject TeamMemoAiSummaryService Summaries

@* History timeline of one team memo: dated entries, each with a comment thread anyone can reply to,
   plus a general discussion thread for the memo itself. Used by the Work Memo page and the board drawer. *@

@if (!string.IsNullOrEmpty(_error))
{
    <div class="tm-alert">@_error <button class="tm-link" @onclick="() => _error = null">dismiss</button></div>
}

@if (ShowHistory)
{
<div class="tm-sechd">
    <b>History <span class="tm-muted tm-small">@Memo.Entries.Count</span></b>
    <span class="tm-small" style="display:flex;gap:10px;align-items:center;">
        <button class="tm-link" @onclick="CollapseAll">Collapse all</button>
        <button class="tm-link" @onclick="ExpandAll">Expand all</button>
        <button class="tm-btn tm-btn-pri" @onclick="StartNewEntry">＋ Add entry</button>
    </span>
</div>

@if (_entryForm is not null && _entryForm.Id is null)
{
    @EntryFormFragment
}

@if (Memo.Entries.Count == 0 && _entryForm is null)
{
    <div class="tm-empty">No history yet. Add the first entry to start the timeline.</div>
}

@foreach (TeamMemoEntry entry in NewestFirst(Memo.Entries))
{
    bool open = !_collapsed.Contains(entry.Id);
    bool late = !entry.IsDone && entry.TargetDate is { } tg && tg < TeamMemoUi.Today;
    <div class="tm-tlrow @(entry.Depth > 0 ? "sub" : "")" @key="entry.Id" style="@(entry.Depth > 0 ? $"margin-left:{Math.Min(entry.Depth, 4) * 22}px" : "")">
        <div class="tm-tldate">@TeamMemoUi.Md(entry.EntryDate)</div>
        <div class="tm-tlrail"><i class="@(entry.IsDone ? "" : "open")"></i></div>
        @if (_entryForm is not null && _entryForm.Id == entry.Id)
        {
            <div style="flex:1;min-width:0;">@EntryFormFragment</div>
        }
        else
        {
            <div class="tm-card">
                <div class="tm-card-top">
                    <span class="tm-caret" style="cursor:pointer;" @onclick="() => Toggle(entry.Id)">@(open ? "▾" : "▸")</span>
                    @if (IsInline(entry, "title"))
                    {
                        <input class="tm-input tm-inline-title" @ref="_inlineRef" @bind="_inlineText" @bind:event="oninput"
                               @onkeydown="e => OnInlineKey(e, entry)" @onblur="() => SaveInline(entry)" />
                    }
                    else
                    {
                        <span class="tm-card-title tm-editable" title="Click to edit the title" @onclick="@(() => StartInline(entry, FTitle))">@(entry.Depth > 0 ? "↳ " : "")@Tr(entry.Title)</span>
                    }
                    @* The schedule (target date) is always shown; click it to change the date. *@
                    @if (IsInline(entry, "target"))
                    {
                        <input class="tm-input tm-inline-date" type="date" @ref="_inlineRef" value="@_inlineText"
                               @onchange="e => SaveTarget(entry, e.Value)" @onblur="CancelInline" @onkeydown="e => OnInlineKey(e, entry)" />
                    }
                    else if (entry.IsDone)
                    {
                        @* WorkHub keeps one date: a done entry's target is its done date. *@
                        <span class="tm-pill tm-pill-done tm-editable" title="Click to change the date" @onclick="@(() => StartInline(entry, FTarget))">Done · @TeamMemoUi.Md(entry.DoneDate)</span>
                    }
                    else if (entry.TargetDate is { } target)
                    {
                        int days = TeamMemoUi.Today.DayNumber - target.DayNumber;
                        <span class="tm-pill tm-editable @(late ? "tm-pill-late" : "tm-pill-todo")" title="Click to change the target date"
                              @onclick="@(() => StartInline(entry, FTarget))">Target @TeamMemoUi.Md(target)@(late ? $" · {days}d late" : "")</span>
                    }
                    else
                    {
                        <span class="tm-pill tm-pill-todo tm-editable" title="Click to set a target date" @onclick="@(() => StartInline(entry, FTarget))">＋ Target</span>
                    }
                    <span class="tm-cm-acts">
                        @if (entry.IsDone)
                        {
                            <button class="tm-btn tm-btn-ghost tm-small" title="Reopen" @onclick="() => SetDone(entry, false)">↺ Reopen</button>
                        }
                        else
                        {
                            <button class="tm-btn tm-btn-ghost tm-small" title="Mark done today" @onclick="() => SetDone(entry, true)">✔ Done</button>
                        }
                        <button class="tm-btn tm-btn-ghost tm-small" title="Change the date or add files" @onclick="() => StartEditEntry(entry)">📎</button>
                        @if (CanDelete(entry.Author))
                        {
                            <button class="tm-btn tm-btn-ghost tm-small tm-btn-danger" @onclick="() => DeleteEntry(entry)">Delete</button>
                        }
                    </span>
                    <span class="tm-card-by">
                        @if (string.IsNullOrWhiteSpace(entry.AiSummary) || !open)
                        {
                            @EntryAiButton(entry, string.IsNullOrWhiteSpace(entry.AiSummary) ? "✨ AI Summary" : "✨ Regenerate")
                        }
                        <TeamMemoAvatar Name="@entry.Author" Size="20" />
                        @if (entry.Attachments.Count > 0) { <span>· 📎 @entry.Attachments.Count</span> }
                        @if (entry.Comments.Count > 0) { <span>· 💬 @entry.Comments.Count</span> }
                        <button class="tm-btn tm-btn-ghost tm-small tm-fold" title="@(open ? "Fold to the title" : "Show the whole entry")"
                                @onclick="() => Toggle(entry.Id)">@(open ? "▴ Fold" : "▾ Open")</button>
                    </span>
                </div>

                @if (open)
                {
                    @if (IsInline(entry, "body"))
                    {
                        <textarea class="tm-input tm-inline-body" rows="@Math.Clamp(_inlineText.Split('\n').Length + 1, 3, 20)" @ref="_inlineRef"
                                  @bind="_inlineText" @bind:event="oninput" placeholder="Detail — Ctrl+Enter saves, Esc cancels"
                                  @onkeydown="e => OnInlineKey(e, entry)" @onblur="() => SaveInline(entry)"></textarea>
                    }
                    else if (!string.IsNullOrWhiteSpace(entry.Body))
                    {
                        <div class="tm-body tm-editable" title="Click to edit" @onclick="@(() => StartInline(entry, FBody))">@Tr(entry.Body)</div>
                    }
                    else
                    {
                        <div class="tm-small tm-muted tm-editable" style="margin-top:6px;" @onclick="@(() => StartInline(entry, FBody))">＋ Add detail</div>
                    }
                    @AttachmentList(entry.Attachments)
                    @EntryAiBlock(entry)
                    <div class="tm-thread">
                        @Thread(entry.Id, entry.Comments)
                    </div>
                }
            </div>
        }
    </div>
}
}

<div class="tm-sechd">
    <b>Discussion <span class="tm-muted tm-small">@Memo.Comments.Count</span></b>
    <span class="tm-small tm-muted">Comments on the memo as a whole</span>
</div>
<div class="tm-card">
    @AttachmentList(Memo.Attachments)
    @Thread("", Memo.Comments)
</div>

@if (_viewer is not null)
{
    <div class="tm-viewer" @onclick="() => _viewer = null">
        <div class="tm-viewer-bar" @onclick:stopPropagation="true">
            <span>@_viewer.FileName · @TeamMemoUi.Size(_viewer.Size) · @Display(_viewer.Author) · @TeamMemoUi.Stamp(_viewer.CreatedAt)</span>
            <a class="tm-btn" href="/team-memo/attachment/@_viewer.Id" target="_blank">Open original</a>
            <a class="tm-btn" href="/team-memo/attachment/@_viewer.Id?download=true">Download</a>
            <button class="tm-btn" @onclick="() => _viewer = null">✕ Close</button>
        </div>
        <img src="/team-memo/attachment/@_viewer.Id" alt="@_viewer.FileName" @onclick:stopPropagation="true" />
    </div>
}

@code {
    [Parameter, EditorRequired] public TeamMemo Memo { get; set; } = default!;
    [Parameter] public string CurrentUser { get; set; } = "";
    [Parameter] public bool IsAdmin { get; set; }
    /// <summary>False for plans: only the discussion thread is shown.</summary>
    [Parameter] public bool ShowHistory { get; set; } = true;
    [Parameter] public Func<string, string>? DisplayName { get; set; }
    /// <summary>Display translation (original text when no language is picked).</summary>
    [Parameter] public Func<string?, string>? Translate { get; set; }

    private string Tr(string? text) => Translate?.Invoke(text) ?? text ?? "";
    /// <summary>Raised after any write so the host reloads the memo.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private const int ShowTailComments = 3;

    private readonly HashSet<string> _collapsed = new(StringComparer.Ordinal);
    private readonly HashSet<string> _showAllComments = new(StringComparer.Ordinal);
    // Keyed by entry id; "" is the memo-level discussion thread.
    private readonly Dictionary<string, string> _drafts = new(StringComparer.Ordinal);
    private readonly Dictionary<string, bool> _draftResult = new(StringComparer.Ordinal);
    private readonly Dictionary<string, List<PendingFile>> _draftFiles = new(StringComparer.Ordinal);
    private readonly Dictionary<string, int> _fileInputKeys = new(StringComparer.Ordinal);

    private EntryForm? _entryForm;
    private TeamMemoAttachment? _viewer;
    // Pending images up to this size are previewed inline as data URLs before they are posted.
    private const int PreviewMaxBytes = 4 * 1024 * 1024;
    private long _editingCommentId;
    private string _editingCommentText = "";
    private string? _error;
    private bool _busy;
    private string _lastMemoId = "";

    private sealed record PendingFile(string Name, string ContentType, byte[] Data);

    private sealed class EntryForm
    {
        /// <summary>Entry being edited, or null for a new one.</summary>
        public string? Id { get; set; }
        public DateOnly Date { get; set; } = TeamMemoUi.Today;
        public string Title { get; set; } = "";
        public string Body { get; set; } = "";
        public DateOnly? Target { get; set; }
        public DateOnly? Done { get; set; }
        public List<PendingFile> Files { get; } = new();
        public int FileKey { get; set; }
    }

    protected override void OnParametersSet()
    {
        if (Memo.Id != _lastMemoId)
        {
            _lastMemoId = Memo.Id;
            _collapsed.Clear();
            _showAllComments.Clear();
            _drafts.Clear();
            _draftResult.Clear();
            _draftFiles.Clear();
            _entryForm = null;
            _editingCommentId = 0;
            // Finished steps with no open discussion start folded so the live ones stand out.
            foreach (TeamMemoEntry e in Memo.Entries)
                if (e.IsDone && e.Attachments.Count == 0 && e.Comments.Count == 0 && string.IsNullOrWhiteSpace(e.Body))
                    _collapsed.Add(e.Id);
        }
    }

    /// <summary>
    /// Display order only (the memo text keeps WorkHub's order): the lead text stays on top, then each
    /// entry with its ↳ sub-entries, newest date first (later in the text first on the same date).
    /// </summary>
    private static IEnumerable<TeamMemoEntry> NewestFirst(IReadOnlyList<TeamMemoEntry> entries)
    {
        var groups = new List<List<TeamMemoEntry>>();
        foreach (TeamMemoEntry e in entries)
        {
            if (e.Depth > 0 && groups.Count > 0 && groups[^1][0].Id != "lead") groups[^1].Add(e);
            else groups.Add([e]);
        }
        return groups.Select((g, i) => (g, i))
            .OrderBy(x => x.g[0].Id == "lead" ? 0 : 1)
            .ThenByDescending(x => x.g[0].EntryDate)
            .ThenByDescending(x => x.i)
            .SelectMany(x => x.g);
    }

    private string Display(string user) => DisplayName?.Invoke(user) ?? user;

    private static string Clip(string s, int n)
    {
        s = (s ?? "").Replace('\n', ' ');
        return s.Length <= n ? s : s[..n] + "…";
    }

    private bool CanDelete(string author) =>
        IsAdmin || string.Equals(author, CurrentUser, StringComparison.OrdinalIgnoreCase);

    private bool CanDeleteAttachment(TeamMemoAttachment a) => CanDelete(a.Author);

    private bool CanMarkResult(TeamMemoComment c) =>
        CanDelete(c.Author) || string.Equals(Memo.Owner, CurrentUser, StringComparison.OrdinalIgnoreCase);

    private void Toggle(string id)
    {
        if (!_collapsed.Remove(id)) _collapsed.Add(id);
    }

    private void CollapseAll() { foreach (var e in Memo.Entries) _collapsed.Add(e.Id); }
    private void ExpandAll() => _collapsed.Clear();

    // ── Thread fragment ────────────────────────────────────────────────────────

    private RenderFragment Thread(string key, List<TeamMemoComment> comments) => __builder =>
    {
        int hidden = _showAllComments.Contains(key) ? 0 : Math.Max(0, comments.Count - ShowTailComments);
        if (hidden > 0)
        {
            <button class="tm-collapsed" @onclick="() => _showAllComments.Add(key)">▸ @hidden earlier comment@(hidden == 1 ? "" : "s")</button>
        }
        foreach (TeamMemoComment c in comments.Skip(hidden))
        {
            <div class="tm-cm @(c.IsResult ? "res" : "")" @key="c.Id">
                <div class="tm-bub">
                    <div class="tm-cm-hd">
                        <TeamMemoAvatar Name="@c.Author" Size="22" />
                        @if (c.IsResult) { <span class="tm-tagres">RESULT</span> }
                        <span class="tm-muted tm-small" title="@c.CreatedAt.ToString("yyyy-MM-dd HH:mm")">@TeamMemoUi.Stamp(c.CreatedAt)@(c.UpdatedAt > c.CreatedAt.AddSeconds(5) ? " · edited" : "")</span>
                        <span class="tm-cm-acts">
                            @if (CanMarkResult(c))
                            {
                                <button class="tm-btn tm-btn-ghost tm-small" @onclick="() => ToggleResult(c)">@(c.IsResult ? "Unmark result" : "Mark as result")</button>
                            }
                            @if (CanDelete(c.Author))
                            {
                                <button class="tm-btn tm-btn-ghost tm-small" @onclick="() => StartEditComment(c)">Edit</button>
                                <button class="tm-btn tm-btn-ghost tm-small tm-btn-danger" @onclick="() => DeleteComment(c)">Delete</button>
                            }
                        </span>
                    </div>
                    @if (_editingCommentId == c.Id)
                    {
                        <textarea class="tm-input" rows="3" @bind="_editingCommentText" style="margin-top:4px;"></textarea>
                        <div class="tm-reply-acts" style="margin-top:4px;">
                            <button class="tm-btn tm-btn-pri" disabled="@_busy" @onclick="() => SaveComment(c)">Save</button>
                            <button class="tm-btn" @onclick="() => _editingCommentId = 0">Cancel</button>
                        </div>
                    }
                    else
                    {
                        <div class="tm-body" style="margin-top:2px;" title="@(Translate is null || Tr(c.Body) == c.Body ? null : c.Body)">@Tr(c.Body)</div>
                    }
                    @AttachmentList(c.Attachments)
                </div>
            </div>
        }

        string draft = _drafts.GetValueOrDefault(key, "");
        bool asResult = _draftResult.GetValueOrDefault(key);
        List<PendingFile> files = _draftFiles.GetValueOrDefault(key) ?? new();
        int inputKey = _fileInputKeys.GetValueOrDefault(key);
        <div class="tm-reply" data-tm-paste>
            <div class="tm-reply-box">
                <InputFile @key="('p', inputKey)" class="tm-paste-input" style="display:none;" multiple OnChange="e => OnDraftFiles(e, key)" />
                <textarea class="tm-input" rows="2"
                          placeholder="@(key.Length == 0 ? "Write a comment…" : "Reply to this entry…")  (Ctrl+V pastes an image · Ctrl+Enter sends)"
                          value="@draft"
                          @oninput="e => _drafts[key] = e.Value?.ToString() ?? string.Empty"
                          @onkeydown="e => OnReplyKey(e, key)"></textarea>
                @PendingPreview(files)
                @if (!string.IsNullOrEmpty(draft) || files.Count > 0)
                {
                    <div class="tm-reply-acts">
                        <label class="tm-check"><input type="checkbox" checked="@asResult" @onchange="e => _draftResult[key] = e.Value is true" /> Post as result</label>
                        <span class="tm-filepick">📎 <InputFile @key="('v', inputKey)" multiple OnChange="e => OnDraftFiles(e, key)" /></span>
                        <button class="tm-btn tm-btn-pri" style="margin-left:auto;" disabled="@_busy" @onclick="() => PostComment(key)">Send</button>
                    </div>
                }
            </div>
        </div>
    };

    // ── Entry AI Summary ───────────────────────────────────────────────────────

    private readonly HashSet<string> _summarizing = new(StringComparer.Ordinal);
    private readonly HashSet<string> _entryAiHidden = new(StringComparer.Ordinal);

    private RenderFragment EntryAiButton(TeamMemoEntry entry, string label) => __builder =>
    {
        string? othersRunning = _summarizing.Contains(entry.Id) ? null : TeamMemoAiSummaryService.RunningByEntry(Memo.Id, entry.Id);
        if (_summarizing.Contains(entry.Id))
        {
            <span class="tm-ai-mini on"><span class="tm-spin dark"></span> Summarizing…</span>
        }
        else if (othersRunning is not null)
        {
            <span class="tm-ai-mini" title="@Display(othersRunning) is summarizing this entry">⏳ @Display(othersRunning)…</span>
        }
        else
        {
            <button class="tm-ai-mini" disabled="@(!Summaries.IsConfigured)"
                    title="@(Summaries.IsConfigured ? "Summarize this entry's text, comments, tables and images" : "Set the Codex API key in Setting first")"
                    @onclick="() => SummarizeEntry(entry)" @onclick:stopPropagation="true">@label</button>
        }
    };

    private RenderFragment EntryAiBlock(TeamMemoEntry entry) => __builder =>
    {
        if (string.IsNullOrWhiteSpace(entry.AiSummary)) return;
        bool hidden = _entryAiHidden.Contains(entry.Id);
        bool stale = entry.IsAiSummaryStale;
        <div class="tm-entry-ai">
            <div class="tm-ai-hd">
                <b>✨ AI Summary</b>
                <span class="tm-muted tm-small">@Display(entry.AiSummaryBy) · @TeamMemoUi.Ago(entry.AiSummaryAt) · @entry.AiSummaryModel</span>
                @if (stale)
                {
                    <span class="tm-pill tm-pill-late" title="Text, comments or files of this entry changed after the summary">Outdated</span>
                }
                <span style="margin-left:auto;display:flex;gap:6px;align-items:center;">
                    @EntryAiButton(entry, "✨ Regenerate")
                    <button class="tm-btn tm-btn-ghost tm-small" @onclick="() => { if (!_entryAiHidden.Remove(entry.Id)) _entryAiHidden.Add(entry.Id); }">@(hidden ? "Show" : "Hide")</button>
                </span>
            </div>
            @if (!hidden)
            {
                <div class="tm-ai-body">@((MarkupString)TeamMemoUi.MarkdownToHtml(Tr(entry.AiSummary)))</div>
            }
        </div>
    };

    private async Task SummarizeEntry(TeamMemoEntry entry)
    {
        if (!_summarizing.Add(entry.Id)) return;
        _error = null;
        _collapsed.Remove(entry.Id);
        _entryAiHidden.Remove(entry.Id);
        try
        {
            // Not tied to the circuit: a summary that is already paid for is saved even if the page closes.
            await Summaries.SummarizeEntryAsync(Memo.Id, entry.Id, CurrentUser, CancellationToken.None);
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _error = $"AI Summary of '{entry.Title}' failed: {ex.Message}";
        }
        finally
        {
            _summarizing.Remove(entry.Id);
        }
    }

    private RenderFragment AttachmentList(List<TeamMemoAttachment> list) => __builder =>
    {
        if (list.Count == 0) return;
        <div class="tm-files">
            @foreach (TeamMemoAttachment a in list)
            {
                @if (a.IsImage)
                {
                    <span class="tm-thumb" title="@a.FileName · @TeamMemoUi.Size(a.Size) · @Display(a.Author)">
                        <img src="/team-memo/attachment/@a.Id" alt="@a.FileName" loading="lazy" style="cursor:zoom-in;"
                             @onclick="() => _viewer = a" />
                        @if (CanDeleteAttachment(a)) { <button class="tm-file-x" @onclick="() => DeleteAttachment(a)">✕</button> }
                    </span>
                }
                else
                {
                    <span class="tm-file">
                        <a href="/team-memo/attachment/@a.Id?download=true" style="color:inherit;text-decoration:none;">📄 @a.FileName</a>
                        <span class="tm-muted">@TeamMemoUi.Size(a.Size)</span>
                        @if (CanDeleteAttachment(a)) { <button class="tm-link" @onclick="() => DeleteAttachment(a)">✕</button> }
                    </span>
                }
            }
        </div>
    };

    private RenderFragment PendingPreview(List<PendingFile> files) => __builder =>
    {
        if (files.Count == 0) return;
        <div class="tm-files">
            @foreach (PendingFile pf in files)
            {
                bool image = pf.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase);
                if (image && pf.Data.Length <= PreviewMaxBytes)
                {
                    <span class="tm-thumb tm-pending" title="@pf.Name · @TeamMemoUi.Size(pf.Data.Length) · not posted yet">
                        <img src="data:@pf.ContentType;base64,@Convert.ToBase64String(pf.Data)" alt="@pf.Name" />
                        <button class="tm-file-x" @onclick="() => files.Remove(pf)">✕</button>
                    </span>
                }
                else
                {
                    <span class="tm-file">@(image ? "🖼" : "📄") @pf.Name <span class="tm-muted">@TeamMemoUi.Size(pf.Data.Length)</span>
                        <button class="tm-link" @onclick="() => files.Remove(pf)">✕</button></span>
                }
            }
        </div>
    };

    // ── Entry form fragment ────────────────────────────────────────────────────

    private RenderFragment EntryFormFragment => __builder =>
    {
        if (_entryForm is null) return;
        EntryForm f = _entryForm;
        <div class="tm-entry-form" data-tm-paste>
            <InputFile @key="('p', f.FileKey)" class="tm-paste-input" style="display:none;" multiple OnChange="OnEntryFiles" />
            <label>Date</label>
            <input class="tm-input" type="date" value="@TeamMemoUi.Ymd(f.Date)" @onchange="e => f.Date = ParseDate(e.Value) ?? f.Date" />
            <label>Target</label>
            <input class="tm-input" type="date" value="@TeamMemoUi.Ymd(f.Target)" @onchange="e => f.Target = ParseDate(e.Value)" />
            <label>Title</label>
            <input class="tm-input tm-span3" @bind="f.Title" @bind:event="oninput" placeholder="What happened / what is being done" />
            <label>Detail</label>
            <textarea class="tm-input tm-span3" rows="3" @bind="f.Body" placeholder="Optional detail — Ctrl+V here pastes a screenshot as an attachment"></textarea>
            @if (f.Id is not null)
            {
                <label>Done</label>
                <input class="tm-input" type="date" value="@TeamMemoUi.Ymd(f.Done)" @onchange="e => f.Done = ParseDate(e.Value)" />
                <span></span><span></span>
            }
            <label>Files</label>
            <div class="tm-span3 tm-filepick" style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
                <InputFile @key="('v', f.FileKey)" multiple OnChange="OnEntryFiles" />
                <span class="tm-muted tm-small">or Ctrl+V an image in any field above</span>
            </div>
            @if (f.Files.Count > 0)
            {
                <span></span>
                <div class="tm-span3">@PendingPreview(f.Files)</div>
            }
            <span></span>
            <div class="tm-span3" style="display:flex;gap:8px;">
                <button class="tm-btn tm-btn-pri" disabled="@(_busy || string.IsNullOrWhiteSpace(f.Title))" @onclick="SaveEntry">@(f.Id is null ? "Add entry" : "Save")</button>
                <button class="tm-btn" @onclick="() => _entryForm = null">Cancel</button>
            </div>
        </div>
    };

    private static DateOnly? ParseDate(object? v) =>
        DateOnly.TryParse(v?.ToString(), out var d) ? d : null;

    private void StartNewEntry()
    {
        _entryForm = new EntryForm();
    }

    private void StartEditEntry(TeamMemoEntry e)
    {
        CancelInline();
        _entryForm = new EntryForm
        {
            Id = e.Id, Date = e.EntryDate, Title = e.Title, Body = e.Body, Target = e.TargetDate, Done = e.DoneDate,
        };
    }

    private async Task OnEntryFiles(InputFileChangeEventArgs e)
    {
        if (_entryForm is null) return;
        foreach (PendingFile f in await ReadFiles(e)) _entryForm.Files.Add(f);
        _entryForm.FileKey++;
    }

    private async Task OnDraftFiles(InputFileChangeEventArgs e, string key)
    {
        if (!_draftFiles.TryGetValue(key, out var list)) _draftFiles[key] = list = new();
        list.AddRange(await ReadFiles(e));
        _fileInputKeys[key] = _fileInputKeys.GetValueOrDefault(key) + 1;
    }

    private async Task<List<PendingFile>> ReadFiles(InputFileChangeEventArgs e)
    {
        var result = new List<PendingFile>();
        try
        {
            foreach (IBrowserFile file in e.GetMultipleFiles(20))
            {
                if (file.Size > TeamMemoService.MaxAttachmentBytes)
                {
                    _error = $"{file.Name} is larger than {TeamMemoService.MaxAttachmentBytes / 1024 / 1024} MB.";
                    continue;
                }
                using var ms = new MemoryStream();
                await using Stream s = file.OpenReadStream(TeamMemoService.MaxAttachmentBytes);
                await s.CopyToAsync(ms);
                result.Add(new PendingFile(file.Name, file.ContentType, ms.ToArray()));
            }
        }
        catch (Exception ex)
        {
            _error = "Could not read the file: " + ex.Message;
        }
        return result;
    }

    // ── Writes ─────────────────────────────────────────────────────────────────

    private async Task Run(Action write)
    {
        if (_busy) return;
        _busy = true;
        _error = null;
        try
        {
            write();
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private Task SaveEntry() => Run(() =>
    {
        EntryForm f = _entryForm!;
        var files = f.Files.Select(pf => (pf.Name, pf.ContentType, pf.Data)).ToList();
        string entryId;
        if (f.Id is null)
        {
            entryId = Memos.AddEntry(Memo.Id, f.Date, f.Title, f.Body, f.Target, CurrentUser, files);
        }
        else
        {
            entryId = f.Id;
            Memos.UpdateEntry(new TeamMemoEntry
            {
                Id = f.Id, MemoId = Memo.Id, EntryDate = f.Date, Title = f.Title, Body = f.Body,
                TargetDate = f.Target, DoneDate = f.Done,
            }, CurrentUser, files);
        }
        _collapsed.Remove(entryId);
        _entryForm = null;
    });

    // ── Inline edit: click the title, the detail or the target date to edit it in place ──

    private const string FTitle = "title", FBody = "body", FTarget = "target";
    private string? _inlineId, _inlineField;
    private string _inlineText = "";
    private ElementReference _inlineRef;
    private bool _focusInline;

    private bool IsInline(TeamMemoEntry e, string field) => _inlineId == e.Id && _inlineField == field;

    private void StartInline(TeamMemoEntry e, string field)
    {
        _entryForm = null;
        _inlineId = e.Id;
        _inlineField = field;
        _inlineText = field switch
        {
            "title" => e.Title,
            "body" => e.Body,
            _ => TeamMemoUi.Ymd(e.TargetDate),
        };
        _collapsed.Remove(e.Id);
        _focusInline = true;
    }

    private void CancelInline() => _inlineId = _inlineField = null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusInline || _inlineId is null) return;
        _focusInline = false;
        try { await _inlineRef.FocusAsync(); } catch { /* element already gone */ }
    }

    private async Task OnInlineKey(KeyboardEventArgs k, TeamMemoEntry e)
    {
        if (k.Key == "Escape") CancelInline();
        else if (k.Key == "Enter" && (_inlineField == "title" || k.CtrlKey)) await SaveInline(e);
    }

    private Task SaveInline(TeamMemoEntry e)
    {
        if (_inlineId != e.Id || _inlineField is not ("title" or "body")) return Task.CompletedTask;
        string field = _inlineField, text = _inlineText;
        CancelInline();
        if (field == "title" && (string.IsNullOrWhiteSpace(text) || text.Trim() == e.Title)) return Task.CompletedTask;
        if (field == "body" && text.TrimEnd() == e.Body.TrimEnd()) return Task.CompletedTask;
        return UpdateEntryField(e, title: field == "title" ? text.Trim() : e.Title, body: field == "body" ? text.TrimEnd() : e.Body,
            target: e.TargetDate);
    }

    private Task SaveTarget(TeamMemoEntry e, object? value)
    {
        CancelInline();
        DateOnly? target = ParseDate(value);
        return target == e.TargetDate ? Task.CompletedTask : UpdateEntryField(e, e.Title, e.Body, target);
    }

    private Task UpdateEntryField(TeamMemoEntry e, string title, string body, DateOnly? target) => Run(() =>
        Memos.UpdateEntry(new TeamMemoEntry
        {
            Id = e.Id, MemoId = Memo.Id, EntryDate = e.EntryDate, Title = title, Body = body,
            TargetDate = target, DoneDate = e.DoneDate,
        }, CurrentUser, []));

    private Task SetDone(TeamMemoEntry e, bool done) =>
        Run(() => Memos.SetEntryDone(Memo.Id, e.Id, done ? TeamMemoUi.Today : null, CurrentUser));

    private Task DeleteEntry(TeamMemoEntry e) =>
        Run(() => Memos.DeleteEntry(Memo.Id, e.Id, CurrentUser));

    private async Task OnReplyKey(KeyboardEventArgs e, string key)
    {
        if (e.Key == "Enter" && e.CtrlKey) await PostComment(key);
    }

    private Task PostComment(string key) => Run(() =>
    {
        string body = _drafts.GetValueOrDefault(key, "").Trim();
        List<PendingFile> files = _draftFiles.GetValueOrDefault(key) ?? new();
        if (body.Length == 0 && files.Count == 0) return;
        Memos.AddComment(Memo.Id, key.Length == 0 ? null : key, body, _draftResult.GetValueOrDefault(key), CurrentUser,
            files.Select(pf => (pf.Name, pf.ContentType, pf.Data)).ToList());
        _drafts.Remove(key);
        _draftResult.Remove(key);
        _draftFiles.Remove(key);
        _showAllComments.Add(key);
    });

    private void StartEditComment(TeamMemoComment c)
    {
        _editingCommentId = c.Id;
        _editingCommentText = c.Body;
    }

    private Task SaveComment(TeamMemoComment c) => Run(() =>
    {
        Memos.UpdateComment(Memo.Id, c.Id, _editingCommentText.Trim());
        _editingCommentId = 0;
    });

    private Task ToggleResult(TeamMemoComment c) =>
        Run(() => Memos.SetCommentResult(Memo.Id, c.Id, !c.IsResult));

    private Task DeleteComment(TeamMemoComment c) =>
        Run(() => Memos.DeleteComment(Memo.Id, c.Id));

    private Task DeleteAttachment(TeamMemoAttachment a) =>
        Run(() => Memos.DeleteAttachment(Memo.Id, a.Id, CurrentUser));
}
