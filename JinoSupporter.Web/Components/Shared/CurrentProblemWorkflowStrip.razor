@inject CurrentProblemAnalysisService CurrentProblem
@inject WebRepository Repo

<div class="cp-strip" title="@SampleDirTitle">
    <div class="cp-strip-main">
        <span class="cp-strip-title">First Analysis</span>
        <span class="cp-chip">@ContextLabel</span>
        <span class="cp-chip">sample_ready @_statusText</span>
        <span class="cp-chip">Result DB @_dbStatus.FirstPassIndexCount.ToString("N0")/@_dbStatus.RawReportCount.ToString("N0")</span>
        <span class="cp-chip">AI docs @_dbStatus.DetailedAiDocumentCount.ToString("N0")</span>
        <span class="cp-chip">Latest @LatestResultText</span>
    </div>
    <div class="cp-strip-actions">
        <a class="btn btn-outline-secondary btn-sm" href="data-inference/db?aiResult=index">Result Index</a>
        <a class="btn btn-outline-secondary btn-sm" href="data-inference/ask">Ask AI</a>
        <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="Refresh">Refresh</button>
    </div>
</div>

@code {
    [Parameter] public string ContextLabel { get; set; } = "workflow";

    private CurrentProblemStatus? _status;
    private CurrentProblemDbStatus _dbStatus = new(0, 0, 0);
    private string _statusText = "-";

    protected override void OnInitialized()
        => Refresh();

    private void Refresh()
    {
        try
        {
            _status = CurrentProblem.GetStatus();
            _statusText = _status.IndexedRows > 0 ? _status.IndexedRows.ToString("N0") : "-";
        }
        catch
        {
            _status = null;
            _statusText = "-";
        }

        try
        {
            _dbStatus = Repo.GetCurrentProblemDbStatus();
        }
        catch
        {
            _dbStatus = new CurrentProblemDbStatus(0, 0, 0);
        }
    }

    private string SampleDirTitle => _status?.SampleDir ?? "";

    private string LatestResultText
    {
        get
        {
            string path = _status?.LatestResultHtmlPath ?? "";
            if (string.IsNullOrWhiteSpace(path) || !File.Exists(path)) return "-";
            return File.GetLastWriteTime(path).ToString("yyyy-MM-dd HH:mm");
        }
    }
}

<style>
    .cp-strip {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin: 0 14px 10px;
        padding: 8px 10px;
        border: 1px solid #d7e1ee;
        border-radius: 6px;
        background: #fff;
        color: #0f172a;
    }

    .cp-strip-main,
    .cp-strip-actions {
        min-width: 0;
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }

    .cp-strip-title {
        font-size: 12px;
        font-weight: 800;
        color: #1e293b;
        white-space: nowrap;
    }

    .cp-chip {
        min-height: 24px;
        display: inline-flex;
        align-items: center;
        border: 1px solid #e2e8f0;
        border-radius: 5px;
        background: #f8fafc;
        padding: 3px 7px;
        color: #475569;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .cp-strip-actions .btn {
        white-space: nowrap;
    }

    @@media (max-width: 900px) {
        .cp-strip {
            align-items: flex-start;
            flex-direction: column;
        }
    }
</style>
