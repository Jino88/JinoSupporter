<style>
    .ngrate-grid,
    .ngrate-flow {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        grid-template-rows: auto;
        gap: 8px;
        align-items: stretch;
    }
    .ngrate-top-toggle {
        width: 100%;
        border: 1px solid #dbe3ee;
        border-radius: 2px;
        background: var(--panel-2, #f5f6f9);
        color: var(--ink-2, #4a5461);
        padding: .4rem .65rem;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 12px;
        text-align: left;
    }
    .ngrate-top-toggle:hover {
        background: var(--panel-2, #f5f6f9);
    }
    .ngrate-top-toggle-collapsed {
        min-height: 42px;
        margin-bottom: 12px;
    }
    .ngrate-cell-tl,
    .ngrate-flow-data {
        grid-column: 1;
        grid-row: 1;
    }
    .ngrate-cell-bl,
    .ngrate-cell-br,
    .ngrate-flow-groups,
    .ngrate-flow-log {
        grid-column: 2;
    }
    .ngrate-cell-progress-log,
    .ngrate-flow-progress {
        grid-column: 2;
        grid-row: 1;
        align-self: stretch;
    }
    .ngrate-setup-grid {
        display: grid;
        grid-template-columns: minmax(0, .82fr) minmax(280px, 1.18fr);
        gap: 10px;
        align-items: stretch;
        min-height: 0;
    }
    .ngrate-setup-main,
    .ngrate-setup-groups {
        min-width: 0;
    }
    .ngrate-setup-groups {
        display: flex;
        flex-direction: column;
        border-left: 1px solid #dbe3ee;
        padding-left: 10px;
    }
    .ngrate-setup-groups-head {
        min-height: 24px;
    }
    .ngrate-setup-groups-list {
        max-height: 150px;
        overflow: auto;
        min-height: 0;
    }
    .ngrate-setup-card {
        border: 1px solid var(--line, #dde1e7);
        background: var(--panel, #fff);
    }
    .ngrate-report-card {
        border: 1px solid var(--line-2, #c6ccd5);
        background: var(--panel, #fff);
        box-shadow: none !important;
    }
    .ngrate-card-header {
        padding: .4rem .65rem;
        background: var(--panel-2, #f5f6f9);
        color: var(--ink-2, #4a5461);
        border-bottom: 1px solid var(--line-2, #c6ccd5);
        min-height: 30px;
        font-size: 11.5px;
    }
    .ngrate-card-body {
        padding: .65rem;
        background: var(--panel, #fff);
    }
    .ngrate-card-body.p-0 {
        padding: 0 !important;
    }
    .ngrate-grid .gap-3,
    .ngrate-flow .gap-3 {
        gap: .65rem !important;
    }
    .ngrate-log-card {
        height: 100% !important;
        min-height: 0;
        max-height: none;
        align-self: stretch;
    }
    .ngrate-log-card-body {
        display: flex;
        flex-direction: column;
        flex: 1 1 auto;
        min-height: 0;
    }
    .ngrate-log-card-body > .p-3.pb-2 {
        padding: .5rem .75rem .35rem !important;
    }
    .ngrate-log-pane {
        flex: 1 1 auto;
        min-height: 0;
        height: 0;
        max-height: none;
        background: var(--panel-2, #f5f6f9);
        color: var(--ink, #0f1319);
        border-top: 1px solid #dbe3ee;
        border-radius: 0 0 2px 2px;
        font-size: 10.5px;
        line-height: 1.35;
        white-space: pre-wrap;
        word-break: break-word;
    }
    .ngrate-log-pane .text-danger { color: var(--crit, #c8342a) !important; }
    .ngrate-log-pane .text-warning { color: var(--warn-ink, #92610a) !important; }
    .ngrate-log-pane .text-info { color: #075985 !important; }
    .ngrate-log-pane .text-success { color: #047857 !important; }

    /* ── Per-stage progress (Daily / Weekly / 원인 비중 / F-COST) ────────────── */
    .ngrate-stages {
        display: flex;
        flex-direction: column;
        gap: .5rem;
    }
    .ngrate-stage-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: .5rem;
        font-size: 11.5px;
        margin-bottom: 3px;
    }
    .ngrate-stage-name {
        font-weight: 600;
        color: var(--ink, #0f1319);
        display: inline-flex;
        align-items: baseline;
        gap: 5px;
        min-width: 0;
    }
    .ngrate-stage-icon {
        font-size: 10px;
        line-height: 1;
    }
    .ngrate-stage-meta {
        display: inline-flex;
        align-items: baseline;
        gap: 6px;
        font-size: 10.5px;
        color: var(--ink-3, #7f8a98);
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }
    .ngrate-stage-pct {
        font-weight: 600;
        color: var(--ink-2, #4a5461);
    }
    .ngrate-stage-phase {
        color: var(--ink-2, #4a5461);
    }
    .ngrate-stage-bar {
        height: 6px;
        background: var(--panel-3, #eceef2);
    }
    .ngrate-stage-step {
        margin-top: 3px;
        font-size: 10px;
        color: var(--ink-3, #7f8a98);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .json-file-item {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 2px 6px;
        border-radius: 2px;
        font-size: 11px;
        font-family: var(--mono, monospace);
        color: var(--ink-2, #4a5461);
        cursor: pointer;
    }
    .json-file-item:hover { background: var(--panel-3, #eceef2); }
    .json-file-item .file-date {
        font-size: 10px;
        color: var(--ink-3, #7f8a98);
        margin-left: auto;
    }
    .json-file-item input[type=checkbox] {
        cursor: pointer;
        flex-shrink: 0;
    }
    .json-file-item.sub-row {
        padding-left: 22px;
        color: var(--ink-2, #4a5461);
        font-size: 10.5px;
    }
    .json-file-item.sub-row .file-date {
        color: var(--line-2, #c6ccd5);
    }
    .grp-chk {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 3px 6px;
        font-size: 13px;
        cursor: pointer;
        border-radius: 2px;
    }
    .grp-chk:hover { background: var(--panel-3, #eceef2); }
    .grp-chk .grp-name { flex: 1; }
    .grp-chk .grp-count {
        font-size: 10px;
        font-family: var(--mono, monospace);
    }
    .ngrate-picker-tabs {
        background: var(--panel-2, #f5f6f9);
    }
    .ngrate-picker-selection,
    .ngrate-picker-count,
    .ngrate-picker .file-date,
    .ngrate-picker .grp-count {
        color: var(--ink-2, #4a5461);
        font-family: var(--mono, monospace);
        font-size: 10px;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }
    .ngrate-picker-selection::before {
        content: "\2713\00a0";
        color: var(--ink, #0f1319);
        font-weight: 700;
    }
    .ngrate-hier-level,
    .ngrate-picker-level {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 42px;
        margin-right: 4px;
        padding: 0 3px;
        border: 1px solid var(--line-2, #c6ccd5);
        background: var(--panel-2, #f5f6f9);
        color: var(--ink-2, #4a5461);
        font-family: var(--sans, "Segoe UI", sans-serif);
        font-size: 8px;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
        letter-spacing: .35px;
        line-height: 1.35;
        vertical-align: 1px;
    }

    .ngrate-view-nav {
        padding-bottom: 6px;
        border-bottom: 1px solid var(--line, #dde1e7);
    }
    .ngrate-view-current,
    .ngrate-view-current:disabled {
        border-color: var(--signal, #16202b);
        background: var(--signal, #16202b);
        color: var(--panel, #fff);
        opacity: 1;
    }
    .ngrate-view-link {
        border-color: var(--line-2, #c6ccd5);
        background: var(--panel, #fff);
        color: var(--ink-2, #4a5461);
    }

    .pg-tab {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .4px;
        padding: 2px 9px;
        border-radius: 2px;
        border: 1.5px solid var(--ink-3, #7f8a98);
        background: var(--panel, #fff);
        color: var(--ink, #0f1319);
        cursor: pointer;
        white-space: nowrap;
        transition: all .15s;
    }
    .pg-tab:hover {
        border-color: var(--ink, #0f1319);
        color: var(--ink, #0f1319);
        background: var(--panel-3, #eceef2);
    }
    .pg-tab.active {
        background: var(--ink, #0f1319);
        border-color: var(--ink, #0f1319);
        color: var(--panel, #fff);
    }
    .pg-section-label,
    .pg-SPK,
    .pg-UNIT,
    .pg-MODULE,
    .pg-TWS,
    .pg-ETC {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .4px;
        padding: 1px 6px;
        border-radius: 2px;
        flex-shrink: 0;
        background: var(--panel-3, #eceef2);
        color: var(--ink, #0f1319);
        border: 1px solid var(--ink-3, #7f8a98);
    }

    .ngrate-del-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.45);
        z-index: 9500;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .ngrate-del-dialog {
        background: var(--panel, #fff);
        border-radius: 2px;
        padding: 0;
        min-width: 420px;
        max-width: 80vw;
        max-height: 80vh;
        display: flex;
        flex-direction: column;
    }
    .ngrate-del-head {
        padding: 12px 16px;
        border-bottom: 1px solid var(--line, var(--line, #dde1e7));
        font-size: 14px;
        font-weight: 700;
        color: var(--crit, #c8342a);
    }
    .ngrate-del-body {
        flex: 1;
        overflow: auto;
        padding: 12px 16px;
    }
    .ngrate-del-foot {
        display: flex;
        gap: 8px;
        justify-content: flex-end;
        padding: 10px 16px;
        border-top: 1px solid var(--line, var(--line, #dde1e7));
    }

    .pivot-wrap {
        overflow-x: hidden;
    }
    .pivot-wrap:has(.text-fit-table) {
        overflow-x: auto;
    }
    .pivot-table {
        font-size: 11px;
        white-space: nowrap;
        border-collapse: collapse;
        border: 1px solid var(--ink-3, #7f8a98);
        table-layout: fixed;
        width: 100%;
        min-width: 0;
    }
    .pivot-table th,
    .pivot-table td {
        border: 1px solid var(--ink-3, #7f8a98);
    }
    .pivot-table th {
        background: var(--line, var(--line, #dde1e7));
        color: var(--ink, #0f1319);
        font-weight: 700;
        font-size: 10px;
        padding: 3px 6px;
        text-align: center;
        position: sticky;
        top: 0;
        z-index: 1;
    }
    .pivot-table td {
        padding: 2px 6px;
        text-align: right;
        font-family: var(--mono, monospace);
    }
    .pivot-table th:not(.label-th):not(.sep-th),
    .pivot-table td:not(.label-td):not(.sep-td) {
        box-sizing: border-box;
        width: auto;
        min-width: 0;
        max-width: none;
        overflow: hidden;
        text-overflow: clip;
        font-variant-numeric: tabular-nums;
        font-size: 10px;
        padding-left: 3px;
        padding-right: 3px;
        white-space: nowrap;
    }
    .pivot-table th.label-th,
    .pivot-table td.label-td {
        text-align: left;
        min-width: 0 !important;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-family: inherit;
        font-size: 11px;
    }
    .pivot-table th.sep-th,
    .pivot-table td.sep-td {
        background: var(--panel-3, #eceef2) !important;
        border-top-color: transparent !important;
        border-bottom-color: transparent !important;
        border-left: 1px solid var(--ink-3, #7f8a98) !important;
        border-right: 1px solid var(--ink-3, #7f8a98) !important;
        width: 12px;
        min-width: 12px;
        max-width: 12px;
        padding: 0;
    }
    .pivot-table th.blk-date,
    .pivot-table th.blk-week,
    .pivot-table th.blk-month {
        background: var(--line, var(--line, #dde1e7));
        color: var(--ink, #0f1319);
        text-align: center;
    }
    .pivot-table td.ppm-zero { color: var(--ink-3, #7f8a98); }
    .pivot-table td.ppm-val {
        color: var(--ink, #0f1319);
        font-weight: 600;
    }
    .pivot-table td .ppm-cell-value {
        display: block;
        line-height: 1.05;
    }
    .pivot-table td .ppm-delta {
        display: block;
        margin-top: 1px;
        font-size: 9px;
        font-weight: 700;
        line-height: 1.05;
        font-variant-numeric: tabular-nums;
    }
    .pivot-table td .ppm-delta::before {
        display: inline-block;
        width: 1em;
        margin-right: 2px;
        color: currentColor;
        text-align: center;
    }
    .pivot-table td .ppm-delta-up {
        color: var(--crit, #c8342a);
    }
    .pivot-table td .ppm-delta-up::before { content: "\25B2"; }
    .pivot-table td .ppm-delta-down {
        color: var(--ok, #2563eb);
    }
    .pivot-table td .ppm-delta-down::before { content: "\25BC"; }
    .pivot-table td .ppm-delta-flat {
        color: var(--ink-3, #7f8a98);
    }
    .pivot-table td .ppm-delta-flat::before { content: "\2014"; }
    .pivot-table td.ppm-max-cell {
        font-weight: 700;
    }
    .pivot-table tr.total-row td,
    .pivot-table tr.hier-group-row td,
    .grp-overall-row td,
    .grp-total-row td,
    .wr-mid-row td {
        background: var(--line, var(--line, #dde1e7));
        color: var(--ink, #0f1319);
        font-weight: 700;
        border-top: 2px solid var(--line-2, #c6ccd5) !important;
        border: 1px solid var(--line, #dde1e7);
    }
    .pivot-table tr.total-row td:first-child,
    .pivot-table tr.hier-group-row td:first-child,
    .grp-overall-row td:first-child,
    .grp-total-row td:first-child {
        border-left: 3px solid var(--ink, #0f1319) !important;
    }
    .pivot-table tr.total-row td,
    .grp-overall-row td {
        border-top: 3px double var(--ink-2, #4a5461) !important;
    }
    .pivot-table tr.rank-row:nth-child(odd) td,
    .pivot-table tr.hier-sub2-row td,
    .pivot-table tr.hier-ls-row td,
    .grp-sub-row td,
    .grp-sub1-row td,
    .grp-sub2-row td,
    .wr-sub1-row td,
    .wr-sub2-row td {
        background: var(--panel, #fff);
        color: var(--ink, #0f1319);
    }
    .pivot-table tr.group-row td,
    .pivot-table tr.hier-mid-row td,
    .pivot-table tr.hier-sub1-row td,
    .grp-mid-row td,
    .top10-group-head {
        background: var(--panel-3, #eceef2);
        color: var(--ink, #0f1319);
    }
    .pivot-table tr.hier-mid-row td,
    .grp-mid-row td,
    .wr-mid-row td {
        font-weight: 600;
        border-top: 1px solid var(--line-2, #c6ccd5) !important;
    }
    .pivot-table tr.hier-sub1-row td:first-child,
    .grp-sub1-row td:first-child,
    .wr-sub1-row td:first-child {
        border-left: 2px solid var(--line-2, #c6ccd5) !important;
    }
    .pivot-table tr.hier-sub2-row td:first-child,
    .grp-sub2-row td:first-child,
    .wr-sub2-row td:first-child,
    .pivot-table tr.hier-ls-row td:first-child,
    .grp-ls-row td:first-child,
    .wr-ls-row td:first-child {
        border-left: 2px dashed var(--line-2, #c6ccd5) !important;
    }
    .pivot-table tr.rank-row:hover td,
    .pivot-table tr.group-row:hover td,
    .pivot-table tr.hier-group-row:hover td,
    .pivot-table tr.hier-mid-row:hover td,
    .grp-total-row:hover td,
    .wr-row-expandable:hover td,
    .grp-sub-expandable:hover td {
        background: var(--line, var(--line, #dde1e7));
        filter: none;
    }
    .pivot-table tr.hier-group-row,
    .pivot-table tr.hier-mid-row,
    .pivot-table tr.hier-sub-expandable,
    .grp-total-row,
    .grp-mid-row,
    .grp-sub-expandable,
    .wr-row-expandable {
        cursor: pointer;
    }
    .pivot-table tr.hier-ls-row td,
    .grp-ls-row td,
    .wr-ls-row td {
        background: var(--panel, #fff);
        color: var(--ink-2, #4a5461);
        font-size: 10.5px;
        font-style: italic;
        border-top: 1px dashed var(--ink-3, #7f8a98);
        font-family: var(--mono, monospace);
    }
    .daily-summary-table .grp-total-row,
    .daily-summary-table .grp-mid-row {
        cursor: default;
    }
    .daily-summary-table .grp-total-row td,
    .daily-summary-table .grp-total-row:hover td,
    .daily-summary-table .grp-mid-row td,
    .daily-summary-table .grp-mid-row:hover td {
        filter: none;
    }
    .daily-summary-table .grp-total-row td,
    .daily-summary-table .grp-total-row:hover td {
        background: var(--panel-2, #f5f6f9);
        border-top: 2px solid var(--line-2, #c6ccd5) !important;
    }
    .daily-summary-table .grp-mid-row td,
    .daily-summary-table .grp-mid-row:hover td {
        background: var(--panel-3, #eceef2);
    }
    .group-name-td,
    .toggle-cell:hover,
    .expand-btn:hover,
    .toggle-icon,
    .tog-icon,
    .wr-tog {
        color: var(--ink, #0f1319) !important;
    }
    .pt-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 56px;
        min-width: 56px;
        box-sizing: border-box;
        font-size: 9px;
        padding: 1px 4px;
        border: 1px solid var(--ink-2, #4a5461);
        border-radius: 2px;
        background: var(--panel, #fff);
        color: var(--ink, #0f1319);
        line-height: 1.2;
        text-align: center;
    }
    .process-cell {
        display: inline-grid;
        grid-template-columns: 56px max-content;
        column-gap: 6px;
        align-items: center;
    }
    .process-label {
        min-width: 0;
    }
    .toggle-cell {
        cursor: pointer;
        text-align: center;
        color: var(--ink-3, #7f8a98);
        user-select: none;
    }
    .expand-btn {
        font-size: 10px;
        padding: 0;
        border: none;
        background: none;
        color: var(--ink-3, #7f8a98);
        cursor: pointer;
        text-decoration: none;
    }
    .group-chip {
        display: inline-block;
        font-size: 10px;
        padding: 2px 7px;
        border-radius: 2px;
        cursor: pointer;
        user-select: none;
        border: 1px solid var(--ink-2, #4a5461);
        background: var(--panel, #fff);
        color: var(--ink, #0f1319);
        transition: background .15s, color .15s;
    }
    .group-chip:hover {
        background: var(--panel-3, #eceef2);
    }
    .group-chip.active {
        background: var(--ink, #0f1319);
        border-color: var(--ink, #0f1319);
        color: var(--panel, #fff);
    }
    .group-chip.ngrate-chip-empty {
        background: var(--panel-3, #eceef2);
        color: var(--ink-3, #7f8a98);
        border-color: var(--line-2, #c6ccd5);
        cursor: not-allowed;
        opacity: .55;
        text-decoration: line-through;
    }
    .group-chip.ngrate-chip-empty:hover {
        background: var(--panel-3, #eceef2);
    }
    .group-chip-clear {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 10px;
        font-weight: 600;
        padding: 2px 9px;
        border-radius: 2px;
        cursor: pointer;
        user-select: none;
        background: var(--panel-3, #eceef2);
        border: 1px solid var(--ink-2, #4a5461);
        color: var(--ink, #0f1319);
        transition: background .15s, color .15s;
    }
    .group-chip-clear:hover,
    .row-hide-btn:hover {
        background: var(--line, var(--line, #dde1e7));
        border-color: var(--ink-2, #4a5461);
        color: var(--ink, #0f1319);
    }
    .row-hide-cell {
        width: 22px;
        text-align: center;
        padding: 0 !important;
    }
    .row-hide-btn {
        width: 16px;
        height: 16px;
        padding: 0;
        line-height: 1;
        font-size: 10px;
        color: var(--ink-3, #7f8a98);
        cursor: pointer;
        background: transparent;
        border: 1px solid transparent;
        border-radius: 2px;
    }
    .top10-table {
