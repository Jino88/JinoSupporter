<Window x:Class="BmesNgRateStandalone.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:local="clr-namespace:BmesNgRateStandalone.Components"
        Title="BMES NG Rate" Height="900" Width="1400"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#F7FAFC"
                BorderBrush="#D9E2EC"
                BorderThickness="0,0,0,1"
                Padding="10,6">
            <DockPanel LastChildFill="False">
                <TextBlock Text="BMES NG Rate"
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#1F2937" />
                <Button x:Name="UpdateButton"
                        DockPanel.Dock="Right"
                        MinWidth="92"
                        Padding="12,4"
                        Content="Update"
                        Click="UpdateButton_Click" />
            </DockPanel>
        </Border>

        <blazor:BlazorWebView x:Name="blazorWebView"
                              Grid.Row="1"
                              HostPage="wwwroot/index.html">
            <blazor:BlazorWebView.RootComponents>
                <blazor:RootComponent Selector="#app" ComponentType="{x:Type local:Routes}" />
            </blazor:BlazorWebView.RootComponents>
        </blazor:BlazorWebView>
    </Grid>
</Window>
