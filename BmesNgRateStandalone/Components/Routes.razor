<Router AppAssembly="typeof(BmesNgRateStandalone.App).Assembly">
    <Found Context="routeData">
        <ErrorBoundary>
            <ChildContent>
                <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
                <FocusOnNavigate RouteData="routeData" Selector="h1" />
            </ChildContent>
            <ErrorContent Context="exception">
                @{ StandaloneErrorLog.Write("Blazor ErrorBoundary", exception); }
                <LayoutView Layout="typeof(Layout.MainLayout)">
                    <div class="alert alert-danger m-3">
                        <div class="fw-semibold">Unhandled error</div>
                        <div class="small mt-1">@exception.Message</div>
                        <div class="small mt-2">Log: <code>@StandaloneErrorLog.LogPath</code></div>
                    </div>
                </LayoutView>
            </ErrorContent>
        </ErrorBoundary>
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(Layout.MainLayout)">
            <div class="alert alert-warning m-3">Page not found.</div>
        </LayoutView>
    </NotFound>
</Router>
