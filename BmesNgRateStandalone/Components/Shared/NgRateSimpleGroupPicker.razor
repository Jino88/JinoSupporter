@using BmesNgRateStandalone.Services

<div class="ngrate-setup-groups-head small fw-semibold d-flex align-items-center gap-2 mb-2">
    <span>Sub Groups</span>
    <span class="badge bg-secondary" style="font-size:10px;">@Groups.Count</span>
    <button class="btn btn-outline-secondary btn-sm ms-auto" @onclick="OnReload">Refresh</button>
    <a class="btn btn-outline-secondary btn-sm" href="/bmes/make-model-group" target="_blank" title="Edit groups">Edit</a>
</div>
<div class="ngrate-setup-groups-body d-flex flex-column gap-2">
    @if (Groups.Count == 0)
    {
        <div class="text-muted small">
            No saved sub groups. Please create them first at <a href="/bmes/make-model-group" target="_blank">Model Group</a>.
        </div>
    }
    else
    {
        <div class="d-flex gap-2 small">
            <button class="btn btn-link btn-sm p-0" @onclick="OnSelectAll">All</button>
            <span class="text-muted">|</span>
            <button class="btn btn-link btn-sm p-0" @onclick="OnClearSelection">None</button>
            <span class="text-muted ms-auto">@SelectedGroupNames.Count selected</span>
        </div>
        <div class="ngrate-setup-groups-list">
            @foreach (var g in Groups)
            {
                <label class="grp-chk">
                    <input type="checkbox"
                           checked="@SelectedGroupNames.Contains(g.Name)"
                           @onchange="e => OnToggleGroup.InvokeAsync((g.Name, (bool)e.Value!))" />
                    <span class="grp-name">@g.Name</span>
                    <span class="grp-count text-muted">@(g.MidGroups.Count) / @g.MidGroups.Sum(m => m.LineShifts.Count)</span>
                </label>
            }
        </div>
    }

    <button class="btn btn-success mt-1"
            @onclick="OnGetReport"
            disabled="@(IsReportBusy || IsBusy || SelectedGroupNames.Count == 0 || !IsCredentialsConfigured)">
        @if (IsReportBusy || IsBusy)
        {
            <span class="spinner-border spinner-border-sm me-1"></span><span>Processing...</span>
        }
        else
        {
            <span>Get Report</span>
        }
    </button>
</div>

@code {
    [Parameter] public IReadOnlyList<ModelGroupRecord> Groups { get; set; } = [];
    [Parameter] public IReadOnlySet<string> SelectedGroupNames { get; set; } = new HashSet<string>(StringComparer.Ordinal);
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public bool IsReportBusy { get; set; }
    [Parameter] public bool IsCredentialsConfigured { get; set; }

    [Parameter] public EventCallback OnReload { get; set; }
    [Parameter] public EventCallback OnSelectAll { get; set; }
    [Parameter] public EventCallback OnClearSelection { get; set; }
    [Parameter] public EventCallback<(string Name, bool Selected)> OnToggleGroup { get; set; }
    [Parameter] public EventCallback OnGetReport { get; set; }
}
