@using BmesNgRateStandalone.Services

<div class="ngrate-setup-groups-head small fw-semibold d-flex justify-content-between align-items-center mb-2">
    <span>@Title</span>
    <div class="d-flex align-items-center gap-2">
        @if (SelectedCount > 0)
        {
            <span class="ngrate-picker-selection">@SelectedCount selected</span>
        }
        <span class="text-muted" style="font-size:11px;">
            @Groups.Count group@(Groups.Count == 1 ? "" : "s")
        </span>
        <button class="btn btn-link btn-sm p-0 text-secondary" @onclick="OnRefresh" title="Refresh">Refresh</button>
    </div>
</div>
<div class="ngrate-picker d-flex flex-column min-h-0">
    @if (Groups.Count == 0)
    {
        <div class="text-muted small p-3 flex-grow-1">
            <span>No groups found. Define groups on the <a href="/bmes/make-model-group">Model Group</a> page.</span>
        </div>
    }
    else
    {
        <div class="ngrate-picker-tabs d-flex flex-wrap gap-1 px-2 py-2 border-bottom">
            @foreach (var pg in GroupProductGroups)
            {
                int pgCount = Groups.Count(g => g.ProductGroup == pg);
                int pgSel = SelectedGroupIds.Count(id => Groups.Any(g => g.Id == id && g.ProductGroup == pg));
                <button class="pg-tab @(ActiveProductGroup == pg ? "active" : "")"
                        title="@($"{pg}: {pgSel} selected of {pgCount}")"
                        @onclick="@(() => ActiveProductGroupChanged.InvokeAsync(pg))">
                    @pg
                    @if (pgSel > 0)
                    {
                        <span class="ms-1" style="opacity:.85;">(@pgSel)</span>
                    }
                    else
                    {
                        <span class="ms-1 opacity-50">@pgCount</span>
                    }
                </button>
            }
        </div>

        <div class="ngrate-setup-groups-list">
            <div class="px-2 py-1">
                @foreach (var g in Groups.Where(g => g.ProductGroup == ActiveProductGroup))
                {
                    bool isChecked = SelectedGroupIds.Contains(g.Id);
                    int lsCount = g.MidGroups.Sum(m => m.LineShifts.Count);
                    <label class="json-file-item" title="@g.Name">
                        <input type="checkbox"
                               class="form-check-input"
                               checked="@isChecked"
                               @onchange="@(_ => OnToggleGroup.InvokeAsync(g.Id))" />
                        <span class="ngrate-picker-level">GROUP</span>
                        <span>@g.Name</span>
                        <span class="file-date ngrate-picker-count">@lsCount shifts</span>
                    </label>

                    @foreach (var entry in ChildEntryProvider(g))
                    {
                        var cap = entry;
                        bool subChecked = SelectedSubEntries.Contains(cap.Key);
                        int padPx = 8 + cap.Depth * 14;
                        string levelLabel = cap.Key.Contains("|mid|", StringComparison.Ordinal)
                            ? "MODEL"
                            : $"SUB {Math.Max(1, cap.Depth - 1)}";
                        <label class="json-file-item sub-row" title="@cap.Label" style="padding-left: @(padPx)px;">
                            <input type="checkbox"
                                   class="form-check-input"
                                   checked="@subChecked"
                                   @onchange="@(_ => OnToggleSubEntry.InvokeAsync(cap.Key))" />
                            <span class="ngrate-picker-level">@levelLabel</span>
                            <span>@cap.Label</span>
                            <span class="file-date ngrate-picker-count">@cap.LsCount shifts</span>
                        </label>
                    }
                }
                @if (!Groups.Any(g => g.ProductGroup == ActiveProductGroup))
                {
                    <div class="text-muted small py-2 text-center">
                        No groups in @ActiveProductGroup
                    </div>
                }
            </div>
        </div>
    }

    <div class="border-top pt-2 mt-2">
        <button class="btn btn-success w-100 btn-sm"
                @onclick="OnGetReport"
                disabled="@(IsReportBusy || IsBusy || !IsCredentialsConfigured)">
            @if (IsReportBusy || IsBusy)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                <span>Processing...</span>
            }
            else
            {
                <span>Get Report</span>
                @if (SelectedCount > 0)
                {
                    <span class="ms-1 opacity-75" style="font-size:10px;">(@SelectedCount group@(SelectedCount == 1 ? "" : "s"))</span>
                }
            }
        </button>
        @if (!string.IsNullOrEmpty(ReportError))
        {
            <div class="text-danger small mt-1">@ReportError</div>
        }
    </div>
</div>

@code {
    [Parameter] public IReadOnlyList<ModelGroupRecord> Groups { get; set; } = [];
    [Parameter] public IReadOnlySet<long> SelectedGroupIds { get; set; } = new HashSet<long>();
    [Parameter] public IReadOnlySet<string> SelectedSubEntries { get; set; } = new HashSet<string>(StringComparer.Ordinal);
    [Parameter] public string ActiveProductGroup { get; set; } = "ETC";
    [Parameter] public string Title { get; set; } = "Model Groups";
    [Parameter] public EventCallback<string> ActiveProductGroupChanged { get; set; }
    [Parameter] public Func<ModelGroupRecord, IEnumerable<ModelGroupChildEntry>> ChildEntryProvider { get; set; }
        = ModelGroupPickerHelpers.EnumerateChildEntries;

    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public bool IsReportBusy { get; set; }
    [Parameter] public bool IsCredentialsConfigured { get; set; }
    [Parameter] public string ReportError { get; set; } = string.Empty;

    [Parameter] public EventCallback OnRefresh { get; set; }
    [Parameter] public EventCallback<long> OnToggleGroup { get; set; }
    [Parameter] public EventCallback<string> OnToggleSubEntry { get; set; }
    [Parameter] public EventCallback OnGetReport { get; set; }

    private int SelectedCount => SelectedGroupIds.Count + SelectedSubEntries.Count;

    private IEnumerable<string> GroupProductGroups =>
        ModelGroupPickerHelpers.ProductGroupsWithRows(Groups);
}
