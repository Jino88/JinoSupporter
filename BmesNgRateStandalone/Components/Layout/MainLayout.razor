@inherits LayoutComponentBase

<div class="app-shell">
    <aside class="app-sidebar">
        <NavMenu />
    </aside>
    <main class="app-main">
        <div class="app-content">
            @Body
        </div>
    </main>
</div>

<div id="blazor-error-ui">
    <span class="err-msg">An unhandled error has occurred.</span>
    <a href="" class="reload">Reload</a>
    <a class="dismiss">×</a>
</div>
