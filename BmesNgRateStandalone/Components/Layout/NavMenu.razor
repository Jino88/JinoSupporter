    </div>
    <div class="nav-item">
        <NavLink class="nav-link" href="bmes/f-cost">
            <span class="nav-text">F-Cost</span>
        </NavLink>
    </div>
    <div class="nav-item">
        <NavLink class="nav-link" href="bmes/worker-status">
            <span class="nav-text">Worker Status</span>
        </NavLink>
    </div>

    <div class="nav-section">NG Rate</div>
