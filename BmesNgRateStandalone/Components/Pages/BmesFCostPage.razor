@page "/bmes/f-cost"
@using BmesNgRateStandalone.Services
@inject FCostService          FCost
@inject FCostReportService    FCostReportSvc
@inject NgRateSettingsService NgRateSettings
@inject WebRepository         Repo

<PageTitle>BMES — F-Cost</PageTitle>

<div class="d-flex align-items-center gap-2 mb-3">
    <span style="font-size:20px;">💰</span>
    <h5 class="mb-0 fw-semibold">F-Cost</h5>
</div>

<div class="row g-3">

    <!-- ══ Get Data ══════════════════════════════════════════════════════════ -->
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header small fw-semibold">Get Data</div>
            <div class="card-body d-flex flex-column gap-3">
                <div>
                    <div class="form-label small fw-semibold mb-1">Search Date (SDATE)</div>
                    <div class="d-flex gap-2 align-items-center flex-wrap">
                        <input type="date" class="form-control form-control-sm"
                               style="width:auto; min-width:160px;"
                               @bind="_queryDate" @bind:format="yyyy-MM-dd" />
                        <button class="btn btn-outline-secondary btn-sm" @onclick="SetToday">Today</button>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <span class="small text-muted">BMES:</span>
                    @if (NgRateSettings.IsCredentialsConfigured)
                    {
                        <span class="badge bg-success">Credentials OK</span>
                        <span class="small text-muted font-monospace">@NgRateSettings.LoginId</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">Not configured</span>
                        <a href="/admin/settings" class="small text-primary">→ Admin Settings</a>
                    }
                </div>

                <div class="small text-muted">
                    Save folder:
                    <span class="font-monospace text-break">@NgRateSettings.FCostDbSaveDirectory</span>
                </div>

                <button class="btn btn-primary"
                        @onclick="GetDataAsync"
                        disabled="@(_isBusy || !NgRateSettings.IsCredentialsConfigured)">
                    @if (_isBusy)
                    { <span class="spinner-border spinner-border-sm me-1"></span><span>Fetching…</span> }
                    else { <span>Get Data</span> }
                </button>

                @if (!string.IsNullOrEmpty(_savedDbPath))
                {
                    <div class="alert alert-success py-2 small mb-0">
                        <div class="fw-semibold mb-1">
                            <span class="badge bg-success me-1">Done</span> Saved DB
                        </div>
                        <div class="font-monospace text-break" style="font-size:11px;">@_savedDbPath</div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert alert-danger py-2 small mb-0">
                        <span class="badge bg-danger me-1">Error</span> @_errorMessage
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ══ Generate Report ═══════════════════════════════════════════════════ -->
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header small fw-semibold">Report</div>
            <div class="card-body d-flex flex-column gap-2">
                <div class="small text-muted">
                    Builds the report from <code>fcost_raw.db</code>. Dates up to 3 days before
                    the selected end date use cached RAW data; the last 3 dates are refreshed.
                </div>

                <div class="row g-2 align-items-end">
                    <div class="col-sm-auto">
                        <label class="form-label small text-muted mb-1">Start</label>
                        <input type="date" class="form-control form-control-sm"
                               @bind="_reportStartDate" @bind:format="yyyy-MM-dd" />
                    </div>
                    <div class="col-sm-auto">
                        <label class="form-label small text-muted mb-1">End</label>
                        <input type="date" class="form-control form-control-sm"
                               @bind="_reportEndDate" @bind:format="yyyy-MM-dd" />
                    </div>
                </div>

                <!-- Row visibility toggles -->
                <div class="d-flex align-items-center gap-3 mt-1 small">
                    <span class="text-muted fw-semibold" style="font-size:11px;">Show rows:</span>
                    <label class="form-check-inline d-flex align-items-center gap-1 m-0" style="font-size:11px;">
                        <input type="checkbox" class="form-check-input m-0" @bind="_showInput" />
                        <span>INPUT</span>
                    </label>
                    <label class="form-check-inline d-flex align-items-center gap-1 m-0" style="font-size:11px;">
                        <input type="checkbox" class="form-check-input m-0" @bind="_showCost" />
                        <span>F-COST</span>
                    </label>
                    <label class="form-check-inline d-flex align-items-center gap-1 m-0" style="font-size:11px;">
                        <input type="checkbox" class="form-check-input m-0" @bind="_showRate" />
                        <span>RATE %</span>
                    </label>
                </div>

                <button class="btn btn-success mt-1"
                        @onclick="GetReportAsync"
                        disabled="@(_isReportBusy || !NgRateSettings.IsCredentialsConfigured)">
                    @if (_isReportBusy)
                    { <span class="spinner-border spinner-border-sm me-1"></span><span>Loading…</span> }
                    else { <span>▶ Generate Report</span> }
                </button>
                @if (!NgRateSettings.IsCredentialsConfigured)
                {
                    <div class="small text-muted">BMES credentials are required for recent-date refresh.</div>
                }
                @if (!string.IsNullOrEmpty(_reportStatusMessage))
                {
                    <div class="small text-muted">@_reportStatusMessage</div>
                }
            </div>
        </div>
    </div>
</div>

<!-- ══ Model / Line-Group roll-up (sums of Input + F-Cost across matching Materials) ══ -->
<div class="row g-3 mt-1">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header small fw-semibold">F-COST RAW Backfill</div>
            <div class="card-body d-flex flex-column gap-3">
                <div class="small text-muted">
                    Pulls one BMES F-COST day at a time into <code>fcost_raw.db</code>.
                    Successful dates are skipped on the next run unless Force is checked.
                </div>

                <div class="row g-2 align-items-end">
                    <div class="col-sm-auto">
                        <label class="form-label small text-muted mb-1">Start</label>
                        <input type="date" class="form-control form-control-sm"
                               @bind="_rawStartDate" @bind:format="yyyy-MM-dd" />
                    </div>
                    <div class="col-sm-auto">
                        <label class="form-label small text-muted mb-1">End</label>
                        <input type="date" class="form-control form-control-sm"
                               @bind="_rawEndDate" @bind:format="yyyy-MM-dd" />
                    </div>
                    <div class="col-sm-auto">
                        <label class="form-check small mb-2">
                            <input class="form-check-input" type="checkbox" @bind="_rawForce" />
                            <span class="form-check-label">Force re-fetch</span>
                        </label>
                    </div>
                    <div class="col-sm-auto">
                        <button class="btn btn-outline-primary btn-sm"
                                @onclick="BackfillRawAsync"
                                disabled="@(_isRawBackfillBusy || !NgRateSettings.IsCredentialsConfigured)">
                            @if (_isRawBackfillBusy)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span><span>Running</span>
                            }
                            else
                            {
                                <span>Backfill RAW</span>
                            }
                        </button>
                    </div>
                </div>

                <div class="small">
                    <div><span class="text-muted">RAW DB:</span> <span class="font-monospace text-break">@FCost.GetRawDbPath()</span></div>
                    @if (_rawStatus is not null && _rawStatus.Exists)
                    {
                        <div class="text-muted">
                            Pulls @_rawStatus.SuccessCount:N0 OK / @_rawStatus.FailedCount:N0 failed,
                            rows @_rawStatus.TotalRows:N0,
                            range @_rawStatus.FirstDate - @_rawStatus.LastDate
                        </div>
                    }
                    else
                    {
                        <div class="text-muted">No RAW DB yet.</div>
                    }
                </div>

                @if (_rawBackfillResult is not null)
                {
                    <div class="alert alert-success py-2 small mb-0">
                        Done: fetched @_rawBackfillResult.FetchedDays:N0,
                        skipped @_rawBackfillResult.SkippedDays:N0,
                        failed @_rawBackfillResult.FailedDays:N0,
                        rows @_rawBackfillResult.TotalRows:N0
                    </div>
                }
                @if (!string.IsNullOrEmpty(_rawBackfillError))
                {
                    <div class="alert alert-danger py-2 small mb-0">@_rawBackfillError</div>
                }
                @if (_rawBackfillProgress.Count > 0)
                {
                    <div class="small font-monospace bg-light border rounded p-2"
                         style="max-height:160px; overflow:auto; white-space:pre-wrap;">
                        @foreach (var line in _rawBackfillProgress.TakeLast(12))
                        {
                            <div>@line</div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (_report is not null && HasPeriodColumnToggles)
{
    <div class="d-flex align-items-center gap-2 flex-wrap mt-3 small">
        <span class="text-muted fw-semibold">Columns:</span>
        @if (PeriodColumnCount(FCostPeriodKind.Day) > DayColumnCollapseLimit)
        {
            <button class="btn btn-outline-secondary btn-sm py-0" @onclick="ToggleDayColumns">
                Day @VisiblePeriodColumnCount(FCostPeriodKind.Day)/@PeriodColumnCount(FCostPeriodKind.Day)
                @(_showAllDayColumns ? "Fold" : "Expand")
            </button>
        }
        @if (PeriodColumnCount(FCostPeriodKind.Week) > WeekColumnCollapseLimit)
        {
            <button class="btn btn-outline-secondary btn-sm py-0" @onclick="ToggleWeekColumns">
                Week @VisiblePeriodColumnCount(FCostPeriodKind.Week)/@PeriodColumnCount(FCostPeriodKind.Week)
                @(_showAllWeekColumns ? "Fold" : "Expand")
            </button>
        }
        @if (PeriodColumnCount(FCostPeriodKind.Month) > MonthColumnCollapseLimit)
        {
            <button class="btn btn-outline-secondary btn-sm py-0" @onclick="ToggleMonthColumns">
                Month @VisiblePeriodColumnCount(FCostPeriodKind.Month)/@PeriodColumnCount(FCostPeriodKind.Month)
                @(_showAllMonthColumns ? "Fold" : "Expand")
            </button>
        }
    </div>
}

@if (_report is not null && (_report.SubGroups.Count > 0 || _report.Total is not null))
{
    var subColumnIndexes = VisibleFCostColumnIndexes();
    <div class="card shadow-sm mt-3">
        <div class="card-header small fw-semibold d-flex align-items-center gap-2">
            <span>📋 Model / Line-Group Summary — Σ Input · Σ F-Cost · Rate% (recomputed from sums)</span>
            <span class="text-muted" style="font-size:11px;">
                @_report.SubGroups.Count line-group bucket(s) · @_report.UnmappedMaterials.Count unmapped
                · sorted by previous-week Rate%
            </span>
        </div>
        <div class="card-body p-0">
            <div style="overflow-x:auto;">
                <table class="fcost-table">
                    <thead>
                        <tr>
                            <th class="label-th" style="width:260px;">Model / Building / Line</th>
                            <th class="label-th" style="width:100px;">Type</th>
                            @foreach (int ci in subColumnIndexes)
                            {
                                <th class="@ColBoundaryClass(ci)">@_report.ColumnHeaders[ci]</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int sgRows = VisibleRowCount;
                            bool sgLabelOnInput = _showInput;
                            bool sgLabelOnCost  = !_showInput && _showCost;
                            bool sgLabelOnRate  = !_showInput && !_showCost && _showRate;
                        }
                        @* Total row — recomputed from the SubGroup sums (same
                           helper feeds the bottom per-Material table's Total row
                           below, so top + bottom always agree). _report.Total
                           from BMES often misses INAMT and would render all
                           "-"; the sum-of-subgroups never has that gap. *@
                        @if (sgRows > 0)
                        {
                            string totalLbl = "Total";
                            int N = subColumnIndexes.Count;
                            var (totalInput, totalCost) = ComputeSubGroupTotals(subColumnIndexes);

                            @if (_showInput)
                            {
                                <tr class="fcost-row-total">
                                    @if (sgLabelOnInput)
                                    {
                                        <td class="label-td" rowspan="@sgRows"><strong>@totalLbl</strong></td>
                                    }
                                    <td class="label-td"><span class="ztype-badge">INPUT</span></td>
                                    @for (int i = 0; i < N; i++)
                                    {
                                        double v = totalInput[i];
                                        <td class="@(v == 0 ? "zero" : "") @ColBoundaryClass(subColumnIndexes[i])">@FormatNum(v)</td>
                                    }
                                </tr>
                            }
                            @if (_showCost)
                            {
                                <tr class="fcost-row-total">
                                    @if (sgLabelOnCost)
                                    {
                                        <td class="label-td" rowspan="@sgRows"><strong>@totalLbl</strong></td>
                                    }
                                    <td class="label-td"><span class="ztype-badge">F-COST</span></td>
                                    @for (int i = 0; i < N; i++)
                                    {
                                        double v = totalCost[i];
                                        <td class="@(v == 0 ? "zero" : "") @ColBoundaryClass(subColumnIndexes[i])">@FormatNum(v)</td>
                                    }
                                </tr>
                            }
                            @if (_showRate)
                            {
                                <tr class="fcost-row-total">
                                    @if (sgLabelOnRate)
                                    {
                                        <td class="label-td" rowspan="@sgRows"><strong>@totalLbl</strong></td>
                                    }
                                    <td class="label-td"><span class="ztype-badge">RATE %</span></td>
                                    @for (int i = 0; i < N; i++)
                                    {
                                        // Weighted rate: Σcost / Σinput * 100. 0 if input=0.
                                        double v = totalInput[i] > 0
                                            ? totalCost[i] / totalInput[i] * 100.0
                                            : 0;
                                        <td class="@(v == 0 ? "zero" : "") @ColBoundaryClass(subColumnIndexes[i])">@FormatRate(v)</td>
                                    }
                                </tr>
                            }
                        }
                        @* Mid → Sub1 → Sub2 expand/collapse hierarchy. Mid rows are always
                           visible; Sub rows render only when their ancestor is expanded.
                           InputByCol/CostByCol on parent rows are sums of leaf descendants. *@
                        @{
                            var hierarchyRows = BuildFCostHierarchy();
                            var fcostById     = hierarchyRows.ToDictionary(r => r.RowId);
                            var fcostHasKids  = hierarchyRows
                                .Where(r => r.ParentId is not null)
                                .Select(r => r.ParentId!)
                                .ToHashSet(StringComparer.Ordinal);
                        }
                        @foreach (var row in hierarchyRows.Where(r => IsFCostRowVisible(r, fcostById)))
                        {
                            if (sgRows == 0) { continue; }
                            int    padPx     = 8 + row.Depth * 16;
                            bool   canExp    = fcostHasKids.Contains(row.RowId);
                            bool   expanded  = _expandedFCostRows.Contains(row.RowId);
                            string capturedId = row.RowId;
                            string rowCls    = row.Depth switch
                            {
                                0 => "fcost-row-mid",
                                1 => "fcost-row-sub1",
                                _ => "fcost-row-sub2"
                            };
                            @if (_showInput)
                            {
                                <tr class="@rowCls">
                                    @if (sgLabelOnInput)
                                    {
                                        <td class="label-td" rowspan="@sgRows"
                                            style="padding-left: @(padPx)px; cursor: @(canExp ? "pointer" : "default");"
                                            @onclick="@(() => { if (canExp) ToggleFCostRow(capturedId); })">
                                            @if (canExp)
                                            { <span class="fcost-tog">@(expanded ? "▼" : "▶")</span> }
                                            else
                                            { <span class="fcost-tog fcost-tog-blank"></span> }
                                            <span class="hier-level-badge">@FCostLevelLabel(row, fcostHasKids)</span>
                                            <strong class="ms-1">@row.Display</strong>
                                        </td>
                                    }
                                    <td class="label-td"><span class="ztype-badge">INPUT</span></td>
                                    @foreach (int ci in subColumnIndexes)
                                    {
                                        double v = row.InputByCol[ci];
                                        <td class="@(v == 0 ? "zero" : "") @ColBoundaryClass(ci, oneBased: false)">@FormatNum(v)</td>
                                    }
                                </tr>
                            }
                            @if (_showCost)
                            {
                                <tr class="@rowCls">
                                    @if (sgLabelOnCost)
                                    {
                                        <td class="label-td" rowspan="@sgRows"
                                            style="padding-left: @(padPx)px; cursor: @(canExp ? "pointer" : "default");"
                                            @onclick="@(() => { if (canExp) ToggleFCostRow(capturedId); })">
                                            @if (canExp)
                                            { <span class="fcost-tog">@(expanded ? "▼" : "▶")</span> }
                                            else
                                            { <span class="fcost-tog fcost-tog-blank"></span> }
                                            <span class="hier-level-badge">@FCostLevelLabel(row, fcostHasKids)</span>
                                            <strong class="ms-1">@row.Display</strong>
                                        </td>
                                    }
                                    <td class="label-td"><span class="ztype-badge">F-COST</span></td>
                                    @foreach (int ci in subColumnIndexes)
                                    {
                                        double v = row.CostByCol[ci];
                                        <td class="@(v == 0 ? "zero" : "") @ColBoundaryClass(ci, oneBased: false)">@FormatNum(v)</td>
                                    }
                                </tr>
                            }
                            @if (_showRate)
                            {
                                <tr class="@rowCls">
                                    @if (sgLabelOnRate)
                                    {
                                        <td class="label-td" rowspan="@sgRows"
                                            style="padding-left: @(padPx)px; cursor: @(canExp ? "pointer" : "default");"
                                            @onclick="@(() => { if (canExp) ToggleFCostRow(capturedId); })">
                                            @if (canExp)
                                            { <span class="fcost-tog">@(expanded ? "▼" : "▶")</span> }
                                            else
                                            { <span class="fcost-tog fcost-tog-blank"></span> }
                                            <span class="hier-level-badge">@FCostLevelLabel(row, fcostHasKids)</span>
                                            <strong class="ms-1">@row.Display</strong>
                                        </td>
                                    }
                                    <td class="label-td"><span class="ztype-badge">RATE %</span></td>
                                    @{ var rate = row.RateByCol; }
                                    @foreach (int ci in subColumnIndexes)
                                    {
                                        double v = rate[ci];
                                        <td class="@(v == 0 ? "zero" : "") @ColBoundaryClass(ci, oneBased: false)">@FormatRate(v)</td>
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            @if (_report.UnmappedMaterials.Count > 0)
            {
                <div class="alert alert-warning small m-3 mb-0">
                    <strong>Unmapped (@_report.UnmappedMaterials.Count):</strong>
                    Materials whose <code>MatnrTx_ModNoTx</code> (or fallback <code>MatnrTx_VeridTx</code>)
                    didn't match any LineShift in the saved ModelGroups —
                    @string.Join(", ", _report.UnmappedMaterials.Take(10).Select(m => m.DisplayName))
                    @(_report.UnmappedMaterials.Count > 10 ? $" … (+{_report.UnmappedMaterials.Count - 10})" : "")
                </div>
            }
        </div>
    </div>
}

<!-- ══ Total + per-Material table ═══════════════════════════════════════════ -->
@if (_report is not null)
{
    var materialColumnIndexes = VisibleFCostColumnIndexes();

    <div class="card shadow-sm mt-3">
        <div class="card-header small fw-semibold d-flex align-items-center gap-2">
            <span>📊 F-Cost — query date @_report.QueryDate</span>
            <span class="text-muted" style="font-size:11px;">
                @_report.Materials.Count materials · @_report.TotalRows rows
            </span>
        </div>
        <div class="card-body p-0">
            <div style="overflow-x:auto;">
                <table class="fcost-table">
                    <thead>
                        <tr>
                            <th class="label-th" style="width:280px;">제품명</th>
                            <th class="label-th" style="width:100px;">Type</th>
                            @foreach (int ci in materialColumnIndexes)
                            {
                                <th class="@ColBoundaryClass(ci)">@_report.ColumnHeaders[ci]</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int matRows = VisibleRowCount;
                            bool matLabelOnInput = _showInput;
                            bool matLabelOnCost  = !_showInput && _showCost;
                            bool matLabelOnRate  = !_showInput && !_showCost && _showRate;
                        }
                        @* Bottom Total — same sum-of-subgroups helper as the
                           top SubGroup Summary uses, so the two Total rows
                           always show identical numbers. *@
                        @if (matRows > 0 && _report.SubGroups.Count > 0)
                        {
                            int Nb = materialColumnIndexes.Count;
                            var (botInput, botCost) = ComputeSubGroupTotals(materialColumnIndexes);
                            string botLbl = _report.Total?.DisplayName is { Length: > 0 } d2 ? d2 : "Total";

                            @if (_showInput)
                            {
                                <tr class="fcost-row-total">
                                    @if (matLabelOnInput)
                                    {
                                        <td class="label-td" rowspan="@matRows"><strong>@botLbl</strong></td>
                                    }
                                    <td class="label-td"><span class="ztype-badge">INPUT</span></td>
                                    @for (int i = 0; i < Nb; i++)
                                    {
                                        double v = botInput[i];
                                        <td class="@(v == 0 ? "zero" : "") @ColBoundaryClass(materialColumnIndexes[i])">@FormatNum(v)</td>
                                    }
                                </tr>
                            }
                            @if (_showCost)
                            {
                                <tr class="fcost-row-total">
                                    @if (matLabelOnCost)
                                    {
                                        <td class="label-td" rowspan="@matRows"><strong>@botLbl</strong></td>
                                    }
                                    <td class="label-td"><span class="ztype-badge">F-COST</span></td>
                                    @for (int i = 0; i < Nb; i++)
                                    {
                                        double v = botCost[i];
                                        <td class="@(v == 0 ? "zero" : "") @ColBoundaryClass(materialColumnIndexes[i])">@FormatNum(v)</td>
                                    }
                                </tr>
                            }
                            @if (_showRate)
                            {
                                <tr class="fcost-row-total">
                                    @if (matLabelOnRate)
                                    {
                                        <td class="label-td" rowspan="@matRows"><strong>@botLbl</strong></td>
                                    }
                                    <td class="label-td"><span class="ztype-badge">RATE %</span></td>
                                    @for (int i = 0; i < Nb; i++)
                                    {
                                        double v = botInput[i] > 0 ? botCost[i] / botInput[i] * 100.0 : 0;
                                        <td class="@(v == 0 ? "zero" : "") @ColBoundaryClass(materialColumnIndexes[i])">@FormatRate(v)</td>
                                    }
                                </tr>
                            }
                        }
                        @foreach (var block in _report.Materials)
                        {
                            if (matRows == 0) { continue; }
                            @if (_showInput)
                            {
                                <tr class="fcost-row-input">
                                    @if (matLabelOnInput)
                                    {
                                        <td class="label-td" rowspan="@matRows">
                                            <strong>@block.DisplayName</strong>
                                            @if (!string.IsNullOrEmpty(block.ProductGroup))
                                            {
                                                <div class="text-muted" style="font-size:10px;">@block.ProductGroup</div>
                                            }
                                        </td>
                                    }
                                    <td class="label-td"><span class="ztype-badge">INPUT</span></td>
                                    @foreach (int ci in materialColumnIndexes)
                                    {
                                        double v = block.Input?.GetCol(ci + 1) ?? 0;
                                        <td class="@(v == 0 ? "zero" : "") @ColBoundaryClass(ci)">@FormatNum(v)</td>
                                    }
                                </tr>
                            }
                            @if (_showCost)
                            {
                                <tr class="fcost-row-cost">
                                    @if (matLabelOnCost)
                                    {
                                        <td class="label-td" rowspan="@matRows">
                                            <strong>@block.DisplayName</strong>
                                            @if (!string.IsNullOrEmpty(block.ProductGroup))
                                            {
                                                <div class="text-muted" style="font-size:10px;">@block.ProductGroup</div>
                                            }
                                        </td>
                                    }
                                    <td class="label-td"><span class="ztype-badge">F-COST</span></td>
                                    @foreach (int ci in materialColumnIndexes)
                                    {
                                        double v = block.Cost?.GetCol(ci + 1) ?? 0;
                                        <td class="@(v == 0 ? "zero" : "") @ColBoundaryClass(ci)">@FormatNum(v)</td>
                                    }
                                </tr>
                            }
                            @if (_showRate)
                            {
                                <tr class="fcost-row-rate">
                                    @if (matLabelOnRate)
                                    {
                                        <td class="label-td" rowspan="@matRows">
                                            <strong>@block.DisplayName</strong>
                                            @if (!string.IsNullOrEmpty(block.ProductGroup))
                                            {
                                                <div class="text-muted" style="font-size:10px;">@block.ProductGroup</div>
                                            }
                                        </td>
                                    }
                                    <td class="label-td"><span class="ztype-badge">RATE %</span></td>
                                    @foreach (int ci in materialColumnIndexes)
                                    {
                                        double input = block.Input?.GetCol(ci + 1) ?? 0;
                                        double cost = block.Cost?.GetCol(ci + 1) ?? 0;
                                        double v = input > 0 ? cost / input * 100.0 : 0;
                                        <td class="@(v == 0 ? "zero" : "") @ColBoundaryClass(ci)">@FormatRate(v)</td>
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
@if (!string.IsNullOrEmpty(_reportError))
{
    <div class="alert alert-danger mt-3 py-2 small">@_reportError</div>
}

<style>
    .fcost-table { font-size: 12px; white-space: nowrap; border-collapse: collapse; width: 100%; }
    .fcost-table th {
        background: #f1f5f9; font-weight: 700; font-size: 10px; color: #64748b;
        text-transform: uppercase; letter-spacing: .4px;
        padding: 5px 10px; text-align: right; border-bottom: 1px solid #e2e8f0;
        position: sticky; top: 0; z-index: 1;
    }
    .fcost-table th.label-th { text-align: left; }
    .fcost-table td {
        padding: 4px 10px; border-bottom: 1px solid #f1f5f9;
        text-align: right; font-family: monospace;
    }
    .fcost-table td.label-td { text-align: left; font-family: inherit; }

    .fcost-row-total td  { background: #fef3c7; color: #78350f; font-weight: 700;
                            border-top: 2px solid #fbbf24; }
    .fcost-row-input td  { background: #eff6ff; }
    .fcost-row-cost  td  { background: #fff; }
    .fcost-row-rate  td  { background: #f0fdf4; color: #166534; font-weight: 600; }

    .ztype-badge {
        display: inline-block; font-size: 10px; font-weight: 700;
        padding: 1px 7px; border: 1px solid #cbd5e1; border-radius: 3px;
        background: #f8fafc; color: #475569;
    }
    .zero { color: #cbd5e1; }

    /* SubGroup Summary — Mid → Sub1 → Sub2 expand/collapse hierarchy */
    .fcost-row-mid  td { background: #fef3c7; color: #78350f; font-weight: 700;
                        border-top: 2px solid #fbbf24; }
    .fcost-row-sub1 td { background: #eff6ff; color: #1e293b; font-weight: 600; }
    .fcost-row-sub2 td { background: #fff;    color: #475569; font-weight: 500; font-size: 11.5px; }
    .fcost-tog        { display: inline-block; width: 14px; color: #6366f1;
                        font-size: 10px; margin-right: 4px; }
    .fcost-tog-blank  { width: 14px; }

    /* Day / Week / Month period dividers — left border on the first column of each
       period block. Heavier than the regular row border so the eye picks out where
       the day → week → month transition happens. */
    .fcost-table th.col-day-start,
    .fcost-table td.col-day-start    { border-left: 2px solid #93c5fd; }
    .fcost-table th.col-week-start,
    .fcost-table td.col-week-start   { border-left: 2px solid #86efac; }
    .fcost-table th.col-month-start,
    .fcost-table td.col-month-start  { border-left: 2px solid #fcd34d; }
</style>

@code {
    /// <summary>Sum InputByCol / CostByCol across every saved SubGroup. Both
    /// the SubGroup Summary's Total row and the per-Material table's Total row
    /// call this so the two Totals are always identical (same data, same code
    /// path). Unmapped materials are excluded by design — they appear in the
    /// "Unmapped (N)" callout below the SubGroup Summary instead.</summary>
    private (double[] Input, double[] Cost) ComputeSubGroupTotals(IReadOnlyList<int> columnIndexes)
    {
        int columnCount = columnIndexes.Count;
        var input = new double[columnCount];
        var cost  = new double[columnCount];
        if (_report is null) return (input, cost);

        if (_report.Total is not null)
        {
            for (int i = 0; i < columnCount; i++)
            {
                int sourceIdx = columnIndexes[i] + 1;
                input[i] = _report.Total.Input?.GetCol(sourceIdx) ?? 0;
                cost[i]  = _report.Total.Cost ?.GetCol(sourceIdx) ?? 0;
            }
            return (input, cost);
        }

        foreach (var sg in _report.SubGroups)
        {
            for (int i = 0; i < columnCount; i++)
            {
                int sourceIdx = columnIndexes[i];
                if (sourceIdx >= sg.InputByCol.Length) continue;
                input[i] += sg.InputByCol[sourceIdx];
                cost[i]  += sg.CostByCol[sourceIdx];
            }
        }
        return (input, cost);
    }

    private static string FormatNum(double v)
        => v == 0 ? "-" : ((long)Math.Round(v)).ToString("N0");

    private static string FormatRate(double v)
        => v == 0 ? "-" : v.ToString("0.00") + "%";

    private DateTime _queryDate    = DateTime.Today;
    private bool     _isBusy;
    private string?  _savedDbPath;
    private string   _errorMessage = string.Empty;

    private DateTime _rawStartDate = new(2025, 1, 1);
    private DateTime _rawEndDate   = DateTime.Today;
    private bool     _rawForce;
    private bool     _isRawBackfillBusy;
    private string   _rawBackfillError = string.Empty;
    private List<string> _rawBackfillProgress = new();
    private FCostRawBackfillResult? _rawBackfillResult;
    private FCostRawStatus? _rawStatus;

    private bool         _isReportBusy;
    private string       _reportError = string.Empty;
    private string       _reportStatusMessage = string.Empty;
    private DateTime     _reportStartDate = DateTime.Today.AddDays(-13);
    private DateTime     _reportEndDate   = DateTime.Today;
    private FCostReport? _report;

    // Row visibility toggles — control which Z-type rows render in both tables.
    private bool _showInput = true;
    private bool _showCost  = true;
    private bool _showRate  = true;

    private const int DayColumnCollapseLimit = 8;
    private const int WeekColumnCollapseLimit = 5;
    private const int MonthColumnCollapseLimit = 4;

    private bool _showAllDayColumns;
    private bool _showAllWeekColumns;
    private bool _showAllMonthColumns;

    private int VisibleRowCount =>
        (_showInput ? 1 : 0) + (_showCost ? 1 : 0) + (_showRate ? 1 : 0);

    // SubGroup Summary hierarchy: rows in the table are tied together by parentId
    // so the user can collapse / expand Mid → Sub1 → Sub2 trees. By default only
    // the top (Mid) rows are visible; clicking opens deeper levels.
    private HashSet<string> _expandedFCostRows = new(StringComparer.Ordinal);

    protected override void OnInitialized()
    {
        _rawStatus = FCost.GetRawStatus();
    }

    private bool HasPeriodColumnToggles =>
        PeriodColumnCount(FCostPeriodKind.Day) > DayColumnCollapseLimit ||
        PeriodColumnCount(FCostPeriodKind.Week) > WeekColumnCollapseLimit ||
        PeriodColumnCount(FCostPeriodKind.Month) > MonthColumnCollapseLimit;

    private void ToggleDayColumns() => _showAllDayColumns = !_showAllDayColumns;
    private void ToggleWeekColumns() => _showAllWeekColumns = !_showAllWeekColumns;
    private void ToggleMonthColumns() => _showAllMonthColumns = !_showAllMonthColumns;

    private int PeriodColumnCount(FCostPeriodKind kind)
        => _report?.Columns.Count(c => c.Kind == kind) ?? 0;

    private int VisiblePeriodColumnCount(FCostPeriodKind kind)
    {
        int total = PeriodColumnCount(kind);
        int limit = PeriodCollapseLimit(kind);
        return IsPeriodExpanded(kind) || total <= limit ? total : limit;
    }

    private List<int> VisibleFCostColumnIndexes()
    {
        if (_report is null) return new List<int>();
        if (_report.Columns.Count == 0)
            return Enumerable.Range(0, _report.ColumnHeaders.Count).ToList();

        int dayTotal = PeriodColumnCount(FCostPeriodKind.Day);
        int weekTotal = PeriodColumnCount(FCostPeriodKind.Week);
        int monthTotal = PeriodColumnCount(FCostPeriodKind.Month);
        int daySeen = 0;
        int weekSeen = 0;
        int monthSeen = 0;
        var indexes = new List<int>(_report.Columns.Count);

        for (int i = 0; i < _report.Columns.Count; i++)
        {
            var kind = _report.Columns[i].Kind;
            bool show = kind switch
            {
                FCostPeriodKind.Day => ShouldShowPeriodColumn(kind, ++daySeen, dayTotal),
                FCostPeriodKind.Week => ShouldShowPeriodColumn(kind, ++weekSeen, weekTotal),
                FCostPeriodKind.Month => ShouldShowPeriodColumn(kind, ++monthSeen, monthTotal),
                _ => true,
            };
            if (show) indexes.Add(i);
        }

        return indexes;
    }

    private static int PeriodCollapseLimit(FCostPeriodKind kind) => kind switch
    {
        FCostPeriodKind.Day => DayColumnCollapseLimit,
        FCostPeriodKind.Week => WeekColumnCollapseLimit,
        FCostPeriodKind.Month => MonthColumnCollapseLimit,
        _ => int.MaxValue,
    };

    private bool IsPeriodExpanded(FCostPeriodKind kind) => kind switch
    {
        FCostPeriodKind.Day => _showAllDayColumns,
        FCostPeriodKind.Week => _showAllWeekColumns,
        FCostPeriodKind.Month => _showAllMonthColumns,
        _ => true,
    };

    private bool ShouldShowPeriodColumn(FCostPeriodKind kind, int seen, int total)
    {
        int limit = PeriodCollapseLimit(kind);
        return total <= limit || IsPeriodExpanded(kind) || seen <= limit;
    }

    private void ToggleFCostRow(string rowId)
    {
        if (!_expandedFCostRows.Remove(rowId)) _expandedFCostRows.Add(rowId);
    }

    /// <summary>One row in the SubGroup-Summary tree. <see cref="InputByCol"/> /
    /// <see cref="CostByCol"/> are the SUM of every leaf descendant under this node;
    /// <see cref="RateByCol"/> is recomputed from the sums to preserve weighting.</summary>
    private sealed record FCostHierarchyRow(
        string   RowId,
        string?  ParentId,
        string   Display,
        int      Depth,
        int      MatchedMaterialCount,
        double[] InputByCol,
        double[] CostByCol)
    {
        public double[] RateByCol
        {
            get
            {
                var arr = new double[InputByCol.Length];
                for (int i = 0; i < arr.Length; i++)
                    arr[i] = InputByCol[i] > 0 ? CostByCol[i] / InputByCol[i] * 100.0 : 0;
                return arr;
            }
        }
    }

    /// <summary>Build the Mid → Sub1 → Sub2 hierarchy from <c>_report.SubGroups</c>.
    /// The flat leaf rows are bucketed by (GroupName, MidGroupName) for the Mid level
    /// and by the first path segment of <c>SubGroupKey</c> for Sub1. Leaves whose
    /// path is two segments or deeper emit Sub2 rows; one-segment leaves stop at Sub1
    /// (the leaf <em>is</em> the Sub1, no redundant duplicate).</summary>
    private List<FCostHierarchyRow> BuildFCostHierarchy()
    {
        var rows = new List<FCostHierarchyRow>();
        if (_report is null || _report.SubGroups.Count == 0) return rows;

        int colCount = _report.ColumnHeaders.Count;

        var byMid = _report.SubGroups
            .GroupBy(sg => new { sg.GroupName, sg.MidGroupName })
            .OrderBy(g => g.Key.GroupName,    StringComparer.Ordinal)
            .ThenBy (g => g.Key.MidGroupName, StringComparer.Ordinal);

        foreach (var midGroup in byMid)
        {
            string midRowId = $"M::{midGroup.Key.GroupName}::{midGroup.Key.MidGroupName}";
            var midInput   = new double[colCount];
            var midCost    = new double[colCount];
            int midMatCnt  = 0;
            foreach (var sg in midGroup)
            {
                for (int i = 0; i < colCount; i++)
                {
                    midInput[i] += sg.InputByCol[i];
                    midCost[i]  += sg.CostByCol[i];
                }
                midMatCnt += sg.MatchedMaterialCount;
            }
            rows.Add(new FCostHierarchyRow(
                RowId: midRowId, ParentId: null,
                Display: midGroup.Key.MidGroupName, Depth: 0,
                MatchedMaterialCount: midMatCnt,
                InputByCol: midInput, CostByCol: midCost));

            // Group leaves under this Mid by first path segment to derive Sub1.
            var bySub1 = midGroup
                .Select(sg => new { Sg = sg, Segments = ParseSubPathSegments(sg.SubGroupKey) })
                .GroupBy(x => x.Segments.Length > 0 ? x.Segments[0] : x.Sg.Display, StringComparer.Ordinal);

            foreach (var sub1Group in bySub1)
            {
                string sub1Display = sub1Group.Key;
                string sub1RowId   = $"S1::{midRowId}::{sub1Display}";

                var s1Input  = new double[colCount];
                var s1Cost   = new double[colCount];
                int s1MatCnt = 0;
                foreach (var x in sub1Group)
                {
                    for (int i = 0; i < colCount; i++)
                    {
                        s1Input[i] += x.Sg.InputByCol[i];
                        s1Cost[i]  += x.Sg.CostByCol[i];
                    }
                    s1MatCnt += x.Sg.MatchedMaterialCount;
                }
                rows.Add(new FCostHierarchyRow(
                    RowId: sub1RowId, ParentId: midRowId,
                    Display: sub1Display, Depth: 1,
                    MatchedMaterialCount: s1MatCnt,
                    InputByCol: s1Input, CostByCol: s1Cost));

                // Sub2+ leaves only when the path has more than one segment — otherwise
                // the Sub1 row IS the leaf and a Sub2 row would just duplicate it.
                foreach (var x in sub1Group)
                {
                    if (x.Segments.Length <= 1) continue;
                    string leafDisplay = x.Segments[^1];
                    string leafRowId   = $"S2::{x.Sg.SubGroupKey}";
                    rows.Add(new FCostHierarchyRow(
                        RowId: leafRowId, ParentId: sub1RowId,
                        Display: leafDisplay, Depth: 2,
                        MatchedMaterialCount: x.Sg.MatchedMaterialCount,
                        InputByCol: x.Sg.InputByCol, CostByCol: x.Sg.CostByCol));
                }
            }
        }
        return rows;
    }

    /// <summary>Extract the path portion of a SubGroupKey ("Group::Material::path")
    /// and split it on the " / " separator FCostReportService uses internally.</summary>
    private static string[] ParseSubPathSegments(string subGroupKey)
    {
        int firstSep = subGroupKey.IndexOf("::", StringComparison.Ordinal);
        if (firstSep < 0) return Array.Empty<string>();
        int secondSep = subGroupKey.IndexOf("::", firstSep + 2, StringComparison.Ordinal);
        if (secondSep < 0) return Array.Empty<string>();
        string path = subGroupKey[(secondSep + 2)..];
        if (string.IsNullOrEmpty(path)) return Array.Empty<string>();
        return path.Split(" / ", StringSplitOptions.None);
    }

    private static string FCostLevelLabel(FCostHierarchyRow row, IReadOnlySet<string> rowsWithChildren)
    {
        if (row.Depth == 0) return "Model Name";
        if (row.Depth == 1 && rowsWithChildren.Contains(row.RowId)) return "Building-Group";
        return "Line-Group";
    }

    private bool IsFCostRowVisible(
        FCostHierarchyRow row,
        IReadOnlyDictionary<string, FCostHierarchyRow> byId)
    {
        string? pid = row.ParentId;
        while (pid is not null)
        {
            if (!_expandedFCostRows.Contains(pid)) return false;
            pid = byId.TryGetValue(pid, out var p) ? p.ParentId : null;
        }
        return true;
    }

    /// <summary>CSS class for cells at the start of a Day / Week / Month period
    /// block so the table draws a heavier divider where the period kind changes.
    /// <paramref name="oneBased"/>=true when the caller iterates with 1..N indexing
    /// (matches FCostRow.GetCol). Returns empty for the very first column (no
    /// preceding kind to compare against) or when the period kind matches the
    /// previous column.</summary>
    private string ColBoundaryClass(int idx, bool oneBased = false)
    {
        if (_report is null) return string.Empty;
        var cols = _report.Columns;
        int zeroIdx = oneBased ? idx - 1 : idx;
        if (zeroIdx <= 0 || zeroIdx >= cols.Count) return string.Empty;
        var cur  = cols[zeroIdx].Kind;
        var prev = cols[zeroIdx - 1].Kind;
        if (cur == prev) return string.Empty;
        return cur switch
        {
            FCostPeriodKind.Day   => "col-day-start",
            FCostPeriodKind.Week  => "col-week-start",
            FCostPeriodKind.Month => "col-month-start",
            _                     => string.Empty,
        };
    }

    private bool HasUsableDb =>
        (!string.IsNullOrEmpty(_savedDbPath) && File.Exists(_savedDbPath)) ||
        FCostReportSvc.FindMostRecentDb() is { Length: > 0 };

    private void SetToday() => _queryDate = DateTime.Today;

    private async Task BackfillRawAsync()
    {
        if (_isRawBackfillBusy) return;

        _isRawBackfillBusy = true;
        _rawBackfillError = string.Empty;
        _rawBackfillResult = null;
        _rawBackfillProgress.Clear();
        StateHasChanged();

        var progress = new Progress<string>(msg =>
        {
            _rawBackfillProgress.Add(msg);
            if (_rawBackfillProgress.Count > 80)
                _rawBackfillProgress.RemoveRange(0, _rawBackfillProgress.Count - 80);
            _ = InvokeAsync(StateHasChanged);
        });

        try
        {
            _rawBackfillResult = await FCost.BackfillRawAsync(
                _rawStartDate,
                _rawEndDate,
                force: _rawForce,
                progress: progress);
            _rawStatus = FCost.GetRawStatus();
        }
        catch (Exception ex)
        {
            _rawBackfillError = ex.Message;
        }
        finally
        {
            _isRawBackfillBusy = false;
            StateHasChanged();
        }
    }

    private async Task GetDataAsync()
    {
        _errorMessage = string.Empty;
        _savedDbPath  = null;
        _isBusy       = true;
        StateHasChanged();

        var progress = new Progress<string>(_ => { });
        try
        {
            string? dbPath = await FCost.FetchAndSaveAsync(_queryDate, progress);
            if (string.IsNullOrEmpty(dbPath))
                _errorMessage = "Fetch failed — check credentials / logs.";
            else
                _savedDbPath = dbPath;
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isBusy = false;
            StateHasChanged();
        }
    }

    private async Task GetReportAsync()
    {
        if (_isReportBusy) return;
        _isReportBusy = true;
        _reportError = string.Empty;
        _reportStatusMessage = string.Empty;
        _report = null;
        StateHasChanged();

        try
        {
            DateTime start = _reportStartDate.Date;
            DateTime end = _reportEndDate.Date;
            DateTime today = DateTime.Today;
            if (end > today) end = today;
            if (start > end)
            {
                _reportError = "Report start date must be before or equal to end date.";
                return;
            }

            DateTime forceFrom = end.AddDays(-2);
            _reportStatusMessage =
                $"Preparing RAW cache. Cached through {forceFrom.AddDays(-1):yyyy-MM-dd}; refreshing {forceFrom:yyyy-MM-dd} - {end:yyyy-MM-dd}.";

            var progress = new Progress<string>(msg =>
            {
                _reportStatusMessage = msg;
                _ = InvokeAsync(StateHasChanged);
            });

            await FCost.BackfillRawAsync(
                start,
                end,
                force: false,
                forceFromDate: forceFrom,
                progress: progress);
            _rawStatus = FCost.GetRawStatus();

            var groups = Repo.GetModelGroups();
            _reportStatusMessage = "Building report from RAW DB...";
            _report = await FCostReportSvc.GenerateRawRangeReportAsync(
                FCost.GetRawDbPath(),
                start,
                end,
                groupsForSubGroupRollup: groups,
                progress: progress);
            _showAllDayColumns = false;
            _showAllWeekColumns = false;
            _showAllMonthColumns = false;
            _reportStatusMessage = $"Report ready: {start:yyyy-MM-dd} - {end:yyyy-MM-dd}.";
        }
        catch (Exception ex)
        {
            _reportError = $"Error: {ex.Message}";
        }
        finally
        {
            _isReportBusy = false;
            StateHasChanged();
        }
    }

    private async Task GetReportLegacyAsync()
    {
        if (_isReportBusy) return;
        _isReportBusy = true;
        _reportError  = string.Empty;
        _report       = null;
        StateHasChanged();

        try
        {
            string? dbPath = _savedDbPath ?? FCostReportSvc.FindMostRecentDb();
            if (string.IsNullOrEmpty(dbPath) || !File.Exists(dbPath))
            {
                _reportError = "No fcost_*.db found. Run Get Data first.";
                return;
            }

            // Always roll up over every defined ModelGroup — picker UI was removed
            // in favour of in-table Mid → Sub1 → Sub2 expand/collapse.
            var groups = Repo.GetModelGroups();
            _report = await FCostReportSvc.GenerateReportAsync(
                dbPath,
                groupsForSubGroupRollup: groups);
        }
        catch (Exception ex)
        {
            _reportError = $"Error: {ex.Message}";
        }
        finally
        {
            _isReportBusy = false;
            StateHasChanged();
        }
    }
}
