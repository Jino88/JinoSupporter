@code {
    private static readonly string[] AllProductGroups = ["SPK", "UNIT", "MODULE", "TWS", "ETC"];

    // ── Get Data state ────────────────────────────────────────────────────────────
    private DateTime     _startDate    = DateTime.Today;
    private DateTime     _endDate      = DateTime.Today;
    private bool         _isBusy       = false;
    private string?      _savedDbPath  = null;
    private string?      _errorMessage = null;
    private List<string> _logs         = new();
    private const string LogElementId  = "ngRateLogByModel";
    private const string OtherReason   = "Other";
    private const int MaxDisplayReasonRows = 10;

    // ── Model Groups state (from ModelGroups DB) ─────────────────────────────────
    private List<ModelGroupRecord> _dbGroups         = new();
    private HashSet<long>          _selectedGroupIds = new();
    private HashSet<string>        _selectedSubEntries = new(StringComparer.Ordinal);
    private string                 _activePg         = "ETC";

    /// <summary>Key forms:
    ///   "{gid}|mid|{material}"         — entire mid-group
    ///   "{gid}|sub|{material}|{path}"  — a single sub-group (path uses the SubPathSep
    ///                                    char ``, same as DB storage)</summary>
    private sealed record ChildEntry(string Key, string Label, int LsCount, int Depth);

    /// <summary>Child-row enumeration for the picker:
    ///   - Each Mid (depth=1) — checkbox includes the entire Mid subtree.
    ///   - Every named descendant Sub (depth=2,3,...) — checkbox includes that node's
    ///     full subtree (its own LineShifts + every nested descendant). Container subs
    ///     (no direct LineShifts, only nested children) ARE surfaced so the user can
    ///     scope a report to e.g. just `_D3` without picking each L/R leaf separately.
    /// Empty-named placeholder subs (auto-created when LineShifts are saved with no
    /// SubGroup path) don't take a visual depth slot — their children render directly
    /// under the parent depth.
    /// A single Mid whose Material equals the Group name is suppressed to avoid an
    /// obviously-redundant row.</summary>
    private static IEnumerable<ChildEntry> EnumerateChildEntries(ModelGroupRecord g)
    {
        bool skipMidWhenSingle = g.MidGroups.Count == 1
            && string.Equals(g.MidGroups[0].Material, g.Name, StringComparison.Ordinal);

        foreach (var mid in g.MidGroups)
        {
            int midLs = mid.LineShifts.Count;
            if (midLs == 0) continue;
            if (string.IsNullOrEmpty(mid.Material)) continue;

            if (!skipMidWhenSingle)
            {
                yield return new ChildEntry(
                    Key:     $"{g.Id}|mid|{mid.Material}",
                    Label:   mid.Material,
                    LsCount: midLs,
                    Depth:   1);
            }

            int subDepth = skipMidWhenSingle ? 1 : 2;
            foreach (var sub in mid.SubGroups)
                foreach (var entry in WalkSubEntries(g.Id, mid, sub, parentPath: string.Empty, depth: subDepth))
                    yield return entry;
        }
    }

    private static IEnumerable<ChildEntry> WalkSubEntries(
        long gid, MidGroupRecord mid, SubGroupRecord sub, string parentPath, int depth)
    {
        string nodeName = sub.Name ?? string.Empty;
        string path = string.IsNullOrEmpty(nodeName)
            ? parentPath
            : (string.IsNullOrEmpty(parentPath) ? nodeName : parentPath + "\u001F" + nodeName);

        // Yield every named node — leaves AND containers. LsCount reflects the FULL
        // subtree under this node, so a container row shows the total it would scope
        // when checked.
        if (!string.IsNullOrEmpty(nodeName))
        {
            int subtreeLs = sub.AllLineShifts.Count();
            if (subtreeLs > 0)
            {
                yield return new ChildEntry(
                    Key:     $"{gid}|sub|{mid.Material}|{path}",
                    Label:   nodeName,
                    LsCount: subtreeLs,
                    Depth:   depth);
            }
        }

        // Empty-named subs (default buckets) collapse — their children render at the
        // parent's depth so we don't waste an indent level on a no-op container.
        int childDepth = string.IsNullOrEmpty(nodeName) ? depth : depth + 1;
        foreach (var child in sub.SubGroups)
            foreach (var e in WalkSubEntries(gid, mid, child, path, childDepth))
                yield return e;
    }

    /// <summary>Only ProductGroups that actually have groups (preserves AllProductGroups order)</summary>
    private IEnumerable<string> GroupProductGroups =>
        AllProductGroups.Where(pg => _dbGroups.Any(g => g.ProductGroup == pg));

    // ── Report state ──────────────────────────────────────────────────────────────
    private bool   _isReportBusy = false;
    private string _reportError  = string.Empty;
    private List<(string Label, NgRateReportService.NgRateReport Report)> _reports = new();
    private int    _activeReportTab = 0;
    private NgRateReportService.NgRateReport? _report =>
        _activeReportTab < _reports.Count ? _reports[_activeReportTab].Report : null;

    // ── Group → Mid → Sub1 → Sub2 → LineShift hierarchy (shared across tabs) ────
    // Bundled by HierReportBuilder; rendered through the <HierSubRows> component.
    // PT-first Summary above is independent so the user keeps both views.
    private HierReports?    _hier;
    private HierPpmLookup   _hierLookup = new();
    private HashSet<string> _hierExpandedGroups = new(StringComparer.Ordinal);
    private HashSet<string> _hierExpandedMids   = new(StringComparer.Ordinal);
    private HashSet<string> _hierExpandedSub1s  = new(StringComparer.Ordinal);

    private void HierToggleGroup(string g) { if (!_hierExpandedGroups.Remove(g)) _hierExpandedGroups.Add(g); }
    private void HierToggleMid(string k)   { if (!_hierExpandedMids.Remove(k))   _hierExpandedMids.Add(k); }

    private bool HierMidHasVisibleData(
        string groupName,
        MidGroupRecord mid,
        IReadOnlyList<NgRateReportService.PeriodColumn> dateCols,
        IReadOnlyList<NgRateReportService.PeriodColumn> weekCols,
        IReadOnlyList<NgRateReportService.PeriodColumn> monthCols)
    {
        if (mid.LineShifts.Count == 0 || string.IsNullOrEmpty(mid.Material)) return false;
        foreach (var col in dateCols)  if (_hierLookup.MidAvgOfSubs(groupName, mid, col.Key) > 0) return true;
        foreach (var col in weekCols)  if (_hierLookup.MidAvgOfSubs(groupName, mid, col.Key) > 0) return true;
        foreach (var col in monthCols) if (_hierLookup.MidAvgOfSubs(groupName, mid, col.Key) > 0) return true;
        return false;
    }

    /// <summary>Resolve the union of selected scopes (whole-group selections +
    /// parent groups of sub-entry selections). Falls back to all groups so the
    /// hierarchy card always has something to show alongside the per-tab views.</summary>
    private List<ModelGroupRecord> ResolveHierGroups()
    {
        var groupSet = new HashSet<long>(_selectedGroupIds);
        foreach (string key in _selectedSubEntries)
        {
            var parts = key.Split('|');
            if (parts.Length >= 1 && long.TryParse(parts[0], out long gid)) groupSet.Add(gid);
        }
        if (groupSet.Count == 0)
            foreach (var g in _dbGroups) groupSet.Add(g.Id);
        return _dbGroups.Where(g => groupSet.Contains(g.Id)).ToList();
    }

    // ── Chart state ───────────────────────────────────────────────────────────────
    private bool _pendingChartRender = false;

    // ── Export state ──────────────────────────────────────────────────────────────
    private bool _isExporting = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingChartRender && _report is not null)
        {
            _pendingChartRender = false;
            await RenderSummaryChartAsync();
        }
    }

    private async Task RenderSummaryChartAsync()
    {
        if (_report is null) return;

        var dateCols  = VisibleDateCols.ToList();
        var weekCols  = VisibleWeekCols.ToList();
        var monthCols = VisibleMonthCols.ToList();
        bool hasWeek  = weekCols.Count > 0;
        bool hasMonth = monthCols.Count > 0;

        // Insert empty label ("") as separator between sections
        var labels = new List<string>();
        labels.AddRange(dateCols.Select(c => c.Header));
        if (hasWeek)  { labels.Add(""); labels.AddRange(weekCols.Select(c  => c.Header)); }
        if (hasMonth) { labels.Add(""); labels.AddRange(monthCols.Select(c => c.Header)); }

        // Data array builder — insert null at separator positions
        double?[] BuildData(Dictionary<string, double> ppm)
        {
            var d = new List<double?>();
            foreach (var c in dateCols)  d.Add(GetChartVal(ppm, c.Key));
            if (hasWeek)  { d.Add(null); foreach (var c in weekCols)  d.Add(GetChartVal(ppm, c.Key)); }
            if (hasMonth) { d.Add(null); foreach (var c in monthCols) d.Add(GetChartVal(ppm, c.Key)); }
            return d.ToArray();
        }

        // When a chip is selected, chart scopes to that group's Summary rows.
        var chartSummary = EffectiveSummary;

        // TOTAL line chart
        var totalRow = chartSummary.FirstOrDefault(r => r.IsTotal);
        string totalLabel = NoChipSelected
            ? "TOTAL"
            : (_selectedChips.Count == 1
                ? $"TOTAL — {_selectedChips.First()}"
                : $"TOTAL — Combined ({_selectedChips.Count})");
        object? totalDs = totalRow is null ? null : new
        {
            label           = totalLabel,
            data            = BuildData(totalRow.Ppm),
            borderColor     = "#4f46e5",
            backgroundColor = "rgba(79,70,229,0.08)",
            borderWidth     = 2,
            pointRadius     = 3,
            pointBackgroundColor = "#4f46e5",
            pointBorderColor     = "#4f46e5",
            tension         = 0.4,
            fill            = false,
            yAxisID         = "y1",
            order           = 0,
            spanGaps        = false,
        };

        // ProcessType bars
        int fi = 0;
        var barDatasets = chartSummary
            .Where(r => !r.IsTotal)
            .Select(r =>
            {
                var ds = (object)new
                {
                    type            = "bar",
                    label           = r.ProcessType,
                    data            = BuildData(r.Ppm),
                    backgroundColor = GetPtColor(r.ProcessType, fi),
                    stack           = "pt",
                    order           = 1,
                };
                fi++;
                return ds;
            })
            .ToArray();

        await JS.InvokeVoidAsync("ngRateChart.render", $"summaryChart_{_activeReportTab}", labels.ToArray(), barDatasets, totalDs);
    }

    private static double? GetChartVal(Dictionary<string, double> ppm, string key)
        => ppm.TryGetValue(key, out double v) && v > 0 ? v : null;

    private static string GetPtColor(string pt, int fi)
    {
        if (pt.StartsWith("SUB",    StringComparison.OrdinalIgnoreCase)) return "rgba(239,68,68,0.85)";
        if (pt == "MAIN")                                                 return "rgba(34,197,94,0.85)";
        if (pt == "FUNCTION")                                             return "rgba(168,85,247,0.85)";
        if (pt.StartsWith("VISUAL", StringComparison.OrdinalIgnoreCase)) return "rgba(6,182,212,0.85)";
        string[] fb = ["rgba(249,115,22,0.85)", "rgba(234,179,8,0.85)", "rgba(99,102,241,0.85)", "rgba(236,72,153,0.85)"];
        return fb[fi % fb.Length];
    }

    private async Task ClearReportAsync()
    {
        await DestroyReportChartsAsync();
        ReleaseReportState();
    }

    public async ValueTask DisposeAsync()
    {
