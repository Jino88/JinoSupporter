@page "/ng-rate"
@using BmesNgRateStandalone.Services
@inject NgRateService         NgRate
@inject NgRateSettingsService NgRateSettings
@inject NgRateReportService   NgRateReport
@inject WebRepository         Repo
@inject IJSRuntime            JS
@inject AppActivityLogger     Activity
@implements IAsyncDisposable

<PageTitle>NG Rate</PageTitle>

<NgRateReportStyles />
<NgRateViewNav CurrentView="by-model" />

<NgRateSetupPanel StartDate="@_startDate"
                  StartDateChanged="@((DateTime d) => _startDate = d)"
                  EndDate="@_endDate"
                  EndDateChanged="@((DateTime d) => _endDate = d)"
                  IsBusy="@_isBusy"
                  IsReportBusy="@_isReportBusy"
                  IsCredentialsConfigured="@NgRateSettings.IsCredentialsConfigured"
                  LoginId="@NgRateSettings.LoginId"
                  SavedDbPath="@_savedDbPath"
                  ErrorMessage="@_errorMessage"
                  LogElementId="@LogElementId"
                  Logs="@_logs"
                  HasSuccessfulResult="@(_savedDbPath is not null || _reports.Count > 0)"
                  OnSetToday="SetToday"
                  OnClearResult="ClearResult"
                  OnClearLogs="@(() => _logs.Clear())">
    <GroupPicker>
        <NgRateModelGroupPicker Groups="@_dbGroups"
                                SelectedGroupIds="@_selectedGroupIds"
                                SelectedSubEntries="@_selectedSubEntries"
                                ActiveProductGroup="@_activePg"
                                ActiveProductGroupChanged="@((string pg) => _activePg = pg)"
                                IsBusy="@_isBusy"
                                IsReportBusy="@_isReportBusy"
                                IsCredentialsConfigured="@NgRateSettings.IsCredentialsConfigured"
                                ReportError="@_reportError"
                                OnRefresh="RefreshGroups"
                                OnToggleGroup="ToggleGroup"
                                OnToggleSubEntry="ToggleSubEntry"
                                OnGetReport="GetReportAsync" />
    </GroupPicker>
</NgRateSetupPanel>

@if (_reports.Count > 0)
{
    <div class="mt-4">

        <!-- Tabs + Export -->
        <div class="d-flex align-items-end justify-content-between mb-0">
            @if (_reports.Count > 1)
            {
                <ul class="nav nav-tabs mb-0" style="border-bottom:none;">
                    @for (int i = 0; i < _reports.Count; i++)
                    {
                        int tabIdx = i;
                        bool active = i == _activeReportTab;
                        <li class="nav-item">
                            <button class="nav-link @(active ? "active fw-semibold" : "")"
                                    style="font-size:13px; padding:6px 14px;"
                                    @onclick="() => SwitchReportTab(tabIdx)">
                                @_reports[tabIdx].Label
                            </button>
                        </li>
                    }
                </ul>
            }
            else
            {
                <div></div>
            }
            <button class="btn btn-outline-success btn-sm mb-1"
                    style="font-size:12px;"
                    @onclick="ExportExcelAsync"
                    disabled="@_isExporting">
                @if (_isExporting)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                }
                else
                {
                    <span>⬇ Export Excel</span>
                }
            </button>
        </div>
        <div style="border-top:2px solid #e2e8f0; margin-bottom:12px;"></div>

        <!-- ── Hierarchy Summary — Group → Mid → Sub1 → Sub2 → LineShift ─────── -->
        @if (_hier is not null && _hier.HasData)
        {
            var hierDateCols  = VisibleDateCols.ToList();
            var hierWeekCols  = VisibleWeekCols.ToList();
            var hierMonthCols = VisibleMonthCols.ToList();
            <div class="card mb-3 shadow-sm">
                <div class="card-header small fw-semibold">
                    📊 Group → Model Name → Sub Group → Shift Group — TOTAL PPM (collapsible)
                </div>
                <div class="card-body p-0">
                    <div class="pivot-wrap">
                        <table class="pivot-table text-fit-table">
                            <thead>
                                <tr>
                                    <th class="label-th" style="min-width:280px;" rowspan="2">Group / Model Name / Sub Group / Shift Group</th>
                                    @if (hierDateCols.Count > 0)
                                    {
                                        <th class="blk-date" colspan="@hierDateCols.Count">Date</th>
                                        <th class="sep-th" rowspan="2"></th>
                                    }
                                    @if (hierWeekCols.Count > 0)
                                    {
                                        <th class="blk-week" colspan="@hierWeekCols.Count">Week</th>
                                        <th class="sep-th" rowspan="2"></th>
                                    }
                                    @if (hierMonthCols.Count > 0)
                                    {
                                        <th class="blk-month" colspan="@hierMonthCols.Count">Month</th>
                                    }
                                </tr>
                                <tr>
                                    @foreach (var col in hierDateCols)  { <th>@col.Header</th> }
                                    @foreach (var col in hierWeekCols)  { <th>@col.Header</th> }
                                    @foreach (var col in hierMonthCols) { <th>@col.Header</th> }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var g in _hier.Groups)
                                {
                                    string gName = g.Name;
                                    bool gExp    = _hierExpandedGroups.Contains(gName);
                                    var visibleMids = g.MidGroups
                                        .Where(mid => HierMidHasVisibleData(gName, mid, hierDateCols, hierWeekCols, hierMonthCols))
                                        .ToList();
                                    <tr class="hier-group-row" @onclick="() => HierToggleGroup(gName)">
                                        <td class="label-td">
                                            <span class="tog-icon">@(gExp ? "▼" : "▶")</span>
                                            <strong>@gName</strong>
                                            <span class="text-muted ms-1" style="font-size:10px;">@visibleMids.Count models</span>
                                        </td>
                                        @foreach (var col in hierDateCols)
                                        {
                                            double v = _hierLookup.GroupAvgOfMids(g, col.Key);
                                            <td class="@(v <= 0 ? "ppm-zero" : "ppm-val")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                        }
                                        @if (hierDateCols.Count > 0) { <td class="sep-td"></td> }
                                        @foreach (var col in hierWeekCols)
                                        {
                                            double v = _hierLookup.GroupAvgOfMids(g, col.Key);
                                            <td class="@(v <= 0 ? "ppm-zero" : "ppm-val")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                        }
                                        @if (hierWeekCols.Count > 0) { <td class="sep-td"></td> }
                                        @foreach (var col in hierMonthCols)
                                        {
                                            double v = _hierLookup.GroupAvgOfMids(g, col.Key);
                                            <td class="@(v <= 0 ? "ppm-zero" : "ppm-val")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                        }
                                    </tr>
                                    @if (gExp)
                                    {
                                        @foreach (var mid in visibleMids)
                                        {
                                            string midKey = $"{gName}::{mid.Material}";
                                            bool midExp   = _hierExpandedMids.Contains(midKey);
                                            <tr class="hier-mid-row" @onclick="() => HierToggleMid(midKey)">
                                                <td class="label-td" style="padding-left:32px; font-size:11.5px;">
                                                    <span class="tog-icon">@(midExp ? "▼" : "▶")</span>
                                                    <span class="ms-1">@mid.Material</span>
                                                </td>
                                                @foreach (var col in hierDateCols)
                                                {
                                                    double v = _hierLookup.MidAvgOfSubs(gName, mid, col.Key);
                                                    <td class="@(v <= 0 ? "ppm-zero" : "ppm-val")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                                }
                                                @if (hierDateCols.Count > 0) { <td class="sep-td"></td> }
                                                @foreach (var col in hierWeekCols)
                                                {
                                                    double v = _hierLookup.MidAvgOfSubs(gName, mid, col.Key);
                                                    <td class="@(v <= 0 ? "ppm-zero" : "ppm-val")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                                }
                                                @if (hierWeekCols.Count > 0) { <td class="sep-td"></td> }
                                                @foreach (var col in hierMonthCols)
                                                {
                                                    double v = _hierLookup.MidAvgOfSubs(gName, mid, col.Key);
                                                    <td class="@(v <= 0 ? "ppm-zero" : "ppm-val")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                                }
                                            </tr>
                                            @if (midExp)
                                            {
                                                <HierSubRows GroupName="@gName" Mid="@mid" Lookup="@_hierLookup"
                                                             DateCols="@hierDateCols" WeekCols="@hierWeekCols" MonthCols="@hierMonthCols"
                                                             Expanded="@_hierExpandedSub1s"
                                                             Sub1RowClass="hier-sub1-row"
                                                             Sub2RowClass="hier-sub2-row"
                                                             LineShiftRowClass="hier-ls-row"
                                                             ExpandableRowClass="hier-sub-expandable" />
                                            }
                                        }
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        <!-- Report header -->
        <div class="d-flex align-items-center gap-2 mb-3 border-bottom pb-2">
            <span style="font-size:18px;">📊</span>
            <h6 class="mb-0 fw-semibold">Report</h6>
            <span class="small text-muted ms-1">
                @Path.GetFileName(_report.DbPath) ·
                @_report.TotalRows.ToString("N0") rows ·
                @_report.GeneratedAt.ToString("HH:mm:ss")
            </span>
            @if (_report.ModelFilter.Count > 0)
            {
                <span class="badge bg-secondary ms-1" style="font-size:10px;">
                    @_report.ModelFilter.Count model@(_report.ModelFilter.Count == 1 ? "" : "s") filtered
                </span>
            }
            <button class="btn btn-link btn-sm p-0 ms-auto text-secondary"
                    @onclick="ClearReportAsync">✕ Clear</button>
        </div>

        <!-- ── Summary ───────────────────────────────────────────────────────── -->
        <div class="card mb-3 shadow-sm">
            <div class="card-header small fw-semibold d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span>Summary — NG PPM by Process Type</span>
                    @if (_hiddenGroups.Count > 0)
                    {
                        <button class="group-chip-clear ms-2" type="button"
                                title="Restore all hidden group rows"
                                @onclick="ClearHiddenGroups">✕ Clear hidden (@_hiddenGroups.Count)</button>
                    }
                </div>
                <div class="d-flex gap-2 align-items-center">
                    @if (_report.GroupSummary.Count > 0)
                    {
                        <button class="expand-btn" @onclick="ExpandAllSummary">Expand All</button>
                        <span class="text-muted" style="font-size:10px;">|</span>
                        <button class="expand-btn" @onclick="CollapseAllSummary">Collapse All</button>
                        <span class="text-muted" style="font-size:10px;">|</span>
                    }
                    @if (_report.DateCols.Count > DateVisibleLimit)
                    {
                        <button class="expand-btn" @onclick="ToggleDateCols">
                            Date @(_dateExpanded ? "▼" : $"▶ +{_report.DateCols.Count - DateVisibleLimit}")
                        </button>
                    }
                    @if (_report.WeekCols.Count > WeekVisibleLimit)
                    {
                        <button class="expand-btn" @onclick="ToggleWeekCols">
                            Week @(_weekExpanded ? "▼" : $"▶ +{_report.WeekCols.Count - WeekVisibleLimit}")
                        </button>
                    }
                    @if (_report.MonthCols.Count > MonthVisibleLimit)
                    {
                        <button class="expand-btn" @onclick="ToggleMonthCols">
                            Month @(_monthExpanded ? "▼" : $"▶ +{_report.MonthCols.Count - MonthVisibleLimit}")
                        </button>
                    }
                </div>
            </div>
            <div class="card-body p-2">
                <div class="pivot-wrap">
                    <table class="pivot-table text-fit-table">
                        <thead>
                            <tr>
                                <th class="label-th" style="min-width:20px; text-align:center;"></th>
                                <th class="label-th">Process Type</th>
                                @foreach (var col in VisibleDateCols)
                                {
                                    <th>@col.Header</th>
                                }
                                <th class="sep-th"></th>
                                @foreach (var col in VisibleWeekCols)
                                {
                                    <th>@col.Header</th>
                                }
                                <th class="sep-th"></th>
                                @foreach (var col in VisibleMonthCols)
                                {
                                    <th>@col.Header</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sumRow in EffectiveSummary)
                            {
                                // When a chip is selected, the rows are already scoped to that
                                // single model — disable per-group expansion rows.
                                bool summaryHasGroups = NoChipSelected && _report.GroupSummary.Count > 0;
                                bool summaryExpanded  = _expandedSummary.Contains(sumRow.ProcessType);
                                string sumPt          = sumRow.ProcessType;
                                <tr class="@(sumRow.IsTotal ? "total-row" : "rank-row")">
                                    <td class="toggle-cell" @onclick="@(() => { if (summaryHasGroups) ToggleSummary(sumPt); })">
                                        @if (summaryHasGroups)
                                        {
                                            <span class="toggle-icon">@(summaryExpanded ? "▼" : "▶")</span>
                                        }
                                    </td>
                                    <td class="label-td">@sumRow.ProcessType</td>
                                    @foreach (var col in VisibleDateCols)
                                    {
                                        double v = sumRow.Ppm.GetValueOrDefault(col.Key);
                                        <td class="@(v <= 0 ? "ppm-zero" : "ppm-val")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                    }
                                    <td class="sep-td"></td>
                                    @foreach (var col in VisibleWeekCols)
                                    {
                                        double v = sumRow.Ppm.GetValueOrDefault(col.Key);
                                        <td class="@(v <= 0 ? "ppm-zero" : "ppm-val")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                    }
                                    <td class="sep-td"></td>
                                    @foreach (var col in VisibleMonthCols)
                                    {
                                        double v = sumRow.Ppm.GetValueOrDefault(col.Key);
                                        <td class="@(v <= 0 ? "ppm-zero" : "ppm-val")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                    }
                                </tr>
                                @if (summaryExpanded)
                                {
                                    @foreach (var grp in _report.GroupNames)
                                    {
                                        if (_hiddenGroups.Contains(grp)) continue;
                                        if (_report.GroupSummary.TryGetValue(grp, out var grpRows))
                                        {
                                            var grpRow = grpRows.FirstOrDefault(sr => sr.ProcessType == sumPt);
                                            if (grpRow is not null)
                                            {
                                                var g = grp;
                                                <tr class="group-row">
                                                    <td class="row-hide-cell">
                                                        <button class="row-hide-btn" type="button"
                                                                title="Hide this group row (Clear to restore)"
                                                                @onclick="() => HideGroup(g)">✕</button>
                                                    </td>
                                                    <td class="label-td group-name-td">↳ @grp</td>
                                                    @foreach (var col in VisibleDateCols)
                                                    {
                                                        double v = grpRow.Ppm.GetValueOrDefault(col.Key);
                                                        <td class="@(v <= 0 ? "ppm-zero" : "")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                                    }
                                                    <td class="sep-td"></td>
                                                    @foreach (var col in VisibleWeekCols)
                                                    {
                                                        double v = grpRow.Ppm.GetValueOrDefault(col.Key);
                                                        <td class="@(v <= 0 ? "ppm-zero" : "")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                                    }
                                                    <td class="sep-td"></td>
                                                    @foreach (var col in VisibleMonthCols)
                                                    {
                                                        double v = grpRow.Ppm.GetValueOrDefault(col.Key);
                                                        <td class="@(v <= 0 ? "ppm-zero" : "")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                                    }
                                                </tr>
                                            }
                                        }
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </div>
                <div style="position:relative; height:200px; margin-top:12px;">
                    <canvas id="summaryChart_@_activeReportTab"></canvas>
                </div>
            </div>
        </div>

        <!-- ── Process 10 NG ─────────────────────────────────────────────────── -->
        <div class="card mb-3 shadow-sm">
            <div class="card-header small fw-semibold d-flex justify-content-between align-items-center">
                <span>Process 10 NG — Top 10 Worst Processes by PPM</span>
                @if (_report.Top10Process.Any(r => r.Groups.Count > 0))
                {
                    <div class="d-flex gap-2">
                        <button class="expand-btn" @onclick="ExpandAllProcess">Expand All</button>
                        <span class="text-muted" style="font-size:10px;">|</span>
                        <button class="expand-btn" @onclick="CollapseAllProcess">Collapse All</button>
                    </div>
                }
            </div>
            <div class="card-body p-2">
                <div class="pivot-wrap">
                    <table class="pivot-table text-fit-table">
                        <thead>
                            <tr>
                                <th class="label-th" style="min-width:28px; text-align:center;">#</th>
                                <th class="label-th" style="min-width:72px;">Type</th>
                                <th class="label-th process-name-col" style="min-width:150px;">Process Name</th>
                                @foreach (var col in VisibleDateCols)
                                {
                                    <th>@col.Header</th>
                                }
                                <th class="sep-th"></th>
                                @foreach (var col in VisibleWeekCols)
                                {
                                    <th>@col.Header</th>
                                }
                                <th class="sep-th"></th>
                                @foreach (var col in VisibleMonthCols)
                                {
                                    <th>@col.Header</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @{ int procDisplay = 0; }
                            @foreach (var row in SortedTop10Process)
                            {
                                procDisplay++;
                                int procRank       = NoChipSelected ? row.Rank : procDisplay;
                                bool procHasGroups = NoChipSelected && row.Groups.Count > 0;
                                bool procExpanded  = procHasGroups && _expandedProcess.Contains(row.Rank);
                                var procPpm        = PpmForRow(row, row.Ppm, row.Groups);
                                <tr class="rank-row">
                                    <td class="toggle-cell" @onclick="@(() => { if (procHasGroups) ToggleProcess(row.Rank); })">
                                        @if (procHasGroups)
                                        {
                                            <span class="toggle-icon">@(procExpanded ? "▼" : "▶")</span>
                                        }
                                        @procRank
                                    </td>
                                    <td class="label-td"><span class="pt-badge">@row.ProcessType</span></td>
                                    <td class="label-td process-name-col">@row.ProcessName</td>
                                    @foreach (var col in VisibleDateCols)
                                    {
                                        double v = procPpm.GetValueOrDefault(col.Key);
                                        <td class="@(v <= 0 ? "ppm-zero" : "ppm-val")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                    }
                                    <td class="sep-td"></td>
                                    @foreach (var col in VisibleWeekCols)
                                    {
                                        double v = procPpm.GetValueOrDefault(col.Key);
                                        <td class="@(v <= 0 ? "ppm-zero" : "ppm-val")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                    }
                                    <td class="sep-td"></td>
                                    @foreach (var col in VisibleMonthCols)
                                    {
                                        double v = procPpm.GetValueOrDefault(col.Key);
                                        <td class="@(v <= 0 ? "ppm-zero" : "ppm-val")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                    }
                                </tr>
                                @if (procExpanded)
                                {
                                    @foreach (var grp in row.Groups.Where(g => !_hiddenGroups.Contains(g.GroupName)))
                                    {
                                        <tr class="group-row">
                                            <td></td>
                                            <td></td>
                                            <td class="label-td group-name-td">↳ @grp.GroupName</td>
                                            @foreach (var col in VisibleDateCols)
                                            {
                                                double v = grp.Ppm.GetValueOrDefault(col.Key);
                                                <td class="@(v <= 0 ? "ppm-zero" : "")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                            }
                                            <td class="sep-td"></td>
                                            @foreach (var col in VisibleWeekCols)
                                            {
                                                double v = grp.Ppm.GetValueOrDefault(col.Key);
                                                <td class="@(v <= 0 ? "ppm-zero" : "")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                            }
                                            <td class="sep-td"></td>
                                            @foreach (var col in VisibleMonthCols)
                                            {
                                                double v = grp.Ppm.GetValueOrDefault(col.Key);
                                                <td class="@(v <= 0 ? "ppm-zero" : "")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                            }
                                        </tr>
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ── Worst 10 NG ───────────────────────────────────────────────────── -->
        <div class="card mb-3 shadow-sm">
            <div class="card-header small fw-semibold d-flex justify-content-between align-items-center">
                <span>Worst 10 NG — Top 10 Worst NG Names by PPM</span>
                @if (_report.Top10Ng.Any(r => r.Groups.Count > 0))
                {
                    <div class="d-flex gap-2">
                        <button class="expand-btn" @onclick="ExpandAllNg">Expand All</button>
                        <span class="text-muted" style="font-size:10px;">|</span>
                        <button class="expand-btn" @onclick="CollapseAllNg">Collapse All</button>
                    </div>
                }
            </div>
            <div class="card-body p-2">
                <div class="pivot-wrap">
                    <table class="pivot-table text-fit-table">
                        <thead>
                            <tr>
                                <th class="label-th" style="min-width:28px; text-align:center;">#</th>
                                <th class="label-th" style="min-width:72px;">Type</th>
                                <th class="label-th process-name-col" style="min-width:150px;">Process Name</th>
                                <th class="label-th ng-name-col" style="min-width:130px;">NG Name</th>
                                @foreach (var col in VisibleDateCols)
                                {
                                    <th>@col.Header</th>
                                }
                                <th class="sep-th"></th>
                                @foreach (var col in VisibleWeekCols)
                                {
                                    <th>@col.Header</th>
                                }
                                <th class="sep-th"></th>
                                @foreach (var col in VisibleMonthCols)
                                {
                                    <th>@col.Header</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @{ int ngDisplay = 0; }
                            @foreach (var row in SortedTop10Ng)
                            {
                                ngDisplay++;
                                int ngRank       = NoChipSelected ? row.Rank : ngDisplay;
                                bool ngHasGroups = NoChipSelected && row.Groups.Count > 0;
                                bool ngExpanded  = ngHasGroups && _expandedNg.Contains(row.Rank);
                                var ngPpm        = PpmForRow(row, row.Ppm, row.Groups);
                                <tr class="rank-row">
                                    <td class="toggle-cell" @onclick="@(() => { if (ngHasGroups) ToggleNg(row.Rank); })">
                                        @if (ngHasGroups)
                                        {
                                            <span class="toggle-icon">@(ngExpanded ? "▼" : "▶")</span>
                                        }
                                        @ngRank
                                    </td>
                                    <td class="label-td"><span class="pt-badge">@row.ProcessType</span></td>
                                    <td class="label-td process-name-col">@row.ProcessName</td>
                                    <td class="label-td ng-name-col">@row.NgName</td>
                                    @foreach (var col in VisibleDateCols)
                                    {
                                        double v = ngPpm.GetValueOrDefault(col.Key);
                                        <td class="@(v <= 0 ? "ppm-zero" : "ppm-val")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                    }
                                    <td class="sep-td"></td>
                                    @foreach (var col in VisibleWeekCols)
                                    {
                                        double v = ngPpm.GetValueOrDefault(col.Key);
                                        <td class="@(v <= 0 ? "ppm-zero" : "ppm-val")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                    }
                                    <td class="sep-td"></td>
                                    @foreach (var col in VisibleMonthCols)
                                    {
                                        double v = ngPpm.GetValueOrDefault(col.Key);
                                        <td class="@(v <= 0 ? "ppm-zero" : "ppm-val")">@(v <= 0 ? "-" : v.ToString("N0"))</td>
                                    }
                                </tr>
                                @if (ngExpanded)
                                {
                                    @foreach (var grp in row.Groups.Where(g => !_hiddenGroups.Contains(g.GroupName)))
                                    {
