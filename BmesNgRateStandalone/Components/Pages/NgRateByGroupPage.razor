    /// <summary>Mid PPM = simple average of its Sub1 PPMs — delegates to the shared
    /// <see cref="HierPpmLookup"/> so all NgRate views use the same math.</summary>
    private double MidPpmAvgOfSubs(string groupName, MidGroupRecord mid, string colKey)
        => _hierLookup.MidAvgOfSubs(groupName, mid, colKey);

