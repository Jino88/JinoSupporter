@page "/bmes/setting"
@page "/setting"
@using BmesNgRateStandalone.Services
@using Microsoft.AspNetCore.WebUtilities
@inject AppPathsService AppPaths
@inject NgRateSettingsService NgRateSettings
@inject NavigationManager Nav

<PageTitle>Setting</PageTitle>

<div class="d-flex align-items-center gap-2 mb-3">
    <h5 class="mb-0 fw-semibold">Setting</h5>
</div>

@if (_firstRun)
{
    <div class="alert alert-info py-2 small mb-3">
        <div class="fw-semibold mb-1">Welcome — one setup step first.</div>
        Pick a <strong>Working Folder</strong> below and press <strong>Save</strong>. All NG Rate,
        F-Cost and Worker Status data is stored there. <strong>Default</strong> puts it under your
        user profile. Then enter your BMES ID and password and restart the app.
    </div>
}

@if (!string.IsNullOrEmpty(_statusMsg))
{
    <div class="alert @(_statusError ? "alert-danger" : "alert-success") py-2 small mb-3 d-flex align-items-center">
        <span class="flex-fill">@_statusMsg</span>
        <button class="btn-close btn-sm" @onclick="() => _statusMsg = string.Empty"></button>
    </div>
}

<div class="row g-3">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header fw-semibold small">App Path</div>
            <div class="card-body">
                <label class="form-label small fw-semibold mb-1">
                    Working Folder
                    <span class="badge bg-warning text-dark ms-1">restart</span>
                </label>
                <div class="input-group input-group-sm">
                    <input class="form-control form-control-sm font-monospace"
                           @bind="_pathsForm.DbRootDirectory"
                           placeholder="@AppPathsService.DefaultDbRootDirectory" />
                    <button class="btn btn-outline-secondary btn-sm"
                            type="button"
                            @onclick="UseDefaultAppPath">
                        Default
                    </button>
                    <button class="btn btn-primary btn-sm"
                            type="button"
                            @onclick="SaveAppPathAsync"
                            disabled="@_pathSaving">
                        @if (_pathSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Save
                    </button>
                </div>
                <div class="small text-muted mt-2">
                    NG RATE: <code>@NgRateWorkDirectory</code><br />
                    FCOST: <code>@FCostWorkDirectory</code><br />
                    WK STATUS: <code>@WorkerStatusWorkDirectory</code>
                </div>
                @if (!string.IsNullOrWhiteSpace(_pathStatus))
                {
                    <div class="small mt-2 @(_pathStatusError ? "text-danger" : "text-success") fw-semibold">
                        @_pathStatus
                    </div>
                }
                @if (_pathSavedRequiresRestart)
                {
                    <div class="small text-warning fw-semibold mt-2">
                        Restart the app for path changes to fully take effect.
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold small">BMES Credentials</div>
            <div class="card-body">
                <div class="mb-2">
                    <label class="form-label small fw-semibold mb-1">Login ID</label>
                    <input class="form-control form-control-sm" @bind="_snap.LoginId" placeholder="BMES ID" />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold mb-1">Password</label>
                    <input class="form-control form-control-sm" type="password" @bind="_snap.Password" placeholder="BMES Password" />
                </div>
                <button class="btn btn-primary btn-sm" @onclick="SaveCredentials">Save</button>
            </div>
        </div>
    </div>
</div>

@code {
    private NgRateSettingsSnapshot _snap = new();
    private AppPathsConfig _pathsForm = new();

    private string _statusMsg = string.Empty;
    private bool _statusError;
    private bool _pathSaving;
    private bool _pathSavedRequiresRestart;
    private string _pathStatus = string.Empty;
    private bool _pathStatusError;
    private string _origDbRoot = string.Empty;
    private string _origMainDb = string.Empty;
    private string _origSettingsDbDir = string.Empty;

    /// <summary>Set when Home bounced a fresh install here (`?firstrun=1`), so the page
    /// explains why it opened instead of dropping the user into a bare form.</summary>
    private bool _firstRun;

    private string EffectiveWorkDirectory =>
        string.IsNullOrWhiteSpace(_pathsForm.DbRootDirectory)
            ? AppPathsService.DefaultDbRootDirectory
            : _pathsForm.DbRootDirectory.Trim();

    private string NgRateWorkDirectory => AppPathsService.GetNgRateDirectory(EffectiveWorkDirectory);
    private string FCostWorkDirectory => AppPathsService.GetFCostDirectory(EffectiveWorkDirectory);
    private string WorkerStatusWorkDirectory => AppPathsService.GetWorkerStatusDirectory(EffectiveWorkDirectory);

    protected override void OnInitialized()
    {
        var query = QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        _firstRun = query.TryGetValue("firstrun", out var flag) && flag == "1";

        CopyAppPathFromCurrent();
        _snap = NgRateSettings.GetSnapshot();
    }

    private void CopyAppPathFromCurrent()
    {
        var c = AppPaths.Current;
        _pathsForm = new AppPathsConfig
        {
            DbRootDirectory = c.DbRootDirectory,
            MainDbPath = c.MainDbPath,
            NgRateDbSaveDirectory = c.NgRateDbSaveDirectory,
            NgRateRoutingFilePath = c.NgRateRoutingFilePath,
            NgRateReasonFilePath = c.NgRateReasonFilePath,
            NgRateSettingsDbDirectory = c.NgRateSettingsDbDirectory,
            ModelBmesJsonFolder = c.ModelBmesJsonFolder,
            TestExcelConverterSourceDir = c.TestExcelConverterSourceDir,
            TestExcelConverterDestDir = c.TestExcelConverterDestDir,
            AdminDbQueryServer = c.AdminDbQueryServer,
            AdminDbQueryPort = c.AdminDbQueryPort,
            AdminDbQueryDatabase = c.AdminDbQueryDatabase,
            AdminDbQueryUserId = c.AdminDbQueryUserId,
            AdminDbQueryPassword = c.AdminDbQueryPassword,
            AdminDbQueryTimeoutSeconds = c.AdminDbQueryTimeoutSeconds,
            AdminDbQueryEncrypt = c.AdminDbQueryEncrypt,
            AdminDbQueryTrustServerCertificate = c.AdminDbQueryTrustServerCertificate,
        };

        _origDbRoot = c.DbRootDirectory;
        _origMainDb = c.MainDbPath;
        _origSettingsDbDir = c.NgRateSettingsDbDirectory;
    }

    private void UseDefaultAppPath()
    {
        _pathsForm.DbRootDirectory = AppPathsService.DefaultDbRootDirectory;
        ApplyUnifiedAppPathToForm();
        _pathStatus = "Default working folder applied. Click Save to keep it.";
        _pathStatusError = false;
    }

    private async Task SaveAppPathAsync()
    {
        if (_pathSaving) return;
        _pathSaving = true;
        _pathStatus = string.Empty;
        _pathStatusError = false;

        try
        {
            string requestedRoot = string.IsNullOrWhiteSpace(_pathsForm.DbRootDirectory)
                ? AppPathsService.DefaultDbRootDirectory
                : _pathsForm.DbRootDirectory.Trim();

            if (AppPathsService.DirectoryPathConflictsWithFile(requestedRoot))
            {
                _pathStatusError = true;
                _pathStatus = $"Working Folder points to an existing file, not a folder: {requestedRoot}";
                return;
            }

            _pathsForm.DbRootDirectory = requestedRoot;
            ApplyUnifiedAppPathToForm();
            await Task.Run(() => AppPaths.Save(_pathsForm));
            NgRateSettings.EnsureDatabase();

            _pathSavedRequiresRestart =
                !PathEquals(_pathsForm.DbRootDirectory, _origDbRoot) ||
                !PathEquals(_pathsForm.MainDbPath, _origMainDb) ||
                !PathEquals(_pathsForm.NgRateSettingsDbDirectory, _origSettingsDbDir);

            CopyAppPathFromCurrent();
            _snap = NgRateSettings.GetSnapshot();
            _pathStatus = $"Saved. Settings DB: {NgRateSettings.SettingsDbPath}";
            SetStatus("App path saved.", false);
        }
        catch (Exception ex)
        {
            _pathStatusError = true;
            _pathStatus = ex.Message;
            SetStatus("App path save failed: " + ex.Message, true);
        }
        finally
        {
            _pathSaving = false;
        }
    }

    private void ApplyUnifiedAppPathToForm()
    {
        if (string.IsNullOrWhiteSpace(_pathsForm.DbRootDirectory))
            _pathsForm.DbRootDirectory = AppPathsService.DefaultDbRootDirectory;
        _pathsForm = AppPathsService.ApplyUnifiedDbDirectory(_pathsForm);
    }

    private void SaveCredentials()
    {
        NgRateSettings.ApplySnapshot(_snap);
        SetStatus("BMES credentials saved.", false);
    }

    private void SetStatus(string message, bool isError)
    {
        _statusMsg = message;
        _statusError = isError;
    }

    private static bool PathEquals(string a, string b) =>
        string.Equals(
            Path.GetFullPath(string.IsNullOrWhiteSpace(a) ? "." : a),
            Path.GetFullPath(string.IsNullOrWhiteSpace(b) ? "." : b),
            StringComparison.OrdinalIgnoreCase);
}
