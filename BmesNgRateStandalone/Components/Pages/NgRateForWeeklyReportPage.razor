@code {
    private DateTime _startDate = DateTime.Today;
    private DateTime _endDate   = DateTime.Today;
    private bool     _isBusy;
    private string?  _savedDbPath;
    private string   _errorMessage = string.Empty;

    private List<ModelGroupRecord> _groups             = new();
    private HashSet<string>        _selectedGroupNames = new(StringComparer.Ordinal);

    private NgRateReportService.NgRateReport?       _report;
    private NgRateReportService.NgRateReport?       _reportByMid;
    private NgRateReportService.NgRateReport?       _reportByModel;
    private NgRateReportService.NgRateReport?       _reportBySubGroup;   // top-level Sub aggregation (Sub1)
    private NgRateReportService.NgRateReport?       _reportBySubLeaf;    // every named leaf Sub (Sub2+) with its own bucket
    private NgRateReportService.LineShiftNgReport?  _lsNgReport;
    private NgRateReportService.LineShiftNgReport?  _midNgReport;
    private HashSet<string>                         _expandedMids = new(StringComparer.Ordinal);
    private bool           _isReportBusy;
    private string         _reportError = string.Empty;
    private HashSet<string> _expandedGroups      = new(StringComparer.Ordinal);
    private HashSet<string> _expandedGroupsModel = new(StringComparer.Ordinal);
    private bool           _pendingChartRender;
    private const string   CanvasId      = "ngrateByGroupCanvas";
    private const string   CanvasIdModel = "ngrateByGroupModelCanvas";

    // Period collapse defaults / state
    private const int DefaultDateCap  = 10;
    private const int DefaultWeekCap  = 4;
    private const int DefaultMonthCap = 3;
    private bool _dateExpanded;
    private bool _weekExpanded;
    private bool _monthExpanded;

    // For Weekly Report view: hide ALL Date columns from tables and charts.
    // Render code uses `VisibleDateCols.Count > 0` guards everywhere, so an empty
    // list cleanly skips every date-related cell, header, and chart slice.
    private IReadOnlyList<NgRateReportService.PeriodColumn> VisibleDateCols =>
        Array.Empty<NgRateReportService.PeriodColumn>();
    private IReadOnlyList<NgRateReportService.PeriodColumn> VisibleWeekCols =>
        _report is null ? Array.Empty<NgRateReportService.PeriodColumn>()
        : _weekExpanded ? _report.WeekCols
        : _report.WeekCols.Take(DefaultWeekCap).ToList();
    private IReadOnlyList<NgRateReportService.PeriodColumn> VisibleMonthCols =>
        _report is null ? Array.Empty<NgRateReportService.PeriodColumn>()
        : _monthExpanded ? _report.MonthCols
        : _report.MonthCols.Take(DefaultMonthCap).ToList();

    private int HiddenDateCount  => _report is null ? 0 : Math.Max(0, _report.DateCols.Count  - VisibleDateCols.Count);
    private int HiddenWeekCount  => _report is null ? 0 : Math.Max(0, _report.WeekCols.Count  - VisibleWeekCols.Count);
    private int HiddenMonthCount => _report is null ? 0 : Math.Max(0, _report.MonthCols.Count - VisibleMonthCols.Count);

    // Top-10 카드 전용 고정 cap (상단 접기와 무관)
    private const int Top10DateCap  = 10;
    private const int Top10WeekCap  = 4;
    private const int Top10MonthCap = 3;
    private IReadOnlyList<NgRateReportService.PeriodColumn> Top10DateCols =>
        Array.Empty<NgRateReportService.PeriodColumn>();
    private IReadOnlyList<NgRateReportService.PeriodColumn> Top10WeekCols =>
        _report is null ? Array.Empty<NgRateReportService.PeriodColumn>()
        : _report.WeekCols.Take(Top10WeekCap).ToList();
    private IReadOnlyList<NgRateReportService.PeriodColumn> Top10MonthCols =>
        _report is null ? Array.Empty<NgRateReportService.PeriodColumn>()
        : _report.MonthCols.Take(Top10MonthCap).ToList();

    private int TotalColCount =>
        _report is null ? 0
        : VisibleDateCols.Count + VisibleWeekCols.Count + VisibleMonthCols.Count;

    // ── Weekly Report Summary (top-of-page table) ─────────────────────────────────
    // Independent of the user's expand/collapse state — always shows the latest 4 weeks
    // and latest 3 months so the snapshot matches what the user copies into Excel.
    private const int WeeklyReportWeekCount  = 4;
    private const int WeeklyReportMonthCount = 3;
    private const string BaselineMonthKey    = "202512"; // 2025년 12월 기준 (matches GetMonthKey format)

    private IReadOnlyList<NgRateReportService.PeriodColumn> WeeklyReportWeekCols =>
        _report is null ? Array.Empty<NgRateReportService.PeriodColumn>()
        : _report.WeekCols.Take(WeeklyReportWeekCount).ToList();

    private IReadOnlyList<NgRateReportService.PeriodColumn> WeeklyReportMonthCols =>
        _report is null ? Array.Empty<NgRateReportService.PeriodColumn>()
        : _report.MonthCols.Take(WeeklyReportMonthCount).ToList();

    /// <summary>One row per node in the Mid → Sub1 → Sub2 hierarchy.
    ///   Depth 0 = Mid           — read from _reportByMid (full subtree aggregate)
    ///   Depth 1 = top-level Sub — read from _reportBySubGroup (subtree aggregate)
    ///   Depth 2+ = nested Sub   — read from _reportBySubLeaf (this node's own
    ///                              direct LineShifts only).
    /// <see cref="ParentId"/> ties each row to its immediate parent so the render
    /// layer can hide subtrees whose ancestor isn't expanded. Default ("") sub-groups
    /// don't take a row; their named children inherit the parent's depth.</summary>
    private sealed record WeeklyReportRow(
        string                     RowId,
        string?                    ParentId,
        string                     Display,
        int                        Depth,
        bool                       IsLineShift,
        double?                    Baseline,
        double?                    Target,
        double?                    AchievementPct,
        Dictionary<string, double> WeekPpm,
        Dictionary<string, double> MonthPpm);

    /// <summary>RowIds of Mid / Sub rows the user has clicked open. Children of
    /// non-expanded rows are filtered out at render time.</summary>
    private HashSet<string> _expandedRowsWr = new(StringComparer.Ordinal);

    private List<WeeklyReportRow> WeeklyReportRows
    {
        get
        {
            var rows = new List<WeeklyReportRow>();
            if (_report is null || _reportByMid is null) return rows;

            foreach (var grp in _groups.Where(g => _selectedGroupNames.Contains(g.Name)))
            {
                foreach (var mid in grp.MidGroups)
                {
                    int totalLs = mid.LineShifts.Count;
                    if (totalLs == 0 || string.IsNullOrEmpty(mid.Material)) continue;

                    string midKey   = $"{grp.Name}::{mid.Material}";
                    string midRowId = "M::" + midKey;

                    var midWeekPpm  = new Dictionary<string, double>();
                    var midMonthPpm = new Dictionary<string, double>();
                    foreach (var col in WeeklyReportWeekCols)
                        midWeekPpm[col.Key] = MidPpmAvgOfSubs(grp.Name, mid, col.Key);
                    foreach (var col in WeeklyReportMonthCols)
                        midMonthPpm[col.Key] = MidPpmAvgOfSubs(grp.Name, mid, col.Key);
                    double midBaselineVal = MidPpmAvgOfSubs(grp.Name, mid, BaselineMonthKey);

                    rows.Add(new WeeklyReportRow(
                        RowId: midRowId,
                        ParentId: null,
                        Display: mid.Material,
                        Depth: 0,
                        IsLineShift: false,
                        Baseline: midBaselineVal > 0 ? midBaselineVal : (double?)null,
                        Target: null, AchievementPct: null,
                        WeekPpm: midWeekPpm, MonthPpm: midMonthPpm));

                    foreach (var sub in mid.SubGroups)
                        EmitSubRows(grp.Name, mid.Material, sub,
                                    parentPath: string.Empty, depth: 1,
                                    parentRowId: midRowId, rows);
                }
            }
            return rows;
        }
    }

    /// <summary>Recursive walker — emits one row per named SubGroup with the immediate
    /// parent RowId so the renderer can fold the subtree. Top-level subs (depth=1)
    /// pull PPM from <c>_reportBySubGroup</c>; nested subs use <c>_reportBySubLeaf</c>.
    /// Empty-named subs don't emit a row but recurse at the parent's depth.</summary>
    private void EmitSubRows(string groupName, string material, SubGroupRecord sub,
                             string parentPath, int depth, string parentRowId,
                             List<WeeklyReportRow> rows)
    {
        string nodeName = sub.Name ?? string.Empty;
        string path = string.IsNullOrEmpty(nodeName)
            ? parentPath
            : (string.IsNullOrEmpty(parentPath) ? nodeName : parentPath + "::" + nodeName);

        string thisRowId = parentRowId;
        bool emit = !string.IsNullOrEmpty(nodeName) && sub.AllLineShifts.Count() > 0;
        if (emit)
        {
            var weekPpm  = new Dictionary<string, double>();
            var monthPpm = new Dictionary<string, double>();
            string ownRowId;
            double bv;

            if (depth == 1)
            {
                string sub1Key = SubGroupKeyOf(groupName, material, sub);
                ownRowId = "S1::" + sub1Key;
                foreach (var col in WeeklyReportWeekCols)
                    weekPpm[col.Key] = SubGroupTotalPpm(sub1Key, col.Key);
                foreach (var col in WeeklyReportMonthCols)
                    monthPpm[col.Key] = SubGroupTotalPpm(sub1Key, col.Key);
                bv = SubGroupTotalPpm(sub1Key, BaselineMonthKey);
            }
            else
            {
                string leafKey = SubLeafKeyOf(groupName, material, path);
                ownRowId = "S" + depth + "::" + leafKey;
                foreach (var col in WeeklyReportWeekCols)
                    weekPpm[col.Key] = SubLeafTotalPpm(leafKey, col.Key);
                foreach (var col in WeeklyReportMonthCols)
                    monthPpm[col.Key] = SubLeafTotalPpm(leafKey, col.Key);
                bv = SubLeafTotalPpm(leafKey, BaselineMonthKey);
            }

            rows.Add(new WeeklyReportRow(
                RowId: ownRowId,
                ParentId: parentRowId,
                Display: nodeName,
                Depth: depth,
                IsLineShift: false,
                Baseline: bv > 0 ? bv : (double?)null,
                Target: null, AchievementPct: null,
                WeekPpm: weekPpm, MonthPpm: monthPpm));

            thisRowId = ownRowId;

            // Virtual LineShift leaves under this sub.
            if (sub.LineShifts.Count > 0)
            {
                int lsDepth = depth + 1;
                foreach (var ls in sub.LineShifts)
                {
                    if (string.IsNullOrEmpty(ls)) continue;
                    var lsWeekPpm  = new Dictionary<string, double>();
                    var lsMonthPpm = new Dictionary<string, double>();
                    foreach (var col in WeeklyReportWeekCols)
                        lsWeekPpm[col.Key] = LsTotalPpm(ls, col.Key);
                    foreach (var col in WeeklyReportMonthCols)
                        lsMonthPpm[col.Key] = LsTotalPpm(ls, col.Key);
                    double lsBv = LsTotalPpm(ls, BaselineMonthKey);
                    rows.Add(new WeeklyReportRow(
                        RowId: "LS::" + ownRowId + "::" + ls,
                        ParentId: ownRowId,
                        Display: ls,
                        Depth: lsDepth,
                        IsLineShift: true,
                        Baseline: lsBv > 0 ? lsBv : (double?)null,
                        Target: null, AchievementPct: null,
                        WeekPpm: lsWeekPpm, MonthPpm: lsMonthPpm));
                }
            }
        }

        int childDepth = string.IsNullOrEmpty(nodeName) ? depth : depth + 1;
        foreach (var child in sub.SubGroups)
            EmitSubRows(groupName, material, child, path, childDepth, thisRowId, rows);
    }

    /// <summary>PPM for a single LineShift, read from <c>_reportByModel</c>.</summary>
    private double LsTotalPpm(string lineShift, string colKey)
    {
        if (_reportByModel is null) return 0;
        var rows = _reportByModel.GroupSummary.GetValueOrDefault(lineShift);
        var tot  = rows?.FirstOrDefault(r => r.IsTotal);
        return tot?.Ppm.GetValueOrDefault(colKey) ?? 0;
    }

    private void ToggleWrRow(string rowId)
    {
        if (!_expandedRowsWr.Remove(rowId)) _expandedRowsWr.Add(rowId);
    }

    /// <summary>True iff every ancestor of <paramref name="row"/> is expanded.
    /// Mid rows (no parent) are always visible.</summary>
    private bool IsWrRowVisible(WeeklyReportRow row, IReadOnlyDictionary<string, WeeklyReportRow> byId)
    {
        string? pid = row.ParentId;
        while (pid is not null)
        {
            if (!_expandedRowsWr.Contains(pid)) return false;
            pid = byId.TryGetValue(pid, out var p) ? p.ParentId : null;
        }
        return true;
    }

    /// <summary>SubGroup namespace key — same scheme as midKey ("대그룹::Material") but with the
    /// SubGroup name appended. Empty SubGroup names get a stable placeholder so default buckets
    /// don't collide across MidGroups.</summary>
    private static string SubGroupKeyOf(string groupName, string material, SubGroupRecord sub)
    {
        string subSegment = string.IsNullOrEmpty(sub.Name) ? "<default>" : sub.Name;
        return $"{groupName}::{material}::{subSegment}";
    }

    /// <summary>Leaf-path namespace key — uses the full sub path joined by "::" so a
    /// leaf like `_D3 → L` becomes "Group::Material::_D3::L". Distinguishes a Sub1's
    /// own direct LineShifts from each Sub2 leaf inside the same Sub1.</summary>
    private static string SubLeafKeyOf(string groupName, string material, string path)
        => $"{groupName}::{material}::{path}";

    /// <summary>Walk the SubGroup tree and build a (LineShift → leaf-path key) mapping.
    /// Every named node that holds direct LineShifts becomes its own bucket — so a
    /// container Sub1 like `_D3` is NOT a bucket here (it has no direct LineShifts;
    /// its row reads from <c>_reportBySubGroup</c> instead), while every leaf Sub2
    /// (`_D3_L`, `_D3_R`, …) maps its own LSes to its own key. Empty-named placeholder
    /// subs are walked through but don't take a path segment.</summary>
    private static void BuildSubLeafMapping(
        string groupName, string material, SubGroupRecord sub,
        string parentPath,
        Dictionary<string, string> mapping, List<string> list)
    {
        string nodeName = sub.Name ?? string.Empty;
        string path = string.IsNullOrEmpty(nodeName)
            ? parentPath
            : (string.IsNullOrEmpty(parentPath) ? nodeName : parentPath + "::" + nodeName);

        if (!string.IsNullOrEmpty(nodeName) && sub.LineShifts.Count > 0)
        {
            string leafKey = SubLeafKeyOf(groupName, material, path);
            if (!list.Contains(leafKey)) list.Add(leafKey);
            foreach (var ls in sub.LineShifts)
                if (!string.IsNullOrEmpty(ls))
                    mapping[ls] = leafKey;
        }

        foreach (var child in sub.SubGroups)
            BuildSubLeafMapping(groupName, material, child, path, mapping, list);
    }

    /// <summary>Total PPM for a top-level Sub at the given period — read from
    /// <c>_reportBySubGroup</c>, which uses the same NG/Input weighted aggregation
    /// the By Model report uses, just bucketed at SubGroup granularity.</summary>
    private double SubGroupTotalPpm(string subKey, string colKey)
    {
        if (_reportBySubGroup is null) return 0;
        var rows = _reportBySubGroup.GroupSummary.GetValueOrDefault(subKey);
        var tot  = rows?.FirstOrDefault(r => r.IsTotal);
        return tot?.Ppm.GetValueOrDefault(colKey) ?? 0;
    }

    /// <summary>Total PPM for a single nested leaf Sub at the given period — read from
    /// <c>_reportBySubLeaf</c>, mapped per leaf path.</summary>
    private double SubLeafTotalPpm(string leafKey, string colKey)
    {
        if (_reportBySubLeaf is null) return 0;
        var rows = _reportBySubLeaf.GroupSummary.GetValueOrDefault(leafKey);
        var tot  = rows?.FirstOrDefault(r => r.IsTotal);
        return tot?.Ppm.GetValueOrDefault(colKey) ?? 0;
    }

    /// <summary>선택된 그룹들의 MeanOfMembers 값을 다시 평균 — 전체 TOTAL 행에 사용.</summary>
    private double MeanOfGroups(string colKey)
    {
        double sum = 0;
        int    cnt = 0;
        foreach (var g in _selectedGroupNames)
        {
            double v = MeanOfMembers(g, colKey, null);
            if (v <= 0) continue;
            sum += v;
            cnt++;
        }
        return cnt == 0 ? 0 : sum / cnt;
    }

    /// <summary>정렬 기준 키: 이전 주차(Week[1]) → Week[0] → Date[0] 순 fallback.</summary>
    private (string Key, string Bucket) SortRefKey()
    {
        if (VisibleWeekCols.Count >= 2) return (VisibleWeekCols[1].Key, "week");
        if (VisibleWeekCols.Count == 1) return (VisibleWeekCols[0].Key, "week");
        if (VisibleDateCols.Count > 0)  return (VisibleDateCols[0].Key, "date");
        return ("", "");
    }

    // Display-only label for the sort-reference period: shifts week -1 and date -2 days.
    // Does NOT affect sort logic — `SortRefKey` still returns the real column key.
    private static string ShiftedRefLabel(string key, string bucket)
    {
        if (string.IsNullOrEmpty(key)) return "";
        if (bucket == "week" && key.Length >= 6
            && int.TryParse(key[..4], out int yy) && int.TryParse(key[4..], out int ww))
        {
            ww -= 1;
            if (ww < 1) { yy -= 1; ww = System.Globalization.ISOWeek.GetWeeksInYear(yy); }
            return $"{yy}{ww:D2}";
        }
        if (bucket == "date" && DateTime.TryParse(key, out DateTime dt))
        {
            return dt.AddDays(-2).ToString("yyyy-MM-dd");
        }
        return key;
    }

    // Display-only header shifts for the Top-10 table columns:
    //   date column header → -2 days (format MM/dd to match FormatDateHeader)
    //   week column header → -1 week ("W" + shifted week number)
    // Underlying `col.Key` (data binding) is unchanged.
    private static string ShiftedDateHeader(NgRateReportService.PeriodColumn col)
    {
        if (DateTime.TryParse(col.Key, out DateTime dt))
            return dt.AddDays(-2).ToString("MM/dd");
        return col.Header;
    }

    private static string ShiftedWeekHeader(NgRateReportService.PeriodColumn col)
    {
        if (col.Key.Length >= 6
            && int.TryParse(col.Key[..4], out int yy)
            && int.TryParse(col.Key[4..], out int ww))
        {
            ww -= 1;
            if (ww < 1) { yy -= 1; ww = System.Globalization.ISOWeek.GetWeeksInYear(yy); }
            return "W" + ww;
        }
        return col.Header;
    }

    private double DetailSortValue(NgRateReportService.LineShiftNgDetail d)
    {
        var (k, b) = SortRefKey();
        if (string.IsNullOrEmpty(k)) return 0;
        return b switch
        {
            "week" => d.WeekPpm.GetValueOrDefault(k),
            "date" => d.DatePpm.GetValueOrDefault(k),
            _      => 0,
        };
    }

    /// <summary>true when the given line-shift has at least one non-zero PPM across all visible period columns.</summary>
    private bool MemberHasAnyData(string lineShift)
    {
        if (_reportByModel is null || _report is null) return false;
        var rows = _reportByModel.GroupSummary.GetValueOrDefault(lineShift);
        var tot  = rows?.FirstOrDefault(r => r.IsTotal);
        if (tot is null) return false;
        foreach (var col in VisibleDateCols)  if (tot.Ppm.GetValueOrDefault(col.Key) > 0) return true;
        foreach (var col in VisibleWeekCols)  if (tot.Ppm.GetValueOrDefault(col.Key) > 0) return true;
        foreach (var col in VisibleMonthCols) if (tot.Ppm.GetValueOrDefault(col.Key) > 0) return true;
        return false;
    }

    /// <summary>
    /// 중그룹 PPM — per-model과 동일하게 서비스의 combo-merged 결과 사용.
    /// processType=null 이면 Total, 아니면 해당 ProcessType row의 PPM.
    /// </summary>
    private double MidGroupPpm(string groupName, string material, string colKey, string? processType = null)
    {
        if (_reportByMid is null) return 0;
        string key  = $"{groupName}::{material}";
        var rows = _reportByMid.GroupSummary.GetValueOrDefault(key);
        if (rows is null) return 0;
        var row = processType is null
            ? rows.FirstOrDefault(r => r.IsTotal)
            : rows.FirstOrDefault(r => !r.IsTotal && r.ProcessType == processType);
        if (row is null) return 0;
        return row.Ppm.GetValueOrDefault(colKey);
    }

    /// <summary>Mid PPM rendered as the simple average of its Sub1 PPMs (skipping
    /// zero ones) to avoid the combo-sum aggregation inflating Mid above any of
    /// its children. Falls back to <see cref="MidGroupPpm"/> when no named Sub1
    /// has data. Total-only — no per-ProcessType variant since the Weekly Summary
    /// table doesn't break down by PT here.</summary>
    private double MidPpmAvgOfSubs(string groupName, MidGroupRecord mid, string colKey)
    {
        double sum = 0; int cnt = 0;
        foreach (var sub in mid.SubGroups)
        {
            if (string.IsNullOrEmpty(sub.Name)) continue;
            if (sub.AllLineShifts.Count() == 0) continue;
            string sub1Key = SubGroupKeyOf(groupName, mid.Material, sub);
            double v = SubGroupTotalPpm(sub1Key, colKey);
            if (v <= 0) continue;
            sum += v; cnt++;
        }
        return cnt == 0 ? MidGroupPpm(groupName, mid.Material, colKey) : sum / cnt;
    }

    /// <summary>대그룹 PPM — 멤버 중그룹들의 PPM 평균 (값>0만).
    /// Total(processType=null)일 때는 Mid 값을 Sub1-평균으로 가져와서 combo-sum
    /// 누적 부풀림을 막고, ProcessType 분해는 기존대로 _reportByMid 의 PT 행을 평균.</summary>
    private double MeanOfMembers(string groupName, string colKey, string? processType)
    {
        var grp = _groups.FirstOrDefault(g => g.Name == groupName);
        if (grp is null || grp.MidGroups.Count == 0 || _reportByMid is null) return 0;

        double sum = 0;
        int    cnt = 0;
        foreach (var mid in grp.MidGroups)
        {
            double v = processType is null
                ? MidPpmAvgOfSubs(groupName, mid, colKey)
                : MidGroupPpm(groupName, mid.Material, colKey, processType);
            if (v <= 0) continue;
            sum += v;
            cnt++;
        }
        return cnt == 0 ? 0 : sum / cnt;
    }

    private bool HasUsableDb =>
        (!string.IsNullOrEmpty(_savedDbPath) && File.Exists(_savedDbPath)) ||
        NgRateReportSvc.FindMostRecentDb() is { Length: > 0 };

    protected override void OnInitialized()
    {
        ReloadGroups();
    }

    private void ReloadGroups()
    {
        _groups = Repo.GetModelGroups();
        _selectedGroupNames.RemoveWhere(n => !_groups.Any(g => g.Name == n));
    }

    private void SelectAllGroups()
    {
        _selectedGroupNames = new HashSet<string>(_groups.Select(g => g.Name), StringComparer.Ordinal);
    }

    private void ClearSelectedGroups() => _selectedGroupNames.Clear();

    private void ToggleGroup(string name, bool sel)
    {
        if (sel) _selectedGroupNames.Add(name);
        else     _selectedGroupNames.Remove(name);
    }

    private void SetToday()
    {
        _startDate = DateTime.Today;
        _endDate   = DateTime.Today;
    }

    private async Task GetDataAsync()
    {
        if (_endDate < _startDate)
        {
            _errorMessage = "End date must be on or after start date.";
            return;
        }
        _errorMessage = string.Empty;
        _savedDbPath  = null;
        _isBusy       = true;
        StateHasChanged();

        var progress = new Progress<string>(_ => { });

        try
        {
            string? dbPath = await NgRate.FetchAndSaveAsync(_startDate, _endDate, progress);
            if (string.IsNullOrEmpty(dbPath))
                _errorMessage = "Fetch failed — check credentials / logs.";
            else
                _savedDbPath = dbPath;
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isBusy = false;
            StateHasChanged();
        }
    }

    private async Task GetReportAsync()
    {
        if (_isReportBusy || _selectedGroupNames.Count == 0) return;
        _isReportBusy     = true;
        _reportError      = string.Empty;
        _report           = null;
        _reportByMid      = null;
        _reportByModel    = null;
        _reportBySubGroup = null;
        _reportBySubLeaf  = null;
        _lsNgReport       = null;
        _midNgReport      = null;
        StateHasChanged();

        try
        {
            string? dbPath = _savedDbPath ?? NgRateReportSvc.FindMostRecentDb();
            if (string.IsNullOrEmpty(dbPath) || !File.Exists(dbPath))
            {
                _reportError = "No .db file found. Run Get Data first.";
                return;
            }

            var mapping        = new Dictionary<string, string>(StringComparer.Ordinal); // LS → 대그룹
            var midMapping     = new Dictionary<string, string>(StringComparer.Ordinal); // LS → 중그룹 (Material)
            var subMapping     = new Dictionary<string, string>(StringComparer.Ordinal); // LS → top-level SubGroup (Sub1) — subtree aggregate
            var subLeafMapping = new Dictionary<string, string>(StringComparer.Ordinal); // LS → leaf SubGroup path  — Sub2+ per-node bucket
            var modelMapping   = new Dictionary<string, string>(StringComparer.Ordinal); // LS → LS (per-LS pseudo-group)
            var groupList    = new List<string>();
            var midList      = new List<string>();
            var subList      = new List<string>();
            var subLeafList  = new List<string>();
            var modelList    = new List<string>();
            foreach (var g in _groups.Where(g => _selectedGroupNames.Contains(g.Name)))
            {
                groupList.Add(g.Name);
                foreach (var mid in g.MidGroups)
                {
                    string matKey = $"{g.Name}::{mid.Material}"; // namespace by 대그룹 to avoid clashes
                    if (!midList.Contains(matKey)) midList.Add(matKey);

                    // For each top-level SubGroup, collect every descendant LineShift under one
                    // sub-key (Sub1 row). Then walk the tree recursively to build per-leaf-path
                    // buckets that drive Sub2+ rows in the Weekly Report Summary table.
                    foreach (var sub in mid.SubGroups)
                    {
                        string subKey = SubGroupKeyOf(g.Name, mid.Material, sub);
                        if (!subList.Contains(subKey)) subList.Add(subKey);
                        foreach (var ls in sub.AllLineShifts)
                        {
                            if (string.IsNullOrEmpty(ls)) continue;
                            subMapping[ls] = subKey;
                        }

                        BuildSubLeafMapping(g.Name, mid.Material, sub, parentPath: string.Empty,
                                            subLeafMapping, subLeafList);
                    }

                    foreach (var ls in mid.LineShifts)
                    {
                        if (string.IsNullOrEmpty(ls)) continue;
                        mapping[ls]      = g.Name;
                        midMapping[ls]   = matKey;
                        modelMapping[ls] = ls;
                        if (!modelList.Contains(ls)) modelList.Add(ls);
                    }
                }
            }

            if (mapping.Count == 0)
            {
                _reportError = "No LineShift found in the selected groups.";
                return;
            }

            var progress = new Progress<string>(_ => { });
            _report           = await NgRateReportSvc.GenerateReportAsync(dbPath, mapping,      groupList, progress);
            _reportByMid      = await NgRateReportSvc.GenerateReportAsync(dbPath, midMapping,   midList,   progress);
            _reportByModel    = await NgRateReportSvc.GenerateReportAsync(dbPath, modelMapping, modelList, progress);
            _reportBySubGroup = subList.Count > 0
                ? await NgRateReportSvc.GenerateReportAsync(dbPath, subMapping, subList, progress)
                : null;
            _reportBySubLeaf = subLeafList.Count > 0
                ? await NgRateReportSvc.GenerateReportAsync(dbPath, subLeafMapping, subLeafList, progress)
                : null;
            _lsNgReport    = await NgRateReportSvc.ComputeLineShiftNgDetailsAsync(dbPath, modelList, progress);
            _midNgReport   = await NgRateReportSvc.ComputeGroupedNgDetailsAsync(dbPath, midMapping, progress);
            _pendingChartRender = true;
        }
        catch (Exception ex)
        {
            _reportError = $"Error: {ex.Message}";
        }
        finally
        {
            _isReportBusy = false;
            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingChartRender && _report is not null && _reportByModel is not null
            && _selectedGroupNames.Count > 0)
        {
            _pendingChartRender = false;

            // Build combined period list — keep service's DESC order (newest → oldest) per block.
            // Each entry: (label, keyOrNull). Null key = separator position.
            var periodCells = new List<(string Label, string? Key)>();
            if (VisibleDateCols.Count > 0)
                periodCells.AddRange(VisibleDateCols.Select(c => (c.Header, (string?)c.Key)));
            if (VisibleWeekCols.Count > 0)
            {
                if (periodCells.Count > 0) periodCells.Add(("", null));
                periodCells.AddRange(VisibleWeekCols.Select(c => (c.Header, (string?)c.Key)));
            }
            if (VisibleMonthCols.Count > 0)
            {
                if (periodCells.Count > 0) periodCells.Add(("", null));
                periodCells.AddRange(VisibleMonthCols.Select(c => (c.Header, (string?)c.Key)));
            }

            if (periodCells.Count == 0) return;

            var labels = periodCells.Select(p => p.Label).ToArray();

            var grpSeries = _selectedGroupNames.Select(g => new
            {
                name   = g,
                values = periodCells.Select(p =>
                {
                    if (p.Key is null) return (double?)null; // separator
                    double v = MeanOfMembers(g, p.Key, null);
                    return v > 0 ? (double?)v : null;
                }).ToArray(),
            }).ToArray();

            try
            {
                await JS.InvokeVoidAsync("ngRateGroupChart.render", CanvasId,      labels, grpSeries);
                await JS.InvokeVoidAsync("ngRateGroupChart.render", CanvasIdModel, labels, grpSeries);
            }
            catch { }
        }
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("ngRateGroupChart.destroy", CanvasId); }      catch { }
        try { await JS.InvokeVoidAsync("ngRateGroupChart.destroy", CanvasIdModel); } catch { }
    }

