    private static string FormatPpm(double v)
        => v == 0 ? "-" : ((long)Math.Round(v)).ToString("N0");

    /// <summary>
    /// Renders a PPM cell content with a "(±delta)" tail vs the previous period.
    /// Red for positive (worse), blue for negative (better). Skipped when prev is
    /// null (oldest period) or both values are zero. Used on Mid-Group rows in the
    /// For Weekly Report view.
    /// </summary>
    private static MarkupString FormatPpmWithDelta(double current, double? prev)
    {
        string main = FormatPpm(current);
        if (!prev.HasValue || (current == 0 && prev.Value == 0))
            return new MarkupString(System.Net.WebUtility.HtmlEncode(main));

        double delta = current - prev.Value;
        if (Math.Abs(delta) < 0.5)
            return new MarkupString(System.Net.WebUtility.HtmlEncode(main));

        long absRounded = (long)Math.Round(Math.Abs(delta));
        string sign     = delta > 0 ? "+" : "−";   // Unicode minus reads cleaner
        string color    = delta > 0 ? "#dc2626" : "#2563eb";   // red / blue
        string deltaStr = $" ({sign}{absRounded:N0})";

        return new MarkupString(
            System.Net.WebUtility.HtmlEncode(main) +
            $"<span style=\"color:{color};font-size:10px;font-weight:600;margin-left:2px;\">" +
            System.Net.WebUtility.HtmlEncode(deltaStr) +
            "</span>");
    }

    private static int ProcessTypeRank(string pt) => pt switch
    {
        "SUB"      => 1,
        "MAIN"     => 2,
        "FUNCTION" => 3,
        "VISUAL"   => 4,
        _          => pt.StartsWith("SUB") ? 1 : 5,
    };
