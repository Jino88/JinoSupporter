<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BmesNgRateStandalone</RootNamespace>
    <AssemblyName>BmesNgRateStandalone</AssemblyName>
    <Version>1.0.26</Version>
    <FileVersion>1.0.26.0</FileVersion>
    <AssemblyVersion>1.0.26.0</AssemblyVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The UI is English only; the 13 satellite resource folders (.NET + dependency
         translations) added ~19 MB to a self-contained publish for nothing. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="8.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="8.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="ClosedXML" Version="0.102.3" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.3" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.5" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="GraphMakerExamples\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <None Include="GraphMakerExamples\*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <Target Name="SyncBmesSourcesFromWeb" BeforeTargets="PrepareForBuild">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\tools\SyncBmesFromWeb.ps1&quot;" />
    <!-- The default Compile glob is expanded when the project is evaluated, which happens
         before this target runs. A source file the sync script has just created for the
         first time is therefore absent from that glob, and the build fails until a second
         build re-evaluates the project. Re-including the synced C# tree here picks those
         files up in the same build. Exclude keeps the files the glob already found from
         being compiled twice, so this is a no-op once a synced file is committed. -->
    <ItemGroup>
      <Compile Include="Services\**\*.cs" Exclude="@(Compile)" />
    </ItemGroup>
  </Target>

</Project>
