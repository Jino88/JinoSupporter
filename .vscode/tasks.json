{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-web",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/JinoSupporter.Web/JinoSupporter.Web.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "kill-web-server",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-NonInteractive",
        "-Command",
        "$p = Get-NetTCPConnection -LocalPort 5050 -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess -Unique; if ($p) { Stop-Process -Id $p -Force -ErrorAction SilentlyContinue; Write-Host \"Killed PID $p\" } else { Write-Host 'No process on :5050' }"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "kill-and-build-web",
      "dependsOn": [
        "kill-web-server",
        "build-web"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-standalone-debug",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/BmesNgRateStandalone/BmesNgRateStandalone.csproj",
        "-c",
        "Debug"
      ],
      "problemMatcher": "$msCompile",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "build-standalone-release",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/BmesNgRateStandalone/BmesNgRateStandalone.csproj",
        "-c",
        "Release"
      ],
      "problemMatcher": "$msCompile",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "publish-standalone-update",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/BmesNgRateStandalone/tools/PublishStandaloneUpdate.ps1"
      ],
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "deploy-standalone-update",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/BmesNgRateStandalone/tools/PublishStandaloneUpdate.ps1",
        "-Version",
        "${input:standaloneUpdateVersion}",
        "-Notes",
        "${input:standaloneUpdateNotes}"
      ],
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "build-standalone-installer",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/BmesNgRateStandalone/tools/BuildStandaloneInstaller.ps1"
      ],
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ],
  "inputs": [
    {
      "id": "standaloneUpdateVersion",
      "type": "promptString",
      "description": "Standalone update version, for example 1.0.10",
      "default": "1.0.10"
    },
    {
      "id": "standaloneUpdateNotes",
      "type": "promptString",
      "description": "Release notes shown in the Standalone update prompt",
      "default": ""
    }
  ]
}
