{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Web Server",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "kill-and-build-web",
      "program": "${workspaceFolder}/JinoSupporter.Web/bin/Debug/net8.0/JinoSupporter.Web.dll",
      "args": [],
      "cwd": "${workspaceFolder}/JinoSupporter.Web",
      "stopAtEntry": false,
      "console": "externalTerminal",
      "justMyCode": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://0.0.0.0:5050"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+https?://(?:\\[[^\\]]+\\]|[^:]+):(\\d+)",
        "uriFormat": "http://10.6.4.54:%s"
      },
      "exceptionOptions": [
        {
          "exceptionNames": [
            "Microsoft.AspNetCore.Components.NavigationException"
          ],
          "throwAction": "ignore"
        }
      ]
    }
  ]
}
